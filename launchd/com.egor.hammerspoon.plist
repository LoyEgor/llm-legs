<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.egor.hammerspoon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/egorloy/.local/libexec/hammerspoon</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- KeepAlive=true on purpose: launchd owns the only launch path, so any
       kill/quit comes back with launchd's clean env — a relaunch from a
       profile shell (poisoned HOME) can never stick. Stop for real with
       `launchctl bootout gui/$UID/com.egor.hammerspoon`. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>org.hammerspoon.Hammerspoon</string>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/egorloy/Library/Logs/com.egor.hammerspoon.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/egorloy/Library/Logs/com.egor.hammerspoon.log</string>
</dict>
</plist>

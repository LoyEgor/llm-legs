#!/usr/bin/env bash
set -euo pipefail

base_home=$HOME
profiles_dir="${GEMINIB_PROFILES_DIR:-$base_home/.gemini-profiles}"
agy_bin="${AGY_BIN:-$base_home/.local/bin/agy}"

resolve_root() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}

geminib_root=$(resolve_root)
quota_helper="${GEMINIB_QUOTA_CMD:-$geminib_root/agy-quota.py}"
gemini_base_home=$base_home
gemini_profiles_dir=$profiles_dir
gemini_accounts_cache_dir="${LLM_LIMITS_GEMINI_ACCOUNTS_DIR:-$base_home/.llm-limits-gemini}"
. "$geminib_root/share/gemini-accounts.sh"
. "$geminib_root/share/worker-pool.sh"
. "$geminib_root/share/worker-model.sh"
. "$geminib_root/share/account-announce.sh"
pool_dir=$(worker_pool_dir gemini)

is_disabled() { worker_pool_is_disabled "$pool_dir" "$1"; }
set_disabled() { worker_pool_set_disabled "$pool_dir" "$1" "$2"; }
pool_suffix() { if is_disabled "$1"; then printf ' (out of pool)'; fi; }

account_exists() {
  if [ "$1" = main ]; then ! gemini_main_removed; else [ -d "$profiles_dir/$1" ]; fi
}

pin_account() {
  case "${1:-}" in
    --unpin) worker_model_pin_account gemini_profile geminib gemini_account_names is_disabled --unpin "${2:-}" ;;
    *) worker_model_pin_account gemini_profile geminib gemini_account_names is_disabled "${1:-}" ;;
  esac
}

set_all_pool() { worker_pool_set_all "$pool_dir" geminib gemini_account_names "$1"; }

enable_account() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    printf 'usage: geminib enable <name>|--all\n' >&2
    exit 2
  fi
  if [ "$name" = --all ]; then
    set_all_pool off
    return
  fi
  if ! account_exists "$name"; then
    printf 'geminib: unknown account: %s\n' "$name" >&2
    exit 2
  fi
  if ! is_disabled "$name"; then
    printf 'geminib: %s is already enabled\n' "$name"
    return
  fi
  set_disabled "$name" off
  printf 'geminib: enabled %s\n' "$name"
}

disable_account() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    printf 'usage: geminib disable <name>|--all\n' >&2
    exit 2
  fi
  if [ "$name" = --all ]; then
    set_all_pool on
    return
  fi
  if ! account_exists "$name"; then
    printf 'geminib: unknown account: %s\n' "$name" >&2
    exit 2
  fi
  if is_disabled "$name"; then
    printf 'geminib: %s is already disabled\n' "$name"
    return
  fi
  set_disabled "$name" on
  printf 'geminib: disabled %s\n' "$name"
}

reserved_name() {
  case "$1" in
    .*|*/*|help|add|remove|list|status|pick|profile|p|run|login|enable|disable|use|export-token) return 0 ;;
    *) return 1 ;;
  esac
}

# Where a path ENDS UP, symlinks resolved. A leg's config link is recognised by this and never by
# how it is spelled: a relative or otherwise-spelled link to main's config survives a string
# compare, and the rewrite below then lands in ~/.gemini/config/mcp_config.json — emptying the
# server list of Egor's interactive profile.
resolved_path() {
  local target="$1" directory base
  if [ -d "$target" ]; then
    # A directory that cannot be entered answers nothing, and answers it SUCCESSFULLY: the
    # subshell's status is the caller's standalone assignment's, and under `set -e` that took the
    # whole of `list`/`status` down.
    (cd -P "$target" 2>/dev/null && pwd) || return 0
    return 0
  fi
  directory=$(cd -P "$(dirname "$target")" 2>/dev/null && pwd) || return 0
  base=$(basename "$target")
  printf '%s/%s\n' "${directory%/}" "$base"
}

# Gives `destination` a server-less MCP config, or writes nothing at all and fails: a destination
# left holding a server list is the per-leg process storm the whole mechanism exists to prevent.
mcp_write_empty() {
  local destination="$1" temporary="${1%/*}/.${1##*/}.$$"
  if jq -e '(.mcpServers // {}) | length == 0' >/dev/null 2>&1 <"$destination"; then
    return 0
  fi
  if printf '{\n  "mcpServers": {}\n}\n' >"$temporary" 2>/dev/null &&
    mv -f "$temporary" "$destination"; then
    return 0
  fi
  rm -f "$temporary"
  return 1
}

# Antigravity launches every server LISTED in mcp_config.json whatever its `disabled` flag says —
# the flag only hides that server's tools from the model — so main's server list, once shared by
# symlinking the whole config directory, spawned one process per leg (57 mcp-remote on
# 2026-08-22). A leg gets its own mcp_config.json listing nothing at all, which is also what leaves
# the interactive main profile free to keep its servers.
ensure_mcp_off() {
  local directory="$1" config_dir="$directory/.gemini/config"
  local base_config="$base_home/.gemini/config" file entry name private
  local base_resolved
  base_resolved=$(resolved_path "$base_config")
  # No leg keeps a LINKED config directory. A link INTO main's config and a dangling one — what the
  # whole-directory link of the previous shape becomes the moment ~/.gemini/config is renamed — are
  # dropped and rebuilt from the mirror below; a dangling one left standing also takes `mkdir -p`
  # with it and, under `set -e`, the whole of `list`/`status` with that. A link anywhere ELSE is
  # copied into place first: everything under it is shared, so the rewrite below would land in
  # another profile's config and a server added on the far side would launch under this leg too.
  if [ -L "$config_dir" ]; then
    if [ ! -e "$config_dir" ] ||
      { [ -n "$base_resolved" ] && [ "$(resolved_path "$config_dir")" = "$base_resolved" ]; }; then
      rm -f "$config_dir"
    else
      private="$directory/.gemini/.config.$$"
      rm -rf "$private"
      if mkdir -p "$private" 2>/dev/null && cp -R "$config_dir/." "$private/" 2>/dev/null &&
        rm -f "$config_dir"; then
        mv "$private" "$config_dir"
      else
        rm -rf "$private"
        printf 'geminib: %s stays linked to a shared config; its MCP servers were left alone.\n' \
          "$config_dir" >&2
        return 0
      fi
    fi
  fi
  mkdir -p "$config_dir" 2>/dev/null || return 0
  if [ -d "$base_config" ]; then
    # Every pass, not only the one that created the directory: a file Antigravity or Egor adds to
    # main's config afterwards reaches an existing leg through nothing else, which is what the
    # whole-directory link used to give for free.
    for entry in "$base_config"/* "$base_config"/.[!.]*; do
      [ -e "$entry" ] || continue
      name=$(basename "$entry")
      [ "$name" != mcp_config.json ] || continue
      [ ! -L "$config_dir/$name" ] || [ -e "$config_dir/$name" ] || rm -f "$config_dir/$name"
      [ -e "$config_dir/$name" ] || [ -L "$config_dir/$name" ] ||
        ln -s "$entry" "$config_dir/$name"
    done
  fi
  # A dangling link left by a file main no longer has: it is main's config the leg mirrors, and a
  # link to nothing is not part of it.
  for entry in "$config_dir"/* "$config_dir"/.[!.]*; do
    [ -L "$entry" ] && [ ! -e "$entry" ] && rm -f "$entry"
  done
  file="$config_dir/mcp_config.json"
  # Whatever the leg's config dir turned out to be, main's is never rewritten in place.
  if [ -n "$base_resolved" ] && [ "$(resolved_path "$config_dir")" = "$base_resolved" ]; then
    return 0
  fi
  # A link is dropped rather than followed: writing through it would land in whatever config it
  # points at — main's, usually — and leaving it standing shares back whatever that side lists.
  [ ! -L "$file" ] || rm -f "$file"
  mcp_write_empty "$file" ||
    printf 'geminib: %s could not be emptied; its MCP servers may still launch.\n' "$file" >&2
}

# Antigravity writes one project record per folder it opens and never deletes them — throwaway
# tempdir clones from benches and quota polls left 10 515 by 2026-08-26. The records live under
# main's config, which every leg mirrors, so one daily pass there covers all of them. A record goes
# only when it names nothing but vanished temp paths: an unmounted /Volumes reads exactly like a
# deleted directory, and so does a percent-escaped URI this deliberately does not decode.
sweep_dead_projects() {
  local config_dir="$base_home/.gemini/config"
  local projects_dir="$config_dir/projects" marker="$config_dir/.projects-swept"
  local today stamp='' record path dead
  today=$(date '+%Y-%m-%d')
  [ ! -r "$marker" ] || read -r stamp <"$marker" || true
  [ "$stamp" != "$today" ] || return 0
  [ -d "$projects_dir" ] || return 0
  for record in "$projects_dir"/*.json; do
    [ -f "$record" ] || continue
    dead=''
    while IFS= read -r path; do
      if [ -e "$path" ]; then dead=no; break; fi
      [ -n "$dead" ] || dead=yes
    done < <(jq -r '
      (.projectResources.resources // []) as $resources
      | [$resources[]? | .folderUri? | select(type == "string")] as $uris
      | if ($uris | length) > 0 and ($uris | length) == ($resources | length)
          and (all($uris[];
            (startswith("file:///private/var/folders/") or startswith("file:///var/folders/")
              or startswith("file:///tmp/") or startswith("file:///private/tmp/"))
            and (contains("%") | not)))
        then $uris[] | ltrimstr("file://")
        else empty
        end' <"$record" 2>/dev/null)
    if [ "$dead" = yes ]; then rm -f "$record"; fi
  done
  printf '%s\n' "$today" 2>/dev/null >"$marker" || true
}

ensure_profile() {
  local directory="$1" item source target
  mkdir -p "$directory/.gemini/antigravity-cli"
  for item in GEMINI.md extensions extension_integrity.json settings.json trustedFolders.json; do
    target="$directory/.gemini/$item"
    if [ -e "$base_home/.gemini/$item" ] && [ ! -e "$target" ] && [ ! -L "$target" ]; then
      ln -s "$base_home/.gemini/$item" "$target"
    fi
  done
  target="$directory/.gemini/antigravity-cli/settings.json"
  if [ -e "$base_home/.gemini/antigravity-cli/settings.json" ] && [ ! -e "$target" ] && [ ! -L "$target" ]; then
    ln -s "$base_home/.gemini/antigravity-cli/settings.json" "$target"
  fi
  ensure_mcp_off "$directory"
  sweep_dead_projects
  mkdir -p "$directory/Library/Caches"
  for item in ms-playwright-go ms-playwright; do
    # Linked even before the base cache exists: a dangling link makes the first driver
    # install write through into the shared cache instead of a private per-profile copy.
    target="$directory/Library/Caches/$item"
    if [ ! -e "$target" ] && [ ! -L "$target" ]; then
      ln -s "$base_home/Library/Caches/$item" "$target"
    fi
  done
  gemini_ensure_keychain "$directory"
}

ensure_profiles() {
  local name
  while IFS= read -r name; do
    [ "$name" = main ] || ensure_profile "$profiles_dir/$name"
  done < <(gemini_account_names)
}

quota_snapshot() {
  local name="$1" home output rc=0
  home=$(gemini_account_home "$name")
  if [ ! -x "$quota_helper" ]; then
    printf '1\t{"error":"quota helper unavailable"}\n'
    return
  fi
  output=$(env HOME="$home" AGY_BIN="$agy_bin" AGY_WORKDIR="${AGY_WORKDIR:-$(resolve_root)}" \
    AGY_QUOTA_TIMEOUT="${GEMINIB_QUOTA_TIMEOUT:-8}" "$quota_helper" 2>/dev/null) || rc=$?
  if ! jq -e 'type == "object"' >/dev/null 2>&1 <<<"$output"; then
    output='{"error":"quota unavailable"}'
    rc=1
  fi
  printf '%s\t%s\n' "$rc" "$output"
}

login_status() {
  local snapshot rc data
  snapshot=$(quota_snapshot "$1")
  rc=${snapshot%%$'\t'*}
  data=${snapshot#*$'\t'}
  if [ "$rc" -eq 0 ]; then
    printf '0\tLogged in\n'
  elif [ "$rc" -eq 2 ] && jq -e '.auth_needed == true' >/dev/null 2>&1 <<<"$data"; then
    printf '1\tNot logged in\n'
  else
    printf '1\tLogin status unavailable\n'
  fi
}

format_reset_time() {
  local timestamp="$1" epoch now delta weekday
  local -a weekdays=(Sun Mon Tue Wed Thu Fri Sat)
  epoch=$(jq -nr --arg value "$timestamp" '$value | fromdateiso8601? // 0')
  if ! [ "$epoch" -gt 0 ] 2>/dev/null; then printf 'unknown'; return; fi
  now=$(date +%s)
  delta=$((epoch - now))
  if [ "$delta" -lt 86400 ]; then
    date -r "$epoch" '+%H:%M' 2>/dev/null || date -d "@$epoch" '+%H:%M' 2>/dev/null || printf 'unknown'
  elif [ "$delta" -lt 604800 ]; then
    weekday=$(date -r "$epoch" '+%w' 2>/dev/null || date -d "@$epoch" '+%w' 2>/dev/null) || { printf 'unknown'; return; }
    printf '%s ' "${weekdays[$weekday]}"
    date -r "$epoch" '+%H:%M' 2>/dev/null || date -d "@$epoch" '+%H:%M' 2>/dev/null || printf 'unknown'
  else
    date -r "$epoch" '+%m-%d %H:%M' 2>/dev/null || date -d "@$epoch" '+%m-%d %H:%M' 2>/dev/null || printf 'unknown'
  fi
}

add_account() {
  local name="${1:-}" directory status
  if [ -z "$name" ] || ! gemini_profile_name_valid "$name" || [ "$name" = main ] || reserved_name "$name"; then
    printf 'usage: geminib add <name> (must start with a lowercase letter or number; use only lowercase letters, numbers, and hyphens; not reserved words or "main")\n' >&2
    exit 2
  fi
  directory="$profiles_dir/$name"
  if [ -e "$directory" ] || [ -L "$directory" ]; then
    printf 'geminib: account already exists: %s\n' "$name" >&2
    exit 2
  fi
  mkdir -p "$directory"
  ensure_profile "$directory"
  announce_account_added "$geminib_root" gemini "$name"
  printf 'HOME=%q agy\n' "$directory"
  status=$(login_status "$name")
  printf '%s: %s\n' "$name" "${status#*$'\t'}"
}

remove_account() {
  local name="${1:-}" directory marker
  if [ -z "$name" ] || ! gemini_profile_name_valid "$name"; then
    printf 'usage: geminib remove <name>\n' >&2
    exit 2
  fi
  marker=$(gemini_removal_marker "$name")
  if [ "$name" = main ]; then
    # main's HOME is the real one: nothing under it is this tool's to delete, so the marker
    # alone is what takes main out of every enumerator.
    if gemini_main_removed; then
      printf 'geminib: unknown account: %s\n' "$name" >&2
      exit 2
    fi
  else
    directory="$profiles_dir/$name"
    if [ ! -e "$directory" ] && [ ! -L "$directory" ]; then
      printf 'geminib: unknown account: %s\n' "$name" >&2
      exit 2
    fi
    rm -rf "$directory"
    rm -f "$gemini_accounts_cache_dir/$name.json"
  fi
  if is_disabled "$name"; then set_disabled "$name" off; fi
  mkdir -p "$(dirname "$marker")"
  : >"$marker"
  announce_account_removed "$geminib_root"
  printf 'geminib: removed %s\n' "$name"
  if [ "$name" = main ]; then
    printf 'geminib: main stays hidden while %s exists; delete that file to bring it back.\n' "$marker"
  fi
}

list_account_line() {
  local name=$1 status
  status=$(login_status "$name")
  printf '%s: %s%s\n' "$name" "${status#*$'\t'}" "$(pool_suffix "$name")"
}

status_account_line() {
  local name=$1 snapshot rc data state hused wused hreset wreset
  snapshot=$(quota_snapshot "$name")
  rc=${snapshot%%$'\t'*}
  data=${snapshot#*$'\t'}
  if [ "$rc" -eq 0 ]; then
    state='Logged in'
    hused=$(jq -r '[.groups[]? | select(.displayName == "Gemini Models")][0] |
      [.buckets[]? | select(.window == "5h")][0] |
      if (.remainingFraction | type) == "number" then (((1 - .remainingFraction) * 100) | round | tostring) + "%" else "-" end' <<<"$data")
    wused=$(jq -r '[.groups[]? | select(.displayName == "Gemini Models")][0] |
      [.buckets[]? | select(.window == "weekly")][0] |
      if (.remainingFraction | type) == "number" then (((1 - .remainingFraction) * 100) | round | tostring) + "%" else "-" end' <<<"$data")
    hreset=$(format_reset_time "$(jq -r '[.groups[]? | select(.displayName == "Gemini Models")][0] |
      [.buckets[]? | select(.window == "5h")][0].resetTime // empty' <<<"$data")")
    wreset=$(format_reset_time "$(jq -r '[.groups[]? | select(.displayName == "Gemini Models")][0] |
      [.buckets[]? | select(.window == "weekly")][0].resetTime // empty' <<<"$data")")
  elif [ "$rc" -eq 2 ] && jq -e '.auth_needed == true' >/dev/null 2>&1 <<<"$data"; then
    state='Not logged in'
    hused=-; wused=-; hreset=unknown; wreset=unknown
  else
    state='Login status unavailable'
    hused=-; wused=-; hreset=unknown; wreset=unknown
  fi
  printf '%s: %s%s | 5H %s reset %s | WEEKLY %s reset %s\n' \
    "$name" "$state" "$(pool_suffix "$name")" "$hused" "$hreset" "$wused" "$wreset"
}

parallel_account_output() {
  local probe=$1 directory names_file name index=0 pid
  local -a pids
  directory=$(mktemp -d "${TMPDIR:-/tmp}/geminib-probes.XXXXXX")
  names_file="$directory/names"
  gemini_account_names >"$names_file"
  while IFS= read -r name; do
    index=$((index + 1))
    "$probe" "$name" >"$directory/$index" &
    pids[$index]=$!
  done <"$names_file"
  # An empty roster — main removed and no named profile left — is reachable, and bash 3.2 (what a
  # launchd or Hammerspoon PATH resolves) aborts on a bare "${pids[@]}" of an empty array under
  # `set -u`.
  for pid in ${pids[@]+"${pids[@]}"}; do
    wait "$pid" || true
  done
  index=0
  while IFS= read -r name; do
    index=$((index + 1))
    cat "$directory/$index"
  done <"$names_file"
  rm -rf "$directory"
}

# The all-accounts pass belongs to the two commands that REPORT on every account. Run before
# dispatch instead, it relinked and keychain-migrated every leg on `disable`, on `use`, and on a
# headless run the worker pool was about to refuse.
list_accounts() {
  ensure_profiles
  parallel_account_output list_account_line
}

show_status() {
  ensure_profiles
  parallel_account_output status_account_line
}

run_account() {
  local allow_create="$1" name="${2:-}" directory created=false arg
  if [ "$allow_create" = true ] && { [ "$name" = -h ] || [ "$name" = --help ]; }; then
    show_help
    return
  fi
  if [ -z "$name" ]; then
    printf 'usage: geminib profile <name> [agy args...]\n' >&2
    exit 2
  fi
  if ! gemini_profile_name_valid "$name"; then
    printf "geminib: invalid profile name '%s' (must start with a lowercase letter or number; use only lowercase letters, numbers, and hyphens)\n" "$name" >&2
    exit 2
  fi
  shift 2
  # `--print` is agy's headless form, so it is a worker asking; an interactive session is Egor.
  for arg in "$@"; do
    case "$arg" in
      --print|--print=*)
        worker_pool_refuse_headless gemini "$name" "$(worker_model_pinned_account gemini_profile)" || exit 2
        break
        ;;
    esac
  done
  if [ "$name" = main ]; then
    if gemini_main_removed; then
      printf 'geminib: unknown account: %s\n' "$name" >&2
      exit 2
    fi
    exec env HOME="$base_home" "$agy_bin" "$@"
  fi
  directory="$profiles_dir/$name"
  if [ ! -d "$directory" ]; then
    if [ "$allow_create" != true ]; then
      printf 'geminib: unknown account: %s\n' "$name" >&2
      exit 2
    fi
    if reserved_name "$name"; then
      printf "geminib: invalid profile name '%s'\n" "$name" >&2
      exit 2
    fi
    if ! gemini_profile_name_valid "$name"; then
      printf "geminib: invalid profile name '%s' (must start with a lowercase letter or number; use only lowercase letters, numbers, and hyphens)\n" "$name" >&2
      exit 2
    fi
    mkdir -p "$directory"
    created=true
    printf "geminib: new profile '%s' created at %s — Antigravity will ask you to log in once.\n" "$name" "$directory" >&2
  fi
  ensure_profile "$directory"
  [ "$created" != true ] || announce_account_added "$geminib_root" gemini "$name"
  exec env HOME="$directory" GEMINIB_BASE_HOME="$base_home" "$agy_bin" "$@"
}

export_token() {
  local name="${1:-}" target='' min_seconds=0 projection='' source_line stripped
  if [ "$#" -gt 0 ]; then shift; fi
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --to) target="${2:-}"; shift 2 || return 2 ;;
      --min-seconds) min_seconds="${2:-}"; shift 2 || return 2 ;;
      *) break ;;
    esac
  done
  if [ "$#" -gt 0 ] || [ -z "$name" ] || [ -z "$target" ] || ! [[ "$min_seconds" =~ ^[0-9]+$ ]]; then
    printf 'usage: geminib export-token <name> --to <path> [--min-seconds <n>]\n' >&2
    return 2
  fi
  if [ "$name" != main ] && ! gemini_profile_name_valid "$name"; then
    printf "geminib: invalid profile name '%s'\n" "$name" >&2
    return 2
  fi
  if ! account_exists "$name"; then
    printf 'geminib: unknown account: %s\n' "$name" >&2
    return 2
  fi
  if [ -e "$target" ] || [ -L "$target" ]; then
    printf 'geminib: export-token will not overwrite %s\n' "$target" >&2
    return 2
  fi
  projection=$(python3 - "$(gemini_account_home "$name")" "$min_seconds" "$agy_bin" \
    "${GEMINIB_SECURITY_CMD:-/usr/bin/security}" "${GEMINIB_TOKEN_ENDPOINT:-https://oauth2.googleapis.com/token}" <<'PY'
import base64
import datetime as dt
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import urllib.parse

profile, minimum, binary, security, endpoint = sys.argv[1:]
minimum = int(minimum)

def refuse(code, reason):
    print("geminib: " + reason, file=sys.stderr)
    raise SystemExit(code)

def expiry_epoch(value):
    try:
        if str(value).isdigit():
            epoch = int(value)
            return epoch // 1000 if epoch >= 10**12 else epoch
        stamp = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
        return int(stamp.timestamp()) if stamp.tzinfo else 0
    except (ValueError, TypeError, AttributeError, OverflowError):
        return 0

def text(value):
    return isinstance(value, str) and bool(value)

def export():
    if minimum > 3540:
        refuse(4, "requested lifetime exceeds the fresh-token ceiling of 3540s")
    home = Path(profile).resolve()
    keychain = (home / "Library/Keychains/gemini.keychain-db").resolve()
    # HOME selects the keychain domain even when security receives an absolute database path.
    security_env = dict(os.environ, HOME=str(home))
    source = "antigravity-oauth-token"
    blob = None
    if keychain.exists():
        command = [security, "find-generic-password", "-s", "gemini", "-a", "antigravity", "-w", str(keychain)]
        result = subprocess.run(command, env=security_env, capture_output=True)
        if result.returncode not in (0, 44):
            try:
                password = (home / ".keychain-password").read_text().rstrip("\n")
            except OSError:
                password = ""
            if not password or subprocess.run(
                [security, "unlock-keychain", "-p", password, str(keychain)],
                env=security_env, capture_output=True,
            ).returncode:
                refuse(3, "keychain is unavailable; refusing a legacy fallback")
            result = subprocess.run(command, env=security_env, capture_output=True)
        if result.returncode == 0:
            source = "keychain"
            blob = result.stdout.strip()
            prefix = b"go-keyring-base64:"
            if not blob.startswith(prefix):
                refuse(3, "stores its sign-in in a shape this export does not recognise")
            try:
                blob = base64.b64decode(blob[len(prefix):], validate=True)
            except ValueError:
                refuse(3, "stores its sign-in in a shape this export does not recognise")
        elif result.returncode != 44:
            refuse(3, "keychain is unavailable; refusing a legacy fallback")
    if blob is None:
        try:
            blob = (home / ".gemini/antigravity-cli/antigravity-oauth-token").read_bytes()
        except FileNotFoundError:
            refuse(3, "is not signed in; refusing a login or a live-profile fallback")
    try:
        saved = json.loads(blob)
    except (ValueError, UnicodeError):
        saved = None
    token = saved.get("token", saved) if isinstance(saved, dict) else None
    if not isinstance(token, dict) or not text(token.get("access_token")):
        refuse(3, "stores its sign-in in a shape this export does not recognise")
    expiry = expiry_epoch(token.get("expiry", token.get("expires_at", token.get("access_token_expires_at"))))
    if expiry <= time.time() + minimum:
        refresh = token.get("refresh_token")
        if source != "keychain" or not text(refresh):
            refuse(4, "refresh_unavailable: no keychain refresh material for the requested lifetime")
        try:
            payload = saved["id_token"].split(".")[1]
            claims = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
            client_id = claims["aud"]
            if not text(client_id):
                raise ValueError()
        except (KeyError, IndexError, ValueError, TypeError, AttributeError):
            refuse(4, "refresh_unavailable: invalid ID token audience")
        # Go packs adjacent strings together: the binary carries one 35-byte secret per embedded
        # client id, back to back, and nothing says which secret pairs with the ID token's audience,
        # so a wrong pairing (invalid_client) moves on to the next candidate.
        try:
            found = subprocess.run(["grep", "-a", "-o", "-E", "GOCSPX-[A-Za-z0-9_-]{28}", binary],
                                   env=dict(os.environ, LC_ALL="C"), capture_output=True)
        except OSError:
            refuse(4, "refresh_unavailable: client secret lookup failed")
        secrets = list(dict.fromkeys(found.stdout.decode("ascii").splitlines()))
        if found.returncode or not 1 <= len(secrets) <= 4:
            refuse(4, "refresh_unavailable: client secret lookup failed")
        # Both the grant and its response stay off argv and disk; only the projection leaves here.
        for secret in secrets:
            body = urllib.parse.urlencode({"grant_type": "refresh_token", "refresh_token": refresh,
                                          "client_id": client_id, "client_secret": secret})
            issued_at = int(time.time())
            try:
                response = subprocess.run(
                    ["curl", "--disable", "--silent", "--max-time", "30", "--request", "POST",
                     "--header", "Content-Type: application/x-www-form-urlencoded", "--data-binary", "@-",
                     "--write-out", "\n%{http_code}", endpoint],
                    input=body, capture_output=True, text=True,
                )
            except OSError:
                refuse(4, "refresh_failed: transport_error")
            if response.returncode:
                refuse(4, "refresh_failed: transport_error")
            raw, _, http = response.stdout.rpartition("\n")
            try:
                grant = json.loads(raw)
            except ValueError:
                grant = {}
            if not isinstance(grant, dict):
                grant = {}
            if grant.get("error") in ("invalid_client", "unauthorized_client") and secret != secrets[-1]:
                continue
            break
        if http != "200" or "error" in grant:
            error = grant.get("error")
            error = error if error in {"invalid_grant", "invalid_client", "invalid_request",
                                      "unauthorized_client", "unsupported_grant_type", "invalid_scope",
                                      "access_denied", "temporarily_unavailable", "server_error"} else "refresh_failed"
            code = http if re.fullmatch(r"[0-9]{3}", http) else "unknown"
            refuse(4, f"{error}: HTTP {code}")
        lifetime = grant.get("expires_in")
        if not text(grant.get("access_token")) or isinstance(lifetime, bool) or not str(lifetime).isdigit():
            refuse(4, "refresh_failed: invalid_response")
        expiry = issued_at + int(lifetime)
        if expiry <= time.time() + minimum:
            refuse(4, "refresh_failed: minted token does not meet the requested lifetime")
        token = dict(token, access_token=grant["access_token"], token_type=grant.get("token_type", "Bearer"))
        if text(grant.get("id_token")):
            saved["id_token"] = grant["id_token"]
        source = "refresh"
    # Unknown fields cannot cross the boundary: some may be future renewal material.
    projected = {"token": {"access_token": token["access_token"],
                           "token_type": token.get("token_type") or "Bearer",
                           "expiry": dt.datetime.fromtimestamp(expiry, dt.timezone.utc).isoformat().replace("+00:00", "Z")},
                 "auth_method": saved.get("auth_method") or "consumer"}
    if text(saved.get("id_token")):
        projected["id_token"] = saved["id_token"]
    print(f"source={source} expires_at={expiry}")
    print(json.dumps(projected, separators=(",", ":")))

try:
    export()
except (OSError, ValueError, TypeError, OverflowError):
    refuse(3, "credential export failed; refusing to disclose credential details")
PY
  ) || return $?
  source_line=${projection%%$'\n'*}
  stripped=${projection#*$'\n'}
  if ! (set -C; umask 077; printf '%s\n' "$stripped" >"$target"); then
    printf 'geminib: export-token could not write %s\n' "$target" >&2
    return 2
  fi
  chmod 600 "$target"
  printf '%s\n' "$source_line"
}

show_help() {
  printf '%s\n' \
    'geminib profile <name> [agy args...]  Open an isolated profile; creates it if missing (Antigravity asks you to log in once). Aliases: p, run.' \
    'geminib <name> exec [args...]' \
    'geminib add <name>                    Create a profile without launching; prints the login command.' \
    'geminib remove <name>                 Forget a profile and prune its cached quota; main leaves only a marker.' \
    'geminib enable <name>|--all           Return an account (or every account) to worker selection.' \
    'geminib disable <name>|--all          Exclude an account (or every account) from the worker pool; headless runs are then refused, your own sessions are not.' \
    'geminib use <name>|--unpin [<name>]|--clear  Add/remove a workers pin; no name prints the list.' \
    'geminib list                          List profiles with login state.' \
    'geminib status                        Per-account login state and quota.' \
    'geminib export-token <name> --to <path> [--min-seconds <n>]  Export a keychain-first access-only sign-in to a new 0600 file; refresh here if needed, with no profile writes.'
}

if [ "${2:-}" = exec ] && [ "${1:-}" != main ] \
   && gemini_profile_name_valid "${1:-}" \
   && [ -d "$profiles_dir/${1:-}" ]; then
  name="$1"
  shift 2
  run_account false "$name" "$@"
fi
case "${1:-}" in
  add)
    shift
    [ "$#" -eq 1 ] || { printf 'usage: geminib add <name>\n' >&2; exit 2; }
    add_account "$1"
    ;;
  remove)
    shift
    [ "$#" -eq 1 ] || { printf 'usage: geminib remove <name>\n' >&2; exit 2; }
    remove_account "$1"
    ;;
  enable)
    shift
    enable_account "${1:-}"
    ;;
  disable)
    shift
    disable_account "${1:-}"
    ;;
  use)
    shift
    pin_account "$@"
    ;;
  list)
    [ "$#" -eq 1 ] || { printf 'usage: geminib list\n' >&2; exit 2; }
    list_accounts
    ;;
  status)
    [ "$#" -eq 1 ] || { printf 'usage: geminib status\n' >&2; exit 2; }
    show_status
    ;;
  export-token)
    shift
    export_token "$@"
    ;;
  profile|p|run)
    shift
    run_account true "$@"
    ;;
  help|-h|--help|'')
    show_help
    ;;
  *)
    name="$1"
    if [ "${2:-}" != exec ]; then
      printf 'usage: geminib <name> exec [args...]\n' >&2
      exit 2
    fi
    shift 2
    run_account false "$name" "$@"
    ;;
esac

#!/usr/bin/env bash
# One group, parsed whole before it runs: bash reads a script as it goes, so an in-place edit
# mid-run fed a running leg shifted bytes (2026-10-02). The closing `exit` and `}` stay last.
{
set -euo pipefail

usage() {
  image_leg_cause "$@"
  printf 'usage: gemini-listen "<question>" <absolute media path>... [-o <absolute .md path>] [--model pro|flash] [--account <geminib profile>]\n' >&2
  printf '       gemini-listen "<question>" --compare <absolute A> <absolute B> -o <absolute .md path> [--model pro|flash]\n' >&2
  printf '  --compare asks twice, A,B then B,A, each reply ending WINNER: first|second|tie; footer winner=A|B|tie votes=<n>/2, tie unless both orders agree\n' >&2
  printf '  Gemini watches and listens through agy on a subscription account: video with its sound, audio, images\n' >&2
  printf '  files over %s bytes (agy views at most 20 MB) are sent as a proxy: video 720p at the bitrate that fits, audio mp3\n' "$limit_bytes" >&2
  printf '  audio goes as wav with 2-4 test beeps appended; a reply that miscounts them is asked once more, then exit 1\n' >&2
  printf '  the answer goes to -o (or stdout) as "<!-- model -->" then the text; exit 3 = usage limit, retry with the other --model\n' >&2
  exit 2
}

say() {
  image_leg_cause "$1"
  exit "${2:-2}"
}

resolve_root() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}

root=$(resolve_root)
. "$root/share/image-leg.sh"
. "$root/share/account-arg.sh"
image_leg_start gemini-listen listen observed_model
. "$root/share/image-caps.sh"
limit_bytes=$(image_caps_get "$root" gemini '.listen.view_max_bytes')
ffmpeg_cmd=${GEMINI_LISTEN_FFMPEG:-ffmpeg}
ffprobe_cmd=${GEMINI_LISTEN_FFPROBE:-ffprobe}

question=''
out=''
model_key=$(image_caps_get "$root" gemini '.listen.model_default')
account=''
compare=false
media=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    -o | --out) [ "$#" -ge 2 ] || usage "$1 needs a value"; out=$2; shift 2 ;;
    --model) [ "$#" -ge 2 ] || usage "$1 needs a value"; model_key=$2; shift 2 ;;
    --account) [ "$#" -ge 2 ] || usage "$1 needs a value"; account_arg "$2"; account=$2; shift 2 ;;
    --compare) compare=true; shift ;;
    -h | --help) image_leg_help usage ;;
    -*) usage "unknown argument $1" ;;
    *)
      if [ -z "$question" ]; then question=$1; else media+=("$1"); fi
      shift
      ;;
  esac
done
[ -n "$question" ] || usage "missing the question"
[ "${#media[@]}" -gt 0 ] || usage "missing a media file"
[ -z "$out" ] || [[ "$out" = /* ]] || say "-o must be an absolute path, not $out"
[ -z "$out" ] || [ -d "$(dirname "$out")" ] || say "-o folder $(dirname "$out") does not exist"
if [ -n "$account" ] && ! [[ "$account" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then usage "--account $account is not a profile name"; fi
family_kind=$(image_caps_get "$root" gemini ".listen.models[\"$model_key\"].family // empty")
[ -n "$family_kind" ] || say "--model is pro or flash"
effort=$(image_caps_get "$root" gemini ".listen.models[\"$model_key\"].effort")
beeps_on=$(image_caps_get "$root" gemini ".listen.models[\"$model_key\"].beeps")
for file in "${media[@]}"; do
  [[ "$file" = /* ]] || say "$file is not an absolute path"
  [ -f "$file" ] || say "$file is not a file"
done
command -v "$ffprobe_cmd" >/dev/null 2>&1 && command -v "$ffmpeg_cmd" >/dev/null 2>&1 ||
  say "ffmpeg and ffprobe are required" 1

started=$(date +%s)
# One verdict is noise and the first file tends to win (2026-10-07), so a comparison is two
# independent calls in both orders; each sub-call logs its own leg.
if [ "$compare" = true ]; then
  [ "${#media[@]}" -eq 2 ] || usage "--compare takes exactly two files"
  [ -n "$out" ] || usage "--compare needs -o"
  IMAGE_LEG_SKIP=1
  pass=(--model "$model_key")
  [ -z "$account" ] || pass+=(--account "$account")
  : >"$out"
  winners='' rows=''
  for order in A,B B,A; do
    if [ "$order" = A,B ]; then pair=("${media[0]}" "${media[1]}"); else pair=("${media[1]}" "${media[0]}"); fi
    printf '## Order %s: File 1 = %s (%s), File 2 = %s (%s)\n\n' "$order" "${order%,*}" "${pair[0]##*/}" \
      "${order#*,}" "${pair[1]##*/}" >>"$out"
    rc=0
    footer=$(GEMINI_LISTEN_WINNER=1 "$root/bin/gemini-listen" "$question" "${pair[@]}" -o "$out.part" "${pass[@]}") || rc=$?
    [ "$rc" -eq 0 ] || { rm -f "$out.part"; exit "$rc"; }
    { cat "$out.part"; printf '\n'; } >>"$out"
    rm -f "$out.part"
    verdict=$(sed -n 's/^verdict=//p' <<<"$footer")
    case "$verdict" in first) winner=${order%,*} ;; second) winner=${order#*,} ;; *) winner=tie ;; esac
    winners+="$winner "
    rows+="order$([ "$order" = A,B ] && printf 1 || printf 2)=$order verdict=$winner $(grep -E '^(account|session|model|calls)=' <<<"$footer" | paste -sd' ' -)"$'\n'
  done
  read -r first second <<<"$winners"
  winner=tie
  [ "$first" != "$second" ] || winner=$first
  votes=0
  for each in $winners; do [ "$each" != "$winner" ] || votes=$((votes + 1)); done
  printf 'dest=%s\n%swinner=%s votes=%s/2\na=%s\nb=%s\nseconds=%s\n' "$out" "$rows" "$winner" "$votes" \
    "${media[0]}" "${media[1]}" "$(($(date +%s) - started))"
  exit 0
fi
base_home=$HOME
gemini_base_home=$base_home
gemini_profiles_dir="${GEMINIB_PROFILES_DIR:-$base_home/.gemini-profiles}"
. "$root/share/account-roster.sh"
. "$root/share/worker-model.sh"
. "$root/share/worker-pool.sh"
. "$root/share/worker-claims.sh"

# macOS TMPDIR ends in /: the model opened the path without the //, and no view_file matched it.
tmp_root=${TMPDIR:-/tmp}
tmp_dir=$(mktemp -d "${tmp_root%/}/gemini-listen.XXXXXX")
trap 'image_leg_exit; rm -rf "$tmp_dir"' EXIT
mkdir "$tmp_dir/media"

stream_of() { # file type
  "$ffprobe_cmd" -v error -select_streams "$2:0" -show_entries stream=codec_name -of csv=p=0 "$1" 2>/dev/null | head -n 1
}
duration_of() {
  "$ffprobe_cmd" -v error -show_entries format=duration -of csv=p=0 "$1" 2>/dev/null | head -n 1
}
size_of() { stat -f %z "$1"; }

# Video over the limit: 720p at the bitrate that fits, re-encoded once lower when x264 overshoots.
video_proxy() { # source dest seconds
  local target kbps attempt
  target=$((limit_bytes * 9 / 10))
  for attempt in 1 2; do
    kbps=$(awk -v b="$target" -v s="$3" 'BEGIN { k = int(b * 8 / s / 1000) - 128; print (k > 4000 ? 4000 : k) }')
    [ "$kbps" -ge 150 ] || say "$1 lasts ${3}s: under 20 MB its picture would be unreadable; cut it into parts" 2
    "$ffmpeg_cmd" -v error -y -i "$1" -map 0:v:0 -map '0:a:0?' -vf "scale='min(1280,iw)':-2" -fpsmax 30 \
      -c:v libx264 -preset veryfast -b:v "${kbps}k" -maxrate "${kbps}k" -bufsize "$((kbps * 2))k" \
      -pix_fmt yuv420p -c:a aac -b:a 128k -ac 2 -movflags +faststart "$2" || say "ffmpeg could not make a proxy of $1" 1
    [ "$(size_of "$2")" -gt "$limit_bytes" ] || return 0
    target=$((target * 7 / 10))
  done
  say "the proxy of $1 is still over $limit_bytes bytes" 1
}

# Pro sometimes believes view_file gave it a transcript, though agy's record shows the sound arrived
# (2026-10-07); a Pro reply must count these beeps. Flash miscounts them under a long question, so it
# gets none.
with_beeps() { # source dest beeps ffmpeg-output-args...
  local source=$1 dest=$2 beeps=$3 rate channels
  shift 3
  if [ "$beeps" -eq 0 ]; then
    "$ffmpeg_cmd" -v error -y -i "$source" -map 0:a:0 "$@" "$dest" || say "ffmpeg could not convert $source" 1
    return
  fi
  IFS=, read -r rate channels < <("$ffprobe_cmd" -v error -select_streams a:0 -show_entries stream=sample_rate,channels \
    -of csv=p=0 "$source" | head -n 1)
  "$ffmpeg_cmd" -v error -y -i "$source" -filter_complex \
    "aevalsrc='if(gte(t,1)*lt(mod(t-1,0.6),0.2)*lt(t-1,0.6*$beeps),0.5*sin(2*PI*1000*t),0)':s=$rate:d=$(awk -v n="$beeps" 'BEGIN { print 1.3 + 0.6 * n }'),aformat=channel_layouts=${channels}c[beeps];[0:a:0][beeps]concat=n=2:v=0:a=1" \
    "$@" "$dest" || say "ffmpeg could not add the test beeps to $source" 1
}

kind_of() { # file ext
  case "$2" in
    png | jpg | jpeg | webp | heic | bmp | tif | tiff | gif) printf image; return ;;
    wav | mp3 | flac | ogg | oga | opus | aac | aiff | aif | m4a) printf audio; return ;;
  esac
  # V, not v: a cover picture in an audio file is a video stream too.
  if [ -n "$(stream_of "$1" V)" ]; then printf video
  elif [ -n "$(stream_of "$1" a)" ]; then printf audio
  fi
}
shape_of() {
  "$ffprobe_cmd" -v error -select_streams V:0 -show_entries stream=width,height -of csv=p=0:s=x "$1" | head -n 1
}

labels=''
proxied=0
proxy_lines=''
beep_counts=''
heard_lines=''
index=0
for file in "${media[@]}"; do
  index=$((index + 1))
  ext=$(printf '%s' "${file##*.}" | tr '[:upper:]' '[:lower:]')
  bytes=$(size_of "$file")
  kind=$(kind_of "$file" "$ext")
  [ -n "$kind" ] || say "$file has no picture or sound ffprobe can read"
  seconds=$(duration_of "$file")
  if [ "$kind" != image ]; then
    [[ "$seconds" =~ ^[0-9.]+$ ]] || say "ffprobe reads no duration in $file"
    seconds=$(awk -v s="$seconds" 'BEGIN { printf "%.1f", s }')
  fi
  case "$kind" in
    video) keep='mp4|mov|webm' proxy_ext=mp4 ;;
    audio) proxy_ext=mp3 ;;
    image) keep='png|jpg|jpeg|webp' proxy_ext=jpg ;;
  esac
  if [ "$kind" = audio ]; then
    # agy refuses flac, aac, m4a and aiff as unsupported mime types, so the lossless copy is always wav.
    beeps=0
    [ "$beeps_on" != true ] || beeps=$((RANDOM % 3 + 2))
    codec=$(stream_of "$file" a)
    [[ "$ext" = wav && "$codec" =~ ^pcm_ ]] || codec=pcm_s16le
    send="$tmp_dir/media/file$index.wav"
    with_beeps "$file" "$send" "$beeps" -c:a "$codec"
    if [ "$(size_of "$send")" -gt "$limit_bytes" ]; then
      rm "$send"
      send="$tmp_dir/media/file$index.$proxy_ext"
      kbps=$(awk -v b="$((limit_bytes * 9 / 10))" -v s="$seconds" 'BEGIN { k = int(b * 8 / (s + 4) / 1000); print (k > 192 ? 192 : k) }')
      [ "$kbps" -ge 32 ] || say "$file is too long to send as one audio file; cut it into parts"
      with_beeps "$file" "$send" "$beeps" -c:a libmp3lame -b:a "${kbps}k"
      [ "$(size_of "$send")" -le "$limit_bytes" ] || say "$file is too long to send as one audio file; cut it into parts"
      proxied=$((proxied + 1))
      proxy_lines+="proxy=file$index.$proxy_ext $(size_of "$send") bytes from $bytes: $file"$'\n'
    fi
    if [ "$beeps" -gt 0 ]; then
      beep_counts+=" $index:$beeps"
      heard_lines+="audio=heard file$index: $file"$'\n'
    else
      heard_lines+="audio=delivered file$index: $file"$'\n'
    fi
  elif [ "$bytes" -le "$limit_bytes" ] && [[ "$ext" =~ ^($keep)$ ]]; then
    send="$tmp_dir/media/file$index.$ext"
    cp "$file" "$send"
  else
    send="$tmp_dir/media/file$index.$proxy_ext"
    case "$kind" in
      video) video_proxy "$file" "$send" "$seconds" ;;
      image) "$ffmpeg_cmd" -v error -y -i "$file" -frames:v 1 -q:v 2 "$send" || say "ffmpeg could not convert $file" 1 ;;
    esac
    proxied=$((proxied + 1))
    proxy_lines+="proxy=file$index.$proxy_ext $(size_of "$send") bytes from $bytes: $file"$'\n'
  fi
  case "$kind" in
    video) desc="video, $seconds s, $(shape_of "$send"), $([ -n "$(stream_of "$send" a)" ] && printf 'with sound' || printf 'silent')" ;;
    audio) desc="audio, $seconds s$([ "$beeps" -eq 0 ] || printf ', then the test beeps')" ;;
    image) desc="image, $(shape_of "$send")" ;;
  esac
  labels+="File $index: $send ($desc; the caller's file ${file##*/})"$'\n'
  printf '%s\t%s\t%s\n' "$send" "$file" "$kind" >>"$tmp_dir/sent"
done

off_roster_rc=1
[ -z "$account" ] || off_roster_rc=2
picked=false
if [ -z "$account" ]; then
  pick_rc=0
  if command -v worker-pick >/dev/null 2>&1; then
    account=$(worker-pick --account gemini --role image 2>/dev/null) || pick_rc=$?
  else
    pick_rc=127
  fi
  [ "$pick_rc" -ne 3 ] || { printf 'GEMINI_USAGE_LIMIT\n' >&2; exit 3; }
  if [ "$pick_rc" -ne 0 ] || ! [[ "$account" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    account=$(worker_model_pin_first gemini 2>/dev/null || true)
    [[ "${account:-}" =~ ^[a-z0-9][a-z0-9-]*$ ]] || account=main
    printf 'gemini-listen: worker-pick unavailable; falling back to account %s\n' "$account" >&2
  else
    picked=true
  fi
fi
account_roster_refuse gemini-listen gemini "$account" || exit "$off_roster_rc"
worker_pool_refuse_headless gemini "$account" "$(worker_model_pin_csv < <(worker_model_pins gemini))" || exit 4
if [ "$picked" = true ] && ! worker_claims_record gemini "$account"; then
  printf 'gemini-listen: could not record the claim on %s\n' "$account" >&2
fi
worker_starts_record gemini "$account" ||
  printf 'gemini-listen: could not stamp the start on %s\n' "$account" >&2

prefix=$("$root/bin/geminib" families 2>/dev/null |
  awk -F'\t' -v kind="$family_kind" '$1 ~ ("-" kind "$") && !done { print $3; done = 1 }')
[ -n "$prefix" ] || say "\`geminib families\` printed no $family_kind row" 1
agy_model="$prefix-$effort"

audio_rule=''
[ -z "$beep_counts" ] || audio_rule="
Short test beeps were added at the very end of each audio file, after its own sound; leave them out of the answer and its timings. The first line of your reply must be BEEPS${beep_counts//:[0-9]/:N}, where each N is how many short test beeps are at the very end of that file, after its own sound."
[ -z "$heard_lines" ] || audio_rule+="
If view_file gives you no sound for an audio file, reply with the single line NO_AUDIO <file number>.
"
instruction="Answer a question about the media files below. First open every file with your view_file tool: it shows you the picture of a video or an image and lets you hear the sound of a video or an audio file. Open each file whole, one view_file call per file, and never run a shell command or write a file. Answer only from what you saw and heard; say so when something cannot be told from the media.
${audio_rule}${labels}
If view_file fails on a file, reply with the single line CANNOT_OPEN <file number> <the error>.
If a quota or usage-limit error stops you, reply with the single word QUOTA.

Question:
$question"
[ -z "${GEMINI_LISTEN_WINNER:-}" ] || instruction+="

End your reply with one last line that is exactly WINNER: first, WINNER: second or WINNER: tie, where first means File 1 and second means File 2."

image_leg_mark "${#media[@]}"
limit_re='GEMINI_USAGE_LIMIT|RESOURCE_EXHAUSTED|Individual quota reached|credits balance is too low|usage limit|quota exceeded|rate limit'
limited() {
  [ "$last_line" = QUOTA ] || grep -Eqi "$limit_re" "$tmp_dir/errors" ||
    { [ "$rc" -ne 0 ] && grep -Eqi "$limit_re" "$tmp_dir/stdout-text" "$tmp_dir/stderr"; }
}
want_beeps=$(printf '%s\n' $beep_counts | sort | tr '\n' ' ')
attempt=0
while :; do
  attempt=$((attempt + 1))
  rc=0
  (cd "$tmp_dir" && geminib profile "$account" --model "$agy_model" --print-timeout 540s \
    --output-format stream-json --dangerously-skip-permissions --log-file "$tmp_dir/agy.log" \
    --print "$instruction") >"$tmp_dir/stdout" 2>"$tmp_dir/stderr" || rc=$?
  events="$tmp_dir/events.json"
  jq -Rn '[inputs | fromjson? | select(type == "object")]' "$tmp_dir/stdout" >"$events"
  session=$(jq -r '([.[] | select(.event == "result") | .result.conversation_id // empty] | last) //
    ([.[] | select(.event == "init") | .conversation_id // empty] | last) // "none"' "$events")
  observed_model=$(jq -r '[.[] | select(.event == "init") | .init.model // empty] | last // empty' "$events")
  answer=$(jq -r '[.[] | select(.event == "result") | .result.response // empty] | last // ""' "$events")
  jq -r '.[] | (.result.error // empty), (.step_update.tool_info.error // empty) | .. | strings' "$events" >"$tmp_dir/errors"
  first_line=$(printf '%s\n' "$answer" | awk 'NF { print; exit }' | tr -d '\r*`')
  last_line=$(printf '%s\n' "$answer" | awk 'NF { line = $0 } END { print line }' | tr -d '\r')

  # Stream events echo the prompt, so of stdout only the lines that are not events count.
  grep -v '^[[:space:]]*{' "$tmp_dir/stdout" >"$tmp_dir/stdout-text" || :
  if limited; then
    printf 'GEMINI_USAGE_LIMIT\n' >&2
    printf 'gemini-listen: %s is out of %s quota; retry with --model %s or later\n' "$account" "$model_key" \
      "$([ "$model_key" = pro ] && printf flash || printf pro)" >&2
    exit 3
  fi
  if [ "$rc" -ne 0 ] && grep -Eqi 'out of the worker pool|treating every account as out of the pool' "$tmp_dir/stderr" "$tmp_dir/stdout-text"; then
    say "account $account refused by the worker pool" 4
  fi
  if [[ "$last_line" =~ ^CANNOT_OPEN ]]; then
    say "agy could not open a file: ${last_line#CANNOT_OPEN }" 1
  fi
  [ -n "$answer" ] || { tail -n 20 "$tmp_dir/stderr" >&2; say "agy returned no answer (exit $rc)" 1; }
  deaf=''
  while IFS=$'\t' read -r sent original _; do
    jq -e --arg path "$sent" 'any(.[]; .event == "step_update" and .step_update.state == "DONE" and
        .step_update.tool_name == "view_file" and .step_update.tool_info.parameters.AbsolutePath == $path and
        ((.step_update.tool_info.error // "") == ""))' \
      "$events" >/dev/null || deaf=${deaf:-"the model answered without opening $original"}
    answer=${answer//"$sent"/"$original"}
  done <"$tmp_dir/sent"
  record="$(gemini_account_home "$account")/.gemini/antigravity-cli/brain/$session/.system_generated/logs/transcript_full.jsonl"
  while IFS=$'\t' read -r sent original kind && [ -z "$deaf" ]; do
    if [ ! -f "$record" ]; then
      deaf="agy kept no record of session $session to show what view_file returned"
    elif ! jq -se --arg path "$sent" --arg kind "$kind/" 'reduce .[] as $step ({calls: [], seen: false};
        if $step.type == "PLANNER_RESPONSE" then .calls += [($step.tool_calls // [])[] | .args.AbsolutePath // ""]
        elif $step.type == "GENERIC" and (.calls | length) > 0 then
          .seen = (.seen or (.calls[0] == $path and any($step.media[]?; .mime_type | startswith($kind))))
          | .calls |= .[1:]
        else . end) | .seen' "$record" >/dev/null; then
      deaf="view_file gave the model $original without its $kind"
    fi
  done <"$tmp_dir/sent"
  if [ -z "$deaf" ] && [ -n "$heard_lines" ] && [[ "$first_line$last_line" =~ NO_AUDIO ]]; then
    deaf="the model says view_file gave it no sound"
  fi
  if [ -z "$deaf" ] && [ -n "$beep_counts" ]; then
    if ! [[ "$first_line" =~ ^[[:space:]]*BEEPS ]] ||
      [ "$(printf '%s\n' "$first_line" | sed 's/: */:/g' | grep -Eo '[0-9]+:[0-9]+' | sort | tr '\n' ' ')" != "$want_beeps" ]; then
      deaf="the model did not hear the test beeps (BEEPS$beep_counts wanted, its first line: ${first_line:0:80})"
    else
      answer=$(printf '%s\n' "$answer" | awk 'cut == 0 { if (NF) cut = 1; next } cut == 1 && !NF { next } { cut = 2; print }')
    fi
  fi
  verdict=''
  if [ -z "$deaf" ] && [ -n "${GEMINI_LISTEN_WINNER:-}" ]; then
    verdict=$(printf '%s\n' "$last_line" | tr -d '*`' | sed -nE 's/^[[:space:]]*WINNER: (first|second|tie)[[:space:]]*$/\1/p')
    [ -n "$verdict" ] || deaf="the reply's last line is not WINNER: first|second|tie (it is: ${last_line:0:80})"
  fi
  [ -n "$deaf" ] || break
  [ "$attempt" -lt 2 ] || say "$deaf, in $attempt calls; the answer is not grounded" 1
  printf 'gemini-listen: %s; asking again\n' "$deaf" >&2
done

model_label=${observed_model:-$agy_model}
body=$(printf '<!-- %s -->\n%s\n' "$model_label" "$answer")
verdict_line=''
[ -z "$verdict" ] || verdict_line="verdict=$verdict"$'\n'
footer=$(printf 'dest=%s\naccount=%s\nsession=%s\nmodel=%s\nfiles=%s proxied=%s\n%s%scalls=%s\n%sseconds=%s' \
  "${out:--}" "$account" "$session" "$model_label" "${#media[@]}" "$proxied" "$proxy_lines" "$heard_lines" "$attempt" \
  "$verdict_line" "$(($(date +%s) - started))")
if [ -n "$out" ]; then
  printf '%s\n' "$body" >"$out"
  printf '%s\n' "$footer"
else
  printf '%s\n' "$body"
  printf '%s\n' "$footer" >&2
fi
exit
}

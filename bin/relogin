#!/usr/bin/env bash
# relogin — a fresh login of an account with no password typed: the vendor CLI's own login waits, the account's
# browser session clicks through its consent, and the store is revived. bin/claude-relogin is `relogin claude`.
# usage: relogin <claude|codex|gemini|grok> <account> [--on <node>] [--dry-run]
#
# claude, the flow Egor proved by hand (2026-11-13): (1) `claude auth login --claudeai` with a BROWSER stub that
# writes the authorize URL (localhost:<port>/callback redirect) to a file while the process waits for the callback;
# (2) `worker-run browse --window <account>` brings the account's Chrome profile up (the only way Chrome starts); (3) a
# codex Computer Use run of share/briefs/claude-cli-login.md opens the URL there and clicks through Google to
# Authorize, stopping on any password, code, captcha, passkey or other email; (4) `claude auth status` shows the
# registry email and `claudeb revive` clears auth_needed. bin/llm-refresh starts it detached for a logged-out account.
#
# codex, gemini (agy) and grok log a node in (--on only). The CLI's login waits there under a sandbox that denies
# LaunchServices: an ssh session still opens URLs in the node's desktop browser (codex started Dia on mac-m1).
# share/oauth_consent.py clicks through in the account's hidden Chrome clone here, chatgpt_web's profile for codex and
# gemini_web's for gemini and grok (its Google session carries the xAI sign-in), and the email that clone's store
# records is the one the login must show. codex: `codex login`'s
# 127.0.0.1:1455 callback rides the ssh forward. grok: `grok login --device-auth`, its device page approved here, no
# forward. agy has no login command: `agy -p /usage` in a pty waits 60 s for the code antigravity.google's page shows;
# the clone catches it and expect types it there on the node. Their revive is `llm-limits --refresh-account`, a usage
# read.
#
# --on <node> gives another Mac (an ssh name, `machines`) its OWN login of the account, so the node refreshes its own
# token and keeps working with this Mac off; a copied login would not, its refresh token being single-use. Steps 1
# and 4 and the revive run on the node (claude's in its desktop session, `sudo -n launchctl asuser`: an ssh session
# cannot read the login keychain); the clicks stay here, where the Chrome profiles are, and an ssh forward of the
# callback port carries a localhost redirect to the node's waiting login. Stamps and journal lines are
# <account>@<node> for claude, <vendor>/<account>@<node> for the others.
#
# Exit codes, each with one `REASON:` line (0 prints `RELOGIN:`):
#   0 logged in and revived            2 usage, unknown account or no brief template
#   3 already logged in (refused)      4 no enrolled Chrome profile or hidden clone (refused)
#   5 another relogin is live (lock)   6 cool-down: a real attempt within CLAUDE_RELOGIN_COOLDOWN_S (refused)
#   7 weather: no codex account can serve Computer Use, the clone is busy, the node or a read failed; no attempt
#     stamp, retried next time
#   8 the attempt failed; the waiting login is killed and "login needed" stays
#   9 logged in, but the revive failed
#  10 the node cannot hold a login: its CLI, b tool, jq or llm-limits missing; for claude no passwordless sudo or
#     nobody at its screen
# Every verdict but usage reaches token-attempts.jsonl as kind `relogin`; --dry-run journals, stamps and starts nothing.
# One relogin at a time, whatever its vendor (the claudeb store's claude-relogin.lock), stamps in claude-relogin.json.
{
set -u

resolve_root() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}
root=$(resolve_root)
. "$root/share/store-lock.sh"
. "$root/share/limit-hit.sh"
. "$root/share/run-bounded.sh"
. "$root/share/processes.sh"
. "$root/share/token-journal.sh"
. "$root/share/claude-relogin.sh"
. "$root/share/ssh-mux.sh"

base_dir=$claude_relogin_dir
claude_bin=${CLAUDE_RELOGIN_CLAUDE:-claude}
worker_run=${CLAUDE_RELOGIN_WORKER_RUN:-$root/bin/worker-run}
claudeb_bin=${CLAUDE_RELOGIN_CLAUDEB:-$root/bin/claudeb}
brief_template=${CLAUDE_RELOGIN_BRIEF:-$root/share/briefs/claude-cli-login.md}
if [ -n "${CLAUDE_RELOGIN_CONSENT:-}" ]; then consent=("$CLAUDE_RELOGIN_CONSENT")
else consent=("$(command -v uv || printf /opt/homebrew/bin/uv)" run -q --script "$root/share/oauth_consent.py"); fi
seconds() { [[ "${!1:-}" =~ ^[1-9][0-9]*$ ]] && printf '%s' "${!1}" || printf '%s' "$2"; }
url_wait=$(seconds CLAUDE_RELOGIN_URL_WAIT_S 30)
run_timeout=$(seconds CLAUDE_RELOGIN_RUN_TIMEOUT_S 1200)
login_wait=$(seconds CLAUDE_RELOGIN_LOGIN_WAIT_S 60)
status_timeout=$(seconds CLAUDE_RELOGIN_STATUS_TIMEOUT_S 30)
revive_timeout=$(seconds CLAUDE_RELOGIN_REVIVE_TIMEOUT_S 240)
# machines' ssh options: no prompt, and a node that sleeps mid-call drops the session in ~30 s instead of hanging it.
read -r -a node_ssh <<<"${CLAUDE_RELOGIN_SSH:-ssh -o BatchMode=yes -o ConnectTimeout=10 -o LogLevel=ERROR -o ServerAliveInterval=10 -o ServerAliveCountMax=3}"

vendor='' account='' node='' key='' dry_run=false work='' login_pid='' node_pid='' forward='' locked=false prev_stamp=null

usage() { printf 'usage: relogin <claude|codex|gemini|grok> <account> [--on <node>] [--dry-run]\n' >&2; exit 2; }
note() { printf 'relogin: %s: %s\n' "$key" "$*" >&2; }

# One verdict: journal (kind relogin), one REASON line, the exit code.
verdict() { # code outcome text
  $dry_run || token_journal "$key" relogin "$2"
  printf 'REASON: %s — %s\n' "$2" "$3"
  exit "$1"
}

# The node's half, a POSIX sh script read from ssh's stdin: `sh -s -- <verb> <vendor> <account> [args]`. Every
# claude or claudeb call goes through the desktop session, where the login keychain is open (an ssh session gets
# "User interaction is not allowed", rc 36); the other CLIs keep their login in files (agy in its profile's own
# keychain file, which an ssh session opens). Exits 10 for a node that cannot hold a login, with the why on stdout.
node_script=$(cat <<'NODE'
set -u
verb=$1 vendor=$2 account=$3
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH
# The vendor table: the profile, the tools a login needs, where the CLI's printed sign-in URL starts.
case $vendor in
  claude) profile="$HOME/.claude-profiles/$account" tools='claude claudeb jq' url_re='' ;;
  codex) profile="$HOME/.codex-profiles/$account" tools='codex codexb jq llm-limits' url_re='https://auth\.openai\.com/oauth/authorize\?' ;;
  gemini) profile="$HOME/.gemini-profiles/$account" tools='agy geminib jq llm-limits expect' url_re='https://accounts\.google\.com/o/oauth2/' ;;
  grok) profile="$HOME/.grok-profiles/$account" tools='grok grokb jq llm-limits' url_re='https://accounts\.x\.ai/[A-Za-z0-9/._-]*\?user_code=' ;;
  *) echo "no vendor $vendor"; exit 2 ;;
esac
urlc='[A-Za-z0-9._~:/?#@!$&()*+,;=%-]*'
row='any(.vendors[$v].accounts[]?; .account == $a and .auth_needed != true and .auth != "needs_login")'
gui() { sudo -n launchctl asuser "$(id -u)" sudo -n -u "$(id -un)" env HOME="$HOME" PATH="$PATH" "$@"; }
# LaunchServices denied: a CLI that opens its sign-in page opens nothing on the node.
nols='(version 1)(allow default)(deny mach-lookup (global-name-regex #"^com\.apple\.(coreservices\.launchservicesd|lsd\.)"))'
case $verb in
  ready)
    for tool in $tools; do
      command -v "$tool" >/dev/null 2>&1 || { echo "no $tool on its PATH (machines install <node>)"; exit 10; }
    done
    [ "$vendor" = claude ] || exit 0
    sudo -n true 2>/dev/null || { echo "no passwordless sudo, so an ssh session cannot reach its keychain"; exit 10; }
    [ "$(stat -f %Su /dev/console 2>/dev/null)" = "$(id -un)" ] ||
      { echo "$(id -un) is not logged in at its screen, so no keychain is open"; exit 10; } ;;
  # {"loggedIn": bool, "email": …}, the login's own identity; no output when it cannot be read.
  status)
    case $vendor in
      claude) gui env CLAUDE_CONFIG_DIR="$profile" "$(command -v claude)" auth status --json ;;
      codex)
        [ -s "$profile/auth.json" ] || { echo '{"loggedIn":false}'; exit 0; }
        in=false
        ! CODEX_HOME="$profile" codex login status >/dev/null 2>&1 || in=true
        jq -c --argjson in "$in" '{loggedIn: $in, email: (try (.tokens.id_token | split(".")[1] | gsub("-"; "+")
          | gsub("_"; "/") | (. + ("=" * ((4 - length % 4) % 4))) | @base64d | fromjson | .email) catch null)}' \
          "$profile/auth.json" ;;
      grok)
        [ -s "$profile/auth.json" ] || { echo '{"loggedIn":false}'; exit 0; }
        jq -c '(if type != "object" then null elif (.key | type) == "string" then .
          else first(.[]? | select(type == "object" and (.key | type) == "string")) end) // {}
          | {loggedIn: ((.email // "") != "" and (.refresh_token // "") != ""), email: (.email // null)}' "$profile/auth.json" ;;
      gemini)
        kc="$profile/Library/Keychains/gemini.keychain-db" blob=''
        if [ -f "$kc" ]; then
          HOME="$profile" security unlock-keychain -p "$(cat "$profile/.keychain-password" 2>/dev/null)" "$kc" >/dev/null 2>&1 || exit 1
          blob=$(HOME="$profile" security find-generic-password -s gemini -a antigravity -w "$kc" 2>/dev/null) &&
            blob=$(printf '%s' "${blob#go-keyring-base64:}" | base64 -D 2>/dev/null)
        fi
        [ -n "$blob" ] || blob=$(cat "$profile/.gemini/antigravity-cli/antigravity-oauth-token" 2>/dev/null)
        [ -n "$blob" ] || { echo '{"loggedIn":false}'; exit 0; }
        printf '%s' "$blob" | jq -c '{loggedIn: (((.token // .).refresh_token // "") != ""), email: (.id_token_email // null)}' ;;
    esac ;;
  logout)
    case $vendor in
      claude) gui env CLAUDE_CONFIG_DIR="$profile" "$(command -v claude)" auth logout ;;
      codex) CODEX_HOME="$profile" codex logout ;;
      grok) GROK_HOME="$profile" grok logout ;;
      gemini)
        kc="$profile/Library/Keychains/gemini.keychain-db"
        [ ! -f "$kc" ] || HOME="$profile" security delete-generic-password -s gemini -a antigravity "$kc" >/dev/null 2>&1
        rm -f "$profile/.gemini/antigravity-cli/antigravity-oauth-token" ;;
    esac ;;
  # claudeb revive; for the others a usage read that writes the node's row, which must then show no login needed.
  revive)
    [ "$vendor" != claude ] || { gui "$(command -v claudeb)" revive "$account"; exit; }
    llm-limits --refresh-account "$vendor/$account" >/dev/null 2>&1
    llm-limits --json --no-write 2>/dev/null | jq -e --arg v "$vendor" --arg a "$account" "$row" >/dev/null ||
      { echo "llm-limits shows no $vendor/$account row free of login needed"; exit 1; } ;;
  # 0 when the node's store holds the account with no login flag: nothing left to do.
  snapshot)
    [ "$vendor" != claude ] ||
      { jq -e 'type == "object" and .auth_needed != true' "$HOME/.claude-profiles/.claudeb/limits/$account.json" >/dev/null 2>&1; exit; }
    llm-limits --json --no-write 2>/dev/null | jq -e --arg v "$vendor" --arg a "$account" "$row" >/dev/null ;;
  # The waiting login: PID= and URL= lines (agy's also CODE=, the file its pty waits for) as soon as the URL is known,
  # EXIT= when it ends; a watchdog ends it after $5 s, so a caller that died without its cleanup leaves none waiting.
  login)
    work=$(mktemp -d "${TMPDIR:-/tmp}/relogin.XXXXXX") || exit 1
    printf '#!/bin/sh\nfor u; do :; done\nprintf "%%s\\n" "$u" >>"%s/url"\n' "$work" >"$work/browser"
    chmod 755 "$work/browser"
    case $vendor in
      claude)
        mkdir -p "$profile"
        gui /bin/sh -c 'echo $$ >"$1/pid"; exec env CLAUDE_CONFIG_DIR="$2" BROWSER="$1/browser" "$3" auth login --claudeai </dev/null >"$1/log" 2>&1' \
          sh "$work" "$profile" "$(command -v claude)" >/dev/null 2>&1 & ;;
      codex)
        [ -d "$profile" ] || LLM_LIMITS_ANNOUNCE_SUPPRESS=1 codexb add "$account" >/dev/null 2>&1
        sandbox-exec -p "$nols" /bin/sh -c 'echo $$ >"$1/pid"; exec env CODEX_HOME="$2" "$3" login </dev/null >"$1/log" 2>&1' \
          sh "$work" "$profile" "$(command -v codex)" >/dev/null 2>&1 & ;;
      grok)
        mkdir -p "$profile"
        sandbox-exec -p "$nols" /bin/sh -c 'echo $$ >"$1/pid"; exec env GROK_HOME="$2" "$3" login --device-auth </dev/null >"$1/log" 2>&1' \
          sh "$work" "$profile" "$(command -v grok)" >/dev/null 2>&1 & ;;
      gemini)
        [ -d "$profile" ] || LLM_LIMITS_ANNOUNCE_SUPPRESS=1 geminib add "$account" >/dev/null 2>&1
        mkdir "$work/bin" && ln -s ../browser "$work/bin/open"
        # agy takes a pasted code only from a terminal (a pipe on stdin is a prompt, and it refuses the login): expect
        # holds a pty, waits for the code file the caller writes, types it, and never logs a line holding it.
        cat >"$work/agy.exp" <<'EXP'
lassign $argv nols home path agy codefile
set timeout 1
spawn -noecho sandbox-exec -p $nols env HOME=$home PATH=$path $agy -p /usage --output-format json
while {![file exists $codefile]} {
  expect -re {\x1b\[6n} { send "\x1b\[1;1R" } eof { catch wait r; exit [lindex $r 3] } timeout {}
}
set f [open $codefile]; set code [string trim [read $f]]; close $f; file delete $codefile
log_user 0
send -- "$code\r"
set timeout -1
expect -re {[^\n]*\n} { if {[string first $code $expect_out(0,string)] < 0} { puts -nonewline $expect_out(0,string) }; exp_continue } eof {}
catch wait r
exit [lindex $r 3]
EXP
        echo "CODE=$work/code"
        /bin/sh -c 'echo $$ >"$1/pid"; cd "$1"; exec expect -f "$1/agy.exp" "$4" "$2" "$1/bin:$PATH" "$3" "$1/code" </dev/null >"$1/log" 2>&1' \
          sh "$work" "$profile" "$(command -v agy)" "$nols" >/dev/null 2>&1 & ;;
    esac
    holder=$! pid='' n=0
    while [ ! -s "$work/url" ] && [ "$n" -lt $(($4 * 5)) ]; do
      [ -n "$pid" ] || pid=$(cat "$work/pid" 2>/dev/null)
      [ -z "$pid" ] || kill -0 "$pid" 2>/dev/null || break
      if [ -n "$url_re" ]; then
        u=$(grep -Eo "$url_re$urlc" "$work/log" 2>/dev/null | head -n 1)
        [ -z "$u" ] || printf '%s\n' "$u" >"$work/url"
      fi
      sleep 0.2
      n=$((n + 1))
    done
    [ -n "$pid" ] || pid=$(cat "$work/pid" 2>/dev/null)
    echo "PID=$pid"
    [ ! -s "$work/url" ] || sed -n '1s/^/URL=/p' "$work/url"
    ( sleep "$5" & s=$!; trap 'kill $s 2>/dev/null; exit 0' TERM; wait $s; [ -z "$pid" ] || kill "$pid" 2>/dev/null ) &
    watchdog=$!
    rc=0
    wait "$holder" || rc=$?
    kill "$watchdog" 2>/dev/null
    wait "$watchdog" 2>/dev/null
    # Gone before the last lines: a caller that hangs up first ends this script on the write (SIGPIPE).
    tail=$(grep -v 'https://' "$work/log" 2>/dev/null | tail -n 3)
    rm -rf "$work"
    printf '%s\nEXIT=%s\n' "$tail" "$rc" ;;
  # The waiting login, ended by the pid its PID= line named.
  stop) kill "$4" 2>/dev/null; : ;;
esac
NODE
)

# node_run <seconds> <verb> [args...]: the verb on the node, bounded; 255 is ssh's own failure.
node_run() {
  local limit=$1
  shift
  run_bounded "$limit" "${node_ssh[@]}" "$node" sh -s -- "$1" "$vendor" "$account" "${@:2}" <<<"$node_script"
}

cleanup() {
  node_stop
  forward_end
  if [ -n "$login_pid" ] && kill -0 "$login_pid" 2>/dev/null; then process_tree_end "$login_pid" 2; fi
  [ -z "$node" ] || ssh_mux_close "${node_ssh[@]}" "$node"
  ! $locked || store_lock_release "$claude_relogin_lock"
  [ -z "$work" ] || rm -rf "$work"
}

# Cool-down stamps: {key: {at, verdict}} under the state file's own lock.
state_write() { # jq filter over $old, $a, $now, $v, $prev
  local lock="$claude_relogin_state.lock" old tmp
  mkdir -p "${claude_relogin_state%/*}" 2>/dev/null || return 0
  store_lock_acquire "$lock" || return 0
  old=$(jq -c 'if type == "object" then . else {} end' "$claude_relogin_state" 2>/dev/null) || old=''
  [ -n "$old" ] || old='{}'
  tmp="$claude_relogin_state.tmp.$$"
  if jq -n --argjson old "$old" --arg a "$key" --argjson now "${EPOCHSECONDS:-$(date +%s)}" \
      --arg v "${2:-}" --argjson prev "$prev_stamp" "$1" >"$tmp" 2>/dev/null; then
    mv -f "$tmp" "$claude_relogin_state" || rm -f "$tmp"
  else
    rm -f "$tmp"
  fi
  store_lock_release "$lock"
}
stamp() { state_write '$old + {($a): {at: $now, verdict: $v}}' "$1"; }
# Weather is no attempt: the stamp the attempt wrote goes back to what it was.
unstamp() { state_write 'if $prev == null then $old | del(.[$a]) else $old + {($a): $prev} end'; }

auth_status() { # -> {"loggedIn", "email"} of the account's login, here or on the node
  if [ -n "$node" ]; then node_run "$status_timeout" status 2>/dev/null; return; fi
  run_bounded "$status_timeout" env CLAUDE_CONFIG_DIR="$profile_dir" "$claude_bin" auth status --json 2>/dev/null
}

# The node's login ends with the ssh session that holds it; one still held is stopped there by its pid, and the
# session is given a moment to end by itself, so the node's script tidies up before the hang-up.
node_stop() {
  local waited=0
  if [ -n "$node_pid" ] && [ -n "$login_pid" ] && kill -0 "$login_pid" 2>/dev/null; then
    node_run 20 stop "$node_pid" >/dev/null 2>&1
    while kill -0 "$login_pid" 2>/dev/null && [ "$waited" -lt 15 ]; do sleep 0.2; waited=$((waited + 1)); done
  fi
  node_pid=''
}

# The callback port's forward lives in the run's ssh master; it ends with the login it served.
forward_end() {
  [ -n "$forward" ] || return 0
  run_bounded 20 "${node_ssh[@]}" -O cancel -L "$forward" "$node" </dev/null >/dev/null 2>&1
  forward=''
}

kill_login() {
  node_stop
  forward_end
  [ -n "$login_pid" ] || return 0
  ! kill -0 "$login_pid" 2>/dev/null || process_tree_end "$login_pid" 2
  wait "$login_pid" 2>/dev/null
  login_pid=''
}

# The revive that clears login needed, on the node when there is one.
revive() { # -> the revive's exit code, its output on stdout
  if [ -n "$node" ]; then node_run "$revive_timeout" revive 2>&1; return; fi
  run_bounded "$revive_timeout" "$claudeb_bin" revive "$account" 2>&1
}

# A failed attempt: the waiting login dies, the stamp stays, the flag is left as it was.
attempt_failed() { # cause text
  kill_login
  verdict 8 "failed:$1" "$2; $hand is the hand fallback"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) dry_run=true ;;
    --on) [ -n "${2:-}" ] && [ -z "$node" ] || usage; node=$2; shift ;;
    -h|--help) usage ;;
    -*) usage ;;
    *) if [ -z "$vendor" ]; then vendor=$1; elif [ -z "$account" ]; then account=$1; else usage; fi ;;
  esac
  shift
done
[ -n "$account" ] || usage
case "$account" in main|-|*[!A-Za-z0-9._-]*) printf 'relogin: not an account name: %s\n' "$account" >&2; exit 2 ;; esac
case "$node" in -*|*[!A-Za-z0-9._@-]*) printf 'relogin: not a node name: %s\n' "$node" >&2; exit 2 ;; esac
# The vendor table, this side: the profiles that name the account here, the hand fallback, the clicks' profile.
case "$vendor" in
  claude)
    profiles_root=${CLAUDE_RELOGIN_PROFILES_ROOT:-$HOME/.claude-profiles}
    hand="\`claudeb profile $account\` + /login" key=$account${node:+@$node} label=$account revive_name='claudeb revive' ;;
  codex|gemini|grok)
    [ -n "$node" ] || { printf 'relogin: a %s login goes to a node: --on <node>\n' "$vendor" >&2; exit 2; }
    profiles_root=$HOME/.$vendor-profiles key=$vendor/$account@$node label=$vendor/$account
    revive_name='llm-limits --refresh-account'
    case "$vendor" in
      codex) hand="\`CODEX_HOME=~/.codex-profiles/$account codex login --device-auth\`" ;;
      gemini) hand="\`geminib profile $account\`" ;;
      grok) hand="\`GROK_HOME=~/.grok-profiles/$account grok login --device-auth\`" ;;
    esac ;;
  *) usage ;;
esac
# The account is this Mac's: its profile here names it, even when the login goes to a node.
profile_dir=$profiles_root/$account
[ -d "$profile_dir" ] || { printf 'relogin: unknown account %s (no %s)\n' "$account" "$profile_dir" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || { printf 'relogin: jq is required\n' >&2; exit 2; }

trap cleanup EXIT
trap 'exit 129' HUP INT TERM

# One relogin at a time, whatever its account or vendor: it owns a Chrome window or clone and a callback port.
if $dry_run; then
  ! claude_relogin_live || verdict 5 busy "another relogin holds $claude_relogin_lock"
else
  mkdir -p "${claude_relogin_lock%/*}" 2>/dev/null
  LLM_STORE_LOCK_RETRIES=1 store_lock_acquire "$claude_relogin_lock" ||
    verdict 5 busy "another relogin holds $claude_relogin_lock"
  locked=true
fi

if [ -n "$node" ]; then
  # One connection carries every node call of the run, the forward included (share/ssh-mux.sh).
  mux_rc=0
  ssh_mux_open "${node_ssh[@]}" "$node" || mux_rc=$?
  [ "$mux_rc" -eq 0 ] ||
    verdict 7 weather "$node did not answer over ssh (exit $mux_rc${SSH_MUX_ERR:+: $(tail -n 1 <<<"$SSH_MUX_ERR")}); \`machines wake $node\` if it sleeps"
  node_ssh+=("${SSH_MUX_OPTS[@]}")
  ready_rc=0
  ready=$(node_run 30 ready 2>&1) || ready_rc=$?
  case "$ready_rc" in
    0) ;;
    10) verdict 10 node-not-ready "$node: $ready" ;;
    *) verdict 7 weather "$node did not answer over ssh (exit $ready_rc${ready:+: $(tail -n 1 <<<"$ready")}); \`machines wake $node\` if it sleeps" ;;
  esac
fi
# The JSON is the answer, not the exit code: the CLI exits 1 for a logged-out profile (2.1.322-2.1.325).
status=$(auth_status)
jq -e 'type == "object" and has("loggedIn")' >/dev/null 2>&1 < <(printf '%s\n' "$status") ||
  verdict 7 weather "$vendor login status gave no answer for $account${node:+ on $node}; retried next time"
if jq -e '.loggedIn == true' >/dev/null 2>&1 < <(printf '%s\n' "$status"); then
  email=$(jq -r '.email // "?"' < <(printf '%s\n' "$status"))
  # A login made by hand leaves the flag until a revive merges a usage read: clear it here, or the heartbeat asks
  # for this account every tick. A node's store may also hold no snapshot yet (a login made there by hand).
  if [ -n "$node" ]; then
    flagged=false
    node_run "$status_timeout" snapshot >/dev/null 2>&1 || flagged=true
  elif jq -e '.auth_needed == true' "$claude_relogin_dir/limits/$account.json" >/dev/null 2>&1; then
    flagged=true
  else
    flagged=false
  fi
  if ! $dry_run && $flagged; then
    revive_rc=0
    revive >/dev/null || revive_rc=$?
    verdict 3 already-logged-in "$account is logged in as $email${node:+ on $node}; login needed cleared by $revive_name (exit $revive_rc)"
  fi
  verdict 3 already-logged-in "$account is logged in as $email${node:+ on $node}; nothing to do"
fi

! claude_relogin_cooling "$key" "${EPOCHSECONDS:-$(date +%s)}" attempt ||
  verdict 6 cooldown "a real attempt on $key ran within ${claude_relogin_cooldown}s ($claude_relogin_state); the hand fallback is $hand${node:+ on $node}"

# Who clicks: claude's enrolled Chrome profile (the worker-run registry), the others' hidden clone and its email.
if [ "$vendor" = claude ]; then
  registry=$(run_bounded 60 "$worker_run" browse --json 2>/dev/null) &&
    jq -e 'type == "object"' >/dev/null 2>&1 < <(printf '%s\n' "$registry") ||
    verdict 7 weather "worker-run browse --json gave no registry; retried next time"
  IFS=$'\t' read -r email chrome_profile < <(jq -r --arg a "$account" '
    .[$a] // {} | select((.email // "") != "" and (.chrome_profile // "") != "") | [.email, .chrome_profile] | @tsv' \
    < <(printf '%s\n' "$registry"))
  if [ -z "${email:-}" ] || [ -z "${chrome_profile:-}" ]; then
    $dry_run || stamp no-profile
    verdict 4 no-profile "$account has no enrolled Chrome profile with an email (worker-run browse --enroll $account); log in by hand: $hand"
  fi
  [ -r "$brief_template" ] || verdict 2 no-brief "the brief template $brief_template is missing"
  through="Chrome profile $chrome_profile"
else
  # The clone's store is gemini_web's (chatgpt_web's for codex): it names the profile and the email it records.
  identity=$(run_bounded 120 "${consent[@]}" "$vendor" "$account" --identity 2>/dev/null)
  jq -e 'type == "object" and has("ok")' >/dev/null 2>&1 < <(printf '%s\n' "$identity") ||
    verdict 7 weather "oauth_consent --identity gave no answer for $account; retried next time"
  IFS=$'\t' read -r email chrome_profile < <(jq -r 'select(.ok == true) | [.email, .profile] | @tsv' < <(printf '%s\n' "$identity"))
  if [ -z "${email:-}" ] || [ -z "${chrome_profile:-}" ]; then
    $dry_run || stamp no-profile
    verdict 4 no-profile "$(jq -r '.reason // "no hidden Chrome clone"' < <(printf '%s\n' "$identity")); log in by hand: $hand on $node"
  fi
  through="the hidden clone $chrome_profile"
fi

if $dry_run; then
  printf 'DRY-RUN: would log %s in%s as %s through %s\n' "$label" "${node:+ on $node}" "$email" "$through"
  exit 0
fi

# The attempt is stamped before anything runs: a relogin killed half way still counts, so a wall never loops.
prev_stamp=$(jq -c --arg a "$key" '.[$a] // null' "$claude_relogin_state" 2>/dev/null) || prev_stamp=null
[ -n "$prev_stamp" ] || prev_stamp=null
stamp attempt

work=$(mktemp -d "${TMPDIR:-/tmp}/relogin.XXXXXX") || attempt_failed workdir 'no scratch directory'
url_file=$work/authorize-url
printf '#!/bin/sh\nprintf '"'"'%%s\\n'"'"' "$1" >>'"'"'%s'"'"'\n' "$url_file" >"$work/browser"
chmod +x "$work/browser"

# Step 1: the waiting login; the stub stands in for the browser and only writes the URL down.
note "step 1: $vendor login${node:+ on $node}"
url_ticks=$((url_wait * 5))
if [ -n "$node" ]; then
  # The ssh session lasts as long as the login there: PID= and URL= first, EXIT= once the callback has landed.
  node_run $((url_wait + run_timeout + login_wait + 180)) login "$url_wait" $((url_wait + run_timeout + login_wait + 120)) \
    >"$work/login.log" 2>&1 &
  url_ticks=$((url_ticks + 75))
else
  CLAUDE_CONFIG_DIR="$profile_dir" BROWSER="$work/browser" "$claude_bin" auth login --claudeai \
    </dev/null >"$work/login.log" 2>&1 &
fi
login_pid=$!
url='' waited=0
while [ "$waited" -lt "$url_ticks" ]; do
  if [ -n "$node" ]; then
    url=$(sed -n 's/^URL=//p' "$work/login.log" 2>/dev/null | head -n1)
    [ -z "$url" ] || break
  elif [ -s "$url_file" ]; then IFS= read -r url <"$url_file"; break; fi
  kill -0 "$login_pid" 2>/dev/null || break
  sleep 0.2
  waited=$((waited + 1))
done
[ -z "$node" ] || node_pid=$(sed -n 's/^PID=\([1-9][0-9]*\)$/\1/p' "$work/login.log" 2>/dev/null | head -n1)
# A CLI that prints the URL instead of opening it still names it in its own output.
[ -n "$url" ] || url=$(grep -Eo 'https://[^[:space:]]*authorize[^[:space:]]*' "$work/login.log" 2>/dev/null | head -n1)
kill -0 "$login_pid" 2>/dev/null ||
  attempt_failed login-exited "$vendor login exited before the callback: $(grep -v 'https://' "$work/login.log" 2>/dev/null | tail -n 3 | tr '\n' ' ')"
# The URL's shape per vendor: the localhost callback port to forward (claude, codex), or none.
port='' fhost=localhost
case "$vendor" in
  claude)
    [[ $url =~ localhost(%3A|:)([0-9]+)(%2F|/)callback ]] ||
      attempt_failed no-authorize-url "no authorize URL with a localhost callback within ${url_wait}s"
    port=${BASH_REMATCH[2]} ;;
  codex)
    [[ $url =~ redirect_uri=http(%3A|:)(%2F|/)(%2F|/)(localhost|127\.0\.0\.1)(%3A|:)([0-9]+)(%2F|/)auth(%2F|/)callback ]] ||
      attempt_failed no-authorize-url "no authorize URL with a localhost callback within ${url_wait}s"
    fhost=${BASH_REMATCH[4]} port=${BASH_REMATCH[6]} ;;
  grok)
    [[ $url == https://accounts.x.ai/*user_code=* ]] ||
      attempt_failed no-authorize-url "no device URL carrying its user code within ${url_wait}s" ;;
  gemini)
    [[ $url == https://accounts.google.com/* && $url == *antigravity.google%2Foauth-callback* ]] ||
      attempt_failed no-authorize-url "no Google authorize URL with antigravity's callback within ${url_wait}s" ;;
esac
[ -s "$url_file" ] || printf '%s\n' "$url" >"$url_file"

if [ -n "$node" ] && [ -n "$port" ]; then
  # The redirect reaches this Mac's localhost:<port>; the forward carries it to the node's waiting login. A port
  # that answers before the forward is another login's here: the redirect would land there.
  if [ "$(curl -s -o /dev/null -m 2 -w '%{http_code}' "http://localhost:$port/" 2>/dev/null)" != 000 ]; then
    kill_login
    unstamp
    verdict 7 weather "port $port already answers on this Mac (another login holds it); retried next time"
  fi
  # Ready once that login answers through it (any HTTP status: a GET of / leaves it waiting).
  # The run's master holds it, beside the login's own session: no second connection.
  forward_rc=0
  run_bounded 20 "${node_ssh[@]}" -O forward -L "$port:$fhost:$port" "$node" </dev/null >"$work/forward.log" 2>&1 ||
    forward_rc=$?
  [ "$forward_rc" -ne 0 ] || forward=$port:$fhost:$port
  answer=000 waited=0
  while [ "$waited" -lt 75 ] && [ "$forward_rc" -eq 0 ]; do
    answer=$(curl -s -o /dev/null -m 2 -w '%{http_code}' "http://localhost:$port/" 2>/dev/null) || answer=000
    [ "$answer" = 000 ] || break
    sleep 0.2
    waited=$((waited + 1))
  done
  if [ "$answer" = 000 ]; then
    kill_login
    unstamp
    verdict 7 weather "no forward of port $port to the login on $node: $(tail -n 1 "$work/forward.log" 2>/dev/null)"
  fi
fi

if [ "$vendor" = claude ]; then
  # Step 2: the account's Chrome profile, brought up the one way Chrome may start.
  note "step 2: worker-run browse --window"
  run_bounded 120 "$worker_run" browse --window "$account" >"$work/window.out" 2>&1 ||
    attempt_failed window "worker-run browse --window $account failed: $(tail -n 1 "$work/window.out" 2>/dev/null)"

  # Step 3: the clicks, a codex Computer Use run of the stock brief.
  note "step 3: Computer Use run (callback port $port)"
  brief=$(awk '/^```/ { n++; next } n == 1' "$brief_template")
  [ -n "$brief" ] || attempt_failed no-brief "the brief template $brief_template holds no fenced brief"
  brief=${brief//"<account>"/"$account"}
  brief=${brief//"<email>"/"$email"}
  brief=${brief//"<profile dir>"/"$chrome_profile"}
  brief=${brief//"<url file>"/"$url_file"}
  brief=${brief//"<port>"/"$port"}
  printf '%s\n' "$brief" >"$work/brief"
  run_rc=0
  run_bounded "$run_timeout" "$worker_run" run auto --brief "$work/brief" --workdir "$work" >"$work/run.out" 2>&1 || run_rc=$?
  if [ "$run_rc" -eq 124 ]; then
    run_id=$(sed -n 's/^RUN: //p' "$work/run.out" | head -n1)
    [ -z "$run_id" ] || run_bounded 60 "$worker_run" stop "$run_id" >/dev/null 2>&1
    attempt_failed run-timeout "the Computer Use run passed ${run_timeout}s${run_id:+ (run $run_id stopped)}"
  fi
  # No codex account (or no Computer Use service) to serve the run is weather: nothing was clicked.
  if grep -Eq '^OUTCOME: (CODEX_UNAVAILABLE|CODEX_USAGE_LIMIT)|^REASON: codex computer use unavailable' "$work/run.out"; then
    kill_login
    unstamp
    verdict 7 weather "no codex account can serve Computer Use now: $(grep -Em1 '^(OUTCOME|REASON): ' "$work/run.out")"
  fi
  # A refusal before launch (e.g. from inside a headless worker) clicked nothing either: no attempt, retried next time.
  if refusal=$(grep -Em1 '^worker-run: .*Nothing was launched' "$work/run.out"); then
    kill_login
    unstamp
    verdict 7 weather "worker-run launched nothing: ${refusal#worker-run: }"
  fi
  outcome=$(sed -nE 's/^`?(OUTCOME: [A-Z_]+.*)$/\1/p' "$work/run.out" | tail -n1)
  outcome=${outcome%\`}
  case "$outcome" in
    'OUTCOME: COMPUTER_OK'*) ;;
    'OUTCOME: COMPUTER_UNAVAILABLE'*) attempt_failed wall "the Computer Use run stopped: ${outcome#OUTCOME: }" ;;
    *) attempt_failed run "worker-run exited $run_rc with ${outcome:-no OUTCOME line}$(grep -Em1 '^(worker-run|REASON): ' "$work/run.out" | sed 's/^/: /')" ;;
  esac
else
  # Steps 2-3: the clicks in the hidden clone. agy's code is caught there and must reach agy inside its 60 s, so its
  # clone waits at most 30 s for a busy profile.
  note "step 2: share/oauth_consent.py in $chrome_profile"
  code_file=$work/code
  extra=()
  [ "$vendor" != gemini ] || extra=(--code-file "$code_file" --lock-wait 30)
  consent_rc=0
  run_bounded "$run_timeout" "${consent[@]}" "$vendor" "$account" --url-file "$url_file" --email "$email" \
    ${extra[@]+"${extra[@]}"} >"$work/consent.out" 2>"$work/consent.err" || consent_rc=$?
  said=$(jq -r '.reason // empty' "$work/consent.out" 2>/dev/null | tail -n 1)
  [ -n "$said" ] || said=$(tail -n 1 "$work/consent.err" 2>/dev/null)
  case "$consent_rc" in
    0) ;;
    4) attempt_failed wall "the hidden clone stopped: $said" ;;
    5) kill_login; unstamp; verdict 7 weather "the hidden clone $chrome_profile is busy: $said; retried next time" ;;
    124) attempt_failed run-timeout "the clicks passed ${run_timeout}s" ;;
    *) attempt_failed run "oauth_consent exited $consent_rc${said:+: $said}" ;;
  esac
  if [ "$vendor" = gemini ]; then
    # The code goes to the file its CODE= line named on the node, whole at once (agy's pty types it from there), and
    # is gone here at once.
    target=$(sed -n 's/^CODE=//p' "$work/login.log" 2>/dev/null | head -n1)
    [[ $target =~ ^/[A-Za-z0-9._/-]+/code$ ]] || { rm -f "$code_file"; attempt_failed no-code-file "agy on $node named no code file"; }
    [ -s "$code_file" ] || attempt_failed no-code "the clone caught no code at antigravity's callback"
    deliver_rc=0
    run_bounded 20 "${node_ssh[@]}" "$node" "umask 077 && cat >'$target.new' && mv '$target.new' '$target'" <"$code_file" \
      >/dev/null 2>&1 || deliver_rc=$?
    rm -f "$code_file"
    [ "$deliver_rc" -eq 0 ] || attempt_failed code-delivery "the code did not reach agy on $node (ssh exit $deliver_rc)"
  fi
fi

# Step 4: the callback lands, then the login's own word and the registry email must agree.
note "step 4: verify"
waited=0
while kill -0 "$login_pid" 2>/dev/null && [ "$waited" -lt $((login_wait * 5)) ]; do sleep 0.2; waited=$((waited + 1)); done
kill_login
status=$(auth_status)
got=$(jq -r 'if .loggedIn == true then (.email // "?") else "" end' 2>/dev/null < <(printf '%s\n' "$status"))
if [ -z "$got" ]; then
  attempt_failed not-logged-in "the clicks reported done, yet $vendor login status shows $account logged out${node:+ on $node}"
fi
if [ "$(tr '[:upper:]' '[:lower:]' < <(printf '%s' "$got"))" != "$(tr '[:upper:]' '[:lower:]' < <(printf '%s' "$email"))" ]; then
  # Another account in this profile would spend the wrong quota under this name: back to logged out.
  if [ -n "$node" ]; then node_run "$status_timeout" logout >/dev/null 2>&1
  else run_bounded "$status_timeout" env CLAUDE_CONFIG_DIR="$profile_dir" "$claude_bin" auth logout >/dev/null 2>&1; fi
  attempt_failed wrong-email "the profile logged in as $got, not $email; logged out again"
fi
# A success leaves no cool-down: the next logout is served at once.
state_write '$old | del(.[$a])'
revive_rc=0
revive >"$work/revive.out" || revive_rc=$?
if [ "$revive_rc" -ne 0 ]; then
  verdict 9 revive-failed "$account is logged in as $email${node:+ on $node}, but $revive_name exited $revive_rc: $(tail -n 1 "$work/revive.out")"
fi
token_journal "$key" relogin success
printf 'RELOGIN: %s logged in as %s%s; revived\n' "$label" "$email" "${node:+ on $node}"
exit; }

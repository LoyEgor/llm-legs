#!/bin/bash
# Read the ClaudeCmdKeys eventtap's own latency ledger: how long each event waited
# in the tap's queue and how long the callback held it, split cold (first key after
# a pause) vs warm. Only the tap's callback records, so a ledger read while the tap is
# stopped holds nothing newer than the moment `claude-keys off` was run.
set -euo pipefail

# Same contract as claude-keys: `hs -c` reports a Lua error as exit 65, but a snippet
# that ran fine against a module that is not loaded exits 0, so the wrapper's own exit
# code comes from what was printed. A leading "!" is that failure marker.
run() {
  local output status=0
  output=$(hs -c "$1") || status=$?
  case "$output" in
    '!'*)
      printf '%s\n' "${output#!}"
      return 1
      ;;
  esac
  printf '%s\n' "$output"
  [ "$status" -eq 0 ]
}

case "${1:-report}" in
  report)
    run 'local m = _G.ClaudeCmdKeys
if not m or not m.latencyReport then print("!module not loaded") else print(m.latencyReport()) end' \
      || exit 1
    ;;
  reset)
    run 'local m = _G.ClaudeCmdKeys
if not m or not m.latencyReset then print("!module not loaded") else m.latencyReset(); print("latency ledger reset") end' \
      || exit 1
    ;;
  *)
    echo "usage: claude-latency [report|reset]" >&2
    exit 2
    ;;
esac

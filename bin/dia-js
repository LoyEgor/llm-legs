#!/usr/bin/env bash
# dia-js (--active | --url-contains <text> | --tab-id <id>) [--file <js>] [--focus]   JS from --file or stdin
# dia-js --list                      every open Dia tab: id, front (1/0), URL, title
# dia-js --relaunch [--auto]         restart a Dia that runs without --enable-applescript-javascript
# dia-js --open                      bring Dia forward, launching a closed one with the flag
# dia-js (--active | --url-contains <text> | --tab-id <id>) --shot <png> [--focus]   PNG of the Dia window showing that tab
# Runs JavaScript in a tab Egor already has open in Dia and prints its result. AppleScript JavaScript
# exists only in a Dia started with the flag, so a Dia without it is quit and reopened with it first;
# --shot needs no flag and never relaunches.
{
set -euo pipefail

DIA_ID=company.thebrowser.dia
DIA_BIN=/Applications/Dia.app/Contents/MacOS/Dia
OSASCRIPT=${DIA_JS_OSASCRIPT:-osascript}
OPEN=${BROWSE_OPEN:-open}
PS=${BROWSE_PS:-ps}
WAIT_S=${DIA_JS_WAIT_S:-30}
STATE_DIR=${DIA_JS_STATE_DIR:-$HOME/.cache/dia-js}
GUARD_S=${DIA_JS_GUARD_S:-120}
POLL_S=${DIA_JS_POLL_S:-0.5}
SCREENCAPTURE=${DIA_JS_SCREENCAPTURE:-screencapture}
WINDOWS=${DIA_JS_WINDOWS:-}
SETTLE_S=${DIA_JS_SETTLE_S:-0.4}

usage() {
  sed -n '2,6s/^# //p' "$0" >&2
  exit 2
}

die() { printf 'dia-js: %s\n' "$*" >&2; exit 1; }

wait_or_die() { # condition message
  wait_for "$WAIT_S" "$1" && return 0
  ! . "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../share/limit-hit.sh" 2>/dev/null ||
    limit_hit dia-js.wait "$WAIT_S" s kill "the Dia relaunch and the JS it was for: $2" 'bin/dia-js:WAIT_S=${'
  die "$2"
}

osa() {
  "$OSASCRIPT" - "$@" <<'APPLESCRIPT'
on run argv
  set mode to item 1 of argv
  set TAB_ to character id 9
  tell application id "company.thebrowser.dia"
    if mode is "count" then
      set n to 0
      repeat with w in windows
        repeat with p in profiles of w
          set n to n + (count of tabs of p)
        end repeat
      end repeat
      return n as text
    end if
    if mode is "front" then
      if (count of windows) is 0 then return ""
      set u to URL of active tab of (item 1 of windows)
      if u is missing value then return ""
      return u
    end if
    if mode is "quit" then
      quit
      return ""
    end if
    if mode is "list" then
      set out to ""
      set frontId to ""
      if (count of windows) > 0 then set frontId to id of active tab of (item 1 of windows)
      repeat with w in windows
        repeat with p in profiles of w
          repeat with t in tabs of p
            set tid to id of t
            set u to URL of t
            if u is missing value then set u to ""
            set n to title of t
            if n is missing value then set n to ""
            set isFront to "0"
            if tid is frontId then set isFront to "1"
            set out to out & tid & TAB_ & isFront & TAB_ & u & TAB_ & n & linefeed
          end repeat
        end repeat
      end repeat
      return out
    end if
    set tid to item 2 of argv
    if mode is "visible" then
      repeat with w in windows
        if (id of active tab of w) is tid then return "1"
      end repeat
      return "0"
    end if
    set doFocus to item 3 of argv
    set js to item 4 of argv
    repeat with w in windows
      repeat with p in profiles of w
        repeat with t in tabs of p
          if (id of t) is tid then
            if doFocus is "1" then
              focus t
              repeat 120 times
                if not (loading of t) then exit repeat
                delay 0.25
              end repeat
            end if
            if mode is "focus" then return "1"
            set r to execute t javascript js
            if r is missing value then return ""
            return r as text
          end if
        end repeat
      end repeat
    end repeat
    error "tab " & tid & " not found" number 1404
  end tell
end run
APPLESCRIPT
}

dia_main() { # prints "flag" or "bare" per Dia main process
  "$PS" -Ao pid=,command= 2>/dev/null | awk -v bin="$DIA_BIN" '
    { sub(/^ *[0-9]+ +/, "") }
    ($0 == bin || index($0, bin " ") == 1) && $0 !~ / --type=/ {
      print (index($0, " --enable-applescript-javascript") ? "flag" : "bare") }'
}

tabs_list() { osa list | awk -F '\t' 'NF >= 3 && !seen[$1]++'; }

dia_windows() { # "<CG window id>\t<window name>" per on-screen Dia window
  if [ -n "$WINDOWS" ]; then
    "$WINDOWS"
    return
  fi
  "$OSASCRIPT" -l JavaScript -e 'ObjC.import("CoreGraphics");
    ObjC.deepUnwrap(ObjC.castRefToObject($.CGWindowListCopyWindowInfo($.kCGWindowListOptionOnScreenOnly, 0)))
      .filter((w) => w.kCGWindowOwnerName === "Dia" && w.kCGWindowLayer === 0 && w.kCGWindowBounds.Height > 100)
      .map((w) => w.kCGWindowNumber + "\t" + (w.kCGWindowName || "")).join("\n")'
}

window_for() { # tab title -> the CG id of the window showing it
  local wins count
  wins=$(dia_windows)
  count=$(printf '%s' "$wins" | grep -c . || true)
  [ "$count" -gt 0 ] || die 'no Dia window on screen (minimized or on another Space)'
  if [ "$count" -gt 1 ]; then
    # Window names read "<profile>: <tab title, cut with …>".
    wins=$(printf '%s\n' "$wins" | awk -F '\t' -v t="$1" '{ n = $2; sub(/^[^:]*: /, "", n); sub(/…$/, "", n) } n != "" && index(t, n) == 1')
    count=$(printf '%s' "$wins" | grep -c . || true)
    [ "$count" -eq 1 ] || die 'several Dia windows on screen and none is told apart by the tab title; leave one on screen'
  fi
  cut -f1 <<<"$wins"
}

wait_for() { # seconds command...
  local deadline=$((SECONDS + $1))
  shift
  until "$@"; do
    [ "$SECONDS" -lt "$deadline" ] || return 1
    sleep "$POLL_S"
  done
}

dia_gone() { [ -z "$(dia_main)" ]; }
dia_flagged() { [ "$(dia_main)" = flag ]; }
dia_answers() { osa count >/dev/null 2>&1; }

restored_count=''
dia_restored() { # the tab count holds still across two polls
  local now
  now=$(osa count 2>/dev/null) || return 1
  [ "$now" -gt 0 ] 2>/dev/null && [ "$now" = "$restored_count" ] && return 0
  restored_count=$now
  return 1
}

relaunch() {
  local front
  wait_or_die dia_answers 'Dia does not answer AppleScript'
  front=$(osa front 2>/dev/null) || front=''
  osa quit >/dev/null 2>&1 || true
  wait_or_die dia_gone "Dia did not quit within ${WAIT_S}s (a dialog may be holding it); nothing relaunched"
  "$OPEN" -b "$DIA_ID" --args --enable-applescript-javascript
  wait_or_die dia_flagged "Dia did not come back with the flag within ${WAIT_S}s"
  restored_count=''
  wait_for "$WAIT_S" dia_restored || true
  if [ -n "$front" ] && ! tabs_list | awk -F '\t' -v u="$front" '$3 == u { found = 1 } END { exit !found }'; then
    "$OPEN" -b "$DIA_ID" "$front"
    printf 'REOPENED: %s\n' "$front" >&2
  fi
  printf 'RELAUNCHED: yes\n' >&2
  printf 'WARNING: Dia was quit and reopened with --enable-applescript-javascript; unsaved input on open pages may be lost\n' >&2
}

pick=''
needle=''
js_file=''
shot=''
focus=0
mode=run
auto=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --active) pick=active; shift ;;
    --url-contains) pick=url; needle=${2:?--url-contains needs text}; shift 2 ;;
    --tab-id) pick=id; needle=${2:?--tab-id needs an id}; shift 2 ;;
    --file) js_file=${2:?--file needs a path}; shift 2 ;;
    --focus) focus=1; shift ;;
    --list) mode=list; shift ;;
    --relaunch) mode=relaunch; shift ;;
    --open) mode=open; shift ;;
    --shot) mode=shot; shot=${2:?--shot needs a .png path}; shift 2 ;;
    --auto) auto=true; shift ;;
    *) usage ;;
  esac
done

state=$(dia_main | head -n1)
case "$mode" in
  open) exec "$OPEN" -b "$DIA_ID" --args --enable-applescript-javascript ;;
  list)
    [ -n "$state" ] || die 'Dia is not running'
    tabs_list
    exit 0
    ;;
  relaunch)
    if [ "$auto" = true ]; then
      [ ! -e "$STATE_DIR/watch-off" ] || { printf 'SKIPPED: watcher off (%s)\n' "$STATE_DIR/watch-off"; exit 0; }
      [ "$state" = bare ] || exit 0
      mkdir -p "$STATE_DIR"
      if [ -e "$STATE_DIR/last-relaunch" ]; then
        age=$(($(date +%s) - $(stat -f %m "$STATE_DIR/last-relaunch")))
        if [ "$age" -lt "$GUARD_S" ]; then
          ! . "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../share/limit-hit.sh" 2>/dev/null ||
            limit_hit dia-js.guard "$GUARD_S" s skip "an automatic Dia relaunch: Dia stays without AppleScript JS until the next try" \
              'bin/dia-js:GUARD_S=${' "$age"
          printf 'SKIPPED: relaunched %ss ago\n' "$age"
          exit 0
        fi
      fi
      touch "$STATE_DIR/last-relaunch"
    fi
    [ -n "$state" ] || die 'Dia is not running'
    [ "$state" = bare ] || { printf 'FLAGGED: yes, nothing to relaunch\n'; exit 0; }
    relaunch
    exit 0
    ;;
esac

choose() { # prints the one matching tab line or dies
  local lines count
  case "$pick" in
    active) lines=$(tabs_list | awk -F '\t' '$2 == "1"') ;;
    url) lines=$(tabs_list | awk -F '\t' -v s="$needle" 'index($3, s)') ;;
    id) lines=$(tabs_list | awk -F '\t' -v s="$needle" '$1 == s') ;;
    exact) lines=$(tabs_list | awk -F '\t' -v s="$needle" '$3 == s') ;;
  esac
  count=$(printf '%s' "$lines" | grep -c . || true)
  [ "$count" -gt 0 ] || die "no open Dia tab matches ($pick${needle:+ $needle}); dia-js --list shows them"
  if [ "$count" -gt 1 ]; then
    printf 'dia-js: %s Dia tabs match (%s %s); pick one with --tab-id:\n' "$count" "$pick" "$needle" >&2
    printf '%s\n' "$lines" | awk -F '\t' '{ printf "  %s  %s  %s\n", $1, $3, $4 }' >&2
    exit 1
  fi
  printf '%s\n' "$lines"
}

[ -n "$pick" ] || usage
[ -n "$state" ] || die 'Dia is not running'
if [ "$mode" = shot ]; then
  target=$(choose)
  tid=$(cut -f1 <<<"$target")
  if [ "$(osa visible "$tid")" != 1 ]; then
    [ "$focus" = 1 ] || die "tab $tid is not the one showing in its Dia window; add --focus to bring it forward (Egor sees the switch)"
    osa focus "$tid" 1 '' >/dev/null
    sleep "$SETTLE_S"
  fi
  wid=$(window_for "$(cut -f4 <<<"$target")")
  rm -f "$shot"
  "$SCREENCAPTURE" -x -o -l "$wid" "$shot" 2>/dev/null && [ -s "$shot" ] ||
    die "screencapture could not grab Dia window $wid (minimized, on another Space, or this terminal lacks Screen Recording)"
  printf '%s\n' "$shot"
  exit 0
fi
if [ -n "$js_file" ]; then
  js=$(cat "$js_file")
else
  [ ! -t 0 ] || die 'no JavaScript: give --file <path> or pipe it on stdin'
  js=$(cat)
fi
[ -n "$js" ] || die 'the JavaScript is empty'


target=$(choose)
if [ "$state" = bare ]; then
  pick=exact needle=$(cut -f3 <<<"$target")
  [ -n "$needle" ] || die 'the tab has no URL to find again after a relaunch'
  relaunch
  target=$(choose)
  focus=1
fi
osa exec "$(cut -f1 <<<"$target")" "$focus" "$js"
exit; }

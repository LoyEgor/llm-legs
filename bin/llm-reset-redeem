#!/usr/bin/env python3
"""Redeem one `<vendor>/<account>` usage-reset consumable, then re-read that account's quota.

A reset is one per period and spending it is Egor's decision. Nothing automated calls the redeem
unless Egor armed that account by his own word: «сделай ресет <account>» (claude-setup's word
intake) or `--arm --word` quoting a prompt of his. The arm is machine-wide and one-shot: the first
machine signal of that account's WEEKLY wall spends one reset and drops it.

    llm-reset-redeem <vendor>/<account>
    llm-reset-redeem --arm <vendor>/<account> --word "<his exact words>"
    llm-reset-redeem --disarm <vendor>/<account>
    llm-reset-redeem --fire-armed [<vendor>/<account> [--wall weekly|unknown]]

Exit codes: 0 redeemed, 2 nothing to redeem, 3 the token was refused, 4 the vendor exposes no
redeem RPC, 5 the call failed without saying anything (weather or a transient error).
"""

from __future__ import annotations

import fcntl
import importlib.util
import json
import os
import subprocess
import sys
import time
import uuid
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "share"))
import account_roster  # noqa: E402
import chat_names  # noqa: E402
import claude_resets  # noqa: E402
import codex_appserver  # noqa: E402
import grok_resets  # noqa: E402

EXIT_REDEEMED = 0
EXIT_USAGE = 2
EXIT_NOTHING = 2
EXIT_EXPIRED = 3
EXIT_NO_BACKEND = 4
EXIT_TRANSIENT = 5

CLAUDEB_DIR = Path(os.environ.get("CLAUDEB_DIR") or Path.home() / ".claude-profiles" / ".claudeb")
LOG_PATH = CLAUDEB_DIR / "reset-redeem.log"


def log(event: str, detail: str) -> None:
    try:
        LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
        with LOG_PATH.open("a") as handle:
            handle.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')}  {event:<18} {detail}\n")
    except OSError:
        pass


LAST_LINE = ""


def report(line: str, code: int) -> int:
    global LAST_LINE
    LAST_LINE = line
    log("exit" if code else "redeemed", f"{line} (exit {code})")
    print(line, file=sys.stderr if code else sys.stdout)
    return code


# The quota pollers' hyphens keep them off the import path, and each vendor's account shape has
# exactly one owner: a second reader here would drift from the poller the menubar's numbers come
# from.
def poller(name: str) -> object:
    spec = importlib.util.spec_from_file_location(name.replace("-", "_"), ROOT / f"{name}.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def touch_grok(account: str) -> bool:
    """One non-interactive CLI subcommand, which rotates the access token as a side effect.

    Never a hand-rolled token POST: the vendor's own CLI is the only thing allowed to refresh.
    """
    grokb = os.environ.get("LLM_RESET_REDEEM_GROKB") or str(ROOT / "bin" / "grokb")
    try:
        subprocess.run([grokb, account, "exec", "models"],
                       capture_output=True, text=True, timeout=90)
    except (OSError, subprocess.SubprocessError):
        return False
    return True


def refresh(target: str) -> bool:
    collector = os.environ.get("LLM_RESET_REDEEM_COLLECTOR") or str(ROOT / "llm-limits.sh")
    try:
        done = subprocess.run(["bash", collector, "--refresh-account", target],
                              capture_output=True, text=True, timeout=180)
    except (OSError, subprocess.SubprocessError):
        return False
    return done.returncode == 0


def redeem_grok(account: str, target: str) -> int:
    module = poller("grok-quota")
    profiles_dir = Path(os.environ.get("GROKB_PROFILES_DIR", "~/.grok-profiles")).expanduser()
    try:
        entry = module.auth_entry(module.resolve(account, profiles_dir))
    except RuntimeError as exc:
        return report(f"{target}: {exc} — the CLI is mid-rotation, try again", EXIT_TRANSIENT)
    if entry is None:
        return report(f"{target}: nobody is logged in — run: grokb add {account}", EXIT_EXPIRED)

    touched = False

    def call(method, *arguments):
        nonlocal touched
        while True:
            try:
                return method(entry["key"], *arguments)
            except grok_resets.AuthError:
                # Only an authentication refusal may be retried: the server rejected the token
                # before doing anything, so nothing was spent. A weather failure on RedeemReset is
                # ambiguous, and a second attempt could spend the consumable twice.
                if touched:
                    raise
                touched = True
                if not touch_grok(account):
                    raise
                try:
                    refreshed = module.auth_entry(module.resolve(account, profiles_dir))
                except RuntimeError:
                    raise grok_resets.AuthError("auth.json was unreadable after the CLI touch") \
                        from None
                if refreshed is None:
                    raise
                entry.update(refreshed)

    try:
        tokens = call(grok_resets.get_remaining_resets)
    except grok_resets.AuthError as exc:
        return report(f"{target}: token rejected ({exc}) — run: grokb {account} exec models",
                      EXIT_EXPIRED)
    except grok_resets.TransientError as exc:
        return report(f"{target}: reset service unavailable ({exc})", EXIT_TRANSIENT)
    if not tokens:
        return report(f"{target}: no usage reset available to redeem", EXIT_NOTHING)

    # The menu shows the soonest deadline the poller published, so that is the grant this spends:
    # taking an arbitrary one lets the deadline the user was reading lapse unused.
    dated = [token for token in tokens if isinstance(token.get("validity_end"), int)]
    spending = min(dated, key=lambda token: token["validity_end"]) if dated else tokens[0]

    try:
        # `token_id` is the period's grant id, shared across accounts — it names the reset being
        # spent, never the account spending it.
        remaining = call(grok_resets.redeem_reset, spending["token_id"])
    except grok_resets.AuthError as exc:
        return report(f"{target}: token rejected ({exc}) — run: grokb {account} exec models",
                      EXIT_EXPIRED)
    except grok_resets.TransientError as exc:
        return report(f"{target}: redeem failed ({exc}) — check the account before retrying",
                      EXIT_TRANSIENT)

    line = f"{target}: usage reset redeemed — {len(remaining)} left"
    if not refresh(target):
        line += " (quota re-read failed; press Refresh)"
    return report(line, EXIT_REDEEMED)


CODEX_CONSUME_METHOD = "account/rateLimitResetCredit/consume"
# `alreadyRedeemed` is a success here and nowhere else: the idempotency key below is derived from
# the credit, so the call it collides with is this tool's own earlier attempt, which landed.
CODEX_OUTCOMES = {"reset": EXIT_REDEEMED, "alreadyredeemed": EXIT_REDEEMED,
                  "nothingtoreset": EXIT_NOTHING, "nocredit": EXIT_NOTHING}
IDEMPOTENCY_NAMESPACE = uuid.UUID("0f1d6b6a-2f2a-5a3e-9c41-6f7a1d0e5b82")


def outcome_tokens(value: object):
    """Every word the reply states an outcome in, punctuation stripped.

    Values only. A key is a field name, not an answer: a reply carrying `{"nothingToReset": false,
    "outcome": "reset"}` states a reset, and reading the key would report the spent credit as
    nothing redeemed. Matching whole normalized words rather than substrings keeps `resetType`
    from reading as a redeemed `reset`.
    """
    if isinstance(value, str):
        if value:
            yield "".join(character for character in value if character.isalnum()).lower()
    elif isinstance(value, dict):
        for item in value.values():
            yield from outcome_tokens(item)
    elif isinstance(value, list):
        for item in value:
            yield from outcome_tokens(item)


def codex_outcome(result: dict) -> tuple[str | None, int | None]:
    for token in outcome_tokens(result):
        if token in CODEX_OUTCOMES:
            return token, CODEX_OUTCOMES[token]
    return None, None


def redeem_codex(account: str, target: str) -> int:
    module = poller("codex-quota")
    _, codex_home = module.parse_target(account, Path.home())
    timeout = float(os.environ.get("CODEX_QUOTA_TIMEOUT", "30"))
    rejected = f"{target}: token rejected — run: codexb run {account} login"

    try:
        snapshot = codex_appserver.call(codex_home, module.READ_METHOD, {}, timeout,
                                        "rateLimits/read")
    except TimeoutError as exc:
        return report(f"{target}: {exc}", EXIT_TRANSIENT)
    except OSError as exc:
        return report(f"{target}: could not run the codex CLI ({exc})", EXIT_TRANSIENT)
    except RuntimeError as exc:
        if module.authentication_required(str(exc)):
            return report(rejected, EXIT_EXPIRED)
        return report(f"{target}: reset read failed ({exc})", EXIT_TRANSIENT)

    published = snapshot.get("rateLimitResetCredits")
    if not isinstance(published, dict):
        published = {}
    credit = next((item["id"] for item in published.get("credits") or []
                   if isinstance(item, dict) and item.get("status") == "available"
                   and isinstance(item.get("id"), str) and item["id"]), None)
    if credit is None:
        count = published.get("availableCount")
        # The count and the id come from two different halves of the same payload, and a summary
        # without the `credits` array leaves the menu showing a reset this tool cannot name.
        if isinstance(count, (int, float)) and not isinstance(count, bool) and count >= 1:
            return report(f"{target}: {int(count)} usage reset published but its credit details "
                          "are unavailable — redeem it from the vendor UI", EXIT_NOTHING)
        return report(f"{target}: no usage reset available to redeem", EXIT_NOTHING)

    # Derived from the credit, never random: a reply lost in transit leaves the owner free to click
    # again, and the vendor answers the retry `alreadyRedeemed` instead of spending a second reset.
    key = str(uuid.uuid5(IDEMPOTENCY_NAMESPACE, f"{target}/{credit}"))
    try:
        result = codex_appserver.call(
            codex_home, CODEX_CONSUME_METHOD, {"creditId": credit, "idempotencyKey": key},
            timeout, "rateLimitResetCredit/consume")
    except TimeoutError as exc:
        return report(f"{target}: {exc} — check the account before retrying", EXIT_TRANSIENT)
    except OSError as exc:
        return report(f"{target}: could not run the codex CLI ({exc})", EXIT_TRANSIENT)
    except RuntimeError as exc:
        if module.authentication_required(str(exc)):
            return report(rejected, EXIT_EXPIRED)
        return report(f"{target}: redeem failed ({exc}) — check the account before retrying",
                      EXIT_TRANSIENT)

    log("codex-consume", json.dumps(result, sort_keys=True))
    token, code = codex_outcome(result)
    if code == EXIT_NOTHING:
        return report(f"{target}: nothing redeemed — {token}", EXIT_NOTHING)
    # An unrecognized outcome still went through, and a second attempt could cost a second reset,
    # so it counts as spent; the raw reply is in the log for whoever teaches this the real name.
    line = f"{target}: usage reset redeemed"
    if token == "alreadyredeemed":
        line += " — an earlier attempt under this credit's key had already landed"
    elif token is None:
        line += f" — unrecognized outcome, see {LOG_PATH}"
    if not refresh(target):
        line += " (quota re-read failed; press Refresh)"
    return report(line, EXIT_REDEEMED)


PENDING_PATH = LOG_PATH.with_name("reset-redeem-pending.json")


def pending_requests() -> dict:
    try:
        pending = json.loads(PENDING_PATH.read_text())
    except (OSError, ValueError):
        return {}
    return pending if isinstance(pending, dict) else {}


def save_pending(key: str, request_id: str | None) -> None:
    pending = pending_requests()
    if request_id is None:
        pending.pop(key, None)
    else:
        pending[key] = request_id
    temporary = PENDING_PATH.with_name(f".{PENDING_PATH.name}.{os.getpid()}")
    try:
        PENDING_PATH.parent.mkdir(parents=True, exist_ok=True)
        temporary.write_text(json.dumps(pending, sort_keys=True))
        os.replace(temporary, PENDING_PATH)
    except OSError:
        pass


CLAUDE_OUTCOMES = {"reset": EXIT_REDEEMED, "already_used": EXIT_REDEEMED,
                   "not_limited": EXIT_NOTHING, "cooldown": EXIT_NOTHING,
                   "ineligible": EXIT_NOTHING, "unavailable": EXIT_TRANSIENT}


def redeem_claude(account: str, target: str) -> int:
    hint = f"press Refresh in the menubar or open Claude Code on {account}, then try again"
    try:
        token = claude_resets.access_token(account)
    except claude_resets.AuthError as exc:
        return report(f"{target}: {exc} — {hint}", EXIT_EXPIRED)
    organization = claude_resets.organization_uuid(account)
    if organization is None:
        return report(f"{target}: no organizationUuid in the profile's .claude.json — open Claude "
                      f"Code on {account}", EXIT_EXPIRED)

    try:
        program = claude_resets.read_program(token)
    except claude_resets.AuthError as exc:
        return report(f"{target}: token rejected ({exc}) — {hint}", EXIT_EXPIRED)
    except claude_resets.TransientError as exc:
        return report(f"{target}: reset read failed ({exc})", EXIT_TRANSIENT)
    grant = claude_resets.choose_grant(program) if program is not None else None
    if grant is None:
        reason = (program or {}).get("ineligible_reason")
        return report(f"{target}: no usage reset available to redeem"
                      + (f" ({reason})" if isinstance(reason, str) and reason else ""),
                      EXIT_NOTHING)

    # A POST without a reply keeps its request id until one arrives: a reset that landed has
    # already lowered resets_left, so a re-derived id would spend a second reset instead of
    # colliding into `already_used`.
    pending_key = f"{target}/{grant['id']}"
    request_id = pending_requests().get(pending_key)
    if not isinstance(request_id, str) or not claude_resets.REQUEST_ID_RE.match(request_id):
        request_id = str(uuid.uuid5(IDEMPOTENCY_NAMESPACE,
                                    f"{target}/{grant['id']}/{grant['resets_left']}"))
    save_pending(pending_key, request_id)
    try:
        result = claude_resets.reset(token, organization, grant["id"], request_id)
    except claude_resets.AuthError as exc:
        return report(f"{target}: token rejected ({exc}) — {hint}", EXIT_EXPIRED)
    except claude_resets.TransientError as exc:
        return report(f"{target}: redeem failed ({exc}) — check the account before retrying",
                      EXIT_TRANSIENT)
    save_pending(pending_key, None)

    log("claude-reset", json.dumps(result, sort_keys=True))
    outcome = result.get("result")
    code = CLAUDE_OUTCOMES.get(outcome) if isinstance(outcome, str) else None
    if code is not None and code != EXIT_REDEEMED:
        reason = result.get("reason")
        return report(f"{target}: nothing redeemed — {outcome}"
                      + (f" ({reason})" if isinstance(reason, str) and reason else ""), code)
    line = f"{target}: usage reset redeemed"
    if outcome == "already_used":
        line += " — an earlier attempt under this grant's request id had already landed"
    elif code is None:
        line += f" — unrecognized outcome, see {LOG_PATH}"
    elif isinstance(result.get("resets_left"), int):
        line += f" — {result['resets_left']} left"
    mark_claude_reset(account)
    if not refresh(target):
        line += " (quota re-read failed; press Refresh)"
    return report(line, EXIT_REDEEMED)


def mark_claude_reset(account: str) -> None:
    """bin/statusline.sh reads this to stop idle chats re-walling the account with pre-reset readings."""
    marker = CLAUDEB_DIR / "limits" / f"{account}.reset-at"
    try:
        marker.parent.mkdir(parents=True, exist_ok=True)
        tmp = marker.with_name(f".{marker.name}.{os.getpid()}")
        tmp.write_text(f"{int(time.time())}\n")
        os.replace(tmp, marker)
    except OSError:
        pass


REDEEMERS = {"claude": redeem_claude, "codex": redeem_codex, "grok": redeem_grok}
ARM_DIR = LOG_PATH.with_name("reset-arm")
ATTEMPTS_MAX = 3
ATTEMPT_GAP_S = 600
WORD_WINDOW_S = 24 * 3600
# A test pointing any of these at a fixture while the arms resolve to the real store would spend a
# real reset on a fake wall.
FIXTURE_SEAMS = ("LLM_LIMITS_CACHE", "WORKER_WALLS_DIR", "CLAUDE_RESETS_ENDPOINT",
                 "GROK_RESETS_ENDPOINT")


def split_target(target: str) -> tuple[str, str] | None:
    vendor, _, account = target.partition("/")
    if not vendor or not account or "/" in account or ".." in account or account[0] == ".":
        return None
    return vendor, account


def arm_path(vendor: str, account: str) -> Path:
    return ARM_DIR / f"{vendor}-{account}"


def write_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}")
    temporary.write_text(text)
    os.replace(temporary, path)


def limits_cache() -> str:
    return os.environ.get("LLM_LIMITS_CACHE") or str(Path.home() / ".llm-limits.json")


def roster() -> dict[str, list[str]]:
    accounts = {}
    for vendor in REDEEMERS:
        try:
            accounts[vendor] = account_roster.roster(vendor)
        except account_roster.Unreadable:
            accounts[vendor] = []
    return accounts


def arm_words(names: list, words: str, by: str,
              only: tuple[str, str] | None = None) -> list[str]:
    """Arm every account his words name: the one arm path, for the word intake and the CLI alike.

    `names` are `(vendor or None, name)` pairs in the order he said them. A bare name held by
    several vendors arms nothing from his prompt, since one would spend a reset he did not mean
    (`<name>: which vendor? …`); the CLI's `only` names the vendor. Names are read up to the first
    one no vendor has, and when that is the first, nothing is armed. One reading per target, or
    `<name>: no such account`.
    """
    accounts = roster()
    targets, unresolved, ambiguous = [], None, []
    for vendor, name in names:
        found = [(candidate, account) for candidate in ([vendor] if vendor else REDEEMERS)
                 for account in accounts.get(candidate, ()) if account.casefold() == name.casefold()]
        if not found:
            unresolved = None if targets or ambiguous else name
            break
        if only is not None:
            found = [pair for pair in found if pair == only]
        elif len(found) > 1:
            ambiguous.append(f"{name}: which vendor? " + ", ".join(candidate for candidate, _ in found))
            continue
        targets += [pair for pair in found if pair not in targets]
    now = int(time.time())
    quoted = " ".join(words.split())[:200]
    for vendor, account in targets:
        write_atomic(arm_path(vendor, account), f"{now}\n")
        log("arm", f"{vendor}/{account} by {by} «{quoted}»")
    return [f"{vendor}/{account}" for vendor, account in targets] + ambiguous \
        + ([f"{unresolved}: no such account"] if unresolved else [])


def words_module():
    setup = os.environ.get("CLAUDE_SETUP_ROOT") or str(ROOT.parent / "claude-setup")
    spec = importlib.util.spec_from_file_location("words", Path(setup) / "hooks" / "lib" / "words.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def transcripts():
    cutoff = time.time() - WORD_WINDOW_S
    for root in chat_names.transcript_roots():
        for path in root.glob("*/*.jsonl"):
            try:
                if path.stat().st_mtime >= cutoff:
                    yield path
            except OSError:
                continue


def spoken(words_lib, words: str, account: str) -> Path | None:
    """The transcript holding `words` verbatim in a prompt of his — never model text, a tool
    result, a meta or cross-session message, or a headless run's brief."""
    wanted = words_lib.normalize(words)
    needle = account.encode()
    for path in transcripts():
        try:
            data = path.read_bytes()
        except OSError:
            continue
        if needle not in data:
            continue
        turns = words_lib.human_turns(data.decode("utf-8", "ignore").splitlines(),
                                      words_lib.headless_transcript(str(path)))
        if any(wanted in words_lib.normalize(text) for _, text, _ in turns):
            return path
    return None


def loose_names(words_lib, words: str, vendor: str, account: str) -> list:
    """His own phrasing a model read as a reset ask: a reset word and the account's name, and no
    vendor named but the one armed."""
    tokens = words_lib.tokenize(words_lib.fold(words)[0])
    said = {words_lib.keyword_at(tokens, k)[0] for k in range(len(tokens))}
    vendors = {{"claudeb": "claude"}.get(named, named) for named in map(words_lib.vendor_named, tokens) if named}
    if "reset" in said and account.casefold() in {token.text for token in tokens} and vendors <= {vendor}:
        return [(vendor, account)]
    return []


def arm_cli(vendor: str, account: str, words: str) -> int:
    target = f"{vendor}/{account}"
    if vendor not in REDEEMERS:
        print(f"{target}: NO_REDEEM_BACKEND — {vendor} has no usage-reset consumable",
              file=sys.stderr)
        return EXIT_NO_BACKEND
    words_lib = words_module()
    source = spoken(words_lib, words, account)
    if source is None:
        log("arm-refused", f"{target} «{' '.join(words.split())[:200]}» in no prompt of his")
        print(f"{target}: not armed — these words are in no prompt of Egor's from the last 24 h",
              file=sys.stderr)
        return EXIT_USAGE
    entry = words_lib.classify(words).get("reset") or {}
    names = entry.get("names") or loose_names(words_lib, words, vendor, account)
    armed = arm_words(names, words, f"cli ({source.name})", (vendor, account))
    if target not in armed:
        print(f"{target}: not armed — his words name no reset of {target}", file=sys.stderr)
        return EXIT_USAGE
    print(f"{target}: armed — auto-redeem at the weekly wall")
    return 0


def disarm(vendor: str, account: str, reason: str | None = None) -> None:
    arm_path(vendor, account).unlink(missing_ok=True)
    log("disarm", f"{vendor}/{account}" + (f" — {reason}" if reason else ""))


def alert(line: str) -> None:
    command = os.environ.get("LLM_RESET_REDEEM_ALERT")
    calls = [[command, line]] if command else [
        ["hs", "-q", "-c", f"hs.alert.show({json.dumps(line, ensure_ascii=False)}, 6)"],
        ["osascript", "-e", "on run argv", "-e",
         'display notification (item 1 of argv) with title "Usage reset"', "-e", "end run", line]]
    for call in calls:
        try:
            subprocess.run(call, capture_output=True, timeout=15)
        except (OSError, subprocess.SubprocessError):
            pass


# The weekly half of worker-pick's own wall verdict (share/limits-view.sh), so a row it routes
# around is the row this fires on.
STORE_ROW_JQ = """
  (.vendors[$vendor] // {}) | (.accounts // [.])[]? | select((.account // "main") == $account) |
  {weekly_wall: (limits_store_wall_until({weekly: .weekly}; $now) != null),
   credits: .reset_credits}
"""


def store_row(vendor: str, account: str, now: int) -> dict:
    try:
        defs = subprocess.run(["bash", "-c", '. "$1" && printf %s "$LIMITS_VIEW_JQ"', "_",
                               str(ROOT / "share" / "limits-view.sh")],
                              capture_output=True, text=True, timeout=20).stdout
        done = subprocess.run(["jq", "-c", "--arg", "vendor", vendor, "--arg", "account", account,
                               "--argjson", "now", str(now), defs + STORE_ROW_JQ, limits_cache()],
                              capture_output=True, text=True, timeout=20)
        row = json.loads(done.stdout.splitlines()[0])
    except (OSError, subprocess.SubprocessError, ValueError, IndexError):
        return {}
    return row if isinstance(row, dict) else {}


def number(value: object) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def fire(vendor: str, account: str, now: int, wall: str) -> None:
    """`wall` is the run's own reading of the bucket it hit; anything short of `weekly` defers to
    the collector's cache, and a cache that cannot tell waits for the collector's next write."""
    target = f"{vendor}/{account}"
    try:
        lines = arm_path(vendor, account).read_text().splitlines()
    except OSError:
        return
    attempts = [line.split() for line in lines[1:] if len(line.split()) == 2]
    row = store_row(vendor, account, now)
    if not (wall == "weekly" or row.get("weekly_wall") is True):
        return
    if not number(row.get("credits")) or row["credits"] < 1:
        return
    if attempts and attempts[-1][0].isdigit() and now - int(attempts[-1][0]) < ATTEMPT_GAP_S:
        return
    log("auto-fire", f"{target} at the weekly wall ({'run' if wall == 'weekly' else 'store'})")
    redeemer = REDEEMERS.get(vendor)
    code = redeemer(account, target) if redeemer else report(
        f"{target}: NO_REDEEM_BACKEND — {vendor} has no usage-reset consumable", EXIT_NO_BACKEND)
    line = LAST_LINE
    if code == EXIT_REDEEMED:
        disarm(vendor, account)
        alert(f"Auto-redeemed at the weekly wall · {line}")
        return
    failures = 1 + sum(1 for attempt in attempts if attempt[1] == str(EXIT_TRANSIENT))
    if code in (EXIT_EXPIRED, EXIT_NO_BACKEND) or (code == EXIT_TRANSIENT
                                                   and failures >= ATTEMPTS_MAX):
        reason = line if code != EXIT_TRANSIENT else f"{failures} attempts failed · {line}"
        disarm(vendor, account, reason)
        alert(f"Auto-redeem disarmed · {reason}")
        return
    with arm_path(vendor, account).open("a") as handle:
        handle.write(f"{now} {code}\n")


def fire_armed(only: tuple[str, str] | None, wall: str) -> int:
    if not os.environ.get("CLAUDEB_DIR") and any(os.environ.get(name) for name in FIXTURE_SEAMS):
        return 0
    try:
        names = sorted(os.listdir(ARM_DIR))
    except OSError:
        return 0
    armed = [tuple(name.split("-", 1)) for name in names if "-" in name and not name.startswith(".")]
    if only is not None:
        armed = [pair for pair in armed if pair == only]
    if not armed:
        return 0
    # Two triggers (the collector and a run's wall) can see one wall together; the loser skips,
    # and the winner's landed redeem has consumed the arm by the time anyone looks again.
    with (ARM_DIR / ".lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return 0
        now = int(time.time())
        for vendor, account in armed:
            fire(vendor, account, now, wall if only is not None else "unknown")
    return 0


USAGE = ("usage: llm-reset-redeem <vendor>/<account> | --arm <vendor>/<account> --word '<his words>'"
         " | --disarm <vendor>/<account> | --fire-armed [<vendor>/<account> [--wall weekly|unknown]]")


def main(argv: list[str]) -> int:
    if argv and argv[0].startswith("--"):
        target = split_target(argv[1]) if len(argv) > 1 else None
        if argv[0] == "--disarm" and len(argv) == 2 and target:
            disarm(*target)
            print(f"{argv[1]}: disarmed")
            return 0
        if argv[0] == "--arm" and len(argv) == 4 and argv[2] == "--word" and target:
            return arm_cli(*target, argv[3])
        if argv[0] == "--fire-armed" and (len(argv) == 1 or target) and (
                len(argv) <= 2 or (len(argv) == 4 and argv[2] == "--wall")):
            return fire_armed(target, argv[3] if len(argv) == 4 else "unknown")
        print(USAGE, file=sys.stderr)
        return EXIT_USAGE
    if len(argv) != 1 or "/" not in argv[0]:
        print(USAGE, file=sys.stderr)
        return EXIT_USAGE
    target = argv[0]
    vendor, _, account = target.partition("/")
    if not vendor or not account:
        print(USAGE, file=sys.stderr)
        return EXIT_USAGE
    log("launch", target)
    if vendor in REDEEMERS:
        return REDEEMERS[vendor](account, target)
    return report(f"{target}: NO_REDEEM_BACKEND — {vendor} has no usage-reset consumable",
                  EXIT_NO_BACKEND)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

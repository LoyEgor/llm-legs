#!/usr/bin/env bash
if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  for modern_bash in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [ -x "$modern_bash" ] && exec "$modern_bash" "$0" "$@"
  done
fi
{
# scheduled-suites: the scheduled layer's runner (Egor 2026-11-14: measurement stops gating every landing; it runs on
# main every few hours, and whoever finds a regression, not the chat that made it, gets it to fix). A suite listed in
# a repository's tests/scheduled-suites (`<suite> <period hours> [path...]`; share/affected-suites.sh leaves it out of
# workers' and landings' selections) runs here against main, in a detached worktree of its own (a bench suite sends
# itself to the bench). Per tick, per sweep repository with the list, per suite, one decision and one log line naming
# the box and the reason: not due (no box owed and the period since the last FINISHED run has not passed: no git call
# at all), main unmoved (one rev-parse), main moved in no file the suite covers (tests/affected's selector over the
# moved files), a landing running (a live land-*.lock in the repository: the next tick), owed <box>: <why> (not ready,
# could not run, cut), or ran <box> on main's commit.
# No work, no run (Egor 2026-11-14): the only trigger is main having moved in a covered file since the commit the suite
# last FINISHED on; the period is only the shortest gap between two finished runs. The state is that commit per box,
# so a run that did not happen is owed: a tick after the Mac slept or was off (launchd fires once after a wake,
# RunAtLoad after a boot) pays it once, on the newest main; a cut run (sleep, reboot, kill: its `run` file names a dead
# pid or one from before the boot; or the cap) records nothing, so the next tick runs it again with no period eaten.
# Boxes: where a run goes is data in the list. `box <name> ready <command...>` (from the main checkout; exit 0 = ready,
# else its last line is why), `box <name> says <ERE>` (a line of a run's output that shows the run went there: a suite
# that sends itself, test_swift_perf.sh through tests/rig/bench-entry.sh), `box <name> run <command...>` (how a suite
# is sent there, {} its path; default `bash {}` in the run's worktree). A box with no `ready` is always ready; a run
# went to the box whose `says` matches, else to the one it was sent to. An entry's `boxes=a,b` (default here) is the
# order of preference; `needs=a` names a box whose readings no other box takes (the bench's time readings): main owes
# it a run even after another box ran it, paid when it is ready, never reported twice (the open failure is one).
# Could not run (a box not ready; exit 125 or 75, a SKIP line, a non-zero exit with no FAIL line; red at the box's last
# good commit too, so the cause is not in the diff) is not a failure: no bisect, no handoff; the box stays owed, tried
# again after the period, and owed past SCHEDULED_SUITES_OWED_S (a day) one limit hit (scheduled-suites.owed) tells
# the harness doctor, once.
# PASS records the commit as last good (and settles an open failure's handoff, when the box that reported it or a
# `needs` box passes). FAIL runs once more (flakes); red twice and green at the box's last good, the first bad commit
# is searched between them: first-parent commits touching covered files,
# halved, each step the same suite on the same box, at most SCHEDULED_SUITES_STEPS (6) steps, a step that does not
# build (could not run, or went to another box) skipped as git bisect does. A box with no green commit of its own (its
# first run) searches from the newest commit another box finished green on, once a control there passes on it ("green
# on <box> at <sha>; first run on <this box>"); no green commit anywhere, or red at that one too: "red at <sha>, first
# measured", no commit named. "was" readings come from the same box's green run; another box's are labelled with it,
# and left out for a key whose budget differs by box (`(budget N, m1)`, or another budget); each key once, the later
# reading. One report per failure: a handoff docs/handoffs/<date>-scheduled-<suite>-
# <sha>.md in the repository's main checkout (untracked; share/handoffs.py and the night's carry take it from there:
# its owner chat by the edits of the commit's files, else a night job; the LLM doctor names it once 60 h open), and
# the line every tests/affected run there prints (`scheduled: ...`). Red again while reported: logged, nothing sent.
# State and the log (scheduled.log, one line a decision) in ~/Library/Application Support/scheduled-suites, never in
# Caches; never two ticks at once.
#   scheduled-suites [tick]          one tick (what the LaunchAgent runs every 15 min)
#   scheduled-suites status          per repository, suite and box: finished on, owed since and why, an open failure
#   scheduled-suites retry           a tick that asks an owed box now, whatever it tried last (he says the box is free)
#   scheduled-suites --install-agent the LaunchAgent com.llm-legs.scheduled-suites (via ~/.local/libexec/scheduled-suites); idempotent
# State per suite: ran tested good checked (the 9f866159 files, read as they are: any box), open, open.box, run (a live
# run: pid box start); per box box-<name>/: done good ran checked tried owed (`<since> <why>`) told.
# Env: SCHEDULED_SUITES_DIR (state), SCHEDULED_SUITES_REPOS (default the sweep list), SCHEDULED_SUITES_STEPS,
# SCHEDULED_SUITES_CAP_S (one suite run's bound, 5400), SCHEDULED_SUITES_OWED_S (86400), SCHEDULED_SUITES_NOW and
# SCHEDULED_SUITES_BOOT (epochs, tests).
set -u
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE

resolve_script() {
  local source="${BASH_SOURCE[0]}" directory
  [[ $source == */* ]] || source=./$source
  while [ -L "$source" ]; do
    directory=$(cd -P "${source%/*}" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "${source%/*}" && printf '%s/%s\n' "$PWD" "${source##*/}"
}

script_path=$(resolve_script)
legs=${script_path%/*/*}
. "$legs/share/affected-suites.sh"
. "$legs/share/store-lock.sh"
. "$legs/share/processes.sh"
. "$legs/share/limit-hit.sh"
DIR=${SCHEDULED_SUITES_DIR:-$HOME/Library/Application Support/scheduled-suites}
LOG=$DIR/scheduled.log
REPOS=${SCHEDULED_SUITES_REPOS:-${NIGHT_RUN_SWEEP_REPOS:-$HOME/.claude/sweep-repos}}
STEPS=${SCHEDULED_SUITES_STEPS:-6}
CAP=${SCHEDULED_SUITES_CAP_S:-5400}
OWED_S=${SCHEDULED_SUITES_OWED_S:-86400}
LABEL=com.llm-legs.scheduled-suites
PLIST=$HOME/Library/LaunchAgents/$LABEL.plist
# launchd runs the wrapper (Login Items show its name; harness-doctor's DEPLOYS watches it), the wrapper this script.
wrapper="$HOME/.local/libexec/scheduled-suites"
INTERVAL=900

now_s() { echo "${SCHEDULED_SUITES_NOW:-$(date +%s)}"; }
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; [ ! -t 1 ] || printf '%s\n' "$*"; }
ago() { local s=$1; [ "$s" -ge 86400 ] && echo "$((s / 86400)) d $((s % 86400 / 3600)) h" || echo "$((s / 3600)) h $((s % 3600 / 60)) min"; }
first_line() { local v=''; read -r v 2>/dev/null <"$1"; printf '%s' "$v"; }
put() { printf '%s\n' "$2" >"$1"; }
boot_s() { # the kernel's boot epoch: a pid written before it is no process of this boot
  [ -z "${SCHEDULED_SUITES_BOOT:-}" ] || { echo "$SCHEDULED_SUITES_BOOT"; return; }
  sysctl -n kern.boottime 2>/dev/null | sed -nE 's/.*sec = ([0-9]+).*/\1/p'
}
from_boot() { # file -> 0 when it was written in this boot
  local m b
  m=$(store_lock_mtime "$1") && b=$(boot_s) && [ -n "$b" ] || return 0
  [ "$m" -ge "$b" ]
}

install_agent() {
  local want wrapper_tmp
  mkdir -p "$DIR" "${wrapper%/*}"
  if ! grep -qxF "exec $(printf %q "$script_path") \"\$@\"" "$wrapper" 2>/dev/null; then
    wrapper_tmp=$(mktemp "$wrapper.tmp.XXXXXX") || return 1
    printf '#!/usr/bin/env bash\nexec %q "$@"\n' "$script_path" >"$wrapper_tmp"
    chmod 755 "$wrapper_tmp"
    mv -f "$wrapper_tmp" "$wrapper"
  fi
  want=$(cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$wrapper</string>
        <string>tick</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartInterval</key>
    <integer>$INTERVAL</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>$DIR/agent.log</string>
    <key>StandardErrorPath</key>
    <string>$DIR/agent.log</string>
</dict>
</plist>
EOF
)
  if [ "$(cat "$PLIST" 2>/dev/null)" = "$want" ] && launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then
    echo "scheduled-suites: agent $LABEL already loaded"; return 0
  fi
  mkdir -p "${PLIST%/*}"
  printf '%s\n' "$want" >"$PLIST"
  launchctl bootout "gui/$(id -u)/$LABEL" >/dev/null 2>&1 || true
  # bootout answers before a running tick's job is gone, and bootstrap then fails (seen 2026-11-14): a few tries.
  local wait loaded=0
  for wait in 0 1 2 4; do
    sleep "$wait"
    launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null && { loaded=1; break; }
  done
  [ "$loaded" = 1 ] || { echo "scheduled-suites: launchctl bootstrap $PLIST failed" >&2; return 1; }
  echo "scheduled-suites: agent $LABEL loaded (every $((INTERVAL / 60)) min); log $LOG; remove: launchctl bootout gui/\$(id -u)/$LABEL; rm $PLIST"
}

land_running() { # repo -> "pid N" of a live landing there
  local lock pid
  for lock in "$1"/.git/land-*.lock; do
    pid=$(first_line "$lock/pid")
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && { printf 'pid %s, %s' "$pid" "${lock##*/}"; return 0; }
  done
  return 1
}

covers() { # files... -> 0 when the suite ($repo, $suite, $paths) covers one: its own file, a listed path, the selector
  local f names hit
  [ "$#" -gt 0 ] || return 1
  for f in "$@"; do
    [ "$f" != "tests/$suite" ] || return 0
    for p in ${paths[@]+"${paths[@]}"}; do [ "$f" != "$p" ] || return 0; done
  done
  names=$(mktemp "${TMPDIR:-/tmp}/scheduled.XXXXXX") || return 0
  printf '%s\n' "$@" >"$names"
  hit=$(printf '%s\n' "$repo/tests/$suite" | affected_filter "$repo" "$names" 2>/dev/null | grep -cxF "$repo/tests/$suite")
  rm -f "$names"
  [ "${hit:-0}" -gt 0 ]
}

run_at() { # sha log box -> "<pass|fail|skip|cut> <the box it went to>": the suite at sha in its own detached worktree
  local sha=$1 out=$2 sent=$3 wt=$st/wt pid watch rc gitdir cmd went='' b
  if [ -e "$wt/.git" ]; then
    # A cut run's index.lock (only this runner, under the tick lock, uses the tree) would refuse every checkout.
    gitdir=$(git -C "$wt" rev-parse --absolute-git-dir 2>/dev/null) && rm -f "$gitdir/index.lock"
    git -C "$wt" checkout -q --force --detach "$sha" >"$out" 2>&1 || { echo "skip $sent"; return; }
  else
    git -C "$repo" worktree prune 2>/dev/null
    git -C "$repo" worktree add -q --force --detach "$wt" "$sha" >"$out" 2>&1 || { echo "skip $sent"; return; }
  fi
  cmd=${box_run[$sent]:-bash \{\}} cmd=${cmd//\{\}/tests/$suite}
  (cd "$wt" && exec env -u WORKER_RUN_ID -u WORKER_RUN_RECORD -u CLAUDE_CODE_SESSION_ID -u CLAUDE_LAUNCHER_SESSION \
    bash -c "$cmd") >"$out" 2>&1 </dev/null &
  pid=$!
  put "$st/run" "$pid $sent $(now_s)"
  (end=$((SECONDS + CAP)); while kill -0 "$pid" 2>/dev/null; do
    [ "$SECONDS" -lt "$end" ] || { printf 'scheduled-suites: ended past %s s\n' "$CAP" >>"$out"; process_tree_end "$pid" 10; break; }
    sleep 2; done) &
  watch=$!
  wait "$pid"; rc=$?
  kill "$watch" 2>/dev/null; wait "$watch" 2>/dev/null
  rm -f "$st/run"
  for b in "${boxes[@]}"; do
    [ -n "${box_says[$b]:-}" ] && grep -qE -- "${box_says[$b]}" "$out" && { went=$b; break; }
  done
  went=${went:-$sent}
  if grep -q '^scheduled-suites: ended past ' "$out"; then echo "cut $went"
  elif [ "$rc" -eq 0 ] && grep -q '^SKIP' "$out"; then echo "skip $went"
  elif [ "$rc" -eq 0 ]; then echo "pass $went"
  elif [ "$rc" -eq 125 ] || [ "$rc" -eq 75 ] || ! grep -q '^FAIL' "$out"; then echo "skip $went"
  else echo "fail $went"; fi
}

why_not_run() { # log -> why a run could not run, one line
  local line
  line=$(grep -m1 '^SKIP' "$1" 2>/dev/null) || line=$(grep -v '^[[:space:]]*$' "$1" 2>/dev/null | tail -1)
  printf '%s' "${line:-no output}" | cut -c1-160
}

perf_value() { # log key -> the number a perf line of key reads there (tests/lib/perf-judge.sh's `perf <key>: <n> <unit>`)
  sed -nE "s/^(FAIL: )?perf $2: ([^ ]+) .*/\\2/p" "$1" 2>/dev/null | tail -1
}

perf_line() { # log key -> the last perf line of key there
  grep -E "^(FAIL: )?perf $2: " "$1" 2>/dev/null | tail -1
}
budget_of() { # a perf line -> its budget: `(budget N[, box])`, `(floor N...`, `over budget N`, `under floor N`
  sed -nE 's/.*(\((budget|floor)|over budget|under floor) ([^ ,)]+).*/\3/p' <<<"$1"
}
box_bound() { # now-log was-log key -> 0 when the key's budget differs by box: a line marked for its box (perf-judge's
  # `(budget N, m1)`), or the two runs judged against different budgets
  local a b
  a=$(perf_line "$1" "$3") b=$(perf_line "$2" "$3")
  grep -qE '\((budget|floor) [^,)]+, [^)]+\)' <<<"$a"$'\n'"$b" && return 0
  [ "$(budget_of "$a")" != "$(budget_of "$b")" ]
}

findings() { # now-log was-log [was-box] -> one line a failed budget key, once (the later run's reading: key: was W, now N
  # unit), else the first FAIL lines. A was-log of another box: its reading labelled with the box, none for a key whose
  # budget differs by box; no was-log (no green run anywhere): the reading alone.
  local key got unit was any=''
  while read -r key got unit; do
    any=1 was=''
    if [ -z "$2" ]; then printf -- '- `%s`: now %s %s\n' "$key" "$got" "$unit"; continue; fi
    was=$(perf_value "$2" "$key")
    if [ -n "$3" ] && { [ -z "$was" ] || box_bound "$1" "$2" "$key"; }; then
      printf -- '- `%s`: now %s %s\n' "$key" "$got" "$unit"; continue
    fi
    printf -- '- `%s`: was %s%s, now %s %s\n' "$key" "${was:-unknown}" "${3:+ on $3}" "$got" "$unit"
  done < <(sed -nE 's/^FAIL: perf ([^:]+): ([^ ]+) ([^ ]+) .*/\1 \2 \3/p' "$1" |
    awk '!($1 in v) { o[++n] = $1 } { v[$1] = $0 } END { for (i = 1; i <= n; i++) print v[o[i]] }')
  [ -n "$any" ] || grep '^FAIL' "$1" | awk '!seen[$0]++' | head -3 | cut -c1-300 | sed 's/^/- /'
  [ -n "$any" ] || grep -q '^FAIL' "$1" || printf -- '- no FAIL line; the log: %s\n' "$1"
}

report() { # first-bad last-pass now-log was-log range-note [was-box] [since] -> the handoff and the open line
  # last-pass empty: no green run anywhere to search from, "red at <sha>, first measured", no commit named. was-box:
  # the box was-log's readings are from when not $went; since: the clause naming where the search started (default
  # "passed at <last-pass>").
  local bad=$1 good=$2 now_log=$3 was_log=$4 note=$5 was_box=${6:-} since=${7:-} subject when doc files rel red
  subject=$(git -C "$repo" log -1 --format=%s "$bad" | cut -c1-200)
  when=$(git -C "$repo" log -1 --format=%cd --date=format:'%F %R' "$bad")
  [ -z "$good" ] || files=$(git -C "$repo" diff --name-only "$bad^1" "$bad" 2>/dev/null | head -20 | sed 's/.*/`&`/' | paste -sd, - | sed 's/,/, /g')
  if [ -z "$good" ]; then red="red at ${bad:0:12}, first measured" since=''
  else red="red on main from ${bad:0:12}" since=${since:-passed at ${good:0:12}}; fi
  mkdir -p "$repo/docs/handoffs"
  rel=docs/handoffs/$(date +%F)-scheduled-${suite%.*}-${bad:0:7}.md
  doc=$repo/$rel
  {
    printf '# Hand-off: tests/%s %s (the scheduled run)\n\nStatus: open\n\n' "$suite" "$red"
    printf 'From: bin/scheduled-suites (llm-legs), %s. The suite is in tests/scheduled-suites: no worker or landing runs it, so whoever reads this fixes it, not necessarily the chat of the commit.\n\n' "$(date '+%F %R')"
    if [ -z "$good" ]; then
      printf '## What failed\n\n`tests/%s` on %s is red at main `%s`, first measured: no box finished it green on an earlier commit of main, so no commit is searched or named.\n\n' \
        "$suite" "$went" "${bad:0:12}"
    else
      printf '## What failed\n\n`tests/%s` on %s fails from `%s` (%s; %s): %s\n\n' "$suite" "$went" "${bad:0:12}" "$when" "$since" "$subject"
    fi
    [ -z "$note" ] || printf '%s\n\n' "$note"
    findings "$now_log" "$([ ! -r "$was_log" ] || echo "$was_log")" "$was_box"
    [ -z "$good" ] || printf '\nThe commit'"'"'s files: %s.\n' "${files:-none listed}"
    printf '\n## Settle\n\nFix it on main (or the budget, with its measurement), `tests/run-all %s` to check. The next scheduled pass on main sets this Status to settled by itself. Logs: `%s`%s.\n' \
      "$suite" "$now_log" "$([ ! -r "$was_log" ] || printf ', `%s`' "$was_log")"
  } >"$doc"
  if [ -z "$good" ]; then printf '%s %s: %s\n' "$suite" "$red" "$doc"
  else printf '%s %s %s (%s): %s\n' "$suite" "$red" "$(printf %s "$subject" | cut -c1-80)" "$since" "$doc"; fi >"$st/open"
  put "$st/open.box" "$went"
  log "$tag: ran $went: ${red/#red on main from/red from}${since:+ ($since)}; reported in $rel"
}

settle() { # sha: an open failure's handoff settled by a pass at sha
  local open doc
  open=$(first_line "$st/open")
  doc=${open##*: }
  if [ -f "$doc" ] && grep -qm1 '^Status: open' "$doc"; then
    awk -v s="Status: settled $(date +%F): the scheduled run passed on main at ${1:0:12}" \
      '!done && /^Status:/ { print s; done = 1; next } { print }' "$doc" >"$doc.tmp" && mv "$doc.tmp" "$doc"
  fi
  rm -f "$st/open" "$st/open.box"
  log "$tag: ran $went: green again at ${1:0:12}; settled ${doc#"$repo"/}"
}

bisect() { # good head was-log [was-box] [good-box] [note] -> report the first bad commit on $went: first-parent commits
  # touching covered files, halved; good-box: the box good was green on when not $went (its first run there)
  local good=$1 head=$2 was_log=$3 was_box=${4:-} from=${5:-} first=${6:-} line sha lo hi mid v steps=0 i try found
  local -a cands=() files=() verdict=()
  if [ -z "$good" ] || ! git -C "$repo" merge-base --is-ancestor "$good" "$head" 2>/dev/null; then
    report "$head" '' "$st/head.log" "$was_log" "$first" "$was_box"
    return
  fi
  sha=''
  while IFS= read -r line; do
    if [[ $line == @* ]]; then
      [ -z "$sha" ] || { covers ${files[@]+"${files[@]}"} && cands+=("$sha"); }
      sha=${line#@} files=()
    elif [ -n "$line" ]; then files+=("$line"); fi
  done < <(git -C "$repo" log --first-parent --diff-merges=first-parent --reverse --format=@%H --name-only "$good..$head")
  [ -z "$sha" ] || { covers ${files[@]+"${files[@]}"} && cands+=("$sha"); }
  [ "${#cands[@]}" -gt 0 ] || cands=("$head")
  # cands[lo] passes (lo = -1: the last good), cands[hi] fails (the last covered commit holds main's covered files).
  lo=-1 hi=$((${#cands[@]} - 1))
  while [ $((hi - lo)) -gt 1 ] && [ "$steps" -lt "$STEPS" ]; do
    mid=$(((lo + hi) / 2)) found=''
    # A step that does not build is skipped: the nearest untried commit inside the range instead.
    for try in $(seq 0 $((hi - lo - 2))); do
      for i in $((mid + try)) $((mid - try)); do
        [ "$i" -gt "$lo" ] && [ "$i" -lt "$hi" ] && [ -z "${verdict[$i]:-}" ] || continue
        [ "$steps" -lt "$STEPS" ] || break 3
        steps=$((steps + 1))
        v=$(run_at "${cands[$i]}" "$st/step-${cands[$i]:0:12}.log" "$went")
        # A step on another box than the red run's reads other readings: not judged, as one that does not build.
        case $v in "pass $went" | "fail $went") v=${v%% *} ;; *) v=skip ;; esac
        verdict[$i]=$v
        log "$tag: step $steps at ${cands[$i]:0:12}: $v"
        [ "$v" = skip ] || { found=$i; break 2; }
      done
    done
    [ -n "$found" ] || break
    if [ "${verdict[$found]}" = pass ]; then lo=$found; else hi=$found; fi
  done
  local was=$was_log now=$st/head.log note='' since=''
  [ -z "$from" ] || since="green on $from at ${good:0:12}; first run on $went"
  # A green step ran on $went: its readings are this box's own.
  [ "$lo" -lt 0 ] || { was=$st/step-${cands[$lo]:0:12}.log was_box=''; [ -z "$since" ] || since="passed at ${cands[$lo]:0:12}; $since"; }
  [ ! -r "$st/step-${cands[$hi]:0:12}.log" ] || now=$st/step-${cands[$hi]:0:12}.log
  [ $((hi - lo)) -le 1 ] || note="Not narrowed to one commit (step cap $STEPS or unbuildable steps): the first bad is one of the $((hi - lo)) first-parent commits after $([ "$lo" -lt 0 ] && echo "${good:0:12}" || echo "${cands[$lo]:0:12}") up to this one."
  report "${cands[$hi]}" "$([ "$lo" -lt 0 ] && echo "$good" || echo "${cands[$lo]}")" "$now" "$was" "$note" "$was_box" "$since"
}

green_elsewhere() { # -> good, from: the newest commit another box of the suite finished green on, an ancestor of main
  local b g
  good='' from=''
  for b in "${boxes[@]}"; do
    [ "$b" != "$went" ] || continue
    g=$(first_line "$st/box-$b/good")
    [ -n "$g" ] && git -C "$repo" merge-base --is-ancestor "$g" "$head" 2>/dev/null || continue
    [ -z "$good" ] || git -C "$repo" merge-base --is-ancestor "$good" "$g" 2>/dev/null || continue
    good=$g from=$b
  done
}

declare -A box_ready=() box_says=() box_run=()
read_boxes() { # repo -> box_ready, box_says, box_run from the `box <name> ready|says|run ...` lines of its list
  local name attr rest
  box_ready=() box_says=() box_run=()
  while read -r _ name attr rest; do
    case $attr in ready) box_ready[$name]=$rest ;; says) box_says[$name]=$rest ;; run) box_run[$name]=$rest ;; esac
  done < <(sed 's/#.*//' "$1/tests/scheduled-suites" | awk '$1 == "box" && NF >= 2')
}

entry() { # an entry's words after its period -> paths, boxes (in order; default here), needs
  local w
  local -a words=()
  read -r -a words <<<"$1"
  paths=() boxes=() needs=()
  for w in ${words[@]+"${words[@]}"}; do
    case $w in
      boxes=*) IFS=, read -r -a boxes <<<"${w#boxes=}" ;;
      needs=*) IFS=, read -r -a needs <<<"${w#needs=}" ;;
      *) paths+=("$w") ;;
    esac
  done
  [ "${#boxes[@]}" -gt 0 ] || boxes=(here)
  for w in ${needs[@]+"${needs[@]}"}; do [[ " ${boxes[*]} " == *" $w "* ]] || boxes+=("$w"); done
}
in_needs() { local n; for n in ${needs[@]+"${needs[@]}"}; do [ "$n" != "$1" ] || return 0; done; return 1; }

# The state of 9f866159 has no box-* directory: its files (one record, whichever box ran) stand for every box.
is_legacy() { local d; for d in "$st"/box-*; do [ -d "$d" ] && return 1; done; [ -e "$st/tested" ]; }
box_file() { # box name -> its file; before boxes the suite's own (`done` was `tested` there)
  if [ -z "$legacy" ]; then printf '%s/box-%s/%s' "$st" "$1" "$2"
  elif [ "$2" = 'done' ]; then printf '%s/tested' "$st"
  else printf '%s/%s' "$st" "$2"; fi
}
owed_any() { local f; for f in "$st"/box-*/owed; do [ -e "$f" ] && return 0; done; return 1; }
when() { date -r "$1" '+%F %R'; }

owe() { # box why -> box-<box>/owed (`<since> <why>`, since kept); owed past OWED_S: one limit hit, once
  local f=$st/box-$1 since now
  mkdir -p "$f"
  now=$(now_s) since=$(cut -d' ' -f1 "$f/owed" 2>/dev/null)
  [[ $since =~ ^[0-9]+$ ]] || since=$now
  put "$f/owed" "$since $2"
  if [ $((now - since)) -ge "$OWED_S" ] && [ ! -e "$f/told" ]; then
    limit_hit scheduled-suites.owed "$OWED_S" s defer "${repo##*/} $suite owed on $1 since $(when "$since"): $2" \
      'bin/scheduled-suites:OWED_S=${' "$((now - since))"
    : >"$f/told"
    log "$tag: owed $1 for $(ago $((now - since))): told the doctor (limit hit scheduled-suites.owed)"
  fi
}
paid() { rm -f "$st/box-$1/owed" "$st/box-$1/told" "$st/box-$1/tried"; }

debt() { # done-file checked-file -> 0 owed (debt_why), 1 main unmoved, 2 moved in no covered file (checked written)
  local fin checked list f
  local -a files=()
  fin=$(first_line "$1")
  [ -n "$fin" ] || { debt_why='never finished'; return 0; }
  [ "$head" != "$fin" ] || return 1
  checked=$(first_line "$2")
  [ "$head" != "$checked" ] || return 1
  list=$(git -C "$repo" diff --name-only "$fin" "$head" 2>/dev/null) || { debt_why="its last commit ${fin:0:12} is gone"; return 0; }
  while IFS= read -r f; do [ -z "$f" ] || files+=("$f"); done <<<"$list"
  if covers ${files[@]+"${files[@]}"}; then debt_why="main moved in a covered file since ${fin:0:12}"; return 0; fi
  mkdir -p "${2%/*}"; put "$2" "$head"; return 2
}

finished() { # verdict: main's head finished on $went (pass or fail): the suite's record and the box's
  local f=$st/box-$went b
  mkdir -p "$f"
  put "$st/tested" "$head"; put "$st/checked" "$head"; put "$st/ran" "$now"
  put "$f/done" "$head"; put "$f/checked" "$head"; put "$f/ran" "$now"
  paid "$went"
  if [ "$1" = pass ]; then
    put "$st/good" "$head"; put "$f/good" "$head"; cp "$st/head.log" "$st/good.log"; cp "$st/head.log" "$f/good.log"
  else cp "$st/head.log" "$st/red.log"; fi
  # Any box's run pays the suite's debt; a `needs` box is still owed main until it ran there itself.
  for b in "${boxes[@]}"; do
    [ "$b" != "$went" ] || continue
    if in_needs "$b" && [ "$(first_line "$st/box-$b/done")" != "$head" ]; then
      [ -e "$st/box-$b/owed" ] || owe "$b" "main at ${head:0:12} ran on $went, not here"
    else paid "$b"; fi
  done
}

decide() { # one suite of one repository: the decision, and the run when one is due
  local now ran head v went='' b why last t target='' notes='' legacy='' pay_any='' moved='' rc good c was was_box from first
  local run_pid='' run_box='' run_from=''
  local -A owes=()
  mkdir -p "$st"
  now=$(now_s) ran=$(first_line "$st/ran")
  # A run file left behind is a cut run (sleep, reboot, kill): its pid dead, or one from before the boot. Nothing was
  # recorded, so the period is not eaten; it is owed and runs again now.
  if [ -e "$st/run" ]; then
    read -r run_pid run_box run_from <"$st/run"
    if [ -n "$run_pid" ] && kill -0 "$run_pid" 2>/dev/null && from_boot "$st/run"; then
      log "$tag: a run is live on ${run_box:-?} (pid $run_pid): the next tick"; return 0
    fi
    rm -f "$st/run"
    why="the run started $(when "${run_from:-$now}") was cut (no result)"
    [ -z "$run_box" ] || owe "$run_box" "$why"
    log "$tag: owed ${run_box:-?}: $why"
  fi
  if [ $((now - ${ran:-0})) -lt $((hours * 3600)) ] && ! owed_any; then
    log "$tag: not due (ran $(ago $((now - ran))) ago, every $hours h)"; return 0
  fi
  head=$(git -C "$repo" rev-parse --verify -q refs/heads/main) || { log "$tag: no main"; return 0; }
  ! is_legacy || legacy=1
  # The debts: any box's (since the commit the suite last finished on) and each `needs` box's own.
  debt "$st/tested" "$st/checked"; rc=$?
  case $rc in 0) pay_any=$debt_why ;; 2) moved=1 ;; esac
  for b in ${needs[@]+"${needs[@]}"}; do
    debt "$(box_file "$b" 'done')" "$(box_file "$b" checked)"; rc=$?
    case $rc in 0) owes[$b]=$debt_why ;; 2) moved=1 ;; esac
  done
  if [ -z "$pay_any" ] && [ "${#owes[@]}" -eq 0 ]; then
    for b in "${boxes[@]}"; do paid "$b"; done
    if [ -n "$moved" ]; then log "$tag: main moved to ${head:0:12} in no file the suite covers"
    else log "$tag: main unmoved at ${head:0:12}"; fi
    return 0
  fi
  if v=$(land_running "$repo"); then log "$tag: a landing runs ($v): the next tick"; return 0; fi
  # The first box in order that is owed something, due (its period since its last finished run, or its last could-not-
  # run) and ready.
  for b in "${boxes[@]}"; do
    if in_needs "$b"; then
      [ -n "${owes[$b]:-}" ] || [ -n "$pay_any" ] || continue
      last=$(first_line "$(box_file "$b" ran)")
    else
      [ -n "$pay_any" ] || continue
      last=$ran
    fi
    t=$(first_line "$st/box-$b/tried") why=ran
    [ -n "${RETRY:-}" ] || [ "${t:-0}" -le "${last:-0}" ] || last=$t why=tried  # `retry`: an owed box is asked now
    if [ $((now - ${last:-0})) -lt $((hours * 3600)) ]; then
      notes+="; owed $b: not due ($why $(ago $((now - last))) ago, every $hours h)"; continue
    fi
    # A box not ready is asked again after the period, as one that could not run: the bench's probe wakes the M1's
    # sleeping display (tests/rig/bench), never every 15 min.
    if [ -n "${box_ready[$b]:-}" ] && ! why=$(cd "$repo" && bash -c "${box_ready[$b]}" </dev/null 2>&1); then
      why=$(printf '%s\n' "$why" | grep -v '^[[:space:]]*$' | tail -1 | cut -c1-160)
      owe "$b" "not ready: ${why:-no answer}"; put "$st/box-$b/tried" "$now"
      notes+="; owed $b: not ready: ${why:-no answer}"; continue
    fi
    target=$b; break
  done
  [ -n "$target" ] || { log "$tag: ${notes#; }"; return 0; }
  v=$(run_at "$head" "$st/head.log" "$target"); went=${v#* } v=${v%% *}
  if [ "$v" = fail ]; then
    log "$tag: ran $went: red at ${head:0:12}, run once more"
    v=$(run_at "$head" "$st/head.log" "$went"); went=${v#* } v=${v%% *}
    [ "$v" != pass ] || log "$tag: ran $went: green on the rerun at ${head:0:12} (flaky)"
  fi
  # Red twice with nothing reported: once more at the box's last good. Red there too, the cause is not in the diff.
  # A box with no green commit of its own (its first run) searches from the newest one another box finished green on.
  was='' was_box='' from='' first=''
  if [ "$v" = fail ] && [ ! -e "$st/open" ]; then
    good=$(first_line "$(box_file "$went" good)")
    if [ -n "$good" ]; then [ ! -r "$(box_file "$went" good.log)" ] || was=$(box_file "$went" good.log)
    else green_elsewhere; [ -z "$from" ] || { was=$st/box-$from/good.log was_box=$from; }; fi
    if [ -n "$good" ] && [ "$good" != "$head" ]; then
      c=$(run_at "$good" "$st/control.log" "$went")
      if [ "$c" = "fail $went" ] && [ -n "$from" ]; then
        # Red on its first run at the other box's green commit too: this box's readings, no commit's.
        first="Red on $went at ${good:0:12} too, where $from was green: no commit of main is the cause."
        good='' was=$st/box-$from/good.log
      elif [ "$c" = "fail $went" ]; then v=could-not
        why="red at ${head:0:12} and at its last good ${good:0:12} too: the cause is not in the diff ($(why_not_run "$st/control.log"))"
      elif [ "$c" = "pass $went" ]; then was=$st/control.log was_box=''; fi
    fi
  fi
  case $v in
    cut) owe "$went" "cut at the cap ($CAP s) at ${head:0:12} (no result)"
      log "$tag: owed $went: cut at the cap ($CAP s) at ${head:0:12} (no result): it runs again" ;;
    skip | could-not)
      [ "$v" = could-not ] || why="could not run at ${head:0:12}: $(why_not_run "$st/head.log")"
      mkdir -p "$st/box-$went"; put "$st/box-$went/tried" "$now"
      owe "$went" "$why"; log "$tag: owed $went: $why" ;;
    pass)
      finished pass
      if [ -e "$st/open" ]; then
        b=$(first_line "$st/open.box")
        # Only the box that reported it, or a `needs` box (it reads everything), settles an open failure.
        if [ -z "$b" ] || [ "$b" = "$went" ] || in_needs "$went"; then settle "$head"
        else log "$tag: ran $went: green at ${head:0:12}; the open failure is $b's readings: it stays"; fi
      else log "$tag: ran $went: green at ${head:0:12}"; fi ;;
    fail)
      finished fail
      if [ -e "$st/open" ]; then log "$tag: ran $went: still red at ${head:0:12}, reported: $(first_line "$st/open" | sed 's/.*: //')"
      else bisect "$good" "$head" "$was" "$was_box" "$from" "$first"; fi ;;
  esac
}

tick_lock=$DIR/.tick.lock
tick() {
  local line
  mkdir -p "$DIR"
  # A dead holder's lock store-lock breaks by itself; one written before the boot may name a pid reused since.
  [ ! -e "$tick_lock/pid" ] || from_boot "$tick_lock/pid" || rm -rf "$tick_lock"
  LLM_STORE_LOCK_RETRIES=1 LLM_STORE_LOCK_CEILING_SECONDS=86400 store_lock_acquire "$tick_lock" 2>/dev/null ||
    { log "another tick runs (pid $(first_line "$tick_lock/pid")): this one ends"; return 0; }
  trap 'store_lock_release "$tick_lock"' EXIT
  while IFS= read -r repo; do
    [ -n "$repo" ] && [ -r "$repo/tests/scheduled-suites" ] || continue
    read_boxes "$repo"
    while read -r suite hours line; do
      entry "$line"
      st=$DIR/${repo##*/}/$suite tag="${repo##*/} $suite"
      decide
    done < <(scheduled_list "$repo")
  done <"$REPOS"
}

status() { # per suite one line, then per box: finished on, owed since and why
  local repo suite hours line b legacy d r g o since now run_pid run_box run_from
  now=$(now_s)
  while IFS= read -r repo; do
    [ -n "$repo" ] && [ -r "$repo/tests/scheduled-suites" ] || continue
    while read -r suite hours line; do
      entry "$line"
      st=$DIR/${repo##*/}/$suite legacy=''
      ! is_legacy || legacy=1
      printf '%s %s every %s h%s%s\n' "${repo##*/}" "$suite" "$hours" \
        "$( [ "${#needs[@]}" -eq 0 ] || echo ", needs ${needs[*]}")" "$( [ ! -r "$st/open" ] || echo "; open: $(first_line "$st/open")")"
      if [ -r "$st/run" ]; then
        read -r run_pid run_box run_from <"$st/run"
        printf '  %-6s %s since %s (pid %s)\n' "$run_box" "$(kill -0 "$run_pid" 2>/dev/null && from_boot "$st/run" && echo running || echo 'cut, no result,')" \
          "$(when "$run_from")" "$run_pid"
      fi
      for b in "${boxes[@]}"; do
        d=$(first_line "$(box_file "$b" 'done')") r=$(first_line "$(box_file "$b" ran)") g=$(first_line "$(box_file "$b" good)")
        printf '  %-6s %s' "$b" "$( [ -z "$d" ] && echo 'never finished' ||
          echo "finished on ${d:0:12} $( [ -z "$r" ] || echo "$(ago $((now - r))) ago, ")$( [ "$d" = "$g" ] && echo green || echo red)")"
        [ -z "$legacy" ] || printf ' (state before boxes: any box)'
        o=$(cat "$st/box-$b/owed" 2>/dev/null) since=${o%% *}
        [ -z "$o" ] || printf '; owed since %s (%s): %s%s' "$(when "$since")" "$(ago $((now - since)))" "${o#* }" \
          "$( [ ! -e "$st/box-$b/told" ] || echo '; the doctor told')"
        printf '\n'
      done
    done < <(scheduled_list "$repo")
  done <"$REPOS"
}

case ${1:-tick} in
  tick) tick ;;
  retry) RETRY=1 tick ;;
  status) status ;;
  --install-agent) install_agent ;;
  *) sed -n '/^#   scheduled-suites/p' "$script_path" | sed 's/^# *//' >&2; exit 2 ;;
esac
exit; }

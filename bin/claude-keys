#!/bin/bash
# Toggle the ClaudeCmdKeys eventtap — the only Claude-side component in the keystroke
# path. Use for A/B latency checks: `claude-keys off`, type, compare.
set -euo pipefail

# `hs -c` does report a Lua error as exit 65, but a snippet that ran perfectly well
# against a module that is not loaded exits 0, and so does one whose start did nothing:
# neither is a Lua error, so the wrapper's own exit code has to come from what the
# snippet printed. A leading "!" is that failure marker and never reaches stdout.
run() {
  local output status=0
  output=$(hs -c "$1") || status=$?
  case "$output" in
    '!'*)
      printf '%s\n' "${output#!}"
      return 1
      ;;
  esac
  printf '%s\n' "$output"
  [ "$status" -eq 0 ]
}

case "${1:-status}" in
  off)
    run 'if not _G.ClaudeCmdKeys then print("!module not loaded") else
  _G.ClaudeCmdKeys.stop(); print("ClaudeCmdKeys: stopped (typing bypasses the tap)")
end' || exit 1
    ;;
  on)
    # start() answers nothing worth trusting on every path, and a tap the system
    # refused is exactly the case this command is run to rule out: the state is read
    # back from the module instead of assumed from the call having returned.
    run 'if not _G.ClaudeCmdKeys then print("!module not loaded") else
  _G.ClaudeCmdKeys.start()
  local s = _G.ClaudeCmdKeys.status()
  if s and s.running then
    print("ClaudeCmdKeys: started")
  else
    print("!ClaudeCmdKeys: start failed (the eventtap is not running)")
  end
end' || exit 1
    ;;
  status)
    run 'local s = _G.ClaudeCmdKeys and _G.ClaudeCmdKeys.status()
if not s then print("!module not loaded") else
  print(string.format("%s · lastCallback %.2fms · tty %s", s.running and "running" or "stopped", s.lastCallbackMs or -1, tostring(s.tty)))
end' || exit 1
    ;;
  *)
    echo "usage: claude-keys [off|on|status]" >&2
    exit 2
    ;;
esac

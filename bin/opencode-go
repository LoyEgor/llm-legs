#!/usr/bin/env bash
set -euo pipefail
# Go-plan only by design: the base URL is fixed and run() rejects models outside
# the plan's /models list, so pay-as-you-go Zen models can never be billed.
BASE_URL=https://opencode.ai/zen/go/v1
# Also the name every wall record and last-call stamp is filed under: the keychain service and the
# account llm-limits.sh maps back to a profile are one string by design (shared-invariants row ai),
# so a profile can never wall one and clear the other.
KEY_SERVICE="opencode-go${OPENCODE_GO_PROFILE:+-$OPENCODE_GO_PROFILE}"
# set -u kills the script outright where USER is unset, which is every launchd context.
KEY_ACCOUNT=${USER:-$(id -un)}
response=
authcfg=
probe_errors=
# A `( … )` subshell starts with the parent's EXIT trap reset, so a probe that ends on the refusal
# it went looking for would leave behind the config file holding the bearer token. The request half
# is its own function for exactly that: the probe re-arms it inside the subshell.
cleanup_request() { rm -f ${response:+"$response"} ${authcfg:+"$authcfg"}; }
# BSD mktemp ignores TMPDIR unless it is handed a template, and one of these files carries the
# bearer token: a caller that points TMPDIR somewhere it can watch gets the files there.
new_temp() { mktemp "${TMPDIR:-/tmp}/opencode-go.XXXXXX"; }
cleanup_temp() { cleanup_request; rm -f ${probe_errors:+"$probe_errors"}; }
trap cleanup_temp EXIT
# The key must never reach curl's argv: ps exposes it to every local process.
auth_config() {
  authcfg=$(new_temp)
  chmod 600 "$authcfg"
  printf 'header = "Authorization: Bearer %s"\n' "$1" >"$authcfg"
  printf 'header = "content-type: application/json"\n' >>"$authcfg"
}
WALL_STATE_DIR=${WORKER_STATS_DIR:-${CLAUDEB_DIR:-$HOME/.claude-profiles/.claudeb}/worker-stats}
WALLS_FILE=$WALL_STATE_DIR/walls.jsonl
SEEN_FILE=$WALL_STATE_DIR/opencode-seen/$KEY_SERVICE
LIMITS_CACHE=${LLM_LIMITS_CACHE:-$HOME/.llm-limits.json}
PROFILES_FILE=${OPENCODE_GO_PROFILES:-$HOME/.config/opencode-go/profiles}
# The roster the collector reads, parsed the way llm-limits.sh parses it (shared-invariants row
# al): read any other way, this probes accounts no surface renders and skips ones it does.
roster_profiles() {
  if [[ -r $PROFILES_FILE ]]; then
    sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$PROFILES_FILE" |
      grep -v -e '^#' -e '^$' || true
  else
    printf -- '-\n'
  fi
}
# Whether a recorded wall still stands is llm-limits.sh's to decide; this file only writes down
# what one finished request showed. A stated horizon is capped here, once, by the window it
# belongs to (shared-invariants row ai): a garbled far-future date would otherwise retire the
# account until someone noticed by hand, and no reader re-clamps a value it did not observe.
wall_row() {
  jq -Rsc --arg account "$KEY_SERVICE" --argjson now "$1" '
    def ceiling($w): {"5-hour":21600,"weekly":691200,"monthly":2764800}[$w // ""] // 604800;
    def window:
      ((capture("limitName\"?\\s*[:=]\\s*\"?(?<n>[A-Za-z0-9_.-]+)"; "i") // null) as $m |
       if $m == null then null
       else ($m.n | ascii_downcase | gsub("[^a-z0-9]"; "")) as $n |
         if ($n | test("weekly")) or $n == "week" then "weekly"
         elif ($n | test("monthly")) or $n == "month" then "monthly"
         elif ["5h","5hour","fivehour"] | index($n) then "5-hour"
         else null end
       end);
    def stated_in:
      ((capture("resets? in\\s+(?<v>[0-9]+(\\.[0-9]+)?)\\s*(?<u>second|minute|hour|day|week)s?"; "i")
        // null) as $m |
       if $m == null then null
       else ($m.v | tonumber) *
            {"second":1,"minute":60,"hour":3600,"day":86400,"week":604800}[$m.u | ascii_downcase]
       end);
    # The status code is shared by two unrelated refusals: the plan is spent (days away), and the
    # provider behind it is throttling a burst (seconds). Retiring an account for the second is
    # how an account with its whole quota intact disappears mid-run.
    select(test("GoUsageLimitError|limitName|usage limit|out of credits|insufficient balance"; "i")) |
    window as $w |
    {side:"opencode", account:$account, bucket:"general", detected_at:$now,
     reset_at:(stated_in as $in |
       if $in == null then null else ([$now + $in, $now + ceiling($w)] | min) end),
     window:$w}
    | with_entries(select(.value != null))' "$2"
}
mark_served() {
  local now=$1
  if mkdir -p "${SEEN_FILE%/*}" 2>/dev/null &&
     printf '%s\n' "$now" >"$SEEN_FILE.tmp.$$" 2>/dev/null &&
     mv -f "$SEEN_FILE.tmp.$$" "$SEEN_FILE" 2>/dev/null; then
    return 0
  fi
  rm -f "$SEEN_FILE.tmp.$$" 2>/dev/null
  printf 'opencode-go: the served-call stamp for %s could not be written\n' "$KEY_SERVICE" >&2
  return 1
}
wall_bytes() {
  local size
  size=$(wc -c 2>/dev/null <"$WALLS_FILE" | tr -d ' ')
  printf '%s' "${size:-0}"
}
record_wall() {
  # An append of one short line is atomic on its own; nothing here reads the file back and rewrites
  # it, which is what keeps a 429 landing beside this one from being read and then dropped.
  if mkdir -p "$WALL_STATE_DIR" 2>/dev/null && printf '%s\n' "$1" >>"$WALLS_FILE" 2>/dev/null; then
    return 0
  fi
  printf 'opencode-go: the plan-wall record for %s could not be written\n' "$KEY_SERVICE" >&2
  return 1
}
# The wall goes on record where the 429 happens, so a probe, a worker and review-bench all leave the
# same evidence. Only a served COMPLETION is the opposite evidence: the plan answers /models while
# completions stay walled, so a 2xx from anywhere else says nothing about the wall and nothing about
# when the account was last served. Neither write is ever retired by the clock — llm-limits.sh reads
# the two stamps against each other (shared-invariants row al) and no reader drops a row.
record_call() {
  local status=$1 body=$2 kind=$3 now row
  now=$(date +%s)
  case $status in
    2??)
      [[ $kind == completion ]] || return 0
      mark_served "$now"
      ;;
    429)
      row=$(wall_row "$now" "$body" 2>/dev/null) || row=
      [[ -n $row ]] || return 0
      record_wall "$row"
      ;;
    *) return 0 ;;
  esac
}
usage() {
  cat >&2 <<'EOF'
Usage:
  opencode-go profile <name>  Open a profile; creates it if missing. Alias: p.
  opencode-go key
  opencode-go models [--json]
  opencode-go wall-check [--all] [--probe-clear]
  opencode-go run <model> (<prompt...> | --prompt-file <path>) [--system <text>] [--max-tokens N] [--effort low|medium|high | --no-reasoning] [--prefill <text>] [--answer-must-match <ere>] [--retries N] [--stream] [--json]
  opencode-go raw <path> [json-body]
OPENCODE_GO_PROFILE=<name> selects the account: key/models/run then use the
keychain service opencode-go-<name> (unset = the default opencode-go account).
Only models included in the OpenCode Go subscription are allowed.
wall-check asks whether a recorded usage wall still stands, --all asking it for
every walled account of the leg, and sends nothing at all when none does: the plan publishes no usage figures, so the only way to learn
anything is a real request, and one that succeeds spends the subscription to be
told what the record already said.
--probe-clear sends the probe whether a wall stands or not, --all then asking
every account on the roster rather than the walled ones, and spends one small
completion on each clear account: its age is the stamp of the last completion
the plan served it, so nothing but a real request moves it, and current truth is
what someone refreshing by hand is asking for. Nothing scheduled passes it.
Requests are buffered by default and retried on 5xx, because an upstream that
drops a slow buffered reply usually answers on the next attempt. --stream
survives generations longer than that deadline, but some models then emit
reasoning only and never start the answer; --json assembles either mode into
one completion envelope.
--effort asks for reasoning and --no-reasoning suppresses it, so they cannot be
combined: one would silently overwrite the other.
--answer-must-match names, as an extended regex, what a real answer looks like
for the caller's own contract: a 2xx whose content does not match retires the
reasoning-off strategy the same way an empty one does, which is how a model that
answers inside its reasoning field reaches the next strategy instead of being
recorded as having answered. Unset, only an empty content counts as nothing.
EOF
  exit 64
}
go_key() {
  local key=
  if [[ -n ${OPENCODE_GO_KEY:-} ]]; then
    printf '%s' "$OPENCODE_GO_KEY"
    return
  fi
  if command -v security >/dev/null 2>&1; then
    key=$(security find-generic-password -a "$KEY_ACCOUNT" -s "$KEY_SERVICE" -w 2>/dev/null \
      || security find-generic-password -s "$KEY_SERVICE" -w 2>/dev/null || true)
    if [[ -n $key ]]; then
      printf '%s' "$key"
      return
    fi
  fi
  if [[ -f ${HOME}/.config/opencode-go/key${OPENCODE_GO_PROFILE:+-$OPENCODE_GO_PROFILE} ]]; then
    key=$(<"${HOME}/.config/opencode-go/key${OPENCODE_GO_PROFILE:+-$OPENCODE_GO_PROFILE}")
    key="${key#"${key%%[![:space:]]*}"}"
    key="${key%"${key##*[![:space:]]}"}"
    if [[ -n $key ]]; then
      printf '%s' "$key"
      return
    fi
  fi
  return 1
}
require_key() {
  local key
  if ! key=$(go_key); then
    printf 'No OpenCode Go API key; run opencode-go key\n' >&2
    exit 2
  fi
  printf '%s' "$key"
}
store_key() {
  local service=${1:-$KEY_SERVICE} masked=${2:-false} key= stored= char
  if [[ -t 0 && $masked == true ]]; then
    printf 'OpenCode Go API key: ' >&2
    while IFS= read -rsn 1 char; do
      case $char in
        '') break ;;
        $'\b'|$'\177')
          if [[ -n $key ]]; then
            key=${key%?}
            printf '\b \b' >&2
          fi
          ;;
        *)
          key+=$char
          printf '*' >&2
          ;;
      esac
    done
    printf '\n' >&2
  elif [[ -t 0 ]]; then
    printf 'OpenCode Go API key: ' >&2
    IFS= read -rs key || true
    printf '\n' >&2
  else
    IFS= read -r key || [[ -n $key ]]
  fi
  if [[ -z $key ]]; then
    printf 'API key must not be empty\n' >&2
    exit 1
  fi
  if ! command -v security >/dev/null 2>&1; then
    printf 'security command not found\n' >&2
    exit 1
  fi
  security add-generic-password -U -a "$KEY_ACCOUNT" -s "$service" -w "$key" >/dev/null
  stored=$(security find-generic-password -a "$KEY_ACCOUNT" -s "$service" -w)
  if [[ $stored != "$key" ]]; then
    printf 'Keychain verification failed\n' >&2
    exit 1
  fi
  printf 'stored (keychain: %s)\n' "$service"
}
ensure_profile() {
  local name=${1:-} roster service stored=
  if [[ $# -ne 1 || ! $name =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    printf 'usage: opencode-go profile <name> (lowercase letters, numbers, and hyphens)\n' >&2
    exit 2
  fi
  service="opencode-go-$name"
  # Every source `run` would accept counts as this profile already having a key: probing the
  # account-qualified keychain item alone re-prompts for a key the client resolves anyway, and
  # a non-interactive run then stores nothing and never reaches the roster.
  stored=$(OPENCODE_GO_PROFILE=$name KEY_SERVICE=$service go_key 2>/dev/null) || stored=
  if [[ -n $stored ]]; then
    printf 'profile %s: key present\n' "$name"
  else
    store_key "$service" true
  fi
  roster=$PROFILES_FILE
  # A roster path with no directory part is its own ${roster%/*}, and creating a DIRECTORY by the
  # file's name is how the write below starts failing on a path the readers accept.
  [[ $roster == */* ]] && mkdir -p "${roster%/*}"
  # review-bench and the menubar fall back to the default account only while this file is
  # ABSENT, so a roster opening with the new name alone retires the account the existing key
  # belongs to — but listing a default that has no key at all hands cells to an account that
  # can only fail to authenticate.
  if [[ ! -f $roster ]]; then
    : >"$roster"
    if (OPENCODE_GO_PROFILE= KEY_SERVICE=opencode-go go_key >/dev/null 2>&1); then
      printf -- '-\n' >"$roster"
      printf 'roster: added the default account as -\n'
    fi
  fi
  # Against the roster as its READERS see it: every one of them trims the line, so an indented
  # entry already names a live account and appending it again double-spends the leg's probe.
  if grep -Fxq -- "$name" <<<"$(roster_profiles)"; then
    printf 'roster: already listed\n'
  else
    # An append onto a last line that never ended fuses both names into an account nobody has.
    if [[ -s $roster && -n $(tail -c 1 "$roster") ]]; then
      printf '\n' >>"$roster"
    fi
    printf '%s\n' "$name" >>"$roster"
    printf 'roster: added %s\n' "$name"
  fi
}
models() {
  local json=false
  [[ $# -le 1 ]] || usage
  if [[ ${1:-} == --json ]]; then
    json=true
  elif [[ $# -ne 0 ]]; then
    usage
  fi
  if $json; then
    curl -sS -m 120 "$BASE_URL/models"
  else
    curl -sS -m 120 "$BASE_URL/models" | jq -r '.data[].id' | sort
  fi
}
sse_to_envelope() {
  jq -Rs '
    [ splits("\n")
      | select(startswith("data:"))
      | sub("^data:[ ]*"; "")
      | select(. != "[DONE]")
      | (try fromjson catch empty) ]
    | reduce .[] as $chunk (
        {id: null, model: null, content: "", reasoning: "", finish_reason: null,
         usage: null, error: null, tool_calls: []};
        .id = (.id // $chunk.id)
        | .model = (.model // $chunk.model)
        | .content += ((($chunk.choices // [])[0].delta.content) // "")
        | .reasoning += ((($chunk.choices // [])[0].delta.reasoning_content) // "")
        | .finish_reason = ((($chunk.choices // [])[0].finish_reason) // .finish_reason)
        | .usage = ($chunk.usage // .usage)
        | .error = (.error // $chunk.error)
        | .tool_calls += ((($chunk.choices // [])[0].delta.tool_calls) // [])
      )
    | {id, object: "chat.completion", model, error,
       choices: [{index: 0, finish_reason,
                  message: {role: "assistant", content, reasoning_content: .reasoning,
                            tool_calls: (if (.tool_calls | length) > 0 then .tool_calls else null end)}}],
       usage}
  ' "$1"
}
# curl prints 000 when the transfer never reached an HTTP status (timeout, reset,
# HTTP/2 error). Every such failure must travel the same retry and escalation path
# as a gateway 5xx: a hang with no status is precisely the case the buffered->stream
# escalation exists for.
transient_status() { [[ $1 == 5?? || $1 == 000 ]]; }
# The MiniMax family streams its reasoning inside the content, and the caller strips it before
# parsing. Matching the caller's contract against text the caller will delete would call a
# reasoning block an answer: findings that live only in there still carry the shape.
ANSWER_CONTENT_FILTER='(.choices[0].message.content // "")
  | gsub("(?s)<think>.*?</think>"; "") | sub("(?s)^\\s*<think>.*"; "")'
answered_nothing() {
  local file=$1 streaming=$2 must_match=${3:-}
  local envelope content
  if [[ $streaming == true ]]; then
    grep -q '^data:' "$file" || return 1
    envelope=$(sse_to_envelope "$file") || return 1
    # A provider error inside the stream also carries no content. Retiring a reasoning-off
    # strategy for it burns the negotiation on an outage and hides the error.
    [[ $(jq -r '.error // "null"' <<<"$envelope") == null ]] || return 1
    content=$(jq -r "$ANSWER_CONTENT_FILTER" <<<"$envelope") || return 1
  else
    content=$(jq -r "$ANSWER_CONTENT_FILTER" "$file") || return 1
  fi
  [[ -n $content ]] || return 0
  # A model that answers inside its reasoning field leaves a one-line announce here: non-empty,
  # so emptiness alone reads it as a working strategy, and useless. What a real answer looks
  # like is the caller's to say, never this script's — the same run() serves prose prompts,
  # where any text at all is the answer.
  [[ -n $must_match ]] || return 1
  local hit=0
  grep -Eqi -- "$must_match" <<<"$content" || hit=$?
  # grep exits 2 on a pattern it cannot compile, and reading that as "no match" would retire a
  # working strategy on every 2xx instead of saying so. The flag is validated where it is parsed;
  # this is the second half of that guard, because a silent burn of the ladder is unattributable.
  (( hit <= 1 )) || return 1
  (( hit == 1 ))
}
no_reasoning_body() {
  local body=$1 strategy=$2
  case $strategy in
    effort-none) jq -c '. + {reasoning_effort:"none"}' <<<"$body" ;;
    enable-thinking) jq -c '. + {chat_template_kwargs:{enable_thinking:false}}' <<<"$body" ;;
    # An explicit --prefill already occupies the assistant turn; leave it alone.
    close-think) jq -c 'if (.messages[-1].role == "assistant") then . else
                          .messages += [{role:"assistant",content:"</think>"}] end' <<<"$body" ;;
    plain) printf '%s' "$body" ;;
    *) printf 'unknown reasoning-off strategy %s\n' "$strategy" >&2; exit 1 ;;
  esac
}
models_cache() {
  local cache=${TMPDIR:-/tmp}/opencode-go-models.$(id -u).txt tmp
  # The plan's model list changes on a vendor's schedule, not between calls, and a
  # batch of raters would otherwise re-fetch it once per request.
  if [[ ! -s $cache ]] || (( $(date +%s) - $(stat -f %m "$cache" 2>/dev/null || echo 0) > 600 )); then
    tmp=$(mktemp "${cache}.XXXXXX")
    if curl -sS -m 120 "$BASE_URL/models" | jq -r '.data[].id' >"$tmp" && [[ -s $tmp ]]; then
      mv -f "$tmp" "$cache"
    else
      rm -f "$tmp"
      [[ -s $cache ]] || { printf 'Cannot read the OpenCode Go model list\n' >&2; exit 1; }
    fi
  fi
  printf '%s' "$cache"
}
require_go_model() {
  local model=$1 cache
  cache=$(models_cache) || exit 1
  if ! grep -qxF "$model" "$cache"; then
    printf 'Model %s is not in the OpenCode Go plan (see: opencode-go models)\n' "$model" >&2
    exit 2
  fi
}
run_model() {
  [[ $# -ge 2 ]] || usage
  local model=$1 key system= prompt= prompt_file= max_tokens=1024 effort= json=false status body
  local retries=3 attempt=1 delay stream=false envelope no_reasoning=false prefill=
  local answer_must_match= pattern_rc
  local max_wait=${OPENCODE_GO_MAX_WAIT_S:-900} stall_seconds=${OPENCODE_GO_STALL_S:-120}
  local slow_switch=${OPENCODE_GO_SLOW_SWITCH_S:-120}
  # How to silence reasoning differs per model and an unsupported knob is a hard
  # 400, so the strategies are negotiated in order rather than guessed. The last
  # one needs no API support: a chat template that has already opened a thinking
  # block accepts a closing tag as the assistant turn's prefix and answers next.
  local -a strategies=(effort-none enable-thinking close-think plain)
  local -a prompt_parts=()
  shift
  while [[ $# -gt 0 ]]; do
    case $1 in
      --prompt-file)
        [[ $# -ge 2 ]] || usage; prompt_file=$2; shift 2 ;;
      --system)
        [[ $# -ge 2 ]] || usage; system=$2; shift 2 ;;
      --max-tokens)
        [[ $# -ge 2 && $2 =~ ^[1-9][0-9]*$ ]] || usage
        max_tokens=$2; shift 2 ;;
      --effort)
        [[ $# -ge 2 && $2 =~ ^(low|medium|high)$ ]] || usage
        effort=$2; shift 2 ;;
      --retries)
        [[ $# -ge 2 && $2 =~ ^[1-9][0-9]*$ ]] || usage
        retries=$2; shift 2 ;;
      --no-reasoning)
        no_reasoning=true; shift ;;
      --prefill)
        [[ $# -ge 2 ]] || usage; prefill=$2; shift 2 ;;
      --answer-must-match)
        [[ $# -ge 2 && -n $2 ]] || usage
        # A pattern grep cannot compile would otherwise reach answered_nothing, where an
        # uncompilable regex and a genuine miss look alike; refusing it here is the only place
        # the caller still hears about it.
        pattern_rc=0
        printf '' | grep -Eq -- "$2" || pattern_rc=$?
        if (( pattern_rc > 1 )); then
          printf -- '--answer-must-match is not a usable extended regex: %s\n' "$2" >&2
          usage
        fi
        answer_must_match=$2; shift 2 ;;
      --stream)
        stream=true; shift ;;
      --no-stream)
        stream=false; shift ;;
      --json)
        json=true; shift ;;
      --*)
        usage ;;
      *)
        prompt_parts+=("$1"); shift ;;
    esac
  done
  if $no_reasoning && [[ -n $effort ]]; then
    printf -- '--effort and --no-reasoning contradict each other\n' >&2
    usage
  fi
  if [[ -n $prompt_file ]]; then
    [[ ${#prompt_parts[@]} -eq 0 && -r $prompt_file ]] || usage
  else
    [[ ${#prompt_parts[@]} -gt 0 ]] || usage
    prompt="${prompt_parts[*]}"
  fi
  key=$(require_key)
  require_go_model "$model"
  local build='{model:$model,max_tokens:$max,
    messages:((if $system == "" then [] else [{role:"system",content:$system}] end)
              + [{role:"user",content:.}]
              + (if $prefill == "" then [] else [{role:"assistant",content:$prefill}] end))}
   + (if $effort == "" then {} else {reasoning_effort:$effort} end)'
  if [[ -n $prompt_file ]]; then
    body=$(jq -Rs --arg model "$model" --arg system "$system" --arg prefill "$prefill" \
      --arg effort "$effort" --argjson max "$max_tokens" "$build" "$prompt_file")
  else
    body=$(printf '%s' "$prompt" | jq -Rs --arg model "$model" --arg system "$system" \
      --arg prefill "$prefill" --arg effort "$effort" --argjson max "$max_tokens" "$build")
  fi
  if $stream; then
    body=$(jq -c '. + {stream: true}' <<<"$body")
  fi
  response=$(new_temp)
  auth_config "$key"
  # A stream reports progress, so its stall detector IS its deadline; adding a
  # wall-clock cap on top only kills a legitimately long generation (measured:
  # deepseek-v4-pro needs ~1000s of streaming). A buffered reply sends nothing
  # until the end, so it has no progress signal and needs the cap.
  local -a stream_transfer=(-N --speed-limit 1 --speed-time "$stall_seconds")
  local -a buffered_transfer=(-m "$max_wait")
  local -a transfer=()
  if $stream; then
    transfer=("${stream_transfer[@]}")
  else
    transfer=("${buffered_transfer[@]}")
  fi
  local -a pending=()
  local base_body=$body
  if $no_reasoning; then
    pending=("${strategies[@]}")
    body=$(no_reasoning_body "$base_body" "${pending[0]}")
  fi
  local elapsed started_at curl_rc
  while :; do
    started_at=$SECONDS
    curl_rc=0
    status=$(curl -sS "${transfer[@]}" -o "$response" -w '%{http_code}' \
      --config "$authcfg" --data-binary @- "$BASE_URL/chat/completions" <<<"$body") || curl_rc=$?
    elapsed=$((SECONDS - started_at))
    if (( curl_rc != 0 )); then
      # curl still reports a status it received before the transfer failed, and keeping an
      # error status is what stops a 429 that died mid-body from being retried as transient
      # weather. A 2xx that died mid-body is the opposite case: the headers promised success
      # and the body is truncated, so it has to re-enter the transport-failure path instead of
      # being handed to the parser as a complete answer.
      [[ $status =~ ^[45][0-9][0-9]$ ]] || status=000
      printf 'curl exit %d after %ds (HTTP %s)\n' "$curl_rc" "$elapsed" "$status" >&2
    fi
    # A model that rejects one reasoning-off strategy may accept the next; only a
    # 400 shaped like an invalid-parameter complaint is worth re-trying this way.
    if [[ $status == 400 && ${#pending[@]} -gt 1 ]] \
      && grep -q 'invalid_request' "$response"; then
      pending=("${pending[@]:1}")
      body=$(no_reasoning_body "$base_body" "${pending[0]}")
      printf 'reasoning-off strategy rejected, falling back to %s\n' "${pending[0]}" >&2
      continue
    fi
    # A model handed a closing think tag may treat the assistant turn as finished
    # and answer nothing at all, so an empty 200 retires that strategy too.
    if [[ $status == 2?? && ${#pending[@]} -gt 1 ]] \
      && answered_nothing "$response" "$stream" "$answer_must_match"; then
      pending=("${pending[@]:1}")
      body=$(no_reasoning_body "$base_body" "${pending[0]}")
      printf 'reasoning-off strategy answered nothing, falling back to %s\n' "${pending[0]}" >&2
      continue
    fi
    # A buffered reply that 5xx's only after minutes was not an outage: the
    # generation outlived the upstream response deadline, and repeating it
    # buffered just pays the same wait again. Streaming has no such deadline.
    if transient_status "$status" && ! $stream && (( elapsed >= slow_switch )); then
      stream=true
      transfer=("${stream_transfer[@]}")
      base_body=$(jq -c '. + {stream: true}' <<<"$base_body")
      body=$(jq -c '. + {stream: true}' <<<"$body")
      # Streaming is a different transport, not another go at the same one, so it gets its
      # own budget and is sent at once: bypassing the retry check is what makes the
      # escalation reachable at --retries 1, and the buffered attempt already paid the wait.
      attempt=1
      printf 'HTTP %s after %ds; the generation outlives the buffered deadline, streaming instead\n' \
        "$status" "$elapsed" >&2
      continue
    fi
    # Gateway 5xx (failover_exhausted, inference_recovery_timeout) means the
    # upstream inference pool was unavailable; the identical request usually
    # succeeds on a later attempt. A 429 is a real Go usage wall and must
    # surface immediately instead of being retried into a longer outage.
    transient_status "$status" && [[ $attempt -lt $retries ]] || break
    delay=$((attempt * 15))
    printf 'HTTP %s from provider (attempt %d/%d), retrying in %ds\n' \
      "$status" "$attempt" "$retries" "$delay" >&2
    attempt=$((attempt + 1))
    sleep "$delay"
  done
  local record_rc=0
  record_call "$status" "$response" completion || record_rc=$?
  if [[ $status != 2?? ]]; then
    printf 'HTTP %s\n' "$status" >&2
    cat "$response" >&2
    printf '\n' >&2
    exit 1
  fi
  if $stream; then
    if ! grep -q '^data:' "$response"; then
      printf 'stream response carried no SSE data chunks\n' >&2
      cat "$response" >&2
      exit 1
    fi
    envelope=$(sse_to_envelope "$response")
    if [[ $(jq -r '.error // "null"' <<<"$envelope") != null ]]; then
      printf 'provider error inside stream: %s\n' "$(jq -c '.error' <<<"$envelope")" >&2
      exit 1
    fi
    printf '%s' "$envelope" >"$response"
  fi
  if $json; then
    cat "$response"
  else
    jq -r '.choices[0].message.content' "$response"
  fi
  # The answer is real, the record of it is not: exiting 0 here would tell every caller the wall
  # was retired while the store still says it stands.
  return "$record_rc"
}
raw_request() {
  [[ $# -ge 1 && $# -le 2 ]] || usage
  local path=${1#/} body=${2-} key status curl_rc=0
  key=$(require_key)
  response=$(new_temp)
  auth_config "$key"
  if [[ $# -eq 2 ]]; then
    status=$(curl -sS -m 600 -o "$response" -w '%{http_code}' \
      --config "$authcfg" --data-binary @- "$BASE_URL/$path" <<<"$body") || curl_rc=$?
  else
    status=$(curl -sS -m 120 -o "$response" -w '%{http_code}' \
      --config "$authcfg" "$BASE_URL/$path") || curl_rc=$?
  fi
  if (( curl_rc != 0 )); then
    printf 'curl exit %d, no HTTP status\n' "$curl_rc" >&2
    status=000
  fi
  local record_rc=0
  record_call "$status" "$response" raw || record_rc=$?
  printf 'HTTP %s\n' "$status" >&2
  cat "$response"
  (( record_rc == 0 )) || return "$record_rc"
  [[ $status == 2?? ]]
}
# The wall belongs to the plan, not to one model, so any model the plan serves answers the
# question; the two named are its small fast ones.
WALL_PROBE_MODELS=(deepseek-v4-flash glm-5.2)
# Every line this prints opens with the state it observed, and the three are not interchangeable:
# `served` needs a completion the plan answered, `walled` needs a refusal this very probe recorded,
# and `dormant` sent nothing at all — reading the third as the first is how an account nobody asked
# walks back into the pool.
wall_check() {
  local probe_clear=false
  while [[ $# -gt 0 ]]; do
    case $1 in
      --probe-clear) probe_clear=true; shift ;;
      *) usage ;;
    esac
  done
  local profile=${OPENCODE_GO_PROFILE:--} walled started fresh cache model candidate rc=0
  local window reset
  walled=$(jq -r --arg p "$profile" \
    'first(.vendors.opencode.accounts[]? | select(.account == $p) | .walled | tostring) // "unknown"' \
    "$LIMITS_CACHE" 2>/dev/null) || walled=unknown
  # The collector's row decides whether the probe is FREE, never whether it may be sent at all:
  # --probe-clear is someone asking for a reading taken now, which only a request can give.
  if ! $probe_clear; then
    if [[ $walled == unknown ]]; then
      printf 'inconclusive — %s carries no OpenCode row for profile %s\n' "$LIMITS_CACHE" "$profile" >&2
      return 1
    fi
    if [[ $walled != true ]]; then
      printf 'dormant — no wall stands on %s, so nothing was sent\n' "$profile"
      return 0
    fi
  fi
  cache=$(models_cache) || return 1
  model=
  for candidate in "${WALL_PROBE_MODELS[@]}"; do
    if grep -qxF "$candidate" "$cache"; then
      model=$candidate
      break
    fi
  done
  [[ -n $model ]] || model=$(head -n 1 "$cache")
  if [[ -z $model ]]; then
    printf 'inconclusive — the plan lists no model to ask with\n' >&2
    return 1
  fi
  probe_errors=$(new_temp)
  started=$(wall_bytes)
  # A subshell because run_model exits on a refusal, and a refusal is the answer here. It re-arms
  # the request cleanup because a subshell inherits no EXIT trap, and it records the 429 itself on
  # the way out, so this only has to read the record back.
  ( trap cleanup_request EXIT
    run_model "$model" --max-tokens 16 --retries 1 ping ) >/dev/null 2>"$probe_errors" || rc=$?
  if (( rc == 0 )); then
    if [[ $walled == true ]]; then
      printf 'served — the plan answered a completion; the wall is retired\n'
    else
      printf 'served — the plan answered a completion\n'
    fi
    return 0
  fi
  # A row that stood before the probe proves nothing: only one this probe itself just appended is
  # a refusal the gateway repeated. Anything else — a provider outage, a burst throttle — answered
  # nothing and must not be read back as a fresh wall. The file GREW is what says so: two refusals
  # a second apart are the same row to the second, and a stamp comparison reads the older as new.
  fresh=
  if [[ $(wall_bytes) -gt $started ]]; then
    # The whole grown region, not the last line: a neighbour's append can land after ours, and
    # reading only the tail row would hide the 429 this probe itself just recorded.
    fresh=$(tail -c +"$((started + 1))" "$WALLS_FILE" 2>/dev/null |
      jq -c --arg a "$KEY_SERVICE" 'select(.side == "opencode" and .account == $a)' 2>/dev/null |
      tail -n 1) || fresh=
  fi
  if [[ -n $fresh ]]; then
    window=$(jq -r '.window // "unknown"' <<<"$fresh")
    reset=$(jq -r '.reset_at // "-"' <<<"$fresh")
    if [[ $reset == - ]]; then
      printf 'walled — %s, no reset stated\n' "$window"
    else
      printf 'walled — %s, resets %s\n' "$window" "$(date -r "${reset%%.*}" '+%Y-%m-%d %H:%M')"
    fi
    return 0
  fi
  printf 'inconclusive — %s\n' "$(grep -v '^$' "$probe_errors" | tail -n 1)" >&2
  return 1
}
# The leg's one refresh action. Which accounts are asked is decided by the collector's rows and
# nowhere else, so the heartbeat and a hand-run command send the same nothing to an account with no
# wall on it — until --probe-clear, which asks the whole roster because a person asked it to.
wall_check_all() {
  local probe_clear=false
  while [[ $# -gt 0 ]]; do
    case $1 in
      --probe-clear) probe_clear=true; shift ;;
      *) usage ;;
    esac
  done
  local self profile rc=0 targets answer
  local -a flags=()
  self=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/$(basename -- "${BASH_SOURCE[0]}")
  if $probe_clear; then
    flags=(--probe-clear)
    targets=$(roster_profiles)
    if [[ -z $targets ]]; then
      printf 'inconclusive — %s names no account to ask\n' "$PROFILES_FILE" >&2
      return 1
    fi
  else
    targets=$(jq -r '.vendors.opencode.accounts[]? | select(.walled == true) | .account' \
      "$LIMITS_CACHE" 2>/dev/null) || targets=
    if [[ -z $targets ]]; then
      printf 'dormant — no wall stands on the leg, so nothing was sent\n'
      return 0
    fi
  fi
  while IFS= read -r profile; do
    [[ -n $profile ]] || continue
    [[ $profile != - ]] || profile=''
    # A bare "${flags[@]}" on an empty array is an unbound-variable error under set -u in bash 3.2,
    # which is the shell every launchd context reaches first.
    answer=$(OPENCODE_GO_PROFILE=$profile "$self" wall-check ${flags[@]+"${flags[@]}"} 2>&1) || rc=1
    printf '%s: %s\n' "${profile:--}" "$answer"
  done <<<"$targets"
  return "$rc"
}
case ${1:-} in
  profile|p) shift; ensure_profile "$@" ;;
  key) shift; [[ $# -eq 0 ]] || usage; store_key ;;
  models) shift; models "$@" ;;
  wall-check)
    shift
    # --all selects the leg-wide walk whatever order the flags arrive in: reaching wall_check with
    # a flag it does not know spends a completion and then dies on usage.
    wall_check_leg=false
    wall_check_args=()
    for wall_check_arg in "$@"; do
      if [[ $wall_check_arg == --all ]]; then wall_check_leg=true
      else wall_check_args+=("$wall_check_arg"); fi
    done
    if $wall_check_leg; then
      wall_check_all ${wall_check_args[@]+"${wall_check_args[@]}"}
    else
      wall_check ${wall_check_args[@]+"${wall_check_args[@]}"}
    fi
    ;;
  run) shift; run_model "$@" ;;
  raw) shift; raw_request "$@" ;;
  *) usage ;;
esac

#!/usr/bin/env bash
{
set -u

resolve_script() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")" && printf '%s/%s\n' "$PWD" "$(basename "$source")"
}

script_path=$(resolve_script)
repo_root=$(cd "$(dirname "$script_path")/.." && pwd)
. "$repo_root/share/limit-hit.sh"
. "$repo_root/share/llm-launch.sh"
state_dir="${VENDOR_CLI_UPDATE_STATE_DIR:-$HOME/.cache/vendor-cli-update}"
state_file="$state_dir/state.json"
log_file="$state_dir/update.log"
codex_profiles_dir="${CODEXB_PROFILES_DIR:-$HOME/.codex-profiles}"
grok_profiles_dir="${GROKB_PROFILES_DIR:-$HOME/.grok-profiles}"
geminib="${VENDOR_CLI_UPDATE_GEMINIB:-$repo_root/bin/geminib}"
native_claude="${VENDOR_CLI_UPDATE_NATIVE_CLAUDE:-$HOME/.local/bin/claude}"
agy="${AGY_BIN:-$HOME/.local/bin/agy}"
agy_manifest="${VENDOR_CLI_UPDATE_AGY_MANIFEST:-https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/darwin_arm64.json}"
agent_dir="$HOME/Library/LaunchAgents"
label="com.llm-legs.vendor-cli-update"
plist="$agent_dir/$label.plist"
wrapper="$HOME/.local/libexec/vendor-cli-update"
pass_every_s=86400
check_every_s=7200
# agy updates itself; npm installs never do, and a vendor lists a new model only to a client at least
# as new as the model's minimal_client_version. The native claude's own updater is off
# (DISABLE_AUTOUPDATER), so it is updated here too; the npm claude is a second install that any PATH
# with /usr/local/bin or nvm first runs instead of the native one.
vendors="codex grok claude"
checked="$vendors gemini"

package_of() {
  case $1 in
    codex) printf '@openai/codex\n' ;;
    grok) printf '@xai-official/grok\n' ;;
    claude) printf '@anthropic-ai/claude-code\n' ;;
  esac
}

timeout_command() {
  local rc=0 frame=0 lost='this step reads as failed'
  if command -v gtimeout >/dev/null 2>&1; then
    command gtimeout "$@" || rc=$?
  elif command -v timeout >/dev/null 2>&1; then
    command timeout "$@" || rc=$?
  else
    perl -e 'alarm shift; exec @ARGV' "$@" || rc=$?
  fi
  case $rc in 124|142)
    [ "${FUNCNAME[1]:-}" != version_of ] || frame=1 lost='its version reads as unknown'
    limit_hit probe.cli "$1" s kill "${2##*/} ${3:-}: $lost" "bin/vendor-cli-update:${BASH_LINENO[frame]}" ;;
  esac
  return "$rc"
}

stamp() { TZ=UTC printf '%(%Y-%m-%dT%H:%M:%SZ)T\n' -1; }

node_bin_dirs() { # cli -> every nvm node's npm bin directory that installed it, oldest node first
  local dir
  while IFS= read -r dir; do
    [ -x "$dir/$1" ] && [ -x "$dir/npm" ] && printf '%s\n' "$dir"
  done < <(ls -d "$HOME"/.nvm/versions/node/*/bin 2>/dev/null | sort -V)
}

node_bin_dir() { # cli -> the npm bin directory that installed it
  local found
  if [ -n "${VENDOR_CLI_UPDATE_BIN_DIR:-}" ]; then
    printf '%s\n' "$VENDOR_CLI_UPDATE_BIN_DIR"
    return 0
  fi
  found=$(node_bin_dirs "$1" | tail -n 1)
  [ -n "$found" ] && printf '%s\n' "$found"
}

version_of() {
  local out
  out=$("$@" 2>/dev/null)
  [[ ${out%%$'\n'*} =~ [0-9]+(\.[0-9]+)+ ]] && printf '%s\n' "${BASH_REMATCH[0]}"
  return 0
}

# Plain numeric versions of one length compare in bash; anything else (a pre-release, 1.2 against 1.2.0) is sort -V's call.
newer() { # a b: a is a later version than b
  local -a a b
  local i
  [ "$1" != "$2" ] || return 1
  if [[ $1 =~ ^[0-9]+(\.[0-9]+)*$ && $2 =~ ^[0-9]+(\.[0-9]+)*$ ]]; then
    IFS=. read -ra a <<<"$1"
    IFS=. read -ra b <<<"$2"
    if [ "${#a[@]}" -eq "${#b[@]}" ]; then
      for i in "${!a[@]}"; do
        [ "$((10#${a[i]}))" -ne "$((10#${b[i]}))" ] || continue
        [ "$((10#${a[i]}))" -gt "$((10#${b[i]}))" ]
        return
      done
    fi
  fi
  [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

# A running client is found by the executable it maps, never by its command line: a worker starts
# `<nvm>/bin/grok`, a symlink, so no argument names the package it would be replaced from. lsof exits
# 1 whenever one listed file is not open, so only its output answers.
busy() { # vendor npm-root
  local file
  local -a files=()
  case $1 in
    codex)
      while IFS= read -r file; do files+=("$file"); done < <(find "$2/@openai/codex" -type f -path '*/vendor/*/bin/codex' 2>/dev/null)
      ;;
    grok) files=("$2/@xai-official/grok/bin/grok-native" "$HOME"/.grok/bin/grok-*) ;;
    claude) files=("$2/@anthropic-ai/claude-code/bin/claude.exe") ;;
  esac
  [ "${#files[@]}" -gt 0 ] && [ -n "$(lsof -t -- "${files[@]}" 2>/dev/null)" ]
}

state_apply() { # jq-args...
  local tmp="$state_file.$$"
  if [ -s "$state_file" ]; then jq "$@" "$state_file" >"$tmp" 2>/dev/null; else jq "$@" <<<'{}' >"$tmp" 2>/dev/null; fi &&
    mv -f "$tmp" "$state_file" || rm -f "$tmp"
}

record() { # vendor result installed latest [from]
  [ "$2" = current ] || [ "$2" = not-installed ] ||
    printf '%s %s %s %s -> %s\n' "$(stamp)" "$1" "$2" "${5:-${3:--}}" "${4:--}" >>"$log_file"
  state_apply --arg v "$1" --arg r "$2" --arg i "$3" --arg l "$4" --arg t "$(stamp)" \
    '.[$v] = ((.[$v] // {}) + {result: $r, installed: $i, latest: $l, checked_at: $t})'
}

refresh_models() { # vendor bin-dir
  local home
  case $1 in
    codex)
      for home in "$HOME/.codex" "$codex_profiles_dir"/*; do
        [ -f "$home/auth.json" ] || continue
        CODEX_HOME=$home PATH="$2:$PATH" timeout_command 60 "$2/codex" debug models >/dev/null 2>&1 ||
          printf '%s codex models refresh failed in %s\n' "$(stamp)" "$home" >>"$log_file"
      done
      ;;
    grok)
      PATH="$2:$PATH" timeout_command 120 "${VENDOR_CLI_UPDATE_GROKB:-$repo_root/bin/grokb}" models --refresh >/dev/null 2>&1 ||
        printf '%s grok models refresh failed\n' "$(stamp)" >>"$log_file"
      ;;
    gemini)
      timeout_command 300 "$geminib" families --union --refresh >/dev/null 2>&1 ||
        printf '%s gemini models refresh failed\n' "$(stamp)" >>"$log_file"
      ;;
  esac
}

# Codex state is per home, and not only our CLI writes it: the ChatGPT app runs its own bundled codex
# against ~/.codex. Each finding is a line `kind<TAB>where<TAB>what`.
codex_divergence() { # bin-dir installed-version pre-pass-version -> foreign writers before the refresh
  local home client
  for home in "$HOME/.codex" "$codex_profiles_dir"/*; do
    [ -f "$home/models_cache.json" ] || continue
    client=$(jq -r '.client_version // "" | tostring' "$home/models_cache.json" 2>/dev/null)
    [ -z "$client" ] || [ "$client" = "$2" ] || [ "$client" = "$3" ] || printf 'writer\t%s\t%s\n' "$(home_account "$home")" "$client"
  done
}
home_account() { if [ "$1" = "$HOME/.codex" ]; then printf main; else printf '%s' "${1##*/}"; fi; }
# Any other codex executable running on this machine, found by what runs rather than by where an app
# happens to install one.
codex_foreign_clients() { # npm-root
  local path version
  ps -axo comm= 2>/dev/null | LC_ALL=C sort -u | while IFS= read -r path; do
    [ "${path##*/}" = codex ] && [ -x "$path" ] || continue
    case "$path" in "$1"/*) continue ;; esac
    version=$(version_of timeout_command 10 "$path" --version)
    printf 'client\t%s\t%s\n' "$path" "${version:-unknown}"
  done
}
# Each account's own model list, as `account<TAB>sorted,models`: the codex and grok homes this client
# fetched, the gemini profiles of `geminib families --union`.
catalog_rows() { # vendor installed-version
  local home
  case $1 in
    codex)
      for home in "$HOME/.codex" "$codex_profiles_dir"/*; do
        [ -f "$home/auth.json" ] && [ -f "$home/models_cache.json" ] || continue
        [ "$(jq -r '.client_version // ""' "$home/models_cache.json" 2>/dev/null)" = "$2" ] || continue
        printf '%s\t%s\n' "$(home_account "$home")" "$(jq -r '[.models[]?.slug | strings] | sort | join(",")' "$home/models_cache.json" 2>/dev/null)"
      done
      ;;
    grok)
      for home in "$grok_profiles_dir"/*; do
        [ -f "$home/auth.json" ] && [ -f "$home/models_cache.json" ] || continue
        jq -r --arg v "$2" --arg a "${home##*/}" 'select(.grok_version == $v) | "\($a)\t\(.models | keys | join(","))"' \
          "$home/models_cache.json" 2>/dev/null
      done
      ;;
    gemini)
      timeout_command 300 "$geminib" families --union 2>/dev/null | awk -F'\t' '
        { n = split($5, held, ","); for (i = 1; i <= n; i++) print held[i] "\t" $2 }' | LC_ALL=C sort |
        awk -F'\t' '$1 != account { if (NR > 1) print account "\t" models; account = $1; models = $2; next }
          { models = models "," $2 } END { if (NR) print account "\t" models }'
      ;;
  esac
}
# Accounts whose own list lacks a model another account lists: a plan difference, or an account the
# vendor serves differently. Read after the refresh.
catalog_gaps() { # vendor installed-version
  local rows union
  rows=$(catalog_rows "$@")
  [ -n "$rows" ] || return 0
  union=$(printf '%s\n' "$rows" | cut -f2 | tr ',' '\n' | sed '/^$/d' | LC_ALL=C sort -u)
  printf '%s\n' "$rows" | while IFS=$'\t' read -r account slugs; do
    missing=$(comm -23 <(printf '%s\n' "$union") <(printf '%s\n' "$slugs" | tr ',' '\n' | LC_ALL=C sort -u) | paste -sd, -)
    [ -z "$missing" ] || printf 'catalog\t%s\tmissing %s\n' "$account" "$missing"
  done
}
# A fresh sign-in hides the refresh path: agy 1.4 saved its sign-in without the id_token the refresh
# read its client id from, and every Gemini review cell refused for a week before one showed it. So
# each signed-in account refreshes once a full pass; a network or server failure is weather, no finding.
auth_gaps() {
  local dir account reason
  dir=$(mktemp -d) || return 0
  timeout_command 60 "$geminib" list 2>/dev/null | sed -n 's/^\([^:]*\): Logged in$/\1/p' | while IFS= read -r account; do
    reason=$(timeout_command 60 "$geminib" export-token "$account" --min-seconds 3500 --to "$dir/$account" 2>&1 >/dev/null) &&
      continue
    reason=${reason##*$'\n'}
    printf 'auth\t%s\t%s (geminib export-token %s --min-seconds 3500 --to <new file>)\n' "$account" "${reason#geminib: }" "$account"
  done | grep -vE 'transport_error|temporarily_unavailable|server_error|HTTP (429|5[0-9][0-9])'
  rm -rf "$dir"
}
record_divergence() { # vendor findings
  local before
  before=$(jq -r --arg v "$1" '.[$v].divergence // [] | .[]' "$state_file" 2>/dev/null)
  [ "$before" = "$2" ] || printf '%s %s divergence: %s\n' "$(stamp)" "$1" "$(printf '%s' "${2:-none}" | tr '\t\n' ' ;')" >>"$log_file"
  state_apply --arg v "$1" --arg d "$2" '.[$v].divergence = ($d | split("\n") | map(select(length > 0)))'
}

# npm install -g deletes the package it replaces before writing the new one, and a client launched in
# between finds no executable (2026-10-29: codex 0.165.0 -> 0.166.0 took 41 s, and worker run
# codex-1793307486-22564-5bdc started in it exited 127). So npm installs into a stage beside the live
# prefix (same filesystem, its bin links relative alike) and two renames swap the package in.
npm_install() { # bin-dir package version
  local prefix stage live link rc=0
  prefix=$(dirname "$1")
  live="$prefix/lib/node_modules/$2"
  stage=$(mktemp -d "$prefix/.vendor-cli-update.XXXXXX") || return 1
  PATH="$1:$PATH" timeout_command 600 "$1/npm" install -g "$2@$3" --prefix "$stage" >>"$log_file" 2>&1 || rc=$?
  [ "$rc" -ne 0 ] || [ -d "$stage/lib/node_modules/$2" ] || rc=1
  if [ "$rc" -eq 0 ]; then
    if mv "$live" "$stage/replaced"; then
      mv "$stage/lib/node_modules/$2" "$live" || { mv "$stage/replaced" "$live"; rc=1; }
    else
      rc=1
    fi
  fi
  if [ "$rc" -eq 0 ]; then
    for link in "$stage"/bin/*; do
      [ -L "$link" ] && [ "$(readlink "$link")" != "$(readlink "$1/${link##*/}")" ] || continue
      ln -sfh "$(readlink "$link")" "$1/${link##*/}"
    done
  fi
  rm -rf "$stage"
  return "$rc"
}

update_vendor() { # vendor
  local vendor=$1 package bin_dir installed latest native now
  if [ "$vendor" = gemini ]; then
    check_agy
    return 0
  fi
  package=$(package_of "$vendor")
  bin_dir=$(node_bin_dir "$vendor") || { record "$vendor" not-installed '' ''; return 0; }
  installed=$(version_of "$bin_dir/$vendor" --version)
  latest=$(PATH="$bin_dir:$PATH" timeout_command 60 "$bin_dir/npm" view "$package" version 2>/dev/null | tail -n 1)
  if [ -z "$installed" ] || [ -z "$latest" ]; then
    record "$vendor" check-failed "$installed" "$latest"
    return 0
  fi
  # A native claude ahead of npm's `latest` (a manual `claude update` ships `next` first) is the target
  # when npm publishes it, so both installs converge on one version.
  if [ "$vendor" = claude ]; then
    native=$(version_of timeout_command 30 "$native_claude" --version)
    if [ -n "$native" ] && newer "$native" "$latest" &&
      [ "$(PATH="$bin_dir:$PATH" timeout_command 60 "$bin_dir/npm" view "$package@$native" version 2>/dev/null | tail -n 1)" = "$native" ]; then
      latest=$native
    fi
    [ -z "$native" ] || update_native_claude "$native" "$latest"
  fi
  if ! newer "$latest" "$installed"; then
    record "$vendor" current "$installed" "$latest"
    update_older_nodes "$vendor" "$package" "$latest" "$bin_dir"
    return 0
  fi
  if busy "$vendor" "$(dirname "$bin_dir")/lib/node_modules"; then
    record "$vendor" busy "$installed" "$latest"
    return 0
  fi
  if ! npm_install "$bin_dir" "$package" "$latest"; then
    record "$vendor" install-failed "$installed" "$latest"
    return 0
  fi
  now=$(version_of "$bin_dir/$vendor" --version)
  if [ "$now" != "$latest" ]; then
    record "$vendor" install-failed "$now" "$latest" "$installed"
    return 0
  fi
  record "$vendor" updated "$now" "$latest" "$installed"
  update_older_nodes "$vendor" "$package" "$latest" "$bin_dir"
}

# A node nvm superseded keeps its own global install, and whatever reaches it first runs that old
# client: /usr/local/bin/claude links into one (2026-10-20: 2.1.296 under node v24.14.1 while v24.21.0
# had 2.1.304, the claude a LaunchAgent PATH with /usr/local/bin first resolves). Each is brought to the
# primary's version; one held busy or failing waits for the vendor's next check, the log says which.
update_older_nodes() { # vendor package version primary-bin-dir
  local dir installed now
  while IFS= read -r dir; do
    [ "$dir" != "$4" ] || continue
    installed=$(version_of "$dir/$1" --version)
    [ -n "$installed" ] && newer "$3" "$installed" || continue
    if busy "$1" "$(dirname "$dir")/lib/node_modules"; then
      printf '%s %s busy %s -> %s in %s\n' "$(stamp)" "$1" "$installed" "$3" "$dir" >>"$log_file"
    elif npm_install "$dir" "$2" "$3" &&
      now=$(version_of "$dir/$1" --version) && [ "$now" = "$3" ]; then
      printf '%s %s updated %s -> %s in %s\n' "$(stamp)" "$1" "$installed" "$3" "$dir" >>"$log_file"
    else
      printf '%s %s install-failed %s -> %s in %s\n' "$(stamp)" "$1" "$installed" "$3" "$dir" >>"$log_file"
    fi
  done < <(node_bin_dirs "$1")
}

# The native versions live in separate files (~/.local/share/claude/versions/<version>) behind the
# ~/.local/bin/claude symlink, and the installer spares a version a running client holds a lock on
# (~/.local/state/claude/locks): a running session keeps its binary, so no busy check here.
update_native_claude() { # installed target
  local now
  if ! newer "$2" "$1"; then
    record claude-native current "$1" "$2"
    return 0
  fi
  if ! timeout_command 600 "$native_claude" install "$2" </dev/null >>"$log_file" 2>&1; then
    record claude-native install-failed "$1" "$2"
    return 0
  fi
  now=$(version_of timeout_command 30 "$native_claude" --version)
  if [ "$now" = "$2" ]; then
    record claude-native updated "$now" "$2" "$1"
  else
    record claude-native install-failed "$now" "$2" "$1"
  fi
}

# agy updates itself; the manifest its updater reads tells only whether it fell behind.
check_agy() {
  local installed latest
  if [ ! -x "$agy" ]; then
    record gemini not-installed '' ''
    return 0
  fi
  installed=$(version_of timeout_command 30 "$agy" --version)
  latest=$(curl -fsS -m 30 "$agy_manifest" 2>/dev/null | jq -r '.version // empty' 2>/dev/null)
  if [ -z "$installed" ] || [ -z "$latest" ]; then
    record gemini check-failed "$installed" "$latest"
  elif newer "$latest" "$installed"; then
    record gemini self-update "$installed" "$latest"
  else
    record gemini current "$installed" "$latest"
  fi
}

due_vendors() { # -> `all` when a full pass is due, else the vendors whose version check is due or whose last result wants a retry
  local due
  due=$(jq -r --arg vendors "$vendors" --arg checked "$checked" --argjson now "$EPOCHSECONDS" --argjson max "$pass_every_s" --argjson check "$check_every_s" '
    def at($f): $f // "" | try fromdateiso8601 catch 0;
    . as $s | ($vendors | split(" ")) as $v
    | if any($v[]; at($s[.].passed_at) < $now - $max) then "all"
      else $checked | split(" ")[] | select(at($s[.].checked_at) < $now - $check
        or any($s[.].result, $s[. + "-native"].result; IN("busy", "install-failed", "check-failed"))) end' \
    "$state_file" 2>/dev/null) && [ -s "$state_file" ] || due=all
  printf '%s\n' "${due//$'\n'/ }"
}

# launchd starts `run --if-due` every half hour: a full pass once a day, and in between only the
# version check (every 2 h) and a retry of the vendors a busy client or a failed install left behind,
# since a full pass re-reads every account's model list.
run_all() { # [--if-due]
  local vendor bin_dir installed findings bin_dirs='' due=all codex_before=''
  mkdir -p "$state_dir"
  if [ -z "${VENDOR_CLI_UPDATE_LOCKED:-}" ]; then
    exec env VENDOR_CLI_UPDATE_LOCKED=1 lockf -k -t 0 "$state_dir/run.lock" "$script_path" run "$@"
  fi
  if [ "${1:-}" = --if-due ]; then
    due=$(due_vendors)
    [ -n "$due" ] || return 0
  fi
  # The caches the divergence check reads were written before the refresh, by the client this pass may replace;
  # read after a tick with nothing due has returned, never after an update.
  bin_dir=$(node_bin_dir codex) && codex_before=$(version_of "$bin_dir/codex" --version)
  if [ "$due" != all ]; then
    for vendor in $due; do update_vendor "$vendor"; done
    jq -e --arg due "$due" 'any(($due | split(" "))[] as $v | .[$v, $v + "-native"].result?; . == "updated")' "$state_file" >/dev/null ||
      { run_doctor; return 0; }
  fi
  [ "$due" = all ] && update_vendor gemini
  for vendor in $vendors; do
    [ "$due" = all ] && update_vendor "$vendor"
    bin_dir=$(node_bin_dir "$vendor") || continue
    bin_dirs+=":$bin_dir"
    [ "$vendor" = claude ] || installed=$(version_of "$bin_dir/$vendor" --version)
    [ "$vendor" != codex ] || findings=$(codex_divergence "$bin_dir" "$installed" "$codex_before")
    # A server adds a model for the client already installed, so the lists are re-read every run,
    # not only after an update: every launch resolves its family word against them.
    refresh_models "$vendor" "$bin_dir"
    if [ "$vendor" = codex ]; then
      findings=$(printf '%s\n%s\n%s\n' "$findings" "$(codex_foreign_clients "$(dirname "$bin_dir")/lib/node_modules")" \
        "$(catalog_gaps codex "$installed")" | sed '/^$/d')
      record_divergence codex "$findings"
    fi
    [ "$vendor" != grok ] || record_divergence grok "$(catalog_gaps grok "$installed")"
  done
  refresh_models gemini
  record_divergence gemini "$(printf '%s\n%s\n' "$(catalog_gaps gemini)" "$(auth_gaps)" | sed '/^$/d')"
  [ "$due" = all ] && mark_passed
  # Appended, not prepended: the native claude in ~/.local/bin must stay the one found first.
  PATH="$PATH$bin_dirs" timeout_command 900 "${VENDOR_CLI_UPDATE_FINGERPRINT:-$repo_root/bin/vendor-fingerprint}" check \
    >>"$log_file" 2>&1 || printf '%s fingerprint check failed\n' "$(stamp)" >>"$log_file"
  run_doctor
}

mark_passed() {
  state_apply --arg vendors "$vendors" --arg t "$(stamp)" 'reduce ($vendors | split(" "))[] as $v (.; .[$v].passed_at = $t)'
}

run_doctor() {
  "${VENDOR_CLI_UPDATE_DOCTOR:-$repo_root/bin/updater-doctor}" --quiet >/dev/null 2>&1 ||
    printf '%s updater doctor failed\n' "$(stamp)" >>"$log_file"
  return 0
}

# Egor's «сделай апдейт» (word family `update`): this pass, then the night's per-vendor fixer runs off main, dispatched
# by one orchestrator chat. It returns at once, since the pass takes minutes and the chat that asked must not wait on it.
# `--night` (night-run prep) blocks until the pass ends and requests nothing: `vendor-fingerprint request --night`
# takes the waiting events next, and a day request would have claimed them first.
update_now() {
  local night=false
  [ "${1:-}" = --night ] && night=true
  # The detached pass asks again: VENDOR_CLI_UPDATE_DETACHED alone must not open the orchestrator chat.
  $night || llm_launch_guard update "the vendor update" || return 1
  mkdir -p "$state_dir"
  if ! $night && [ -z "${VENDOR_CLI_UPDATE_DETACHED:-}" ]; then
    if ! lockf -k -t 0 "$state_dir/manual.lock" true 2>/dev/null; then
      printf 'vendor update already running: its orchestrator chat opens when the pass ends; progress in %s\n' "$log_file"
      return 0
    fi
    VENDOR_CLI_UPDATE_DETACHED=1 perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' \
      lockf -k -t 0 "$state_dir/manual.lock" "$script_path" now </dev/null >>"$state_dir/launchd.log" 2>&1 &
    printf 'vendor update started: CLIs, model lists and fingerprints first, then one orchestrator chat dispatching a fixer per vendor opens in Terminal; progress in %s\n' "$log_file"
    return 0
  fi
  local rc=0 vendor bin_dir bin_dirs=''
  printf '%s manual update: pass started\n' "$(stamp)" >>"$log_file"
  VENDOR_FINGERPRINT_HOLD=1 lockf -k -t 900 "$state_dir/run.lock" env VENDOR_CLI_UPDATE_LOCKED=1 "$script_path" run ||
    rc=$?
  # 75 is lockf's timeout: the pass never ran, so its fixers would read CLIs nobody updated.
  if [ "$rc" = 75 ]; then
    printf '%s manual update: another run held the lock for 900s; no pass, no fixers\n' "$(stamp)" >>"$log_file"
    return 1
  fi
  if $night; then
    printf '%s night update: pass done, no orchestrator chat\n' "$(stamp)" >>"$log_file"
    run_doctor
    return 0
  fi
  for vendor in $vendors; do
    bin_dir=$(node_bin_dir "$vendor") && bin_dirs+=":$bin_dir"
  done
  PATH="$PATH$bin_dirs" "${VENDOR_CLI_UPDATE_FINGERPRINT:-$repo_root/bin/vendor-fingerprint}" request --all \
    "Egor's manual update" >/dev/null
  run_doctor
}

wrapper_exec_line() {
  printf 'exec %q "$@"' "$script_path"
}

install_agent() {
  local wrapper_tmp
  mkdir -p "$agent_dir" "$state_dir" "$(dirname "$wrapper")"
  wrapper_tmp=$(mktemp "${wrapper}.tmp.XXXXXX") || return 1
  printf '#!/usr/bin/env bash\n%s\n' "$(wrapper_exec_line)" >"$wrapper_tmp"
  chmod 755 "$wrapper_tmp"
  mv -f "$wrapper_tmp" "$wrapper"
  cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$wrapper</string>
    <string>run</string>
    <string>--if-due</string>
  </array>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>$state_dir/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>$state_dir/launchd.log</string>
</dict>
</plist>
EOF
  launchctl bootout "gui/$UID" "$plist" >/dev/null 2>&1 || true
  if ! launchctl bootstrap "gui/$UID" "$plist"; then
    launchctl load -w "$plist"
  fi
  printf 'Installed %s: a full pass daily, versions checked every 2 hours, a busy or failed vendor retried every 30 minutes.\n' "$label"
}

uninstall_agent() {
  launchctl bootout "gui/$UID" "$plist" >/dev/null 2>&1 || launchctl unload -w "$plist" >/dev/null 2>&1 || true
  rm -f "$plist"
  if [ -f "$wrapper" ] && grep -qF "$(wrapper_exec_line)" "$wrapper"; then
    rm -f "$wrapper"
  fi
  printf 'Uninstalled %s.\n' "$label"
}

show_status() {
  if launchctl print "gui/$UID/$label" >/dev/null 2>&1; then
    printf 'agent: loaded\n'
  else
    printf 'agent: not loaded\n'
  fi
  if [ -s "$state_file" ]; then
    jq -r 'to_entries[] | "\(.key)\t\(.value.result)\tinstalled \(.value.installed)\tlatest \(.value.latest)\t\(.value.checked_at)"' "$state_file"
  fi
  [ -s "$state_file" ] && jq -r 'to_entries[] | .key as $v | (.value.divergence // [])[] | "\($v)\tdivergence\t\(.)"' "$state_file"
  "${VENDOR_CLI_UPDATE_FINGERPRINT:-$repo_root/bin/vendor-fingerprint}" events 2>/dev/null | sed "s/^/event\t/"
  [ -s "$log_file" ] && tail -n 10 "$log_file"
  return 0
}

usage() { printf 'usage: vendor-cli-update [run [--if-due]|now [--night]|install|uninstall|status]\n' >&2; exit 2; }

case "${1:-run}" in
  run) run_all "${@:2}" ;;
  now) update_now "${@:2}" ;;
  install) install_agent ;;
  uninstall) uninstall_agent ;;
  status) show_status ;;
  *) usage ;;
esac
exit; }

#!/usr/bin/env bash
set -euo pipefail

command -v jq >/dev/null 2>&1 || {
  printf 'grok-image: jq is required\n' >&2
  exit 1
}

resolve_root() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}

root=$(resolve_root)
. "$root/share/image-caps.sh"
. "$root/share/image-chroma.sh"
. "$root/share/worker-claims.sh"
. "$root/share/grok-media.sh"

caps() { image_caps_get "$root" grok "$1"; }

generate_aspects=$(caps '.aspects.generate | join("|")')
edit_aspects=$(caps '.aspects.edit | join("|")')
refs_max=$(caps '.refs.max')
default_aspect=$(caps '.aspects.default')

usage() {
  printf 'usage: grok-image --dest <absolute path> --prompt <description> [--aspect <ratio>] [--ref <absolute image path>]... [--transparent] [--account <profile>] [--resume <session-id>]\n' >&2
  printf '  --aspect without --ref/--resume (image_gen): %s\n' "$generate_aspects" >&2
  printf '  --aspect with --ref/--resume (image_edit):    %s\n' "$edit_aspects" >&2
  printf '  --ref up to %s; --resume takes the session id printed as session= by an earlier run\n' "$refs_max" >&2
  exit 2
}

normalized_extension() {
  local value
  value=$(printf '%s' "${1##*.}" | tr '[:upper:]' '[:lower:]')
  case "$value" in jpeg) printf 'jpg' ;; *) printf '%s' "$value" ;; esac
}

# The answer's NAME says nothing about its bytes, and a file named for the destination's own
# extension would be copied verbatim however it is encoded. Unreadable bytes fall through to a
# re-encode. Same reader in codex-image and gemini-image.
actual_format() { # path
  local value
  value=$(sips -g format "$1" 2>/dev/null | awk '/format:/ {print $2; exit}')
  case "$value" in jpeg) printf 'jpg' ;; *) printf '%s' "$value" ;; esac
}

dest=''
prompt=''
aspect=$default_aspect
account=''
resume=''
remove_green=false
refs=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dest)
      [ "$#" -ge 2 ] || usage
      dest=$2
      shift 2
      ;;
    --prompt)
      [ "$#" -ge 2 ] || usage
      prompt=$2
      shift 2
      ;;
    --aspect)
      [ "$#" -ge 2 ] || usage
      aspect=$2
      shift 2
      ;;
    --ref)
      [ "$#" -ge 2 ] || usage
      refs+=("$2")
      shift 2
      ;;
    --transparent)
      remove_green=true
      shift
      ;;
    --account)
      [ "$#" -ge 2 ] || usage
      account=$2
      shift 2
      ;;
    --resume)
      [ "$#" -ge 2 ] || usage
      resume=$2
      shift 2
      ;;
    *) usage ;;
  esac
done

[ -n "$dest" ] && [ -n "$prompt" ] || usage
[[ "$dest" = /* ]] || usage
extension=$(normalized_extension "${dest##*/}")
# An extensionless destination — a bare trailing dot included — names no format for `magick` to
# infer, and the mismatch below would hand it one anyway.
{ [[ "${dest##*/}" = *.* ]] && [ -n "$extension" ]; } || usage
[ -d "$(dirname "$dest")" ] || usage
if [ "$remove_green" = true ] && [ "$extension" != png ]; then
  printf 'grok-image: --transparent requires a .png destination\n' >&2
  exit 2
fi
# Unconditional because the answer's own extension is what decides the conversion and no check here
# can know it yet: a `.jpg` destination answered with a `.png` needs `magick` too. A generation is
# billed the moment it is sent, so the missing tool costs a whole image if it is found afterwards.
command -v magick >/dev/null 2>&1 || {
  printf 'grok-image: magick is required for this output\n' >&2
  exit 1
}
# A non-UUID resume value is not an id to Grok: it is a session TITLE matched against the current
# working directory, and this script's cwd is a fresh temp dir that owns no sessions at all. Such a
# value resolves to nothing or, worse, to some other session that happens to share a title.
if [ -n "$resume" ] && ! [[ "$resume" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
  printf 'grok-image: --resume takes the session UUID printed as session= by an earlier run\n' >&2
  exit 2
fi
ref_count=${#refs[@]}
[ "$ref_count" -le "$refs_max" ] || usage
# A resumed run edits what the session already produced, so it reaches image_edit with or without
# a new reference — and image_edit is the tool whose wider ratio list applies.
editing=false
if [ "$ref_count" -gt 0 ] || [ -n "$resume" ]; then editing=true; fi
# The flag surface is every image script's, but the two grok tools behind it take different ratios.
# Refused here rather than sent: the CLI passes the string to the images API unvalidated, and a
# generation is billed the moment it goes out.
allowed_aspects=$generate_aspects
[ "$editing" = false ] || allowed_aspects=$edit_aspects
case "|$allowed_aspects|" in
  *"|$aspect|"*) ;;
  *)
    case "|$edit_aspects|" in
      *"|$aspect|"*)
        printf 'grok-image: --aspect %s needs --ref or --resume (image_edit); image_gen takes %s\n' \
          "$aspect" "$generate_aspects" >&2
        exit 2
        ;;
    esac
    usage
    ;;
esac
if [ "$ref_count" -gt 0 ]; then
  for ref in "${refs[@]}"; do
    [[ "$ref" = /* ]] && [ -f "$ref" ] || usage
  done
fi
if [ -n "$account" ] && ! grok_media_valid_account "$account"; then
  usage
fi

worker_pick_cmd="${GROK_IMAGE_WORKER_PICK:-worker-pick}"
grokb_cmd="${GROK_IMAGE_GROKB:-grokb}"
grok_profiles_dir="${GROKB_PROFILES_DIR:-$HOME/.grok-profiles}"
main_grok_home="${GROKB_MAIN_GROK_HOME:-$HOME/.grok}"

# A session belongs to exactly one profile's store, so resuming may not go through the selector:
# any other account simply cannot see it.
if [ -n "$resume" ] && [ -z "$account" ]; then
  account=$(grok_media_account_for_session "$grok_profiles_dir" "$main_grok_home" "$resume") || account=''
  if [ -z "$account" ]; then
    printf 'grok-image: no account holds session %s; pass --account\n' "$resume" >&2
    exit 1
  fi
fi

select_rc=0
grok_media_select_account grok-image "$root" "$worker_pick_cmd" "$grok_profiles_dir" "$account" || select_rc=$?
[ "$select_rc" -eq 0 ] || exit "$select_rc"
account=$grok_media_account

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/grok-image.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT
work_dir="$tmp_dir/work"
mkdir -p "$work_dir"
stream_file="$tmp_dir/stream.jsonl"
stderr_file="$tmp_dir/grok.stderr"
content=$prompt
if [ "$remove_green" = true ]; then
  content=$(printf '%s' "$content" | sed 's/[[:<:]][Tt][Rr][Aa][Nn][Ss][Pp][Aa][Rr][Ee][Nn][Tt][[:>:]]//g')
  content="$content on a flat solid #00FF00 green background"
fi

instruction="Generate exactly one image and stop after the image tool completes.
Aspect ratio: $aspect.
Requested content: $content"
tools_arg=image_gen
if [ "$editing" = true ]; then
  # image_edit alone, never both: left in the list, image_gen is a tool the model may answer a
  # reference run with — and on a ratio only image_edit takes it would spend the generation on the
  # very value the gate above exists to keep off the wire.
  tools_arg=image_edit
  if [ "$ref_count" -gt 0 ]; then
    instruction+=$'\nUse image_edit with these source paths in its image parameter:'
    for ref in "${refs[@]}"; do
      instruction+=$'\n- '
      instruction+="$ref"
    done
  else
    instruction+=$'\nUse image_edit on the image you produced most recently in this session, passing its absolute path in the image parameter.'
  fi
  instruction+=$'\nApply the requested content as the edit instruction and keep unrelated source details unchanged.'
else
  instruction+=$'\nUse image_gen and pass the aspect ratio above as aspect_ratio.'
fi

launch_args=(profile "$account" -p "$instruction"
  --tools "$tools_arg" --always-approve --max-turns 4 --output-format streaming-json
  --disable-web-search --no-subagents --cwd "$work_dir")
[ -z "$resume" ] || launch_args+=(--resume "$resume")

generation_rc=0
GROK_MEMORY=0 "$grokb_cmd" "${launch_args[@]}" \
  >"$stream_file" 2>"$stderr_file" || generation_rc=$?

generated=$(grok_media_stream_path "$stream_file" ImageGen,ImageEdit) || generated=''

if [ -z "$generated" ]; then
  case "$(grok_media_failure_class "$stream_file" "$stderr_file")" in
    limit)
      printf 'GROK_USAGE_LIMIT\n' >&2
      exit 3
      ;;
    pool)
      printf 'grok-image: account refused by the worker pool\n' >&2
      exit 4
      ;;
  esac
  printf 'grok-image: generation failed (exit %s); no ImageGen event with a readable file\n' \
    "$generation_rc" >&2
  tail -n 20 "$stderr_file" "$stream_file" >&2 2>/dev/null || true
  exit 1
fi

if [ "$remove_green" = true ]; then
  chroma_key_to_png "$generated" "$tmp_dir" "$dest"
elif [ "$extension" != "$(actual_format "$generated")" ]; then
  magick "$generated" "$dest"
else
  cp "$generated" "$dest"
fi

sips_output=$(sips -g pixelWidth -g pixelHeight -g format "$dest")
width=$(awk '/pixelWidth:/ {print $2; exit}' <<<"$sips_output")
height=$(awk '/pixelHeight:/ {print $2; exit}' <<<"$sips_output")
format=$(awk '/format:/ {print $2; exit}' <<<"$sips_output")
[ -n "$width" ] && [ -n "$height" ] && [ -n "$format" ] || {
  printf 'grok-image: could not inspect output\n' >&2
  exit 1
}

caps_line=$(image_caps_check "$root" grok "$(grok_media_grok_bin || true)")
grok_home=$main_grok_home
[ "$account" = main ] || grok_home="$grok_profiles_dir/$account"
override_key=image_gen_model_override
[ "$editing" = false ] || override_key=image_edit_model_override
observed_model=$(grok_media_model_override "$grok_home" "$override_key")
# Without an override the CLI defers to a remotely configured default it never reports back, so
# the compiled-in id is only an observation while the binary is the verified one.
if [ -z "$observed_model" ] && [ "$caps_line" = 'caps=fresh' ]; then
  observed_model=$(caps '.model.image')
fi

printf 'dest=%s\nsize=%sx%s\nformat=%s\naccount=%s\nsession=%s\n' \
  "$dest" "$width" "$height" "$format" "$account" "$(grok_media_session_id "$stream_file")"
image_caps_model_check "$root" grok image "$observed_model"
printf '%s\n' "$caps_line"

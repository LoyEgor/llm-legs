#!/usr/bin/python3 -I
"""ssd-sampler: who writes which disk, the part the System doctor's uid-bound rusage cannot see (short-lived and
other uids' processes). As root, `fs_usage -w -F -f diskio` runs up to SECS seconds every EVERY_S; its lines are
aggregated in memory into one JSON per sample in OUT_DIR, which the System doctor reads. Each sample carries its own
capture check (a CALIBRATION_B write of known size, device counters every TICK_S beside the traced bytes, fs_usage's
lag and stderr, raw lines the parse cannot place) and its own cost, which the doctor judges as an own tool's. fs_usage
loses events once it lags behind them (2026-10-13: full capture for 2 min, a tenth by minute 9, 3.5 GB RSS), so a
sample ends at LAG_CUT_S of lag, RSS_CUT_B of fs_usage memory or SECS + GRACE_S whatever happens. Owner consented
2026-10-13.

  sudo ssd-sampler install      copy to /usr/local/libexec, load the LaunchDaemon, take the first sample now
  sudo ssd-sampler uninstall"""
import collections, json, os, plistlib, re, resource, shutil, subprocess, sys, threading, time

LABEL = "com.egor.ssd-sampler"
INSTALLED = "/usr/local/libexec/ssd-sampler"
PLIST = "/Library/LaunchDaemons/%s.plist" % LABEL
OUT_DIR = os.environ.get("SSD_SAMPLER_DIR") or "/var/db/ssd-sampler"
SECS = 120
EVERY_S = 12600
KEEP_DAYS = 30
ROWS = 200
TICK_S = 10
LAG_CUT_S = 20
GRACE_S = 60
RSS_CUT_B = 768 << 20
CALIBRATION_B = 16 << 20
ROOTS = {"private", "Users", "System", "Volumes", "Library", "Applications", "opt", "usr", "var", "tmp"}
EXAMPLES = 3
DATA = "/System/Volumes/Data"
FS_USAGE = "/usr/bin/fs_usage"
FLOAT = re.compile(r"^\d+\.\d+$")
TOD = re.compile(r"^(\d\d):(\d\d):(\d\d(?:\.\d+)?)$")


def top_dir(path):
    if path.startswith(DATA + "/"):
        path = path[len(DATA):]
    dirs = path.split("/")[1:-1]
    if dirs[:3] == ["private", "var", "folders"]:
        return {"T": "$TMPDIR", "C": "$CACHEDIR"}.get(dirs[5] if len(dirs) > 5 else "", "/private/var/folders")
    if path.startswith("/Users/") and len(dirs) >= 2:
        return "/".join(["~"] + dirs[2:4])
    return "/" + "/".join(dirs[:3])


def clock(token):
    tod = TOD.match(token)
    return int(tod.group(1)) * 3600 + int(tod.group(2)) * 60 + float(tod.group(3)) if tod else None


def odd(stats, kind, raw, nbytes):
    slot = stats["odd"].setdefault(kind, [0, 0, []])
    slot[0] += nbytes
    slot[1] += 1
    if len(slot[2]) < EXAMPLES:
        slot[2].append(raw.strip())


def aggregate(lines, on_first=None, wall=None, halt=None):
    """(stats, {(proc, dev, dir): [bytes, events]}) of the write events. stats carries what tells a short trace from
    a lossy one: write bytes per call, the event clock span, fs_usage's lag behind it (wall() = local seconds of day),
    bytes per (event tick, dev), the calibration bytes seen, and raw lines of each kind the parse cannot place. It
    stops (stats.cut) once fs_usage lags LAG_CUT_S behind the events, past which the kernel drops them, or on halt()."""
    rows = collections.defaultdict(lambda: [0, 0])
    stats = {"lines": 0, "first": None, "last": None, "lag_max": 0, "calls": {}, "ticks": {}, "calibration": 0,
             "odd": {}, "cut": None}
    for raw in lines:
        if on_first:
            on_first()
            on_first = None
        stats["cut"] = halt() if halt else None
        if stats["cut"]:
            break
        p = raw.split()
        if len(p) < 4:
            continue
        stats["lines"] += 1
        tod = clock(p[0])
        if tod is not None:
            if stats["first"] is None:
                stats["first"] = tod
            stats["last"] = tod
            if wall:
                stats["lag_max"] = max(stats["lag_max"], round((wall() - tod + 43200) % 86400 - 43200, 1))
                if stats["lag_max"] > LAG_CUT_S:
                    stats["cut"] = "lag"
                    break
        if "Wr" not in p[1] and "PgOut" not in p[1]:
            continue
        nbytes = next((int(t[2:], 16) for t in p if t.startswith("B=0x")), 0)
        call = stats["calls"].setdefault(p[1].split("[")[0], [0, 0])
        call[0] += nbytes
        call[1] += 1
        dev = next((t for t in p if t.startswith("/dev/")), None)
        if not dev:
            odd(stats, "nodev", raw, nbytes)
            continue
        i, rest = p.index(dev) + 1, []
        while i < len(p) - 1 and not FLOAT.match(p[i]):
            rest.append(p[i])
            i += 1
        path = " ".join(rest)
        if path.split("/", 1)[0] in ROOTS:
            path = "/" + path
        last = max((i for i, t in enumerate(p) if FLOAT.match(t) and i > 1), default=len(p) - 2)
        tail = p[last + 1:]
        if tail and tail[0] == "W":
            tail = tail[1:]
        proc = re.sub(r"\.\d+$", "", " ".join(tail) or p[-1])
        if not proc:
            odd(stats, "noproc", raw, nbytes)
            proc = "?"
        if "ssd-sampler/calibration" in path:
            stats["calibration"] += nbytes
        where = top_dir(path) if path.startswith("/") else "(none)" if not path else "(rel)"
        if where == "(rel)":
            odd(stats, "rel", raw, nbytes)
        if tod is not None and stats["first"] is not None:
            key = "%d %s" % ((tod - stats["first"]) % 86400 // TICK_S, dev[5:])
            stats["ticks"][key] = stats["ticks"].get(key, 0) + nbytes
        slot = rows[(proc, dev[5:], where)]
        slot[0] += nbytes
        slot[1] += 1
    return stats, rows


def devices():
    """{`internal:<bsd>` or `external:<bsd>`: bytes written}, the System doctor's disk_counters labels."""
    out = subprocess.run(["/usr/sbin/ioreg", "-r", "-c", "IOBlockStorageDevice", "-w0", "-d", "3", "-l"],
                         capture_output=True, text=True, errors="replace").stdout
    disks = {}
    for block in re.split(r"(?m)^\+-o ", out)[1:]:
        location = re.search(r'"Physical Interconnect Location"="(\w+)"', block)
        wrote = re.search(r'"Bytes \(Write\)"=(\d+)', block)
        bsd = re.search(r'"BSD Name" = "(disk\d+)"', block)
        if wrote:
            disks["%s:%s" % ((location.group(1) if location else "unknown").lower(), bsd.group(1) if bsd else "?")] = \
                int(wrote.group(1))
    return disks


def internal(dev):
    info = subprocess.run(["/usr/sbin/diskutil", "info", "-plist", dev], capture_output=True).stdout
    try:
        return int(bool(plistlib.loads(info).get("Internal")))
    except Exception:
        return None


def calibrate():
    path = os.path.join(OUT_DIR, "calibration")
    with open(path, "wb") as handle:
        for _ in range(CALIBRATION_B >> 20):
            handle.write(bytes(1 << 20))
        handle.flush()
        os.fsync(handle.fileno())
    os.remove(path)


def rss(pid):
    out = subprocess.run(["/bin/ps", "-o", "rss=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
    return int(out) * 1024 if out.isdigit() else 0


def run():
    if os.geteuid() != 0:
        sys.exit("ssd-sampler: run needs root; launchd runs it")
    os.makedirs(OUT_DIR, mode=0o755, exist_ok=True)
    ticks, errors, done, calibrated, halted = [], collections.deque(maxlen=40), threading.Event(), [], []
    trace = subprocess.Popen([FS_USAGE, "-w", "-F", "-f", "diskio", "-t", str(SECS)], stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, text=True, errors="replace")
    watchdog = threading.Timer(SECS + GRACE_S, trace.kill)
    watchdog.start()

    def tick():
        ticks.append((time.time(), devices()))
        try:
            calibrate()
            calibrated.append(CALIBRATION_B)
        except OSError as error:
            errors.append("calibration: %s\n" % error)
        while not done.wait(max(0.0, ticks[0][0] + TICK_S * len(ticks) - time.time())):
            ticks.append((time.time(), devices()))
            if rss(trace.pid) > RSS_CUT_B:
                halted.append("rss")

    ticker = threading.Thread(target=tick, daemon=True)
    reader = threading.Thread(target=lambda: errors.extend(trace.stderr), daemon=True)
    reader.start()
    now = time.time()
    local = time.localtime(now)
    midnight = now - local.tm_hour * 3600 - local.tm_min * 60 - local.tm_sec - now % 1
    stats, rows = aggregate(trace.stdout, ticker.start, lambda: time.time() - midnight,
                            lambda: halted[0] if halted else None)
    if stats["cut"]:
        trace.terminate()
        trace.stdout.close()
    try:
        trace.wait(10)
    except subprocess.TimeoutExpired:
        trace.kill()
        trace.wait()
    watchdog.cancel()
    reader.join(5)
    done.set()
    end = time.time()
    if ticker.is_alive():
        ticker.join(30)
    if not ticks:
        ticks.append((end, devices()))
    start, before = ticks[0]
    span = (stats["last"] - stats["first"]) % 86400 if stats["first"] is not None else 0
    stop, closing = min(ticks, key=lambda t: abs(t[0] - start - span))
    where = {dev: internal(dev) for dev in {key[1] for key in rows}}
    top = sorted(([proc, dev, where[dev], path, b, n] for (proc, dev, path), (b, n) in rows.items()),
                 key=lambda r: -r[4])
    steps = []
    for k in range(len(ticks) - 1):
        seen = [sum(b for key, b in stats["ticks"].items()
                    if key.split()[0] == str(k) and where.get(key.split()[1]) == inside) for inside in (1, 0)]
        wrote = [sum(b - ticks[k][1].get(label, b) for label, b in ticks[k + 1][1].items() if label.startswith(kind))
                 for kind in ("internal:", "external:")]
        steps.append([k, seen[0], wrote[0], seen[1], wrote[1]])
    own, kids = resource.getrusage(resource.RUSAGE_SELF), resource.getrusage(resource.RUSAGE_CHILDREN)
    doc = {"v": 3, "start": round(start), "end": round(stop), "lines": stats["lines"],
           "devices": {label: closing[label] - before[label] for label in closing if label in before},
           "columns": ["proc", "dev", "internal", "dir", "bytes", "events"], "rows": top[:ROWS],
           "trace": {"span": round(span), "ran": round(end - start), "lag_max": stats["lag_max"], "cut": stats["cut"],
                     "exit": trace.returncode, "stderr": "".join(errors)[-2000:]},
           "cost": {"cpu_s": round(own.ru_utime + own.ru_stime + kids.ru_utime + kids.ru_stime, 1),
                    "rss_max_b": max(own.ru_maxrss, kids.ru_maxrss), "ran_s": round(time.time() - now),
                    "wrote_b": sum(calibrated)},
           "calibration": {"wrote": sum(calibrated), "seen": stats["calibration"]},
           "calls": stats["calls"], "odd": stats["odd"],
           "ticks_columns": ["tick", "internal seen", "internal device", "external seen", "external device"],
           "ticks": steps}
    final = os.path.join(OUT_DIR, time.strftime("%Y%m%dT%H%M%S", time.localtime(start)) + ".json")
    with open(final + ".tmp", "w") as handle:
        json.dump(doc, handle, separators=(",", ":"))
    os.chmod(final + ".tmp", 0o644)
    os.replace(final + ".tmp", final)
    for name in os.listdir(OUT_DIR):
        path = os.path.join(OUT_DIR, name)
        if name.endswith(".json") and os.path.getmtime(path) < end - KEEP_DAYS * 86400:
            os.remove(path)


def launchctl(*args):
    return subprocess.run(["/bin/launchctl", *args], capture_output=True, text=True)


def install():
    if os.geteuid() != 0:
        sys.exit("ssd-sampler: install needs root: sudo %s install" % os.path.realpath(__file__))
    os.makedirs(os.path.dirname(INSTALLED), mode=0o755, exist_ok=True)
    shutil.copyfile(os.path.realpath(__file__), INSTALLED + ".tmp")
    os.chown(INSTALLED + ".tmp", 0, 0)
    os.chmod(INSTALLED + ".tmp", 0o755)
    os.replace(INSTALLED + ".tmp", INSTALLED)
    os.makedirs(OUT_DIR, mode=0o755, exist_ok=True)
    with open(PLIST, "wb") as handle:
        plistlib.dump({"Label": LABEL, "ProgramArguments": [INSTALLED, "run"], "StartInterval": EVERY_S,
                       "StandardErrorPath": os.path.join(OUT_DIR, "errors.log")}, handle)
    os.chmod(PLIST, 0o644)
    launchctl("bootout", "system/" + LABEL)
    loaded = launchctl("bootstrap", "system", PLIST)
    if loaded.returncode:
        sys.exit("ssd-sampler: launchctl bootstrap failed: %s" % loaded.stderr.strip())
    launchctl("kickstart", "system/" + LABEL)
    print("Installed %s: a %d-min disk-write sample every %.1f h, the first one now (ready in ~%d min); samples in %s."
          % (LABEL, SECS // 60, EVERY_S / 3600, SECS // 60 + 1, OUT_DIR))


def uninstall():
    if os.geteuid() != 0:
        sys.exit("ssd-sampler: uninstall needs root")
    launchctl("bootout", "system/" + LABEL)
    for path in (PLIST, INSTALLED):
        if os.path.exists(path):
            os.remove(path)
    shutil.rmtree(OUT_DIR, ignore_errors=True)
    print("Removed %s, its program and its samples." % LABEL)


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else "run"
    {"run": run, "install": install, "uninstall": uninstall}.get(command, lambda: sys.exit(__doc__))()


if __name__ == "__main__":
    main()

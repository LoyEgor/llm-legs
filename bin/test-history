#!/usr/bin/env bash
# TEMP-TESTTIME(test-history): the summary the temporary Test time menu shows, rebuilt from the journal
# bin/statusline-work-probe.sh appends to (EXPERIMENTS.json, test-time). Line 1 is the menu title,
# `-` is a separator.
set -u
dir="${STATUSLINE_CACHE_DIR:-$HOME/.cache/claude-statusline}"
journal="$dir/test-history.jsonl"
out="$dir/test-history.txt"
now=${TEST_HISTORY_NOW:-$(date +%s)}
[ -f "$journal" ] || exit 0
today=$(date -r "$now" +%Y-%m-%d 2>/dev/null || date -d "@$now" +%Y-%m-%d)

summary=$(jq -Rrn --argjson now "$now" --arg today "$today" '
  def dur: floor | if . < 60 then "\(.)s" elif . < 3600 then "\(. / 60 | floor)m \(. % 60)s"
    else "\(. / 3600 | floor)h \(. % 3600 / 60 | floor)m" end;
  def sum(f): map(f) | add // 0;
  def totals(xs): "\(xs | length) runs · \(xs | sum(.secs) | dur) — chat \(xs | map(select(.who == "chat")) | sum(.secs) | dur) · workers \(xs | map(select(.who == "worker")) | sum(.secs) | dur)";
  def what: .label + (if .total then " \(.total)" + (if (.failed // 0) > 0 then " ✗\(.failed)" else "" end) else "" end);
  [inputs | fromjson? | select(type == "object" and (.end | type) == "number" and (.secs | type) == "number")] as $all
  | ($all | map(select(.end >= $now - 7 * 86400))) as $week
  | ($week | map(select((.end | strflocaltime("%Y-%m-%d")) == $today))) as $day
  | "Test time (temp) · today \($day | sum(.secs) | dur)",
    "today: \(totals($day))",
    "7 days: \(totals($week))",
    "-",
    ($all | sort_by(.end) | reverse | .[:10][]
      | "\(.end | if strflocaltime("%Y-%m-%d") == $today then strflocaltime("%H:%M") else strflocaltime("%m-%d %H:%M") end) \(.repo) · \(what) · \(.secs | dur) · \(.who)"),
    "-",
    "slowest over 7 days:",
    ($week | group_by([.label, .repo]) | map({label: .[0].label, repo: .[0].repo, n: length, t: sum(.secs)})
      | sort_by(-.t) | .[:5][] | "\(.label) · \(.repo) · \(.n)× · \(.t | dur)"),
    "as of \($now | strflocaltime("%H:%M"))"
' "$journal") || exit 1
tmp="$out.tmp.$$"
printf '%s\n' "$summary" > "$tmp" && mv -f "$tmp" "$out" || rm -f "$tmp"

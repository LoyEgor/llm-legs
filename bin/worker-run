#!/usr/bin/env bash
set -u

usage() {
  printf '%s\n' \
    'usage: worker-run start <claudeb|codex|gemini> --brief <file> [--workdir <dir>] [--account <n>] [--model <m>] [--effort <e>] [--resume <id>] [--add-dir <d>]... [--image <p>]... [--web-search]' \
    '       worker-run wait <run-id> [--max <sec>]' \
    '       worker-run report <run-id>' \
    '       worker-run claim <run-id> --paths <path>... [--complete]' >&2
  exit 2
}

fail() {
  printf 'worker-run: %s\n' "$*" >&2
  exit 4
}

# The symlink walk the self-edit guard needs anyway, hoisted here so the include below resolves
# against the same root instead of a second copy of the same loop.
SCRIPT_PATH=${BASH_SOURCE[0]}
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIRECTORY=$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd) || exit 4
  SCRIPT_PATH=$(readlink "$SCRIPT_PATH")
  [[ "$SCRIPT_PATH" = /* ]] || SCRIPT_PATH="$SCRIPT_DIRECTORY/$SCRIPT_PATH"
done
SCRIPT_DIRECTORY=$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd) || exit 4
SCRIPT_PATH="$SCRIPT_DIRECTORY/$(basename "$SCRIPT_PATH")"
umask 077

# Sourced, not optional: without it `worker_pool_refuse_headless` is simply undefined, every
# launch reads as refused, and each one blames the worker pool for a missing include.
. "$SCRIPT_DIRECTORY/../share/worker-pool.sh" ||
  fail 'share/worker-pool.sh is missing: worker-run cannot check worker-pool membership'
command -v worker_pool_refuse_headless >/dev/null ||
  fail 'share/worker-pool.sh defines no worker_pool_refuse_headless: refusing to launch unchecked'

# The main→base-HOME, named→<profiles-dir>/<name> mapping (shared-invariants row m) lives in one
# place for every reader of an agy profile; respelled here, a worker's transcript would be looked
# for under a directory geminib does not use.
. "$SCRIPT_DIRECTORY/../share/gemini-accounts.sh" ||
  fail 'share/gemini-accounts.sh is missing: worker-run cannot resolve an agy profile HOME'
gemini_base_home=$HOME
gemini_profiles_dir="${GEMINIB_PROFILES_DIR:-$HOME/.gemini-profiles}"

# Wall-clock ceiling per vendor invocation (matches gemini's --print-timeout 170m).
# Not a work cap — the longest observed real run is minutes — but a wedged CLI
# (stalled stream, hung auth) must eventually write an exit_code or every wait
# reports "running" forever with no supported way to reclaim the run.
DEADLINE=${WORKER_RUN_DEADLINE:-10200}
[[ "$DEADLINE" =~ ^[0-9]+$ ]] && [ "$DEADLINE" -gt 0 ] || DEADLINE=10200

run_with_deadline() {
  local child watchdog rc
  # <&0 is load-bearing: without an explicit stdin redirect, a background
  # command in a non-interactive shell gets /dev/null instead of the brief
  # the caller redirected in (live-caught: claudeb saw an empty stdin).
  "$@" <&0 &
  child=$!
  # The watchdog sleeps in short hops: killing the subshell strands its in-flight
  # sleep, and a single sleep $DEADLINE would linger for hours after every run.
  (
    end=$(($(date +%s) + DEADLINE))
    while [ "$(date +%s)" -lt "$end" ]; do sleep 5; done
    kill -TERM "$child" 2>/dev/null
    sleep 10
    kill -KILL "$child" 2>/dev/null
  ) &
  watchdog=$!
  wait "$child"
  rc=$?
  kill "$watchdog" 2>/dev/null
  wait "$watchdog" 2>/dev/null
  return "$rc"
}

run_overdue() {
  # A pid check alone cannot be trusted forever: a legacy record carries no launch
  # stamp for supervisor_running to compare, and then a run whose supervisor never
  # wrote exit_code reports "running" indefinitely. Twice the deadline covers the one
  # compatibility retry each vendor may make. Unparseable started_at counts as
  # overdue — better a failed report than an eternal "running".
  local started now
  started=$(jq -r '.started_at // 0' "$1/meta.json" 2>/dev/null)
  [[ "$started" =~ ^[0-9]+$ ]] && [ "$started" -gt 0 ] || return 0
  now=$(date +%s)
  [ $((now - started)) -gt $((2 * DEADLINE + 900)) ]
}

# How far a supervisor's own start may sit from the launch its record stamped before the pid is a
# different process wearing a recycled number. The review hooks judge these same runs by the same
# number (hooks/lib/review-journal.sh, RJ_PID_SLACK): two tools disagreeing about whether a run is
# alive is a chat told to wait forever for one the hooks have already retired.
PID_START_SLACK=30

etime_seconds() { # etime as ps prints it: [[dd-]hh:]mm:ss
  printf '%s' "$1" | awk -F'[-:]' '
    NF == 2 { print $1 * 60 + $2; exit }
    NF == 3 { print $1 * 3600 + $2 * 60 + $3; exit }
    NF == 4 { print $1 * 86400 + $2 * 3600 + $3 * 60 + $4; exit }
  ' 2>/dev/null
}

# Whether the process wearing a run's recorded pid IS that run's supervisor. The number is reused
# within a day on a busy machine, and whatever inherits it answers a signal probe exactly as the
# supervisor would — which is how an abandoned run kept reporting "running". `ps`, never `kill -0`:
# a live process owned by another user answers EPERM to the probe and reads as dead, and the probe
# is reached for only where ps itself proved unable to answer. A record
# written before pid_started_at existed cannot be checked this way and keeps the old answer, or
# every run started before that field went in would begin reading dead.
supervisor_running() { # directory pid
  local elapsed seconds started now begin drift
  [[ "$2" =~ ^[0-9]+$ ]] && [ "$2" -gt 0 ] || return 1
  command -v ps >/dev/null 2>&1 || { kill -0 "$2" 2>/dev/null; return; }
  elapsed=$(ps -p "$2" -o etime= 2>/dev/null | tr -d '[:space:]')
  if [ -z "$elapsed" ]; then
    # "No such process" and "ps could not answer" are the same empty output, and one of them is a
    # live run about to be reported failed. A pid that must be listed settles it — pid 1, not `$$`:
    # a sandbox hiding every process but our own still lists `$$`, and a foreign supervisor then
    # still reads gone. If init is not listed either, ps is what is broken and the probe answers.
    [ -n "$(ps -p 1 -o etime= 2>/dev/null | tr -d '[:space:]')" ] && return 1
    kill -0 "$2" 2>/dev/null
    return
  fi
  started=$(jq -r '.pid_started_at // empty' "$1/meta.json" 2>/dev/null)
  [[ "$started" =~ ^[0-9]+$ ]] && [ "$started" -gt 0 ] || return 0
  seconds=$(etime_seconds "$elapsed")
  [[ "$seconds" =~ ^[0-9]+$ ]] || return 0
  now=$(date +%s)
  begin=$((now - seconds))
  drift=$((begin - started))
  [ "$drift" -ge 0 ] || drift=$((-drift))
  [ "$drift" -le "$PID_START_SLACK" ]
}

config_value() {
  sed -n "s/^$1=//p" "$CONFIG_FILE" 2>/dev/null | head -n1
}

vendor_name() {
  case "$1" in
    claudeb) printf 'CLAUDEB' ;;
    codex) printf 'CODEX' ;;
    gemini) printf 'GEMINI' ;;
  esac
}

failure_outcome() {
  case "$1" in
    claudeb) printf 'CLAUDEB_FAILED' ;;
    codex) printf 'CODEX_UNAVAILABLE' ;;
    gemini) printf 'GEMINI_UNAVAILABLE' ;;
  esac
}

codex_home() {
  if [ "$1" = main ]; then
    printf '%s/.codex' "$HOME"
  else
    printf '%s/%s' "${CODEX_PROFILES_DIR:-$HOME/.codex-profiles}" "$1"
  fi
}

codex_unsupported_model() {
  # tail-scoped for the same reason has_limit_signature is: codex streams the
  # echoed brief to stderr, and the phrase can appear there as prose.
  tail -n 40 "$1/err" 2>/dev/null | grep -Fqi 'model is not supported'
}

# Where the spawned instance keeps its own transcript: claudeb files it under the profile's projects
# tree named by session id, codex under the profile's sessions tree with the id inside the filename,
# agy under the profile's brain tree named by conversation id — deterministic from the id the run's
# own log already gave up, so nothing here searches for it.
session_transcript() {
  local vendor="$1" account="$2" session="$3" transcript=''
  [ -n "$session" ] && [ "$session" != - ] || return 1
  # A relative step in an id read out of a log would resolve the path somewhere else entirely.
  case "$session" in .|..|*/*) return 1 ;; esac
  case "$vendor" in
    claudeb)
      for transcript in "${CLAUDEB_PROFILES_ROOT:-$HOME/.claude-profiles}/$account/projects/"*/"$session.jsonl"; do
        [ -f "$transcript" ] && break
        transcript=''
      done
      ;;
    codex) transcript=$(find "$(codex_home "$account")/sessions" -type f -name "*$session*.jsonl" 2>/dev/null | head -n1) ;;
    gemini)
      transcript="$(gemini_account_home "$account")/.gemini/antigravity-cli/brain/$session/.system_generated/logs/transcript_full.jsonl"
      ;;
  esac
  [ -n "$transcript" ] && [ -f "$transcript" ] || return 1
  printf '%s' "$transcript"
}

warn_cold_resume() {
  local vendor="$1" account="$2" resume="$3" transcript threshold ttl now mtime idle usage size tokens token_k idle_text
  [ -n "$resume" ] || return 0
  case "$vendor" in
    claudeb) threshold=3600; ttl=1h ;;
    codex) threshold=1800; ttl=30m ;;
    *) return 0 ;;
  esac
  transcript=$(session_transcript "$vendor" "$account" "$resume") || return 0
  mtime=$(stat -f %m "$transcript" 2>/dev/null) || return 0
  [[ "$mtime" =~ ^[0-9]+$ ]] || return 0
  now=$(date +%s)
  idle=$((now - mtime))
  [ "$idle" -gt "$threshold" ] || return 0
  usage=''
  if [ "$vendor" = claudeb ]; then
    usage=$(jq -r 'select(.message.usage) | (.message.usage | ((.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)))' "$transcript" 2>/dev/null | tail -n1)
    [[ "$usage" =~ ^[0-9]+$ ]] || usage=''
  fi
  if [ -n "$usage" ]; then
    tokens=$usage
  else
    size=$(stat -f %z "$transcript" 2>/dev/null) || return 0
    [[ "$size" =~ ^[0-9]+$ ]] || return 0
    tokens=$((size / 4))
  fi
  token_k=$(((tokens + 500) / 1000))
  if [ "$idle" -ge 3600 ]; then
    idle_text="$((idle / 3600))h$(((idle % 3600) / 60))m"
  else
    idle_text="$((idle / 60))m"
  fi
  printf 'RESUME-COLD: %s session idle %s, cache TTL ~%s expired; context ~%sk tokens re-ingested at full price — consider a fresh worker with a distilled brief\n' "$vendor" "$idle_text" "$ttl" "$token_k" >&2
  return 0
}

valid_run_id() {
  case "$1" in
    ''|*[!a-z0-9-]*) return 1 ;;
    *) return 0 ;;
  esac
}

run_path() {
  valid_run_id "$1" || fail "invalid run id: $1"
  printf '%s/%s' "${WORKER_RUN_DIR:-$HOME/.cache/claude-worker-runs}" "$1"
}

busy_accounts() {
  # worker-pick ranks by recorded usage and knows nothing about in-flight runs,
  # so parallel starts would all land on the same "best" account. Comma list of
  # accounts carrying a live same-vendor run, for --exclude; busy is a
  # preference, not a wall — callers must retry unexcluded if the pick fails.
  local vendor="$1" root directory pid account
  local -a names=()
  root="${WORKER_RUN_DIR:-$HOME/.cache/claude-worker-runs}"
  for directory in "$root/$vendor-"*; do
    [ -r "$directory/meta.json" ] || continue
    [ ! -f "$directory/exit_code" ] || continue
    pid=$(jq -r '.pid' "$directory/meta.json" 2>/dev/null)
    supervisor_running "$directory" "$pid" || continue
    run_overdue "$directory" && continue
    account=$(jq -r '.account // empty' "$directory/meta.json" 2>/dev/null)
    [ -z "$account" ] || names+=("$account")
  done
  [ "${#names[@]}" -eq 0 ] || printf '%s\n' "${names[@]}" | sort -u | paste -sd, -
}

meta_update() {
  local directory="$1" filter="$2" temporary
  shift 2
  temporary="$directory/meta.json.tmp.$$"
  if ! jq "$@" "$filter" "$directory/meta.json" >"$temporary"; then
    rm -f "$temporary"
    return 1
  fi
  mv -f "$temporary" "$directory/meta.json"
}

run_picker() {
  local picker="$1" vendor="$2" exclude="$3" errors="$4"
  if [ -n "$exclude" ]; then
    "$picker" --account "$vendor" --exclude "$exclude" 2>"$errors"
  else
    "$picker" --account "$vendor" 2>"$errors"
  fi
}

pick_account() {
  # Answers into PICKED_ACCOUNT / PICKED_RC / PICKED_RESERVE. $2 is the hard
  # exclusion list — accounts that already walled in this run's chain; busy
  # accounts are layered on top as a preference only.
  local vendor="$1" walled="$2" picker busy combined errors
  PICKED_ACCOUNT=''
  PICKED_RC=0
  PICKED_RESERVE=false
  PICKED_POOL_EMPTY=false
  PICKED_ROLE_OFF=false
  picker="${WORKER_RUN_WORKER_PICK:-worker-pick}"
  busy=$(busy_accounts "$vendor")
  combined=$(printf '%s\n%s\n' "$walled" "$busy" | tr ',' '\n' | grep -v '^$' | awk '!seen[$0]++' | paste -sd, -)
  # The picker says on stderr when its answer is the session account held in reserve, and
  # dropping that note would launch a worker on the live chat's own quota silently. Each
  # redirect truncates the file, so only the pick actually used is reported.
  errors=$(mktemp "${TMPDIR:-/tmp}/worker-run-pick.XXXXXX") ||
    fail 'could not create a temporary file for the account query'
  PICKED_ACCOUNT=$(run_picker "$picker" "$vendor" "$combined" "$errors")
  PICKED_RC=$?
  # rc 3 once busy accounts are excluded means "everything ELSE is walled", not
  # walled: fall through to the walled-only query and let the pick queue on a
  # busy account rather than lie about limits.
  if [ "$combined" != "$walled" ] && { [ "$PICKED_RC" -ne 0 ] || [ -z "$PICKED_ACCOUNT" ]; }; then
    PICKED_ACCOUNT=$(run_picker "$picker" "$vendor" "$walled" "$errors")
    PICKED_RC=$?
  fi
  [ ! -s "$errors" ] || cat "$errors" >&2
  ! grep -Fq 'SESSION RESERVE' "$errors" || PICKED_RESERVE=true
  # An empty pool is Egor's choice, not a limit: reporting it as a usage limit would send the
  # orchestrator hunting for quota that is not the problem.
  ! grep -Eq 'every [a-z]+ account is out of the worker pool' "$errors" || PICKED_POOL_EMPTY=true
  # A vendor closed for this role is the same kind of decision, and its accounts may be at 0%.
  # Only workers is asked for here, so only workers can come back.
  ! grep -q 'is switched off for workers' "$errors" || PICKED_ROLE_OFF=true
  rm -f "$errors"
  PICKED_ACCOUNT=${PICKED_ACCOUNT%%$'\n'*}
}

read_json_array() {
  local expression="$1" file="$2" value
  while IFS= read -r value; do
    REPLY_ARRAY+=("$value")
  done < <(jq -r "$expression" "$file")
}

supervise_claudeb() {
  local directory="$1" meta="$1/meta.json" account model effort resume cli rc
  local -a command retry
  account=$(jq -r '.account' "$meta")
  model=$(jq -r '.model' "$meta")
  effort=$(jq -r '.effort' "$meta")
  resume=$(jq -r '.resume' "$meta")
  cli=$(jq -r '.cli' "$meta")
  command=("$cli" profile "$account" -p --model "$model" --effort "$effort" --output-format json --dangerously-skip-permissions)
  [ -z "$resume" ] || command+=(--resume "$resume")
  run_with_deadline "${command[@]}" <"$directory/brief" >"$directory/out" 2>"$directory/err"
  rc=$?
  if [ "$rc" -ne 0 ] && grep -Eiq -- '((unknown|unrecognized|invalid|unexpected|unsupported|not supported).{0,80}--effort|--effort.{0,80}(unknown|unrecognized|invalid|unexpected|unsupported|not supported))' "$directory/err"; then
    retry=("$cli" profile "$account" -p --model "$model" --output-format json --dangerously-skip-permissions)
    [ -z "$resume" ] || retry+=(--resume "$resume")
    meta_update "$directory" '.effort_flag_dropped = true' || return 4
    : >"$directory/out"
    : >"$directory/err"
    run_with_deadline "${retry[@]}" <"$directory/brief" >"$directory/out" 2>"$directory/err"
    rc=$?
  fi
  return "$rc"
}

codex_attempt() {
  local directory="$1" account="$2" rc
  shift 2
  if [ "$account" = main ]; then
    (unset CODEX_HOME; run_with_deadline "$@" <"$directory/brief" >/dev/null 2>"$directory/err")
    rc=$?
  else
    CODEX_HOME="$(codex_home "$account")" run_with_deadline "$@" <"$directory/brief" >/dev/null 2>"$directory/err"
    rc=$?
  fi
  return "$rc"
}

supervise_codex() {
  local directory="$1" meta="$1/meta.json" account model effort resume cli rc value drop=false dropped=false
  local -a command retry add_dirs images
  account=$(jq -r '.account' "$meta")
  model=$(jq -r '.model' "$meta")
  effort=$(jq -r '.effort' "$meta")
  resume=$(jq -r '.resume' "$meta")
  cli=$(jq -r '.cli' "$meta")
  REPLY_ARRAY=()
  read_json_array '.add_dirs[]' "$meta"
  add_dirs=("${REPLY_ARRAY[@]}")
  REPLY_ARRAY=()
  read_json_array '.images[]' "$meta"
  images=("${REPLY_ARRAY[@]}")
  if [ -n "$resume" ]; then
    command=("$cli" exec resume "$resume")
    value=$(jq -r '.explicit_model // empty' "$meta")
    [ -z "$value" ] || command+=(-m "$value")
    value=$(jq -r '.explicit_effort // empty' "$meta")
    [ -z "$value" ] || command+=(-c "model_reasoning_effort=$value")
  else
    command=("$cli" exec -C "$(jq -r '.workdir' "$meta")" -m "$model" -c "model_reasoning_effort=$effort" --color never)
  fi
  for value in "${add_dirs[@]}"; do command+=(--add-dir "$value"); done
  for value in "${images[@]}"; do command+=(-i "$value"); done
  if [ "$(jq -r '.web_search' "$meta")" = true ]; then command+=(-c web_search=live); fi
  command+=(-o "$directory/out" -)
  codex_attempt "$directory" "$account" "${command[@]}"
  rc=$?
  if [ "$rc" -ne 0 ] && grep -Fqi 'Not inside a trusted directory' "$directory/err"; then
    # Appended, not spliced in: a resume command starts `exec resume <id>` and a
    # positional insert would separate the subcommand from its id.
    command+=(--skip-git-repo-check)
    meta_update "$directory" '.trusted_dir_retry = true' || return 4
    : >"$directory/out"
    codex_attempt "$directory" "$account" "${command[@]}"
    rc=$?
  fi
  if [ "$rc" -ne 0 ] && codex_unsupported_model "$directory"; then
    # A brief's model override can name a model the account cannot use; the run
    # is otherwise sound, and worker-pick's own default always resolves.
    retry=()
    for value in "${command[@]}"; do
      if [ "$drop" = true ]; then drop=false; continue; fi
      if [ "$value" = -m ]; then drop=true; dropped=true; continue; fi
      retry+=("$value")
    done
    if [ "$dropped" = true ]; then
      meta_update "$directory" '.model_flag_dropped = true' || return 4
      : >"$directory/out"
      codex_attempt "$directory" "$account" "${retry[@]}"
      rc=$?
    fi
  fi
  return "$rc"
}

supervise_gemini() {
  local directory="$1" meta="$1/meta.json" account agy_model resume cli prompt value rc
  local -a command add_dirs
  account=$(jq -r '.account' "$meta")
  agy_model=$(jq -r '.agy_model' "$meta")
  resume=$(jq -r '.resume' "$meta")
  cli=$(jq -r '.cli' "$meta")
  prompt=$(<"$directory/brief")
  command=("$cli" profile "$account" --model "$agy_model" --add-dir "$HOME/.claude")
  REPLY_ARRAY=()
  read_json_array '.add_dirs[]' "$meta"
  add_dirs=("${REPLY_ARRAY[@]}")
  for value in "${add_dirs[@]}"; do command+=(--add-dir "$value"); done
  command+=(--print-timeout 170m --dangerously-skip-permissions --log-file "$directory/log")
  [ -z "$resume" ] || command+=(--conversation "$resume")
  command+=(--print "$prompt")
  run_with_deadline "${command[@]}" >"$directory/out" 2>"$directory/err"
  rc=$?
  return "$rc"
}

reroute_walled() {
  # The run ends on a wall only once every account is walled; otherwise the brief
  # continues on the next one and no caller re-dispatches by hand. A caller-given
  # --account is that caller's decision and stays put — and since --resume always
  # carries one, no session is ever dragged across accounts.
  local directory="$1" vendor="$2" walled tag
  has_limit_signature "$directory" "$vendor" || return 1
  [ "$(jq -r '.pinned' "$directory/meta.json")" != true ] || return 1
  walled=$(jq -r '((.walled_accounts // []) + [.account]) | join(",")' "$directory/meta.json")
  pick_account "$vendor" "$walled"
  [ "$PICKED_RC" -eq 0 ] && [ -n "$PICKED_ACCOUNT" ] || return 1
  # Defence against a picker that ignores --exclude: relaunching on an account
  # this run already burnt would wall again forever.
  case ",$walled," in *",$PICKED_ACCOUNT,"*) return 1 ;; esac
  if [ "$vendor" = gemini ]; then
    grep -Eq "^${PICKED_ACCOUNT}:" <<<"$("$(jq -r '.cli' "$directory/meta.json")" list 2>/dev/null)" ||
      return 1
  fi
  # started_at is restamped because run_overdue budgets one deadline, and a chain
  # of full-length attempts would otherwise read as a wedged CLI.
  meta_update "$directory" \
    '.walled_accounts = ((.walled_accounts // []) + [.account]) | .account = $next | .started_at = $now
     | if $reserve then .session_reserve = true else del(.session_reserve) end' \
    --arg next "$PICKED_ACCOUNT" --argjson now "$(date +%s)" --argjson reserve "$PICKED_RESERVE" || return 1
  if IFS= read -r tag <"$directory/tag" 2>/dev/null; then
    printf '%s · %s\n' "$PICKED_ACCOUNT" "${tag#* · }" >"$directory/tag"
  fi
  : >"$directory/out"
  : >"$directory/err"
  [ "$vendor" != gemini ] || : >"$directory/log"
}

supervise() {
  local directory="$1" vendor workdir rc
  [ -r "$directory/meta.json" ] || return 4
  vendor=$(jq -r '.vendor' "$directory/meta.json")
  workdir=$(jq -r '.workdir' "$directory/meta.json")
  # Even the run that never started answers for itself: absent, its record is indistinguishable from
  # the record of a run still going, and a reader takes that for a run that wrote nothing.
  cd "$workdir" || { persist_run_files "$directory"; return 4; }
  while :; do
    case "$vendor" in
      claudeb) supervise_claudeb "$directory" ;;
      codex) supervise_codex "$directory" ;;
      gemini) supervise_gemini "$directory" ;;
      *) return 4 ;;
    esac
    rc=$?
    # After EVERY attempt, not only the last one: a walled attempt wrote whatever it wrote before the
    # wall, and rerouting restamps the run's start and takes a new session — read afterwards, that
    # attempt's files are behind the cut and belong to nobody at all. A failed attempt counts the
    # same way; the record is a union across attempts.
    persist_run_files "$directory"
    [ "$rc" -eq 0 ] && return 0
    reroute_walled "$directory" "$vendor" || return "$rc"
  done
}

persist_run_files() {
  # The run's own file list, written beside the run the moment it ends, so who answers for reviewing
  # this work no longer depends on somebody reading a report: an unread report left the work covered
  # by nobody, a truncated one covered a prefix silently, and a report read by another chat named the
  # wrong owner (2026-08-17 lens round). Line one is the workdir the paths are relative to; an
  # UNKNOWN line says the list could not be established, which a reader must not read as "no files".
  local directory="$1" workdir
  workdir=$(jq -r '.workdir' "$directory/meta.json" 2>/dev/null)
  compute_run_files "$directory"
  record_worker_session "$directory"
  # A record is written even when there is nothing to put in it. No record at all is indistinguishable
  # from a run that never terminated, and both readers take that absence for "this run wrote nothing"
  # — the one answer that is certainly wrong about a run that has ended.
  if [ -z "$workdir" ] || [ "$workdir" = null ]; then
    RUN_FILES_LIST=''
    RUN_FILES_REASON='the run recorded no workdir to resolve its files against'
  fi
  {
    [ -z "$workdir" ] || [ "$workdir" = null ] || printf 'WORKDIR: %s\n' "$workdir"
    # Union with what earlier attempts recorded — their calls are behind this attempt's start cut,
    # and their UNCERTAINTY carries forward with their paths: an attempt whose list was unanswerable
    # stays unanswerable however cleanly the attempt after it read. PARTIAL rather than UNKNOWN for
    # the shell case: the paths beside it are real and reviewable, and only what stands beside them
    # is missing.
    { [ -z "$RUN_FILES_REASON" ] || printf 'UNKNOWN: %s\n' "$RUN_FILES_REASON"
      [ -z "$RUN_FILES_PARTIAL" ] || printf 'PARTIAL: %s\n' "$RUN_FILES_PARTIAL"
      grep '^UNKNOWN: \|^PARTIAL: ' "$directory/files" 2>/dev/null; } | sort -u
    { [ -z "$RUN_FILES_LIST" ] || printf '%s\n' "$RUN_FILES_LIST"
      grep -v '^WORKDIR: \|^UNKNOWN: \|^PARTIAL: ' "$directory/files" 2>/dev/null; } | sort -u
  } >"$directory/files.tmp.$$" 2>/dev/null &&
    mv -f "$directory/files.tmp.$$" "$directory/files" 2>/dev/null ||
    rm -f "$directory/files.tmp.$$" 2>/dev/null
  record_workdir_escape "$directory"
  # After the listing and never before it: what this reads out of the record is the record this
  # call just wrote, and the paths it must not claim are the ones standing in it.
  record_workdir_dirt "$directory" "$workdir"
  return 0
}

# A run that worked somewhere other than the workdir it was given, kept beside the run so the two
# readers who care hear it: whoever prints a report, and whoever later wonders why the workdir is
# clean. agy did this SILENTLY (live 2026-08-24) — handed a directory it does not trust it moved
# into the first --add-dir and reported success — and a silent success over an untouched workdir is
# the one failure a launcher cannot see. One line per escaped destination, unioned across attempts.
record_workdir_escape() { # directory
  local directory="$1"
  [ -n "$RUN_FILES_ESCAPE" ] || return 0
  grep -qxF -- "$RUN_FILES_ESCAPE" "$directory/workdir-escape" 2>/dev/null && return 0
  printf '%s\n' "$RUN_FILES_ESCAPE" >>"$directory/workdir-escape" 2>/dev/null || :
  return 0
}

# Off the live answer where one was just computed, off the record otherwise, so every report says it
# — the one `wait` prints the moment the run ends included, which computes no file list of its own.
workdir_escape_line() { # directory
  local escaped
  {
    [ -z "${RUN_FILES_ESCAPE:-}" ] || printf '%s\n' "$RUN_FILES_ESCAPE"
    [ ! -r "$1/workdir-escape" ] || sed '/^$/d' "$1/workdir-escape"
  } | awk '!seen[$0]++ {
    printf "WORKDIR-ESCAPE: the run named no path inside its own workdir; it worked in %s\n", $0
  }'
}

# The uncommitted paths of the repository the workdir belongs to, one per line, spelled against
# that repository's top — which is what `--porcelain` answers in, whatever subdirectory the run was
# launched from. Untracked files are listed individually (`-uall`): a file the run created and
# nothing tracks is exactly the work that reaches no other record at all.
#
# Nonzero where git could not answer at all, never an empty answer: read as a clean tree, a status
# that failed at launch makes every file Egor already had open content this run gained.
workdir_dirty_paths() { # workdir
  local answer
  [ -n "${1:-}" ] && [ "$1" != null ] || return 1
  answer=$(git -C "$1" status --porcelain --no-renames -uall -z 2>/dev/null |
    tr '\0' '\n' | cut -c4- | sed '/^$/d' | sort -u; exit "${PIPESTATUS[0]}") || return 1
  [ -z "$answer" ] || printf '%s\n' "$answer"
}

# The content standing at each already-uncommitted path, as `<blob sha>\t<path>`, so the snapshot
# at the end can tell a file this run REWROTE from one it merely found dirty. Without it a worker
# whose vendor keeps no per-file record and whose fix pass edits files that were already dirty —
# which is every fixing pass over a review scope — reaches no store at all: the launching chat saw
# its own worker's fixes as debt owed by nobody, and a closed round covered none of them (live case
# 2026-08-22). A path git cannot hash (gone, a directory, a special file) records `-`, which
# compares equal only to itself.
workdir_dirty_shas() { # workdir
  local top paths path sha
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || return 1
  [ -n "$top" ] || return 1
  paths=$(workdir_dirty_paths "$1") || return 1
  [ -n "$paths" ] || return 0
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    sha=-
    [ -f "$top/$path" ] && sha=$(git -C "$top" hash-object -- "$path" 2>/dev/null) && [ -n "$sha" ] ||
      sha=-
    printf '%s\t%s\n' "$sha" "$path"
  done <<<"$paths"
}

# The paths whose content is not what `dirty-before` recorded for them: rewritten by this run, or
# gone. A floor written before the shas existed lists paths alone, and every one of them reads as
# unchanged — the old behaviour, which is what a record written by an older worker-run must keep.
workdir_rewritten_paths() { # directory workdir
  local before="$1/dirty-before-shas"
  [ -s "$before" ] || return 0
  workdir_dirty_shas "$2" 2>/dev/null | awk -F'\t' -v before="$before" '
    BEGIN { while ((getline line < before) > 0) { split(line, f, "\t"); was[f[2]] = f[1] } }
    NF == 2 && ($2 in was) && was[$2] != $1 { print $2 }
  '
}

# The paths this run's window put content at, top-relative: dirty now and not dirty at launch, or
# dirty at launch and holding different content since. Read twice over — by the dirt record at the
# end, and by the liveness row of a run still going — and one definition, or the two disagree about
# what this run has touched.
workdir_gained_paths() { # directory workdir
  { comm -23 <(workdir_dirty_paths "$2") \
             <(sort -u "$1/dirty-before" 2>/dev/null)
    workdir_rewritten_paths "$1" "$2"; } | sort -u
}

# The run's own listing, spelled against the repository TOP the way the dirt snapshot is. The
# listing answers in paths relative to the WORKDIR, so subtracted as it stands from a top-relative
# set it matches nothing at all for a run launched one directory in, and every path the run's own
# tracker named is recorded a second time as owed by nobody.
listing_top_paths() { # directory top workdir
  local rel=${3%/}
  case "$rel" in
    "$2"/*) rel=${rel#"$2"/} ;;
    *) rel='' ;;
  esac
  grep -v '^WORKDIR: \|^UNKNOWN: \|^PARTIAL: ' "$1/files" 2>/dev/null |
    awk -v rel="$rel" -v top="$2/" '
      !NF { next }
      substr($0, 1, 1) == "/" { if (index($0, top) == 1) print substr($0, length(top) + 1); next }
      { print (rel == "" ? $0 : rel "/" $0) }' | sort -u
}

# What this run's repository gained uncommitted content on while it ran, for the readers that price
# review debt. A worker working through the SHELL — `sed -i`, a redirect, a heredoc — leaves no
# editor tool call in its transcript and no journal entry anywhere, so that work is in no file
# list, in no journal and under no artifact: a repository-wide debt question answered `none` over
# two rewritten files, and a merged review scoped straight past them (live case 2026-08-21).
#
# Written ONLY where the run itself says its own list cannot be complete. A run whose transcript
# answered for every edit it made has named its work already, and the rest of a shared checkout's
# dirt is a co-tenant's — claimed here it would be this run's evidence for somebody else's file.
#
# Bounded twice over, because `git status` answers for the whole checkout and parallel agents share
# it: the paths already uncommitted when the run STARTED are dropped (that is Egor's or another
# chat's work, recorded wherever it was recorded), and so are the paths the run's own tracker named
# (they carry an owner and are priced through it). What is left is content that changed inside this
# run's window and that nothing on this machine attributes to anyone — which is exactly how every
# reader of this file prices it: as owed by nobody, never as the launcher's.
#
# No floor on record, no snapshot: the guard missing and the tree clean at launch are the same
# empty set, and taken for the second the dirt of everyone working beside this run is claimed here.
record_workdir_dirt() { # directory workdir
  local directory="$1" workdir="$2" top gained
  grep -q '^UNKNOWN: \|^PARTIAL: ' "$directory/files" 2>/dev/null || return 0
  [ -f "$directory/dirty-before" ] || return 0
  top=$(git -C "$workdir" rev-parse --show-toplevel 2>/dev/null) || return 0
  [ -n "$top" ] || return 0
  gained=$(comm -23 \
    <(workdir_gained_paths "$directory" "$workdir") \
    <(listing_top_paths "$directory" "$top" "$workdir"))
  [ -n "$gained" ] || [ -f "$directory/dirty" ] || return 0
  { printf 'WORKDIR: %s\n' "$top"
    [ -z "$gained" ] || printf '%s\n' "$gained"
    grep -v '^WORKDIR: ' "$directory/dirty" 2>/dev/null; } |
    awk 'NR == 1 || !seen[$0]++' >"$directory/dirty.tmp.$$" 2>/dev/null &&
    mv -f "$directory/dirty.tmp.$$" "$directory/dirty" 2>/dev/null ||
    rm -f "$directory/dirty.tmp.$$" 2>/dev/null
  return 0
}

record_worker_session() {
  # The worker's OWN session id, beside the launcher this run answers to. A run that edited through
  # the shell alone lists no file at all (`PARTIAL:` and nothing else), while the worker session's
  # own hooks journaled every one of those edits under THIS id — so without the mapping the launching
  # chat commits its worker's work with no debt on it (live case 2026-08-20). Unioned across attempts
  # like the file list: rerouting takes a new session, and the walled attempt journaled under the old
  # one. A resumed run repeats the id the session already had, which is what its entries carry too.
  local directory="$1" vendor session
  vendor=$(jq -r '.vendor' "$directory/meta.json" 2>/dev/null)
  # Only the vendor whose sessions run this machine's journal hooks. A codex or agy id names no chat
  # any journal here was ever written under, and one folded in could only match by accident.
  [ "$vendor" = claudeb ] || return 0
  session=$(session_id "$directory")
  # A resumed run's id is known before its first token — the session keeps the id it already had,
  # and every entry it journals while the run is LIVE carries that one. Read only where the run
  # has not answered with an id of its own yet, so a session that somehow moved still wins.
  [ "$session" != - ] || session=$(jq -r '.resume // empty' "$directory/meta.json" 2>/dev/null)
  # Never a guess: an id nothing named, or one no journal record could carry, leaves no file.
  case "$session" in
    ''|-|.|..|*[!A-Za-z0-9._-]*) return 0 ;;
  esac
  grep -qxF -- "$session" "$directory/worker-session" 2>/dev/null && return 0
  printf '%s\n' "$session" >>"$directory/worker-session" 2>/dev/null || :
  return 0
}

start_run() {
  [ "$#" -ge 1 ] || usage
  local vendor="$1" brief='' workdir="$PWD" explicit_account='' model='' effort='' resume=''
  local account pick_reserve=false pin_fallback=false pin config_model model_label agy_model='' root epoch suffix run_id directory
  local explicit_model='' explicit_effort=''
  local started cli cmd_json add_dirs_json images_json pid supervisor_body value list_output list_rc
  local web_search=false
  local -a add_dirs images command_meta command
  add_dirs=()
  images=()
  command_meta=()
  command=()
  shift
  case "$vendor" in claudeb|codex|gemini) ;; *) usage ;; esac
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --brief) [ "$#" -ge 2 ] || usage; brief="$2"; shift 2 ;;
      --workdir) [ "$#" -ge 2 ] || usage; workdir="$2"; shift 2 ;;
      --account) [ "$#" -ge 2 ] || usage; explicit_account="$2"; shift 2 ;;
      --model) [ "$#" -ge 2 ] || usage; model="$2"; shift 2 ;;
      --effort) [ "$#" -ge 2 ] || usage; effort="$2"; shift 2 ;;
      --resume) [ "$#" -ge 2 ] || usage; resume="$2"; shift 2 ;;
      --add-dir) [ "$#" -ge 2 ] || usage; add_dirs+=("$2"); shift 2 ;;
      --image) [ "$#" -ge 2 ] || usage; images+=("$2"); shift 2 ;;
      --web-search) web_search=true; shift ;;
      *) usage ;;
    esac
  done
  [ -n "$brief" ] || usage
  [ -r "$brief" ] || fail "brief is not readable: $brief"
  [ -d "$workdir" ] || fail "workdir is not a directory: $workdir"
  workdir=$(cd "$workdir" && pwd -P) || fail "could not resolve workdir: $workdir"
  case "$vendor" in
    claudeb)
      [ "${#add_dirs[@]}" -eq 0 ] && [ "${#images[@]}" -eq 0 ] && [ "$web_search" = false ] || fail 'claudeb does not support --add-dir, --image, or --web-search'
      ;;
    codex)
      [ -z "$resume" ] || [ "${#add_dirs[@]}" -eq 0 ] || fail 'codex resume does not support --add-dir'
      ;;
    gemini)
      [ "${#images[@]}" -eq 0 ] && [ "$web_search" = false ] || fail 'gemini does not support --image or --web-search flags'
      # agy has no stdin mode — the brief travels on argv, and past the kernel's
      # per-argument ceiling execve fails with a bare E2BIG long after start.
      [ "$(wc -c <"$brief" | tr -d '[:space:]')" -le 131072 ] || fail 'gemini takes the brief on argv; briefs over 128KB cannot launch — shorten it or use another vendor'
      ;;
  esac
  [ -z "$resume" ] || [ -n "$explicit_account" ] || fail '--resume requires --account: sessions live inside one vendor profile, and worker-pick may route elsewhere'
  # Paths are re-resolved by the detached supervisor after it cds to workdir, so
  # relative arguments valid here would dangle there — pin them to the caller's cwd.
  for value in "${!images[@]}"; do
    [ -r "${images[$value]}" ] || fail "image is not readable: ${images[$value]}"
    [[ "${images[$value]}" = /* ]] || images[$value]="$PWD/${images[$value]}"
  done
  for value in "${!add_dirs[@]}"; do
    [[ "${add_dirs[$value]}" = /* ]] || add_dirs[$value]="$PWD/${add_dirs[$value]}"
  done

  if [ -n "$explicit_account" ]; then
    account="$explicit_account"
  else
    pick_account "$vendor" ''
    pick_reserve=$PICKED_RESERVE
    if [ "$PICKED_RC" -eq 0 ] && [ -n "$PICKED_ACCOUNT" ]; then
      account="$PICKED_ACCOUNT"
    elif [ "$PICKED_RC" -eq 3 ]; then
      if [ "$PICKED_POOL_EMPTY" = true ]; then
        printf 'OUTCOME: %s_UNAVAILABLE\n' "$(vendor_name "$vendor")"
        fail "every $vendor account is out of the worker pool; ask Egor to put one back in or pin one"
      fi
      if [ "$PICKED_ROLE_OFF" = true ]; then
        printf 'OUTCOME: %s_UNAVAILABLE\n' "$(vendor_name "$vendor")"
        fail "$vendor is switched off for workers; ask Egor to turn the role back on or name another vendor"
      fi
      printf 'OUTCOME: %s_USAGE_LIMIT\n' "$(vendor_name "$vendor")"
      exit 3
    else
      pin=$(config_value "${vendor}_profile")
      if [ -n "$pin" ]; then
        # A *_profile pin is a directly named account (shared-invariants row q):
        # a reroute off it would override the same standing --account carries.
        account="$pin"
        pin_fallback=true
      elif [ "$vendor" = claudeb ]; then
        fail 'claudeb needs an explicit account or claudeb_profile pin when worker-pick is unavailable'
      else
        account=main
      fi
    fi
  fi
  # The role switch walls the vendor exactly the way the pool walls an account: an explicit
  # --account, a resumed session or the pin fallback cannot get in under it, and the vendor pin is
  # the one override, because naming it there is the deliberate "use this one anyway".
  if [ "$(config_value "${vendor}_workers")" = off ] &&
     [ "$account" != "$(config_value "${vendor}_profile")" ]; then
    printf 'OUTCOME: %s_UNAVAILABLE\n' "$(vendor_name "$vendor")"
    fail "$vendor is switched off for workers; ask Egor to turn the role back on or name another vendor"
  fi
  # The pool is a wall, not advice to the picker: an account Egor took out cannot carry a worker
  # even when the brief names it outright — only the vendor pin overrides. A picked account is
  # already in the pool, so this only ever fires on --account.
  if ! worker_pool_refuse_headless "$vendor" "$account" "$(config_value "${vendor}_profile")"; then
    printf 'OUTCOME: %s_UNAVAILABLE\n' "$(vendor_name "$vendor")"
    exit 4
  fi
  case "$vendor:$account" in
    gemini:main) ! gemini_main_removed || fail 'gemini account main has been removed' ;;
    gemini:*) [[ "$account" =~ ^[a-z0-9][a-z0-9-]*$ ]] || fail "invalid gemini account: $account" ;;
    *) [[ "$account" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || fail "invalid account: $account" ;;
  esac
  warn_cold_resume "$vendor" "$account" "$resume" || :

  case "$vendor" in
    claudeb)
      model=${model:-$(config_value claudeb_model)}; model=${model:-opus}
      effort=${effort:-$(config_value claudeb_effort)}; effort=${effort:-high}
      cli="${WORKER_RUN_CLAUDEB:-$HOME/.local/bin/claudeb}"
      command_meta=("$cli" profile "$account" -p --model "$model" --effort "$effort" --output-format json --dangerously-skip-permissions)
      [ -z "$resume" ] || command_meta+=(--resume "$resume")
      ;;
    codex)
      config_model=$(sed -n 's/^[[:space:]]*model[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$CODEX_CONFIG" 2>/dev/null | head -n1)
      config_model=${config_model:-gpt-5.6-sol}
      explicit_model=$model
      explicit_effort=$effort
      model=${model:-$config_model}
      effort=${effort:-$(config_value codex_effort)}; effort=${effort:-medium}
      model_label=${model##*-}
      [[ "$model_label" =~ ^[A-Za-z0-9]+$ ]] || model_label=sol
      cli="${WORKER_RUN_CODEX:-codex}"
      if [ -n "$resume" ]; then
        # `exec resume` keeps the session's own model unless told otherwise, so
        # only an explicit request overrides it — config defaults must not.
        command=("$cli" exec resume "$resume")
        [ -z "$explicit_model" ] || command+=(-m "$explicit_model")
        [ -z "$explicit_effort" ] || command+=(-c "model_reasoning_effort=$explicit_effort")
      else
        command=("$cli" exec -C "$workdir" -m "$model" -c "model_reasoning_effort=$effort" --color never)
      fi
      for value in "${add_dirs[@]}"; do command+=(--add-dir "$value"); done
      for value in "${images[@]}"; do command+=(-i "$value"); done
      [ "$web_search" = false ] || command+=(-c web_search=live)
      command+=(-o OUT -)
      if [ "$account" = main ]; then command_meta=("${command[@]}"); else command_meta=(env "CODEX_HOME=$(codex_home "$account")" "${command[@]}"); fi
      ;;
    gemini)
      model=${model:-$(config_value gemini_model)}; model=${model:-pro}
      effort=${effort:-$(config_value gemini_effort)}; effort=${effort:-high}
      [ "$model" != flash ] || model=flash36
      case "$effort" in xhigh|max|ultra) effort=high ;; esac
      case "$model:$effort" in
        pro:high) agy_model='Gemini 3.1 Pro (High)' ;;
        pro:low) agy_model='gemini-3.1-pro-low' ;;
        flash36:high|flash36:medium|flash36:low) agy_model="gemini-3.6-flash-$effort" ;;
        flash35:high|flash35:medium|flash35:low) agy_model="gemini-3.5-flash-$effort" ;;
        *) printf 'OUTCOME: GEMINI_UNAVAILABLE\n'; exit 4 ;;
      esac
      cli="${WORKER_RUN_GEMINIB:-$HOME/.local/bin/geminib}"
      if [ "$account" != main ]; then
        list_output=$("$cli" list 2>/dev/null)
        list_rc=$?
        if [ "$list_rc" -ne 0 ] || ! grep -Eq "^${account}:" <<<"$list_output"; then
          printf 'OUTCOME: GEMINI_UNAVAILABLE\n'
          exit 4
        fi
      fi
      command_meta=("$cli" profile "$account" --model "$agy_model" --add-dir "$HOME/.claude")
      for value in "${add_dirs[@]}"; do command_meta+=(--add-dir "$value"); done
      command_meta+=(--print-timeout 170m --dangerously-skip-permissions --log-file LOG)
      [ -z "$resume" ] || command_meta+=(--conversation "$resume")
      command_meta+=(--print "$(<"$brief")")
      ;;
  esac

  root="${WORKER_RUN_DIR:-$HOME/.cache/claude-worker-runs}"
  mkdir -p "$root" || fail "could not create run root: $root"
  root=$(cd "$root" && pwd -P) || fail "could not resolve run root: $root"
  local prune_marker="$root/.prune"
  if [ ! -f "$prune_marker" ] || [ -n "$(find "$prune_marker" -mtime +1 2>/dev/null)" ]; then
    touch "$prune_marker" 2>/dev/null
    find "$root" -mindepth 1 -maxdepth 1 -type d -mtime +7 -exec rm -rf {} + 2>/dev/null
  fi
  epoch=$(date +%s)
  local attempts=0
  while :; do
    printf -v suffix '%04x' "$RANDOM"
    run_id="$vendor-$epoch-$$-$suffix"
    directory="$root/$run_id"
    mkdir "$directory" 2>/dev/null && break
    attempts=$((attempts + 1))
    [ "$attempts" -lt 50 ] || fail "could not create run directory under: $root"
  done
  cp "$brief" "$directory/brief" || fail 'could not copy brief'
  : >"$directory/out"
  : >"$directory/err"
  [ "$vendor" != gemini ] || : >"$directory/log"
  for value in "${!command_meta[@]}"; do
    case "${command_meta[$value]}" in
      OUT) command_meta[$value]="$directory/out" ;;
      LOG) command_meta[$value]="$directory/log" ;;
    esac
  done
  printf '%s · %s · %s\n' "$account" "${model_label:-$model}" "$effort" >"$directory/tag"
  cmd_json=$(jq -cn --args '$ARGS.positional' -- "${command_meta[@]}") || fail 'could not encode command metadata'
  add_dirs_json=$(jq -cn --args '$ARGS.positional' -- "${add_dirs[@]}") || fail 'could not encode add-dir metadata'
  images_json=$(jq -cn --args '$ARGS.positional' -- "${images[@]}") || fail 'could not encode image metadata'
  started=$(date +%s)
  jq -cn --arg vendor "$vendor" --arg account "$account" --arg model "$model" --arg effort "$effort" \
    --arg agy_model "$agy_model" --arg workdir "$workdir" --arg resume "$resume" --arg cli "$cli" \
    --arg explicit_model "$explicit_model" --arg explicit_effort "$explicit_effort" \
    --argjson pid 0 --argjson started_at "$started" --argjson cmd "$cmd_json" \
    --argjson add_dirs "$add_dirs_json" --argjson images "$images_json" --argjson web_search "$web_search" \
    --argjson pinned "$([ -n "$explicit_account" ] || [ "$pin_fallback" = true ] && printf true || printf false)" \
    '{vendor:$vendor,account:$account,model:$model,effort:$effort,workdir:$workdir,pid:$pid,cmd:$cmd,started_at:$started_at,resume:$resume,cli:$cli,add_dirs:$add_dirs,images:$images,web_search:$web_search,explicit_model:$explicit_model,explicit_effort:$explicit_effort,pinned:$pinned}
     + if $vendor == "gemini" then {agy_model:$agy_model} else {} end' >"$directory/meta.json" || fail 'could not write metadata'
  [ "$pick_reserve" != true ] || meta_update "$directory" '.session_reserve = true' ||
    fail 'could not record the session-reserve note'
  # Who this run answers to, written where a hook can find it without parsing anything: a worker a
  # chat spawned IS that chat (Egor, 2026-08-17), and the run is the only place that fact exists —
  # the report says who a worker is, never who asked for it, so ownership read off a report is
  # ownership assigned to whoever happened to read it. A file rather than a meta.json key because
  # the reader is a per-tool-call hook globbing hundreds of runs, and one grep is its whole budget.
  case "${CLAUDE_CODE_SESSION_ID:-}" in
    ''|.|..|*[!A-Za-z0-9._-]*) ;;
    *) printf '%s\n' "$CLAUDE_CODE_SESSION_ID" >"$directory/launcher" ;;
  esac
  # What was already uncommitted here before this run touched anything. It is the floor the dirt
  # snapshot at the end is measured against: without it, every file Egor or a co-tenant chat had
  # open would be evidence produced by whichever run happened to finish beside them.
  workdir_dirty_paths "$workdir" >"$directory/dirty-before.tmp.$$" 2>/dev/null &&
    mv -f "$directory/dirty-before.tmp.$$" "$directory/dirty-before" 2>/dev/null ||
    rm -f "$directory/dirty-before.tmp.$$" 2>/dev/null
  workdir_dirty_shas "$workdir" >"$directory/dirty-before-shas.tmp.$$" 2>/dev/null &&
    mv -f "$directory/dirty-before-shas.tmp.$$" "$directory/dirty-before-shas" 2>/dev/null ||
    rm -f "$directory/dirty-before-shas.tmp.$$" 2>/dev/null

  supervisor_body='ticks=0
while [ ! -e "$2/.ready" ]; do
  ticks=$((ticks + 1))
  if [ "$ticks" -ge 6000 ]; then
    printf "4\n" >"$2/exit_code.tmp.$$"
    mv -f "$2/exit_code.tmp.$$" "$2/exit_code"
    exit 4
  fi
  sleep 0.01
done
rm -f "$2/.ready"
"$1" _supervise "$2"
rc=$?
printf "%s\n" "$rc" >"$2/exit_code.tmp.$$"
mv -f "$2/exit_code.tmp.$$" "$2/exit_code"
exit "$rc"'
  if command -v setsid >/dev/null 2>&1; then
    nohup setsid bash -c "$supervisor_body" _ "$SCRIPT_PATH" "$directory" </dev/null >/dev/null 2>&1 &
  elif command -v perl >/dev/null 2>&1; then
    nohup perl -MPOSIX -e 'defined POSIX::setsid() or die "setsid failed\n"; exec @ARGV; die "exec failed\n"' \
      bash -c "$supervisor_body" _ "$SCRIPT_PATH" "$directory" </dev/null >/dev/null 2>&1 &
  else
    fail 'setsid is unavailable'
  fi
  pid=$!
  # pid_started_at is the supervisor's launch instant and never restamped: started_at moves on
  # every walled reroute (run_overdue budgets one deadline per attempt), and a liveness check
  # comparing the pid's own age against a restamped clock reads a live rerouted run as dead.
  pid_began=$(date +%s)
  jq --argjson pid "$pid" --argjson began "$pid_began" '.pid = $pid | .pid_started_at = $began' \
    "$directory/meta.json" >"$directory/meta.json.tmp.$$" \
    && mv -f "$directory/meta.json.tmp.$$" "$directory/meta.json" || fail 'could not record supervisor pid'
  # A brief carrying a bench run's own `record` command is that run's triage, delegated: stamp the
  # bench with the supervisor's pid so the Stop gate nagging for an untriaged report stays quiet
  # while this worker lives — and asks again the moment it dies, which is the case the nag is for.
  # The launch instant stands beside the pid on that first line, and the reader compares it: the
  # number is reused within a day, and read alone it silences an untriaged run for as long as
  # whatever inherited it lives (shared-invariants row `ar`).
  # Written before .ready, since the supervisor waits on that file and the triage starts after it.
  delegated_state="${WORKER_STATS_DIR:-${CLAUDEB_DIR:-$HOME/.claude-profiles/.claudeb}/worker-stats}"
  grep -Eo 'review-bench[[:blank:]]+record[[:blank:]]+[0-9]{8}T[0-9]{6}Z-[0-9a-f]+(-[0-9]+)?' \
    "$directory/brief" 2>/dev/null | awk '{print $NF}' | sort -u |
    while IFS= read -r delegated_run; do
      [ -d "$delegated_state/benches/$delegated_run" ] || continue
      {
        printf '%s %s\n' "$pid" "$pid_began"
        [ ! -s "$directory/launcher" ] || cat "$directory/launcher"
      } >"$delegated_state/benches/$delegated_run/delegated" 2>/dev/null || :
    done
  # Before the run is readable and not only when it ends: a resumed session journals under an id
  # this launch already knows, and the gate that prices a live run's worker work reads this file.
  record_worker_session "$directory"
  : >"$directory/.ready"
  printf 'RUN: %s\nTAG: %s · %s · %s\nDIR: %s\n' "$run_id" "$account" "${model_label:-$model}" "$effort" "$directory"
}

session_id() {
  local directory="$1" vendor session
  vendor=$(jq -r '.vendor' "$directory/meta.json")
  session=''
  case "$vendor" in
    claudeb) session=$(jq -r '.session_id // empty' "$directory/out" 2>/dev/null) ;;
    codex)
      # Live codex exec prints 'session id: <uuid>' to stderr, not stdout.
      session=$(grep -Ehio 'session[_ -]?id[[:space:]:=]+[A-Za-z0-9._-]+' "$directory/err" "$directory/out" 2>/dev/null | head -n1 | sed -E 's/.*[[:space:]:=]+//')
      ;;
    gemini)
      # Live agy v1.1.9 log shapes: 'Created conversation <id>' on a fresh run,
      # 'conversationID="<id>"' (non-empty) when resuming.
      session=$(grep -Eo 'Created conversation [A-Za-z0-9._-]+' "$directory/log" 2>/dev/null | head -n1 | awk '{print $3}')
      [ -n "$session" ] || session=$(grep -Eo 'conversationID="[A-Za-z0-9._-]+"' "$directory/log" 2>/dev/null | head -n1 | sed -E 's/.*"([^"]*)"/\1/')
      ;;
  esac
  printf '%s' "${session:--}"
}

has_limit_signature() {
  local directory="$1" vendor="$2" pattern tail_lines=0
  local -a scan
  # out holds the worker's ANSWER, which in this repo routinely discusses quotas
  # and 429s; vendor limit errors arrive on stderr (live-verified for agy and
  # codex). claudeb print mode can emit its limit error on stdout, so it keeps
  # both. The agy log mentions quota even on healthy runs — never scan it.
  case "$vendor" in
    # codex streams the whole session to stderr: the echoed brief plus every file
    # the worker reads. In this repo that text routinely carries "quota",
    # "usage_limit" and "CODEX_USAGE_LIMIT" (live-caught misverdicts), so bare
    # tokens cannot count and the scan sees only the tail, where the CLI's own
    # fatal error is.
    codex) pattern='hit your usage limit|usage limit (reached|exceeded)|usage_limit_reached|quota (exhausted|exceeded|reached)|rate limit (exceeded|reached)|too many requests'; scan=("$directory/err"); tail_lines=40 ;;
    claudeb) pattern='usage limit|(^|[^0-9])429([^0-9]|$)'; scan=("$directory/out" "$directory/err") ;;
    gemini) pattern='RESOURCE_EXHAUSTED|Individual quota reached|usage limit|quota|rate.?limit|(^|[^0-9])429([^0-9]|$)'; scan=("$directory/err") ;;
  esac
  # A rejected model override is a 400, never a wall, however the surrounding
  # transcript reads.
  if [ "$vendor" = codex ] && codex_unsupported_model "$directory"; then return 1; fi
  if [ "$tail_lines" -gt 0 ]; then
    tail -n "$tail_lines" "${scan[0]}" 2>/dev/null | grep -Eiq "$pattern"
  else
    grep -Eiq "$pattern" "${scan[@]}" 2>/dev/null
  fi
}

reroute_lines() {
  jq -r '. as $meta | ($meta.walled_accounts // []) | range(0; length) as $hop
         | "REROUTE: walled on \(.[$hop]) → continued on \(.[$hop + 1] // $meta.account)"' \
    "$1/meta.json" 2>/dev/null
}

print_outcome() {
  local directory="$1" vendor="$2" code="$3" reset
  # Signature scan only on failure: results in this ecosystem routinely DISCUSS
  # quotas and 429s, so a clean exit whose text mentions them is not a limit.
  [ "$code" != 0 ] || return 0
  if has_limit_signature "$directory" "$vendor"; then
    printf 'OUTCOME: %s_USAGE_LIMIT\n' "$(vendor_name "$vendor")"
    # Worker agents relay these lines verbatim, so the wall's SCOPE lives here, not in agent prose:
    # a pinned/resumed run never consulted the pool, and "every account walled" said of one sent
    # the orchestrator hunting a pool problem that never existed.
    if [ "$(jq -r '.pinned' "$directory/meta.json" 2>/dev/null)" = true ]; then
      printf 'WALL: pinned account %s — pool not consulted\n' \
        "$(jq -r '.account' "$directory/meta.json" 2>/dev/null)"
    else
      printf 'WALL: pool exhausted (walled: %s)\n' \
        "$(jq -r '((.walled_accounts // []) + [.account]) | join(", ")' "$directory/meta.json" 2>/dev/null)"
    fi
    reset=$(grep -Eioh '(retry[_ -]?at|reset(s)?([_ -]?at|[ _-]?in)?)[[:space:]:=]+[^,;]+' "$directory/out" "$directory/err" 2>/dev/null | head -n1)
    [ -z "$reset" ] || printf 'RESET: %s\n' "$reset"
  else
    printf 'OUTCOME: %s\n' "$(failure_outcome "$vendor")"
  fi
}

# Said once for every vendor: an editor list answers for editor calls, and a run that also worked
# through the shell changed files no transcript records as a call, so its list is a floor. The gate
# and the record readers match this text, so the vendors may not word it differently.
SHELL_FLOOR_PARTIAL='the run also ran shell commands, whose edits no transcript records'

# The shell command forms that write a file no transcript names. One list for every vendor, because
# the question is the same one: a worker's editor calls name their targets and its shell does not,
# so a run that wrote this way cannot answer for its own files however cleanly the rest of it read.
# Redirects to a file descriptor or to /dev/null are struck out first — they write no file, and
# counted as writes they made every `2>/dev/null` in a read-only run unanswerable. What is NOT here:
# a program that writes files of its own accord (a build, a test run, a package install). Those the
# workdir-dirt net answers for, and listed here they would make almost every real run UNKNOWN.
WRITE_SHELL_PATTERN='(^|[^0-9<>&=])([0-9]+|&)?>>?([^=&]|$)|(^|[[:space:]])(sed|perl|ruby)[[:space:]]+[^|;&]*-i|(^|[[:space:]])(tee|mv|cp|rm|rmdir|touch|ln|truncate|dd|patch)([[:space:]]|$)|(^|[[:space:]])git[[:space:]]+(apply|checkout|restore|stash|clean|reset|mv|rm)([[:space:]]|$)'

writes_through_shell() { # command-line
  printf '%s' "$1" |
    sed -E 's/2>&1|>&2/ /g; s/(([0-9]+|&)?>+)[[:space:]]*\/dev\/null([[:space:];|&]|$)/ \3/g' |
    grep -Eq "$WRITE_SHELL_PATTERN"
}

# One verdict over the tagged rows a vendor's own extractor emits: `F` a mutating call's target,
# `C` a shell command line, `D` the directory a shell command ran in, `X` a call whose file targets
# the transcript does not name, `T` a mutating context with no usable timestamp. Fail-closed, and the
# whole run at once: a write naming no target, a shell command that writes, or a call this reader does
# not know leaves the run UNKNOWN — the answer it gave before any extractor existed, and the one the
# dirt net is written against. A read-only shell command does not spoil the list; any shell at all
# makes it a floor, as it does for claudeb.
resolve_tool_path() { # path workdir
  local value="$1" workdir="$2" part joined='' index
  local -a parts resolved
  if [[ "$value" != /* ]]; then
    [ -n "$workdir" ] && [ "$workdir" != null ] || { printf '%s\n' "$value"; return 0; }
    value="${workdir%/}/$value"
  fi
  IFS='/' read -ra parts <<<"${value#/}"
  for part in "${parts[@]}"; do
    case "$part" in
      ''|.) ;;
      ..)
        if [ "${#resolved[@]}" -gt 0 ]; then
          index=$((${#resolved[@]} - 1))
          unset "resolved[$index]"
        fi
        ;;
      *) resolved+=("$part") ;;
    esac
  done
  for part in "${resolved[@]}"; do joined+="/$part"; done
  printf '%s\n' "${joined:-/}"
}

classify_tool_rows() { # rows workdir
  local rows="$1" workdir="$2" line tag value paths='' places='' shell=false inside=0 outside='' dir=''
  local unexpanded_target_re='(^|/)(\$[A-Za-z_][A-Za-z0-9_]*|\$\{[A-Za-z_][A-Za-z0-9_]*\}|`[^`]+`)(/|$)'
  [ -z "$workdir" ] || [ "$workdir" = null ] || dir="${workdir%/}/"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    tag=${line:0:1}
    value=${line:2}
    case "$tag" in
      F)
        if [ -z "$value" ]; then
          [ -n "$RUN_FILES_REASON" ] ||
            RUN_FILES_REASON='the transcript records a write whose target it does not name'
          continue
        fi
        if [[ "$value" =~ $unexpanded_target_re ]]; then
          [ -n "$RUN_FILES_PARTIAL" ] ||
            RUN_FILES_PARTIAL="the run named a target the transcript cannot resolve: $value"
          continue
        fi
        value=$(resolve_tool_path "$value" "$workdir")
        paths+="$value"$'\n'
        places+="$value"$'\n'
        ;;
      C)
        shell=true
        if writes_through_shell "$value"; then
          [ -n "$RUN_FILES_REASON" ] ||
            RUN_FILES_REASON='the run wrote through the shell, whose targets no transcript names'
        fi
        ;;
      D)
        [ -z "$value" ] || places+="$(resolve_tool_path "$value" "$workdir")"$'\n'
        ;;
      X)
        [ -n "$RUN_FILES_REASON" ] ||
          RUN_FILES_REASON="the transcript records a call whose file targets it does not name: $value"
        ;;
      T)
        [ -n "$RUN_FILES_REASON" ] ||
          RUN_FILES_REASON='the transcript records a mutating context with an unparseable timestamp'
        ;;
    esac
  done <<<"$rows"
  # Live-reproduced 2026-08-24: handed a workdir agy does not trust, agy worked in the first
  # --add-dir instead and said nothing — every path it touched was somewhere else entirely. Not
  # "a path outside the workdir", which is ordinary (a worker reads ~/.claude, writes /tmp): the
  # signal is that NOTHING it named is inside, which no run doing its actual job ever looks like.
  if [ -n "$dir" ] && [ -n "$places" ]; then
    while IFS= read -r value; do
      [ -n "$value" ] || continue
      case "$value" in
        "$dir"*|"${dir%/}") inside=$((inside + 1)) ;;
        *) [ -n "$outside" ] || outside="$value" ;;
      esac
    done <<<"$places"
    [ "$inside" -ne 0 ] || [ -z "$outside" ] || RUN_FILES_ESCAPE="$outside"
  fi
  [ -z "$RUN_FILES_REASON" ] || return 0
  RUN_FILES_LIST=$(awk -v dir="$dir" \
    '{ if (dir != "" && index($0, dir) == 1) $0 = substr($0, length(dir) + 1) } NF' \
    <<<"$paths" | sort -u)
  # First reason wins, like RUN_FILES_REASON: one PARTIAL line carries the caveat, and the named
  # unresolvable target says more than the generic shell floor beside it.
  [ "$shell" = false ] || [ -n "$RUN_FILES_PARTIAL" ] || RUN_FILES_PARTIAL="$SHELL_FLOOR_PARTIAL"
  return 0
}

# agy's own per-conversation log, the only place it names the files it wrote. `transcript.jsonl`
# beside it carries the same rows with the tool_call ARGUMENTS stripped, so it can never answer
# this question — read the `_full` one or nothing.
gemini_tool_rows() { # transcript since
  jq -rs --argjson since "$2" '
    def epoch(value):
      try ((value | tostring | sub("\\.[0-9]+(?=Z$)"; "")) | fromdateiso8601) catch null;
    def write_tool: test("^(write_to_file|replace_file_content|multi_replace_file_content)$");
    def read_tool: test("^(view_file|list_dir|find_by_name|grep_search|search_web|read_url_content|manage_task|schedule|send_message|ask_question|list_permissions)$");
    def succeeded: tostring | ascii_upcase | test("^(DONE|SUCCESS|SUCCEEDED)$");
    def failed: tostring | ascii_upcase | test("^(FAILED|FAILURE|ERROR|CANCELLED|CANCELED|REJECTED)$");
    . as $rows
    | to_entries[]
    | .key as $index
    | .value as $row
    | ($rows[$index + 1] // {}) as $execution
    | epoch($row.created_at? // "") as $t
    | [$row.tool_calls[]?
        | (.name? // "") as $name
        | (.args? // {}) as $args
        | if ($name | write_tool) then
            if ($execution.type? == "CODE_ACTION" and ($execution.status? | succeeded)) then
              "F\t" + (($args.TargetFile? // "") | tostring)
            elif ($execution.type? == "CODE_ACTION" and ($execution.status? | failed)) then empty
            else "X\t" + $name + " outcome" end
          elif $name == "run_command" then
            ("C\t" + (($args.CommandLine? // "") | tostring | gsub("[\n\r\t]"; " "))),
            ("D\t" + (($args.Cwd? // "") | tostring))
          elif ($name | read_tool) then empty
          else "X\t" + $name
          end
      ] as $classified
    | if $t == null then
        if ($classified | length) > 0 then "T\tunparseable" else empty end
      elif $t < $since then empty
      else $classified[]
      end' "$1" 2>/dev/null
}

# codex names its edits twice over and neither alone is complete: the `patch_apply_end` event holds
# the changed paths of a patch that applied, and the call itself holds the patch TEXT, whose
# `*** ... File:` headers name targets for the runs whose events are missing (both gaps live-measured
# over the local rollout corpus). The union is what the run answers with. Its shell arrives as JSON
# inside the harness call — one `"cmd"` field per command, whatever wrapper carries it — and the JS
# `exec` tool is a dispatcher, so what it dispatched TO is the tool that must be classified.
codex_tool_rows() { # rollout since
  jq -rs --argjson since "$2" '
    def epoch(value):
      try ((value | tostring | sub("\\.[0-9]+(?=Z$)"; "")) | fromdateiso8601) catch null;
    def targets(text):
      ([text | scan("\\*\\*\\* (?:Update|Add|Delete) File: [^\"\\\\\r\n]+")
             | sub("^\\*\\*\\* (?:Update|Add|Delete) File: "; "")]
       + [text | scan("\\*\\*\\* Move to: [^\"\\\\\r\n]+")
              | sub("^\\*\\*\\* Move to: "; "")])
      | map(gsub("\\r$"; ""));
    def js_mask:
      gsub("\"(?:\\\\.|[^\"\\\\])*\"|\\x27(?:\\\\.|[^\\x27\\\\])*\\x27|`(?:\\\\.|[^`\\\\])*`|//[^\\r\\n]*|/\\*(?:[^*]|\\*+[^*/])*\\*+/"; " ");
    def exec_tools(text):
      [text | js_mask | scan("\\btools\\.[A-Za-z_][A-Za-z_0-9]*\\s*\\(")
            | sub("^tools\\."; "") | sub("\\s*\\($"; "")];
    def fields(text; key):
      [text | scan("(?:\"" + key + "\"|\\b" + key + "\\b)\\s*:\\s*\"(?:\\\\.|[^\"\\\\])*\"")
            | sub("^(?:\"" + key + "\"|" + key + ")\\s*:\\s*\""; "") | sub("\"$"; "")];
    def result_for(rows; payload):
      [rows[] | .payload? // {}
       | select((.type? == "custom_tool_call_output" or .type? == "function_call_output")
                and (.call_id? // "") != "" and .call_id? == (payload.call_id? // ""))] | last? // {};
    def result_state(result):
      (result.output? // result.result? // "" | tostring) as $output
      | if result.success? == true then "success"
        elif result.success? == false then "failed"
        elif ($output | test("Script failed|apply_patch verification failed|\\\"exit_code\\\"\\s*:\\s*[1-9]"; "i")) then "failed"
        elif ($output | test("Script completed|Success\\.|Done!|\\\"exit_code\\\"\\s*:\\s*0"; "i")) then "success"
        else "unknown"
        end;
    def direct_args(blob): try (blob | fromjson | select(type == "object")) catch null;
    . as $rows
    | to_entries[]
    | .key as $index
    | .value as $row
    | ($row.payload? // {}) as $payload
    | ($rows[$index + 1].payload? // {}) as $next
    | epoch($row.timestamp? // "") as $t
    | [if ($payload.type? == "patch_apply_end") then
         if ($payload.success? == true) then
           (($payload.changes? // {}) | to_entries | .[]
            | ("F\t" + .key), ("F\t" + (.value.move_path? | select(type == "string" and . != ""))))
         else empty end
       elif ($payload.type? == "custom_tool_call" or $payload.type? == "function_call") then
         (($payload.input? // $payload.arguments? // "") | tostring) as $blob
         | (if ($payload.name? == "exec") then
              (exec_tools($blob) | if length == 0 then ["exec (naming no tool)"] else . end)
            else [($payload.name? // "")] end)
         | .[] as $name
         | if $name == "apply_patch" then
              (if ($next.type? == "patch_apply_end") then
                (if $next.success? == true then "success" else "failed" end)
              else result_state(result_for($rows; $payload)) end) as $state
             | if $state == "success" then (targets($blob) | .[] | "F\t" + .)
               elif $state == "failed" then empty
               else "X\tapply_patch outcome" end
           elif ($name | test("^(exec_command|run|shell)$")) then
             if $payload.name? == "exec" then
               (fields($blob; "cmd")) as $commands
               | (fields($blob; "workdir")) as $directories
               | (exec_tools($blob) | map(select(test("^(exec_command|run|shell)$"))) | length) as $calls
               | if ($commands | length) != $calls or ($directories | length) > $calls then
                   "X\t" + $name + " arguments"
                 else ($commands[] | "C\t" + gsub("[\n\r\t]"; " ")),
                      ($directories[] | "D\t" + .)
                 end
             else (direct_args($blob)) as $args
               | if $args == null or ($args.cmd? | type) != "string" then "X\t" + $name + " arguments"
                 else ("C\t" + ($args.cmd | gsub("[\n\r\t]"; " "))),
                      (if ($args.workdir? | type) == "string" then "D\t" + $args.workdir else empty end)
                 end
             end
           elif $name == "write_stdin" then
             if $payload.name? == "exec" then
               (fields($blob; "chars")) as $commands
               | (exec_tools($blob) | map(select(. == "write_stdin")) | length) as $calls
               | if ($commands | length) != $calls then "X\twrite_stdin arguments"
                 else ($commands[] | "C\t" + gsub("[\n\r\t]"; " ")) end
             else (direct_args($blob)) as $args
               | if $args == null or ($args.chars? | type) != "string" then "X\twrite_stdin arguments"
                 else "C\t" + ($args.chars | gsub("[\n\r\t]"; " ")) end
             end
           elif ($name | test("^(view_image|update_plan|wait|web_search|web__run|tool_search|get_goal|update_goal|create_goal|get_app_state|list_apps|getTabContext|request_user_input)$")) then
             empty
           else "X\t" + $name end
       elif ($payload.type? == "mcp_tool_call_end") then
         "X\t" + (($payload.invocation?.tool? // "mcp tool") | tostring)
       else empty end] as $classified
    | if $t == null then
        if ($classified | length) > 0 then "T\tunparseable" else empty end
      elif $t < $since then empty
      else $classified[]
      end' "$1" 2>/dev/null
}

transcript_files() {
  # Only the file-writing tool calls, read by recursive descent so a wrapper key around the message
  # (assistant turn, sidechain entry) does not hide the call. NotebookEdit names its target
  # notebook_path; every other editor names file_path. A call whose tool_result came back is_error
  # changed nothing — a denied or failed edit listed as this run's work is a file it never touched.
  # Nonzero says UNREADABLE, never empty: jq's own status is what the caller needs, so the passes
  # are separate assignments rather than one pipeline whose status belongs to `sort`.
  #
  # `since` is the run's own start: a --resume run APPENDS to the session's existing transcript, so
  # the file also holds the calls of the runs before it, and listing those as this run's work is the
  # shared-checkout mistake one directory in. Each LINE carries its own timestamp and governs its own
  # calls, so the cut is a per-line select ahead of the descent, not a filter on the paths it yields.
  # `fromdateiso8601` refuses the milliseconds every real transcript writes, hence the sub() — parsed
  # without it, every line reads as epoch 0 and a resumed run reports nothing at all.
  local transcript="$1" workdir="$2" since="${3:-0}" failed paths dir=''
  [[ "$since" =~ ^[0-9]+$ ]] || since=0
  failed=$(jq -r '.. | objects
           | select((.type? == "tool_result") and (.is_error? == true))
           | (.tool_use_id? // empty)' "$transcript" 2>/dev/null) || return 1
  paths=$(jq -r --arg failed "$failed" --argjson since "$since" '
           ($failed | split("\n") | map(select(length > 0))) as $bad
           | select(((((.timestamp? // "") | tostring | sub("\\.[0-9]+"; ""))
                      | fromdateiso8601? // 0)) >= $since)
           | .. | objects
           | select((.type? == "tool_use") and ((.name? // "") | test("^(Write|Edit|MultiEdit|NotebookEdit)$")))
           | select((.id? // "") as $id | ($bad | index($id)) == null)
           | (.input.file_path? // .input.notebook_path? // empty)' "$transcript" 2>/dev/null) || return 1
  # A trailing slash makes the prefix double-slashed and silently stops matching; an absent workdir
  # would strip the leading `/` off every absolute path, so it strips nothing at all.
  [ -z "$workdir" ] || [ "$workdir" = null ] || dir="${workdir%/}/"
  awk -v dir="$dir" '{ if (dir != "" && index($0, dir) == 1) $0 = substr($0, length(dir) + 1) } NF' \
    <<<"$paths" | sort -u
}

compute_run_files() {
  # The run's OWN changed files, from the run's own transcript. `git status` in the workdir answers
  # for the whole checkout, which parallel agents share — a relay reading it reported another
  # worker's hunks as this run's work, apology included (live-caught 2026-08-11). Anything this
  # cannot establish sets a REASON rather than falling back to the workdir or to silence: an empty
  # list and an unanswerable one are different claims, and both the printed report and the record on
  # disk are rendered from this one answer so they can never disagree.
  local directory="$1" vendor account workdir session transcript started rows
  RUN_FILES_LIST=''
  RUN_FILES_REASON=''
  RUN_FILES_PARTIAL=''
  RUN_FILES_ESCAPE=''
  vendor=$(jq -r '.vendor' "$directory/meta.json" 2>/dev/null)
  account=$(jq -r '.account' "$directory/meta.json" 2>/dev/null)
  workdir=$(jq -r '.workdir' "$directory/meta.json" 2>/dev/null)
  started=$(jq -r '.started_at // 0' "$directory/meta.json" 2>/dev/null)
  session=$(session_id "$directory")
  if ! transcript=$(session_transcript "$vendor" "$account" "$session"); then
    RUN_FILES_REASON="no session transcript for $session"
    return 0
  fi
  case "$vendor" in
    claudeb)
      if ! RUN_FILES_LIST=$(transcript_files "$transcript" "$workdir" "$started"); then
        RUN_FILES_LIST=''
        RUN_FILES_REASON='transcript unreadable'
        return 0
      fi
      # A list of editor calls answers for editor calls: a run that also worked through the shell —
      # `sed -i`, a redirect, `mv` — changed files no transcript records as a tool call, and the list
      # is a floor rather than the whole of it. Said per run, because a run that ran no shell command
      # has a complete list and must not be doubted.
      if transcript_ran_shell "$transcript" "$started"; then
        RUN_FILES_PARTIAL="$SHELL_FLOOR_PARTIAL"
      fi
      ;;
    gemini)
      rows=$(gemini_tool_rows "$transcript" "$started") || {
        RUN_FILES_REASON='transcript unreadable'
        return 0
      }
      classify_tool_rows "$rows" "$workdir"
      ;;
    codex)
      rows=$(codex_tool_rows "$transcript" "$started") || {
        RUN_FILES_REASON='transcript unreadable'
        return 0
      }
      classify_tool_rows "$rows" "$workdir"
      ;;
    # Fail-closed for a vendor added without an extractor: an empty list is a claim about the run,
    # and it is the one claim certainly wrong about a run nobody can read.
    *) RUN_FILES_REASON="no per-file extractor for $vendor" ;;
  esac
  return 0
}

transcript_ran_shell() {
  local transcript="$1" since="${2:-0}" hits
  [[ "$since" =~ ^[0-9]+$ ]] || since=0
  hits=$(jq -r --argjson since "$since" '
           select(((((.timestamp? // "") | tostring | sub("\\.[0-9]+"; ""))
                    | fromdateiso8601? // 0)) >= $since)
           | .. | objects
           | select((.type? == "tool_use") and ((.name? // "") == "Bash"))
           | .name' "$transcript" 2>/dev/null) || return 1
  [ -n "$hits" ]
}

run_files() {
  local directory="$1" workdir count value
  workdir=$(jq -r '.workdir' "$directory/meta.json" 2>/dev/null)
  compute_run_files "$directory"
  workdir_escape_line "$directory"
  if [ -n "$RUN_FILES_REASON" ]; then
    printf 'RUN-FILES: unknown (%s)\n' "$RUN_FILES_REASON"
    return 0
  fi
  if [ -z "$RUN_FILES_LIST" ]; then
    # The count answers for editor tool calls only, and a bare `0` read as "changed nothing": an
    # edit made through the shell — `sed -i`, a redirect, `mv` — is real and appears in no transcript
    # as a tool call.
    printf 'RUN-FILES: 0 (editor tool calls only; shell edits are not tracked)\n'
    [ -z "$RUN_FILES_PARTIAL" ] || printf 'RUN-FILES-PARTIAL: %s\n' "$RUN_FILES_PARTIAL"
    return 0
  fi
  count=$(grep -c '' <<<"$RUN_FILES_LIST")
  # The paths below are workdir-relative (absolute only when they fall outside it), so a consumer
  # standing anywhere else — the launching chat's journal hook — can resolve them only with this.
  [ -z "$workdir" ] || [ "$workdir" = null ] || printf 'WORKDIR: %s\n' "$workdir"
  printf 'RUN-FILES: %s\n' "$count"
  while IFS= read -r value; do
    printf 'RUN-FILE: %s\n' "$value"
  done <<<"$RUN_FILES_LIST"
  [ -z "$RUN_FILES_PARTIAL" ] || printf 'RUN-FILES-PARTIAL: %s\n' "$RUN_FILES_PARTIAL"
}

result_tail() {
  local directory="$1" vendor="$2" lines="$3"
  printf 'RESULT-TAIL:\n'
  if [ "$vendor" = claudeb ]; then
    jq -r '.result // empty' "$directory/out" 2>/dev/null | tail -n "$lines"
  else
    tail -n "$lines" "$directory/out" 2>/dev/null
  fi
}

terminal_report() {
  local directory="$1" code vendor status
  code=$(tr -d '[:space:]' <"$directory/exit_code")
  [[ "$code" =~ ^[0-9]+$ ]] || code=unknown
  vendor=$(jq -r '.vendor' "$directory/meta.json")
  if [ "$code" = 0 ]; then status=done; else status=failed; fi
  printf 'STATUS: %s\nEXIT: %s\nSESSION: %s\n' "$status" "$code" "$(session_id "$directory")"
  reroute_lines "$directory"
  workdir_escape_line "$directory"
  print_outcome "$directory" "$vendor" "$code"
  unnamed_line "$directory"
  result_tail "$directory" "$vendor" 40
  if [ "$code" != 0 ]; then
    printf 'ERR-TAIL:\n'
    tail -n 40 "$directory/err" 2>/dev/null
  fi
}

unknown_report() {
  local directory="$1" vendor
  vendor=$(jq -r '.vendor' "$directory/meta.json")
  printf 'STATUS: failed\nEXIT: unknown\nSESSION: %s\nOUTCOME: %s\n' "$(session_id "$directory")" "$(failure_outcome "$vendor")"
  result_tail "$directory" "$vendor" 40
  printf 'ERR-TAIL:\n'
  tail -n 40 "$directory/err" 2>/dev/null
}

# How long ago this run last put bytes on disk. OUT-BYTES is no liveness signal — claudeb writes
# its JSON once, at the end, so it reads 0 for the whole run and a wrapper agent declared a healthy
# 52-minute run stalled one minute before it finished (live 2026-08-24). Newest mtime among the
# paths the dirt tracker already calls this run's own; nonzero where nothing has changed yet.
last_edit_age() { # directory workdir now
  local directory="$1" workdir="$2" now="$3" top path target mtime newest='' age
  [ -f "$directory/dirty-before" ] || return 1
  top=$(git -C "$workdir" rev-parse --show-toplevel 2>/dev/null) || return 1
  [ -n "$top" ] || return 1
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    target="$top/$path"
    while ! mtime=$(stat -f %m "$target" 2>/dev/null || stat -c %Y "$target" 2>/dev/null); do
      [ "$target" != "$top" ] || { mtime=''; break; }
      target=${target%/*}
    done
    [ -n "$mtime" ] || continue
    [[ "$mtime" =~ ^[0-9]+$ ]] || continue
    [ -n "$newest" ] && [ "$mtime" -le "$newest" ] || newest=$mtime
  done < <(workdir_gained_paths "$directory" "$workdir")
  [ -n "$newest" ] || return 1
  age=$((now - newest)); [ "$age" -ge 0 ] || age=0
  printf '%s\n' "$age"
}

# CPU the run has burned, summed over the whole process group: the supervisor is `setsid`'d, so its
# pid IS the group and one `ps` covers the CLI and everything it spawned. The second half of the
# liveness answer — a run whose files sit still is thinking if this keeps climbing.
pid_group_cpu_seconds() { # pid
  [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -gt 0 ] || return 1
  ps -g "$1" -o time= 2>/dev/null |
    awk 'NF { n = split($1, f, ":"); s = 0; for (i = 1; i <= n; i++) s = s * 60 + f[i]; total += s; seen = 1 }
         END { if (!seen) exit 1; printf "%d\n", total }'
}

running_report() {
  local directory="$1" now started elapsed out_bytes err_bytes workdir age cpu
  now=$(date +%s)
  started=$(jq -r '.started_at' "$directory/meta.json")
  elapsed=$((now - started)); [ "$elapsed" -ge 0 ] || elapsed=0
  out_bytes=$(wc -c <"$directory/out" | tr -d '[:space:]')
  err_bytes=$(wc -c <"$directory/err" | tr -d '[:space:]')
  printf 'STATUS: running\nELAPSED: %s\nOUT-BYTES: %s\nERR-BYTES: %s\nSESSION: %s\n' "$elapsed" "$out_bytes" "$err_bytes" "$(session_id "$directory")"
  workdir=$(jq -r '.workdir' "$directory/meta.json" 2>/dev/null)
  age=$(last_edit_age "$directory" "$workdir" "$now") || age=none
  printf 'LAST-EDIT: %s\n' "$age"
  cpu=$(pid_group_cpu_seconds "$(jq -r '.pid' "$directory/meta.json" 2>/dev/null)") &&
    printf 'CPU-SECONDS: %s\n' "$cpu"
  return 0
}

wait_run() {
  [ "$#" -ge 1 ] || usage
  local run_id="$1" max=100 directory wait_started now waited remaining sleep_for pid
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --max) [ "$#" -ge 2 ] || usage; max="$2"; shift 2 ;;
      *) usage ;;
    esac
  done
  [[ "$max" =~ ^[0-9]+$ ]] || usage
  directory=$(run_path "$run_id")
  [ -d "$directory" ] && [ -r "$directory/meta.json" ] || fail "unknown run: $run_id"
  wait_started=$(date +%s)
  while :; do
    if [ -f "$directory/exit_code" ]; then terminal_report "$directory"; return 0; fi
    pid=$(jq -r '.pid' "$directory/meta.json")
    # pid 0 is the pre-launch placeholder, and a probe of it would answer for our own
    # process group and report a never-started run as alive.
    if ! supervisor_running "$directory" "$pid" || run_overdue "$directory"; then
      sleep 0.1
      if [ -f "$directory/exit_code" ]; then terminal_report "$directory"; else unknown_report "$directory"; fi
      return 0
    fi
    now=$(date +%s)
    waited=$((now - wait_started)); [ "$waited" -ge 0 ] || waited=0
    if [ "$waited" -ge "$max" ]; then running_report "$directory"; return 0; fi
    remaining=$((max - waited))
    sleep_for=5; [ "$remaining" -ge "$sleep_for" ] || sleep_for=$remaining
    sleep "$sleep_for"
  done
}

report_run() {
  [ "$#" -eq 1 ] || usage
  local directory vendor account code status cost s5_rate pid
  directory=$(run_path "$1")
  [ -d "$directory" ] && [ -r "$directory/meta.json" ] || fail "unknown run: $1"
  vendor=$(jq -r '.vendor' "$directory/meta.json")
  account=$(jq -r '.account' "$directory/meta.json")
  printf 'ACCOUNT: %s (%s)%s\n' "$account" "$vendor" \
    "$(jq -r 'if .session_reserve == true then " SESSION RESERVE" else "" end' "$directory/meta.json")"
  reroute_lines "$directory"
  if [ -f "$directory/exit_code" ]; then
    code=$(tr -d '[:space:]' <"$directory/exit_code")
    [[ "$code" =~ ^[0-9]+$ ]] || code=unknown
    if [ "$code" = 0 ]; then status=done; else status=failed; fi
    printf 'STATUS: %s\nEXIT: %s\nSESSION: %s\n' "$status" "$code" "$(session_id "$directory")"
    print_outcome "$directory" "$vendor" "$code"
    if [ "$code" != 0 ]; then
      printf 'ERR-TAIL:\n'
      tail -n 80 "$directory/err" 2>/dev/null
    fi
  else
    pid=$(jq -r '.pid' "$directory/meta.json")
    if supervisor_running "$directory" "$pid" && ! run_overdue "$directory"; then
      running_report "$directory"
    else
      printf 'STATUS: failed\nEXIT: unknown\nSESSION: %s\nOUTCOME: %s\n' "$(session_id "$directory")" "$(failure_outcome "$vendor")"
      printf 'ERR-TAIL:\n'
      tail -n 80 "$directory/err" 2>/dev/null
    fi
  fi
  if [ "$vendor" = claudeb ]; then
    cost=$(jq -r '.total_cost_usd // empty' "$directory/out" 2>/dev/null)
    # The $2/M base permanently defines one Sonnet-5-equivalent token; after the public rate
    # returns to $3/M, one Sonnet 5 token weighs 1.5 of these stable units.
    s5_rate=${WORKER_RUN_S5_USD_PER_M:-}
    LC_ALL=C awk -v n="$s5_rate" \
      'BEGIN { exit !(n ~ /^[+]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?$/ && n > 0) }' \
      || s5_rate=2.0
    # LC_ALL=C: a comma-decimal locale reads 1.25 as 1 and understates the cost fivefold.
    # The k rung stops short of 999500 so that %.0f never rounds its way to "1000k".
    [ -z "$cost" ] || printf 'COST: %s\n' "$(LC_ALL=C awk -v c="$cost" -v r="$s5_rate" \
      'BEGIN { t = c * 1e6 / r
               if (t > 0 && t < 0.5) printf "<1 tok-eq"
               else if (t < 999.5) printf "%.0f tok-eq", t
               else if (t < 999500) printf "%.0fk tok-eq", t / 1e3
               else printf "%.1fM tok-eq", t / 1e6 }')"
  fi
  run_files "$directory"
  printf 'RESULT:\n'
  if [ "$vendor" = claudeb ]; then
    jq -r '.result // empty' "$directory/out" 2>/dev/null | tail -n 400
  else
    tail -n 400 "$directory/out" 2>/dev/null
  fi
}

# How many of those paths the line still spells out itself. Past it the reader is pointed at the
# record instead: the list is there to be pasted, and one nobody can read at the end of a report is
# not one anybody pastes.
UNNAMED_INLINE_MAX=${WORKER_RUN_UNNAMED_INLINE_MAX:-25}

# The paths a run's window changed that no record on this machine names, spelled absolutely so the
# claim below takes them exactly as they are printed. The `dirty` record is only ever written where
# the run itself says its own list cannot be complete, so its rows ARE the unowned set — printed at
# the end of `wait` because that is the one moment the launching chat is looking at this run and can
# still say which of them are its worker's (live case 2026-08-25: 887 lines nobody answered for).
unnamed_line() { # directory
  local directory="$1" top paths count listed path
  grep -q '^UNKNOWN: \|^PARTIAL: ' "$directory/files" 2>/dev/null || return 0
  top=$(sed -n 's/^WORKDIR: //p' "$directory/dirty" 2>/dev/null | head -n1)
  [ -n "$top" ] || return 0
  paths=$(grep -v '^WORKDIR: ' "$directory/dirty" 2>/dev/null | sed '/^$/d')
  [ -n "$paths" ] || return 0
  count=$(grep -c '' <<<"$paths")
  if [ "$count" -gt "$UNNAMED_INLINE_MAX" ]; then
    # The list is the record's, not this line's, past the point where it stops being readable: the
    # 887-path case above printed a multi-kilobyte shell-quoted line at the end of every wait,
    # crowding out the outcome and the result tail it is printed beside.
    printf 'UNNAMED: %s path(s) changed in this run'"'"'s window that no record names, listed one per line in %s — claim yours: worker-run claim %s --paths <path>...\n' \
      "$count" "$directory/dirty" "${directory##*/}"
    return 0
  fi
  # Quoted for the shell this line is pasted into: a path carrying a space arrives at `claim` as
  # two paths, and one carrying a metacharacter as whatever that shell makes of it.
  listed=$(while IFS= read -r path; do printf '%q ' "$top/$path"; done <<<"$paths")
  printf 'UNNAMED: %s path(s) changed in this run'"'"'s window that no record names — claim yours: worker-run claim %s --paths %s\n' \
    "$count" "${directory##*/}" "${listed% }"
}

# What the run's own listing is spelled against. The record's first line where it has one, since that
# is what every reader of `files` resolves its rows with; the metadata otherwise, so a run whose
# listing could not be established at all still has an anchor to check a claim against.
claim_workdir() { # directory
  local workdir
  workdir=$(sed -n 's/^WORKDIR: //p' "$1/files" 2>/dev/null | head -n1)
  [ -n "$workdir" ] || workdir=$(jq -r '.workdir // empty' "$1/meta.json" 2>/dev/null)
  [ "$workdir" != null ] || workdir=''
  printf '%s' "$workdir"
}

# Lexical, like every other path answer here: a claimed target need not still exist, and a symlink
# resolved would answer about a path the run never named. Globbing off for the split, or a `*` in a
# claimed path is answered by whatever the filesystem happens to hold beside it.
normalize_path() { # path
  local part out='' IFS=/ globbing=on
  case $- in *f*) globbing=off ;; esac
  set -f
  for part in $1; do
    case "$part" in
      ''|.) ;;
      ..) out=${out%/*} ;;
      *) out="$out/$part" ;;
    esac
  done
  [ "$globbing" = off ] || set +f
  printf '%s' "${out:-/}"
}

# `worker-run claim <run-id> --paths <p>... [--complete]` — the launching chat NAMING the work its
# worker did through the shell. A run that edited that way lists no file and its work is owned by
# nobody; only the chat that spawned it knows which of the paths that changed in its window are its
# worker's, so only that chat may say so, and only once the run has ended and the set has stopped
# moving. The PARTIAL/UNKNOWN caveat stands through an ordinary claim — the claimed rows are real,
# and whatever stood beside them may still be missing — and is retired only by `--complete`, which
# is the caller stating that this IS the whole list.
claim_run() {
  [ "$#" -ge 1 ] || usage
  local run_id="$1" directory workdir top complete=false session launcher path absolute relative
  local -a paths=() resolved=()
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --complete) complete=true; shift ;;
      --paths)
        shift
        while [ "$#" -gt 0 ]; do
          case "$1" in --*) break ;; esac
          paths+=("$1"); shift
        done
        ;;
      *) usage ;;
    esac
  done
  [ "${#paths[@]}" -gt 0 ] || usage
  directory=$(run_path "$run_id")
  [ -d "$directory" ] && [ -r "$directory/meta.json" ] || fail "unknown run: $run_id"
  # A live run is still writing its own record: a claim landing mid-flight is overwritten by the next
  # `persist_run_files`, and the paths it named read back as nobody's again.
  [ -f "$directory/exit_code" ] ||
    fail "run $run_id is still running; claim its files once it has ended"
  session="${CLAUDE_CODE_SESSION_ID:-}"
  launcher=$(tr -d '[:space:]' <"$directory/launcher" 2>/dev/null)
  [ -n "$launcher" ] ||
    fail "run $run_id records no launching chat, so nobody may claim its files"
  [ -n "$session" ] ||
    fail "this shell names no chat (CLAUDE_CODE_SESSION_ID), and run $run_id answers to $launcher"
  [ "$session" = "$launcher" ] ||
    fail "run $run_id was launched by $launcher, not by this chat; the launching chat is the only one that may claim its files"
  workdir=$(claim_workdir "$directory")
  [ -n "$workdir" ] || fail "run $run_id records no workdir to resolve a claim against"
  top=$(git -C "$workdir" rev-parse --show-toplevel 2>/dev/null) || top=''
  # Every path is checked before any is written: a claim half applied leaves the caller unable to
  # tell which of its paths are named and which are still nobody's.
  #
  # Under the workdir, or anywhere in the REPOSITORY that workdir sits in: the dirt record this
  # claim answers is spelled against the repository top whatever directory the run was launched in,
  # so a run launched in a subdirectory has the very line `wait` prints refused whole (and the
  # listing already spells a path outside the workdir absolutely). Anything outside that
  # repository is nothing this run's records ever named.
  for path in "${paths[@]}"; do
    case "$path" in
      /*) absolute=$(normalize_path "$path") ;;
      *) absolute=$(normalize_path "$workdir/$path") ;;
    esac
    case "$absolute" in
      "$workdir"/*) ;;
      *)
        [ -n "$top" ] && [ "$absolute" != "${absolute#"$top"/}" ] ||
          fail "$path is not under this run's workdir ($workdir)${top:+ or its repository ($top)}"
        ;;
    esac
    resolved+=("$absolute")
  done
  {
    if [ "$complete" = true ]; then
      grep '^WORKDIR: ' "$directory/files" 2>/dev/null
    else
      grep '^WORKDIR: \|^UNKNOWN: \|^PARTIAL: ' "$directory/files" 2>/dev/null
    fi
    { grep -v '^WORKDIR: \|^UNKNOWN: \|^PARTIAL: ' "$directory/files" 2>/dev/null
      for absolute in "${resolved[@]}"; do
        relative=${absolute#"$workdir"/}
        printf '%s\n' "$relative"
      done; } | sed '/^$/d' | sort -u
  } >"$directory/files.tmp.$$" 2>/dev/null &&
    mv -f "$directory/files.tmp.$$" "$directory/files" 2>/dev/null ||
    { rm -f "$directory/files.tmp.$$" 2>/dev/null; fail "could not rewrite the listing of $run_id"; }
  # A claimed path carries an owner now, and the dirt record is exactly the set that carries none.
  if [ -n "$top" ] && [ -f "$directory/dirty" ]; then
    local remaining
    # A difference, never a symmetric one: a claimed path the dirt record never held must not be
    # ADDED to it by the very call that names it.
    remaining=$(comm -23 \
      <(grep -v '^WORKDIR: ' "$directory/dirty" 2>/dev/null | sed '/^$/d' | sort -u) \
      <(for absolute in "${resolved[@]}"; do
          case "$absolute" in "$top"/*) printf '%s\n' "${absolute#"$top"/}" ;; esac
        done | sort -u))
    if [ -n "$remaining" ]; then
      { printf 'WORKDIR: %s\n' "$top"; printf '%s\n' "$remaining"; } >"$directory/dirty.tmp.$$" &&
        mv -f "$directory/dirty.tmp.$$" "$directory/dirty" 2>/dev/null ||
        rm -f "$directory/dirty.tmp.$$" 2>/dev/null
    else
      rm -f "$directory/dirty" 2>/dev/null
    fi
  fi
  printf 'CLAIMED: %s path(s) for %s\nFILES:\n' "${#resolved[@]}" "$run_id"
  head -n 20 "$directory/files" 2>/dev/null
}

CONFIG_FILE="${WORKER_RUN_CONFIG_FILE:-$HOME/.claude/worker-model}"
CODEX_CONFIG="${WORKER_RUN_CODEX_CONFIG:-$HOME/.codex/config.toml}"
# Every arm exits from inside the case: workers edit this very file while their
# own supervisor and the caller's `wait` are still running it, and bash re-reads
# the script from a byte offset once the last top-level command returns — a file
# that changed size since then parses as garbage, so a finished run dies with a
# syntax error and exit 2 (live-caught: a successful codex run reported EXIT: 2).
case "${1:-}" in
  start) shift; start_run "$@"; exit $? ;;
  wait) shift; wait_run "$@"; exit $? ;;
  report) shift; report_run "$@"; exit $? ;;
  claim) shift; claim_run "$@"; exit $? ;;
  _supervise) shift; supervise "$@"; exit $? ;;
  *) usage ;;
esac

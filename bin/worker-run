#!/usr/bin/env bash
# `env bash` resolves to macOS bash 3.2 when PATH lists /bin before Homebrew; this script needs bash 4+.
if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  for modern_bash in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [ -x "$modern_bash" ] && "$modern_bash" -c '[ "${BASH_VERSINFO[0]}" -ge 4 ]' && exec "$modern_bash" "$0" "$@"
  done
  echo "worker-run: bash 4+ required (found $BASH_VERSION)" >&2
  exit 1
fi
{
set -u

usage() {
  printf '%s\n' \
    'usage: worker-run start <claudeb|codex|gemini|grok|light> --brief <file> [--workdir <dir>] [--account <n>] [--model <m>] [--effort <e>] [--resume <id>] [--round <review-round-id>] [--add-dir <d>]... [--image <p>]... [--web-search | --no-web-search] [--browser] [--target dia|chrome] [--chrome] [--computer] [--role research --research-timeout <duration>]' \
    '       worker-run wait <run-id> [--max <sec>]' \
    '       worker-run report <run-id>' \
    '       worker-run say [<run-id>] <text>' \
    '       worker-run transcript <run-id>' \
    '       worker-run claim <run-id> --paths <path>... [--complete]' \
    '       worker-run browse [--vendor codex|claudeb] [--target dia|chrome] [--dia-profile <dir|name>] [--account <account>] [--record <deviceId> <account>] [--no-launch] [--json]' >&2
  exit 2
}

fail() {
  printf 'worker-run: %s\n' "$*" >&2
  exit 4
}

REVIEW_ROUND_RE='^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7}(-[0-9]+)?$'
# git's empty blob, which is what a path the run CREATED was before it: the store reads a base to
# anchor a path it has never seen, and no base at all would leave that path's whole content owed.
EMPTY_BLOB=e69de29bb2d1d6434b8b29ae775ad8c2e48c5391

review_bench_dir() { # round
  printf '%s/benches/%s' \
    "${WORKER_STATS_DIR:-${CLAUDEB_DIR:-$HOME/.claude-profiles/.claudeb}/worker-stats}" "$1"
}

# A round is an id review-bench holds a bench for, whichever door it arrived through: the flag and
# the brief header are one answer, so no run is bound to a round that never ran.
review_round_ok() { # round
  [[ "$1" =~ $REVIEW_ROUND_RE ]] && [ -d "$(review_bench_dir "$1")" ]
}

git_common_dir() { # dir
  git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null
}

# Whether repo is already granted: a worktree of it is the same repository, and granting the main
# checkout beside the worktree would hand the worker a second copy to write into.
same_repository() { # repo dir...
  local repo=$1 common dir
  shift
  common=$(git_common_dir "$repo") || common=''
  for dir in "$@"; do
    [ "$(cd "$dir" 2>/dev/null && pwd -P)" = "$(cd "$repo" && pwd -P)" ] && return 0
    [ -n "$common" ] && [ "$(git_common_dir "$dir")" = "$common" ] && return 0
  done
  return 1
}

# The anchors store's CLI, resolved off PATH: a machine without it has no store to write to.
review_anchors() { # subcommand argument...
  local anchors args rc
  anchors=$(command -v review-anchors 2>/dev/null) && [ -x "$anchors" ] || return 127
  # A run over thousands of changed paths outgrows ARG_MAX ("Argument list too long", exit 126).
  if [ "$(printf '%s\n' "$@" | wc -c)" -gt 100000 ]; then
    args=$(mktemp "${TMPDIR:-/tmp}/review-anchors-args.XXXXXX") || return 1
    printf '%s\n' "$@" >"$args"
    "$anchors" "@$args"
    rc=$?
    rm -f "$args"
    return "$rc"
  fi
  "$anchors" "$@"
}

# The same line worker-launch-gate holds a relay's flag to: the first `KEY: value` of the brief.
brief_line_value() { # brief key
  head -n 400 "$1" 2>/dev/null | grep -m1 -oE "^$2:[[:space:]]*[A-Za-z0-9_.-]+" | sed -E "s/^$2:[[:space:]]*//"
}

brief_review_round() {
  local brief="$1" line='' round=''
  # The header is every KEY: line the brief opens with (a RESUME/ATTACH handle among them), and
  # ROUND: may stand after ACCOUNT:/EFFORT: there; a ROUND: past the first body line is prose.
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ROUND:*) break ;;
      RESUME\ *:* | ATTACH\ *:*) continue ;;
    esac
    [[ "$line" =~ ^[A-Z][A-Z-]*: ]] || return 0
  done <"$brief"
  case "$line" in
    ROUND:*) ;;
    *) return 0 ;;
  esac
  round=${line#ROUND:}
  round=${round#"${round%%[![:space:]]*}"}
  round=${round%"${round##*[![:space:]]}"}
  [ "$round" != none ] || { printf 'none\n'; return 0; }
  review_round_ok "$round" ||
    fail "brief names no review round on record: '$line' — the shape is 'ROUND: <review-bench run id YYYYMMDDTHHMMSSZ-<7 hex>>'"
  printf '%s\n' "$round"
}

# Header-only, as ROUND: is: a brief's prose names other repositories to read far more often than to
# write, and a grant is also what exempts a write there from the doctor's escape count. The one
# prose exception is brief_worktree_roots: a task worktree exists to be written; a main checkout
# named in prose stays ungranted, so a write there still reads as escaped.
brief_add_dirs() { # brief
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ADD-DIR:*)
        line=${line#ADD-DIR:}
        line=${line#"${line%%[![:space:]]*}"}
        printf '%s\n' "${line%"${line##*[![:space:]]}"}"
        continue
        ;;
      RESUME\ *:* | ATTACH\ *:*) continue ;;
    esac
    [[ "$line" =~ ^[A-Z][A-Z-]*: ]] || return 0
  done <"$1"
}

# A named *.md is read as part of the brief (relays hand over to brief files), and
# `<repo>/.claude/worktrees/<name>` resolves in every repository the text names.
brief_worktree_roots() { # brief
  local text value name root
  text=$(cat "$1" 2>/dev/null
    grep -oE '/[A-Za-z0-9._~+/-]+\.md' "$1" 2>/dev/null | sort -u |
      while IFS= read -r value; do [ -f "$value" ] && cat "$value" 2>/dev/null; done)
  {
    grep -oE '/[A-Za-z0-9._~+/-]+/\.claude/worktrees/[A-Za-z0-9._-]+' <<<"$text" | sed 's/\.*$//'
    grep -oE '(^|[^A-Za-z0-9._~+/-])[^[:space:]/]*/\.claude/worktrees/[A-Za-z0-9._-]+' <<<"$text" |
      sed 's/\.*$//' | sed 's#.*/##' | sort -u | while IFS= read -r name; do
        grep -oE '/[A-Za-z0-9._~+-][A-Za-z0-9._~+/-]*' <<<"$text" | sed 's#[./]*$##' | sort -u |
          while IFS= read -r root; do
            [ -e "$root/.git" ] && printf '%s/.claude/worktrees/%s\n' "$root" "$name"
          done
      done
  } | sort -u |
    while IFS= read -r value; do
      [ -e "$value/.git" ] && printf '%s\n' "$value"
    done
}

# A resumed session keeps every grant its earlier runs had, workdirs included: a RESUME brief rarely
# repeats them, and its relay may pick another workdir.
resumed_add_dirs() { # resume [jq filter]
  local entry
  [ -n "$1" ] || return 0
  while IFS= read -r entry; do
    [ -n "$entry" ] && jq -r "${2:-.add_dirs[]?, .worktrees_made[]?} // empty" "${entry%/worker-session}/meta.json" 2>/dev/null
  done < <(refuse_live_matches "$1" "${WORKER_RUN_DIR:-$HOME/.cache/claude-worker-runs}" worker-session)
}

# Every round-shaped WHOLE token of the brief, deduplicated: a longer token that merely contains a
# round id names no round, and one id repeated in the prose must not read as two rounds.
brief_text_rounds() { # brief
  # The validator's own shape, unanchored for grep -x: a second copy here drifts, which is how the
  # scan came to miss the member suffix the header and the flag both accept.
  local shape=${REVIEW_ROUND_RE#^}
  tr -c '0-9A-Za-z-' '\n' <"$1" | grep -xE "${shape%'$'}" | awk '!seen[$0]++'
}

# The symlink walk the self-edit guard needs anyway, hoisted here so the include below resolves
# against the same root instead of a second copy of the same loop.
SCRIPT_PATH=${BASH_SOURCE[0]}
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIRECTORY=$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd) || exit 4
  SCRIPT_PATH=$(readlink "$SCRIPT_PATH")
  [[ "$SCRIPT_PATH" = /* ]] || SCRIPT_PATH="$SCRIPT_DIRECTORY/$SCRIPT_PATH"
done
SCRIPT_DIRECTORY=$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd) || exit 4
SCRIPT_PATH="$SCRIPT_DIRECTORY/$(basename "$SCRIPT_PATH")"
umask 077

# Sourced, not optional: without it `worker_pool_refuse_headless` is simply undefined, every
# launch reads as refused, and each one blames the worker pool for a missing include.
. "$SCRIPT_DIRECTORY/../share/worker-pool.sh" ||
  fail 'share/worker-pool.sh is missing: worker-run cannot check worker-pool membership'
command -v worker_pool_refuse_headless >/dev/null ||
  fail 'share/worker-pool.sh defines no worker_pool_refuse_headless: refusing to launch unchecked'

# The one per-vendor allowed-model list (shared-invariants row `bq`). Sourced, not optional: a
# launcher that cannot tell an allowed model from a cheap one must refuse every launch rather than
# spend an account on a model Egor forbade.
. "$SCRIPT_DIRECTORY/../share/worker-model.sh" ||
  fail 'share/worker-model.sh is missing: worker-run cannot tell an allowed model from a cheap one'
command -v worker_model_allows >/dev/null ||
  fail 'share/worker-model.sh defines no worker_model_allows: refusing to launch unchecked'
. "$SCRIPT_DIRECTORY/../share/web-search.sh" ||
  fail 'share/web-search.sh is missing: worker-run cannot tell which vendors can search the web'
command -v web_search_args >/dev/null ||
  fail 'share/web-search.sh defines no web_search_args: refusing to launch with an unknown search state'

. "$SCRIPT_DIRECTORY/../share/worker-walls.sh" ||
  fail 'share/worker-walls.sh is missing: worker-run cannot record a run-observed wall'
command -v worker_walls_record >/dev/null ||
  fail 'share/worker-walls.sh defines no worker_walls_record: refusing to launch without a wall writer'

# The main→base-HOME, named→<profiles-dir>/<name> mapping (shared-invariants row m) lives in one
# place for every reader of an agy profile; respelled here, a worker's transcript would be looked
# for under a directory geminib does not use.
. "$SCRIPT_DIRECTORY/../share/gemini-accounts.sh" ||
  fail 'share/gemini-accounts.sh is missing: worker-run cannot resolve an agy profile HOME'
. "$SCRIPT_DIRECTORY/../share/codex-accounts.sh" ||
  fail 'share/codex-accounts.sh is missing: worker-run cannot tell whether codex main was removed'
. "$SCRIPT_DIRECTORY/../share/store-lock.sh" ||
  fail 'share/store-lock.sh is missing: worker-run cannot rotate the worker-attempts journal safely'
. "$SCRIPT_DIRECTORY/../share/slots.sh" || fail 'share/slots.sh is missing'
NIGHT_SLOT=''
. "$SCRIPT_DIRECTORY/../share/worktree-branch.sh" ||
  fail 'share/worktree-branch.sh is missing: worker-run cannot find a sibling worktree on its branch'
. "$SCRIPT_DIRECTORY/../share/worker-claims.sh" ||
  fail 'share/worker-claims.sh is missing: worker-run cannot release a claim on an account it passed over'
. "$SCRIPT_DIRECTORY/../share/worker-inbox.sh" ||
  fail 'share/worker-inbox.sh is missing: worker-run cannot pass a message to a run'
gemini_base_home=$HOME
gemini_profiles_dir="${GEMINIB_PROFILES_DIR:-$HOME/.gemini-profiles}"

# Every launched brief carries this, so the loop rule cannot depend on an orchestrator remembering
# to type it: serial full-suite reruns were 54-75% of the wall clock of every run that passed an
# hour, and two of them died on the ceiling below with the work unfinished. Appended rather than
# prepended — the brief's own first line is load-bearing (`RESUME <id>:`, `ATTACH <id>:`, which
# both the relay agents and the spawn gate read off the top), and a rule a model must still obey at
# edit 60 belongs where it read last.
BRIEF_PREAMBLE='AUDIENCE: your reader is another model (the orchestrator), never Egor — write the report and every message in English; Russian only as code in backticks. TEST LOOP: while iterating run a one-off probe or ONE covering suite, never every suite after each edit; a mutation check is one run of the covering suite (revert → fails → restore); at the end run, in one `tests/run-all <suite>...` call, only the suites covering the files you changed (`tests/affected <file>...` lists them where the repo has it) plus the one that goes red on the old code, and report PASS counts; never the full `tests/run-all`, which the night runs once in the background. Work in the files the brief names; if the brief covers more than ~8 findings or ~6 files, do them in the order given. RETURN: first line the outcome — done, partially done or failed, plus one clause; then changed files, verification with PASS counts and anything undone; mark anything you could not confirm and say where you looked. The relay puts `worker-run report`'"'"'s `ACCOUNT: <account> (<vendor>)` line second, so never write one; an `OUTCOME:` line is a worker-run status code, written only where a preamble names its code. A command that ended by signal 9 (exit 137) was killed by the machine'"'"'s memory guard: do not rerun it as is — run one project'"'"'s tests, never the whole monorepo'"'"'s, or split the work. REUSE FIRST: nothing the project may already have is written from scratch — before writing a function, helper, wrapper over a platform API, list, constant or pattern, grep the whole project for an existing one (its name, the API it wraps, the literal) and use it; editing an existing value or call needs no search; one search, then proceed.'

# Grok is the one research leg with no read-only mode: supervise_grok digests every tree it may read
# before and after, and ANY difference ends a finished run as READ_ONLY_VIOLATION with the answer
# withheld and the account already spent. Since the answer contract asks such a run to fetch pages,
# the consequence is stated where the model reads it rather than discovered by losing a run.
COMPUTER_PREAMBLE='# Computer Use Preamble (Codex)

Drive Egor'"'"'s Mac apps through Codex Computer Use: the CUA REPL `js` tool, whose own instructions document the `cua` API.
- First js call must be exactly: `await cua.getState()`
- Attach to an app with `await cua.getApp("<App name>")` and read it (getAXState / getScreenshot) before acting.
- Do only what the brief allows. Never log in, enter credentials, approve payments or answer admin password prompts; the surface refuses Terminal. Report such a step instead of working around it.
- Close the windows and tabs you opened once the task is complete, unless the brief says to keep them; a stop for Egor'"'"'s input leaves them open.
- Computer Use refuses some URLs (vendor policy, checked on the frontmost browser tab, even one Egor opened): when it stops the session for a disallowed URL, end with `OUTCOME: COMPUTER_UNAVAILABLE reason=disallowed-url url=<that tab'"'"'s URL>`.
- Return the evidence the brief asks for and end with: `OUTCOME: COMPUTER_OK` or `OUTCOME: COMPUTER_UNAVAILABLE reason=<text>`'
# The harness's own prompt steers a bypass-mode model toward sed and heredocs, which worker-edit-guard
# only records; said up front, a text edit stays an Edit call the transcript names.
CLAUDEB_EDIT_FENCE='EDITS: change repository files only through the Edit and Write tools where an edit can do it; a cp, mv, rsync or redirect with no Edit form is recorded for the run, never refused.'
GROK_RESEARCH_FENCE='READ-ONLY TREE: every repository handed to this run is digested before and after it. Creating or changing ANY file in them — a fetched page, a scratch note, a saved quote — fails the finished run and throws your answer away. Quote web pages inline in the answer and write nothing, anywhere.'

CYRILLIC_MAX=${WORKER_RUN_CYRILLIC_MAX:-}
CYRILLIC_SHARE=${WORKER_RUN_CYRILLIC_SHARE:-$SCRIPT_DIRECTORY/cyrillic-share}

# The share alone, or nothing where the tool cannot answer: a report is never stamped on a failed
# measurement, and a brief is refused on one.
cyrillic_share() { # <stdin
  local answer
  [ -x "$CYRILLIC_SHARE" ] || return 1
  answer=$("$CYRILLIC_SHARE" 2>/dev/null) || return 1
  answer=${answer%% *}
  [[ "$answer" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$answer"
}

cyrillic_over() { # share
  [ -n "$CYRILLIC_MAX" ] || CYRILLIC_MAX=$("$CYRILLIC_SHARE" --max 2>/dev/null)
  [[ "$CYRILLIC_MAX" =~ ^[0-9]+$ ]] || CYRILLIC_MAX=0
  [ "$1" -gt "$CYRILLIC_MAX" ]
}

# Wall-clock ceiling per vendor invocation, and only the last resort: a wedged CLI is normally
# reclaimed by the idle watchdog below in half an hour, and the ceiling is what catches one that
# wedges while still writing (a retry loop, a stuck stream). Six hours because the old 170-minute
# one is not a runaway guard but a work cap — it killed two real runs mid-edit, and a killed run
# hands nothing back.
DEADLINE=${WORKER_RUN_DEADLINE:-21600}
[[ "$DEADLINE" =~ ^[0-9]+$ ]] && [ "$DEADLINE" -gt 0 ] || DEADLINE=21600

# No growth in anything the worker writes for this long ends the run. A worker counts as active the
# moment a tool RETURNS, so this only has to clear the longest single tool call a brief can
# legitimately make: the slowest suite measured in this checkout runs ~10 min, so 30 min is three
# times the worst case and still far under the ceiling. 0 disables the idle half entirely.
IDLE=${WORKER_RUN_IDLE_S:-1800}
[[ "$IDLE" =~ ^[0-9]+$ ]] || IDLE=1800
SILENT=${WORKER_RUN_SILENT_S:-600}
WALL_SETTLE=${WORKER_RUN_WALL_SETTLE_S:-60}
[[ "$WALL_SETTLE" =~ ^[0-9]+$ ]] || WALL_SETTLE=60
[[ "$SILENT" =~ ^[0-9]+$ ]] || SILENT=600
WAIT_POLL=${WORKER_RUN_WAIT_POLL_S:-5}
[[ "$WAIT_POLL" =~ ^[1-9][0-9]*$ ]] || WAIT_POLL=5

# The run record the watchdog watches, set by `supervise` before any vendor is launched.
RUN_DIRECTORY=''

# The first user message of a Claude transcript, whole. Read with `first(inputs)` rather than
# `head -n1`, which would cut a multi-line brief down to its first line and match any run of the
# same task.
first_user_text() { # transcript
  jq -nRr 'first(inputs | fromjson? | select(type == "object" and .type == "user")
           | .message | objects | .content
           | if type == "string" then . else ([.[]? | select(.type? == "text") | .text] | join("")) end
           | select(. != ""))' "$1" 2>/dev/null
}

# The brief as this ATTEMPT hands it to the vendor: the caller's text, worker-run's standing
# preamble, and a token unique to the attempt. Brief text is no identity — every profile writes
# into one transcript tree, a co-tenant run may carry the same brief word for word, and this run
# itself launches again on an effort-flag retry or a walled reroute — so the token is what
# discovery matches on. Rewriting the file also restamps it, and its mtime is the floor `find`
# uses: a transcript older than this attempt belongs to an attempt that was abandoned.
launch_attempt() { # directory
  local directory="$1" attempt token preamble
  attempt=$(head -n1 "$directory/attempt" 2>/dev/null)
  [[ "$attempt" =~ ^[0-9]+$ ]] || attempt=0
  attempt=$((attempt + 1))
  token="$(basename "$directory")-a$attempt"
  { for preamble in inbox-carried browser-preamble computer-preamble; do
      [ -f "$directory/$preamble" ] || continue
      cat "$directory/$preamble" || return 1
      printf '\n'
    done
    cat "$directory/brief" || return 1
    if [ -s "$directory/fix-rule" ]; then
      printf '\n'
      cat "$directory/fix-rule" || return 1
    fi
    for preamble in research-fence edit-fence; do
      [ -s "$directory/$preamble" ] || continue
      printf '\n'
      cat "$directory/$preamble" || return 1
    done
    printf '\n%s\n\nRUN-TOKEN: %s\n' "$BRIEF_PREAMBLE" "$token"; } \
    >"$directory/brief.launch.tmp.$$" &&
    mv -f "$directory/brief.launch.tmp.$$" "$directory/brief.launch" || return 1
  printf '%s\n' "$attempt" >"$directory/attempt" 2>/dev/null || :
  printf '%s\n' "$token" >"$directory/launch-token" 2>/dev/null || :
  # The session this run answers by is the session of the attempt now starting; kept, the previous
  # attempt's id would be reported and resumed as if it held this attempt's work.
  rm -f "$directory/session" "$directory/session-file" 2>/dev/null || :
  return 0
}

# This run's claudeb session, resolved off the profile's transcript tree while the run is still
# alive. Claude names the file after the session and fills it from the first turn, so the id exists
# long before `out` does; matched on the token of the attempt now running, since a co-tenant run on
# the same account writes into the same tree. Called once per watchdog tick until it answers.
claudeb_discover_session() { # directory
  local directory="$1" account resume root candidate launched first_line text token started fallback='' _wd_now
  [ ! -s "$directory/session-file" ] || return 0
  # A transcript that has not appeared within ten minutes never will — Claude names the file on the
  # first turn — and searching on would walk a profile tree of thousands of files every tick for the
  # rest of a six-hour run.
  # The watchdog reads meta once per attempt; those fields do not move until the next one.
  if [ -n "${WD_META_READY:-}" ]; then
    started=$WD_STARTED
    account=$WD_ACCOUNT
  else
    started=$(jq -r '([.started_at, .slot_at] | map(numbers) | max // 0)' "$directory/meta.json" 2>/dev/null)
    account=$(jq -r '.account // empty' "$directory/meta.json" 2>/dev/null)
  fi
  [[ "$started" =~ ^[0-9]+$ ]] || started=0
  printf -v _wd_now '%(%s)T' -1
  [ "$started" -eq 0 ] || [ $((_wd_now - started)) -le 600 ] || return 1
  [ -n "$account" ] || return 1
  # PHYSICALLY, because every real profile reaches the shared transcript tree through a SYMLINK
  # (`~/.claude-profiles/<account>/projects` -> `~/.claude/projects`) and `find` handed a symlinked
  # directory as its own argument walks nothing at all: discovery answered for no live claudeb run
  # on this machine until 2026-09-04, and `test -d` cannot see the difference.
  root=$(cd "${CLAUDEB_PROFILES_ROOT:-$HOME/.claude-profiles}/$account/projects" 2>/dev/null && pwd -P) ||
    return 1
  if [ -n "${WD_META_READY:-}" ]; then
    resume=$WD_RESUME
  else
    resume=$(jq -r '.resume // empty' "$directory/meta.json" 2>/dev/null)
  fi
  if [ -n "$resume" ]; then
    # A resumed session keeps the id it already had and APPENDS to a transcript whose first user
    # record is the original brief, so nothing here is matched: the id is known, only its file is
    # being located.
    case "$resume" in .|..|*/*) return 1 ;; esac
    for candidate in "$root"/*/"$resume.jsonl"; do
      [ -f "$candidate" ] || continue
      record_session_file "$directory" "$resume" "$candidate"
      return 0
    done
    return 1
  fi
  token=''
  [ ! -r "$directory/launch-token" ] || IFS= read -r token <"$directory/launch-token" || true
  launched=$(<"$directory/brief.launch")
  first_line=${launched%%$'\n'*}
  while IFS= read -r candidate; do
    [ -f "$candidate" ] || continue
    text=$(first_user_text "$candidate")
    if [ -n "$token" ]; then
      case "$text" in *"RUN-TOKEN: $token"*) record_session_file "$directory" "$(basename "${candidate%.jsonl}")" "$candidate"; return 0 ;; esac
      continue
    fi
    # A run launched before the token existed has nothing but its brief text to be found by.
    case "$text" in
      "$launched") record_session_file "$directory" "$(basename "${candidate%.jsonl}")" "$candidate"; return 0 ;;
    esac
    # Newest-first, so the first prefix match is the freshest: the CLI may reflow or annotate the
    # prompt it stores, and an exact match is then unreachable while the run is still this run. An
    # EMPTY first line makes that prefix `*`, which adopts the newest transcript of any run at all.
    if [ -z "$fallback" ] && [ -n "$first_line" ]; then
      case "$text" in "$first_line"*) fallback=$candidate ;; esac
    fi
  # -H, because every claudeb profile reaches the transcripts through a SYMLINK
  # (`<profile>/projects` -> `~/.claude/projects`): handed one as its starting point, find without
  # it walks nothing at all and answers an empty tree, so discovery never once succeeded for a live
  # claudeb run — which left the watchdog blind and the launcher-to-worker pairing unwritten
  # (live 2026-09-04: 0 candidates over a tree of 6239 transcripts).
  # -newer brief.launch, which this ATTEMPT wrote: a transcript predating the launch cannot be its
  # own, and after a reroute the abandoned attempt's transcript is exactly that.
  done < <(find -H "$root" -type f -name '*.jsonl' -newer "$directory/brief.launch" -print0 2>/dev/null |
    xargs -0 ls -t 2>/dev/null)
  [ -n "$fallback" ] || return 1
  record_session_file "$directory" "$(basename "${fallback%.jsonl}")" "$fallback"
}

record_session_file() { # directory session transcript
  local directory="$1"
  case "$2" in ''|-|.|..|*[!A-Za-z0-9._-]*) return 1 ;; esac
  printf '%s\n' "$2" >"$directory/session.tmp.$$" &&
    mv -f "$directory/session.tmp.$$" "$directory/session" || return 1
  printf '%s\n' "$3" >"$directory/session-file.tmp.$$" &&
    mv -f "$directory/session-file.tmp.$$" "$directory/session-file" || return 1
  # The launcher-to-worker mapping the review hooks price a LIVE run by, which until now could not
  # be written before the run ended.
  record_worker_session "$directory"
}

# Shared-checkout dirt is not this run's activity; only paths its own transcript names count.
activity_fingerprint() { # directory vendor workdir
  local directory="$1" vendor="$2" workdir="$3" path stamp observed=y fingerprint='' session_path
  if [ "$vendor" = claudeb ]; then
    claudeb_discover_session "$directory"
    observed=n
    [ ! -s "$directory/session-file" ] || observed=y
  fi
  session_path=''
  if [ -r "$directory/session-file" ]; then
    IFS= read -r session_path <"$directory/session-file" || true
  fi
  for path in "$directory/out" "$directory/err" "$directory/log" "$session_path"; do
    [ -n "$path" ] && [ -e "$path" ] || continue
    fingerprint+="$(stat -f '%N %z %m' "$path" 2>/dev/null || stat -c '%n %s %Y' "$path" 2>/dev/null)|"
  done
  if stamp=$(workdir_activity_stamp "$directory" "$workdir" own); then
    observed=y
    fingerprint+="edit $stamp|"
  fi
  printf '%s~%s\n' "$observed" "$fingerprint"
}

# The vendor CLI in a process group of its own, so one signal takes the whole tree it built: every
# vendor here is reached through a wrapper (`claudeb`, `codexb`, `agy`), and a TERM delivered to
# the wrapper alone leaves the CLI it launched editing the workdir with nobody supervising it.
# perl and not setsid(1), which is absent on stock macOS and forks when the caller already leads a
# group — `wait` would then reap the wrapper and report a run that is still going.
CHILD_GROUP_PREFIX=()
if command -v perl >/dev/null 2>&1 && perl -MPOSIX -e 'exit 0' 2>/dev/null; then
  # `or exit 127`: a failed exec leaves perl running the rest of the script, and a missing CLI
  # would exit 0 and report the run as a success that produced nothing.
  CHILD_GROUP_PREFIX=(perl -MPOSIX -e 'POSIX::setsid(); exec {$ARGV[0]} @ARGV or exit 127' --)
fi

# The group where the child leads one, the child alone otherwise. Asked NOW and never at launch:
# the wrapper has not reached setsid() when the pid first appears, and a group kill aimed at a pid
# that leads no group would hit whatever group does wear that number.
end_child() { # pid signal
  [ -n "$1" ] || return 0
  [ "$(ps -o pgid= -p "$1" 2>/dev/null | tr -d '[:space:]')" != "$1" ] || kill -"$2" "-$1" 2>/dev/null || :
  kill -"$2" "$1" 2>/dev/null || :
}

# A process launchd adopted before the run ended is in no tree process_tree_end or end_child walks; the id it
# inherited is all that ties it to the run.
end_run_orphans() { # directory
  local holders pid etime command rows='' pids=()
  holders=$(run_env_holders "${1##*/}")
  [ -n "$holders" ] || return 0
  while IFS=$'\t' read -r pid etime command; do
    pids+=("$pid")
    rows+="$pid"$'\t'"$(etime_seconds "$etime")"$'\t'"${command:0:80}"$'\n'
  done <<<"$holders"
  pids_end 10 "${pids[@]}"
  meta_update "$1" '.orphans_ended = ((.orphans_ended // []) + $rows)' --argjson rows "$(printf '%s' "$rows" |
    jq -Rnc '[inputs | split("\t") | {pid: (.[0] | tonumber), age_s: (.[1] | tonumber? // null), command: .[2]}]')" || :
}

run_with_deadline() {
  local child watchdog='' rc rc_reaped signalled='' began ended
  # Per ATTEMPT, so a reroute's fresh launch cannot inherit the previous one's verdict.
  [ -z "$RUN_DIRECTORY" ] || rm -f "$RUN_DIRECTORY/killed" 2>/dev/null || :
  # <&0 is load-bearing: without an explicit stdin redirect, a background
  # command in a non-interactive shell gets /dev/null instead of the brief
  # the caller redirected in (live-caught: claudeb saw an empty stdin).
  ${CHILD_GROUP_PREFIX[@]+"${CHILD_GROUP_PREFIX[@]}"} "$@" <&0 &
  child=$!
  # The CLI's own pid, for memlogd's memory guard: that guard kills the DESCENDANTS of the pid a
  # run registers, and with only the supervisor's pid on record the CLI is a descendant and dies
  # with the hog (live 2026-09-05: run claudeb-1788615828-30933-684d, EXIT 137). The agent has to
  # outlive the kill to see its command die by signal 9 and read the preamble's answer to it.
  # The launch instant stands beside the number: pids are reused within the day, and the guard skips
  # a root whose process did not start when its registration says it did.
  printf -v began '%(%s)T' -1
  [ -z "$RUN_DIRECTORY" ] || meta_update "$RUN_DIRECTORY" \
    '.cli_pid = $pid | .cli_pid_started_at = $began | .cli_starts = ((.cli_starts // []) + [$began])' \
    --argjson pid "$child" --argjson began "$began" || :
  # A signal aimed at this supervisor is aimed at its run: the child goes with it, or the run keeps
  # writing to a workdir whose supervisor is gone and its record never gets an exit code (live
  # 2026-09-04: claudeb-1788518882-986-6f32, TERMed at 41s, worker landed edits afterwards).
  trap 'signalled=TERM; stop_run TERM' TERM
  trap 'signalled=INT; stop_run INT' INT
  # The watchdog sleeps in short hops: killing the subshell strands its in-flight
  # sleep, and a single sleep $DEADLINE would linger for hours after every run.
  (
    directory=$RUN_DIRECTORY
    vendor='' workdir=''
    WD_META_READY=''
    WD_STARTED=0
    WD_ACCOUNT=''
    WD_RESUME=''
    if [ -n "$directory" ] && [ -r "$directory/meta.json" ]; then
      # Not a tab: IFS whitespace collapses an empty field and shifts the next one into its place.
      IFS=$'\x1f' read -r vendor workdir WD_STARTED WD_ACCOUNT WD_RESUME < <(
        jq -r '[.vendor // "", .workdir // "", (([.started_at, .slot_at] | map(numbers) | max // 0) | tostring), .account // "", .resume // ""] | join("\u001f")' \
          "$directory/meta.json" 2>/dev/null) || true
      WD_META_READY=1
    fi
    window=$DEADLINE
    [ "$IDLE" -eq 0 ] || [ "$IDLE" -ge "$window" ] || window=$IDLE
    [ "$SILENT" -eq 0 ] || [ "$SILENT" -ge "$window" ] || window=$SILENT
    hop=$((window / 10))
    [ "$hop" -ge 1 ] || hop=1
    [ "$hop" -le 30 ] || hop=30
    printf -v wd_now '%(%s)T' -1
    end=$((wd_now + DEADLINE))
    idle_since=$wd_now
    silent_since=$idle_since
    ever_active=0
    reason=''
    # Seeded before the first sleep, not left empty: an empty seed differs from every real reading,
    # so the first tick would always read as progress and no idle kill could land on its own hop.
    seen=$(activity_fingerprint "$directory" "$vendor" "$workdir")
    while [ "$wd_now" -lt "$end" ]; do
      sleep "$hop"
      kill -0 "$child" 2>/dev/null || exit 0
      printf -v wd_now '%(%s)T' -1
      # Log text may quote a wall; a structured vendor error is authoritative even with heartbeats.
      if [ -n "$directory" ] && { [ "$((wd_now - $(newest_mtime "$directory/out" "$directory/err")))" -ge "$WALL_SETTLE" ] ||
           { [ "$vendor" = grok ] && grok_stream_errors "$directory" 4096 | grep -Eiq "$GROK_LIMIT_RE"; }; } &&
         has_limit_signature "$directory" "$vendor" 4096; then
        reason=wall
        break
      fi
      [ -n "$directory" ] && { [ "$SILENT" -gt 0 ] || [ "$IDLE" -gt 0 ]; } || continue
      # claudeb prints its JSON result only at the end, so empty out/err alone is not silence: the
      # transcript and workdir stamps in the fingerprint are what tell a working run from a hung one.
      current=$(activity_fingerprint "$directory" "$vendor" "$workdir")
      if [ "$current" != "$seen" ]; then
        # Only a move of something already observed is activity: a claudeb transcript first found
        # is how a hung start looks too.
        [ "${seen%%~*}" != y ] || ever_active=1
        seen=$current
        idle_since=$wd_now
        silent_since=$idle_since
      fi
      # A tool call waiting in a limiter (a suite slot) is no hung worker.
      ! holds_in_tree "$child" || { idle_since=$wd_now silent_since=$wd_now; }
      # SILENT catches a hung START only: once the run has shown activity, a single long tool call
      # (a suite) freezes every source for many minutes and only IDLE may judge it (live 2026-09-24:
      # two sweep fixers killed mid `tests/run-all`).
      if [ "$SILENT" -gt 0 ] && [ "$ever_active" -eq 0 ] &&
         [ ! -s "$directory/out" ] && [ ! -s "$directory/err" ] &&
         [ $((wd_now - silent_since)) -ge "$SILENT" ]; then
        reason="silent $SILENT"
        break
      fi
      [ "$IDLE" -gt 0 ] || continue
      # An idle kill needs POSITIVE evidence that the worker stopped. A run none of the sources
      # above can see offers none, so it is left to the ceiling below instead of being killed for
      # being unobservable — a killed run hands nothing back.
      if [ "${current%%~*}" = y ] && [ $(($(date +%s) - idle_since)) -ge "$IDLE" ]; then
        reason="idle $IDLE"
        break
      fi
    done
    [ -n "$reason" ] || reason="deadline $DEADLINE"
    [ -z "$directory" ] || printf '%s\n' "$reason" >"$directory/killed" 2>/dev/null || :
    [ "$reason" != wall ] || record_run_wall "$directory" "$vendor"
    end_child "$child" TERM
    sleep 10
    end_child "$child" KILL
  ) &
  watchdog=$!
  wait "$child"
  rc=$?
  # `wait` interrupted by a trapped signal returns 128+n with the child not yet reaped; the second
  # one is what carries the status the child actually died of. 127 is "already reaped" and answers
  # for nothing.
  if [ -n "$signalled" ] && [ "$rc" -gt 128 ]; then
    wait "$child" 2>/dev/null
    rc_reaped=$?
    [ "$rc_reaped" -eq 127 ] || rc=$rc_reaped
  fi
  trap - TERM INT
  # The whole tree: killed alone, the watchdog's in-flight command substitutions outlive it. Grace 0:
  # its zombie stays unreaped until the wait below and answers kill -0 for any grace.
  process_tree_end "$watchdog" 0
  wait "$watchdog" 2>/dev/null
  printf -v ended '%(%s)T' -1
  [ -z "$RUN_DIRECTORY" ] || meta_update "$RUN_DIRECTORY" \
    '.attempt_secs = ((.attempt_secs // []) + [$secs]) | .attempt_rcs = ((.attempt_rcs // []) + [$rc])' \
    --argjson secs "$((ended - began))" --argjson rc "$rc" || :
  return "$rc"
}

# What the traps above do, in the scope that holds the pids: the watchdog first, so the reason this
# run ends is the signal and not a deadline it races, then the child's whole group, then a KILL
# escalation for a CLI that ignores TERM — detached, because this supervisor is on its way out.
stop_run() { # signal
  local reason="signal $1"
  [ "$1" != TERM ] || reason=term
  [ -z "$RUN_DIRECTORY" ] || printf '%s\n' "$reason" >"$RUN_DIRECTORY/killed" 2>/dev/null || :
  process_tree_end "$watchdog" 0
  end_child "$child" TERM
  ( sleep 5; end_child "$child" KILL ) >/dev/null 2>&1 &
}

run_overdue() {
  # A pid check alone cannot be trusted forever: a legacy record carries no launch
  # stamp for supervisor_running to compare, and then a run whose supervisor never
  # wrote exit_code reports "running" indefinitely. Twice the deadline covers the one
  # compatibility retry each vendor may make. Unparseable started_at counts as
  # overdue — better a failed report than an eternal "running".
  local started now
  started=$(jq -r '([.started_at, .slot_at] | map(numbers) | max // 0)' "$1/meta.json" 2>/dev/null)
  [[ "$started" =~ ^[0-9]+$ ]] && [ "$started" -gt 0 ] || return 0
  now=$(date +%s)
  [ $((now - started)) -gt $((2 * DEADLINE + 900)) ]
}

. "$SCRIPT_DIRECTORY/../share/run-liveness.sh" ||
  fail 'share/run-liveness.sh is missing: worker-run cannot tell a live supervisor from a recycled pid'
. "$SCRIPT_DIRECTORY/../share/processes.sh" ||
  fail 'share/processes.sh is missing: worker-run cannot end the processes its runs leave behind'

config_value() {
  sed -n "s/^$1=//p" "$CONFIG_FILE" 2>/dev/null | head -n1
}

vendor_name() {
  case "$1" in
    claudeb) printf 'CLAUDEB' ;;
    codex) printf 'CODEX' ;;
    gemini) printf 'GEMINI' ;;
    grok) printf 'GROK' ;;
  esac
}

# The worker model is the allow-list's, never ~/.codex/config.toml's: that file is symlinked into
# every codexb profile and rewritten by Egor's interactive Codex picks, which must neither switch
# nor refuse a worker launch.
codex_config_model() {
  worker_model_allowed_models codex | head -n1
}

# llm-doctor reads the outcome back: beside the run when there is one, else from prelaunch.jsonl.
outcome_record() { # outcome [directory]
  local log="${WORKER_RUN_DIR:-$HOME/.cache/claude-worker-runs}/prelaunch.jsonl"
  if [ -n "${2:-}" ]; then
    [ ! -d "$2" ] || printf '%s\n' "$1" 2>/dev/null >"$2/outcome" || :
    return 0
  fi
  mkdir -p "${log%/*}" 2>/dev/null || return 0
  jq -cn --arg outcome "$1" --arg vendor "${vendor:-}" --arg account "${account:-${explicit_account:-}}" \
    --arg model "${model:-${effective:-}}" --arg role "${role:-}" --arg light "${light:-}" \
    '{ts: (now | floor), outcome: $outcome, vendor: $vendor, account: $account, model: $model,
      role: $role, light: $light}' 2>/dev/null >>"$log" || :
}

outcome_line() (
  local outcome="$1" report_directory="${2:-}" place_session
  printf 'OUTCOME: %s\n' "$outcome"
  outcome_record "$outcome" "$report_directory"
  if [ -n "$report_directory" ] && mkdir "$report_directory/.place-end" 2>/dev/null; then
    place_session=$(cat "$report_directory/launcher" 2>/dev/null)
    case "$place_session" in
      ''|_orphan|.|..|*[!A-Za-z0-9._-]*) ;;
      *)
        "$SCRIPT_DIRECTORY/statusline-place" add --session "$place_session" --kind worker-end \
          --path "$(jq -r '.workdir // empty' "$report_directory/meta.json" 2>/dev/null)" >/dev/null 2>&1 || : ;;
    esac
  fi
  return 0
)

# Refused BEFORE the account is resolved and long before a CLI is launched, because the run is what
# would be wasted, and the name reaches here by three roads that all end at the same list: the
# brief's `MODEL:` line (relays forward it as `--model`), `--model` itself, and the vendor's own
# `*_model=` key in the toggle file — including the default a missing key falls back to.
refuse_cheap_model() { # vendor offered-model [resume-id] [class]
  local vendor="$1" offered="$2" resume="${3:-}" class="${4:-}" effective
  case "$vendor" in
    claudeb) effective=${offered:-$(config_value claudeb_model)}; effective=${effective:-$(worker_model_default_model "$vendor")} ;;
    codex)
      # `exec resume` re-runs the session's own model and config.toml's never travels with it
      # (start_run sends `-m` only for an explicit one), so a Terra sitting in that file refuses
      # nothing here — the resumed session is not the run it names.
      [ -z "$resume" ] || [ -n "$offered" ] || return 0
      # `default` names the worker model rather than a model.
      effective=$offered
      [ -n "$effective" ] && [ "$effective" != default ] || effective=$(codex_config_model)
      ;;
    gemini) effective=${offered:-$(config_value gemini_model)}; effective=${effective:-$(worker_model_default_model "$vendor")} ;;
    grok) effective=${offered:-$(config_value grok_model)}; effective=${effective:-$(worker_model_default_model "$vendor")} ;;
  esac
  worker_model_allows "$vendor" "$effective" "$class" && return 0
  outcome_line MODEL_REFUSED
  fail "$vendor models are $(worker_model_allowed_list "$vendor" "$class"); offered model $effective is not among them. Nothing was launched and no account was spent — drop the MODEL: line, or ask Egor."
}

failure_outcome() {
  case "$1" in
    claudeb) printf 'CLAUDEB_FAILED' ;;
    codex) printf 'CODEX_UNAVAILABLE' ;;
    gemini) printf 'GEMINI_UNAVAILABLE' ;;
    grok) printf 'GROK_UNAVAILABLE' ;;
  esac
}

# Fast asked for but not in the account's catalog for this model: the CLI would drop it silently, so
# the run says so and goes standard; it comes back by itself once OpenAI lists the tier again.
refuse_codex_model() { # model
  outcome_line MODEL_REFUSED
  fail "codex model $1 names no model \`codexb models\` lists. Nothing was launched and no account was spent."
}

codex_tier_args() { # account slug requested(true|false)
  local want=$3 rc=0
  if [ "$want" = true ]; then
    codex_fast_offered "$(codex_home "$1")" "$2" || rc=$?
    if [ "$rc" -eq 1 ]; then
      printf 'worker-run: OpenAI offers no Fast for %s on %s now; running standard\n' "$2" "$1" >&2
      want=false
    fi
  fi
  if [ "$want" = true ]; then printf '%s\n' --enable fast_mode -c 'service_tier="priority"'
  else printf '%s\n' --disable fast_mode -c 'service_tier="default"'; fi
}

codex_home() {
  if [ "$1" = main ]; then
    printf '%s/.codex' "$HOME"
  else
    printf '%s/%s' "${CODEX_PROFILES_DIR:-$HOME/.codex-profiles}" "$1"
  fi
}

grok_home() {
  if [ "$1" = main ]; then
    printf '%s/.grok' "$HOME"
  else
    printf '%s/%s' "${GROKB_PROFILES_DIR:-$HOME/.grok-profiles}" "$1"
  fi
}

codex_unsupported_model() {
  # tail-scoped for the same reason has_limit_signature is: codex streams the
  # echoed brief to stderr, and the phrase can appear there as prose.
  if [ -n "${2:-}" ]; then tail -c "$2" "$1/err" 2>/dev/null; else cat "$1/err" 2>/dev/null; fi |
    tail -n 40 | grep -Fqi 'model is not supported'
}

# Where the spawned instance keeps its own transcript: claudeb files it under the profile's projects
# tree named by session id, codex under the profile's sessions tree with the id inside the filename,
# agy under the profile's brain tree named by conversation id — deterministic from the id the run's
# own log already gave up, so nothing here searches for it.
# Grok files a session under the URL-encoded cwd it ran in, so an id found by globbing can belong
# to a session from another directory entirely: the session's own summary.json names that cwd, and
# the encoded directory name answers when the summary is missing. Asked without a workdir — a
# caller that only wants the file — nothing is verified.
grok_session_dir_matches() { # session-dir workdir
  local directory="$1" workdir="$2" recorded
  [ -n "$workdir" ] && [ "$workdir" != null ] || return 0
  recorded=$(jq -r '.info.cwd // empty' "$directory/summary.json" 2>/dev/null)
  if [ -n "$recorded" ]; then
    [ "${recorded%/}" = "${workdir%/}" ]
    return
  fi
  recorded=${directory%/*}
  recorded=${recorded##*/}
  recorded=$(printf '%b' "${recorded//%/\\x}" 2>/dev/null) || return 1
  [ "${recorded%/}" = "${workdir%/}" ]
}

session_transcript() {
  local vendor="$1" account="$2" session="$3" workdir="${4:-}" transcript='' candidate=''
  [ -n "$session" ] && [ "$session" != - ] || return 1
  # A relative step in an id read out of a log would resolve the path somewhere else entirely.
  case "$session" in .|..|*/*) return 1 ;; esac
  case "$vendor" in
    claudeb)
      for transcript in "${CLAUDEB_PROFILES_ROOT:-$HOME/.claude-profiles}/$account/projects/"*/"$session.jsonl"; do
        [ -f "$transcript" ] && break
        transcript=''
      done
      ;;
    codex) transcript=$(find "$(codex_home "$account")/sessions" -type f -name "*$session*.jsonl" 2>/dev/null | head -n1) ;;
    gemini)
      transcript="$(gemini_account_home "$account")/.gemini/antigravity-cli/brain/$session/.system_generated/logs/transcript_full.jsonl"
      ;;
    grok)
      for candidate in "$(grok_home "$account")/sessions/"*/"$session/updates.jsonl"; do
        [ -f "$candidate" ] || continue
        grok_session_dir_matches "${candidate%/updates.jsonl}" "$workdir" || continue
        transcript="$candidate"
        break
      done
      ;;
  esac
  [ -n "$transcript" ] && [ -f "$transcript" ] || return 1
  printf '%s' "$transcript"
}

warn_cold_resume() {
  local vendor="$1" account="$2" resume="$3" transcript threshold ttl now mtime idle usage size tokens token_k idle_text
  [ -n "$resume" ] || return 0
  case "$vendor" in
    claudeb) threshold=3600; ttl=1h ;;
    codex) threshold=1800; ttl=30m ;;
    *) return 0 ;;
  esac
  transcript=$(session_transcript "$vendor" "$account" "$resume") || return 0
  mtime=$(stat -f %m "$transcript" 2>/dev/null) || return 0
  [[ "$mtime" =~ ^[0-9]+$ ]] || return 0
  now=$(date +%s)
  idle=$((now - mtime))
  [ "$idle" -gt "$threshold" ] || return 0
  usage=''
  if [ "$vendor" = claudeb ]; then
    usage=$(jq -r 'select(.message.usage) | (.message.usage | ((.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)))' "$transcript" 2>/dev/null | tail -n1)
    [[ "$usage" =~ ^[0-9]+$ ]] || usage=''
  fi
  if [ -n "$usage" ]; then
    tokens=$usage
  else
    size=$(stat -f %z "$transcript" 2>/dev/null) || return 0
    [[ "$size" =~ ^[0-9]+$ ]] || return 0
    tokens=$((size / 4))
  fi
  token_k=$(((tokens + 500) / 1000))
  if [ "$idle" -ge 3600 ]; then
    idle_text="$((idle / 3600))h$(((idle % 3600) / 60))m"
  else
    idle_text="$((idle / 60))m"
  fi
  printf 'RESUME-COLD: %s session idle %s, cache TTL ~%s expired; context ~%sk tokens re-ingested at full price — consider a fresh worker with a distilled brief\n' "$vendor" "$idle_text" "$ttl" "$token_k" >&2
  return 0
}

valid_run_id() {
  case "$1" in
    ''|*[!a-z0-9-]*) return 1 ;;
    *) return 0 ;;
  esac
}

run_path() {
  valid_run_id "$1" || fail "invalid run id: $1"
  printf '%s/%s' "${WORKER_RUN_DIR:-$HOME/.cache/claude-worker-runs}" "$1"
}

meta_update() {
  local directory="$1" filter="$2" temporary
  shift 2
  temporary="$directory/meta.json.tmp.$$"
  if ! jq "$@" "$filter" "$directory/meta.json" >"$temporary"; then
    rm -f "$temporary"
    return 1
  fi
  mv -f "$temporary" "$directory/meta.json"
}

run_picker() {
  local picker="$1" vendor="$2" exclude="$3" errors="$4"
  local role_arg=${WORKER_RUN_ROLE:-workers}
  if [ -n "$exclude" ]; then
    if [ "$role_arg" = workers ]; then "$picker" --account "$vendor" --claim --exclude "$exclude" 2>"$errors"; else "$picker" --account "$vendor" --role "$role_arg" --claim --exclude "$exclude" 2>"$errors"; fi
  else
    if [ "$role_arg" = workers ]; then "$picker" --account "$vendor" --claim 2>"$errors"; else "$picker" --account "$vendor" --role "$role_arg" --claim 2>"$errors"; fi
  fi
}

pick_account() {
  local vendor="$1" walled="$2" picker errors
  PICKED_ACCOUNT=''
  PICKED_RC=0
  PICKED_POOL_EMPTY=false
  PICKED_ROLE_OFF=false
  PICKED_NO_DATA=false
  picker="${WORKER_RUN_WORKER_PICK:-worker-pick}"
  errors=$(mktemp "${TMPDIR:-/tmp}/worker-run-pick.XXXXXX") ||
    fail 'could not create a temporary file for the account query'
  PICKED_ACCOUNT=$(run_picker "$picker" "$vendor" "$walled" "$errors")
  PICKED_RC=$?
  [ ! -s "$errors" ] || cat "$errors" >&2
  # An empty pool is Egor's choice, not a limit: reporting it as a usage limit would send the
  # orchestrator hunting for quota that is not the problem.
  ! grep -Eq 'every [a-z]+ account is out of the worker pool' "$errors" || PICKED_POOL_EMPTY=true
  # A vendor closed for this role is the same kind of decision, and its accounts may be at 0%.
  # Only workers is asked for here, so only workers can come back.
  ! grep -q 'is switched off for workers' "$errors" || PICKED_ROLE_OFF=true
  ! grep -Eq 'worker-pick: [a-z]+ is paused \(' "$errors" || PICKED_ROLE_OFF=true
  # A vendor the picker cannot read at all — no accounts, no usage snapshot — is not a walled one.
  # Its quota may be untouched, and this whole system exists so that nothing reports a limit it has
  # no data for (docs/DIAGNOSTICS.md, the 429 taxonomy).
  # worker-pick puts its whole vendor line inside those parens, so the reason may carry a
  # pin-lapse clause before it and, on older builds, a vendor prefix (`grok: unavailable`).
  ! grep -Eq 'no selectable [a-z]+ account \(([a-z]+: )?([^)]*[|—] )?(unavailable|no( [A-Za-z]+)* quota data|no accounts)\)' "$errors" ||
    PICKED_NO_DATA=true
  PICKED_WALLED=false
  ! grep -Eq '(^|[^[:alnum:]_])WALLED([^[:alnum:]_]|$)' "$errors" || PICKED_WALLED=true
  if [ "${WORKER_RUN_ROLE:-workers}" = research ] && [ "$PICKED_WALLED" = false ]; then
    PICKED_NO_DATA=true
  fi
  rm -f "$errors"
  PICKED_ACCOUNT=${PICKED_ACCOUNT%%$'\n'*}
}

# The picker ranks quota only, and a codex catalog is per account: a lapsed plan lists the free models
# alone, so its idle account ranks first and would launch an id it does not serve.
pick_account_listing() { # vendor exclude model
  local exclude=$2 claimed=''
  PICKED_UNLISTED=''
  while :; do
    [ "$1" != codex ] || claimed=$(worker_claims_fresh codex 2>/dev/null) || claimed=''
    pick_account "$1" "$exclude"
    [ "$1" = codex ] && [ "$PICKED_RC" -eq 0 ] && [ -n "$PICKED_ACCOUNT" ] || return 0
    [ -z "$(worker_model_codex_slug "$3" "$PICKED_ACCOUNT")" ] || return 0
    case ",$exclude," in *",$PICKED_ACCOUNT,"*) PICKED_ACCOUNT='' PICKED_RC=3; return 0 ;; esac
    # The picker claimed it for this launch; a claim someone else already held stays theirs.
    grep -qxF -- "$PICKED_ACCOUNT" <<<"$claimed" || worker_claims_release codex "$PICKED_ACCOUNT" || :
    printf 'worker-run: codex/%s lists no model of %s; routing past it\n' "$PICKED_ACCOUNT" "$3" >&2
    PICKED_UNLISTED=${PICKED_UNLISTED:+$PICKED_UNLISTED,}$PICKED_ACCOUNT
    exclude=${exclude:+$exclude,}$PICKED_ACCOUNT
  done
}

read_json_array() {
  local expression="$1" file="$2" value
  while IFS= read -r value; do
    REPLY_ARRAY+=("$value")
  done < <(jq -r "$expression" "$file")
}

supervise_claudeb() {
  local directory="$1" meta="$1/meta.json" account model effort resume cli rc chrome value
  local -a command retry access
  account=$(jq -r '.account' "$meta")
  model=$(jq -r '.model' "$meta")
  effort=$(jq -r '.effort' "$meta")
  resume=$(jq -r '.resume' "$meta")
  cli=$(jq -r '.cli' "$meta")
  chrome=$(jq -r '.chrome // false' "$meta")
  access=(--dangerously-skip-permissions)
  [ "$(jq -r '.role // "workers"' "$meta")" != research ] || access=(--permission-mode plan)
  REPLY_ARRAY=()
  read_json_array '.add_dirs[]' "$meta"
  for value in "${REPLY_ARRAY[@]}"; do access+=(--add-dir "$value"); done
  # Into `access` and not into `command`: the effort-drop retry below rebuilds the command from it,
  # and a web-search state left behind there relaunches the run with a capability it was denied.
  while IFS= read -r value; do access+=("$value"); done < <(web_search_args claudeb "$(web_search_meta_state "$meta")")
  value=$(jq -r '.inbox_settings // empty' "$meta")
  [ -z "$value" ] || access+=(--settings "$value")
  command=("$cli" profile "$account" -p --model "$model" --effort "$effort" --output-format json "${access[@]}")
  [ -z "$resume" ] || command+=(--resume "$resume")
  [ "$chrome" = false ] || command+=(--chrome)
  # A -p session ends when its turn does: a suite sent to the background dies unread with it, and
  # the worker's closing "I'll report once they finish" leaves the round without its verdicts.
  local -x CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1
  run_with_deadline "${command[@]}" <"$directory/brief.launch" >"$directory/out" 2>"$directory/err"
  rc=$?
  if [ "$rc" -ne 0 ] && grep -Eiq -- '((unknown|unrecognized|invalid|unexpected|unsupported|not supported).{0,80}--effort|--effort.{0,80}(unknown|unrecognized|invalid|unexpected|unsupported|not supported))' "$directory/err"; then
    retry=("$cli" profile "$account" -p --model "$model" --output-format json "${access[@]}")
    [ -z "$resume" ] || retry+=(--resume "$resume")
    [ "$chrome" = false ] || retry+=(--chrome)
    meta_update "$directory" '.effort_flag_dropped = true' || return 4
    : >"$directory/out"
    : >"$directory/err"
    # A second launch is a second session: without a token of its own this attempt adopts the
    # transcript the first one left in the tree, and reports a session that holds none of its work.
    launch_attempt "$directory" || return 4
    run_with_deadline "${retry[@]}" <"$directory/brief.launch" >"$directory/out" 2>"$directory/err"
    rc=$?
  fi
  value=$(served_model_from_envelope "$directory/out" "$model")
  [ -z "$value" ] || meta_update "$directory" '.served_model = $model' --arg model "$value" || :
  return "$rc"
}

codex_attempt() {
  local directory="$1" account="$2" rc saved_home="${CODEX_HOME-}" had_home="${CODEX_HOME+x}"
  shift 2
  if [ "$account" = main ]; then
    unset CODEX_HOME
    run_with_deadline "$@" <"$directory/brief.launch" >/dev/null 2>"$directory/err"
    rc=$?
    [ -z "$had_home" ] || export CODEX_HOME="$saved_home"
  else
    CODEX_HOME="$(codex_home "$account")" run_with_deadline "$@" <"$directory/brief.launch" >/dev/null 2>"$directory/err"
    rc=$?
  fi
  return "$rc"
}

supervise_codex() {
  local directory="$1" meta="$1/meta.json" account model effort resume cli rc value drop=false dropped=false fast refused=
  local -a command retry add_dirs images
  account=$(jq -r '.account' "$meta")
  model=$(jq -r '.model' "$meta")
  effort=$(jq -r '.effort' "$meta")
  resume=$(jq -r '.resume' "$meta")
  cli=$(jq -r '.cli' "$meta")
  REPLY_ARRAY=()
  read_json_array '.add_dirs[]' "$meta"
  add_dirs=("${REPLY_ARRAY[@]}")
  REPLY_ARRAY=()
  read_json_array '.images[]' "$meta"
  images=("${REPLY_ARRAY[@]}")
  # Resolved again here, on the account this attempt runs on: a reroute lands on another account,
  # and each account's catalog is its own.
  value=$(worker_model_codex_slug "$model" "$account") && [ -n "$value" ] &&
    [ "$value" != "$(jq -r '.model_id // empty' "$meta")" ] &&
    { meta_update "$directory" '.model_id = $id' --arg id "$value" || :; }
  if [ -n "$resume" ]; then
    command=("$cli" exec resume "$resume")
    value=$(jq -r 'if (.explicit_model // "") != "" then .model_id // .explicit_model else empty end' "$meta")
    [ -z "$value" ] || command+=(-m "$value")
    value=$(jq -r '.explicit_effort // empty' "$meta")
    [ -z "$value" ] || command+=(-c "model_reasoning_effort=$value")
  else
    command=("$cli" exec -C "$(jq -r '.workdir' "$meta")" -m "$(jq -r '.model_id // .model' "$meta")" -c "model_reasoning_effort=$effort" --color never)
  fi
  [ "$(jq -r '.role // "workers"' "$meta")" != research ] || command+=(--sandbox read-only)
  for value in "${add_dirs[@]}"; do command+=(--add-dir "$value"); done
  for value in "${images[@]}"; do command+=(-i "$value"); done
  while IFS= read -r value; do command+=("$value"); done < <(web_search_args codex "$(web_search_meta_state "$meta")")
  # The launching chat's fast word travels in meta.json: the supervisor is detached and the chat
  # pin file it was read from belongs to a session this process cannot name.
  fast=false
  if [ "$(jq -r '.fast // false' "$meta")" = true ] || [ "$(codex_fast_tier "$account")" = fast ]; then fast=true; fi
  while IFS= read -r value; do command+=("$value"); done < <(codex_tier_args "$account" "$(jq -r '.model_id // .model' "$meta")" "$fast")
  command+=(-o "$directory/out" -)
  codex_attempt "$directory" "$account" "${command[@]}"
  rc=$?
  if [ "$rc" -ne 0 ] && grep -Fqi 'Not inside a trusted directory' "$directory/err"; then
    # Appended, not spliced in: a resume command starts `exec resume <id>` and a
    # positional insert would separate the subcommand from its id.
    command+=(--skip-git-repo-check)
    meta_update "$directory" '.trusted_dir_retry = true' || return 4
    : >"$directory/out"
    codex_attempt "$directory" "$account" "${command[@]}"
    rc=$?
  fi
  if [ "$rc" -ne 0 ] && codex_unsupported_model "$directory"; then
    retry=()
    for value in "${command[@]}"; do
      if [ "$drop" = true ]; then drop=false; refused=$value; continue; fi
      if [ "$value" = -m ]; then drop=true; dropped=true; continue; fi
      retry+=("$value")
    done
    if [ "$dropped" = true ]; then
      value=$(worker_model_codex_slug "$model" "$account") || value=''
      if [ -z "$value" ] || [ "$value" = "$refused" ]; then
        value=$(codex_config_model)
        worker_model_allows codex "$value" || return "$rc"
        value=$(worker_model_codex_slug "$value" "$account") && [ -n "$value" ] && [ "$value" != "$refused" ] ||
          return "$rc"
      fi
      retry+=(-c "model=\"$value\"")
      meta_update "$directory" '.model_flag_dropped = true' || return 4
      : >"$directory/out"
      codex_attempt "$directory" "$account" "${retry[@]}"
      rc=$?
    fi
  fi
  codex_record_served "$directory" "$account"
  return "$rc"
}

# The rollout names the model the client asked for on each turn, and a `model_reroute` event where
# the server answered with another; the last of them is what served the run.
codex_record_served() { # directory account
  local session transcript served
  session=$(session_id "$1")
  transcript=$(session_transcript codex "$2" "$session") || return 0
  served=$(jq -rR 'fromjson? | select(type == "object")
      | if .type == "turn_context" then .payload.model?
        elif .type == "event_msg" and .payload.type? == "model_reroute" then .payload.to_model?
        else empty end | strings' "$transcript" 2>/dev/null | tail -n 1)
  [ -z "$served" ] || meta_update "$1" '.served_model = $model' --arg model "$served" || :
}

# The requested id is no evidence (agy <= 1.1.9 served Flash for the Pro high slug); the log's last
# backend override label is.
gemini_record_served() { # directory
  local served
  served=$(sed -n 's/.*Propagating selected model override to backend: label="\([^"]*\)".*/\1/p' \
    "$1/log" 2>/dev/null | tail -n 1)
  [ -z "$served" ] || meta_update "$1" '.served_model = $model' --arg model "$served" || :
}

supervise_gemini() {
  local directory="$1" meta="$1/meta.json" account agy_model resume cli prompt value rc
  local -a command add_dirs
  account=$(jq -r '.account' "$meta")
  agy_model=$(jq -r '.agy_model' "$meta")
  resume=$(jq -r '.resume' "$meta")
  cli=$(jq -r '.cli' "$meta")
  prompt=$(<"$directory/brief.launch")
  command=("$cli" profile "$account" --model "$agy_model" --add-dir "$HOME/.claude")
  REPLY_ARRAY=()
  read_json_array '.add_dirs[]' "$meta"
  add_dirs=("${REPLY_ARRAY[@]}")
  for value in "${add_dirs[@]}"; do command+=(--add-dir "$value"); done
  command+=(--print-timeout 360m --dangerously-skip-permissions --log-file "$directory/log")
  while IFS= read -r value; do command+=("$value"); done < <(web_search_args gemini "$(web_search_meta_state "$meta")")
  [ -z "$resume" ] || command+=(--conversation "$resume")
  command+=(--print "$prompt")
  run_with_deadline "${command[@]}" >"$directory/out" 2>"$directory/err"
  rc=$?
  return "$rc"
}

non_git_tree_digest() { # dir
  (cd "$1" 2>/dev/null || exit 1
   find . -mindepth 1 2>/dev/null | sort | while IFS= read -r item; do
    if [ -L "$item" ]; then
      printf 'l\t%s\t%s\n' "$(readlink "$item" 2>/dev/null)" "$item"
    elif [ -d "$item" ]; then
      printf 'd\t%s\n' "$item"
    elif [ -f "$item" ]; then
      sha=$(git hash-object -- "$item" 2>/dev/null) || sha=$(shasum -a 256 "$item" 2>/dev/null | cut -d' ' -f1)
      printf 'f\t%s\t%s\n' "${sha:--}" "$item"
    fi
  done)
}

research_tree_digest() { # root...
  local root head unshaped
  for root in "$@"; do
    [ -d "$root" ] || return 1
    printf '%s\n' "$root"
    if git -C "$root" rev-parse --show-toplevel >/dev/null 2>&1; then
      head=$(git -C "$root" rev-parse --verify --quiet HEAD 2>/dev/null) || head=empty
      printf '%s\n' "$head"
      unshaped=$(mktemp) || return 1
      workdir_dirty_shas "$root" "$unshaped" && cat "$unshaped" || { rm -f "$unshaped"; return 1; }
      rm -f "$unshaped"
    else
      non_git_tree_digest "$root" || return 1
    fi
  done
}

# Grok has no read-only mode, so a research run is checked from outside: the trees it may read are
# digested before and after, and any difference fails the run.
supervise_grok() {
  local directory="$1" meta="$1/meta.json" account model effort resume cli turns rc served denied before='' search_arg
  local -a command roots
  roots=()
  if [ "$(jq -r '.role // "workers"' "$meta")" = research ]; then
    REPLY_ARRAY=()
    read_json_array '.add_dirs[]' "$meta"
    roots=("$(jq -r '.workdir' "$meta")" "${REPLY_ARRAY[@]}")
    before=$(research_tree_digest "${roots[@]}") || {
      printf 'research: the tree digest a read-only grok run is checked against could not be taken\n' >"$directory/err"
      printf 'READ_ONLY_VIOLATION\n' >"$directory/research-outcome"
      return 5
    }
  fi
  account=$(jq -r '.account' "$meta")
  model=$(jq -r '.model' "$meta")
  effort=$(jq -r '.effort' "$meta")
  resume=$(jq -r '.resume' "$meta")
  cli=$(jq -r '.cli' "$meta")
  turns=$(jq -r '.max_turns // empty' "$meta")
  # GROK_MEMORY=0 rather than a flag: `--no-memory` was dropped in 1.0.13, and a worker inheriting
  # the profile's memory would carry another task's notes into this brief.
  command=(env GROK_MEMORY=0 "$cli" profile "$account" --prompt-file "$directory/brief.launch"
    --output-format streaming-json --always-approve --cwd "$(jq -r '.workdir' "$meta")"
    --no-subagents --reasoning-effort "$effort")
  [ -z "$turns" ] || command+=(--max-turns "$turns")
  [ "$model" = auto ] || command+=(-m "$model")
  # `-r` resumes; `-s` only ever CREATES and rejects an id that already exists (live 1.0.13).
  [ -z "$resume" ] || command+=(-r "$resume")
  while IFS= read -r search_arg; do command+=("$search_arg"); done < <(web_search_args grok "$(web_search_meta_state "$meta")")
  run_with_deadline "${command[@]}" >"$directory/out" 2>"$directory/err"
  rc=$?
  if [ "${#roots[@]}" -gt 0 ] && [ "$(research_tree_digest "${roots[@]}")" != "$before" ]; then
    printf 'research: the tree changed during a read-only grok run — a fetched page or a scratch note saved into it is the usual cause; web sources belong inline in the answer\n' >>"$directory/err"
    printf 'READ_ONLY_VIOLATION\n' >"$directory/research-outcome"
    return 5
  fi
  served=$(grok_end_field "$directory" 'tojson' | served_model_from_envelope /dev/stdin "$model")
  [ -z "$served" ] || meta_update "$directory" '.served_model = $model' --arg model "$served" || :
  # A tool the permission policy refused is neither a wall nor a failed run — 1.0.13 ends such a run
  # normally with exit 0 — but it is the one thing a reader of a thin result needs to know about.
  # Counted off the denial EVENT, never the phrase: the CLI states a policy denial once, in the
  # failed tool_call_update, and the agent then quotes that same sentence back in its own answer
  # (live-caught) — so a grep over the stream double-counts a real denial, and reports one for a
  # brief that merely discusses them.
  denied=$(jq -rR 'fromjson?
                   | select(type == "object" and .type == "tool_call_update" and .status == "failed")
                   | select([.content[]? | .. | strings]
                            | any(test("was not executed: Denied by permission policy")))
                   | .toolCallId' "$directory/out" 2>/dev/null | wc -l | tr -d '[:space:]')
  [[ "$denied" =~ ^[0-9]+$ ]] || denied=0
  [ "$denied" -eq 0 ] || meta_update "$directory" '.denied_tools = $n' --argjson n "$denied" || :
  return "$rc"
}

served_model_from_envelope() { # envelope-file requested-model
  "$SCRIPT_DIRECTORY/../ask_claude.sh" --extract-served-model "${2:-}" <"$1"
}

# One field off the streaming run's terminal `end` event. Read with fromjson? so a truncated line
# in a killed run's stream is skipped rather than voiding the whole read.
grok_end_field() { # directory jq-expression
  jq -rR "fromjson? | select(type == \"object\" and .type == \"end\") | $2" "$1/out" 2>/dev/null |
    sed '/^$/d' | tail -n1
}

record_run_wall() {
  local directory="$1" vendor="$2" account reset epoch event
  account=$(jq -r '.account' "$directory/meta.json" 2>/dev/null) || return 0
  [ -n "$account" ] || return 0
  event="$directory/wall-reset.$(head -n1 "$directory/attempt" 2>/dev/null)"
  if ! IFS= read -r epoch 2>/dev/null <"$event"; then
    reset=$(worker_walls_extract_reset "$directory/out" "$directory/err")
    epoch=$(worker_walls_parse_reset "$reset") || epoch=$(($(date +%s) + 3600))
    printf '%s\n' "$epoch" >"$event" || return 1
  fi
  worker_walls_record "$vendor" "$account" "$epoch" || true
  worker_model_clear_walled_pin "$vendor" "$account" || true
  local target="${vendor/#claudeb/claude}/$account" wall
  if [ -f "${CLAUDEB_DIR:-$HOME/.claude-profiles/.claudeb}/reset-arm/${target/\//-}" ]; then
    wall=$(worker_walls_kind "$vendor" "${reset:+$epoch}" "$directory/out" "$directory/err")
    ${CHILD_GROUP_PREFIX[@]+"${CHILD_GROUP_PREFIX[@]}"} "$SCRIPT_DIRECTORY/llm-reset-redeem" \
      --fire-armed "$target" --wall "$wall" </dev/null >/dev/null 2>&1 &
  fi
}

CLAUDEB_AUTH_RE='OAuth session expired'

record_claudeb_auth_dead() { # directory
  local account
  jq -Rne --arg re "$CLAUDEB_AUTH_RE" \
    'any(inputs | fromjson? | objects | select(.is_error == true) | .result | strings; test($re; "i"))' \
    >/dev/null 2>&1 <"$1/out" || return 0
  account=$(jq -r '.account // empty' "$1/meta.json" 2>/dev/null)
  [ -n "$account" ] || return 0
  "$(jq -r '.cli' "$1/meta.json")" auth-needed "$account" "$CLAUDEB_AUTH_RE" </dev/null >/dev/null 2>&1 || true
}

reroute_walled() {
  # At most ONE reroute per run (Egor, 2026-10-05): each rescue is a fresh session rereading the whole
  # context, and a chain of them burnt a pool for hours unseen; the second wall hands the choice back
  # to the launching chat. A resumed session never moves: it lives inside one profile.
  local directory="$1" vendor="$2" walled tag
  # The research leg reads the quota out of the answer stream and the agy log too, which
  # has_limit_signature deliberately never scans; its own verdict is the wall for that run.
  if ! has_limit_signature "$directory" "$vendor"; then
    [ "$(cat "$directory/research-outcome" 2>/dev/null)" = GEMINI_USAGE_LIMIT ] || return 1
  fi
  record_run_wall "$directory" "$vendor"
  # An account-bound browser preamble cannot follow the ordinary pool reroute.
  if [ "$vendor" = claudeb ] && jq -e '.browser == true' "$directory/meta.json" >/dev/null; then return 1; fi
  [ -z "$(jq -r '.resume // empty' "$directory/meta.json")" ] || return 1
  if jq -e '.role == "research" and .explicit_account != ""' "$directory/meta.json" >/dev/null; then return 1; fi
  if jq -e '(.walled_accounts // []) | length > 0' "$directory/meta.json" >/dev/null; then return 1; fi
  walled=$(jq -r '((.walled_accounts // []) + [.account]) | join(",")' "$directory/meta.json")
  pick_account_listing "$vendor" "$walled" "$(jq -r '.model' "$directory/meta.json")"
  [ "$PICKED_RC" -eq 0 ] && [ -n "$PICKED_ACCOUNT" ] || return 1
  # Defence against a picker that ignores --exclude: relaunching on an account
  # this run already burnt would wall again forever.
  case ",$walled," in *",$PICKED_ACCOUNT,"*) return 1 ;; esac
  if [ "$vendor" = gemini ]; then
    grep -Eq "^${PICKED_ACCOUNT}:" <<<"$("$(jq -r '.cli' "$directory/meta.json")" list 2>/dev/null)" ||
      return 1
  fi
  # started_at is restamped because run_overdue budgets one deadline, and a chain
  # of full-length attempts would otherwise read as a wedged CLI.
  # Per-attempt facts belong to the attempt that recorded them: carried over, the abandoned run's
  # served model and refused tools would be reported as the rescue attempt's own.
  meta_update "$directory" \
    '.walled_accounts = ((.walled_accounts // []) + [.account]) | .account = $next | .started_at = $now
     | if .browser then .browser_account = $next else . end
     | del(.served_model, .denied_tools)' \
    --arg next "$PICKED_ACCOUNT" --argjson now "$(date +%s)" || return 1
  if IFS= read -r tag 2>/dev/null <"$directory/tag"; then
    printf '%s · %s\n' "$PICKED_ACCOUNT" "${tag#* · }" >"$directory/tag"
  fi
  : >"$directory/out"
  : >"$directory/err"
  [ "$vendor" != gemini ] || : >"$directory/log"
}

# In the detached supervisor, before the first attempt: hashing a large dirty tree takes minutes, and
# held in start's foreground a caller interrupted there left a run with no supervisor (ledger W6).
take_floor() { # directory workdir
  local directory="$1" workdir="$2" review_round
  review_round=$(jq -r '.review_round // empty' "$directory/meta.json" 2>/dev/null) || review_round=''
  REPLY_ARRAY=()
  read_json_array '.add_dirs[]' "$directory/meta.json"
  # What was already uncommitted here before this run touched anything. It is the floor the dirt
  # snapshot at the end is measured against: without it, every file Egor or a co-tenant chat had
  # open would be evidence produced by whichever run happened to finish beside them.
  workdir_dirty_paths "$workdir" >"$directory/dirty-before.tmp.$$" 2>/dev/null &&
    mv -f "$directory/dirty-before.tmp.$$" "$directory/dirty-before" 2>/dev/null ||
    rm -f "$directory/dirty-before.tmp.$$" 2>/dev/null
  workdir_dirty_shas "$workdir" "$directory/unshaped-before" >"$directory/dirty-before-shas.tmp.$$" 2>/dev/null &&
    mv -f "$directory/dirty-before-shas.tmp.$$" "$directory/dirty-before-shas" 2>/dev/null ||
    rm -f "$directory/dirty-before-shas.tmp.$$" "$directory/unshaped-before" 2>/dev/null
  # And the commit the tree stood on, which is what a path NOT already dirty is measured against.
  # Never restamped by a reroute: an attempt's floor is the run's floor, and read off the end of the
  # run instead every link the run itself committed would be measured against its own result.
  git -C "$workdir" rev-parse --verify --quiet HEAD >"$directory/head-before.tmp.$$" 2>/dev/null &&
    mv -f "$directory/head-before.tmp.$$" "$directory/head-before" 2>/dev/null ||
    rm -f "$directory/head-before.tmp.$$" 2>/dev/null
  git -C "$workdir" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' \
    >"$directory/worktrees-before" 2>/dev/null || :
  # A round fixer's fold reads the start, branch and HEAD this record keeps, so a commit landed
  # during the run is never anchored as the fix.
  if [ -n "$review_round" ] && [ -s "$directory/launcher" ] &&
    git -C "$workdir" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$workdir" rev-parse --path-format=absolute --git-common-dir >"$directory/anchors-common" 2>/dev/null ||
      rm -f "$directory/anchors-common" 2>/dev/null
    review_anchors run-start --repo "$workdir" --run "${directory##*/}" --session "$(cat "$directory/launcher")" \
      >/dev/null 2>&1 || :
  fi
  [ ! -s "$directory/launcher" ] ||
    snapshot_other_families "$directory" "$workdir" "$(cat "$directory/launcher")" "$review_round" \
      ${REPLY_ARRAY[@]+"${REPLY_ARRAY[@]}"}
}

supervise() {
  local directory="$1" vendor workdir rc
  [ -r "$directory/meta.json" ] || return 4
  vendor=$(jq -r '.vendor' "$directory/meta.json")
  workdir=$(jq -r '.workdir' "$directory/meta.json")
  RUN_DIRECTORY=$directory
  # Into THIS run's tree and nowhere else: the supervisor is setsid'd, so every vendor child and
  # everything it spawns inherits these and nothing on the machine outside the run does. A serial,
  # daemonless nx is what keeps one agent's fan-out from being the tree memlogd's memory guard has
  # to cut down (docs/memory-guard.md).
  export NX_PARALLEL=1 NX_DAEMON=false
  # Even the run that never started answers for itself: absent, its record is indistinguishable from
  # the record of a run still going, and a reader takes that for a run that wrote nothing.
  cd "$workdir" || { persist_run_files "$directory"; return 4; }
  take_floor "$directory" "$workdir"
  # At most NIGHT_FIXER_SLOTS workers on night branches at once (cores / 2 clamped 2 to 8, up to the cores
  # capped at 12 while slot_room finds room): a night worker is model-bound between suite runs, which run-suites caps on its own. started_at
  # stays the launch, so a night's hours include the queue; the deadline clock is slot_at, the slot's
  # instant, kept fresh through the wait.
  local branch
  branch=$(linked_worktree_branch "$workdir")
  # A run nested under a slot holder's worker inherits NIGHT_FIXER_SLOT: waiting would deadlock on its ancestor.
  if [[ $branch == night/*/* ]] && [ -z "${NIGHT_FIXER_SLOT:-}" ]; then
    NIGHT_SLOT=$(slot_wait "${NIGHT_FIXER_SLOTS_DIR:-${DOCTORS_DIR:-$HOME/.cache/doctors}/fixer-slots}" \
      "${NIGHT_FIXER_SLOTS:-$(night_worker_slots)}" $((2 * DEADLINE + 900)) night-workers \
      "worker run ${directory##*/} on $branch" meta_update "$directory" '.slot_at = (now | floor)' 2>/dev/null) ||
      { persist_run_files "$directory"; return 4; }
    export NIGHT_FIXER_SLOT=$NIGHT_SLOT
    meta_update "$directory" '.slot_at = (now | floor)' || :
  fi
  while :; do
    # The slot's ceiling runs from its mtime, and each walled reroute is an attempt with a deadline of its own.
    [ -z "$NIGHT_SLOT" ] || touch "$NIGHT_SLOT" 2>/dev/null
    case "$vendor" in
      claudeb) supervise_claudeb "$directory" ;;
      codex) supervise_codex "$directory" ;;
      gemini)
        if [ "$(jq -r '.role // "workers"' "$directory/meta.json")" = research ]; then
          . "$SCRIPT_DIRECTORY/../share/light-research.sh"
          supervise_gemini_research "$directory"
        else
          supervise_gemini "$directory"
        fi
        ;;
      grok) supervise_grok "$directory" ;;
      *) return 4 ;;
    esac
    rc=$?
    [ "$vendor" != gemini ] || gemini_record_served "$directory"
    # After EVERY attempt, not only the last one: a walled attempt wrote whatever it wrote before the
    # wall, and rerouting restamps the run's start and takes a new session — read afterwards, that
    # attempt's files are behind the cut and belong to nobody at all. A failed attempt counts the
    # same way; the record is a union across attempts.
    persist_run_files "$directory"
    [ "$rc" -eq 0 ] && return 0
    [ "$vendor" != claudeb ] || record_claudeb_auth_dead "$directory"
    # A run somebody signalled is over: rerouting it would answer an operator's kill by launching
    # the same brief again on another account.
    case "$(head -n1 "$directory/killed" 2>/dev/null)" in term|'signal '*) return "$rc" ;; esac
    reroute_walled "$directory" "$vendor" || return "$rc"
    # The rescue attempt is a session of its own on another account, and the walled attempt's
    # transcript is still the newest one in the tree it shares.
    launch_attempt "$directory" || return "$rc"
  done
}

persist_run_files() {
  local directory="$1" workdir snapshot reason top path nonrepo_named=''
  workdir=$(jq -r '.workdir' "$directory/meta.json" 2>/dev/null)
  if snapshot_workdir "$directory" "$workdir" after; then
    compute_snapshot_files "$directory" "$workdir"
  else
    RUN_FILES_LIST=''
    RUN_FILES_REASON='the workdir after snapshot could not be established'
  fi
  record_worker_session "$directory"
  if [ -z "$workdir" ] || [ "$workdir" = null ]; then
    RUN_FILES_LIST=''
    RUN_FILES_REASON='the run recorded no workdir to resolve its files against'
  fi
  snapshot=$RUN_FILES_LIST
  reason=$RUN_FILES_REASON
  # A snapshot detects change, never its author; an unreadable transcript names no owner.
  compute_transcript_files "$directory"
  RUN_LISTING_LIST=$(sort -u <(sed '/^$/d' <<<"$RUN_FILES_LIST") \
                             <([ -z "$workdir" ] || [ "$workdir" = null ] ||
                                 shell_write_rows "$directory" "$workdir" "$snapshot"))
  RUN_LISTING_REASON=$RUN_FILES_REASON
  RUN_LISTING_PARTIAL=$RUN_FILES_PARTIAL
  RUN_FILES_EXTERNAL=''
  top=$(git -C "$workdir" rev-parse --show-toplevel 2>/dev/null) || top=''
  while IFS= read -r path; do
    case "$path" in
      /*)
        [ -z "$top" ] || [[ "$path" != "$top"/* ]] || continue
        RUN_FILES_EXTERNAL+="$path"$'\n'
        ;;
      ?*)
        # A workdir that is no repository (the parent of several) folds only through its families,
        # which read the named paths from files-external. Kept out of RUN_FILES_EXTERNAL: its
        # PARTIAL line would let `claim` accept unchecked paths of a workdir that lost its .git.
        [ -n "$top" ] || [ -z "$workdir" ] || [ "$workdir" = null ] || nonrepo_named+="${workdir%/}/$path"$'\n'
        ;;
    esac
  done <<<"$RUN_LISTING_LIST"
  record_made_worktrees "$directory"
  record_workdir_escape "$directory"
  RUN_FILES_LIST=$snapshot
  RUN_FILES_REASON=$reason
  RUN_FILES_COTENANT=''
  RUN_FILES_UNNAMED=''
  if [ -z "$reason" ]; then
    RUN_FILES_LIST=$(comm -12 <(sed '/^$/d' <<<"$snapshot" | sort -u) \
                              <(sed '/^$/d' <<<"$RUN_LISTING_LIST" | sort -u))
    if [ -z "$RUN_LISTING_REASON" ] && [ -z "$RUN_LISTING_PARTIAL" ]; then
      RUN_FILES_COTENANT=$(comm -23 <(sed '/^$/d' <<<"$snapshot" | sort -u) \
                                    <(sed '/^$/d' <<<"$RUN_LISTING_LIST" | sort -u))
    else
      RUN_FILES_UNNAMED=$(comm -23 <(sed '/^$/d' <<<"$snapshot" | sort -u) \
                                   <(sed '/^$/d' <<<"$RUN_LISTING_LIST" | sort -u))
    fi
  fi
  {
    [ -z "$workdir" ] || [ "$workdir" = null ] || printf 'WORKDIR: %s\n' "$workdir"
    [ -z "$RUN_FILES_REASON" ] || printf 'UNKNOWN: %s\n' "$RUN_FILES_REASON"
    if [ -z "$RUN_FILES_REASON" ] && { [ -n "$RUN_LISTING_REASON" ] || [ -n "$RUN_LISTING_PARTIAL" ]; }; then
      printf 'PARTIAL: %s\n' "${RUN_LISTING_REASON:-$RUN_LISTING_PARTIAL}"
    fi
    [ -z "$RUN_FILES_EXTERNAL" ] ||
      printf 'PARTIAL: transcript names writes outside the snapshotted repository; see files-note\n'
    [ -z "$RUN_FILES_LIST" ] || printf '%s\n' "$RUN_FILES_LIST"
  } >"$directory/files.tmp.$$" 2>/dev/null &&
    mv -f "$directory/files.tmp.$$" "$directory/files" 2>/dev/null ||
    rm -f "$directory/files.tmp.$$" 2>/dev/null
  printf '%s' "$RUN_FILES_EXTERNAL$nonrepo_named" >"$directory/files-external" 2>/dev/null || :
  record_workdir_dirt "$directory" "$workdir"
  [ -n "$RUN_FILES_REASON" ] || record_produced "$directory" "$workdir"
  transcript_crosscheck "$directory"
  return 0
}

# A worktree the run made after launch is its own to write (ledger W3), granted only when the run's
# own `worktree add` names it and it did not exist at launch: absent from the floor's listing of the
# workdir's repository, or, in a repository the floor never listed, its git admin directory born
# after the run started. One another chat made meanwhile has no such command, so a write there still
# reads as escaped.
record_made_worktrees() { # directory
  local directory="$1" path root name tree admin born started made=''
  started=$(jq -r '.pid_started_at // .started_at // 0' "$directory/meta.json" 2>/dev/null)
  [[ "$started" =~ ^[0-9]+$ ]] || return 0
  while IFS= read -r path; do
    [[ "$path" =~ ^(/.+)/\.claude/worktrees/([A-Za-z0-9._-]+)/ ]] || continue
    root=${BASH_REMATCH[1]} name=${BASH_REMATCH[2]} tree=${BASH_REMATCH[1]}/.claude/worktrees/${BASH_REMATCH[2]}
    printf '%s\n' "${RUN_SHELL_COMMANDS:-}" | grep -F 'worktree add' |
      grep -qE "(^|[^A-Za-z0-9._-])\.claude/worktrees/${name//./\\.}([^A-Za-z0-9._-]|\$)" || continue
    if grep -qxF -- "$root" "$directory/worktrees-before" 2>/dev/null; then
      ! grep -qxF -- "$tree" "$directory/worktrees-before" || continue
    elif [ -e "$tree/.git" ]; then
      admin=$(git -C "$tree" rev-parse --absolute-git-dir 2>/dev/null) &&
        born=$(stat -c %W "$admin" 2>/dev/null || stat -f %B "$admin" 2>/dev/null) &&
        [[ "$born" =~ ^[0-9]+$ ]] && [ "$born" -ge "$started" ] || continue
    else
      [ -e "$root/.git" ] || continue
    fi
    made+="$tree"$'\n'
  done <<<"${RUN_FILES_EXTERNAL:-}"
  [ -n "$made" ] || return 0
  meta_update "$directory" '.worktrees_made = ((.worktrees_made // []) + $made | unique)' \
    --argjson made "$(printf '%s' "$made" | jq -Rn '[inputs | select(length > 0)]')" || :
}

# A run that worked somewhere other than the workdir it was given, kept beside the run so the two
# readers who care hear it: whoever prints a report, and whoever later wonders why the workdir is
# clean. agy did this SILENTLY (live 2026-08-24) — handed a directory it does not trust it moved
# into the first --add-dir and reported success — and a silent success over an untouched workdir is
# the one failure a launcher cannot see. One line per escaped destination, unioned across attempts.
record_workdir_escape() { # directory
  local directory="$1"
  [ -n "$RUN_FILES_ESCAPE" ] || return 0
  grep -qxF -- "$RUN_FILES_ESCAPE" "$directory/workdir-escape" 2>/dev/null && return 0
  printf '%s\n' "$RUN_FILES_ESCAPE" >>"$directory/workdir-escape" 2>/dev/null || :
  return 0
}

# Off the live answer where one was just computed, off the record otherwise, so every report says it
# — the one `wait` prints the moment the run ends included, which computes no file list of its own.
workdir_escape_line() { # directory
  local escaped
  {
    [ -z "${RUN_FILES_ESCAPE:-}" ] || printf '%s\n' "$RUN_FILES_ESCAPE"
    [ ! -r "$1/workdir-escape" ] || sed '/^$/d' "$1/workdir-escape"
  } | awk '!seen[$0]++ {
    printf "WORKDIR-ESCAPE: the run named no path inside its own workdir; it worked in %s\n", $0
  }'
}

# The uncommitted paths of the repository the workdir belongs to, one per line, spelled against
# that repository's top — which is what `--porcelain` answers in, whatever subdirectory the run was
# launched from. Untracked files are listed individually (`-uall`): a file the run created and
# nothing tracks is exactly the work that reaches no other record at all.
#
# Same arms as ../claude-setup/hooks/lib/review-journal.sh `rj_path_shape_ok`: a path the reader
# would skip must never land in `produced` and then vanish from the ledger. It stays out of the
# listing and goes into the snapshot's `unshaped` digest instead: a run that changed one fails the
# snapshot closed, and one stray `-` file no longer blinds every run in its tree (logo-vectorizer-bench
# 2026-10-01: 47 runs a day folded as `snapshots unreadable`).
path_shape_ok() { # path
  case $1 in
    ''|.|..) return 1 ;;
    /*|\~*|-*) return 1 ;;
    ../*|*/../*|*/..) return 1 ;;
    *[[:cntrl:]]*) return 1 ;;
  esac
  return 0
}

# A symlink's git blob is the link text, never the target. `test -f` follows the link, so a
# symlink-to-dir or a dangling link hashed as `-` and read as a deletion.
hash_workdir_path() { # top path
  local top="$1" path="$2" sha
  if [ -L "$top/$path" ]; then
    sha=$(printf '%s' "$(readlink "$top/$path")" | git -C "$top" hash-object -w --stdin 2>/dev/null) || sha=
  elif [ -f "$top/$path" ]; then
    sha=$(git -C "$top" hash-object -w -- "$path" 2>/dev/null) || sha=
  fi
  printf '%s\n' "${sha:--}"
}

# Nonzero where git could not answer at all, never an empty answer: read as a clean tree, a status
# that failed at launch makes every file Egor already had open content this run gained.
workdir_dirty_paths() { # workdir [unshaped-list]
  local answer
  [ -n "${1:-}" ] && [ "$1" != null ] || return 1
  answer=$(git -C "$1" status --porcelain --no-renames -uall -z 2>/dev/null |
    python3 -c '
import locale, re, sys

try:
    locale.setlocale(locale.LC_CTYPE, "")
except locale.Error:
    pass
cntrl = rb"[\x00-\x1f\x7f]"
if locale.nl_langinfo(locale.CODESET) == "UTF-8":
    cntrl += rb"|\xc2[\x80-\x9f]"
unshaped_re = re.compile(rb"\A(?:\.\.?\Z|[/~-]|\.\./)|/\.\./|/\.\.\Z|" + cntrl)
shaped, unshaped = [], []
for entry in sys.stdin.buffer.read().split(b"\0")[:-1]:
    path = entry[3:]
    if path:
        (unshaped if unshaped_re.search(path) else shaped).append(path)
if unshaped and sys.argv[1]:
    with open(sys.argv[1], "ab") as fh:
        fh.write(b"".join(path + b"\0" for path in unshaped))
sys.stdout.buffer.write(b"".join(path + b"\n" for path in shaped))
' "${2:-}"; status=("${PIPESTATUS[@]}");
    [ "${status[0]}" = 0 ] && [ "${status[1]}" = 0 ]) || return 1
  [ -z "$answer" ] || printf '%s\n' "$answer" | sort -u
}

# The content standing at each already-uncommitted path, as `<blob sha>\t<path>`, so the snapshot
# at the end can tell a file this run REWROTE from one it merely found dirty. Without it a worker
# whose vendor keeps no per-file record and whose fix pass edits files that were already dirty —
# which is every fixing pass over a review scope — reaches no store at all: the launching chat saw
# its own worker's fixes as debt owed by nobody, and a closed round covered none of them (live case
# 2026-08-22). A path git cannot hash (gone, a directory, a special file) records `-`, which
# compares equal only to itself.
workdir_dirty_shas() { # workdir [unshaped-digest-out]
  local top paths
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || return 1
  [ -n "$top" ] || return 1
  if [ -n "${2:-}" ]; then
    : >"$2.list" && paths=$(workdir_dirty_paths "$1" "$2.list") &&
      unshaped_digest "$top" "$2.list" >"$2" || { rm -f "$2.list"; return 1; }
    rm -f "$2.list"
  else
    paths=$(workdir_dirty_paths "$1") || return 1
  fi
  [ -n "$paths" ] || return 0
  printf '%s\n' "$paths" | python3 -c '
import os, stat, subprocess, sys, tempfile

top = sys.argv[1]
paths = [path for path in sys.stdin.buffer.read().split(b"\n") if path]
shas = [b"-"] * len(paths)


def hash_into(indices, names, flags):
    git = ["git", "-C", top, "hash-object", "-w"] + flags

    def one(i):
        run = subprocess.run(git + ["--", names[i]], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if run.returncode == 0 and run.stdout.strip():
            shas[i] = run.stdout.strip()

    # --stdin-paths unquotes a line opening with a double quote. A missing path stops the batch
    # with the shas before it printed, so the rest re-batches after that one path alone.
    pending = []
    for i in indices:
        if names[i].startswith(b"\""):
            one(i)
        else:
            pending.append(i)
    while pending:
        run = subprocess.run(git + ["--stdin-paths"], input=b"".join(names[i] + b"\n" for i in pending),
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        got = run.stdout.split()
        done = len(pending) if run.returncode == 0 and len(got) == len(pending) else min(len(got), len(pending) - 1)
        for i, sha in zip(pending[:done], got):
            shas[i] = sha
        if done < len(pending):
            one(pending[done])
        pending = pending[done + 1:]


root = os.fsencode(top) + b"/"
files, links = [], []
for i, path in enumerate(paths):
    try:
        mode = os.lstat(root + path).st_mode
    except OSError:
        continue
    if stat.S_ISLNK(mode):
        links.append(i)
    elif stat.S_ISREG(mode):
        files.append(i)
hash_into(files, paths, [])
if links:
    with tempfile.TemporaryDirectory() as tmp:
        texts = {}
        for i in links:
            try:
                text = os.readlink(root + paths[i])
            except OSError:
                text = b""
            texts[i] = os.path.join(os.fsencode(tmp), b"%d" % i)
            with open(texts[i], "wb") as fh:
                fh.write(text.rstrip(b"\n"))
        hash_into(links, texts, ["--no-filters"])
sys.stdout.buffer.write(b"".join(sha + b"\t" + path + b"\n" for sha, path in zip(shas, paths)))
' "$top"
}

unshaped_digest() { # top list
  local path
  [ -s "$2" ] || return 0
  while IFS= read -r -d '' path; do
    printf '%s\0' "$path"
    hash_workdir_path "$1" "$path"
  done <"$2" | git -C "$1" hash-object --stdin
}

snapshot_workdir() { # directory workdir side
  local directory="$1" workdir="$2" side="$3" shas head
  # A moved unshaped digest fails the after side itself: a claim reads an absent head-after as "no
  # snapshot" and takes the --complete/PARTIAL path, while a written one demands a diff never computed.
  shas=$(workdir_dirty_shas "$workdir" "$directory/unshaped-$side.tmp.$$") &&
    { [ "$side" != after ] ||
      [ "$(cat "$directory/unshaped-before" 2>/dev/null)" = "$(cat "$directory/unshaped-$side.tmp.$$")" ]; } &&
    mv -f "$directory/unshaped-$side.tmp.$$" "$directory/unshaped-$side" || {
    rm -f "$directory/unshaped-$side.tmp.$$"
    [ "$side" = after ] && rm -f "$directory/produced" "$directory/dirty"
    return 1
  }
  head=$(git -C "$workdir" rev-parse --verify --quiet HEAD 2>/dev/null) || head=''
  { [ -z "$shas" ] || printf '%s\n' "$shas"; } >"$directory/dirty-$side-shas.tmp.$$" &&
    mv -f "$directory/dirty-$side-shas.tmp.$$" "$directory/dirty-$side-shas" || return 1
  printf '%s\n' "$head" >"$directory/head-$side.tmp.$$" &&
    mv -f "$directory/head-$side.tmp.$$" "$directory/head-$side" || return 1
  [ "$side" != after ] || pack_loose_objects "$workdir"
}

# The snapshots' `hash-object -w` blobs are unreachable, and `gc --auto` leaves unreachable objects
# younger than gc.pruneExpire loose, so a repository nobody commits to never packs them. The
# loose-objects task packs any loose object; gc.auto keeps git's threshold, its 0 still means never.
pack_loose_objects() { # workdir
  local at
  at=$(git -C "$1" config --get gc.auto 2>/dev/null) || at=6700
  (nice -n 10 git -C "$1" -c maintenance.loose-objects.auto="$at" maintenance run --auto --task=loose-objects \
    --quiet >/dev/null 2>&1 && git -C "$1" prune-packed --quiet >/dev/null 2>&1 &)
}

# LC_ALL=C on each awk path match (here and in produced_edit_rows): macOS awk compares strings with
# strcoll, and under a UTF-8 locale two different Cyrillic names compare equal — another file's blob.
snapshot_blob() { # directory top side path
  local directory="$1" top="$2" side="$3" path="$4" sha head
  sha=$(AWK_PATH=$path LC_ALL=C awk -F'\t' 'NF == 2 && $2 == ENVIRON["AWK_PATH"] { print $1; exit }' \
    "$directory/dirty-$side-shas" 2>/dev/null)
  if [ -z "$sha" ]; then
    head=$(tr -d '[:space:]' <"$directory/head-$side" 2>/dev/null)
    [ -z "$head" ] || sha=$(git -C "$top" rev-parse --verify --quiet "$head:$path" 2>/dev/null)
  fi
  printf '%s\n' "${sha:--}"
}

# `<before>\t<after>\t<path>` for each top-relative path on stdin, both sides read as snapshot_blob
# reads them; with `changed`, the path alone and only where the two differ. One pass: a snapshot_blob
# per path rescans the listing, and a checkout with thousands of dirty paths took minutes per fold.
snapshot_pairs() { # directory top [changed]
  python3 -c '
import subprocess, sys

directory, top = sys.argv[1], sys.argv[2]
only_changed = sys.argv[3:] == ["changed"]


def listing(side):
    rows = {}
    try:
        with open(directory + "/dirty-" + side + "-shas", "rb") as fh:
            data = fh.read()
    except OSError:
        return rows
    for line in data.split(b"\n"):
        cells = line.split(b"\t")
        if len(cells) == 2:
            rows.setdefault(cells[1], cells[0])
    return rows


def head_tree(side):
    try:
        with open(directory + "/head-" + side, "rb") as fh:
            head = b"".join(fh.read().split())
    except OSError:
        return {}
    if not head:
        return {}
    listed = subprocess.run(["git", "-C", top, "ls-tree", "-r", "-t", "-z", "--full-tree", head],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    if listed.returncode:
        return {}
    entries = {}
    for record in listed.stdout.split(b"\0"):
        meta, tab, path = record.partition(b"\t")
        if tab:
            entries[path] = meta.split(b" ")[2]
    return entries


listings = {side: listing(side) for side in ("before", "after")}
trees = {}
out = []
for path in sys.stdin.buffer.read().split(b"\n"):
    if not path:
        continue
    shas = []
    for side in ("before", "after"):
        sha = listings[side].get(path, b"")
        if not sha:
            if side not in trees:
                trees[side] = head_tree(side)
            sha = trees[side].get(path, b"")
        shas.append(sha or b"-")
    if not only_changed:
        out.append(b"\t".join(shas + [path]))
    elif shas[0] != shas[1]:
        out.append(path)
sys.stdout.buffer.write(b"".join(row + b"\n" for row in out))
' "$@"
}

snapshot_changed_paths() { # directory top
  local directory="$1" top="$2" before after changed paths path
  [ -f "$directory/dirty-before-shas" ] && [ -f "$directory/dirty-after-shas" ] &&
    [ -f "$directory/head-after" ] || return 1
  before=$(cat "$directory/head-before" 2>/dev/null) || before=''
  after=$(cat "$directory/head-after" 2>/dev/null) || return 1
  changed=''
  if [ "$before" != "$after" ]; then
    [ -n "$before" ] || before=$(git -C "$top" hash-object -w -t tree --stdin </dev/null)
    [ -n "$after" ] || after=$(git -C "$top" hash-object -w -t tree --stdin </dev/null)
    changed=$(git -C "$top" diff --no-renames --name-only -z "$before" "$after" -- |
      (while IFS= read -r -d '' path; do
        [ -z "$path" ] && continue
        path_shape_ok "$path" || exit 1
        printf '%s\n' "$path"
      done); status=("${PIPESTATUS[@]}");
      [ "${status[0]}" = 0 ] && [ "${status[1]}" = 0 ]) || return 1
  fi
  paths=$({ cut -f2- "$directory/dirty-before-shas" "$directory/dirty-after-shas"
    [ -z "$changed" ] || printf '%s\n' "$changed"; } | sort -u)
  snapshot_pairs "$directory" "$top" changed <<<"$paths"
}

compute_snapshot_files() { # directory workdir
  local directory="$1" workdir="$2" top rel paths path
  RUN_FILES_LIST=''
  RUN_FILES_REASON=''
  top=$(git -C "$workdir" rev-parse --show-toplevel 2>/dev/null) || {
    RUN_FILES_REASON='the workdir is not a git working tree'; return 0;
  }
  if ! paths=$(snapshot_changed_paths "$directory" "$top"); then
    RUN_FILES_REASON='the workdir before/after snapshots could not be established'
    return 0
  fi
  rel=${workdir%/}
  case "$rel" in "$top"/*) rel=${rel#"$top"/} ;; *) rel='' ;; esac
  RUN_FILES_LIST=$(while IFS= read -r path; do
    [ -n "$path" ] || continue
    produced_spelling "$top" "$rel" "$path"
    printf '\n'
  done <<<"$paths" | sort -u)
}

# The paths whose content is not what `dirty-before` recorded for them: rewritten by this run, or
# gone. A floor written before the shas existed lists paths alone, and every one of them reads as
# unchanged — the old behaviour, which is what a record written by an older worker-run must keep.
workdir_rewritten_paths() { # directory workdir
  local before="$1/dirty-before-shas"
  [ -s "$before" ] || return 0
  workdir_dirty_shas "$2" 2>/dev/null | AWK_BEFORE=$before awk -F'\t' '
    BEGIN { while ((getline line < ENVIRON["AWK_BEFORE"]) > 0) { split(line, f, "\t"); was[f[2]] = f[1] } }
    NF == 2 && ($2 in was) && was[$2] != $1 { print $2 }
  '
}

# The paths this run's window put content at, top-relative: dirty now and not dirty at launch, or
# dirty at launch and holding different content since. Read twice over — by the dirt record at the
# end, and by the liveness row of a run still going — and one definition, or the two disagree about
# what this run has touched.
workdir_gained_paths() { # directory workdir
  { comm -23 <(workdir_dirty_paths "$2") \
             <(sort -u "$1/dirty-before" 2>/dev/null)
    workdir_rewritten_paths "$1" "$2"; } | sort -u
}

# The run's own listing, spelled against the repository TOP the way the dirt snapshot is. The
# listing answers in paths relative to the WORKDIR, so subtracted as it stands from a top-relative
# set it matches nothing at all for a run launched one directory in, and every path the run's own
# tracker named is recorded a second time as owed by nobody.
listing_top_paths() { # directory top workdir
  local rel=${3%/}
  case "$rel" in
    "$2"/*) rel=${rel#"$2"/} ;;
    *) rel='' ;;
  esac
  grep -v '^WORKDIR: \|^UNKNOWN: \|^PARTIAL: ' "$1/files" 2>/dev/null |
    AWK_REL=$rel AWK_TOP=$2/ awk '
      BEGIN { rel = ENVIRON["AWK_REL"]; top = ENVIRON["AWK_TOP"] }
      !NF { next }
      substr($0, 1, 1) == "/" { if (index($0, top) == 1) print substr($0, length(top) + 1); next }
      { print (rel == "" ? $0 : rel "/" $0) }' | sort -u
}

# Spelled the way the LISTING spells its rows — relative to the workdir, absolute outside it — so
# one reader resolves both records against the same anchor.
produced_spelling() { # top rel path
  [ -n "$2" ] || { printf '%s' "$3"; return 0; }
  case "$3" in
    "$2"/*) printf '%s' "${3#"$2"/}" ;;
    *) printf '%s' "$1/$3" ;;
  esac
}

# `<prev>\t<cur>\t<path>` for each top-relative path on stdin whose content moved while the run ran.
# `prev` is what stood there when the run was LAUNCHED — the floor's sha where the path was already
# dirty, HEAD's blob then otherwise — never what stands there now: the reader joins these rows to a
# tree by SHA alone, and a prev read off the current HEAD names a link nothing produced. Both sides
# are hashed with `-w`: the reader prices a link by diffing the two blobs out of the object store,
# and one never written there prices the whole file.
produced_edit_rows() { # directory top rel head-before
  local before="$1/dirty-before-shas" top="$2" rel="$3" head="$4" path prev cur after_head head_blob
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    if [ -f "$1/head-after" ]; then
      cur=$(snapshot_blob "$1" "$top" after "$path")
      after_head=$(cat "$1/head-after")
      if [ -n "$after_head" ] && [ "$after_head" != "$head" ] &&
          ! AWK_PATH=$path LC_ALL=C awk -F'\t' '$2 == ENVIRON["AWK_PATH"] { found=1 } END { exit !found }' "$1/dirty-after-shas"; then
        # A clean launch needs only the commit row; preexisting dirt has a different starting blob.
        head_blob=''
        [ -z "$head" ] || head_blob=$(git -C "$top" rev-parse --verify --quiet "$head:$path" 2>/dev/null)
        [ "$(snapshot_blob "$1" "$top" before "$path")" != "${head_blob:--}" ] || continue
      fi
    else
      cur=$(hash_workdir_path "$top" "$path")
    fi
    # Through the environment and never `-v`: awk expands escape sequences in a `-v` assignment, so
    # a filename holding a backslash reaches the program as some other name and matches no row.
    prev=$(AWK_PATH=$path LC_ALL=C awk -F'\t' 'NF == 2 && $2 == ENVIRON["AWK_PATH"] { print $1; exit }' \
      "$before" 2>/dev/null)
    [ -n "$prev" ] || [ -z "$head" ] ||
      prev=$(git -C "$top" rev-parse --verify --quiet "$head:$path" 2>/dev/null)
    [ -n "$prev" ] || prev=-
    [ "$prev" != "$cur" ] || continue
    printf '%s\t%s\t%s\n' "$prev" "$cur" "$(produced_spelling "$top" "$rel" "$path")"
  done
}

# The same rows for the transitions the run's own commits made, with a fourth field `commit` — the
# one distinction the reader needs, since a commit's blob may already have been produced by whoever
# wrote it (a merge, a cherry-pick) and only the first row naming it owns it. An all-zero sha is a
# side that holds no content, which is this record's `-`.
produced_commit_rows() { # top rel head-before
  local top="$1" rel="$2" head="$3" after
  after=${4-}
  [ "$#" -ge 4 ] || after=$(git -C "$top" rev-parse --verify --quiet HEAD 2>/dev/null) || return 0
  [ -n "$after" ] && [ "$after" != "$head" ] || return 0
  {
    if [ -n "$head" ] && git -C "$top" merge-base --is-ancestor "$head" "$after" 2>/dev/null; then
      git -C "$top" log --raw -m --no-renames --no-abbrev --reverse -z --format=%H "$head..$after"
    else
      [ -n "$head" ] || head=$(git -C "$top" hash-object -w -t tree --stdin </dev/null)
      git -C "$top" diff --raw --no-renames --no-abbrev -z "$head" "$after" --
    fi
  } 2>/dev/null | tr '\0' '\n' |
    AWK_TOP=$top AWK_REL=$rel awk '
      BEGIN { top = ENVIRON["AWK_TOP"]; rel = ENVIRON["AWK_REL"] }
      !NF { next }
      pending != "" {
        path = $0
        if (rel != "") {
          if (index(path, rel "/") == 1) path = substr(path, length(rel) + 2)
          else path = top "/" path
        }
        split(pending, f, " ")
        prev = f[3]; cur = f[4]
        if (prev ~ /^0+$/) prev = "-"
        if (cur ~ /^0+$/) cur = "-"
        printf "%s\t%s\t%s\tcommit\n", prev, cur, path
        pending = ""
        next
      }
      /^:/ { pending = $0 }'
}

record_workdir_dirt() { # directory workdir
  local directory="$1" workdir="$2" top gained
  [ -z "$RUN_FILES_REASON" ] || return 0
  # A run answering to a chat records dirt for exactly what its own listing could not answer for:
  # the rest of its window is already that chat's by the listing, and a run whose listing is whole
  # leaves nothing here at all.
  if [ -s "$directory/launcher" ] && [ -z "${RUN_FILES_UNNAMED:-}" ]; then
    return 0
  fi
  top=$(git -C "$workdir" rev-parse --show-toplevel 2>/dev/null) || return 0
  gained=$(snapshot_changed_paths "$directory" "$top") || return 0
  if [ -s "$directory/launcher" ]; then
    gained=$(comm -23 <(sed '/^$/d' <<<"$gained" | sort -u) \
                      <(listing_top_paths "$directory" "$top" "$workdir"))
  fi
  [ -n "$gained" ] || [ -f "$directory/dirty" ] || return 0
  { printf 'WORKDIR: %s\n' "$top"; [ -z "$gained" ] || printf '%s\n' "$gained"; } \
    >"$directory/dirty.tmp.$$" 2>/dev/null &&
    mv -f "$directory/dirty.tmp.$$" "$directory/dirty" 2>/dev/null ||
    rm -f "$directory/dirty.tmp.$$" 2>/dev/null
  return 0
}

record_worker_session() {
  local directory="$1" session
  # Every vendor, not claudeb alone. grok loads this machine's hooks out of `~/.claude/settings.json`
  # for Claude compatibility and journals under its OWN session id, which read without this pairing
  # is a chat nothing on the machine answers for (live: grok sessions 01a0641b…/01a0647f… against
  # chat 35c155ac…, 2026-09-03). A codex or agy id reaching a journal is the same case one level
  # down — a nested relay, a review-bench call — and one that never reaches one costs a reader
  # nothing: this mapping is only ever consulted about an id some row already carries.
  session=$(session_id "$directory")
  # A resumed run's id is known before its first token — the session keeps the id it already had,
  # and every entry it journals while the run is LIVE carries that one. Read only where the run
  # has not answered with an id of its own yet, so a session that somehow moved still wins.
  [ "$session" != - ] || session=$(jq -r '.resume // empty' "$directory/meta.json" 2>/dev/null)
  # Never a guess: an id nothing named, or one no journal record could carry, leaves no file.
  case "$session" in
    ''|-|.|..|*[!A-Za-z0-9._-]*) return 0 ;;
  esac
  grep -qxF -- "$session" "$directory/worker-session" 2>/dev/null && return 0
  printf '%s\n' "$session" >>"$directory/worker-session" 2>/dev/null || :
  journal_worker_attempt "$directory" "$session"
  return 0
}

WORKER_ATTEMPTS_ROTATE_BYTES=16777216

file_bytes() { # path
  local bytes
  bytes=$(wc -c 2>/dev/null <"$1" | tr -d '[:space:]')
  printf '%s\n' "${bytes:-0}"
}

# tokenmap zones every worker session from this journal: the run directory is pruned after seven
# days and a wall reroute rewrites meta.account, so each attempt is written down while its facts
# still hold. Two segments of 16 MiB bound it; the rotation lock is re-checked inside because a
# second writer may have rotated between the size read and the mkdir, and a lock older than a
# minute is a killed rotation's, which would otherwise stop every later one.
journal_worker_attempt() { # directory session
  local directory="$1" journal
  journal="${WORKER_STATS_DIR:-${CLAUDEB_DIR:-$HOME/.claude-profiles/.claudeb}/worker-stats}/worker-attempts.jsonl"
  mkdir -p "${journal%/*}" 2>/dev/null || return 0
  if [ "$(file_bytes "$journal")" -gt "$WORKER_ATTEMPTS_ROTATE_BYTES" ] \
    && LLM_STORE_LOCK_RETRIES=1 store_lock_acquire "$journal.rotating"; then
    [ "$(file_bytes "$journal")" -le "$WORKER_ATTEMPTS_ROTATE_BYTES" ] || mv -f "$journal" "$journal.1" 2>/dev/null
    store_lock_release "$journal.rotating"
  fi
  jq -c --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg run "${directory##*/}" --arg session "$2" \
    --arg attempt "$(head -n1 "$directory/attempt" 2>/dev/null)" \
    --arg launcher "$(head -n1 "$directory/launcher" 2>/dev/null)" \
    --arg agent "$(head -n1 "$directory/agent-task" 2>/dev/null)" \
    '{ts: $ts, run: $run, attempt: (($attempt | tonumber?) // null), session: $session,
      vendor, account, role, light: (.light // null), model, workdir,
      launcher: (($launcher | select(. != "")) // null), agent: (($agent | select(. != "")) // null)}' \
    "$directory/meta.json" >>"$journal" 2>/dev/null || :
}

WORKER_RUNS_KEEP_DAYS=35

# Appends and the daily prune share one lock: a prune rewriting the file under an unlocked append
# would drop that row.
journal_worker_run() { # directory status exit-code
  local directory="$1" journal now row marker reason
  journal="${WORKER_STATS_DIR:-${CLAUDEB_DIR:-$HOME/.claude-profiles/.claudeb}/worker-stats}/runs.jsonl"
  printf -v now '%(%s)T' -1
  reason=$2
  case "$3" in 143|137) IFS=' ' read -r reason _ <"$directory/killed" 2>/dev/null || reason=$2 ;; esac
  meta_update "$directory" '.ended_at = $now
    | .terminal_reason = (if $reason == "failed" and $code == "4" and ((.cli_starts // []) | length) == 0
        then "no-start" else $reason end)' \
    --argjson now "$now" --arg reason "$reason" --arg code "$3" 2>/dev/null || return 0
  row=$(jq -c --arg run "${directory##*/}" --arg status "$2" --arg code "$3" \
    --arg launcher "$(head -n1 "$directory/launcher" 2>/dev/null)" \
    '{run: $run, vendor, account, role, model, effort, light: (.light // null), workdir,
      launcher: (($launcher | select(. != "")) // null), resume: ((.resume // "") != ""),
      round: (.review_round // null), pid_started_at: (.pid_started_at // null), started_at,
      cli_starts: (.cli_starts // []), attempt_secs: (.attempt_secs // []), attempt_rcs: (.attempt_rcs // []),
      walled: (.walled_accounts // []), ended_at, exit_code: (($code | tonumber?) // null), status: $status,
      reason: .terminal_reason, orphans: (.orphans_ended // [])}' "$directory/meta.json" 2>/dev/null) || return 0
  mkdir -p "${journal%/*}" 2>/dev/null || return 0
  LLM_STORE_LOCK_RETRIES=40 store_lock_acquire "$journal.lock" || return 0
  marker="$journal.pruned"
  if [ -s "$journal" ] && { [ ! -f "$marker" ] || [ -n "$(find "$marker" -mtime +1 2>/dev/null)" ]; }; then
    touch "$marker" 2>/dev/null
    jq -cR --argjson cut "$((now - WORKER_RUNS_KEEP_DAYS * 86400))" 'fromjson? | select((.ended_at // 0) >= $cut)' \
      "$journal" >"$journal.tmp.$$" 2>/dev/null && mv -f "$journal.tmp.$$" "$journal" || rm -f "$journal.tmp.$$"
  fi
  printf '%s\n' "$row" >>"$journal" 2>/dev/null
  store_lock_release "$journal.lock"
  return 0
}

# The task row the chat paints for this run reads this file, so every transition rewrites it whole.
write_run_state() { # directory phase [exit-code]
  local directory="$1" phase="$2" code="${3:-}" tag='' rest agent session tmp
  [ -d "$directory" ] || return 0
  agent=$(jq -r '.agent_task_id // empty' "$directory/state.json" 2>/dev/null) || agent=''
  [ -n "$agent" ] || agent=$(cat "$directory/agent-task" 2>/dev/null) || agent=''
  [ -n "$agent" ] || agent=${CLAUDE_AGENT_ID:-}
  IFS= read -r tag 2>/dev/null <"$directory/tag" || :
  rest=${tag#* · }
  session=$(cat "$directory/launcher" 2>/dev/null) || session=''
  tmp="$directory/state.json.tmp.$$"
  if jq -n --arg phase "$phase" --arg code "$code" --arg agent "$agent" \
    --arg session "$session" --arg account "${tag%% · *}" --arg model "${rest%% · *}" --arg effort "${rest##* · }" \
    --arg round_id "$(jq -r '.review_round // empty' "$directory/meta.json" 2>/dev/null)" \
    --arg started "$(jq -r '.pid_started_at // .started_at // empty' "$directory/meta.json" 2>/dev/null)" \
    'def opt: if . == "" then null else . end;
     {phase: $phase, exit_code: ($code | opt | if . == null then . else (tonumber? // .) end),
      agent_task_id: ($agent | opt), session: ($session | opt), account: ($account | opt),
      model: ($model | opt), effort: ($effort | opt), round_id: ($round_id | opt),
      started_epoch: ($started | opt | if . == null then . else (tonumber? // null) end),
      ts: (now | floor | todate)}' >"$tmp" 2>/dev/null; then
    mv -f "$tmp" "$directory/state.json" 2>/dev/null || rm -f "$tmp"
  else
    rm -f "$tmp"
  fi
}

# The agent whose task row shows this run: CLAUDE_AGENT_ID where the harness sets it, else the tag file
# worker-tag-hook marked `start=` for this very launch in the launching chat's tag cache. The claim
# swaps that mark for `run=<id>` and the tag for the one this launch resolved.
claim_agent_tag() { # directory launcher
  local dir="$HOME/.cache/claude-worker-tags/$2"
  [ -n "$2" ] && [ -d "$dir" ] || return 0
  with_agent_tag_lock "$dir" claim_agent_tag_locked "$1" "$dir"
}

# Every read of the chat's fresh `start=` marks runs under this lock: two launches of one chat that
# both read the newest `start=` before either swaps it claim ONE agent's row for two runs. A holder
# that died is outwaited.
with_agent_tag_lock() { # tag-dir command...
  local lock="$1/.claim.lock" waited=0 rc=0
  shift
  while ! mkdir "$lock" 2>/dev/null; do
    if [ "$waited" -ge 50 ]; then
      [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ] && rmdir "$lock" 2>/dev/null
      lock=''
      break
    fi
    sleep 0.1
    waited=$((waited + 1))
  done
  "$@" || rc=$?
  [ -z "$lock" ] || rmdir "$lock" 2>/dev/null || :
  return "$rc"
}

fresh_agent_tags() { # tag-dir — "mark<TAB>file", one per tag file marked `start=` in the last 120 s
  local file mark now
  now=$(date +%s)
  for file in "$1"/*; do
    case "${file##*/}" in pending-* | git-unlock-* | *.tmp.* | *.claim.*) continue ;; esac
    [ -f "$file" ] || continue
    mark=$(sed -n 's/^start=//p' "$file" 2>/dev/null | tail -n1)
    [[ "$mark" =~ ^[0-9]+$ ]] && [ $((now - mark)) -le 120 ] || continue
    printf '%s\t%s\n' "$mark" "$file"
  done
}

launch_agent_tag() { # tag-dir
  local dir="$1"
  if [ -n "${CLAUDE_AGENT_ID:-}" ] && [ -f "$dir/${CLAUDE_AGENT_ID//[^A-Za-z0-9_-]/}" ]; then
    printf '%s' "$dir/${CLAUDE_AGENT_ID//[^A-Za-z0-9_-]/}"
  else
    fresh_agent_tags "$dir" | sort -s -t $'\t' -k1,1nr | head -n1 | cut -f2- | tr -d '\n'
  fi
}

# The spawning Agent prompt's ROUND: header, which worker-spawn-hook seeds into the relay's tag file
# in the spawning chat's cache: a relay that rewrites the brief drops the header, never this.
spawn_review_round() {
  local session=${CLAUDE_CODE_SESSION_ID:-} dir
  case "$session" in ''|.|..|*[!A-Za-z0-9._-]*) return 0 ;; esac
  dir="$HOME/.cache/claude-worker-tags/$session"
  [ -d "$dir" ] || return 0
  with_agent_tag_lock "$dir" spawn_review_round_locked "$dir"
}

# The claim comes at the end of the launch, so without CLAUDE_AGENT_ID the newest `start=` may be a
# sibling relay's: a round is adopted only when every fresh tag file agrees on it.
spawn_review_round_locked() { # tag-dir
  local dir="$1" rounds
  if [ -n "${CLAUDE_AGENT_ID:-}" ] && [ -f "$dir/${CLAUDE_AGENT_ID//[^A-Za-z0-9_-]/}" ]; then
    sed -n 's/^round=//p' "$dir/${CLAUDE_AGENT_ID//[^A-Za-z0-9_-]/}" 2>/dev/null | tail -n1
    return 0
  fi
  rounds=$(fresh_agent_tags "$dir" | cut -f2- | while IFS= read -r file; do
    printf '%s\n' "$(sed -n 's/^round=//p' "$file" 2>/dev/null | tail -n1)"
  done | sort -u)
  [ "$(printf '%s\n' "$rounds" | wc -l)" -eq 1 ] || return 0
  printf '%s\n' "$rounds"
}

claim_agent_tag_locked() { # directory tag-dir
  local directory="$1" dir="$2" best tag tmp
  best=$(launch_agent_tag "$dir")
  [ -n "$best" ] || return 0
  printf '%s\n' "${best##*/}" >"$directory/agent-task" 2>/dev/null || :
  IFS= read -r tag 2>/dev/null <"$directory/tag" || IFS= read -r tag 2>/dev/null <"$best" || tag=''
  tmp="$best.tmp.$$"
  { printf '%s\n' "$tag"; tail -n +2 "$best" | grep -vE '^start=' | grep -vxF "run=${directory##*/}"; printf 'run=%s\n' "${directory##*/}"; } \
    >"$tmp" 2>/dev/null && mv -f "$tmp" "$best" 2>/dev/null || rm -f "$tmp" 2>/dev/null
}

allocate_run_directory() { # vendor — sets root, run_id, directory
  local allocate_vendor="$1" stamp mark attempts=0 prune_marker
  root="${WORKER_RUN_DIR:-$HOME/.cache/claude-worker-runs}"
  mkdir -p "$root" || fail "could not create run root: $root"
  root=$(cd "$root" && pwd -P) || fail "could not resolve run root: $root"
  prune_marker="$root/.prune"
  if [ ! -f "$prune_marker" ] || [ -n "$(find "$prune_marker" -mtime +1 2>/dev/null)" ]; then
    touch "$prune_marker" 2>/dev/null
    find "$root" -mindepth 1 -maxdepth 1 -type d ! -name browse -mtime +7 -exec rm -rf {} + 2>/dev/null
  fi
  stamp=$(date +%s)
  printf -v mark '%04x' "$RANDOM"
  run_id="$allocate_vendor-$stamp-$$-$mark"
  while :; do
    directory="$root/$run_id"
    mkdir "$directory" 2>/dev/null && break
    attempts=$((attempts + 1))
    printf -v mark '%04x' "$RANDOM"
    run_id="$allocate_vendor-$stamp-$$-$mark"
    [ "$attempts" -lt 50 ] || fail "could not create run directory under: $root"
  done
}

# One grep over the glob, in the glob's own order: that is the order the per-file loop stopped at.
refuse_live_matches() { # needle root filename
  local needle="$1" root="$2" name="$3" matches
  matches=$(grep -lxF -- "$needle" "$root"/*/"$name" 2>/dev/null) || true
  [ -n "$matches" ] || return 0
  printf '%s\n' "$matches"
}

refuse_live_run() { # brief resume
  local brief="$1" resume="$2" root entry directory pid now started sha other_sha owner
  root="${WORKER_RUN_DIR:-$HOME/.cache/claude-worker-runs}"
  if [ -n "$resume" ]; then
    while IFS= read -r entry; do
      [ -n "$entry" ] && [ -f "$entry" ] || continue
      directory=${entry%/worker-session}
      [ ! -e "$directory/exit_code" ] || continue
      pid=$(jq -r '.pid // 0' "$directory/meta.json" 2>/dev/null)
      supervisor_running "$directory" "$pid" || continue
      outcome_line "RESUME_BUSY ${directory##*/}"
      printf 'ATTACH %s\n' "${directory##*/}"
      exit 4
    done < <(refuse_live_matches "$resume" "$root" worker-session)
  fi
  [ "${WORKER_RUN_ALLOW_DUPLICATE:-0}" != 1 ] || return 0
  # The same owner start_run writes into `launcher`: inside a worker CLAUDE_CODE_SESSION_ID is the
  # worker's own chat and never matches, so a nested duplicate would slip through.
  owner=${CLAUDE_LAUNCHER_SESSION:-${CLAUDE_CODE_SESSION_ID:-}}
  [ -n "$owner" ] || return 0
  sha=$(shasum -a 256 "$brief" | awk '{print $1}')
  [ -n "$sha" ] || return 0
  now=$(date +%s)
  while IFS= read -r entry; do
    [ -n "$entry" ] && [ -f "$entry" ] || continue
    directory=${entry%/launcher}
    [ ! -e "$directory/exit_code" ] || continue
    started=$(jq -r '.pid_started_at // .started_at // 0' "$directory/meta.json" 2>/dev/null)
    [[ "$started" =~ ^[0-9]+$ ]] || continue
    [ "$started" -le "$now" ] && [ $((now - started)) -lt 1800 ] || continue
    pid=$(jq -r '.pid // 0' "$directory/meta.json" 2>/dev/null)
    supervisor_running "$directory" "$pid" || continue
    other_sha=$(shasum -a 256 "$directory/brief" 2>/dev/null | awk '{print $1}')
    [ "$sha" = "$other_sha" ] || continue
    outcome_line "DUPLICATE_RUN ${directory##*/}"
    printf 'ATTACH %s\n' "${directory##*/}"
    exit 4
  done < <(refuse_live_matches "$owner" "$root" launcher)
  return 0
}

start_run() {
  [ "$#" -ge 1 ] || usage
  local vendor="$1" brief='' workdir="$PWD" explicit_account='' model='' effort='' resume='' first_line='' review_round='' round_flag='' role='workers' research_timeout='' sandbox_exec=''
  local round_source='' spawn_round='' candidate='' rule=''
  local -a text_rounds=()
  local account pin config_model model_label agy_model='' gemini_family='' grok_turns='' root run_id='' directory=''
  local explicit_model='' explicit_effort='' light='' light_model='' model_class=workers fix_rule='' chat_fast=false fast_role='' model_id='' slug_account=''
  local light_offrow=false inbox_settings=''
  local started cli cmd_json add_dirs_json images_json pid supervisor_body value list_output list_rc launcher_session entry
  local web_search=false web_search_flag=false web_search_off_flag=false web_search_asked=''
  local web_search_state='' brief_cyrillic=''
  local chrome=false browser=false browser_json='' browser_preamble='' browser_device='' browser_account=''
  local browser_target='' browser_dia_profile='' computer=false computer_home=''
  local -a browse_args=()
  local -a add_dirs images command_meta command
  add_dirs=()
  images=()
  command_meta=()
  command=()
  shift
  case "$vendor" in claudeb|codex|gemini|grok|light) ;; *) usage ;; esac
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --brief) [ "$#" -ge 2 ] || usage; brief="$2"; shift 2 ;;
      --workdir) [ "$#" -ge 2 ] || usage; workdir="$2"; shift 2 ;;
      --account) [ "$#" -ge 2 ] || usage; explicit_account="$2"; shift 2 ;;
      --model) [ "$#" -ge 2 ] || usage; model="$2"; shift 2 ;;
      --effort) [ "$#" -ge 2 ] || usage; effort="$2"; shift 2 ;;
      --resume) [ "$#" -ge 2 ] || usage; resume="$2"; shift 2 ;;
      --add-dir) [ "$#" -ge 2 ] || usage; add_dirs+=("$2"); shift 2 ;;
      --image) [ "$#" -ge 2 ] || usage; images+=("$2"); shift 2 ;;
      --web-search) web_search_flag=true; shift ;;
      --no-web-search) web_search_off_flag=true; shift ;;
      --chrome) chrome=true; shift ;;
      --round) [ "$#" -ge 2 ] || usage; round_flag="$2"; shift 2 ;;
      --role) [ "$#" -ge 2 ] || usage; role="$2"; shift 2 ;;
      --research-timeout) [ "$#" -ge 2 ] || usage; research_timeout="$2"; shift 2 ;;
      --browser) browser=true; shift ;;
      --computer) computer=true; shift ;;
      --target)
        [ "$#" -ge 2 ] || usage
        browser_target="$2"
        case "$browser_target" in dia|chrome) ;; *) usage ;; esac
        shift 2
        ;;
      *) usage ;;
    esac
  done
  [ -n "$brief" ] || usage
  [ "$web_search_flag" = false ] || [ "$web_search_off_flag" = false ] ||
    fail '--web-search and --no-web-search ask for opposite states: pass one of them'
  [ "$role" = workers ] || [ "$role" = research ] || usage
  if [ "$role" = workers ]; then
    # A flag the relay rebuilt from the header must not outvote it: a relay that lost `--effort` to a
    # shell quoting slip launched a Fable `EFFORT: high` brief on the low default (2026-09-30).
    local header_key header_value header_flag
    for header_key in ACCOUNT MODEL EFFORT; do
      [ "$header_key" = ACCOUNT ] || [ "$vendor" != light ] || continue
      header_value=$(brief_line_value "$brief" "$header_key")
      case "$header_key" in
        ACCOUNT) header_flag=$explicit_account ;;
        MODEL) header_flag=$model ;;
        EFFORT) header_flag=$effort ;;
      esac
      [ -z "$header_value" ] || [ -z "$header_flag" ] || [ "$header_flag" = "$header_value" ] ||
        fail "--$(tr '[:upper:]' '[:lower:]' <<<"$header_key") $header_flag contradicts the brief header '$header_key: $header_value': drop the flag, worker-run reads the header itself. Nothing was launched and no account was spent."
    done
    [ -n "$explicit_account" ] || explicit_account=$(brief_line_value "$brief" ACCOUNT)
    [ -n "$model" ] || [ "$vendor" = light ] || model=$(brief_line_value "$brief" MODEL)
    [ -n "$effort" ] || [ "$vendor" = light ] || effort=$(brief_line_value "$brief" EFFORT)
    [ "$computer" = true ] || [ "$(brief_line_value "$brief" COMPUTER)" != yes ] || computer=true
    browser_dia_profile=$(head -n 400 "$brief" 2>/dev/null | grep -m1 -E '^DIA-PROFILE:' |
      sed -E 's/^DIA-PROFILE:[[:space:]]*//; s/[[:space:]]+$//')
    # A relay that dropped --resume launched a RESUME brief as a fresh session (2026-10-02).
    value=$(sed -n '1s/^RESUME \([^[:space:]:]\{1,\}\):.*/\1/p' "$brief" 2>/dev/null)
    [ -z "$value" ] || [ -z "$resume" ] || [ "$resume" = "$value" ] ||
      fail "--resume $resume contradicts the brief's first line 'RESUME $value:': drop the flag, worker-run reads the line itself. Nothing was launched and no account was spent."
    [ -n "$resume" ] || resume=$value
    while IFS= read -r value; do
      [[ "$value" = /* ]] && [ -d "$value" ] ||
        fail "the brief's 'ADD-DIR: $value' names no absolute directory: give each other repository the run writes as its own ADD-DIR: line. Nothing was launched and no account was spent."
      add_dirs+=("$value")
    done < <(brief_add_dirs "$brief")
  fi
  relay_start_door "$vendor" "$role"
  if worker_light_off; then
    if [ "$vendor" = light ]; then
      outcome_line LIGHT_OFF
      fail "Light is off (Egor's menu: LLM Limits -> Light), so there is no light leg: give the task to the regular worker worker-pick names. Nothing was launched and no account was spent."
    fi
  elif [ "$role" = research ]; then light=research
  elif [ "$vendor" = light ]; then light=edit
  fi
  if [ -n "$light" ]; then
    model_class=light
    if [ "$vendor" = light ] || [ "$(worker_light_vendor "$light" 2>/dev/null)" = "$vendor" ]; then
      if ! vendor=$(worker_light_vendor "$light") || ! light_model=$(worker_light_model "$light"); then
        outcome_line MODEL_REFUSED
        fail "the light_$light row in $CONFIG_FILE names no vendor/model of the table. Nothing was launched and no account was spent."
      fi
    fi
    # Off the row's vendor there is no light model to fall to, and the vendor's own default is a
    # STRONG model: a run that silently answered on it would be a light class in name only. The
    # refusal itself waits until the flag-shape checks below have had their say.
    [ -n "$light_model" ] || [ -n "$model" ] || light_offrow=true
    model=${model:-${light_model:-$(worker_model_default_model "$vendor")}}
    effort=${effort:-$(worker_model_default_effort "$vendor" "$model" light)}
    # A light edit is not the implementation leg `<vendor>_workers=off` closes, so it asks the
    # picker under its own role; research already travels as `research` a few lines below.
    [ "$light" != edit ] || export WORKER_RUN_ROLE=light
  fi
  if [ "$role" = research ]; then
    [ -z "$resume" ] && [ "$browser" = false ] && [ "$chrome" = false ] || fail 'research does not support resume or browser flags'
    [ -n "$research_timeout" ] || research_timeout=360m
    . "$SCRIPT_DIRECTORY/../share/light-research.sh"
    value=$(research_duration_seconds "$research_timeout") && [ "$value" -gt 0 ] || usage
    [ "$vendor" != gemini ] || sandbox_exec="${GEMINI_RESEARCH_SANDBOX_EXEC:-/usr/bin/sandbox-exec}"
    export WORKER_RUN_ROLE=research
  elif [ -n "$research_timeout" ]; then
    usage
  fi
  [ -r "$brief" ] || fail "brief is not readable: $brief"
  # The first line is the run's handle: the spawn gate and the relay agents read `RESUME <id>:` and
  # `ATTACH <id>:` off the top of it, and every reader that falls back to a prefix of the brief
  # matches nothing useful with a blank one.
  # `|| :` and not `|| first_line=''`: a file with no trailing newline fails the read and still
  # assigns every byte of its one line.
  IFS= read -r first_line <"$brief" || :
  case "$first_line" in
    *[![:space:]]*) ;;
    *) fail "brief starts with a blank line: $brief — the first line is the run's handle (RESUME/ATTACH) and what a reader identifies it by" ;;
  esac
  # The flag is `review-bench fix`'s own composition and outranks the header, which stays the
  # fallback for a brief a chat wrote by hand.
  if [ -n "$round_flag" ]; then
    review_round_ok "$round_flag" ||
      fail "--round names no review round on record: '$round_flag' — the shape is <review-bench run id YYYYMMDDTHHMMSSZ-<7 hex>> and $(review_bench_dir "$round_flag") must exist"
    review_round=$round_flag
    round_source=flag
  else
    review_round=$(brief_review_round "$brief") || exit 4
    [ -z "$review_round" ] || round_source=header
  fi
  spawn_round=$(spawn_review_round)
  if [ -n "$spawn_round" ] && [ -n "$review_round" ] && [ "$review_round" != "$spawn_round" ]; then
    fail "--round/ROUND: says '$review_round' but the Agent prompt that spawned this relay says 'ROUND: $spawn_round': launch with the prompt's ROUND: line, or have the orchestrator respawn with the right one"
  elif [ "$spawn_round" = none ] && [ -z "$review_round" ]; then
    review_round=none
  elif [ -n "$spawn_round" ] && [ -z "$review_round" ]; then
    review_round_ok "$spawn_round" ||
      fail "the Agent prompt that spawned this relay names no review round on record: 'ROUND: $spawn_round'"
    review_round=$spawn_round
    round_source=prompt
  fi
  if [ -z "$round_flag" ]; then
    if [ "$review_round" = none ]; then
      review_round=''
      round_source=''
    elif [ -z "$review_round" ] && [ "$role" = workers ]; then
      # Prose that names a round with a confirmed finding left is asked about, never bound: bound,
      # a read-only audit citing a run as evidence was handed that round's findings to fix. Unasked,
      # a hand-written fix brief lands its fixes as the next chat's debt.
      while IFS= read -r candidate; do
        review_round_ok "$candidate" || continue
        rule=$(review-bench fix "$candidate" --print 2>/dev/null) ||
          fail "review-bench fix $candidate --print failed: the brief names that round and a round whose open findings cannot be read cannot be fixed"
        [ -z "$rule" ] || text_rounds+=("$candidate")
      done < <(brief_text_rounds "$brief")
      [ "${#text_rounds[@]}" -eq 0 ] ||
        fail "brief names open review round(s) ${text_rounds[*]} but has no ROUND: line: add 'ROUND: <id>' when this run fixes that round, or 'ROUND: none' when it only cites it"
    fi
  fi
  [ -z "$review_round" ] || [ "$role" = workers ] ||
    fail "a research run fixes nothing: drop --round / the ROUND: line, or launch it as a worker"
  if [ -n "$review_round" ] && ! grep -Fq verdicts.jsonl "$brief"; then
    # Composed once at start: a relaunch or an ATTACH must hand the worker the same rule text.
    fix_rule=$(review-bench fix "$review_round" --print 2>/dev/null) ||
      fail "review-bench fix $review_round --print failed: a round-tagged brief without the verdicts.jsonl rule cannot launch"
  fi
  brief_cyrillic=$(cyrillic_share <"$brief") ||
    fail "the brief's language could not be measured ($CYRILLIC_SHARE): nothing was launched; fix the tool rather than skipping the check"
  ! cyrillic_over "$brief_cyrillic" ||
    fail "brief has Russian ($brief_cyrillic% Cyrillic): the reader is a model — write it in English; $("$CYRILLIC_SHARE" --allowed 2>/dev/null)"
  [ -d "$workdir" ] || fail "workdir is not a directory: $workdir"
  workdir=$(cd "$workdir" && pwd -P) || fail "could not resolve workdir: $workdir"
  [ "$role" != workers ] || [ "$workdir" != "$(cd "$HOME" && pwd -P)" ] ||
    fail "workdir is the home directory, where no run's files can be tracked: launch with --workdir <the repository the brief works in>, plus one 'ADD-DIR: <dir>' header line per other repository it writes; a run that writes no repository launches in a scratch directory. Nothing was launched and no account was spent."
  # Every repository of the round is the fixer's to write, and a write outside workdir and
  # --add-dir has no content baseline: the run's changes there read as escaped. A codex resume and
  # grok take no --add-dir, so they are granted none and fix one repository a run.
  if [ -n "$review_round" ] && [ "$vendor" != grok ] &&
    { [ "$vendor" != codex ] || [ -z "$resume" ]; }; then
    while IFS= read -r value; do
      [ -d "$value" ] && ! same_repository "$value" "$workdir" ${add_dirs[@]+"${add_dirs[@]}"} &&
        add_dirs+=("$value")
    done < <(jq -r '.repos[]? | objects | .repo // empty' "$(review_bench_dir "$review_round")/meta.json" 2>/dev/null)
  fi
  if [ "$light" != research ] && [ "$vendor" != grok ] && { [ "$vendor" != codex ] || [ -z "$resume" ]; }; then
    while IFS= read -r value; do
      [ -d "$value" ] && value=$(cd "$value" && pwd -P) && [ "$value" != "$workdir" ] || continue
      for entry in ${add_dirs[@]+"${add_dirs[@]}"}; do (cd "$entry" 2>/dev/null && pwd -P); done |
        grep -qxF -- "$value" || add_dirs+=("$value")
    done < <(brief_worktree_roots "$brief"; resumed_add_dirs "$resume")
    while IFS= read -r value; do
      [ -n "$(git_common_dir "$value")" ] && value=$(cd "$value" && pwd -P) &&
        ! same_repository "$value" "$workdir" ${add_dirs[@]+"${add_dirs[@]}"} && add_dirs+=("$value")
    done < <(resumed_add_dirs "$resume" .workdir)
  fi
  web_search_column "$vendor" on >/dev/null ||
    fail "share/web-search.sh has no row for $vendor: a launch with an unknown search state would take whichever one the CLI happens to stand in. Nothing was launched and no account was spent."
  [ "$role" != research ] || web_search=true
  value=$(web_search_brief_state "$brief") || fail "$value"
  case "$value" in
    on)
      [ "$web_search_off_flag" = false ] ||
        fail "--no-web-search and the brief's 'WEB: on' ask for opposite states: pass one of them. Nothing was launched and no account was spent."
      web_search=true; web_search_asked=on ;;
    off)
      [ "$web_search_flag" = false ] ||
        fail "--web-search and the brief's 'WEB: off' ask for opposite states: pass one of them. Nothing was launched and no account was spent."
      web_search=false; web_search_asked=off ;;
  esac
  if [ "$web_search_flag" = true ]; then web_search=true; web_search_asked=on; fi
  if [ "$web_search_off_flag" = true ]; then web_search=false; web_search_asked=off; fi
  if [ "$web_search" = true ] && [ "$(web_search_column "$vendor" on)" = '!' ]; then
    outcome_line MODEL_REFUSED
    fail "$vendor cannot search the web, and a run that answers such a brief from memory is worse than none: launch it on $(web_search_vendors on). Nothing was launched and no account was spent."
  fi
  # An unreachable OFF is refused the same way an unreachable ON is, and only when it was ASKED for:
  # the vendor's own default searching anyway is recorded as what the run got, but a caller who said
  # so would otherwise get live pages under a brief that ruled them out and learn it from nothing.
  if [ "$web_search_asked" = off ] && [ "$(web_search_column "$vendor" off)" = '!' ]; then
    outcome_line MODEL_REFUSED
    fail "$vendor has no switch that turns web search off — it searches whatever the brief says — so a run that must not rest on live pages launches on $(web_search_vendors off). Drop the ask to accept $vendor's own search-on default. Nothing was launched and no account was spent."
  fi
  # What the table can actually deliver, not what was asked: a vendor with no off switch searches
  # anyway, and meta.json is read by everything downstream as the state the answer may rest on.
  web_search_state=$(web_search_state "$vendor" "$web_search")
  case "$web_search_state" in on) web_search=true ;; *) web_search=false ;; esac
  case "$vendor" in
    claudeb)
      [ "${#images[@]}" -eq 0 ] || fail 'claudeb does not support --image'
      ;;
    codex)
      [ "$chrome" = false ] || fail 'only claudeb supports --chrome'
      [ -z "$resume" ] || [ "${#add_dirs[@]}" -eq 0 ] || fail 'codex resume does not support --add-dir'
      ;;
    gemini)
      [ "$chrome" = false ] || fail 'only claudeb supports --chrome'
      [ "${#images[@]}" -eq 0 ] || fail 'gemini does not support --image'
      # agy has no stdin mode — the brief travels on argv, and past the kernel's
      # per-argument ceiling execve fails with a bare E2BIG long after start.
      # 128 for the RUN-TOKEN line launch_attempt appends, whose run id is not known yet.
      [ "$(($(wc -c <"$brief" | tr -d '[:space:]') + ${#fix_rule} + ${#BRIEF_PREAMBLE} + 128))" -le 131072 ] || fail 'gemini takes the brief on argv; briefs over 128KB cannot launch — shorten it or use another vendor'
      ;;
    grok)
      [ "$chrome" = false ] || fail 'only claudeb supports --chrome'
      # `--cwd` is the whole of grok's directory grant (1.0.13 has no --add-dir), so research gets no
      # exemption here the way claudeb's read-only mode does: the extra trees would reach neither the
      # CLI nor the run, and the answer would be about repositories nobody read. No image either.
      [ "${#add_dirs[@]}" -eq 0 ] && [ "${#images[@]}" -eq 0 ] || fail 'grok does not support --add-dir or --image; a run over several repositories needs another vendor, or one run per repository'
      ;;
  esac
  if [ "$light_offrow" = true ]; then
    outcome_line MODEL_REFUSED
    fail "the light_$light row names $(worker_light_vendor "$light" 2>/dev/null || printf 'no vendor'), not $vendor: a $vendor light run with no --model falls to that vendor's strong default. Add \`--model <id>\` with one of $vendor's light ids ($(worker_model_allowed_list "$vendor" light 2>/dev/null || printf 'none — the vendor has no row')), or launch on the row's vendor. Nothing was launched and no account was spent."
  fi
  [ -z "$browser_target" ] || [ "$browser" = true ] || usage
  if [ "$computer" = true ]; then
    [ "$vendor" = codex ] || fail 'only codex drives the computer (Codex Computer Use): launch --computer on codex'
    [ "$browser" = false ] || fail '--computer and --browser drive different surfaces: pass one of them'
    [ -z "$light" ] && [ "$role" = workers ] || fail 'a Light or research run does not drive the computer: launch --computer as a codex worker'
    export WORKER_RUN_ROLE=computer
  fi
  if [ "$browser" = true ]; then
    case "$vendor" in
      claudeb) chrome=true ;;
      codex) ;;
      *) printf 'REASON: %s does not support --browser\n' "$vendor"; return 2 ;;
    esac
  fi
  refuse_cheap_model "$vendor" "$model" "$resume" "$model_class"
  explicit_effort=$effort
  if [ "$vendor" = codex ]; then
    config_model=$(codex_config_model)
    [ "$model" != default ] || model=$config_model
    explicit_model=$model
    model=${model:-$config_model}
  else
    model=${model:-$(config_value "${vendor}_model")}
    model=${model:-$(worker_model_default_model "$vendor")}
  fi
  # Fast is the chat pin's modifier and it is WORKERS ONLY (Egor): a research or light leg carries
  # the model its own row names, whatever this chat asked for.
  chat_fast=false
  if [ "$role" = workers ] && [ -z "$light" ] && worker_model_chat_fast "$vendor"; then
    chat_fast=true
  fi
  # One resolution for the slug a fast chat launches; the spawn hook labels its row through the
  # same helper, so the row and the run can never name different models.
  if [ "$vendor" = grok ]; then
    fast_role=$role
    [ -z "$light" ] || fast_role=light
    model=$(worker_model_grok_launch_model "$model" "$fast_role")
  fi
  effort=${effort:-$(config_value "${vendor}_effort")}
  effort=${effort:-$(worker_model_default_effort "$vendor" "$model" "$model_class")}
  # Gemini is raised, never refused: Egor's rule is high on every Gemini leg, and a brief asking for
  # less is asking for a cheaper model than the vendor has, not for a different run. A word the
  # table knows nothing of is still a typo and still refused below.
  if [ "$vendor" = gemini ] && [ "$effort" != high ]; then
    case "$effort" in
      low | medium | xhigh | max)
        printf 'gemini effort forced to high\n' >&2
        effort=high
        ;;
    esac
  fi
  if { [ "$vendor" != codex ] || [ -z "$resume" ] || [ -n "$explicit_effort" ]; } &&
     ! worker_model_effort_allowed "$vendor" "$model" "$effort" "$model_class"; then
    outcome_line EFFORT_REFUSED
    fail "$vendor model $model does not allow effort $effort; allowed efforts: $(worker_model_effort_list "$vendor" "$model" "$model_class"). Nothing was launched and no account was spent."
  fi
  if [ "$role" = workers ] && [ "$vendor/$model" != claudeb/fable ] && [ -n "${WORKER_RUN_RECORD:-}" ] &&
     [ "$(jq -r '.model // empty' "$WORKER_RUN_RECORD/meta.json" 2>/dev/null)" = fable ]; then
    outcome_line NESTED_MODEL_REFUSED
    fail "this run is nested in a Fable worker and would hand its brief to $vendor $model; Egor chose Fable for that brief, so do the work in this session. Nothing was launched and no account was spent."
  fi
  if [ "$vendor" = codex ]; then
    slug_account=$explicit_account
    model_id=$(worker_model_codex_slug "$model" "$slug_account") || model_id=''
    [ -n "$model_id" ] || [ -z "$slug_account" ] || refuse_codex_model "$model"
  fi
  [ -z "$resume" ] || [ -n "$explicit_account" ] || fail '--resume requires --account: sessions live inside one vendor profile, and worker-pick may route elsewhere'
  refuse_live_run "$brief" "$resume"
  # Paths are re-resolved by the detached supervisor after it cds to workdir, so
  # relative arguments valid here would dangle there — pin them to the caller's cwd.
  for value in "${!images[@]}"; do
    [ -r "${images[$value]}" ] || fail "image is not readable: ${images[$value]}"
    [[ "${images[$value]}" = /* ]] || images[$value]="$PWD/${images[$value]}"
  done
  for value in "${!add_dirs[@]}"; do
    [[ "${add_dirs[$value]}" = /* ]] || add_dirs[$value]="$PWD/${add_dirs[$value]}"
  done

  if [ "$browser" = true ]; then
    browse_args=(--vendor "$vendor" --target "${browser_target:-dia}" --json)
    [ -z "$explicit_account" ] || browse_args+=(--account "$explicit_account")
    [ -z "$browser_dia_profile" ] || browse_args+=(--dia-profile "$browser_dia_profile")
    browser_json=$(browse_run "${browse_args[@]}") || :
    if ! jq -e --arg vendor "$vendor" '.plan.vendor == $vendor' <<<"$browser_json" >/dev/null 2>&1; then
      jq -r '.reasons[] | "REASON: " + .' <<<"$browser_json"
      return 2
    fi
    browser_account=$(jq -r '.plan.account' <<<"$browser_json")
    # A codex plan carries no device, and the fallback the run records has to be the TARGET's own
    # browser: Dia's uuid written into a chrome run names a device that run never touches.
    browser_device=$(jq -r --arg target "${browser_target:-dia}" \
      '.plan.device // (if $target == "chrome" then .chrome_device.id else .dia_device.id end) // empty' <<<"$browser_json")
    browser_preamble=$(jq -r '.preamble_file' <<<"$browser_json")
    if [ "$vendor" = claudeb ] && [ -n "$explicit_account" ] && [ "$explicit_account" != "$browser_account" ]; then
      jq -r '.reasons[] | "REASON: " + .' <<<"$browser_json"
      printf 'REASON: claudeb/%s cannot see device %s; plan says %s\n' "$explicit_account" "$browser_device" "$browser_account"
      return 2
    fi
    jq -r '.reasons[] | "REASON: " + .' <<<"$browser_json" >&2
    explicit_account=${explicit_account:-$browser_account}
    browser_account=$explicit_account
  fi
  if [ "$computer" = true ]; then
    computer_home=$(browse_real_home)
    cua_repl_sync "$(browse_codex_config "$computer_home")"
    if [ "$CUA_REPL_STATUS" = broken ]; then
      printf 'REASON: codex computer use unavailable — cua_repl registration failed: %s\n' "$CUA_REPL_ERROR"
      return 2
    fi
    if [ "$(sky_ensure "$computer_home")" = absent ]; then
      printf 'REASON: codex computer use unavailable — SkyComputerUseService is not running and Codex Computer Use.app did not start it\n'
      return 2
    fi
  fi

  if [ -n "$explicit_account" ]; then
    account="$explicit_account"
  else
    pick_account_listing "$vendor" '' "$model"
    if [ "$PICKED_RC" -eq 0 ] && [ -n "$PICKED_ACCOUNT" ]; then
      account="$PICKED_ACCOUNT"
    elif [ "$PICKED_RC" -eq 3 ]; then
      if [ "$PICKED_POOL_EMPTY" = true ]; then
        outcome_line "$(vendor_name "$vendor")_UNAVAILABLE"
        fail "every $vendor account is out of the worker pool; ask Egor to put one back in or pin one"
      fi
      if [ "$PICKED_ROLE_OFF" = true ]; then
        outcome_line "$(vendor_name "$vendor")_UNAVAILABLE"
        fail "$vendor is switched off for workers; ask Egor to turn the role back on or name another vendor"
      fi
      if [ "$PICKED_NO_DATA" = true ]; then
        outcome_line "$(vendor_name "$vendor")_UNAVAILABLE"
        fail "worker-pick has no usage data for $vendor, so it can route to no account; name one with --account"
      fi
      # A wall behind the passed-over accounts is a quota to wait out, not a model to change.
      if [ -n "$PICKED_UNLISTED" ] && [ "$PICKED_WALLED" = false ]; then
        outcome_line MODEL_REFUSED
        fail "codex model $model: no selectable account lists it (passed over $PICKED_UNLISTED, whose catalogs lack it). Nothing was launched and no account was spent."
      fi
      outcome_line "$(vendor_name "$vendor")_USAGE_LIMIT"
      exit 3
    else
      pin=$(worker_model_pin_first "$vendor")
      if [ -n "$pin" ]; then
        account="$pin"
      elif [ "$vendor" = claudeb ]; then
        fail 'claudeb needs an explicit account or claudeb_profile pin when worker-pick is unavailable'
      elif [ "$vendor" = grok ]; then
        # `main` is the real ~/.grok and carries no login, so falling back to it would launch a run
        # that can only fail at authentication.
        outcome_line GROK_UNAVAILABLE
        fail 'grok has no account to fall back on: name one with --account, pin grok_profile, or bring worker-pick back'
      else
        account=main
      fi
    fi
  fi
  # The role switch walls the vendor exactly the way the pool walls an account: an explicit
  # --account, a resumed session or the pin fallback cannot get in under it; the vendor pin and the
  # chat's open=all are the overrides, because naming either is the deliberate "use this one anyway".
  if [ "$role" = workers ] && [ -z "$light" ] && [ "$computer" = false ] && [ "$(config_value "${vendor}_workers")" = off ] &&
     ! worker_model_pin_has "$vendor" "$account" && ! worker_model_chat_opens_all; then
    outcome_line "$(vendor_name "$vendor")_UNAVAILABLE"
    fail "$vendor is switched off for workers; ask Egor to turn the role back on or name another vendor"
  fi
  # The pool is a wall, not advice to the picker: an account Egor took out cannot carry a worker
  # even when the brief names it outright — only the vendor pin overrides. A picked account is
  # already in the pool, so this only ever fires on --account.
  if ! worker_pool_refuse_headless "$vendor" "$account" "$(worker_model_pin_csv < <(worker_model_pins "$vendor"))"; then
    outcome_line "$(vendor_name "$vendor")_UNAVAILABLE"
    exit 4
  fi
  case "$vendor:$account" in
    codex:main) ! codex_main_removed || fail 'codex account main has been removed' ;;
    gemini:main) ! gemini_main_removed || fail 'gemini account main has been removed' ;;
    gemini:*) [[ "$account" =~ ^[a-z0-9][a-z0-9-]*$ ]] || fail "invalid gemini account: $account" ;;
    grok:*) [[ "$account" =~ ^[a-z0-9][a-z0-9-]*$ ]] || fail "invalid grok account: $account" ;;
    *) [[ "$account" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || fail "invalid account: $account" ;;
  esac
  # The account's own Fast Mode is only known now; the chat's was applied above.
  if [ "$vendor" = grok ]; then
    value=$(worker_model_grok_launch_model "$model" "$fast_role" '' "$account")
    if [ "$value" != "$model" ] && ! worker_model_effort_allowed grok "$value" "$effort" "$model_class"; then
      outcome_line EFFORT_REFUSED
      fail "grok model $value (this account's Fast Mode) does not allow effort $effort; allowed efforts: $(worker_model_effort_list grok "$value" "$model_class"). Nothing was launched and no account was spent."
    fi
    model=$value
  fi
  if [ "$vendor" = codex ] && [ "$account" != "$slug_account" ]; then
    value=$(worker_model_codex_slug "$model" "$account") && [ -n "$value" ] && model_id=$value
    [ -n "$model_id" ] || refuse_codex_model "$model"
  fi
  warn_cold_resume "$vendor" "$account" "$resume" || :

  case "$vendor" in
    claudeb)
      cli="${WORKER_RUN_CLAUDEB:-$HOME/.local/bin/claudeb}"
      inbox_settings=$(inbox_hook_settings) || fail 'could not compose the inbox hook settings. Nothing was launched and no account was spent.'
      command_meta=("$cli" profile "$account" -p --model "$model" --effort "$effort" --output-format json --dangerously-skip-permissions --settings "$inbox_settings")
      while IFS= read -r value; do command_meta+=("$value"); done < <(web_search_args claudeb "$web_search_state")
      [ -z "$resume" ] || command_meta+=(--resume "$resume")
      [ "$chrome" = false ] || command_meta+=(--chrome)
      ;;
    codex)
      model_label=${model##*-}
      [[ "$model_label" =~ ^[A-Za-z0-9]+$ ]] || model_label=astra
      cli="${WORKER_RUN_CODEX:-codex}"
      if [ -n "$resume" ]; then
        # `exec resume` keeps the session's own model unless told otherwise, so
        # only an explicit request overrides it — config defaults must not.
        command=("$cli" exec resume "$resume")
        [ -z "$explicit_model" ] || command+=(-m "$model_id")
        [ -z "$explicit_effort" ] || command+=(-c "model_reasoning_effort=$explicit_effort")
      else
        command=("$cli" exec -C "$workdir" -m "$model_id" -c "model_reasoning_effort=$effort" --color never)
      fi
      [ "$role" != research ] || command+=(--sandbox read-only)
      for value in "${add_dirs[@]}"; do command+=(--add-dir "$value"); done
      for value in "${images[@]}"; do command+=(-i "$value"); done
      while IFS= read -r value; do command+=("$value"); done < <(web_search_args codex "$web_search_state")
      # The chat's own word outranks the account's standing switch for this run alone.
      fast_tier=false
      if [ "$chat_fast" = true ] || [ "$(codex_fast_tier "$account")" = fast ]; then fast_tier=true; fi
      while IFS= read -r value; do command+=("$value"); done < <(codex_tier_args "$account" "$model_id" "$fast_tier")
      command+=(-o OUT -)
      if [ "$account" = main ]; then command_meta=("${command[@]}"); else command_meta=(env "CODEX_HOME=$(codex_home "$account")" "${command[@]}"); fi
      ;;
    gemini)
      # The effort rides in the agy slug and never in an `--effort` flag (shared-invariants row h).
      [ "$effort" = high ] &&
        gemini_family=$(worker_model_gemini_families | awk -F'\t' -v slug="$model" '$2 == slug { print; exit }') &&
        [ -n "$gemini_family" ] || { outcome_line GEMINI_UNAVAILABLE; exit 4; }
      agy_model="$(cut -f3 <<<"$gemini_family")-$effort"
      cli="${WORKER_RUN_GEMINIB:-$HOME/.local/bin/geminib}"
      if [ "$account" != main ]; then
        list_output=$("$cli" list 2>/dev/null)
        list_rc=$?
        if [ "$list_rc" -ne 0 ] || ! grep -Eq "^${account}:" <<<"$list_output"; then
          outcome_line GEMINI_UNAVAILABLE
          exit 4
        fi
      fi
      command_meta=("$cli" profile "$account" --model "$agy_model" --add-dir "$HOME/.claude")
      for value in "${add_dirs[@]}"; do command_meta+=(--add-dir "$value"); done
      command_meta+=(--print-timeout 360m --dangerously-skip-permissions --log-file LOG)
      while IFS= read -r value; do command_meta+=("$value"); done < <(web_search_args gemini "$web_search_state")
      [ -z "$resume" ] || command_meta+=(--conversation "$resume")
      command_meta+=(--print BRIEF_TEXT)
      ;;
    grok)
      model_label=$(worker_model_grok_label "$model")
      # No turn cap unless one is asked for: an implementation brief is bounded by the wall-clock
      # deadline like every other vendor's, and a cap ends a run the vendor was still serving.
      grok_turns=${WORKER_RUN_GROK_MAX_TURNS:-}
      [[ "$grok_turns" =~ ^[0-9]+$ ]] && [ "$grok_turns" -gt 0 ] || grok_turns=''
      cli="${WORKER_RUN_GROKB:-$HOME/.local/bin/grokb}"
      command_meta=(env GROK_MEMORY=0 "$cli" profile "$account" --prompt-file BRIEF
        --output-format streaming-json --always-approve --cwd "$workdir"
        --no-subagents --reasoning-effort "$effort")
      [ -z "$grok_turns" ] || command_meta+=(--max-turns "$grok_turns")
      [ "$model" = auto ] || command_meta+=(-m "$model")
      [ -z "$resume" ] || command_meta+=(-r "$resume")
      while IFS= read -r value; do command_meta+=("$value"); done < <(web_search_args grok "$web_search_state")
      ;;
  esac

  allocate_run_directory "$vendor"
  cp "$brief" "$directory/brief" || fail 'could not copy brief'
  [ -z "$fix_rule" ] || printf '%s\n' "$fix_rule" >"$directory/fix-rule" || fail 'could not write the fix rule'
  [ "$vendor" != grok ] || [ "$role" != research ] ||
    printf '%s\n' "$GROK_RESEARCH_FENCE" >"$directory/research-fence" || fail 'could not write the research fence'
  [ "$vendor" != claudeb ] || [ "$role" = research ] ||
    printf '%s\n' "$CLAUDEB_EDIT_FENCE" >"$directory/edit-fence" || fail 'could not write the edit fence'
  if [ "$browser" = true ]; then
    cp "$browser_preamble" "$directory/browser-preamble" || fail 'could not copy browser preamble'
    rm -f "$browser_preamble"
  fi
  [ "$computer" = false ] || printf '%s\n' "$COMPUTER_PREAMBLE" >"$directory/computer-preamble" ||
    fail 'could not write the computer preamble'
  [ -z "$resume" ] || inbox_carry_resume "$directory" "$resume"
  # The recorded brief is the input, byte for byte — `worker-run report`, RESUME and ATTACH all
  # quote it back, and a preamble growing on every hop would be a brief nobody wrote. What the
  # vendor is handed is this second file, and only ever this one.
  launch_attempt "$directory" || fail 'could not compose the launched brief'
  : >"$directory/out"
  : >"$directory/err"
  [ "$vendor" != gemini ] || : >"$directory/log"
  for value in "${!command_meta[@]}"; do
    case "${command_meta[$value]}" in
      OUT) command_meta[$value]="$directory/out" ;;
      LOG) command_meta[$value]="$directory/log" ;;
      BRIEF) command_meta[$value]="$directory/brief.launch" ;;
      BRIEF_TEXT) command_meta[$value]=$(<"$directory/brief.launch") ;;
    esac
  done
  printf '%s · %s · %s\n' "$account" "${model_label:-$model}" "$effort" >"$directory/tag"
  cmd_json=$(jq -cn --args '$ARGS.positional' -- "${command_meta[@]}") || fail 'could not encode command metadata'
  add_dirs_json=$(jq -cn --args '$ARGS.positional' -- "${add_dirs[@]}") || fail 'could not encode add-dir metadata'
  images_json=$(jq -cn --args '$ARGS.positional' -- "${images[@]}") || fail 'could not encode image metadata'
  started=$(date +%s)
  jq -cn --arg vendor "$vendor" --arg account "$account" --arg model "$model" --arg effort "$effort" \
    --arg agy_model "$agy_model" --arg grok_turns "$grok_turns" --arg model_id "$model_id" \
    --arg workdir "$workdir" --arg resume "$resume" --arg cli "$cli" \
    --arg explicit_model "$explicit_model" --arg explicit_effort "$explicit_effort" --arg role "$role" --arg explicit_account "$explicit_account" \
    --arg research_timeout "$research_timeout" --arg sandbox_exec "$sandbox_exec" --arg review_round "$review_round" \
    --arg round_source "$round_source" \
    --argjson pid 0 --argjson started_at "$started" --argjson cmd "$cmd_json" \
    --argjson add_dirs "$add_dirs_json" --argjson images "$images_json" --argjson web_search "$web_search" \
    --argjson chrome "$chrome" --argjson browser "$browser" --argjson computer "$computer" --argjson chat_fast "$chat_fast" \
    --arg browser_device "$browser_device" --arg browser_account "$browser_account" --arg browser_target "${browser_target:-dia}" \
    --arg light "$light" --arg inbox_settings "$inbox_settings" \
    '{vendor:$vendor,account:$account,model:$model,effort:$effort,role:$role,research_timeout:$research_timeout,sandbox_exec:$sandbox_exec,workdir:$workdir,pid:$pid,cmd:$cmd,started_at:$started_at,resume:$resume,cli:$cli,add_dirs:$add_dirs,images:$images,web_search:$web_search,chrome:$chrome,browser:$browser,explicit_model:$explicit_model,explicit_effort:$explicit_effort}
     + {explicit_account:$explicit_account}
     + if $chat_fast then {fast:true} else {} end
     + if $computer then {computer:true} else {} end
     + if $light != "" then {light:$light} else {} end
     + if $inbox_settings != "" then {inbox_settings:$inbox_settings} else {} end
     + if $review_round != "" then {review_round:$review_round,round_source:$round_source} else {} end
     + if $browser then {browser_device:$browser_device,browser_account:$browser_account,browser_target:$browser_target} else {} end
     + if $vendor == "gemini" then {agy_model:$agy_model} else {} end
     + if $model_id != "" then {model_id:$model_id} else {} end
     + if $vendor == "grok" and $grok_turns != "" then {max_turns:($grok_turns | tonumber)} else {} end' >"$directory/meta.json" || fail 'could not write metadata'
  # Who this run answers to, written where a hook can find it without parsing anything: a worker a
  # chat spawned IS that chat (Egor, 2026-08-17), and the run is the only place that fact exists —
  # the report says who a worker is, never who asked for it, so ownership read off a report is
  # ownership assigned to whoever happened to read it. A file rather than a meta.json key because
  # the reader is a per-tool-call hook globbing hundreds of runs, and one grep is its whole budget.
  # And into the worker's own environment, under a name the harness does not overwrite: inside the
  # launched CLI `CLAUDE_CODE_SESSION_ID` is that process's OWN chat, so a report the worker
  # produces has no other way to name the chat it belongs to and lands in its own outbox. The
  # supervisor spawned below inherits this export, and `claudeb` passes the environment through
  # untouched.
  # Launched from inside a worker, CLAUDE_CODE_SESSION_ID is that worker's own chat, while the chat
  # that owns the whole chain — and whose tag cache the task rows read — arrives as the launcher.
  launcher_session=${CLAUDE_LAUNCHER_SESSION:-${CLAUDE_CODE_SESSION_ID:-}}
  case "$launcher_session" in
    ''|.|..|*[!A-Za-z0-9._-]*) ;;
    *)
      printf '%s\n' "$launcher_session" >"$directory/launcher"
      "$SCRIPT_DIRECTORY/statusline-place" add --session "$launcher_session" --kind worker-start \
        --path "$workdir" >/dev/null 2>&1 || :
      export CLAUDE_LAUNCHER_SESSION="$launcher_session"
      # The anchors store's own name for the same fact: every touch a hook inside this worker
      # records is the LAUNCHER's, whatever session id the vendor journals under.
      export CLAUDE_DEBT_OWNER="$launcher_session" ;;
  esac
  # The run's own directory, which a fixing worker writes its verdict rows into. Not
  # `WORKER_RUN_DIR`: that name is the store ROOT everywhere on this machine (claude-setup's
  # hooks, `share/chat_names.py`), and overwritten here every reader inside the worker would look
  # for run records under one run.
  export WORKER_RUN_RECORD="$directory" WORKER_RUN_ID="$run_id"

  supervisor_body='ticks=0
while [ ! -e "$2/.ready" ]; do
  ticks=$((ticks + 1))
  if [ "$ticks" -ge 6000 ]; then
    "$1" _deliver "$2" 4 >/dev/null 2>&1
    printf "4\n" >"$2/exit_code.tmp.$$"
    mv -f "$2/exit_code.tmp.$$" "$2/exit_code"
    exit 4
  fi
  sleep 0.01
done
rm -f "$2/.ready"
# Backgrounded and waited on, with the signal passed down: run in the foreground, this shell dies
# on a TERM without ever reaching the lines below, and the run it was supervising is left with no
# exit code and a vendor CLI still writing.
"$1" _supervise "$2" &
supervised=$!
trap "kill -TERM $supervised 2>/dev/null" TERM INT
wait "$supervised"
rc=$?
if [ "$rc" -gt 128 ]; then
  wait "$supervised" 2>/dev/null
  reaped=$?
  [ "$reaped" -eq 127 ] || rc=$reaped
fi
"$1" _deliver "$2" "$rc" >/dev/null 2>&1
printf "%s\n" "$rc" >"$2/exit_code.tmp.$$"
mv -f "$2/exit_code.tmp.$$" "$2/exit_code"
exit "$rc"'
  if command -v setsid >/dev/null 2>&1; then
    nohup setsid bash -c "$supervisor_body" _ "$SCRIPT_PATH" "$directory" </dev/null >/dev/null 2>&1 &
  elif command -v perl >/dev/null 2>&1; then
    nohup perl -MPOSIX -e 'defined POSIX::setsid() or die "setsid failed\n"; exec @ARGV; die "exec failed\n"' \
      bash -c "$supervisor_body" _ "$SCRIPT_PATH" "$directory" </dev/null >/dev/null 2>&1 &
  else
    fail 'setsid is unavailable'
  fi
  pid=$!
  # pid_started_at is the supervisor's launch instant and never restamped: started_at moves on
  # every walled reroute (run_overdue budgets one deadline per attempt), and a liveness check
  # comparing the pid's own age against a restamped clock reads a live rerouted run as dead.
  pid_began=$(date +%s)
  jq --argjson pid "$pid" --argjson began "$pid_began" '.pid = $pid | .pid_started_at = $began' \
    "$directory/meta.json" >"$directory/meta.json.tmp.$$" \
    && mv -f "$directory/meta.json.tmp.$$" "$directory/meta.json" || fail 'could not record supervisor pid'
  inbox_carry_commit "$directory"
  # A brief carrying a bench run's own `record` command is that run's triage, delegated: stamp the
  # bench with the supervisor's pid so the Stop gate nagging for an untriaged report stays quiet
  # while this worker lives — and asks again the moment it dies, which is the case the nag is for.
  # The launch instant stands beside the pid on that first line, and the reader compares it: the
  # number is reused within a day, and read alone it silences an untriaged run for as long as
  # whatever inherited it lives (shared-invariants row `ar`).
  # Written before .ready, since the supervisor waits on that file and the triage starts after it.
  delegated_state="${WORKER_STATS_DIR:-${CLAUDEB_DIR:-$HOME/.claude-profiles/.claudeb}/worker-stats}"
  grep -Eo 'review-bench[[:blank:]]+record[[:blank:]]+[0-9]{8}T[0-9]{6}Z-[0-9a-f]+(-[0-9]+)?' \
    "$directory/brief" 2>/dev/null | awk '{print $NF}' | sort -u |
    while IFS= read -r delegated_run; do
      [ -d "$delegated_state/benches/$delegated_run" ] || continue
      {
        printf '%s %s\n' "$pid" "$pid_began"
        [ ! -s "$directory/launcher" ] || cat "$directory/launcher"
      } >"$delegated_state/benches/$delegated_run/delegated" 2>/dev/null || :
    done
  # Before the run is readable and not only when it ends: a resumed session journals under an id
  # this launch already knows, and the gate that prices a live run's worker work reads this file.
  # The claim first: the resumed session's attempt line is journalled here, once, and names its agent.
  [ ! -s "$directory/launcher" ] || claim_agent_tag "$directory" "$(cat "$directory/launcher")"
  record_worker_session "$directory"
  write_run_state "$directory" start
  : >"$directory/.ready"
  # WEB: on the launch line, because the state the run really got is otherwise only in meta.json and
  # an orchestrator cannot tell a web-grounded answer from one written out of memory.
  printf 'RUN: %s\nTAG: %s · %s · %s\nWEB: %s\nDIR: %s\n' "$run_id" "$account" "${model_label:-$model}" "$effort" "$web_search_state" "$directory"
}

session_id() {
  local directory="$1" vendor session
  vendor=$(jq -r '.vendor' "$directory/meta.json")
  session=''
  case "$vendor" in
    claudeb)
      session=$(jq -r '.session_id // empty' "$directory/out" 2>/dev/null)
      # `out` exists only once the CLI exits, so a run the watchdog killed has none: without the
      # id the watchdog resolved while the run was alive, hours of work end with no SESSION: line
      # and nothing to RESUME (live: two runs killed on the old ceiling, 2026-09-02 and 09-04).
      [ -n "$session" ] || session=$(head -n1 "$directory/session" 2>/dev/null)
      ;;
    codex)
      # Live codex exec prints 'session id: <uuid>' to stderr, not stdout.
      session=$(grep -Ehio 'session[_ -]?id[[:space:]:=]+[A-Za-z0-9._-]+' "$directory/err" "$directory/out" 2>/dev/null | head -n1 | sed -E 's/.*[[:space:]:=]+//')
      ;;
    gemini)
      # Live agy v1.1.9 log shapes: 'Created conversation <id>' on a fresh run,
      # 'conversationID="<id>"' (non-empty) when resuming. The LAST one: a geminib capacity
      # relaunch appends a new conversation to the same log after the killed one.
      session=$(grep -Eo 'Created conversation [A-Za-z0-9._-]+|conversationID="[A-Za-z0-9._-]+"' "$directory/log" 2>/dev/null |
        tail -n1 | sed -E 's/^Created conversation //; s/^conversationID="([^"]*)"$/\1/')
      ;;
    grok) session=$(grok_end_field "$directory" '.sessionId // empty') ;;
  esac
  printf '%s' "${session:--}"
}

# Grok's PERSISTENT wall wording, and nothing else. The CLI folds capacity weather (429, 5xx,
# Retry-After) into the same internal `rate_limit` class as a real wall, so a bare "rate limit" here
# would report an exhausted plan every time xAI has a bad minute.
GROK_LIMIT_RE="hit the rate limit for your plan|hit the credit limit for your plan|subscription:free-usage-exhausted|run out of credits|you['’]ve reached your free Grok Build usage limit for now|(status|http)[^0-9]{0,12}402([^0-9]|$)|402 payment required"
GROK_AUTH_RE='not signed in|credentials were rejected|session has expired'
GROK_TRANSIENT_RE='(status|http)[^0-9]{0,12}(429|5[0-9][0-9])([^0-9]|$)|too many requests|gateway timeout|retry-after|service unavailable|overloaded'

# Where a grok failure states itself: stderr, plus the `error` events of the stream — the CLI puts a
# startup failure on stderr alone (the `-s` collision) and a mid-run one in an event on stdout. The
# agent's own answer text is left out on purpose: this repository's briefs discuss quotas and 429s.
grok_stream_errors() { # directory [bytes]
  if [ -n "${2:-}" ]; then tail -c "$2" "$1/out" 2>/dev/null; else cat "$1/out" 2>/dev/null; fi |
  jq -rR 'fromjson? | select(type == "object" and (.type == "error" or .type == "max_turns_reached"))
          | tostring' 2>/dev/null
}

grok_error_text() { # directory [bytes]
  if [ -n "${2:-}" ]; then tail -c "$2" "$1/err" 2>/dev/null; else cat "$1/err" 2>/dev/null; fi
  grok_stream_errors "$@"
}

# A turn cap the run hit is the vendor answering fine to the last turn. Read as GROK_UNAVAILABLE it
# joins capacity weather, and the relay reroutes a brief that will outrun the same cap wherever it
# lands next.
grok_max_turns_hit() { # directory
  grok_error_text "$1" | grep -q 'max_turns_reached'
}

# Grok refuses a NEW session under load by ending it before its first turn: the handshake events,
# then `end` with `stopReason: cancelled`, exit 0 and an empty stderr. Exit 0 alone reads as a
# finished run, so the orchestrator was handed an empty result as `STATUS: done` (live 2026-09-08,
# five runs across two accounts while their older sessions kept streaming). It is weather like a
# 503: no wall is recorded, no pin lapses, and the relay pauses and relaunches once. The FIRST
# event that is a turn or the end decides — a cancel after real work is an ordinary ending.
grok_cancelled_start() { # directory
  local first
  first=$(jq -rR 'fromjson? | select(type == "object") |
    if .type == "end" then "end:" + ((.stopReason // "") | ascii_downcase)
    elif .type == "text" or .type == "thought" or .type == "assistant" or
         ((.type // "") | startswith("tool_call")) then "turn"
    else empty end' "$1/out" 2>/dev/null | head -n1)
  case "$first" in end:cancelled | end:canceled) return 0 ;; esac
  return 1
}

# Which kind of not-a-wall a grok failure was, said where the relay reads its outcome: an expired
# login needs a human, capacity weather needs nothing but another attempt.
grok_reason_line() { # directory
  local text
  text=$(grok_error_text "$1")
  if grep -q 'max_turns_reached' <<<"$text"; then
    printf 'REASON: max-turns — the brief outran --max-turns (%s); the vendor answered fine, so relaunching it whole buys nothing\n' \
      "$(jq -r '.max_turns // "?"' "$1/meta.json" 2>/dev/null)"
  elif grep -Eiq "$GROK_AUTH_RE" <<<"$text"; then
    printf 'REASON: auth — the account needs a human login (grokb add <account>)\n'
  elif grep -Eiq "$GROK_TRANSIENT_RE" <<<"$text"; then
    printf 'REASON: transient — capacity weather, not a wall; the brief may be relaunched\n'
  fi
}

newest_mtime() { # files...
  local newest=0 m path
  for path in "$@"; do
    m=$(stat -f %m "$path" 2>/dev/null) || m=$(stat -c %Y "$path" 2>/dev/null) || continue
    [[ "$m" =~ ^[0-9]+$ ]] && [ "$m" -gt "$newest" ] && newest=$m
  done
  printf '%s\n' "$newest"
}

has_limit_signature() {
  local directory="$1" vendor="$2" bytes="${3:-}" pattern tail_lines=0 path
  local -a scan
  if [ "$vendor" = codex ] && codex_unsupported_model "$directory" "$bytes"; then return 1; fi
  if tail -c 4096 "$directory/err" 2>/dev/null |
     grep -Eq 'worker-pick: no selectable [a-z]+ account \([^)]*WALLED'; then return 0; fi
  # out holds the worker's ANSWER, which in this repo routinely discusses quotas
  # and 429s; vendor limit errors arrive on stderr (live-verified for agy and
  # codex). claudeb print mode can emit its limit error on stdout, so it keeps
  # both. The agy log mentions quota even on healthy runs — never scan it.
  case "$vendor" in
    # codex streams the whole session to stderr: the echoed brief plus every file
    # the worker reads. In this repo that text routinely carries "quota",
    # "usage_limit" and "CODEX_USAGE_LIMIT" (live-caught misverdicts), so bare
    # tokens cannot count and the scan sees only the tail, where the CLI's own
    # fatal error is.
    codex) pattern='hit your usage limit|usage limit (reached|exceeded)|usage_limit_reached|quota (exhausted|exceeded|reached)|rate limit (exceeded|reached)|too many requests|out of credits|402 Payment Required|deactivated_workspace'; scan=("$directory/err"); tail_lines=40 ;;
    claudeb) pattern='hit your session limit|hit your usage limit|usage limit|(^|[^0-9])429([^0-9]|$)'; scan=("$directory/out" "$directory/err") ;;
    gemini) pattern='RESOURCE_EXHAUSTED|Individual quota reached|credits balance is too low|usage limit|quota|rate.?limit|(^|[^0-9])429([^0-9]|$)'; scan=("$directory/err") ;;
    # grok states a failure in two places — stderr and the stream's own error events — so its text
    # is assembled rather than read from a file list.
    grok) grok_error_text "$directory" "$bytes" | grep -Eiq "$GROK_LIMIT_RE"; return ;;
  esac
  if [ -n "$bytes" ]; then
    for path in "${scan[@]}"; do
      if [ "$tail_lines" -gt 0 ]; then
        tail -c "$bytes" "$path" 2>/dev/null | tail -n "$tail_lines"
      else
        tail -c "$bytes" "$path" 2>/dev/null
      fi
    done | grep -Eiq "$pattern"
  elif [ "$tail_lines" -gt 0 ]; then
    tail -n "$tail_lines" "${scan[0]}" 2>/dev/null | grep -Eiq "$pattern"
  else
    grep -Eiq "$pattern" "${scan[@]}" 2>/dev/null
  fi
}

reroute_lines() {
  jq -r '. as $meta | ($meta.walled_accounts // []) | range(0; length) as $hop
         | "REROUTE: walled on \(.[$hop]) → continued on \(.[$hop + 1] // $meta.account)"' \
    "$1/meta.json" 2>/dev/null
}

# Which watchdog ended a run, where one did: a bare exit 143 reads as a vendor failure, and the two
# answers differ — an idle kill means the worker stopped writing and whatever it finished is on
# disk, the ceiling means it was still being served when the clock ran out. Signal exits only, so
# the marker a watchdog writes as it races a run finishing on its own cannot mislabel that run.
killed_line() { # directory code
  local reason
  case "$2" in 143|137) ;; *) return 0 ;; esac
  reason=$(head -n1 "$1/killed" 2>/dev/null) || return 0
  case "$reason" in
    'silent '*) printf 'KILLED: silent — no output in %ss\n' "${reason#silent }" ;;
    wall) printf 'KILLED: wall — vendor usage limit detected\n' ;;
    term) printf 'KILLED: signal TERM — the supervisor was signalled and stopped the vendor child with it\n' ;;
    'idle '*) printf 'KILLED: idle watchdog — nothing this run writes changed for %ss (WORKER_RUN_IDLE_S)\n' "${reason#idle }" ;;
    'deadline '*) printf 'KILLED: deadline — the %ss ceiling ended a run still being served (WORKER_RUN_DEADLINE)\n' "${reason#deadline }" ;;
    'signal '*) printf 'KILLED: signal %s — the supervisor was signalled and stopped the vendor child with it\n' "${reason#signal }" ;;
  esac
}

print_outcome() {
  local directory="$1" vendor="$2" code="$3" reset
  # Signature scan only on failure: results in this ecosystem routinely DISCUSS
  # quotas and 429s, so a clean exit whose text mentions them is not a limit.
  if [ "$vendor" = grok ] && grok_cancelled_start "$directory"; then
    outcome_line "GROK_CANCELLED ${directory##*/}" "$directory"
    printf 'REASON: cancelled — grok ended the session before its first turn; capacity weather, not a wall: pause and relaunch once\n'
    return 0
  fi
  if [ "$code" = 0 ]; then outcome_line DONE "$directory" >/dev/null; return 0; fi
  if [ "$(jq -r '.role // "workers"' "$directory/meta.json" 2>/dev/null)" = research ] && [ -s "$directory/research-outcome" ]; then
    outcome_line "$(cat "$directory/research-outcome")" "$directory"
    return 0
  fi
  killed_line "$directory" "$code"
  if has_limit_signature "$directory" "$vendor"; then
    outcome_line "$(vendor_name "$vendor")_USAGE_LIMIT" "$directory"
    # Worker agents relay these lines verbatim, so the wall's SCOPE lives here, not in agent prose.
    if [ "$vendor" = claudeb ] && jq -e '.browser == true' "$directory/meta.json" >/dev/null; then
      printf 'WALL: browser device stays on %s\n' "$(jq -r '.account' "$directory/meta.json")"
    elif [ -n "$(jq -r '.resume // empty' "$directory/meta.json" 2>/dev/null)" ]; then
      printf 'WALL: resumed session stays on %s\n' \
        "$(jq -r '.account' "$directory/meta.json" 2>/dev/null)"
    elif jq -e '(.walled_accounts // []) | length > 0' "$directory/meta.json" >/dev/null 2>&1; then
      printf 'WALL: reroute cap reached (walled: %s) — the work done so far stays in the workdir\n' \
        "$(jq -r '((.walled_accounts // []) + [.account]) | join(", ")' "$directory/meta.json" 2>/dev/null)"
    else
      printf 'WALL: pool exhausted (walled: %s)\n' \
        "$(jq -r '((.walled_accounts // []) + [.account]) | join(", ")' "$directory/meta.json" 2>/dev/null)"
    fi
    reset=$(worker_walls_extract_reset "$directory/out" "$directory/err")
    [ -z "$reset" ] || printf 'RESET: %s\n' "$reset"
  elif [ "$vendor" = grok ] && grok_max_turns_hit "$directory"; then
    outcome_line GROK_MAX_TURNS "$directory"
    grok_reason_line "$directory"
  else
    outcome_line "$(failure_outcome "$vendor")" "$directory"
    case "$vendor" in grok) grok_reason_line "$directory" ;; esac
  fi
}

# The allowlist below treats test entry points as read-only; unclassified shell programs are a floor.
SHELL_FLOOR_PARTIAL='the run also ran shell commands, whose edits no transcript records'

writes_through_shell() { # command-line
  python3 - "$1" <<'PY'
import re
import shlex
import sys

command = sys.argv[1]
# Empty is a poll (codex write_stdin chars:""), not an unclassified write.
if command == "":
    sys.exit(1)
if not command.strip() or any(token in command for token in ("$", "`", "\\", "<<")):
    sys.exit(0)
try:
    lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|<>\n()")
    lexer.whitespace = " \t\r"
    # shlex's comment reader consumes the newline that separates the next command.
    lexer.commenters = ""
    tokens = list(lexer)
except ValueError:
    sys.exit(0)

def readonly(words):
    if not words:
        return True
    name, *args = words
    if name in {"bash", "sh", "python3"}:
        return len(args) == 1 and ".." not in args[0].split("/") and re.fullmatch(r"(?:\./)?tests/[\w./-]+\.(?:sh|py)", args[0]) is not None
    if name == "git":
        return bool(args) and args[0] in {"diff", "status", "show", "log", "ls-files", "rev-parse"} and not any(
            arg.startswith(("--output", "--ext-diff", "--textconv")) for arg in args)
    if name == "sed":
        return len(args) >= 2 and args[0] == "-n" and re.fullmatch(r"[0-9]+(?:,[0-9]+)?p", args[1]) is not None and not any(arg.startswith("-") for arg in args[2:])
    if name in {"grep", "egrep", "fgrep", "rg"}:
        return not any(arg.startswith(("--pre", "--hostname-bin")) for arg in args)
    return name in {"cat", "head", "tail", "wc", "pwd", "ls", "stat", "readlink", "basename", "dirname", "echo", "printf", "true", "false", "test", "[", "cd"}

words = []
tokens = iter(tokens + [";"])
for token in tokens:
    if token in {">", ">>", ">&"}:
        target = next(tokens, "")
        if (token in {">", ">>"} and target == "/dev/null") or (token == ">&" and target in {"1", "2"}):
            if words and words[-1].isdigit():
                words.pop()
            continue
        sys.exit(0)
    if token in {";", "&&", "||", "|", "\n"}:
        if not readonly(words):
            sys.exit(0)
        words = []
    elif set(token) <= set(";&|<>()\n"):
        sys.exit(0)
    else:
        words.append(token)
sys.exit(1)
PY
  [ "$?" -ne 1 ]
}

resolve_tool_path() { # path workdir
  local value="$1" workdir="$2" part joined='' index
  local -a parts resolved
  if [[ "$value" != /* ]]; then
    [ -n "$workdir" ] && [ "$workdir" != null ] || { printf '%s\n' "$value"; return 0; }
    value="${workdir%/}/$value"
  fi
  IFS='/' read -ra parts <<<"${value#/}"
  for part in "${parts[@]}"; do
    case "$part" in
      ''|.) ;;
      ..)
        if [ "${#resolved[@]}" -gt 0 ]; then
          index=$((${#resolved[@]} - 1))
          unset "resolved[$index]"
        fi
        ;;
      *) resolved+=("$part") ;;
    esac
  done
  for part in "${resolved[@]}"; do joined+="/$part"; done
  printf '%s\n' "${joined:-/}"
}

classify_tool_rows() { # rows workdir
  local rows="$1" workdir="$2" line tag value paths='' places='' shell=false inside=0 outside='' dir=''
  local unexpanded_target_re='(^|/)(\$[A-Za-z_][A-Za-z0-9_]*|\$\{[A-Za-z_][A-Za-z0-9_]*\}|`[^`]+`)(/|$)'
  [ -z "$workdir" ] || [ "$workdir" = null ] || dir="${workdir%/}/"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    tag=${line:0:1}
    value=${line:2}
    case "$tag" in
      F)
        if [ -z "$value" ]; then
          [ -n "$RUN_FILES_REASON" ] ||
            RUN_FILES_REASON='the transcript records a write whose target it does not name'
          continue
        fi
        if [[ "$value" =~ $unexpanded_target_re ]]; then
          [ -n "$RUN_FILES_PARTIAL" ] ||
            RUN_FILES_PARTIAL="the run named a target the transcript cannot resolve: $value"
          continue
        fi
        value=$(resolve_tool_path "$value" "$workdir")
        paths+="$value"$'\n'
        places+="$value"$'\n'
        ;;
      C)
        [ -n "$value" ] || continue
        shell=true
        if writes_through_shell "$value"; then
          [ -n "$RUN_FILES_REASON" ] ||
            RUN_FILES_REASON='the run wrote through the shell, whose targets no transcript names'
        fi
        ;;
      D)
        [ -z "$value" ] || places+="$(resolve_tool_path "$value" "$workdir")"$'\n'
        ;;
      X)
        [ -n "$RUN_FILES_REASON" ] ||
          RUN_FILES_REASON="the transcript records a call whose file targets it does not name: $value"
        ;;
      T)
        [ -n "$RUN_FILES_REASON" ] ||
          RUN_FILES_REASON='the transcript records a mutating context with an unparseable timestamp'
        ;;
    esac
  done <<<"$rows"
  # Live-reproduced 2026-08-24: handed a workdir agy does not trust, agy worked in the first
  # --add-dir instead and said nothing — every path it touched was somewhere else entirely. Not
  # "a path outside the workdir", which is ordinary (a worker reads ~/.claude, writes /tmp): the
  # signal is that NOTHING it named is inside, which no run doing its actual job ever looks like.
  if [ -n "$dir" ] && [ -n "$places" ]; then
    while IFS= read -r value; do
      [ -n "$value" ] || continue
      case "$value" in
        "$dir"*|"${dir%/}") inside=$((inside + 1)) ;;
        *) [ -n "$outside" ] || outside="$value" ;;
      esac
    done <<<"$places"
    [ "$inside" -ne 0 ] || [ -z "$outside" ] || RUN_FILES_ESCAPE="$outside"
  fi
  [ -z "$RUN_FILES_REASON" ] || return 0
  RUN_FILES_LIST=$(AWK_DIR=$dir awk \
    'BEGIN { dir = ENVIRON["AWK_DIR"] }
     { if (dir != "" && index($0, dir) == 1) $0 = substr($0, length(dir) + 1) } NF' \
    <<<"$paths" | sort -u)
  # First reason wins, like RUN_FILES_REASON: one PARTIAL line carries the caveat, and the named
  # unresolvable target says more than the generic shell floor beside it.
  [ "$shell" = false ] || [ -n "$RUN_FILES_PARTIAL" ] || RUN_FILES_PARTIAL="$SHELL_FLOOR_PARTIAL"
  return 0
}

# agy's own per-conversation log, the only place it names the files it wrote. `transcript.jsonl`
# beside it carries the same rows with the tool_call ARGUMENTS stripped, so it can never answer
# this question — read the `_full` one or nothing.
gemini_tool_rows() { # transcript since
  jq -rs --argjson since "$2" '
    def epoch(value):
      try ((value | tostring | sub("\\.[0-9]+(?=Z$)"; "")) | fromdateiso8601) catch null;
    def write_tool: test("^(write_to_file|replace_file_content|multi_replace_file_content)$");
    def read_tool: test("^(view_file|list_dir|find_by_name|grep_search|search_web|read_url_content|manage_task|schedule|send_message|ask_question|list_permissions)$");
    def succeeded: tostring | ascii_upcase | test("^(DONE|SUCCESS|SUCCEEDED)$");
    def failed: tostring | ascii_upcase | test("^(FAILED|FAILURE|ERROR|CANCELLED|CANCELED|REJECTED)$");
    . as $rows
    | to_entries[]
    | .key as $index
    | .value as $row
    | ($rows[$index + 1] // {}) as $execution
    | epoch($row.created_at? // "") as $t
    | [$row.tool_calls[]?
        | (.name? // "") as $name
        | (.args? // {}) as $args
        | if ($name | write_tool) then
            if ($execution.type? == "CODE_ACTION" and ($execution.status? | succeeded)) then
              "F\t" + (($args.TargetFile? // "") | tostring)
            elif ($execution.type? == "CODE_ACTION" and ($execution.status? | failed)) then empty
            else "X\t" + $name + " outcome" end
          elif $name == "run_command" then
            ("C\t" + (($args.CommandLine? // "") | tostring | gsub("[\n\r\t]"; " "))),
            ("D\t" + (($args.Cwd? // "") | tostring))
          elif ($name | read_tool) then empty
          else "X\t" + $name
          end
      ] as $classified
    | if $t == null then
        if ($classified | length) > 0 then "T\tunparseable" else empty end
      elif $t < $since then empty
      else $classified[]
      end' "$1" 2>/dev/null
}

# codex names its edits twice over and neither alone is complete: the `patch_apply_end` event holds
# the changed paths of a patch that applied, and the call itself holds the patch TEXT, whose
# `*** ... File:` headers name targets for the runs whose events are missing (both gaps live-measured
# over the local rollout corpus). The union is what the run answers with. Its shell arrives as JSON
# inside the harness call — one `"cmd"` field per command, whatever wrapper carries it — and the JS
# `exec` tool is a dispatcher, so what it dispatched TO is the tool that must be classified.
codex_tool_rows() { # rollout since
  jq -rs --argjson since "$2" '
    def epoch(value):
      try ((value | tostring | sub("\\.[0-9]+(?=Z$)"; "")) | fromdateiso8601) catch null;
    def targets(text):
      ([text | scan("\\*\\*\\* (?:Update|Add|Delete) File: [^\"\\\\\r\n]+")
             | sub("^\\*\\*\\* (?:Update|Add|Delete) File: "; "")]
       + [text | scan("\\*\\*\\* Move to: [^\"\\\\\r\n]+")
              | sub("^\\*\\*\\* Move to: "; "")])
      | map(gsub("\\r$"; ""));
    def js_mask:
      gsub("(?<m>\"(?:\\\\.|[^\"\\\\])*\"|\\x27(?:\\\\.|[^\\x27\\\\])*\\x27|`(?:\\\\.|[^`\\\\])*`|//[^\\r\\n]*|/\\*(?:[^*]|\\*+[^*/])*\\*+/)"; " " * (.m | length));
    def exec_tools(text):
      [text | js_mask | scan("\\btools\\.[A-Za-z_][A-Za-z_0-9]*\\s*\\(")
            | sub("^tools\\."; "") | sub("\\s*\\($"; "")];
    def js_literal(text; pos):
      (text[pos:] | sub("^\\s+"; "")) as $rest
      | ($rest[0:1]) as $quote
      | (if $quote == "`" then "`(?:\\\\.|[^`\\\\])*`"
         elif $quote == "\u0027" then "\\x27(?:\\\\.|[^\\x27\\\\])*\\x27"
         elif $quote == "\"" then "\"(?:\\\\.|[^\"\\\\])*\""
         else null end) as $shape
      | if $shape == null then null
        else ([$rest | match("^" + $shape)] | first | .string) as $literal
          | if $literal == null or ($quote == "`" and ($literal | test("\\$\\{"))) then null
            else $literal[1:-1] end
        end;
    # One state per call, in source order, so a value never pairs with another call. js_mask keeps the
    # masked text the same LENGTH as the raw text, so every offset below indexes both: a match found
    # in the mask (where no string or comment can fake one) reads its value out of the raw text.
    def key_states(text; tools; key):
      (text | js_mask) as $mask
      | [$mask | match("\\b(?:const|let|var)\\s+" + key + "\\s*="; "g")
             | (.offset + .length) as $at
             | {at: $at, value: js_literal(text; $at)}] as $bindings
      | [$mask | match("\\btools\\.(?:" + tools + ")\\s*\\(\\s*\\{[^{}]*\\}"; "g")
             | {start: .offset, end: (.offset + .length)}]
      | map(. as $call
          | [text[$call.start:$call.end]
             | match("(?:\"" + key + "\"|\\b" + key + "\\b)\\s*(?<colon>:)\\s*"; "g")
             | select($mask[($call.start + .captures[0].offset):($call.start + .captures[0].offset + 1)] == ":")
             | ($call.start + .offset + .length)] as $explicit
          | if ($explicit | length) > 0 then
              ([$explicit[] | js_literal(text; .)] | map(select(. != null))) as $values
              | if ($values | length) > 0 then {state: "value", value: $values[0]}
                else {state: "unresolved"} end
            elif ($mask[$call.start:$call.end] | test("(?:\\{|,)\\s*" + key + "\\s*(?:,|\\})")) then
              ([$bindings[] | select(.at < $call.start)] | last) as $binding
              | if ($binding.value? // null) == null then {state: "unresolved"}
                else {state: "value", value: $binding.value} end
            else {state: "absent"} end);
    def result_for(rows; payload):
      [rows[] | .payload? // {}
       | select((.type? == "custom_tool_call_output" or .type? == "function_call_output")
                and (.call_id? // "") != "" and .call_id? == (payload.call_id? // ""))] | last? // {};
    def result_state(result):
      (result.output? // result.result? // "" | tostring) as $output
      | if result.success? == true then "success"
        elif result.success? == false then "failed"
        elif ($output | test("Script failed|apply_patch verification failed|\\\"exit_code\\\"\\s*:\\s*[1-9]"; "i")) then "failed"
        elif ($output | test("Script completed|Success\\.|Done!|\\\"exit_code\\\"\\s*:\\s*0"; "i")) then "success"
        else "unknown"
        end;
    def direct_args(blob): try (blob | fromjson | select(type == "object")) catch null;
    . as $rows
    | to_entries[]
    | .key as $index
    | .value as $row
    | ($row.payload? // {}) as $payload
    | ($rows[$index + 1].payload? // {}) as $next
    | epoch($row.timestamp? // "") as $t
    | [if ($payload.type? == "patch_apply_end") then
         if ($payload.success? == true) then
           (($payload.changes? // {}) | to_entries | .[]
            | ("F\t" + .key), ("F\t" + (.value.move_path? | select(type == "string" and . != ""))))
         else empty end
       elif ($payload.type? == "custom_tool_call" or $payload.type? == "function_call") then
         (($payload.input? // $payload.arguments? // "") | tostring) as $blob
         | (if ($payload.name? == "exec") then
              (exec_tools($blob) | if length == 0 then ["exec (naming no tool)"] else . end)
            else [($payload.name? // "")] end)
         | .[] as $name
         | if $name == "apply_patch" then
              (if ($next.type? == "patch_apply_end") then
                (if $next.success? == true then "success" else "failed" end)
              else result_state(result_for($rows; $payload)) end) as $state
             | if $state == "success" then (targets($blob) | .[] | "F\t" + .)
               elif $state == "failed" then empty
               else "X\tapply_patch outcome" end
           elif ($name | test("^(exec_command|run|shell)$")) then
             if $payload.name? == "exec" then
               key_states($blob; "exec_command|run|shell"; "cmd") as $commands
               | key_states($blob; "exec_command|run|shell"; "workdir") as $directories
               | (exec_tools($blob) | map(select(test("^(exec_command|run|shell)$"))) | length) as $calls
               | if ($commands | length) != $calls or any($commands[]; .state != "value")
                    or any($directories[]; .state == "unresolved") then
                   "X\t" + $name + " arguments"
                 else ($commands[] | .value | "C\t" + gsub("[\n\r\t]"; " ")),
                      ($directories[] | select(.state == "value") | .value | "D\t" + .)
                 end
             else (direct_args($blob)) as $args
               | if $args == null or ($args.cmd? | type) != "string" then "X\t" + $name + " arguments"
                 else ("C\t" + ($args.cmd | gsub("[\n\r\t]"; " "))),
                      (if ($args.workdir? | type) == "string" then "D\t" + $args.workdir else empty end)
                 end
             end
           elif $name == "write_stdin" then
             if $payload.name? == "exec" then
               key_states($blob; "write_stdin"; "chars") as $commands
               | (exec_tools($blob) | map(select(. == "write_stdin")) | length) as $calls
               | if ($commands | length) != $calls or any($commands[]; .state != "value") then
                   "X\twrite_stdin arguments"
                 else ($commands[] | .value | "C\t" + gsub("[\n\r\t]"; " ")) end
             else (direct_args($blob)) as $args
               | if $args == null or ($args.chars? | type) != "string" then "X\twrite_stdin arguments"
                 else "C\t" + ($args.chars | gsub("[\n\r\t]"; " ")) end
             end
           elif ($name | test("^(view_image|update_plan|wait|web_search|web__run|tool_search|get_goal|update_goal|create_goal|get_app_state|list_apps|getTabContext|request_user_input)$")) then
             empty
           else "X\t" + $name end
       elif ($payload.type? == "mcp_tool_call_end") then
         "X\t" + (($payload.invocation?.tool? // "mcp tool") | tostring)
       else empty end] as $classified
    | if $t == null then
        if ($classified | length) > 0 then "T\tunparseable" else empty end
      elif $t < $since then empty
      else $classified[]
      end' "$1" 2>/dev/null
}

# Grok's own per-session record. One update line per event, so a call's identity is spread across
# them: the `tool_call` names the tool and carries its arguments, and the `tool_call_update` lines
# that follow carry the terminal status and the directory a shell command actually ran in — folded
# back together by toolCallId here. The tool's own `x.ai/tool` metadata classifies it (`kind`,
# `read_only`), never a name whitelist: a tool added by an update reads as unknown and leaves the
# run UNKNOWN, which is the answer a reader can act on. Lines are parsed individually so the
# partial last line of a live session does not void the whole read.
grok_tool_rows() { # updates since
  jq -rRs --argjson since "$2" '
    [split("\n")[] | select(length > 0) | fromjson? | select(type == "object")] as $all
    | reduce $all[] as $row ({};
        ($row.params.update // {}) as $update
        | ($update._meta["x.ai/tool"] // {}) as $tool
        | ($update.toolCallId // "") as $id
        | if $id == "" then .
          else .[$id] = ((.[$id] // {})
            + (if $update.sessionUpdate == "tool_call" or ((.[$id].name // "") == "" and ($tool.name // "") != "") then
                 {name: ($tool.name // ""), kind: ($tool.kind // ""),
                  read_only: ($tool.read_only // false), input: ($update.rawInput // {})}
               else {} end)
            + (if (.[$id].t // null) == null then {t: ($row.timestamp // null)} else {} end)
            + (if ($update.status // null) != null then {status: ($update.status | tostring | ascii_downcase)} else {} end)
            + (if (($update.rawOutput // {}).current_dir // "") != "" then {dir: $update.rawOutput.current_dir} else {} end))
          end)
    | to_entries[]
    | .value as $call
    | ($call.name // "") as $name
    | ($call.kind // "") as $kind
    | ($call.status // "") as $status
    | ($call.input // {}) as $args
    | ($call.t) as $t
    | [if $call.read_only == true or $name == "search_tool" or $kind == "plan" then empty
       elif ($kind | IN("write", "edit")) then
         if $status == "completed" then
           "F\t" + (($args.file_path // $args.path // $args.absolute_path // "") | tostring)
         elif ($status | IN("failed", "cancelled", "canceled", "rejected", "error")) then empty
         else "X\t" + $name + " outcome" end
       elif $kind == "execute" then
         ("C\t" + (($args.command // "") | tostring | gsub("[\n\r\t]"; " "))),
         (if ($call.dir // "") != "" then "D\t" + $call.dir else empty end)
       elif $name == "use_tool" then
         (($args.tool_name // "") | tostring | ascii_downcase) as $dispatched
         | if ($dispatched | IN("bash", "run_terminal_command", "shell")) then
             ("C\t" + ((($args.tool_input // {}).command // "") | tostring | gsub("[\n\r\t]"; " "))),
             (if ($call.dir // "") != "" then "D\t" + $call.dir else empty end)
           else "X\tuse_tool " + $dispatched end
       else "X\t" + (if $name == "" then "unnamed tool" else $name end) end] as $classified
    | if $t == null then
        if ($classified | length) > 0 then "T\tunparseable" else empty end
      elif $t < $since then empty
      else $classified[]
      end' "$1" 2>/dev/null
}

transcript_files() {
  # Only the file-writing tool calls, read by recursive descent so a wrapper key around the message
  # (assistant turn, sidechain entry) does not hide the call. NotebookEdit names its target
  # notebook_path; every other editor names file_path. A call whose tool_result came back is_error
  # changed nothing — a denied or failed edit listed as this run's work is a file it never touched.
  # Nonzero says UNREADABLE, never empty: jq's own status is what the caller needs, so the passes
  # are separate assignments rather than one pipeline whose status belongs to `sort`.
  #
  # `since` is the run's own start: a --resume run APPENDS to the session's existing transcript, so
  # the file also holds the calls of the runs before it, and listing those as this run's work is the
  # shared-checkout mistake one directory in. Each LINE carries its own timestamp and governs its own
  # calls, so the cut is a per-line select ahead of the descent, not a filter on the paths it yields.
  # `fromdateiso8601` refuses the milliseconds every real transcript writes, hence the sub() — parsed
  # without it, every line reads as epoch 0 and a resumed run reports nothing at all.
  local transcript="$1" workdir="$2" since="${3:-0}" failed paths
  [[ "$since" =~ ^[0-9]+$ ]] || since=0
  failed=$(jq -r '.. | objects
           | select((.type? == "tool_result") and (.is_error? == true))
           | (.tool_use_id? // empty)' "$transcript" 2>/dev/null) || return 1
  paths=$(jq -r --arg failed "$failed" --argjson since "$since" '
           ($failed | split("\n") | map(select(length > 0))) as $bad
           | select(((((.timestamp? // "") | tostring | sub("\\.[0-9]+"; ""))
                      | fromdateiso8601? // 0)) >= $since)
           | .. | objects
           | select((.type? == "tool_use") and ((.name? // "") | test("^(Write|Edit|MultiEdit|NotebookEdit)$")))
           | select((.id? // "") as $id | ($bad | index($id)) == null)
           | (.input.file_path? // .input.notebook_path? // empty)' "$transcript" 2>/dev/null) || return 1
  # Piped, never a here-string: bash writes a short one whole into a pipe only it reads, and a
  # transcript's path list past the 16K buffer a macOS pipe was left at blocked that write forever
  # (live 2026-10-04: four watchdog chains outlived their runs by 31 h).
  printf '%s\n' "$paths" | listing_spelling "$workdir"
}

listing_spelling() { # workdir; paths on stdin
  local workdir="$1" path dir=''
  # A trailing slash makes the prefix double-slashed and silently stops matching; an absent workdir
  # would strip the leading `/` off every absolute path, so it strips nothing at all.
  [ -z "$workdir" ] || [ "$workdir" = null ] || dir="${workdir%/}/"
  while IFS= read -r path; do
    [ -z "$path" ] || resolve_tool_path "$path" "$workdir"
  done | AWK_DIR=$dir awk \
    'BEGIN { dir = ENVIRON["AWK_DIR"] }
     { if (dir != "" && index($0, dir) == 1) $0 = substr($0, length(dir) + 1) } NF' \
    | sort -u
}

# The shell writes worker-edit-guard recorded instead of refusing, spelled as the Edit/Write rows
# are so they fold through the same snapshot intersection. The hook spells them against the PHYSICAL
# top, and a directory it recorded (`cp -R`) answers for the snapshot rows under it.
shell_write_rows() { # directory workdir snapshot
  local physical
  [ -s "$1/shell-writes" ] || return 0
  physical=$(cd "$2" 2>/dev/null && pwd -P) || physical=${2%/}
  AWK_FROM=${physical%/}/ AWK_TO=${2%/}/ awk \
    'BEGIN { from = ENVIRON["AWK_FROM"]; to = ENVIRON["AWK_TO"] }
     { if (from != to && index($0, from) == 1) $0 = to substr($0, length(from) + 1); print }' \
    "$1/shell-writes" | listing_spelling "$2" |
    AWK_TOP=${2%/} AWK_PTOP=${physical%/} awk 'NR == FNR { if ($0 != "") snap[++n] = $0; next }
      $0 == ENVIRON["AWK_TOP"] || $0 == ENVIRON["AWK_PTOP"] { for (i = 1; i <= n; i++) print snap[i]; next }
      { print; for (i = 1; i <= n; i++) if (index(snap[i], $0 "/") == 1) print snap[i] }' <(printf '%s\n' "$3") - |
    sort -u
}

compute_transcript_files() {
  local directory="$1" vendor account workdir session transcript started rows
  RUN_FILES_LIST=''
  RUN_FILES_REASON=''
  RUN_FILES_PARTIAL=''
  RUN_FILES_ESCAPE=''
  RUN_SHELL_COMMANDS=''
  {
    IFS= read -r vendor || true
    IFS= read -r account || true
    IFS= read -r workdir || true
    IFS= read -r started || true
  } < <(jq -r '.vendor, .account, .workdir, (.started_at // 0)' "$directory/meta.json" 2>/dev/null)
  session=$(session_id "$directory")
  if ! transcript=$(session_transcript "$vendor" "$account" "$session" "$workdir"); then
    RUN_FILES_REASON="no session transcript for $session"
    return 0
  fi
  case "$vendor" in
    claudeb)
      if ! RUN_FILES_LIST=$(transcript_files "$transcript" "$workdir" "$started"); then
        RUN_FILES_LIST=''
        RUN_FILES_REASON='transcript unreadable'
        return 0
      fi
      # A list of editor calls answers for editor calls: a run that also WROTE through the shell —
      # `sed -i`, a redirect, `mv` — changed files no transcript records as a tool call, and the list
      # is a floor rather than the whole of it. Said per run, because a run whose shell only READ
      # (its own test suite, `git status`) has a complete list and must not be doubted.
      transcript_wrote_through_shell "$transcript" "$started"
      case $? in
        0) RUN_FILES_PARTIAL="$SHELL_FLOOR_PARTIAL" ;;
        2) RUN_FILES_LIST=''; RUN_FILES_REASON='transcript unreadable'; return 0 ;;
      esac
      ;;
    gemini)
      rows=$(gemini_tool_rows "$transcript" "$started") || {
        RUN_FILES_REASON='transcript unreadable'
        return 0
      }
      classify_tool_rows "$rows" "$workdir"
      RUN_SHELL_COMMANDS=$(printf '%s\n' "$rows" | sed -n $'s/^C\t//p')
      ;;
    codex)
      rows=$(codex_tool_rows "$transcript" "$started") || {
        RUN_FILES_REASON='transcript unreadable'
        return 0
      }
      classify_tool_rows "$rows" "$workdir"
      RUN_SHELL_COMMANDS=$(printf '%s\n' "$rows" | sed -n $'s/^C\t//p')
      ;;
    grok)
      rows=$(grok_tool_rows "$transcript" "$started") || {
        RUN_FILES_REASON='transcript unreadable'
        return 0
      }
      classify_tool_rows "$rows" "$workdir"
      RUN_SHELL_COMMANDS=$(printf '%s\n' "$rows" | sed -n $'s/^C\t//p')
      ;;
    # Fail-closed for a vendor added without an extractor: an empty list is a claim about the run,
    # and it is the one claim certainly wrong about a run nobody can read.
    *) RUN_FILES_REASON="no per-file extractor for $vendor" ;;
  esac
  return 0
}

cotenant_note() { # paths
  local paths="$1" count listed
  count=$(grep -c '' <<<"$paths")
  listed=$paths
  [ "$count" -le "$UNNAMED_INLINE_MAX" ] || listed=$(head -n "$UNNAMED_INLINE_MAX" <<<"$paths")
  listed=$(tr '\n' ' ' <<<"$listed")
  listed=${listed% }
  if [ "$count" -gt "$UNNAMED_INLINE_MAX" ]; then
    printf '%s path(s) changed in the checkout during the run by another writer and are not this run'"'"'s; the first %s: %s\n' \
      "$count" "$UNNAMED_INLINE_MAX" "$listed"
    return 0
  fi
  printf '%s path(s) changed in the checkout during the run by another writer and are not this run'"'"'s: %s\n' \
    "$count" "$listed"
}

# The same for the paths NOBODY answers for: the run's own listing is a floor or unreadable, so the
# window holds changes it may or may not have made, and neither answer may be invented. They are in
# the dirt record, which is what the UNNAMED line offers the launching chat to claim.
unattributed_note() { # paths reason
  local paths="$1" count listed
  count=$(grep -c '' <<<"$paths")
  listed=$paths
  [ "$count" -le "$UNNAMED_INLINE_MAX" ] || listed=$(head -n "$UNNAMED_INLINE_MAX" <<<"$paths")
  listed=$(tr '\n' ' ' <<<"$listed")
  listed=${listed% }
  if [ "$count" -gt "$UNNAMED_INLINE_MAX" ]; then
    printf '%s path(s) changed in the run'"'"'s window that its own listing does not name and nobody answers for (%s); the first %s: %s\n' \
      "$count" "$2" "$UNNAMED_INLINE_MAX" "$listed"
    return 0
  fi
  printf '%s path(s) changed in the run'"'"'s window that its own listing does not name and nobody answers for (%s): %s\n' \
    "$count" "$2" "$listed"
}

# The caveat the launching chat reads beside the file list, from what `persist_run_files` already
# resolved: what the run does NOT answer for. A listing that answered for the whole run names a
# co-tenant's paths as a co-tenant's; one that could not leaves them owned by nobody, which is a
# different sentence — and never "the snapshot stands", which is the claim that handed a run eight
# files for the two it wrote (live 2026-09-11).
transcript_crosscheck() ( # directory
  local directory="$1" path
  {
    if [ -n "${RUN_FILES_COTENANT:-}" ]; then
      cotenant_note "$RUN_FILES_COTENANT"
    fi
    if [ -n "${RUN_FILES_UNNAMED:-}" ]; then
      unattributed_note "$RUN_FILES_UNNAMED" "${RUN_LISTING_REASON:-${RUN_LISTING_PARTIAL:-the listing is incomplete}}"
    fi
    while IFS= read -r path; do
      [ -z "$path" ] || printf 'UNKNOWN: transcript names a write outside the snapshotted repository; no content baseline was recorded: %s\n' "$path"
    done <<<"${RUN_FILES_EXTERNAL:-}"
    if [ -n "${RUN_LISTING_REASON:-}" ]; then
      printf 'transcript cross-check unavailable: %s; changed paths remain unnamed\n' \
        "$RUN_LISTING_REASON"
    fi
  } >"$directory/files-note"
  if [ -n "${RUN_FOREIGN_NOTE:-}" ]; then
    printf '%s\n' "$RUN_FOREIGN_NOTE" >>"$directory/files-note" 2>/dev/null || :
  fi
)

compute_run_files() {
  local directory="$1" workdir
  RUN_FILES_LIST=''
  RUN_FILES_REASON=''
  RUN_FILES_PARTIAL=''
  RUN_FILES_ESCAPE=''
  if [ -f "$directory/files" ]; then
    RUN_FILES_LIST=$(grep -v '^WORKDIR: \|^UNKNOWN: \|^PARTIAL: ' "$directory/files" 2>/dev/null)
    RUN_FILES_REASON=$(sed -n 's/^UNKNOWN: //p' "$directory/files" | head -n1)
    return 0
  fi
  workdir=$(jq -r '.workdir' "$directory/meta.json" 2>/dev/null)
  compute_snapshot_files "$directory" "$workdir"
}

# 1 requires every Bash call in the window to be classified read-only; 0 is a floor, 2 unreadable.
transcript_wrote_through_shell() { # transcript since
  local transcript="$1" since="${2:-0}" commands command
  [[ "$since" =~ ^[0-9]+$ ]] || since=0
  commands=$(jq -c --argjson since "$since" '
           (((.timestamp? // "") | tostring | sub("\\.[0-9]+"; ""))
             | fromdateiso8601? // null) as $stamp
           | .. | objects
           | select((.type? == "tool_use") and ((.name? // "") == "Bash"))
           | if $stamp == null then "__unclassified_shell_call__"
             elif $stamp < $since then empty
             else (.input.command? // "") | tostring
               | if length == 0 then "__unclassified_shell_call__" else . end
             end' "$transcript" 2>/dev/null) || return 2
  RUN_SHELL_COMMANDS=$commands
  [ -n "$commands" ] || return 1
  while IFS= read -r command; do
    command=$(printf '%s\n' "$command" | jq -r .) || return 2
    writes_through_shell "$command" && return 0
  done < <(printf '%s\n' "$commands")
  return 1
}

run_files() {
  local directory="$1" workdir count value
  workdir=$(jq -r '.workdir' "$directory/meta.json" 2>/dev/null)
  compute_run_files "$directory"
  workdir_escape_line "$directory"
  [ ! -s "$directory/files-note" ] || sed 's/^/RUN-FILES-NOTE: /' "$directory/files-note"
  if [ -n "$RUN_FILES_REASON" ]; then
    printf 'RUN-FILES: unknown (%s)\n' "$RUN_FILES_REASON"
    return 0
  fi
  if [ -z "$RUN_FILES_LIST" ]; then
    printf 'RUN-FILES: 0\n'
    return 0
  fi
  count=$(grep -c '' <<<"$RUN_FILES_LIST")
  # The paths below are workdir-relative (absolute only when they fall outside it), so a consumer
  # standing anywhere else — the launching chat's journal hook — can resolve them only with this.
  [ -z "$workdir" ] || [ "$workdir" = null ] || printf 'WORKDIR: %s\n' "$workdir"
  printf 'RUN-FILES: %s\n' "$count"
  while IFS= read -r value; do
    printf 'RUN-FILE: %s\n' "$value"
  done <<<"$RUN_FILES_LIST"
}

readonly_report_hint() {
  local directory="$1" workdir gained marker root month started marker_month count=0
  [ -f "$directory/exit_code" ] || return 0
  head -n1 "$directory/brief" 2>/dev/null | grep -Eiq '(^|[[:space:]])(READ-ONLY|RESEARCH):' && return 0
  # A Light run IS the cheaper leg the hint asks for, and a research run edits nothing by design:
  # told to route itself somewhere cheaper, either one is being asked to stop existing.
  jq -e '.role == "research" or has("light")' "$directory/meta.json" >/dev/null 2>&1 && return 0
  compute_run_files "$directory"
  [ -z "$RUN_FILES_REASON" ] && [ -z "$RUN_FILES_LIST" ] || return 0
  [ -f "$directory/dirty-before" ] || return 0
  workdir=$(jq -r '.workdir' "$directory/meta.json" 2>/dev/null)
  workdir_dirty_paths "$workdir" >/dev/null 2>&1 || return 0
  workdir_dirty_shas "$workdir" >/dev/null 2>&1 || return 0
  gained=$(workdir_gained_paths "$directory" "$workdir")
  [ -z "$gained" ] || return 0
  marker="$directory/report-readonly"
  [ -e "$marker" ] || : >"$marker"
  root=${directory%/*}
  month=$(date +%Y-%m)
  for marker in "$root"/*/report-readonly; do
    [ -e "$marker" ] || continue
    started=$(jq -r '.started_at // empty' "${marker%/*}/meta.json" 2>/dev/null)
    [[ "$started" =~ ^[0-9]+$ ]] || continue
    marker_month=$(date -r "$started" +%Y-%m 2>/dev/null || date -d "@$started" +%Y-%m 2>/dev/null) || continue
    [ "$marker_month" != "$month" ] || count=$((count + 1))
  done
  printf 'HINT: this run edited nothing — a read-only lookup is cheaper on the light-research agent (see ~/.claude/CLAUDE.md, Model routing); read-only relay runs this month: %s\n' "$count"
}

# The agent's answer, reassembled out of the stream: `text` events carry it in chunks, and a raw
# NDJSON tail is the one shape no reader of a report can use. The raw tail stands in where not one
# chunk parsed, so a stream that broke early is still visible.
grok_result_text() { # directory
  local text
  text=$(jq -jR 'fromjson? | select(type == "object" and .type == "text") | (.data // .text // "")' \
    "$1/out" 2>/dev/null)
  if [ -n "$text" ]; then printf '%s\n' "$text"; else tail -n 400 "$1/out" 2>/dev/null; fi
}

# `wait` names the answer instead of quoting it: a relay reads `report` next in any case, and a tail
# here made every terminal wait hand the orchestrator the same result twice.
result_pointer() { # directory
  printf 'RESULT: run `worker-run report %s`\n' "${1##*/}"
}

# What memlogd's memory guard did to this run, off the record it left in the run dir. A worker whose
# children were SIGKILLed under memory pressure comes back with a torn transcript and a vendor error
# that names nothing, and the supervisor survived precisely so this line can be printed: without it
# the run reports a failure whose cause is only in a daemon log nobody reads. One line per kill,
# since a long run can be cut more than once.
memguard_lines() { # directory
  [ -s "$1/memguard" ] || return 0
  awk '$1 == "MEMGUARD" {
    avail = tree = pids = ""
    for (i = 2; i <= NF; i++) {
      if ($i ~ /^avail_mb=/) avail = substr($i, 10)
      else if ($i ~ /^tree_rss_mb=/) tree = substr($i, 13)
      else if ($i ~ /^killed=/) pids = substr($i, 8)
    }
    n = (pids == "" ? 0 : split(pids, list, ","))
    printf "MEMGUARD: %d descendant%s SIGKILLed under memory pressure (avail %s MB, tree %s MB); the run'"'"'s own root was spared\n", \
      n, (n == 1 ? "" : "s"), avail, tree
  }' "$1/memguard"
}

# A result written for Egor rather than for the model that has to read it. Stamped once, when the
# run's result lands, because the text is what is measured and `worker-run report` must say the same
# thing about it a week later; no re-ask follows — the vendors that cannot run a Stop hook are
# exactly the ones this flag is for.
stamp_result_language() { # directory
  local share
  [ -s "$1/result" ] || return 0
  [ ! -e "$1/lang" ] || return 0
  share=$(cyrillic_share <"$1/result") || return 0
  cyrillic_over "$share" || return 0
  printf 'cyrillic %s\n' "$share" >"$1/lang" 2>/dev/null || :
}

lang_line() { # directory
  local share
  share=$(sed -n 's/^cyrillic //p' "$1/lang" 2>/dev/null | head -n1)
  case "$share" in ''|*[!0-9]*) return 0 ;; esac
  printf 'LANG: cyrillic %s%%\n' "$share"
}

denied_tools_line() {
  local denied
  denied=$(jq -r '.denied_tools // empty' "$1/meta.json")
  [ -z "$denied" ] || printf 'DENIED-TOOLS: %s\n' "$denied"
}

# `done` is a run that finished its work, which exit 0 alone does not prove: a grok session the
# vendor cancelled before its first turn exits 0 with nothing in it. Both terminal reports read the
# status here so `wait` and `report` can never disagree about the same run.
terminal_status() { # directory vendor code
  [ "$3" = 0 ] || { printf 'failed\n'; return 0; }
  if [ "$2" = grok ] && grok_cancelled_start "$1"; then printf 'failed\n'; return 0; fi
  printf 'done\n'
}

terminal_report() {
  local directory="$1" code vendor status
  code=$(tr -d '[:space:]' <"$directory/exit_code")
  [[ "$code" =~ ^[0-9]+$ ]] || code=unknown
  vendor=$(jq -r '.vendor' "$directory/meta.json")
  status=$(terminal_status "$directory" "$vendor" "$code")
  printf 'STATUS: %s\nEXIT: %s\nSESSION: %s\n' "$status" "$code" "$(session_id "$directory")"
  reroute_lines "$directory"
  workdir_escape_line "$directory"
  memguard_lines "$directory"
  print_outcome "$directory" "$vendor" "$code"
  denied_tools_line "$directory"
  lang_line "$directory"
  inbox_lines "$directory"
  unnamed_line "$directory"
  result_pointer "$directory"
  if [ "$code" != 0 ]; then
    printf 'ERR-TAIL:\n'
    tail -n 40 "$directory/err" 2>/dev/null
  fi
}

run_state_terminal() { # directory
  local code
  code=$(tr -d '[:space:]' <"$1/exit_code" 2>/dev/null)
  [[ "$code" =~ ^[0-9]+$ ]] || code=unknown
  write_run_state "$1" "$(terminal_status "$1" "$(jq -r '.vendor' "$1/meta.json" 2>/dev/null)" "$code")" "$code"
}

unknown_report() {
  local directory="$1" vendor
  vendor=$(jq -r '.vendor' "$directory/meta.json")
  printf 'STATUS: failed\nEXIT: unknown\nSESSION: %s\n' "$(session_id "$directory")"
  outcome_line "$(failure_outcome "$vendor")" "$directory"
  memguard_lines "$directory"
  denied_tools_line "$directory"
  result_pointer "$directory"
  printf 'ERR-TAIL:\n'
  tail -n 40 "$directory/err" 2>/dev/null
}

# How long ago this run last put bytes on disk. OUT-BYTES is no liveness signal — claudeb writes
# its JSON once, at the end, so it reads 0 for the whole run and a wrapper agent declared a healthy
# 52-minute run stalled one minute before it finished (live 2026-08-24). Newest mtime among the
# paths the dirt tracker already calls this run's own; nonzero where nothing has changed yet.
last_edit_age() { # directory workdir now
  local now="$3" newest age
  newest=$(workdir_activity_stamp "$1" "$2") || return 1
  age=$((now - newest)); [ "$age" -ge 0 ] || age=0
  printf '%s\n' "$age"
}

# LAST-EDIT keeps the dirt view; the watchdog passes `own` to exclude co-tenant edits.
workdir_activity_stamp() { # directory workdir [own]
  local directory="$1" workdir="$2" top path target mtime newest=''
  if [ "${3:-}" = own ]; then
    top=$workdir
  else
    [ -f "$directory/dirty-before" ] || return 1
    top=$(git -C "$workdir" rev-parse --show-toplevel 2>/dev/null) || return 1
  fi
  [ -n "$top" ] || return 1
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    if [ "${3:-}" = own ]; then
      case "$path" in /*|..|../*|*/../*|*/..) continue ;; esac
    fi
    target="$top/$path"
    if [ "${3:-}" = own ] && [ ! -e "$target" ]; then
      [ -n "$newest" ] || newest=0
      continue
    fi
    while ! mtime=$(stat -f %m "$target" 2>/dev/null || stat -c %Y "$target" 2>/dev/null); do
      [ "$target" != "$top" ] || { mtime=''; break; }
      target=${target%/*}
    done
    [ -n "$mtime" ] || continue
    [[ "$mtime" =~ ^[0-9]+$ ]] || continue
    [ -n "$newest" ] && [ "$mtime" -le "$newest" ] || newest=$mtime
  done < <(
    if [ "${3:-}" = own ]; then
      compute_transcript_files "$directory"
      printf '%s\n' "$RUN_FILES_LIST"
    else
      workdir_gained_paths "$directory" "$workdir"
    fi
  )
  [ -n "$newest" ] || return 1
  printf '%s\n' "$newest"
}

# CPU the run has burned, summed over the whole process group: the supervisor is `setsid`'d, so its
# pid IS the group and one `ps` covers the CLI and everything it spawned. The second half of the
# liveness answer — a run whose files sit still is thinking if this keeps climbing.
pid_group_cpu_seconds() { # pid
  [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -gt 0 ] || return 1
  ps -g "$1" -o time= 2>/dev/null |
    awk 'NF { n = split($1, f, ":"); s = 0; for (i = 1; i <= n; i++) s = s * 60 + f[i]; total += s; seen = 1 }
         END { if (!seen) exit 1; printf "%d\n", total }'
}

running_report() {
  local directory="$1" now started elapsed out_bytes err_bytes workdir age cpu
  now=$(date +%s)
  started=$(jq -r '.started_at' "$directory/meta.json")
  elapsed=$((now - started)); [ "$elapsed" -ge 0 ] || elapsed=0
  out_bytes=$(wc -c <"$directory/out" | tr -d '[:space:]')
  err_bytes=$(wc -c <"$directory/err" | tr -d '[:space:]')
  printf 'STATUS: running\nELAPSED: %s\n' "$elapsed"
  # Once per RUN, not once per round. The marker is written where the line is printed, so a `wait`
  # that never got to print it still owes it. A relay never returns on it: its row is the run's only
  # visible trace.
  if [ "$elapsed" -ge "${WORKER_RUN_LONG_RUN_S:-1500}" ] && [ ! -e "$directory/long-run-said" ]; then
    printf 'LONG-RUN: %s min — the orchestrator'"'"'s prompt cache cools past the hour; the relay keeps waiting until the run ends\n' "$((elapsed / 60))"
    : >"$directory/long-run-said" 2>/dev/null || :
  fi
  printf 'OUT-BYTES: %s\nERR-BYTES: %s\nSESSION: %s\n' "$out_bytes" "$err_bytes" "$(session_id "$directory")"
  workdir=$(jq -r '.workdir' "$directory/meta.json" 2>/dev/null)
  age=$(last_edit_age "$directory" "$workdir" "$now") || age=none
  printf 'LAST-EDIT: %s\n' "$age"
  memguard_lines "$directory"
  cpu=$(pid_group_cpu_seconds "$(jq -r '.pid' "$directory/meta.json" 2>/dev/null)") &&
    printf 'CPU-SECONDS: %s\n' "$cpu"
  return 0
}

wait_poll_lag() { # directory run-id wait-started: how long an exit the poll had not yet seen waited
  local ended
  ended=$(store_lock_mtime "$1/exit_code") && [ "$ended" -ge "$3" ] 2>/dev/null &&
    wait_note poll "worker-run wait $2" "$ended"
  return 0
}

run_live() { # directory
  [ ! -e "$1/exit_code" ] && supervisor_running "$1" "$(jq -r '.pid // 0' "$1/meta.json" 2>/dev/null)" &&
    ! run_overdue "$1"
}

chrome_runs() { # live run ids that may be driving Google Chrome
  local runs="${WORKER_RUN_DIR:-$HOME/.cache/claude-worker-runs}" devices meta
  devices=$(jq -c . "$runs/browse/devices.json" 2>/dev/null) || devices='{}'
  # A run from before browser_target was recorded names only its device; one that is no Dia
  # profile's, or a computer-use run, may be on Chrome.
  find "$runs" -mindepth 2 -maxdepth 2 -name meta.json -mtime -2 -print0 2>/dev/null |
    xargs -0 jq -r --argjson devices "$devices" 'select(.chrome == true or .computer == true or (.browser == true
      and (.browser_target // "") != "dia" and ((($devices[.browser_device // ""] // {}).profile // "") | startswith("dia:") | not)))
      | input_filename' 2>/dev/null |
    while IFS= read -r meta; do
      ! run_live "${meta%/meta.json}" || printf '%s\n' "$(basename "${meta%/meta.json}")"
    done
}

say_run() {
  local directory vendor mode line end at waited=0 owner entry
  local -a live=()
  if [ "$#" -eq 1 ] && [ -n "$1" ]; then
    owner=${CLAUDE_LAUNCHER_SESSION:-${CLAUDE_CODE_SESSION_ID:-}}
    [ -z "$owner" ] || while IFS= read -r entry; do
      directory=${entry%/launcher}
      ! run_live "$directory" || live+=("$directory")
    done < <(refuse_live_matches "$owner" "${WORKER_RUN_DIR:-$HOME/.cache/claude-worker-runs}" launcher)
    [ "${#live[@]}" -gt 0 ] || fail 'no live worker run of this chat: nothing was sent.'
    if [ "${#live[@]}" -gt 1 ]; then
      for directory in "${live[@]}"; do
        printf '%s  %s  %s\n' "${directory##*/}" "$(head -c 80 "$directory/tag" 2>/dev/null | head -n1)" \
          "$(head -n1 "$directory/brief" 2>/dev/null | cut -c1-60)" >&2
      done
      fail "${#live[@]} live worker runs of this chat: name one, \`worker-run say <run-id> <text>\`. Nothing was sent."
    fi
    set -- "${live[0]##*/}" "$1"
  fi
  [ "$#" -eq 2 ] && [ -n "$2" ] || usage
  directory=$(run_path "$1")
  [ -r "$directory/meta.json" ] || fail "unknown run: $1"
  run_live "$directory" ||
    fail "run $1 has finished and nothing reads its inbox any more: put the message into the next brief, \`RESUME $(session_id "$directory"):\` for the same session. Nothing was sent."
  vendor=$(jq -r '.vendor' "$directory/meta.json")
  mode=$(inbox_mode "$directory")
  line=$(jq -cn --arg at "$(inbox_now)" --arg by "${CLAUDE_LAUNCHER_SESSION:-${CLAUDE_CODE_SESSION_ID:-${USER:-?}}}" \
    --arg text "$2" '{at: $at, by: $by, text: $text}') || fail 'could not encode the message. Nothing was sent.'
  with_agent_tag_lock "$directory" inbox_append "$directory" "$line" || fail "could not write $directory/inbox. Nothing was sent."
  end=$INBOX_APPENDED_END
  if [ "$mode" = hook ]; then
    while :; do
      at=$(inbox_delivered_at "$directory" "$end")
      [ -z "$at" ] || { printf 'delivered at %s\n' "$at"; return 0; }
      [ "$waited" -lt $((${WORKER_RUN_SAY_WAIT_S:-2} * 10)) ] || break
      sleep 0.1
      waited=$((waited + 1))
    done
  fi
  inbox_queued_text "$vendor" "$mode" true
}

inbox_lines() { # directory
  [ -s "$1/inbox" ] || return 0
  local vendor live=false
  vendor=$(jq -r '.vendor' "$1/meta.json")
  ! run_live "$1" || live=true
  inbox_states "$1" "$(inbox_queued_text "$vendor" "$(inbox_mode "$1")" "$live")"
}

inbox_carry_from() { # prior-directory directory
  inbox_pending "$1" || return 0
  { inbox_context "$INBOX_TAKEN" && printf '\n'; } >>"$2/inbox-carried" &&
    INBOX_CARRIES+=("$INBOX_END"$'\t'"$1")
}

# Only once the resumed run has a supervisor: a start failing earlier would leave the messages
# reported as delivered to a run that never launched, and the next RESUME with nothing to carry.
inbox_carry_commit() { # directory
  local entry
  for entry in ${INBOX_CARRIES[@]+"${INBOX_CARRIES[@]}"}; do
    with_agent_tag_lock "${entry#*$'\t'}" inbox_record "${entry#*$'\t'}" "${entry%%$'\t'*}" "resume:${1##*/}"
  done
  INBOX_CARRIES=()
}

inbox_carry_resume() { # directory session
  local entry prior
  while IFS= read -r entry; do
    prior=${entry%/worker-session}
    [ "$prior" != "$1" ] && [ -s "$prior/inbox" ] || continue
    with_agent_tag_lock "$prior" inbox_carry_from "$prior" "$1"
  done < <(refuse_live_matches "$2" "${1%/*}" worker-session)
}

wait_run() {
  [ "$#" -ge 1 ] || usage
  local run_id="$1" max=100 directory wait_started now waited remaining sleep_for pid
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --max) [ "$#" -ge 2 ] || usage; max="$2"; shift 2 ;;
      *) usage ;;
    esac
  done
  [[ "$max" =~ ^[0-9]+$ ]] || usage
  directory=$(run_path "$run_id")
  [ -d "$directory" ] && [ -r "$directory/meta.json" ] || fail "unknown run: $run_id"
  wait_started=$(date +%s)
  write_run_state "$directory" wait
  while :; do
    if [ -f "$directory/exit_code" ]; then
      wait_poll_lag "$directory" "$run_id" "$wait_started"; run_state_terminal "$directory"; terminal_report "$directory"; return 0
    fi
    pid=$(jq -r '.pid' "$directory/meta.json")
    # pid 0 is the pre-launch placeholder, and a probe of it would answer for our own
    # process group and report a never-started run as alive.
    if ! supervisor_running "$directory" "$pid" || run_overdue "$directory"; then
      sleep 0.1
      if [ -f "$directory/exit_code" ]; then
        run_state_terminal "$directory"
        terminal_report "$directory"
      else
        write_run_state "$directory" failed unknown
        unknown_report "$directory"
      fi
      return 0
    fi
    now=$(date +%s)
    waited=$((now - wait_started)); [ "$waited" -ge 0 ] || waited=0
    if [ "$waited" -ge "$max" ]; then running_report "$directory"; return 0; fi
    remaining=$((max - waited))
    sleep_for=$WAIT_POLL; [ "$remaining" -ge "$sleep_for" ] || sleep_for=$remaining
    sleep "$sleep_for"
  done
}

transcript_run() {
  [ "$#" -eq 1 ] || usage
  local directory
  directory=$(run_path "$1")
  [ -r "$directory/meta.json" ] || fail "unknown run: $1"
  session_transcript "$(jq -r '.vendor' "$directory/meta.json")" "$(jq -r '.account' "$directory/meta.json")" \
    "$(session_id "$directory")" "$(jq -r '.workdir // empty' "$directory/meta.json")" && printf '\n'
}

report_run() {
  [ "$#" -eq 1 ] || usage
  local directory vendor account code status cost s5_rate pid
  directory=$(run_path "$1")
  [ -d "$directory" ] && [ -r "$directory/meta.json" ] || fail "unknown run: $1"
  vendor=$(jq -r '.vendor' "$directory/meta.json")
  account=$(jq -r '.account' "$directory/meta.json")
  printf 'ACCOUNT: %s (%s)\n' "$account" "$vendor"
  jq -r '"MODEL: \(.model // "?")\(if (.effort // "") != "" then "·" + .effort else "" end)",
         (.served_model // empty | "SERVED: \(.)")' "$directory/meta.json" 2>/dev/null
  printf 'WEB: %s\n' "$(web_search_meta_state "$directory/meta.json")"
  reroute_lines "$directory"
  if [ -f "$directory/exit_code" ]; then
    code=$(tr -d '[:space:]' <"$directory/exit_code")
    [[ "$code" =~ ^[0-9]+$ ]] || code=unknown
    status=$(terminal_status "$directory" "$vendor" "$code")
    printf 'STATUS: %s\nEXIT: %s\nSESSION: %s\n' "$status" "$code" "$(session_id "$directory")"
    memguard_lines "$directory"
    print_outcome "$directory" "$vendor" "$code"
    readonly_report_hint "$directory"
    if [ "$code" != 0 ]; then
      printf 'ERR-TAIL:\n'
      tail -n 80 "$directory/err" 2>/dev/null
    fi
  else
    pid=$(jq -r '.pid' "$directory/meta.json")
    if supervisor_running "$directory" "$pid" && ! run_overdue "$directory"; then
      running_report "$directory"
    else
      printf 'STATUS: failed\nEXIT: unknown\nSESSION: %s\n' "$(session_id "$directory")"
      outcome_line "$(failure_outcome "$vendor")" "$directory"
      memguard_lines "$directory"
      printf 'ERR-TAIL:\n'
      tail -n 80 "$directory/err" 2>/dev/null
    fi
  fi
  denied_tools_line "$directory"
  lang_line "$directory"
  inbox_lines "$directory"
  if [ "$vendor" = claudeb ]; then
    cost=$(jq -r '.total_cost_usd // empty' "$directory/out" 2>/dev/null)
    # The $2/M base permanently defines one Sonnet-5-equivalent token; after the public rate
    # returns to $3/M, one Sonnet 5 token weighs 1.5 of these stable units.
    s5_rate=${WORKER_RUN_S5_USD_PER_M:-}
    LC_ALL=C awk -v n="$s5_rate" \
      'BEGIN { exit !(n ~ /^[+]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?$/ && n > 0) }' \
      || s5_rate=2.0
    # LC_ALL=C: a comma-decimal locale reads 1.25 as 1 and understates the cost fivefold.
    # The k rung stops short of 999500 so that %.0f never rounds its way to "1000k".
    [ -z "$cost" ] || printf 'COST: %s\n' "$(LC_ALL=C awk -v c="$cost" -v r="$s5_rate" \
      'BEGIN { t = c * 1e6 / r
               if (t > 0 && t < 0.5) printf "<1 tok-eq"
               else if (t < 999.5) printf "%.0f tok-eq", t
               else if (t < 999500) printf "%.0fk tok-eq", t / 1e3
               else printf "%.1fM tok-eq", t / 1e6 }')"
  fi
  run_files "$directory"
  unnamed_line "$directory"
  printf 'RESULT:\n'
  run_result_text "$directory" "$vendor" | tail -n 400
}

produced_commit_rows() { # top rel head-before [after]
  local top="$1" rel="$2" head="$3" after directory="${RUN_DIRECTORY:-}" since until dirty foreign
  after=${4-}
  [ "$#" -ge 4 ] || after=$(git -C "$top" rev-parse --verify --quiet HEAD 2>/dev/null) || return 0
  [ -n "$after" ] && [ "$after" != "$head" ] || return 0
  foreign=/dev/null
  dirty=/dev/null
  if [ -n "$directory" ]; then
    [ -f "$directory/dirty-before-shas" ] && dirty=$directory/dirty-before-shas
    foreign=${RUN_FOREIGN_FILE:-/dev/null}
    since=$(jq -r '.pid_started_at // .started_at // empty' "$directory/meta.json" 2>/dev/null)
  fi
  until=$(date +%s)
  export AWK_TOP=$top AWK_REL=$rel AWK_DIRTY=$dirty AWK_FOREIGN=$foreign
  if [ -n "${since:-}" ] && [[ "$since" =~ ^[0-9]+$ ]]; then
    export AWK_WINDOW=1 AWK_SINCE=$since AWK_UNTIL=$until
  else
    export AWK_WINDOW=0 AWK_SINCE=0 AWK_UNTIL=0
  fi
  {
    if [ -n "$head" ] && git -C "$top" merge-base --is-ancestor "$head" "$after" 2>/dev/null; then
      git -C "$top" log --raw -m --no-renames --no-abbrev --reverse -z --format='%H %ct' "$head..$after"
    else
      [ -n "$head" ] || head=$(git -C "$top" hash-object -w -t tree --stdin </dev/null)
      git -C "$top" diff --raw --no-renames --no-abbrev -z "$head" "$after" --
    fi
  } 2>/dev/null | tr '\0' '\n' |
    awk '
      BEGIN {
        top = ENVIRON["AWK_TOP"]; rel = ENVIRON["AWK_REL"]
        since = ENVIRON["AWK_SINCE"]+0; until = ENVIRON["AWK_UNTIL"]+0
        window = ENVIRON["AWK_WINDOW"]+0; foreign = ENVIRON["AWK_FOREIGN"]
        in_window = 1
        while ((getline line < ENVIRON["AWK_DIRTY"]) > 0) {
          split(line, d, "\t")
          if (d[2] != "") predirty[d[2]] = 1
        }
      }
      !NF { next }
      pending != "" {
        top_path = $0
        if (top_path in predirty) { pending = ""; next }
        path = top_path
        if (rel != "") {
          if (index(path, rel "/") == 1) path = substr(path, length(rel) + 2)
          else path = top "/" path
        }
        if (window && !in_window) {
          if (foreign != "" && foreign != "/dev/null") print path >> foreign
          pending = ""
          next
        }
        split(pending, f, " ")
        prev = f[3]; cur = f[4]
        if (prev ~ /^0+$/) prev = "-"
        if (cur ~ /^0+$/) cur = "-"
        printf "%s\t%s\t%s\tcommit\n", prev, cur, path
        pending = ""
        next
      }
      /^:/ { pending = $0; next }
      {
        if (window) {
          split($0, h, " ")
          ct = h[2]+0
          in_window = (ct >= since && ct <= until) ? 1 : 0
        }
      }'
}

# The content this run PRODUCED, which is what a debt reader prices: one row per link, so ownership
# follows the BLOB and no longer a path and an epoch. Written only for a run that answers to a chat
# and worked in a git tree — content nobody owns is what `dirty` is for — and written even when it
# is empty, since its presence is this run answering for its own content and its absence is what
# sends the sweep back to the listing.
record_produced() { # directory workdir
  local directory="$1" workdir="$2" top rel head after foreign commits
  RUN_FOREIGN_NOTE=''
  [ -s "$directory/launcher" ] || return 0
  top=$(git -C "$workdir" rev-parse --show-toplevel 2>/dev/null) || return 0
  [ -n "$top" ] || return 0
  rel=${workdir%/}
  case "$rel" in
    "$top"/*) rel=${rel#"$top"/} ;;
    *) rel='' ;;
  esac
  head=$(tr -d '[:space:]' <"$directory/head-before" 2>/dev/null)
  after=$(cat "$directory/head-after" 2>/dev/null)
  foreign="$directory/foreign.tmp.$$"
  commits="$directory/commit-rows.tmp.$$"
  : >"$foreign"
  RUN_DIRECTORY=$directory
  RUN_FOREIGN_FILE=$foreign
  produced_commit_rows "$top" "$rel" "$head" "$after" >"$commits"
  unset RUN_FOREIGN_FILE
  {
    produced_edit_rows "$directory" "$top" "$rel" "$head" \
      < <(listing_top_paths "$directory" "$top" "$workdir")
    AWK_LIST="$RUN_FILES_LIST" awk -F'\t' 'BEGIN { n=split(ENVIRON["AWK_LIST"], p, "\n"); for (i=1;i<=n;i++) named[p[i]]=1 } $3 in named' "$commits"
  } | AWK_FOREIGN=$foreign awk -F'\t' '
      BEGIN { while ((getline p < ENVIRON["AWK_FOREIGN"]) > 0) if (p != "") skip[p]=1 }
      NF >= 3 && !($3 in skip)
    ' >"$directory/produced.tmp.$$" 2>/dev/null &&
    mv -f "$directory/produced.tmp.$$" "$directory/produced" 2>/dev/null ||
    rm -f "$directory/produced.tmp.$$" 2>/dev/null
  if [ -s "$foreign" ]; then
    RUN_FOREIGN_NOTE='commits outside the run window landed in head-before..head-after; those paths are unattributed'
    sort -u "$foreign" | sed '/^$/d' >"$foreign.sorted"
    grep -vxF -f "$foreign.sorted" "$directory/files" >"$directory/files.tmp.$$" 2>/dev/null &&
      mv -f "$directory/files.tmp.$$" "$directory/files" 2>/dev/null ||
      rm -f "$directory/files.tmp.$$" 2>/dev/null
    rm -f "$foreign.sorted"
  fi
  rm -f "$foreign" "$commits"
  return 0
}

# How many of those paths the line still spells out itself. Past it the reader is pointed at the
# record instead: the list is there to be pasted, and one nobody can read at the end of a report is
# not one anybody pastes.
UNNAMED_INLINE_MAX=${WORKER_RUN_UNNAMED_INLINE_MAX:-25}

# The paths a run's window changed that no record on this machine names, spelled absolutely so the
# claim below takes them exactly as they are printed. The `dirty` record is only ever written where
# the run itself says its own list cannot be complete, so its rows ARE the unowned set — printed at
# the end of `wait` because that is the one moment the launching chat is looking at this run and can
# still say which of them are its worker's (live case 2026-08-25: 887 lines nobody answered for).
unnamed_line() { # directory
  local directory="$1" top paths count listed path workdir missing_after=false
  if grep -q '^UNKNOWN: \|^PARTIAL: ' "$directory/files" 2>/dev/null; then
    :
  elif [ ! -f "$directory/files" ] && [ -f "$directory/exit_code" ] &&
       { [ -f "$directory/head-before" ] || [ -f "$directory/dirty-before-shas" ]; } &&
       { [ ! -f "$directory/head-after" ] || [ ! -f "$directory/dirty-after-shas" ]; }; then
    missing_after=true
  else
    return 0
  fi
  top=$(sed -n 's/^WORKDIR: //p' "$directory/dirty" 2>/dev/null | head -n1)
  paths=$(grep -v '^WORKDIR: ' "$directory/dirty" 2>/dev/null | sed '/^$/d')
  if [ -z "$top" ] || [ -z "$paths" ]; then
    grep -q '^UNKNOWN: ' "$directory/files" 2>/dev/null || [ "$missing_after" = true ] || return 0
    workdir=$(sed -n 's/^WORKDIR: //p' "$directory/files" 2>/dev/null | head -n1)
    [ -n "$workdir" ] || workdir=$(jq -r '.workdir // empty' "$directory/meta.json" 2>/dev/null)
    [ "$workdir" != null ] || workdir=''
    printf 'UNNAMED: this run'"'"'s files are UNKNOWN — claim yours: worker-run claim %s --paths %s/<path>...\n' \
      "${directory##*/}" "${workdir:-<workdir>}"
    return 0
  fi
  count=$(grep -c '' <<<"$paths")
  if [ "$count" -gt "$UNNAMED_INLINE_MAX" ]; then
    # The list is the record's, not this line's, past the point where it stops being readable: the
    # 887-path case above printed a multi-kilobyte shell-quoted line at the end of every wait,
    # crowding out the outcome and the result tail it is printed beside.
    # The rows are spelled against the repository TOP, and `claim` resolves a relative operand
    # against the run's WORKDIR: for a run launched in a subdirectory a row pasted as it stands
    # names a path this run never touched, so the prefix is part of the instruction.
    printf 'UNNAMED: %s path(s) changed in this run'"'"'s window that no record names, listed one per line in %s — claim yours: worker-run claim %s --paths %s/<row>...\n' \
      "$count" "$directory/dirty" "${directory##*/}" "$top"
    return 0
  fi
  # Quoted for the shell this line is pasted into: a path carrying a space arrives at `claim` as
  # two paths, and one carrying a metacharacter as whatever that shell makes of it.
  listed=$(while IFS= read -r path; do printf '%q ' "$top/$path"; done <<<"$paths")
  printf 'UNNAMED: %s path(s) changed in this run'"'"'s window that no record names — claim yours: worker-run claim %s --paths %s\n' \
    "$count" "${directory##*/}" "${listed% }"
}

# What the run's own listing is spelled against. The record's first line where it has one, since that
# is what every reader of `files` resolves its rows with; the metadata otherwise, so a run whose
# listing could not be established at all still has an anchor to check a claim against.
claim_workdir() { # directory
  local workdir
  workdir=$(sed -n 's/^WORKDIR: //p' "$1/files" 2>/dev/null | head -n1)
  [ -n "$workdir" ] || workdir=$(jq -r '.workdir // empty' "$1/meta.json" 2>/dev/null)
  [ "$workdir" != null ] || workdir=''
  printf '%s' "$workdir"
}

# Lexical, like every other path answer here: a claimed target need not still exist, and a symlink
# resolved would answer about a path the run never named. Globbing off for the split, or a `*` in a
# claimed path is answered by whatever the filesystem happens to hold beside it.
normalize_path() { # path
  local part out='' IFS=/ globbing=on
  case $- in *f*) globbing=off ;; esac
  set -f
  for part in $1; do
    case "$part" in
      ''|.) ;;
      ..) out=${out%/*} ;;
      *) out="$out/$part" ;;
    esac
  done
  [ "$globbing" = off ] || set +f
  printf '%s' "${out:-/}"
}

# Claimed paths of one family, top-relative: folded as fixes only in a round.
claim_family_anchors() { # directory snap repo top launcher path...
  local directory="$1" snap="$2" repo="$3" top="$4" launcher="$5" round
  shift 5
  round=$(jq -r '.review_round // empty' "$directory/meta.json" 2>/dev/null) || round=''
  [ -z "$round" ] || fold_family_anchors "$directory" "$snap" "$repo" "$top" "$launcher" "$round" "$@"
}

# The diff is the same for every path of one snapshot. Computed in this shell: a cache set
# inside the grep pipeline would die with that subshell and the next path would rebuild it.
claim_snap() { # directory top; sets CLAIM_SNAP. Caller owns snap_dirs/snap_blobs.
  local i
  if [ "${#snap_dirs[@]}" -gt 0 ]; then
    for i in "${!snap_dirs[@]}"; do
      if [ "${snap_dirs[$i]}" = "$1" ]; then
        CLAIM_SNAP=${snap_blobs[$i]}
        return 0
      fi
    done
  fi
  CLAIM_SNAP=$(snapshot_changed_paths "$1" "$2" || true)
  snap_dirs+=("$1")
  snap_blobs+=("$CLAIM_SNAP")
}

claim_run() {
  [ "$#" -ge 1 ] || usage
  local run_id="$1" directory workdir top complete=false session launcher path absolute relative
  local sub family physical under CLAIM_SNAP=''
  local -a paths=() resolved=() elsewhere=() snap_dirs=() snap_blobs=()
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --complete) complete=true; shift ;;
      --paths)
        shift
        while [ "$#" -gt 0 ]; do
          case "$1" in --*) break ;; esac
          paths+=("$1"); shift
        done
        ;;
      *) usage ;;
    esac
  done
  [ "${#paths[@]}" -gt 0 ] || usage
  directory=$(run_path "$run_id")
  [ -d "$directory" ] && [ -r "$directory/meta.json" ] || fail "unknown run: $run_id"
  # A live run is still writing its own record: a claim landing mid-flight is overwritten by the next
  # `persist_run_files`, and the paths it named read back as nobody's again.
  [ -f "$directory/exit_code" ] ||
    fail "run $run_id is still running; claim its files once it has ended"
  session="${CLAUDE_CODE_SESSION_ID:-}"
  launcher=$(tr -d '[:space:]' <"$directory/launcher" 2>/dev/null)
  [ -n "$launcher" ] ||
    fail "run $run_id records no launching chat, so nobody may claim its files"
  [ -n "$session" ] ||
    fail "this shell names no chat (CLAUDE_CODE_SESSION_ID), and run $run_id answers to $launcher"
  [ "$session" = "$launcher" ] ||
    fail "run $run_id was launched by $launcher, not by this chat; the launching chat is the only one that may claim its files"
  workdir=$(claim_workdir "$directory")
  [ -n "$workdir" ] || fail "run $run_id records no workdir to resolve a claim against"
  top=$(git -C "$workdir" rev-parse --show-toplevel 2>/dev/null) || top=''
  # Every path is checked before any is written: a claim half applied leaves the caller unable to
  # tell which of its paths are named and which are still nobody's.
  #
  # Under the workdir, or anywhere in the REPOSITORY that workdir sits in: the dirt record this
  # claim answers is spelled against the repository top whatever directory the run was launched in,
  # so a run launched in a subdirectory has the very line `wait` prints refused whole (and the
  # listing already spells a path outside the workdir absolutely). Anything outside that
  # repository is nothing this run's records ever named.
  for path in "${paths[@]}"; do
    case "$path" in
      /*) absolute=$(normalize_path "$path") ;;
      *) absolute=$(normalize_path "$workdir/$path") ;;
    esac
    # The anchors store holds files only: a claimed directory reached `files` and was then refused
    # by the touch, leaving everything under it nobody's (live 2026-10-01, a claim-touch gap).
    [ ! -d "$absolute" ] || [ -L "$absolute" ] ||
      fail "$path is a directory; claim the files under it, one path each"
    case "$absolute" in
      "$workdir"/*) under=true ;;
      *) under=false ;;
    esac
    if [ "$under" = false ] || [ -z "$top" ]; then
      physical=$(physical_path "$absolute") || physical=$absolute
      if [ "$under" = false ] && [ -n "$top" ] && [ "$physical" != "${physical#"$top"/}" ]; then
        absolute=$physical
      else
        # A repository the run snapshotted beside its workdir (an --add-dir), or under a workdir
        # that is no repository itself: a fix it made there is claimed and folded in that family.
        family=''
        for sub in "$directory"/families/*; do
          [ -f "$sub/top" ] && [ -f "$sub/head-after" ] || continue
          IFS= read -r family <"$sub/top" 2>/dev/null || continue
          family=$(cd "$family" 2>/dev/null && pwd -P) || { family=''; continue; }
          [ "$physical" != "${physical#"$family"/}" ] && break
          family=''
        done
        if [ -n "$family" ]; then
          claim_snap "$sub" "$family"
          printf '%s\n' "$CLAIM_SNAP" | grep -qxF -- "${physical#"$family"/}" ||
            fail "$path is not in this run's snapshot diff"
          elsewhere+=("$sub"$'\t'"$family"$'\t'"$physical")
          continue
        fi
        [ "$under" = true ] ||
          fail "$path is not under this run's workdir ($workdir)${top:+, its repository ($top)} or a repository it snapshotted"
      fi
    fi
    if [ -f "$directory/head-after" ]; then
      if [ -n "$top" ]; then
        claim_snap "$directory" "$top"
        printf '%s\n' "$CLAIM_SNAP" | grep -qxF -- "${absolute#"$top"/}" ||
          fail "$path is not in this run's snapshot diff"
      else
        fail "$path is not in this run's snapshot diff"
      fi
    elif [ "$complete" != true ] &&
         ! grep -q '^PARTIAL: ' "$directory/files" 2>/dev/null; then
      fail "run $run_id has no after-snapshot; its files cannot be claimed"
    fi
    resolved+=("$absolute")
  done
  {
    if [ "$complete" = true ]; then
      grep '^WORKDIR: ' "$directory/files" 2>/dev/null
    else
      grep '^WORKDIR: \|^UNKNOWN: \|^PARTIAL: ' "$directory/files" 2>/dev/null
    fi
    { grep -v '^WORKDIR: \|^UNKNOWN: \|^PARTIAL: ' "$directory/files" 2>/dev/null
      for absolute in ${resolved[@]+"${resolved[@]}"}; do
        relative=${absolute#"$workdir"/}
        printf '%s\n' "$relative"
      done; } | sed '/^$/d' | sort -u
  } >"$directory/files.tmp.$$" 2>/dev/null &&
    mv -f "$directory/files.tmp.$$" "$directory/files" 2>/dev/null ||
    { rm -f "$directory/files.tmp.$$" 2>/dev/null; fail "could not rewrite the listing of $run_id"; }
  # A claimed path carries an owner now, and the dirt record is exactly the set that carries none.
  if [ -n "$top" ] && [ -f "$directory/dirty" ]; then
    local remaining
    # A difference, never a symmetric one: a claimed path the dirt record never held must not be
    # ADDED to it by the very call that names it.
    remaining=$(comm -23 \
      <(grep -v '^WORKDIR: ' "$directory/dirty" 2>/dev/null | sed '/^$/d' | sort -u) \
      <(for absolute in ${resolved[@]+"${resolved[@]}"}; do
          case "$absolute" in ("$top"/*) printf '%s\n' "${absolute#"$top"/}" ;; esac
        done | sort -u))
    if [ -n "$remaining" ]; then
      { printf 'WORKDIR: %s\n' "$top"; printf '%s\n' "$remaining"; } >"$directory/dirty.tmp.$$" &&
        mv -f "$directory/dirty.tmp.$$" "$directory/dirty" 2>/dev/null ||
        rm -f "$directory/dirty.tmp.$$" 2>/dev/null
    else
      rm -f "$directory/dirty" 2>/dev/null
    fi
  fi
  # A claimed path is content this run produced too, and `produced` was written when the run ended:
  # left out of it, the very paths a claim exists to name are invisible to every reader that takes
  # this record over the listing. APPENDED and never recomputed — the rows already standing were
  # measured at the run's end, and a fresh pass now would date a co-tenant's later edit to this run.
  if [ -n "$top" ] && [ -f "$directory/produced" ]; then
    local head rel row
    head=$(tr -d '[:space:]' <"$directory/head-before" 2>/dev/null)
    rel=${workdir%/}
    case "$rel" in
      "$top"/*) rel=${rel#"$top"/} ;;
      *) rel='' ;;
    esac
    while IFS= read -r row; do
      grep -qxF -- "$row" "$directory/produced" 2>/dev/null ||
        printf '%s\n' "$row" >>"$directory/produced"
    done < <(produced_edit_rows "$directory" "$top" "$rel" "$head" \
      < <(for absolute in ${resolved[@]+"${resolved[@]}"}; do
            case "$absolute" in ("$top"/*) printf '%s\n' "${absolute#"$top"/}" ;; esac
          done))
  fi
  if [ -n "$top" ]; then
    local -a touched=()
    for absolute in ${resolved[@]+"${resolved[@]}"}; do
      case "$absolute" in ("$top"/*) touched+=("./${absolute#"$top"/}") ;; esac
    done
    [ "${#touched[@]}" -eq 0 ] ||
      claim_family_anchors "$directory" "$directory" "$workdir" "$top" "$launcher" "${touched[@]#./}"
  fi
  if [ "${#elsewhere[@]}" -ne 0 ]; then
    local entry
    { cat "$directory/files-external" 2>/dev/null; printf '%s\n' "${elsewhere[@]##*$'\t'}"; } |
      sed '/^$/d' | sort -u >"$directory/files-external.tmp.$$" &&
      mv -f "$directory/files-external.tmp.$$" "$directory/files-external"
    for sub in "$directory"/families/*; do
      family=''
      paths=()
      for entry in "${elsewhere[@]}"; do
        [ "${entry%%$'\t'*}" = "$sub" ] || continue
        entry=${entry#*$'\t'}
        family=${entry%%$'\t'*}
        physical=${entry#*$'\t'}
        paths+=("${physical#"$family"/}")
      done
      [ -z "$family" ] || claim_family_anchors "$directory" "$sub" "$family" "$family" "$launcher" "${paths[@]}"
    done
  fi
  printf 'CLAIMED: %s path(s) for %s\nFILES:\n' "$((${#resolved[@]} + ${#elsewhere[@]}))" "$run_id"
  head -n 20 "$directory/files" 2>/dev/null
}

# What a vendor actually drives a browser through is a native-messaging host the BROWSER spawned,
# so a host belonging to the other browser can never answer for this one: parentage is the test,
# never the mere presence of a socket.
browse_real_home() {
  local home
  home=$(dscl . -read "/Users/$(id -un)" NFSHomeDirectory 2>/dev/null | sed -n 's/^NFSHomeDirectory: //p')
  [ -n "$home" ] || home="/Users/$(id -un)"
  [ -d "$home" ] || home="$HOME"
  printf '%s' "$home"
}

browse_codex_config() { # real-home
  if [ -n "${BROWSE_CODEX_CONFIG:-}" ]; then
    printf '%s' "$BROWSE_CODEX_CONFIG"
  elif [ -f "$HOME/.codex/config.toml" ] || [ ! -f "$1/.codex/config.toml" ]; then
    printf '%s' "$HOME/.codex/config.toml"
  else
    printf '%s' "$1/.codex/config.toml"
  fi
}

# Sets CUA_REPL_STATUS (registered|repaired|broken) and, when broken, CUA_REPL_ERROR.
cua_repl_sync() { # codex-config
  local sync_cmd="${BROWSE_CUA_SYNC:-$SCRIPT_DIRECTORY/codex-cua-repl-sync}" sync_rc=0 sync_stderr
  CUA_REPL_STATUS=broken CUA_REPL_ERROR=''
  sync_stderr=$(mktemp "${TMPDIR:-/tmp}/worker-run-cua.XXXXXX") || fail 'could not capture cua_repl diagnostics'
  BROWSE_CODEX_CONFIG="$1" "$sync_cmd" --check >/dev/null 2>"$sync_stderr" || sync_rc=$?
  if [ "$sync_rc" -eq 0 ]; then
    CUA_REPL_STATUS=registered
  elif [ "$sync_rc" -eq 1 ] && BROWSE_CODEX_CONFIG="$1" "$sync_cmd" >/dev/null 2>"$sync_stderr"; then
    CUA_REPL_STATUS=repaired
  fi
  if [ "$CUA_REPL_STATUS" = broken ]; then
    IFS= read -r CUA_REPL_ERROR <"$sync_stderr" || :
    CUA_REPL_ERROR=${CUA_REPL_ERROR:-sync exited without diagnostics}
  fi
  rm -f "$sync_stderr"
}

sky_running() {
  local pgrep_cmd="${BROWSE_PGREP:-pgrep}"
  [ "${BROWSE_SKIP_PROCESSES:-0}" = 1 ] ||
    $pgrep_cmd -x SkyComputerUseService >/dev/null 2>&1 || $pgrep_cmd -f SkyComputerUseService >/dev/null 2>&1
}

sky_ensure() { # real-home -> running|started|absent
  local sky_app="${BROWSE_SKY_APP:-}" deadline
  if sky_running; then printf running; return 0; fi
  if [ -z "$sky_app" ]; then
    sky_app="$HOME/.codex/computer-use/Codex Computer Use.app"
    [ -d "$sky_app" ] || sky_app="$1/.codex/computer-use/Codex Computer Use.app"
  fi
  if [ -d "$sky_app" ]; then
    ${BROWSE_OPEN:-open} "$sky_app" >/dev/null 2>&1 || true
    deadline=$(( $(date +%s) + 15 ))
    while [ "$(date +%s)" -le "$deadline" ]; do
      if sky_running; then printf started; return 0; fi
      sleep 0.25
    done
  fi
  printf absent
}

browse_browser_pids() { # ps-listing app-path
  awk -v app="$2" '
    { pid = $1; sub(/^[[:space:]]*[0-9]+[[:space:]]+[0-9]+[[:space:]]+/, "")
      if (index($0, app) && index($0, "--type=") == 0) print pid }' <<<"$1"
}

# The host is matched by the command it IS, never by a fragment a sibling can also carry: a browser
# spawns dozens of children, and only the extension host's socket answers for this vendor.
browse_host_pids() { # ps-listing command-regex parent-pid...
  local listing="$1" pattern="$2"
  shift 2
  awk -v pattern="$pattern" -v parents=" $* " '
    { pid = $1; ppid = $2; sub(/^[[:space:]]*[0-9]+[[:space:]]+[0-9]+[[:space:]]+/, "")
      if ($0 ~ pattern && index(parents, " " ppid " ")) print pid }' <<<"$listing"
}

browse_transport_present() { # vendor app-path
  local vendor="$1" app="$2" listing pids host sock_dir lsof_cmd="${BROWSE_LSOF:-lsof}"
  listing=$("${BROWSE_PS:-ps}" -Ao pid=,ppid=,command= 2>/dev/null) || return 1
  pids=$(browse_browser_pids "$listing" "$app")
  [ -n "$pids" ] || return 1
  if [ "$vendor" = claudeb ]; then
    sock_dir="${BROWSE_CLAUDE_SOCKET_DIR:-/tmp/claude-mcp-browser-bridge-$(id -un)}"
    for host in $(browse_host_pids "$listing" 'claude.*[[:space:]]--chrome-native-host([[:space:]]|$)' $pids); do
      [ -e "$sock_dir/$host.sock" ] && return 0
    done
    return 1
  fi
  sock_dir="${BROWSE_CODEX_SOCKET_DIR:-/tmp/codex-browser-use}"
  [ -d "$sock_dir" ] || return 1
  for host in $(browse_host_pids "$listing" 'ChatGPT for Chrome([[:space:]]|$)' $pids); do
    # The socket is named by a rotating uuid, so only the host's own open files tie one to this
    # browser; where lsof cannot be asked, the parentage stands alone.
    command -v "$lsof_cmd" >/dev/null 2>&1 || return 0
    "$lsof_cmd" -p "$host" 2>/dev/null | grep -qF "$sock_dir/" && return 0
  done
  return 1
}

browse_device_cache() (
  local operation="$1" device="$2" account="$3"
  local browse_dir="${WORKER_RUN_DIR:-$HOME/.cache/claude-worker-runs}/browse"
  local dev_file="$browse_dir/devices.json" lock="$browse_dir/devices.lock.d" tmp_file deadline owner mtime now
  mkdir -p "$browse_dir" || return 1
  deadline=$((SECONDS + 10))
  while :; do
    if mkdir "$lock" 2>/dev/null; then
      printf '%s\n' "$$" >"$lock/pid" || { rm -rf "$lock"; return 1; }
      break
    fi
    owner=''
    read -r owner 2>/dev/null <"$lock/pid" || owner=''
    mtime=$(stat -f %m "$lock" 2>/dev/null || stat -c %Y "$lock" 2>/dev/null) || mtime=0
    now=$(date +%s)
    if [ -z "$owner" ] || ! kill -0 "$owner" 2>/dev/null ||
       { [ "$mtime" -gt 0 ] && [ $((now - mtime)) -gt 60 ]; }; then
      rm -rf "$lock" 2>/dev/null
      continue
    fi
    [ "$SECONDS" -lt "$deadline" ] || return 1
    sleep 0.05
  done
  trap 'rm -rf "$lock" 2>/dev/null; [ -z "${tmp_file:-}" ] || rm -f "$tmp_file"' EXIT
  local existing='{}'
  [ ! -f "$dev_file" ] || existing=$(cat "$dev_file") || return 1
  tmp_file=$(mktemp "$dev_file.XXXXXX") || return 1
  jq --arg op "$operation" --arg dev "$device" --arg acct "$account" \
    --arg seen "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" '
      if $op == "record" then . + {($dev): ((.[$dev] // {} | {profile, profile_seen} | with_entries(select(.value != null)))
        + {account: $acct, seen: $seen})}
      elif $op == "profile" then
        with_entries(if .key != $dev and .value.profile == $acct then .value |= del(.profile, .profile_seen) else . end)
        | .[$dev] = ((.[$dev] // {}) + {profile: $acct, profile_seen: $seen})
      elif $op == "broken" then .[$dev] = ((.[$dev] // {}) + {health: "broken", health_seen: $seen})
      elif $op == "drop" and (.[$dev] == null or .[$dev].account == $acct or .[$dev].denied == true) then
        . + {($dev): ((.[$dev] // {} | {profile, profile_seen, health, health_seen} | with_entries(select(.value != null)))
          + {account: $acct, seen: $seen, denied: true,
          denied_accounts: (((.[$dev].denied_accounts // [.[$dev] | select(.denied == true) | .account]) + [$acct]) | unique)})}
      elif $op == "drop" then
        .[$dev] += {denied_accounts: (((.[$dev].denied_accounts // []) + [$acct]) | unique), denied_seen: $seen}
      else . end
    ' <<<"$existing" >"$tmp_file" && mv -f "$tmp_file" "$dev_file"
)

browse_ext_read() {
  local key value
  BROWSE_EXT_DEVICE='' BROWSE_EXT_ACCOUNT='' BROWSE_EXT_DEVICE_KNOWN=false
  while IFS=$'\t' read -r key value; do
    case "$key" in
      bridgeDeviceId) BROWSE_EXT_DEVICE=$value BROWSE_EXT_DEVICE_KNOWN=true ;;
      accountUuid) BROWSE_EXT_ACCOUNT=$value ;;
    esac
  done < <(python3 "$SCRIPT_DIRECTORY/../share/ext_leveldb.py" "$1" bridgeDeviceId accountUuid 2>/dev/null)
}

browse_ext_account() {
  local account_uuid json
  account_uuid=$(LC_ALL=C grep -Eo "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" <<<"$1" | head -n 1)
  [ -n "$account_uuid" ] || return 0
  for json in "${CLAUDEB_PROFILES_ROOT:-$HOME/.claude-profiles}"/*/.claude.json; do
    [ -f "$json" ] || continue
    [ "$(jq -r '.oauthAccount.accountUuid // empty' "$json" 2>/dev/null)" = "$account_uuid" ] || continue
    json=${json%/.claude.json}
    printf '%s\n' "${json##*/}"
    return 0
  done
}

# The extension's own sign-in names the account outright; the cache only remembers probes, so a
# denial recorded under one sign-in must not shadow the account the extension holds now.
browse_device_account() {
  local dev_file="$1" device="$2" ext_account="$3" existing='{}'
  [ ! -f "$dev_file" ] || existing=$(cat "$dev_file" 2>/dev/null) || existing='{}'
  jq -r --arg dev "$device" --arg ext "$ext_account" --argjson ttl "${BROWSE_BROKEN_TTL:-86400}" '
    (.[$dev] // {}) as $e
    | ($e.denied_accounts // (if $e.denied == true then [$e.account] else [] end)) as $d
    | (if $ext != "" then $ext else ($e.account // "") end) as $a
    | (if $e.health == "broken" and (($e.health_seen // "" | try fromdateiso8601 catch 0) > (now - $ttl))
       then $e.health_seen else "" end) as $b
    | "\($a)|\(($a != "") and ($d | index($a)) != null)|\($b)"
  ' <<<"$existing" 2>/dev/null || printf '%s|false|\n' "$ext_account"
}

browse_profile_device() { # dev_file profile-key
  [ -f "$1" ] || return 0
  jq -r --arg p "$2" '[to_entries[] | select(.value.profile == $p)] | max_by(.value.profile_seen) | .key // empty' "$1" 2>/dev/null
}

browse_cache_output() {
  local line device account
  local uuid='[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}'
  local acct='[A-Za-z0-9][A-Za-z0-9_.-]*'
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ "$line" =~ ^BROWSER-DEVICE-ACCOUNT:[[:blank:]]+($uuid)[[:blank:]]+($acct)[[:space:]]*$ ]]; then
      device=${BASH_REMATCH[1]} account=${BASH_REMATCH[2]}
      browse_device_cache record "$device" "$account" || true
    elif [[ "$line" =~ ^OUTCOME:[[:blank:]]+BROWSER_DEVICE_NOT_IN_ACCOUNT[[:blank:]]+device=($uuid)[[:blank:]]+account=($acct)[[:space:]]*$ ]]; then
      device=${BASH_REMATCH[1]} account=${BASH_REMATCH[2]}
      browse_device_cache drop "$device" "$account" || true
    elif [[ "$line" =~ ^OUTCOME:[[:blank:]]+BROWSER_TABS_BROKEN[[:blank:]]+device=($uuid)[[:space:]]*$ ]]; then
      browse_device_cache broken "${BASH_REMATCH[1]}" '' || true
    fi
  done
}

run_result_text() {
  if [ -f "$1/result" ]; then cat "$1/result"; return; fi
  case "$2" in
    claudeb) jq -r '.result // empty' "$1/out" 2>/dev/null ;;
    grok) grok_result_text "$1" ;;
    *) cat "$1/out" 2>/dev/null ;;
  esac
}

# The families besides the workdir's this run may write in — its --add-dir trees — each get a
# before-listing under `families/<n>/`, and in a round a run-start of their own. Folded from the
# workdir alone, a fix that also edits them never anchors there.
snapshot_other_families() { # directory workdir launcher round add-dir...
  local directory="$1" workdir="$2" launcher="$3" round="$4" seen candidate common top sub n=0 branch sibling
  shift 4
  seen=$(git -C "$workdir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || seen=''
  branch=$(linked_worktree_branch "$workdir")
  while IFS= read -r candidate; do
    [ -n "$candidate" ] && [ -d "$candidate" ] || continue
    common=$(git -C "$candidate" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || continue
    top=$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null) || continue
    [ -n "$common" ] && [ -n "$top" ] || continue
    if [ -n "$branch" ] && sibling=$(same_branch_worktree "$top" "$branch"); then top=$sibling; fi
    grep -qxF -- "$common" <<<"$seen" && continue
    seen="$seen"$'\n'"$common"
    n=$((n + 1))
    sub="$directory/families/$n"
    mkdir -p "$sub" 2>/dev/null && printf '%s\n' "$top" >"$sub/top" 2>/dev/null || continue
    snapshot_workdir "$sub" "$top" before 2>/dev/null || continue
    printf '%s\n' "$common" >"$sub/anchors-common" 2>/dev/null || :
    [ -z "$round" ] ||
      review_anchors run-start --repo "$top" --run "${directory##*/}" --session "$launcher" >/dev/null 2>&1 || :
  done < <(printf '%s\n' "$@")
}

# Only the directories are resolved, never the last component: a claimed symlink names itself, and a
# deleted path still resolves through its deepest surviving ancestor.
physical_path() { # absolute-path
  local head="${1%/*}" tail="/${1##*/}" resolved
  while [ -n "$head" ] && [ ! -d "$head" ]; do
    tail="/${head##*/}$tail"
    head=${head%/*}
  done
  resolved=$(cd "${head:-/}" 2>/dev/null && pwd -P) || return 1
  printf '%s%s\n' "${resolved%/}" "$tail"
}

# The run's transcript-named paths outside its workdir's repository that fall under TOP, top-relative.
external_top_paths() { # directory top
  local top row resolved
  top=$(cd "$2" 2>/dev/null && pwd -P) || return 0
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    resolved=$(physical_path "$row") || continue
    case "$resolved" in "$top"/*) printf '%s\n' "${resolved#"$top"/}" ;; esac
  done <"$1/files-external"
} 2>/dev/null

# One family's fold: the changed set and bases from the before/after listings in SNAP, plus what the
# run left at each path, so a fix anchor is never written over content a co-tenant moved since.
# PATHs given narrow the fold to them (a claim); otherwise a round fix owns only what the run's own
# records name, since the snapshot diff also holds every concurrent run's edits in the family.
fold_family_anchors() { # directory snap repo top launcher round [path...]
  local directory="$1" snap="$2" changed pairs entry base after owned='' i
  local -a fold paths bases afters only=("${@:7}")
  fold=(run-fold --repo "$3" --run "${directory##*/}" --session "$5" --round "$6" --owned)
  paths=()
  if [ "${#only[@]}" -ne 0 ]; then
    owned=$(printf '%s\n' "${only[@]}")
  else
    [ "$snap" != "$directory" ] || owned=$(listing_top_paths "$directory" "$4" "$3")
    owned+=$'\n'$(external_top_paths "$directory" "$4")
  fi
  while IFS= read -r entry; do
    [ -z "$entry" ] || fold+=("./$entry")
  done <<<"$owned"
  if changed=$(snapshot_changed_paths "$snap" "$4" 2>/dev/null) &&
    { [ "${#only[@]}" -eq 0 ] || changed=$(grep -xF -f <(printf '%s\n' "${only[@]}") <<<"$changed"); true; } &&
    pairs=$(snapshot_pairs "$snap" "$4" <<<"$changed" 2>/dev/null); then
    # What each path stood at before this run: its own dirty-before blob, else the content the
    # HEAD it started from held, else nothing at all. Only a path the store has no anchor for
    # reads it, so a wrong base cannot move a path a review already knows.
    while IFS=$'\t' read -r base after entry; do
      [ -n "$entry" ] || continue
      paths+=("$entry")
      bases+=("$base")
      afters+=("$after")
    done <<<"$pairs"
    if [ "${#paths[@]}" -ne 0 ]; then
      fold+=(--changed)
      for entry in "${paths[@]}"; do
        fold+=("./$entry")
      done
      for i in "${!paths[@]}"; do
        entry=${paths[$i]} base=${bases[$i]} after=${afters[$i]}
        [ "$base" = - ] && base=$EMPTY_BLOB
        [ "$after" = - ] && after=$EMPTY_BLOB
        fold+=("--base=./$entry=$base" "--after=./$entry=$after")
      done
    fi
  fi
  review_anchors "${fold[@]}" >/dev/null 2>&1 || :
}

# What a round fixer changed, told to the anchors store from the one path that runs whatever the run's
# end was — a clean exit, a nonzero one, an operator's kill, the launch timeout. The changed set is
# the run's OWN before/after listings and never the transcript's `files`/`produced`: a heredoc no
# tool call names still moved content.
# A round run's record in a family whose checkout is gone is dropped in its main checkout: left
# open, `review-anchors check` reads it as a dead run forever.
fold_gone_checkout() { # directory anchors-common-file launcher round
  local common workdir=''
  IFS= read -r common <"$2" 2>/dev/null || common=''
  case "$common" in */.git) workdir=$(git -C "${common%/.git}" rev-parse --show-toplevel 2>/dev/null) ;; esac
  [ -z "$workdir" ] ||
    review_anchors run-fold --repo "$workdir" --run "${1##*/}" --session "$3" --round "$4" --owned >/dev/null 2>&1 || :
}

fold_run_anchors() { # directory
  local directory="$1" launcher workdir top round sub
  launcher=''
  [ -f "$directory/launcher" ] && IFS= read -r launcher <"$directory/launcher"
  round=$(jq -r '.review_round // empty' "$directory/meta.json" 2>/dev/null) || round=''
  [ -n "$launcher" ] && [ -n "$round" ] || return 0
  workdir=$(jq -r '.workdir // empty' "$directory/meta.json" 2>/dev/null) || workdir=''
  [ "$workdir" != null ] || workdir=''
  top=''
  [ -z "$workdir" ] || top=$(git -C "$workdir" rev-parse --show-toplevel 2>/dev/null) || top=''
  if [ -n "$top" ] && [ ! -e "$directory/head-before" ] && [ ! -e "$directory/dirty-before-shas" ] &&
    [ ! -e "$directory/anchors-common" ]; then
    # Born during the run: nothing in it predates the run and no review anchors it.
    :
  elif [ -n "$top" ]; then
    fold_family_anchors "$directory" "$directory" "$workdir" "$top" "$launcher" "$round"
  elif [ -f "$directory/anchors-common" ]; then
    fold_gone_checkout "$directory" "$directory/anchors-common" "$launcher" "$round"
  fi
  for sub in "$directory"/families/*; do
    [ -f "$sub/top" ] || continue
    IFS= read -r top <"$sub/top" 2>/dev/null || continue
    if ! git -C "$top" rev-parse --show-toplevel >/dev/null 2>&1; then
      fold_gone_checkout "$directory" "$sub/anchors-common" "$launcher" "$round"
      continue
    fi
    [ -f "$sub/dirty-after-shas" ] || snapshot_workdir "$sub" "$top" after 2>/dev/null || :
    fold_family_anchors "$directory" "$sub" "$top" "$top" "$launcher" "$round"
  done
}

complete_run() {
  local directory="$1" code="$2" vendor run_status
  local -a result_status
  fold_run_anchors "$directory"
  vendor=$(jq -r .vendor "$directory/meta.json")
  if [ ! -f "$directory/result" ]; then
    if jq -e '.browser == true or .chrome == true' "$directory/meta.json" >/dev/null 2>&1; then
      run_result_text "$directory" "$vendor" | tee "$directory/result.tmp.$$" | browse_cache_output
      result_status=("${PIPESTATUS[@]}")
      if [ "${result_status[0]}" = 0 ]; then
        mv -f "$directory/result.tmp.$$" "$directory/result"
      else
        rm -f "$directory/result.tmp.$$"
      fi
    else
      if run_result_text "$directory" "$vendor" >"$directory/result.tmp.$$"; then
        mv -f "$directory/result.tmp.$$" "$directory/result"
      else
        rm -f "$directory/result.tmp.$$"
      fi
    fi
  fi
  stamp_result_language "$directory"
  print_outcome "$directory" "$vendor" "$code"
  lang_line "$directory"
  run_status=$(terminal_status "$directory" "$vendor" "$code")
  write_run_state "$directory" "$run_status" "$code"
  journal_worker_run "$directory" "$run_status" "$code"
}

browse_run() {
  local browse_vendor='' browse_dia_profile='' browse_account='' browse_record_device='' browse_record_account=''
  local browse_json=false browse_target='' browse_no_launch=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --vendor)
        [ "$#" -ge 2 ] || usage
        browse_vendor="$2"
        case "$browse_vendor" in
          codex|claudeb) ;;
          *) fail "unknown vendor for browse: $browse_vendor" ;;
        esac
        shift 2
        ;;
      --target)
        [ "$#" -ge 2 ] || usage
        browse_target="$2"
        case "$browse_target" in dia|chrome) ;; *) usage ;; esac
        shift 2
        ;;
      --no-launch)
        browse_no_launch=true
        shift
        ;;
      --dia-profile)
        [ "$#" -ge 2 ] || usage
        browse_dia_profile="$2"
        shift 2
        ;;
      --account)
        [ "$#" -ge 2 ] || usage
        browse_account="$2"
        shift 2
        ;;
      --record)
        [ "$#" -ge 3 ] || usage
        browse_record_device="$2"
        browse_record_account="$3"
        shift 3
        ;;
      --json)
        browse_json=true
        shift
        ;;
      *) usage ;;
    esac
  done
  # A literal, and the only place one is spelled: no environment variable or config key flips the
  # default for a whole machine. Chrome is automation's own browser; Dia is the one Egor watches.
  if [ -z "$browse_target" ]; then
    browse_target=chrome
    [ -z "$browse_dia_profile" ] || browse_target=dia
  fi

  local real_home
  real_home=$(browse_real_home)

  local browse_dir="${WORKER_RUN_DIR:-$HOME/.cache/claude-worker-runs}/browse"
  local dev_file="$browse_dir/devices.json"
  if [ -n "$browse_record_device" ] && [ -n "$browse_record_account" ]; then
    browse_device_cache record "$browse_record_device" "$browse_record_account" ||
      fail 'could not record browser device account'
  fi

  local pgrep_cmd="${BROWSE_PGREP:-pgrep}"
  local open_cmd="${BROWSE_OPEN:-open}"

  local dia_user_data="${BROWSE_DIA_USER_DATA:-}"
  if [ -z "$dia_user_data" ]; then
    if [ -d "$HOME/Library/Application Support/Dia/User Data" ]; then
      dia_user_data="$HOME/Library/Application Support/Dia/User Data"
    elif [ -d "$real_home/Library/Application Support/Dia/User Data" ]; then
      dia_user_data="$real_home/Library/Application Support/Dia/User Data"
    else
      dia_user_data="$HOME/Library/Application Support/Dia/User Data"
    fi
  fi

  local dia_profile_name='' dia_profile_dir='' dia_profile_reason=''
  local dia_device_id='' dia_device_name='' dia_device_reason='' dia_ext_account=''
  local -a dia_profiles=() dia_names=() dia_devices=() dia_device_names=() dia_accounts=() dia_ext_accounts=()
  local -a dia_broken=() dia_cache_reasons=()
  local local_state="$dia_user_data/Local State"
  if [ ! -f "$local_state" ]; then
    dia_profile_reason='dia profile unreadable — Local State missing'
  elif ! jq -e . "$local_state" >/dev/null 2>&1; then
    dia_profile_reason='dia profile unreadable — Local State invalid JSON'
  else
    while IFS= read -r dia_profile_dir; do
      [ -n "$dia_profile_dir" ] || continue
      dia_profile_name=$(jq -r --arg d "$dia_profile_dir" '.profile.info_cache[$d].name // $d' "$local_state")
      dia_device_id='' dia_device_name='' dia_ext_account=''
      local ext_settings="$dia_user_data/$dia_profile_dir/Local Extension Settings/fcoeoabgfenejglbffodgkkbkcdhcgfn"
      if [ -d "$ext_settings" ]; then
        browse_ext_read "$ext_settings"
        if [ -n "$BROWSE_EXT_DEVICE" ]; then
          dia_device_id=$(LC_ALL=C grep -Eo "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" <<<"$BROWSE_EXT_DEVICE" | head -n 1)
          dia_device_name=$(LC_ALL=C sed -E -n "s/.*[dD]?isplayName[^\"]*\"([^\"]+)\".*/\1/p" <<<"$BROWSE_EXT_DEVICE")
        fi
        [ -z "$dia_device_id" ] || dia_ext_account=$(browse_ext_account "$BROWSE_EXT_ACCOUNT")
        if [ -n "$dia_device_id" ]; then
          [ "$(jq -r --arg d "$dia_device_id" '.[$d].profile // empty' "$dev_file" 2>/dev/null)" = "dia:$dia_profile_dir" ] ||
            browse_device_cache profile "$dia_device_id" "dia:$dia_profile_dir" || true
        elif [ "$BROWSE_EXT_DEVICE_KNOWN" = false ]; then
          dia_device_id=$(browse_profile_device "$dev_file" "dia:$dia_profile_dir")
          [ -z "$dia_device_id" ] ||
            dia_cache_reasons+=("REASON: dia/$dia_profile_name device $dia_device_id read from the cache — the extension storage names none")
        fi
      fi
      dia_ext_accounts+=("$dia_ext_account")
      dia_profiles+=("$dia_profile_dir")
      dia_names+=("$dia_profile_name")
      dia_devices+=("$dia_device_id")
      dia_device_names+=("$dia_device_name")
    done < <(jq -r --arg forced "$browse_dia_profile" '
      if $forced != "" then
        [if (.profile.info_cache // {}) | has($forced) then $forced
         else ((.profile.info_cache // {}) | to_entries | map(select(.value.name == $forced)) | .[0].key) // $forced end]
      else [.profile.last_used, (.profile.last_active_profiles // [])[]] end
      | map(select(type == "string" and length > 0))
      | reduce .[] as $d ([]; if index($d) == null then . + [$d] else . end) | .[]
    ' "$local_state")
    [ "${#dia_profiles[@]}" -gt 0 ] || dia_profile_reason='dia profile unreadable — profile.last_used missing'
  fi

  local chrome_user_data="${BROWSE_CHROME_USER_DATA:-}"
  if [ -z "$chrome_user_data" ]; then
    if [ -d "$HOME/Library/Application Support/Google/Chrome" ]; then
      chrome_user_data="$HOME/Library/Application Support/Google/Chrome"
    elif [ -d "$real_home/Library/Application Support/Google/Chrome" ]; then
      chrome_user_data="$real_home/Library/Application Support/Google/Chrome"
    else
      chrome_user_data="$HOME/Library/Application Support/Google/Chrome"
    fi
  fi

  local chrome_profile_dir='' chrome_profile_name='' chrome_device_id='' chrome_device_name='' chrome_ext_account=''
  local chrome_ext_dir chrome_scan_dir chrome_last
  local uuid_re='[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}'
  if [ -d "$chrome_user_data" ]; then
    for chrome_ext_dir in "$chrome_user_data"/*/"Local Extension Settings/fcoeoabgfenejglbffodgkkbkcdhcgfn"; do
      [ -d "$chrome_ext_dir" ] || continue
      browse_ext_read "$chrome_ext_dir"
      chrome_last=$BROWSE_EXT_DEVICE
      [ -n "$chrome_last" ] || continue
      chrome_device_id=$(LC_ALL=C grep -Eo "$uuid_re" <<<"$chrome_last" | head -n 1)
      [ -n "$chrome_device_id" ] || continue
      chrome_device_name=$(LC_ALL=C sed -E -n 's/.*[dD]?isplayName[^"]*"([^"]+)".*/\1/p' <<<"$chrome_last")
      chrome_ext_account=$(browse_ext_account "$BROWSE_EXT_ACCOUNT")
      chrome_scan_dir=${chrome_ext_dir%/Local Extension Settings/*}
      chrome_profile_dir=${chrome_scan_dir##*/}
      break
    done
    if [ -z "$chrome_profile_dir" ]; then
      # No Claude device does not mean no target: the Codex path drives the ChatGPT extension, and
      # its profile is the one a `--target chrome` run has to be launched into.
      for chrome_ext_dir in "$chrome_user_data"/*/"Local Extension Settings/hehggadaopoacecdllhhajmbjkdcmajg"; do
        [ -d "$chrome_ext_dir" ] || continue
        chrome_scan_dir=${chrome_ext_dir%/Local Extension Settings/*}
        chrome_profile_dir=${chrome_scan_dir##*/}
        break
      done
    fi
    if [ -n "$chrome_profile_dir" ] && [ -f "$chrome_user_data/Local State" ]; then
      chrome_profile_name=$(jq -r --arg d "$chrome_profile_dir" '.profile.info_cache[$d].name // empty' \
        "$chrome_user_data/Local State" 2>/dev/null) || chrome_profile_name=''
    fi
  fi
  local chrome_profile_label="${chrome_profile_dir:-unknown}"
  [ -z "$chrome_profile_name" ] || chrome_profile_label="$chrome_profile_name ($chrome_profile_dir)"

  local target_label='Dia' target_app='Dia.app/Contents/MacOS/Dia' target_ext_url='dia://extensions'
  local off_label='Google Chrome'
  if [ "$browse_target" = chrome ]; then
    target_label='Google Chrome'
    target_app='Google Chrome.app/Contents/MacOS/Google Chrome'
    target_ext_url='chrome://extensions'
    off_label='Dia'
  fi

  local dia_status='absent' chrome_status='absent' launched='' launch_timeout=''
  local launch_wait="${BROWSE_LAUNCH_TIMEOUT:-25}"
  if [ "${BROWSE_SKIP_PROCESSES:-0}" = 1 ]; then
    dia_status='running'
    if [ "$browse_target" = chrome ]; then
      chrome_status="${BROWSE_CHROME_STATUS:-running}"
    else
      chrome_status="${BROWSE_CHROME_STATUS:-absent}"
    fi
  else
    if $pgrep_cmd -x Dia >/dev/null 2>&1 || $pgrep_cmd -f Dia.app/Contents/MacOS/Dia >/dev/null 2>&1; then
      dia_status='running'
    fi
    if [ -n "${BROWSE_CHROME_STATUS:-}" ]; then
      chrome_status="$BROWSE_CHROME_STATUS"
    elif $pgrep_cmd -x "Google Chrome" >/dev/null 2>&1 ||
         $pgrep_cmd -f "Google Chrome.app/Contents/MacOS/Google Chrome" >/dev/null 2>&1; then
      chrome_status='running'
    fi
    local target_absent=false
    if [ "$browse_target" = chrome ]; then
      [ "$chrome_status" != absent ] || target_absent=true
    else
      [ "$dia_status" != absent ] || target_absent=true
    fi
    if [ "$target_absent" = true ] && [ "$browse_no_launch" = false ]; then
      # The TARGET and nothing else: Egor's other browser is his, and a preflight that opens it has
      # already broken the one rule `--target` exists to keep.
      if [ "$browse_target" = chrome ]; then
        if [ -n "$chrome_profile_dir" ]; then
          $open_cmd -g -a "Google Chrome" --args --profile-directory="$chrome_profile_dir" >/dev/null 2>&1 || true
        else
          $open_cmd -g -a "Google Chrome" >/dev/null 2>&1 || true
        fi
      else
        $open_cmd -g -a Dia --args --enable-applescript-javascript >/dev/null 2>&1 || true
      fi
      local deadline=$(( $(date +%s) + 15 ))
      while [ "$(date +%s)" -le "$deadline" ]; do
        if $pgrep_cmd -x "$target_label" >/dev/null 2>&1 || $pgrep_cmd -f "$target_app" >/dev/null 2>&1; then
          launched="$browse_target"
          break
        fi
        sleep 0.25
      done
      if [ -n "$launched" ]; then
        if [ "$browse_target" = chrome ]; then chrome_status='launched'; else dia_status='launched'; fi
        # A browser that is up is not yet a browser a worker can drive: the extension's native host
        # is spawned after the window, and until its socket exists every vendor call answers nothing.
        local -a wait_vendors=(codex claudeb)
        [ -z "$browse_vendor" ] || wait_vendors=("$browse_vendor")
        local wait_deadline=$(( $(date +%s) + launch_wait )) wait_vendor
        launch_timeout="$launch_wait"
        while :; do
          for wait_vendor in "${wait_vendors[@]}"; do
            if browse_transport_present "$wait_vendor" "$target_app"; then launch_timeout=''; break; fi
          done
          [ -n "$launch_timeout" ] || break
          [ "$(date +%s)" -lt "$wait_deadline" ] || break
          sleep 0.5
        done
      fi
    fi
  fi
  local target_status="$dia_status"
  [ "$browse_target" != chrome ] || target_status="$chrome_status"
  local applescript_js=off
  if [ "$browse_target" = chrome ]; then
    [ "$(jq -r '.browser.allow_javascript_apple_events // false' \
      "$chrome_user_data/${chrome_profile_dir:-Default}/Preferences" 2>/dev/null)" != true ] || applescript_js=on
  elif [ "$dia_status" != absent ]; then
    local ps_listing dia_pid
    ps_listing=$("${BROWSE_PS:-ps}" -Ao pid=,ppid=,command= 2>/dev/null) || ps_listing=''
    for dia_pid in $(browse_browser_pids "$ps_listing" 'Dia.app/Contents/MacOS/Dia'); do
      awk -v pid="$dia_pid" '$1 == pid' <<<"$ps_listing" | grep -q -- '--enable-applescript-javascript' &&
        applescript_js=on
    done
  fi

  local -a reasons_list=("${dia_cache_reasons[@]}")
  cua_repl_sync "$(browse_codex_config "$real_home")"
  local cua_repl_status=$CUA_REPL_STATUS
  [ "$cua_repl_status" != broken ] ||
    reasons_list+=("REASON: codex skipped — cua_repl registration failed: $CUA_REPL_ERROR")

  local manifest_status='missing' manifest_path='' manifest_tmp
  local chrome_manifest="${BROWSE_CHROME_MANIFEST:-}"
  local native_host="${BROWSE_NATIVE_HOST:-}"
  if [ -z "$chrome_manifest" ]; then
    chrome_manifest="$HOME/Library/Application Support/Google/Chrome/NativeMessagingHosts/com.anthropic.claude_code_browser_extension.json"
    if [ ! -f "$chrome_manifest" ] &&
       [ -f "$real_home/Library/Application Support/Google/Chrome/NativeMessagingHosts/com.anthropic.claude_code_browser_extension.json" ]; then
      chrome_manifest="$real_home/Library/Application Support/Google/Chrome/NativeMessagingHosts/com.anthropic.claude_code_browser_extension.json"
    fi
  fi
  if [ -z "$native_host" ]; then
    native_host="$HOME/.claude/chrome/chrome-native-host"
    if [ ! -x "$native_host" ] && [ -x "$real_home/.claude/chrome/chrome-native-host" ]; then
      native_host="$real_home/.claude/chrome/chrome-native-host"
    fi
  fi
  if [ ! -f "$chrome_manifest" ]; then
    reasons_list+=("REASON: claudeb skipped — native messaging manifest missing")
  else
    manifest_path=$(jq -r '.path // empty' "$chrome_manifest" 2>/dev/null)
    if [ -f "$manifest_path" ] && [ -x "$manifest_path" ]; then
      manifest_status=ok
    elif [ -f "$native_host" ] && [ -x "$native_host" ]; then
      manifest_status=broken
      manifest_tmp=$(mktemp "$chrome_manifest.XXXXXX") || manifest_tmp=''
      if [ -n "$manifest_tmp" ] && jq --arg host "$native_host" '.path = $host' "$chrome_manifest" >"$manifest_tmp" &&
         mv -f "$manifest_tmp" "$chrome_manifest"; then
        manifest_status=repaired
        reasons_list+=("REASON: manifest path repaired: $manifest_path -> $native_host")
      else
        reasons_list+=("REASON: claudeb skipped — native messaging manifest repair failed")
      fi
      [ -z "$manifest_tmp" ] || rm -f "$manifest_tmp"
    else
      manifest_status=broken
      reasons_list+=("REASON: claudeb skipped — native host missing at ${manifest_path:-$native_host}")
    fi
  fi

  local sky_status=absent
  ! sky_running || sky_status=running

  local wp_cmd="${BROWSE_WORKER_PICK:-${WORKER_RUN_WORKER_PICK:-worker-pick}}"
  local wp_raw=''
  wp_raw=$("$wp_cmd" 2>&1) || true

  local -a usable_claude=() usable_codex=()
  local -A claude_exclusions=() vendor_state=()
  local current_v='' line acct rest flag_reason reset_str stripped tok vname

  while IFS= read -r line; do
    case "$line" in
      codex:*) current_v=codex ;;
      claude:*) current_v=claude ;;
      " "*) ;;
      *) current_v="" ;;
    esac
    [ -n "$current_v" ] || continue
    case "$(sed -e 's/^[[:space:]]*//' <<<"$line")" in \**) continue ;; esac

    acct='' rest='' flag_reason='' reset_str=''
    stripped="${line#$current_v:}"
    stripped=$(sed -e "s/^[[:space:]]*//" <<<"$stripped")
    case "$stripped" in
      pin[[:space:]]*) continue ;;
      unavailable|"off for workers"|"no accounts"|"no quota data"|"every account is out of the worker pool"*)
        vendor_state[$current_v]=$stripped
        continue
        ;;
    esac
    if [ "${#line}" -ge 58 ] && grep -Eq "^.{9,36}(%|-)" <<<"$line"; then
      acct=$(cut -c 38-58 <<<"$line" | tr -d "[:space:]*")
      rest=$(cut -c 59- <<<"$line")
    else
      rest="$stripped"
      for tok in $stripped; do
        case "$tok" in
          *%|*d|*h|↺*|WALLED|PINNED|5h!|off|blocked|login|needed|auth|expired|opus*|astra*|f38*|grok*|low|med*|high|xhigh|auto|-|–|\?|\*|pin)
            ;;
          *)
            acct=${tok%\*}
            break
            ;;
        esac
      done
    fi

    [ -n "$acct" ] || continue

    if [[ "$rest" =~ ↺[[:space:]]*([^[:space:]]+([[:space:]]+[^[:space:]]+)?) ]]; then
      reset_str="${BASH_REMATCH[1]}"
    fi

    if [[ "$rest" =~ (^|[[:space:]])off([[:space:]]|$) ]]; then
      flag_reason="out of pool"
    elif [[ "$rest" =~ (^|[[:space:]])WALLED([[:space:]]|$) ]]; then
      # The ↺ column is the weekly reset, not the wall's end; llm-limits owns reset times.
      flag_reason="walled"
    elif [[ "$rest" =~ (^|[[:space:]])login[[:space:]]+needed([[:space:]]|$) ]]; then
      flag_reason="login needed"
    elif [[ "$rest" =~ (^|[[:space:]])blocked([[:space:]]|$) ]]; then
      flag_reason="blocked"
    elif [[ "$rest" =~ (^|[[:space:]])auth[[:space:]]+expired([[:space:]]|$) ]]; then
      flag_reason="auth expired"
    fi

    vname="$current_v"
    [ "$vname" != claude ] || vname=claudeb

    if [ -n "$flag_reason" ]; then
      reasons_list+=("REASON: $vname/$acct skipped — $flag_reason")
      [ "$current_v" != claude ] || claude_exclusions[$acct]="$flag_reason"
    else
      if [ "$current_v" = claude ]; then
        usable_claude+=("$acct")
      elif [ "$current_v" = codex ]; then
        usable_codex+=("$acct")
      fi
    fi
  done <<<"$wp_raw"

  local is_cached=false cached_acct='' cached_denied=false cached_broken='' any_cached=false selected=0 i a active_reason
  local rank best_rank=9 dia_other_json='[]'
  local -a dia_other_lines=() dia_ranks=()
  for i in "${!dia_profiles[@]}"; do
    cached_acct='' cached_denied=false cached_broken='' rank=''
    if [ -n "${dia_devices[$i]}" ]; then
      IFS='|' read -r cached_acct cached_denied cached_broken < <(browse_device_account "$dev_file" "${dia_devices[$i]}" "${dia_ext_accounts[$i]}")
      [ "$cached_denied" = true ] || cached_denied=false
    fi
    dia_accounts+=("$cached_acct")
    dia_broken+=("$cached_broken")
    if [ "$cached_denied" = false ] && [ -n "$cached_acct" ]; then
      any_cached=true
      for a in "${usable_claude[@]}"; do
        [ "$a" = "$cached_acct" ] || continue
        if [ -n "$browse_account" ] && [ "$cached_acct" = "$browse_account" ]; then rank=0
        elif [ -z "$cached_broken" ]; then rank=1
        else rank=2; fi
        break
      done
      if [ -n "$rank" ] && [ "$rank" -lt "$best_rank" ]; then selected=$i; best_rank=$rank; is_cached=true; fi
    fi
    dia_ranks+=("$rank")
  done
  dia_profile_dir="${dia_profiles[$selected]:-}" dia_profile_name="${dia_names[$selected]:-}"
  dia_device_id="${dia_devices[$selected]:-}" dia_device_name="${dia_device_names[$selected]:-}"
  cached_acct="${dia_accounts[$selected]:-}"
  if [ "$selected" -ne 0 ] && [ "$browse_target" = dia ]; then
    active_reason=unknown
    if [ -n "${dia_ranks[0]}" ] && [ -n "${dia_broken[0]}" ]; then
      active_reason="device ${dia_devices[0]} could not open a tab (marked ${dia_broken[0]})"
    elif [ -n "${dia_ranks[0]}" ]; then
      active_reason="is not the run's account $browse_account"
    elif [ -n "${dia_accounts[0]}" ]; then
      active_reason="${claude_exclusions[${dia_accounts[0]}]:-out of pool}"
    fi
    reasons_list+=("REASON: dia/${dia_names[0]} skipped — account ${dia_accounts[0]:-unknown} $active_reason")
  fi
  if [ "$browse_target" = dia ] && [ "$best_rank" = 2 ]; then
    reasons_list+=("REASON: dia/$dia_profile_name device $dia_device_id could not open a tab (marked ${dia_broken[$selected]}) and no healthy device has a usable account")
  fi
  for i in "${!dia_profiles[@]}"; do
    [ "$i" -ne "$selected" ] || continue
    dia_other_lines+=("DIA-OTHER: ${dia_names[$i]} (${dia_profiles[$i]}) ${dia_devices[$i]:-none} ${dia_accounts[$i]:+account=}${dia_accounts[$i]:-unknown}")
    dia_other_json=$(jq --arg name "${dia_names[$i]}" --arg dir "${dia_profiles[$i]}" \
      --arg device "${dia_devices[$i]}" --arg account "${dia_accounts[$i]}" \
      '. + [{name:$name, dir:$dir, device:$device, account:(if $account == "" then null else $account end)}]' <<<"$dia_other_json")
  done
  local target_device_id="$dia_device_id" target_device_name="$dia_device_name"
  local target_profile_dir="$dia_profile_dir"
  local target_profile_label="${dia_profile_name:-${dia_profile_dir:-unknown}}"
  local -a off_devices=()
  if [ "$browse_target" = chrome ]; then
    target_device_id="$chrome_device_id" target_device_name="$chrome_device_name"
    target_profile_dir="$chrome_profile_dir" target_profile_label="${chrome_profile_name:-${chrome_profile_dir:-unknown}}"
    for i in "${!dia_devices[@]}"; do
      [ -z "${dia_devices[$i]}" ] || off_devices+=("${dia_devices[$i]}")
    done
    # Chrome carries one extension profile, so the whole cached/denied question is that one
    # device's; the Dia profile walk above answered a question about another browser.
    is_cached=false any_cached=false cached_acct=''
    if [ -n "$target_device_id" ]; then
      IFS='|' read -r cached_acct cached_denied cached_broken < <(browse_device_account "$dev_file" "$target_device_id" "$chrome_ext_account")
      [ "$cached_denied" != true ] || cached_acct=''
      [ -z "$cached_broken" ] ||
        reasons_list+=("REASON: chrome device $target_device_id could not open a tab (marked $cached_broken)")
    fi
    if [ -n "$cached_acct" ]; then
      any_cached=true
      for a in "${usable_claude[@]}"; do
        [ "$a" = "$cached_acct" ] || continue
        is_cached=true
        break
      done
    fi
  else
    [ -z "$chrome_device_id" ] || off_devices+=("$chrome_device_id")
  fi
  local off_str='none'
  [ "${#off_devices[@]}" -eq 0 ] || off_str=$(IFS=,; printf '%s' "${off_devices[*]}")
  if [ -z "$target_device_id" ]; then
    dia_device_reason="no claude extension device in ${target_profile_dir:-unknown} — extension not installed or never logged in"
  fi
  [ -z "$dia_profile_reason" ] || reasons_list+=("REASON: $dia_profile_reason")
  [ -z "$dia_device_reason" ] || reasons_list+=("REASON: $dia_device_reason")
  if [ "$is_cached" = true ]; then
    local -a reordered=("$cached_acct")
    for a in "${usable_claude[@]}"; do
      [ "$a" = "$cached_acct" ] || reordered+=("$a")
    done
    usable_claude=("${reordered[@]}")
  elif [ "$any_cached" = true ]; then
    reasons_list+=("REASON: claudeb skipped — no open $target_label device has a usable cached account")
  fi
  local denied_list='' denied_seen='' signin_needed=false d
  local -a denied_accts=()
  if [ -n "$target_device_id" ] && [ -f "$dev_file" ]; then
    denied_list=$(jq -r --arg dev "$target_device_id" '(.[$dev] // {}) as $e
      | ($e.denied_accounts // (if $e.denied == true then [$e.account // empty] else [] end)) | join(" ")' "$dev_file" 2>/dev/null)
    denied_seen=$(jq -r --arg dev "$target_device_id" '.[$dev] // {} | if .denied == true then .seen // empty else .denied_seen // empty end' "$dev_file" 2>/dev/null)
  fi
  read -r -a denied_accts <<<"$denied_list"
  if [ "${#denied_accts[@]}" -gt 0 ]; then
    for d in "${denied_accts[@]}"; do
      reasons_list+=("REASON: claudeb/$d skipped — device $target_device_id not visible (probe failed ${denied_seen:-unknown})")
    done
    if [ "${#usable_claude[@]}" -gt 0 ]; then
      local -a denied_first=() denied_last=()
      for a in "${usable_claude[@]}"; do
        if [[ " $denied_list " == *" $a "* ]]; then denied_last+=("$a"); else denied_first+=("$a"); fi
      done
      usable_claude=("${denied_first[@]}" "${denied_last[@]}")
    fi
  fi
  # A device no pool account can see is a login, and a login is Egor's to make: naming the browser,
  # the profile and the accounts is the whole of what this preflight may do about it.
  if [ -n "$target_device_id" ] && [ "${#usable_claude[@]}" -gt 0 ]; then
    if [ "$any_cached" = true ] && [ "$is_cached" = false ]; then
      signin_needed=true
    elif [ "${#denied_accts[@]}" -gt 0 ]; then
      signin_needed=true
      for a in "${usable_claude[@]}"; do
        [[ " $denied_list " == *" $a "* ]] || { signin_needed=false; break; }
      done
    fi
  fi
  if [ "$signin_needed" = true ]; then
    reasons_list+=("REASON: sign in the Claude extension in $target_label ($target_profile_label) as $(IFS=,; printf '%s' "${usable_claude[*]}") — device $target_device_id is visible to no pool account")
  fi
  local codex_transport=true
  if [ "$browse_vendor" != claudeb ] && [ "${BROWSE_SKIP_PROCESSES:-0}" != 1 ] &&
     [ "$target_status" != absent ] && ! browse_transport_present codex "$target_app"; then
    codex_transport=false
    reasons_list+=("REASON: codex skipped — the ChatGPT extension is not connected in $target_label ($target_profile_label); enable it at $target_ext_url and sign in")
  fi
  if [ -n "$launch_timeout" ]; then
    local waited_for='Claude or ChatGPT'
    case "$browse_vendor" in
      claudeb) waited_for=Claude ;;
      codex) waited_for=ChatGPT ;;
    esac
    reasons_list+=("REASON: $target_label launched but the $waited_for extension did not connect within ${launch_timeout}s — open $target_label's extensions page and check the extension is enabled in $target_profile_label")
  fi
  [ "${#usable_claude[@]}" -gt 0 ] || reasons_list+=("REASON: claudeb skipped — ${vendor_state[claude]:-no usable accounts}")
  [ "${#usable_codex[@]}" -gt 0 ] || reasons_list+=("REASON: codex skipped — ${vendor_state[codex]:-no usable accounts}")

  local plan_vendor='none' plan_account='' plan_device='' plan_source=''
  local codex_ok=false claudeb_ok=false
  if [ "${#usable_codex[@]}" -gt 0 ] && [ "$cua_repl_status" != broken ] && [ "$codex_transport" = true ]; then
    codex_ok=true
  fi
  if [ -n "$target_device_id" ] && [ "${#usable_claude[@]}" -gt 0 ] && [ "$signin_needed" = false ] &&
     [[ "$manifest_status" = ok || "$manifest_status" = repaired ]] &&
     { [ "$is_cached" = true ] || [ "$any_cached" = false ]; }; then
    claudeb_ok=true
  fi
  if [ "$target_status" = absent ] || [ -n "$launch_timeout" ]; then
    [ "$target_status" != absent ] || reasons_list+=("REASON: $browse_target not running")
  else
    if [ "$browse_vendor" != codex ] && [ "$claudeb_ok" = true ]; then
      plan_vendor='claudeb'
      plan_account="${usable_claude[0]}"
      plan_device="$target_device_id"
      if [ "$is_cached" = true ]; then plan_source='cached'; else plan_source='probe'; fi
    elif [ "$browse_vendor" != claudeb ] && [ "$codex_ok" = true ]; then
      plan_vendor='codex'
      plan_account="${usable_codex[0]}"
    fi
  fi
  [ "$plan_vendor" != codex ] || [ "$sky_status" != absent ] || sky_status=$(sky_ensure "$real_home")

  local preamble_file=''
  mkdir -p "$browse_dir"
  find "$browse_dir" -maxdepth 1 -name 'preamble-*.md' -mmin +1440 -delete 2>/dev/null || true
  if [ "$plan_vendor" != none ]; then
    preamble_file=$(mktemp "$browse_dir/preamble-$(date +%s)-$$.XXXXXX") || fail 'could not create browser preamble'
    mv "$preamble_file" "$preamble_file.md" && preamble_file="$preamble_file.md"
    local target_pick off_pick target_hint
    target_hint="Dia profile \"${dia_profile_name:-unknown}\" (${dia_profile_dir:-unknown}); window title \"${dia_device_name:-Dia browser}\""
    if [ "$browse_target" = chrome ]; then
      target_hint="Chrome profile \"${chrome_profile_name:-unknown}\" (${chrome_profile_dir:-unknown})"
      if [ -n "$chrome_profile_name" ]; then
        target_pick="the \`extension\`-type entry whose \`profileName\` is \"$chrome_profile_name\" (Chrome ${chrome_profile_dir:-profile}); its \`family\` is \`chrome\`"
      else
        target_pick="the \`extension\`-type entry that HAS a \`profileName\` (Chrome ${chrome_profile_dir:-profile}); its \`family\` is \`chrome\`"
      fi
      off_pick="every \`extension\` entry WITHOUT a \`profileName\` is Dia"
    else
      target_pick="the \`extension\`-type entry WITHOUT a \`profileName\` (Dia is not in the plugin's browser registry, so its profile never resolves), confirmed by tab titles matching \`await cua.getApp(\"Dia\")\`"
      if [ -n "$chrome_profile_name" ]; then
        off_pick="the entry whose \`profileName\` is \"$chrome_profile_name\" is Google Chrome"
      else
        off_pick="the \`extension\` entry that HAS a \`profileName\` is Google Chrome"
      fi
    fi
    if [ "$plan_vendor" = codex ]; then
      cat >"$preamble_file" <<EOF
# Browser Automation Preamble (Codex / $target_label)

Drive Egor's visible browser ($target_label) using CUA REPL (\`js\` tool).

## Instructions
- First js call must be exactly: \`await cua.getState()\`
- Then \`await agent.browsers.list()\` and pick by the field named below; each entry carries \`{family?, id, name, type, profileName?, metadata?}\` and the ids rotate between runs, so never reuse one.
- Target ($target_label): $target_pick.
- Identification hints (not CUA ids): $target_hint. Anthropic bridge device UUIDs are irrelevant to \`cua\` — do not use them as CUA browser ids.
- Off-target: $off_pick — never drive it, never switch to it.
- Never drive $off_label. Never perform logins or credential entry.
- All test/probing navigations must use https://example.com (Dia blocks httpbin.org / postman-echo.com for extension tabs).
- Extension path first; use computer surface fallback (\`await cua.getApp("$target_label")\`, pressKey/typeText/getAXState) via SkyComputerUseService if needed.
- Close the tabs you created only once the task is complete; when you stop for Egor's input (sign-in, approval, a blocker) or the result is not final, leave them open and name the tab that holds the work.
- End the answer with: \`OUTCOME: BROWSER_OK_EXTENSION|BROWSER_OK_COMPUTER|BROWSER_UNAVAILABLE reason=<text>\`; a session Computer Use stopped for a disallowed URL ends with \`OUTCOME: BROWSER_UNAVAILABLE reason=disallowed-url url=<that tab's URL>\`.
EOF
    elif [ "$plan_vendor" = claudeb ]; then
      cat >"$preamble_file" <<EOF
# Browser Automation Preamble (Claudeb / $target_label)

Drive Egor's visible browser ($target_label) using Claude in Chrome extension.

## Instructions
- Call \`list_connected_browsers\` first.
- If target device \`$plan_device\` is listed, select it and continue.
- If target device is not listed, print exactly:
  \`OUTCOME: BROWSER_DEVICE_NOT_IN_ACCOUNT device=$plan_device account=$plan_account\`
  and stop immediately.
- Never \`switch_browser\` to an unlisted device, and never run pairing or login flows headless.
- After any extension reconnect or tool error, call \`list_connected_browsers\` again and re-select \`$plan_device\` before the next action: a reconnect silently falls back to the account's default browser.
- If \`tabs_context_mcp\` (\`createIfEmpty: true\`) or the first \`navigate\` fails twice on \`$plan_device\`, re-selecting it in between, print exactly:
  \`OUTCOME: BROWSER_TABS_BROKEN device=$plan_device\`
  and stop: the device cannot open a tab, and the next preflight ranks it last.
- Off-target extension device IDs ($off_label — never drive one, never \`switch_browser\` to it): $off_str
- Target $target_label device ID: $plan_device
- Never drive $off_label.
- All test/probing navigations must use https://example.com.
- On success print \`BROWSER-DEVICE-ACCOUNT: $plan_device $plan_account\` and end with \`OUTCOME: BROWSER_OK\`.
- Close the tabs you created only once the task is complete; when you stop for Egor's input (sign-in, approval, a blocker) or the result is not final, leave them open and name the tab that holds the work.
EOF
    fi
  fi

  if [ "$browse_json" = true ]; then
    local claude_json codex_json reasons_json plan_json
    claude_json=$(printf '%s\n' "${usable_claude[@]}" | jq -R . | jq -s 'map(select(length > 0))')
    if [ "${#usable_codex[@]}" -gt 0 ]; then
      codex_json=$(printf '"%s"' "${usable_codex[0]}")
    else
      codex_json=null
    fi
    reasons_json=$(printf '%s\n' "${reasons_list[@]}" | sed 's/^REASON: //' | jq -R . | jq -s 'map(select(length > 0))')
    if [ "$plan_vendor" != none ]; then
      plan_json=$(jq -n --arg v "$plan_vendor" --arg a "$plan_account" --arg d "$plan_device" --arg s "$plan_source" \
        '{vendor:$v, account:$a} + (if $d != "" then {device:$d, source:$s} else {} end)')
    else
      plan_json=null
    fi
    jq -n \
      --arg dia "$dia_status" \
      --arg dia_p_name "$dia_profile_name" \
      --arg dia_p_dir "$dia_profile_dir" \
      --arg dia_dev_id "$dia_device_id" \
      --arg dia_dev_name "$dia_device_name" \
      --argjson dia_other "$dia_other_json" \
      --arg target "$browse_target" \
      --arg applescript_js "$applescript_js" \
      --arg chrome_dev_id "$chrome_device_id" \
      --arg chrome_dev_name "$chrome_device_name" \
      --arg chrome_p_name "$chrome_profile_name" \
      --arg chrome_p_dir "$chrome_profile_dir" \
      --arg launched "$launched" \
      --arg chrome "$chrome_status" \
      --arg manifest "$manifest_status" \
      --arg cua "$cua_repl_status" \
      --arg sky "$sky_status" \
      --argjson claude "$claude_json" \
      --argjson codex "$codex_json" \
      --argjson reasons "$reasons_json" \
      --argjson plan "$plan_json" \
      --arg preamble "$preamble_file" \
      '{
        dia: $dia,
        dia_profile: (if $dia_p_dir != "" then {name: $dia_p_name, dir: $dia_p_dir} else null end),
        dia_device: (if $dia_dev_id != "" then {id: $dia_dev_id, display_name: $dia_dev_name} else null end),
        dia_other: $dia_other,
        target: $target,
        applescript_js: $applescript_js,
        chrome_device: (if $chrome_dev_id != "" then {id: $chrome_dev_id, display_name: $chrome_dev_name} else null end),
        chrome_profile: (if $chrome_p_dir != "" then {name: $chrome_p_name, dir: $chrome_p_dir} else null end),
        chrome: $chrome,
        launched: (if $launched != "" then $launched else null end),
        manifest: $manifest,
        cua_repl: $cua,
        sky: $sky,
        next_claude_accounts: $claude,
        next_codex_account: $codex,
        reasons: $reasons,
        plan: $plan,
        preamble_file: (if $preamble != "" then $preamble else null end)
      }'
  else
    printf 'TARGET: %s\n' "$browse_target"
    printf 'APPLESCRIPT-JS: %s\n' "$applescript_js"
    printf 'DIA: %s\n' "$dia_status"
    if [ -n "$dia_profile_dir" ]; then
      printf 'DIA-PROFILE: %s (%s)\n' "$dia_profile_name" "$dia_profile_dir"
    else
      printf 'DIA-PROFILE: unknown\n'
    fi
    if [ -n "$dia_device_id" ]; then
      printf 'DIA-DEVICE: %s "%s"\n' "$dia_device_id" "${dia_device_name:-Dia browser}"
    else
      printf 'DIA-DEVICE: none\n'
    fi
    for line in "${dia_other_lines[@]}"; do printf '%s\n' "$line"; done
    if [ -n "$chrome_device_id" ]; then
      printf 'CHROME-DEVICE: %s "%s"\n' "$chrome_device_id" "${chrome_device_name:-Chrome browser}"
    else
      printf 'CHROME-DEVICE: none\n'
    fi
    printf 'CHROME-PROFILE: %s\n' "$chrome_profile_label"
    printf 'CHROME: %s\n' "$chrome_status"
    [ -z "$launched" ] || printf 'LAUNCHED: %s\n' "$launched"
    printf 'MANIFEST: %s\n' "$manifest_status"
    printf 'CUA-REPL: %s\n' "$cua_repl_status"
    printf 'SKY: %s\n' "$sky_status"
    if [ "${#usable_claude[@]}" -gt 0 ]; then
      local IFS=,
      printf 'NEXT-CLAUDE-ACCOUNTS: %s\n' "${usable_claude[*]}"
    else
      printf 'NEXT-CLAUDE-ACCOUNTS: none\n'
    fi
    if [ "${#usable_codex[@]}" -gt 0 ]; then
      printf 'NEXT-CODEX-ACCOUNT: %s\n' "${usable_codex[0]}"
    else
      printf 'NEXT-CODEX-ACCOUNT: none\n'
    fi
    for r in "${reasons_list[@]}"; do
      printf '%s\n' "$r"
    done
    if [ "$plan_vendor" = codex ]; then
      printf 'PLAN: codex account=%s\n' "$plan_account"
    elif [ "$plan_vendor" = claudeb ]; then
      printf 'PLAN: claudeb account=%s device=%s source=%s\n' "$plan_account" "$plan_device" "$plan_source"
    else
      printf 'PLAN: none\n'
    fi
    if [ -n "$preamble_file" ]; then
      printf 'PREAMBLE-FILE: %s\n' "$preamble_file"
    fi
    if [ -n "$browse_record_device" ] && [ -n "$browse_record_account" ]; then
      printf 'RECORDED: %s %s\n' "$browse_record_device" "$browse_record_account"
    fi
  fi

  [ "$plan_vendor" != none ] || return 2
  return 0
}

# Inside Claude Code a run belongs to the relay agent whose Bash call worker-tag-hook.sh stamped with
# WORKER_RUN_RELAY=<agent-type>:<agent-id>[:attach]; a main chat's script, eval, interpreter, Monitor
# or background shell carries none, whatever the text gates read. Unset before anything launches: the
# worker a run spawns inherits this environment, and a worker is never a relay. Egor's own shell and
# launchd carry no CLAUDECODE and stay open.
RELAY_TYPE='' RELAY_AGENT='' RELAY_ATTACH=false
relay_door() { # subcommand
  local token=${WORKER_RUN_RELAY:-} rest
  unset WORKER_RUN_RELAY
  case "$1" in start | wait) ;; *) return 0 ;; esac
  [ -n "${CLAUDECODE:-}${CLAUDE_CODE_ENTRYPOINT:-}" ] || [ "${CLAUDEB_WORKER:-}" = 1 ] || return 0
  RELAY_TYPE=${token%%:*}
  rest=${token#*:}
  RELAY_AGENT=${rest%%:*}
  case "$token" in *:attach) RELAY_ATTACH=true ;; esac
  case "$RELAY_TYPE" in
    claudeb-worker | codex-worker | gemini-worker | grok-worker | light-worker | light-research | end-report | code-doctor-judge) ;;
    *) RELAY_TYPE='' ;;
  esac
  if [ -z "$RELAY_TYPE" ] || [ "$token" = "$RELAY_TYPE" ] || [[ ! "$RELAY_AGENT" =~ ^[A-Za-z0-9_-]+$ ]]; then
    fail "\`worker-run $1\` runs only inside the relay agent that owns the run — the owner is what draws its magenta task row and wakes the chat when it ends. Spawn the Agent instead: claudeb-worker, codex-worker, gemini-worker, grok-worker or light-worker (light-research for a read-only research brief), the vendor worker-pick's NEXT row names; it runs worker-run itself. A run already in flight is re-attached by the same agent type with a brief starting \`ATTACH <run-id>:\`. A script, eval, interpreter, Monitor or background shell reaching worker-run is this same launch. Nothing was launched and no account was spent."
  fi
  case "$RELAY_TYPE" in end-report | code-doctor-judge) ;; *) [ -n "${CLAUDE_AGENT_ID:-}" ] || CLAUDE_AGENT_ID=$RELAY_AGENT ;; esac
}

# The run a relay starts is the one its agent type names: a claudeb-worker relabelled as a codex run,
# or any relay asking for the research role, would spend a vendor or a role the spawn gates priced
# for something else. An ATTACH relay waits on a run in flight and starts nothing.
relay_start_door() { # vendor role
  [ -n "$RELAY_TYPE" ] || return 0
  [ "$RELAY_ATTACH" = false ] ||
    fail "this $RELAY_TYPE was spawned with an \`ATTACH <run-id>:\` brief: it waits on that run (\`worker-run wait <run-id>\`) and starts nothing. A new run needs a new spawn with its own brief. Nothing was launched and no account was spent."
  case "$RELAY_TYPE:$1:$2" in
    claudeb-worker:claudeb:workers | codex-worker:codex:workers | gemini-worker:gemini:workers | \
      grok-worker:grok:workers | light-worker:light:workers | light-research:*:research | end-report:*:workers | code-doctor-judge:*:workers) ;;
    light-research:*)
      fail "a light-research relay starts research runs only, through light-research itself. Nothing was launched and no account was spent." ;;
    *:*:research)
      fail "the research role belongs to the light-research Agent: a $RELAY_TYPE runs \`worker-run start ${RELAY_TYPE%-worker}\` as a worker. Nothing was launched and no account was spent." ;;
    *)
      fail "a $RELAY_TYPE relay starts \`worker-run start ${RELAY_TYPE%-worker}\`, not \`$1\`: another vendor is another relay, spawned from the chat as that vendor's Agent. Nothing was launched and no account was spent." ;;
  esac
}

CONFIG_FILE="${WORKER_RUN_CONFIG_FILE:-$HOME/.claude/worker-model}"
export WORKER_PICK_CONFIG_FILE="${WORKER_PICK_CONFIG_FILE:-$CONFIG_FILE}"
CODEX_CONFIG="${WORKER_RUN_CODEX_CONFIG:-$HOME/.codex/config.toml}"
# Every arm exits from inside the case: workers edit this very file while their
# own supervisor and the caller's `wait` are still running it, and bash re-reads
# the script from a byte offset once the last top-level command returns — a file
# that changed size since then parses as garbage, so a finished run dies with a
# syntax error and exit 2 (live-caught: a successful codex run reported EXIT: 2).
relay_door "${1:-}"
case "${1:-}" in
  start) shift; start_run "$@"; exit $? ;;
  wait) shift; wait_run "$@"; exit $? ;;
  report) shift; report_run "$@"; exit $? ;;
  transcript) shift; transcript_run "$@"; exit $? ;;
  claim) shift; claim_run "$@"; exit $? ;;
  say) shift; say_run "$@"; exit $? ;;
  browse) shift; browse_run "$@"; exit $? ;;
  _deliver) complete_run "$2" "$3"; exit 0 ;;
  _chrome-runs) chrome_runs; exit 0 ;;
  _supervise) shift; supervise "$@"; rc=$?; end_run_orphans "$1"; slot_release "$NIGHT_SLOT"; exit "$rc" ;;
  *) usage ;;
esac
exit; }

#!/usr/bin/env bash
# claudeb — multi-account launcher for Claude Code.
# See ~/.claude-profiles/README.md before changing anything: snapshot schema and
# account==profile naming are shared with the limits and statusline surfaces.
set -euo pipefail

resolve_root() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}
claudeb_root=$(resolve_root)
. "$claudeb_root/share/worker-pool.sh"
. "$claudeb_root/share/worker-model.sh"

base_dir="${CLAUDEB_DIR:-$HOME/.claude-profiles/.claudeb}"
tokens_dir="$base_dir/tokens"
limits_dir="$base_dir/limits"
state_file="$base_dir/.claudeb-state"
pool_dir="$base_dir"
disabled_file="$(worker_pool_file "$pool_dir")"

account_names() {
  local path
  if [ -d "$tokens_dir" ]; then
    for path in "$tokens_dir"/*; do
      if [ -f "$path" ]; then
        basename "$path"
      fi
    done | LC_ALL=C sort
  fi
}

# Two independent ways a profile becomes real: `add` writes a setup token, a browser login
# writes only the keychain entry. Judging by either alone would call a freshly logged-in
# profile unclaimed, or keep a token-less typo forever.
profile_has_credentials() {
  # `set -e` is on, so the tri-state return must be captured, never left as a bare call.
  local state=0
  profile_credentials_state "$1" || state=$?
  [ "$state" -eq 0 ]
}

# 0 = has credentials, 1 = provably absent, 2 = cannot tell. The third state is the point:
# a locked keychain (errSecInteractionNotAllowed) or a missing `security` is not evidence of
# an unclaimed profile, and anything that deletes on that assumption destroys a live account.
# Only 44 (item not found) is a real "no".
profile_credentials_state() {
  local name="$1" rc
  [ -f "$tokens_dir/$name" ] && return 0
  command -v security >/dev/null 2>&1 || return 2
  security find-generic-password -s "$(keychain_service "$name")" >/dev/null 2>&1
  rc=$?
  case "$rc" in
    0) return 0 ;;
    44) return 1 ;;
    *) return 2 ;;
  esac
}

# Passed through the environment, not `-v`: awk expands escape sequences in a -v assignment,
# so a name holding a backslash would corrupt the assignment and print nothing.
edit_distance() {
  ED_A="$1" ED_B="$2" awk 'BEGIN {
    a = ENVIRON["ED_A"]; b = ENVIRON["ED_B"]
    la = length(a); lb = length(b)
    for (i = 0; i <= la; i++) d[i, 0] = i
    for (j = 0; j <= lb; j++) d[0, j] = j
    for (i = 1; i <= la; i++) for (j = 1; j <= lb; j++) {
      c = (substr(a, i, 1) == substr(b, j, 1)) ? 0 : 1
      m = d[i-1, j] + 1; n = d[i, j-1] + 1; o = d[i-1, j-1] + c
      d[i, j] = (m < n ? (m < o ? m : o) : (n < o ? n : o))
    }
    print d[la, lb]
  }'
}

# Names within two edits of the target — enough for a doubled or dropped letter (the way
# `notccom` happened) without dragging in every short name.
similar_names() {
  local target="$1" name out='' dist
  shift
  for name in "$@"; do
    [ "$name" != "$target" ] || continue
    dist=$(edit_distance "$target" "$name" || true)
    [[ "$dist" =~ ^[0-9]+$ ]] || continue
    [ "$dist" -le 2 ] || continue
    out="${out:+$out, }$name"
  done
  printf '%s' "$out"
}

# Read line by line rather than word-splitting: a directory created outside `claudeb add`
# can hold a space, and splitting would compare against fragments of it.
similar_account_names() {
  local target="$1" name out='' dist
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    [ "$name" != "$target" ] || continue
    dist=$(edit_distance "$target" "$name" || true)
    [[ "$dist" =~ ^[0-9]+$ ]] || continue
    [ "$dist" -le 2 ] || continue
    out="${out:+$out, }$name"
  done < <(account_names)
  printf '%s' "$out"
}

file_mtime() {
  stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null
}

lock_acquire() {
  local lock="$1" tries=0 now mt
  local max="${2:-${CLAUDEB_LOCK_RETRIES:-10}}" delay="${CLAUDEB_LOCK_DELAY:-0.2}"
  [[ "$max" =~ ^[1-9][0-9]*$ ]] || max=10
  while ! mkdir "$lock" 2>/dev/null; do
    tries=$((tries + 1))
    # Stale-break during the wait too — a ~40s waiter must not sit behind a crashed holder.
    if [ "$tries" -ge "$max" ] || [ "$((tries % 25))" -eq 0 ]; then
      now=$(date +%s) || return 1
      mt=$(file_mtime "$lock" 2>/dev/null) || mt="$now"
      if [[ "$mt" =~ ^[0-9]+$ ]] && [ "$((now - mt))" -gt 30 ]; then
        rm -rf "$lock" 2>/dev/null && continue
      fi
      [ "$tries" -ge "$max" ] && return 1
    fi
    sleep "$delay" 2>/dev/null || return 1
  done
  return 0
}

lock_release() {
  [ -n "$1" ] || return 0
  rmdir "$1" 2>/dev/null || true
}

account_data() {
  local name="$1" file="$limits_dir/$1.json" now modified age
  now=$(date +%s)
  modified=0
  age=-1
  if [ -r "$file" ] && jq -e 'type == "object"' "$file" >/dev/null 2>&1; then
    modified=$(stat -f %m "$file" 2>/dev/null || stat -c %Y "$file" 2>/dev/null || printf '0')
    age=$((now - modified))
    jq -c --arg name "$name" --argjson now "$now" --argjson age "$age" --argjson mtime "$modified" '
      def number_or_zero: if type == "number" then . else 0 end;
      def reset: if type == "number" then . else 0 end;
      # Header-origin week = never measured (shared-invariants n) — week unknown.
      (if (.seven_day.origin? == "headers") then del(.seven_day) else . end) |
      # Age is observation age (as_of), same metric as the menu/table — file mtime
      # moves on verdict merges without fresh data and would show younger than truth.
      (if (.five_hour.as_of | type) == "number" then ($now - .five_hour.as_of) else $age end) as $age |
      (.auth.status // "") as $auth |
      def is_stale($b; $thr):
        ($auth == "expired") or (($b.origin? // "") == "cached")
        or (($now - ($b.as_of? // $mtime)) > $thr);
      (.five_hour.resets_at | reset) as $hreset |
      (.seven_day.resets_at | reset) as $wreset |
      (.fable.resets_at | reset) as $freset |
      (if $hreset > $now then (.five_hour.used_percentage | number_or_zero) else 0 end) as $h5 |
      (if $wreset > $now then (.seven_day.used_percentage | number_or_zero) else 0 end) as $wk |
      (if (.fable.used_percentage | type) == "number" and
          ($freset > $now or ($freset == 0 and .fable.used_percentage == 0))
       then .fable.used_percentage else null end) as $fable |
      {name: $name, h5: $h5, wk: $wk, hreset: $hreset, wreset: $wreset,
       fable: $fable, freset: $freset, age: $age,
       h5_raw: (.five_hour.used_percentage | number_or_zero),
       wk_raw: (if (.seven_day.used_percentage | type) == "number" then .seven_day.used_percentage else null end),
       fable_raw: (if (.fable.used_percentage | type) == "number" then .fable.used_percentage else null end),
       h5_dim: (($hreset <= $now) or is_stale(.five_hour; 1800)),
       wk_dim: (($wreset <= $now) or is_stale(.seven_day; 21600)),
       fable_dim: (($freset <= $now) or is_stale(.fable; 21600)),
       auth: (if $auth == "" then "ok" else $auth end),
       walled: ($h5 >= 97 or $wk >= 99)}' "$file"
  else
    jq -cn --arg name "$name" '{name: $name, h5: 0, wk: 0, hreset: 0, wreset: 0, fable: null, freset: 0, age: -1,
      h5_raw: 0, wk_raw: null, fable_raw: null, h5_dim: true, wk_dim: true, fable_dim: true, auth: "ok", walled: false}'
  fi
}

is_disabled() { worker_pool_is_disabled "$pool_dir" "$1"; }
set_disabled() { worker_pool_set_disabled "$pool_dir" "$1" "$2"; }

pinned_account() {
  worker_model_pinned_account claudeb_profile
}

pin_account() {
  worker_model_pin_account claudeb_profile claudeb account_names is_disabled "${1:-}"
}

selection() {
  local state="" data name result picked all_walled reset disabled_json sticky_disabled=false
  if ! account_names | grep -q .; then
    printf 'claudeb: no accounts configured; add one with `claudeb add <name>`\n' >&2
    exit 1
  fi
  [ -r "$state_file" ] && IFS= read -r state < "$state_file" || true
  disabled_json='[]'
  if [ -r "$disabled_file" ]; then
    disabled_json=$(jq -Rn '[inputs | select(length > 0)]' < "$disabled_file")
  fi
  if [ -r "$state_file" ] && { [ ! -e "$disabled_file" ] || [ "$state_file" -nt "$disabled_file" ]; }; then
    sticky_disabled=true
  fi
  data=""
  while IFS= read -r name; do
    data="${data}$(account_data "$name")"$'\n'
  done < <(account_names)
  result=$(printf '%s' "$data" | jq -sc --arg state "$state" --argjson disabled "$disabled_json" --argjson sticky_disabled "$sticky_disabled" '
    map(. + {disabled: (.name as $n | $disabled | any(. == $n))}) as $all |
    [$all[] | select(.disabled | not)] as $enabled |
    ($enabled | length) as $enabled_count |
    ($enabled_count > 0 and ($enabled | all(.walled))) as $all_walled |
    ($all | map(select(.name == $state and ((.disabled | not) or $sticky_disabled) and (.walled | not) and .h5 < 90)) | first) as $sticky |
    (if $sticky != null then $sticky
     elif $all_walled then $enabled | sort_by(.hreset, .name) | first
     else [$enabled[] | select(.walled | not)] | sort_by(.h5, .wk, .name) | first
     end) as $picked |
    {picked: $picked.name, all_walled: $all_walled, reset: $picked.hreset,
     enabled_count: $enabled_count, data: $all}')
  if [ "$(printf '%s' "$result" | jq -r .enabled_count)" -eq 0 ]; then
    printf 'claudeb: all accounts are disabled; enable one with `claudeb enable <name>`\n' >&2
    exit 1
  fi
  picked=$(printf '%s' "$result" | jq -r .picked)
  all_walled=$(printf '%s' "$result" | jq -r .all_walled)
  reset=$(printf '%s' "$result" | jq -r .reset)
  if [ "$all_walled" = true ]; then
    printf 'claudeb: warning: all accounts are walled; earliest 5h reset is %s\n' "$(format_time "$reset")" >&2
  fi
  printf '%s\n' "$result"
}

format_time() {
  local epoch="$1"
  if [ "$epoch" -gt 0 ] 2>/dev/null; then
    date -r "$epoch" '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null || date -d "@$epoch" '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null || printf 'unknown'
  else
    printf 'unknown'
  fi
}

format_reset_time() {
  local epoch="$1" now delta weekday
  local -a weekdays=(Sun Mon Tue Wed Thu Fri Sat)
  if ! [ "$epoch" -gt 0 ] 2>/dev/null; then printf 'unknown'; return; fi
  now=${CLAUDEB_NOW:-$(date +%s)}
  delta=$((epoch - now))
  if [ "$delta" -lt 604800 ]; then
    local epoch_day now_day
    epoch_day=$(date -r "$epoch" '+%Y-%m-%d' 2>/dev/null || date -d "@$epoch" '+%Y-%m-%d' 2>/dev/null)
    now_day=$(date -r "$now" '+%Y-%m-%d' 2>/dev/null || date -d "@$now" '+%Y-%m-%d' 2>/dev/null)
    if [ "$epoch_day" != "$now_day" ]; then
      weekday=$(date -r "$epoch" '+%w' 2>/dev/null || date -d "@$epoch" '+%w' 2>/dev/null) || { printf 'unknown'; return; }
      printf '%s ' "${weekdays[$weekday]}"
    fi
    date -r "$epoch" '+%H:%M' 2>/dev/null || date -d "@$epoch" '+%H:%M' 2>/dev/null || printf 'unknown'
  else
    date -r "$epoch" '+%m-%d %H:%M' 2>/dev/null || date -d "@$epoch" '+%m-%d %H:%M' 2>/dev/null || printf 'unknown'
  fi
}

format_age() {
  local seconds="$1"
  if [ "$seconds" -lt 0 ]; then printf 'unknown'
  elif [ "$seconds" -lt 60 ]; then printf '%ss' "$seconds"
  elif [ "$seconds" -lt 3600 ]; then printf '%sm' "$((seconds / 60))"
  elif [ "$seconds" -lt 86400 ]; then printf '%sh' "$((seconds / 3600))"
  else printf '%sd' "$((seconds / 86400))"
  fi
}

header_value() {
  local file="$1" key="$2"
  awk -v wanted="$key" '
    BEGIN { IGNORECASE = 1 }
    {
      sub(/\r$/, "")
      name = $0
      sub(/:.*/, "", name)
      if (tolower(name) == tolower(wanted)) {
        sub(/^[^:]*:[[:space:]]*/, "")
        value = $0
      }
    }
    END { print value }
  ' "$file"
}

# 5h only: this writer must never touch seven_day (shared-invariants n).
merge_headers() {
  local name="$1" headers="$2" file="$limits_dir/$1.json"
  local utilization hreset tmp lock cached='{}'
  utilization=$(header_value "$headers" anthropic-ratelimit-unified-5h-utilization)
  hreset=$(header_value "$headers" anthropic-ratelimit-unified-5h-reset)
  if ! jq -en --arg utilization "$utilization" --arg hreset "$hreset" '
    ($utilization | tonumber? // -1) as $u |
    ($hreset | tonumber? // 0) as $r |
    $u >= 0 and $u <= 1 and $r > 0' >/dev/null; then
    return 1
  fi
  mkdir -p "$limits_dir"
  lock="$file.lock"
  lock_acquire "$lock" || return 1
  (
    trap 'lock_release "$lock"' EXIT
    tmp="$limits_dir/.$name.json.$$"
    if [ -r "$file" ] && jq -e 'type == "object"' "$file" >/dev/null 2>&1; then
      cached=$(jq -c . "$file" 2>/dev/null) || cached='{}'
    fi
    if ! jq -n --arg utilization "$utilization" --arg hreset "$hreset" \
      --argjson old "$cached" --argjson now "$(date +%s)" '
        ($old | if (.seven_day.origin? == "headers") then del(.seven_day) else . end) +
        {five_hour: {
          used_percentage: (($utilization | tonumber) * 100 | round),
          resets_at: ($hreset | tonumber),
          as_of: $now, origin: "headers"
        }} +
        {auth: {status: "ok", checked_at: $now}}' > "$tmp" 2>/dev/null; then
      rm -f "$tmp"
      return 1
    fi
    if ! mv "$tmp" "$file"; then
      rm -f "$tmp"
      return 1
    fi
  )
}

merge_usage() {
  local name="$1" body="$2" file="$limits_dir/$1.json" tmp lock cached='{}'
  mkdir -p "$limits_dir"
  lock="$file.lock"
  lock_acquire "$lock" || return 1
  (
    trap 'lock_release "$lock"' EXIT
    tmp="$limits_dir/.$name.json.$$"
    if [ -r "$file" ] && jq -e 'type == "object"' "$file" >/dev/null 2>&1; then
      cached=$(jq -c . "$file" 2>/dev/null) || cached='{}'
    fi
    if ! jq --argjson old "$cached" --argjson now "$(date +%s)" '
    def epoch:
      capture("^(?<base>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(?:\\.[0-9]+)?(?:Z|\\+00:00)$") |
      (.base + "Z") | fromdateiso8601;
    ($old + {
      five_hour: {used_percentage: (.five_hour.utilization | round), resets_at: (.five_hour.resets_at | if . == null then 0 else epoch end), as_of: $now, origin: "usage"}
    } +
    (if (.seven_day.utilization | type) == "number" then
      {seven_day: {used_percentage: (.seven_day.utilization | round), resets_at: (.seven_day.resets_at | if . == null then 0 else epoch end), as_of: $now, origin: "usage"}}
     else {} end)) as $merged |
    [.limits[]? | select(.kind == "weekly_scoped" and .scope.model.display_name == "Fable")][0] as $fable |
    # The endpoint includes the Fable entry inconsistently: a 200 without it may
    # follow one that had a real percent, so a still-valid cached value wins over
    # the zero marker (resets_at 0 = "confirmed zero, no active window").
    (if $fable then $merged + {fable: {used_percentage: ($fable.percent | round), resets_at: ($fable.resets_at | if . == null then 0 else epoch end), as_of: $now, origin: "usage"}}
    elif ($merged.fable.resets_at? // 0) > $now then $merged + {fable: ($merged.fable + {origin: "cached"})}
    else $merged + {fable: {used_percentage: 0, resets_at: 0, as_of: $now, origin: "usage"}} end) +
    {auth: {status: "ok", checked_at: $now}} | del(.auth_needed, .auth_cause, .auth_checked_at)' \
      "$body" > "$tmp" 2>/dev/null; then
      rm -f "$tmp"
      return 1
    fi
    if ! mv "$tmp" "$file"; then
      rm -f "$tmp"
      return 1
    fi
  )
}

mark_auth() {
  local name="$1" status="$2" cause="${3:-}" require_status="${4:-}" file="$limits_dir/$1.json" tmp lock cached='{}'
  mkdir -p "$limits_dir"
  lock="$file.lock"
  lock_acquire "$lock" || return 0
  (
    trap 'lock_release "$lock"' EXIT
    tmp="$limits_dir/.$name.json.auth.$$"
    if [ -r "$file" ] && jq -e 'type == "object"' "$file" >/dev/null 2>&1; then
      cached=$(jq -c . "$file" 2>/dev/null) || cached='{}'
    fi
    if jq -cn --argjson old "$cached" --argjson now "$(date +%s)" --arg status "$status" --arg cause "$cause" \
      --arg require_status "$require_status" '
      if $require_status != "" and ($old.auth.status // "") != $require_status then $old
      else ($old + {auth: ({status: $status, checked_at: $now} + (if $cause == "" then {} else {cause: $cause} end))}
           | del(.auth_needed, .auth_cause, .auth_checked_at))
      end' > "$tmp" 2>/dev/null; then
      if [ "$(cat "$tmp")" = "$cached" ]; then rm -f "$tmp"; else mv "$tmp" "$file" || rm -f "$tmp"; fi
    else
      rm -f "$tmp"
    fi
  ) || true
}

# CLI-wipe signature: the Claude CLI blanks its own keychain OAuth blob
# (accessToken/refreshToken → "", expiresAt → 0) when its refresh fails, leaving
# a readable but empty credential. Both tokens empty/missing is affirmative local
# evidence the account is logged out — distinct from transient read weather, which
# never produces this shape. A garbage/unparseable blob is NOT this signature.
credentials_logged_out() {
  printf '%s' "$1" | jq -e '
    type == "object" and (.claudeAiOauth | type == "object") and
    ((.claudeAiOauth.accessToken // "") == "") and
    ((.claudeAiOauth.refreshToken // "") == "")' >/dev/null 2>&1
}

# The inverse signal used by `remove` to protect a still-usable login: a parseable
# blob carrying a non-empty accessToken or refreshToken is affirmative evidence the
# account can still authenticate, so removal refuses it without --force.
credentials_alive() {
  printf '%s' "$1" | jq -e '
    type == "object" and (.claudeAiOauth | type == "object") and
    (((.claudeAiOauth.accessToken // "") != "") or
     ((.claudeAiOauth.refreshToken // "") != ""))' >/dev/null 2>&1
}

# Record the logged-out ("login needed") verdict, mirroring Codex/Gemini's
# auth_needed flag. Preserves the last usage buckets for provenance and drops any
# stale auth.status so a wiped account never renders a cached "ok". Only callers
# with affirmative local evidence (empty-token wipe signature or keychain
# item-not-found, exit 44) may invoke this — never on 429/5xx/timeout weather.
mark_auth_needed() {
  local name="$1" cause="${2:-logged out}" file="$limits_dir/$1.json" tmp lock cached='{}'
  mkdir -p "$limits_dir"
  lock="$file.lock"
  lock_acquire "$lock" || return 0
  (
    trap 'lock_release "$lock"' EXIT
    tmp="$limits_dir/.$name.json.authneeded.$$"
    if [ -r "$file" ] && jq -e 'type == "object"' "$file" >/dev/null 2>&1; then
      cached=$(jq -c . "$file" 2>/dev/null) || cached='{}'
    fi
    if jq -cn --argjson old "$cached" --argjson now "$(date +%s)" --arg cause "$cause" '
      ($old | del(.auth)) + {auth_needed: true, auth_checked_at: $now}
      + (if $cause == "" then {} else {auth_cause: $cause} end)' > "$tmp" 2>/dev/null; then
      if [ "$(cat "$tmp")" = "$cached" ]; then rm -f "$tmp"; else mv "$tmp" "$file" || rm -f "$tmp"; fi
    else
      rm -f "$tmp"
    fi
  ) || true
}

# Fire the logged-out verdict from a keychain read alone (no probe). Returns 0
# only on the two affirmative shapes: item-not-found (security exit 44) or a
# readable-but-empty-token wipe. Any other read error is weather → returns 1,
# nothing written.
detect_logged_out() {
  local name="$1" cause="${2:-logged out}" service creds sec_rc
  service=$(keychain_service "$name")
  sec_rc=0
  creds=$(security find-generic-password -s "$service" -w 2>/dev/null) || sec_rc=$?
  if [ "$sec_rc" -eq 44 ]; then
    mark_auth_needed "$name" 'no keychain credentials'
    return 0
  fi
  if [ "$sec_rc" -eq 0 ] && credentials_logged_out "$creds"; then
    mark_auth_needed "$name" "$cause"
    return 0
  fi
  return 1
}

oauth_client_id="9d1c250a-e61b-44d9-88ed-5944d1962f5e"
oauth_token_url="${CLAUDEB_OAUTH_TOKEN_URL:-https://platform.claude.com/v1/oauth/token}"
oauth_attempts_file="$base_dir/oauth-attempts.json"
token_freeze_file="$base_dir/token-freeze"
token_attempts_file="$base_dir/token-attempts.jsonl"

# Token-freeze experiment: while this file exists, every ROBOT path to the OAuth
# token endpoint is held. An `until` in the past means the freeze lapsed and
# automation resumes on its own; a missing/garbled `until` holds until the file
# is removed.
token_freeze_active() {
  local until now
  [ -f "$token_freeze_file" ] || return 1
  until=$(jq -r '.until // empty' "$token_freeze_file" 2>/dev/null) || until=''
  if [[ "$until" =~ ^[0-9]+$ ]]; then
    now=$(date +%s) || return 1
    [ "$until" -gt "$now" ] || return 1
  fi
  return 0
}

user_refresh_explicit() {
  [ "${CLAUDEB_WARM_USER_EXPLICIT:-false}" = true ]
}

# Append-only evidence of every token-endpoint-relevant event (real attempts and
# their outcomes, warm outcomes, adoptions, freeze skips). Single-line O_APPEND
# writes stay atomic under PIPE_BUF, so no lock; a failed write never breaks a
# refresh path.
token_journal() {
  local account="$1" kind="$2" outcome="$3" http="${4:-}" ts line sz max_bytes user=false
  user_refresh_explicit && user=true
  ts=$(date +%Y-%m-%dT%H:%M:%S%z 2>/dev/null) || ts=''
  line=$(jq -cn --arg ts "$ts" --arg account "$account" --arg kind "$kind" \
    --arg outcome "$outcome" --arg http "$http" --argjson pid "$$" --argjson user "$user" '
    {ts:$ts, account:$account, kind:$kind, outcome:$outcome}
    + (if $http == "" then {} else {http:$http} end)
    + (if $user then {user:true} else {} end)
    + {pid:$pid}') || return 0
  mkdir -p "$base_dir" 2>/dev/null || return 0
  # Permanent but bounded: roll to one .1 generation past the cap so the journal
  # can never grow without limit (~16k events/generation at the default cap).
  max_bytes="${CLAUDEB_TOKEN_JOURNAL_MAX_BYTES:-2000000}"
  if [[ "$max_bytes" =~ ^[0-9]+$ ]] && [ -f "$token_attempts_file" ]; then
    sz=$(wc -c < "$token_attempts_file" 2>/dev/null) || sz=0
    if [[ "$sz" =~ ^[0-9]+$ ]] && [ "$sz" -ge "$max_bytes" ]; then
      mv -f "$token_attempts_file" "$token_attempts_file.1" 2>/dev/null || true
    fi
  fi
  printf '%s\n' "$line" >>"$token_attempts_file" 2>/dev/null || true
  return 0
}

oauth_attempt_update() {
  local name="$1" outcome="$2" retry_until="${3:-0}" credentials_expires_at="${4:-0}" warm_cause="${5:-}" http_status="${6:-0}" transport_rc="${7:-0}" bypass_attempted_at="${8:-0}" lock="$oauth_attempts_file.lock" tmp now tries=0 lock_mtime stale_retake=false jkind jhttp
  local max_tries="${CLAUDEB_LOCK_RETRIES:-10}" delay="${CLAUDEB_LOCK_DELAY:-0.2}"
  [[ "$max_tries" =~ ^[1-9][0-9]*$ ]] || max_tries=10
  case "$outcome" in
    attempting|warming) ;;
    *)
      jkind=curl-refresh
      case "$outcome" in
        success-adopted) jkind=adopt ;;
        warm-failed) jkind=warm ;;
      esac
      # A CLI-only warm reports its outcome through this same funnel but never
      # touched the token endpoint; its caller sets the kind so `success` is not
      # mislabeled curl-refresh. oauth_refresh's own successes carry no hint.
      [ -n "${CLAUDEB_JOURNAL_KIND:-}" ] && jkind="$CLAUDEB_JOURNAL_KIND"
      jhttp=''
      if [ "$outcome" = 429 ]; then jhttp=429
      elif [ "${http_status:-0}" != 0 ] \
          && { user_refresh_explicit || [ "$outcome" = weather ]; }; then jhttp="$http_status"; fi
      token_journal "$name" "$jkind" "$outcome" "$jhttp"
      ;;
  esac
  mkdir -p "$base_dir" || return 0
  while ! mkdir "$lock" 2>/dev/null; do
    tries=$((tries + 1))
    if [ "$tries" -ge "$max_tries" ]; then
      now=$(date +%s) || return 0
      if ! lock_mtime=$(file_mtime "$lock"); then lock_mtime=$now; fi
      if [ "$stale_retake" = false ] && [[ "$lock_mtime" =~ ^[0-9]+$ ]] && [ "$((now - lock_mtime))" -gt 30 ]; then
        stale_retake=true
        rm -rf "$lock" || return 0
        continue
      fi
      return 0
    fi
    sleep "$delay" || return 0
  done
  if ! now=$(date +%s); then
    rmdir "$lock" 2>/dev/null || true
    return 0
  fi
  tmp="$oauth_attempts_file.tmp.$$"
  if jq -cn --argjson old "$([ -r "$oauth_attempts_file" ] && jq -c 'if type == "object" then . else {} end' "$oauth_attempts_file" 2>/dev/null || printf '{}')" \
    --arg name "$name" --arg outcome "$outcome" --argjson now "$now" --argjson retry "$retry_until" \
    --argjson credentials_expires_at "$credentials_expires_at" --arg warm_cause "$warm_cause" \
    --argjson http_status "$http_status" --argjson transport_rc "$transport_rc" \
    --argjson bypass_attempted_at "$bypass_attempted_at" '
    def strikes: if type == "number" and . >= 0 then floor else 0 end;
    def cooldown($s):
      (if $s < 1 then 1 else $s end) as $n |
      (900 * (2 | pow(.; $n - 1))) | if . > 14400 then 14400 else . end;
    ($old[$name] // {}) as $entry |
    if $outcome == "success" then
      if ($entry.bypass_attempted_at // 0) > 0
      then $old + {($name): {bypass_attempted_at:$entry.bypass_attempted_at}}
      else $old | del(.[$name]) end
    elif $outcome == "success-adopted" then
      $old + {($name): ({attempted_at:$now,outcome:$outcome,retry_after_until:0}
        + (if ($entry.bypass_attempted_at // 0) > 0 then {bypass_attempted_at:$entry.bypass_attempted_at} else {} end))}
    elif $outcome == "warming" or $outcome == "warm-failed" then
      $old + {($name): (($entry | del(.warm_cause)) + {warm_attempted_at:$now,warm_outcome:$outcome}
        + (if $warm_cause == "" then {} else {warm_cause:$warm_cause} end))}
    else $old + {($name): (($old[$name] // {}) as $entry |
      (($entry.strikes // 0) | strikes) as $old_strikes |
      (if $outcome == "429" then ($old_strikes + 1) else $old_strikes end) as $new_strikes |
      (($entry | del(.attempted_at,.outcome,.retry_after_until,.credentials_expires_at,.http_status,.transport_rc))
      + (if ($entry.outcome // "") == "warming" or ($entry.outcome // "") == "warm-failed"
         then {warm_attempted_at:($entry.attempted_at // 0),warm_outcome:$entry.outcome} else {} end))
      + {attempted_at:$now,outcome:$outcome,
         retry_after_until:(if $outcome == "429" then ([$retry, ($now + cooldown($new_strikes))] | max) else $retry end)}
      + (if $outcome == "429" then {strikes:$new_strikes} else {} end)
      + (if $bypass_attempted_at > 0 then {bypass_attempted_at:$bypass_attempted_at} else {} end)
      + (if $credentials_expires_at > 0 then {credentials_expires_at:$credentials_expires_at} else {} end)
      + (if ($outcome == "weather" or $outcome == "failed") and $http_status > 0 then {http_status:$http_status} else {} end)
      + (if $outcome == "weather" and $transport_rc > 0 then {transport_rc:$transport_rc} else {} end))} end' > "$tmp"; then
    mv "$tmp" "$oauth_attempts_file" 2>/dev/null || true
  fi
  rm -f "$tmp" 2>/dev/null || true
  rmdir "$lock" 2>/dev/null || true
  return 0
}

oauth_backoff_until() {
  local name="$1" credentials="${2:-}" now credentials_expires_at=0
  now=$(date +%s)
  if [ -n "$credentials" ]; then
    credentials_expires_at=$(printf '%s' "$credentials" | jq -r '.claudeAiOauth.expiresAt // 0 | floor' 2>/dev/null) || credentials_expires_at=0
    [[ "$credentials_expires_at" =~ ^[0-9]+$ ]] || credentials_expires_at=0
  fi
  jq -r --arg name "$name" --argjson now "$now" --argjson credentials_expires_at "$credentials_expires_at" '
    .[$name] // {} |
    if (.outcome // "") == "revoked" and $credentials_expires_at > (.credentials_expires_at // 0) then 0
    elif ((.outcome // "") | startswith("success")) then 0
    elif (.outcome // "") == "warming" or (.outcome // "") == "warm-failed" then 0
    elif (.outcome // "") == "429" then
      (((.strikes // 0) | if type != "number" or . < 1 then 1 else floor end) as $s |
       (900 * (2 | pow(.; $s - 1)) | if . > 14400 then 14400 else . end) as $c |
       ([((.attempted_at // 0) + $c), (.retry_after_until // 0)] | max) as $until |
       if $until > $now then $until else 0 end)
    elif ((.retry_after_until // 0) > $now) then .retry_after_until
    elif (.outcome // "") != "success" and ($now - (.attempted_at // 0)) < 900
    then (.attempted_at + 900) else 0 end' "$oauth_attempts_file" 2>/dev/null || printf '0'
}

oauth_warm_backoff_until() {
  local name="$1" mode="$2" now oauth_until warm_until
  case "$mode" in
    all)
      oauth_until=$(oauth_backoff_until "$name")
      warm_until=$(oauth_heal_backoff_until "$name")
      if [ "$oauth_until" -gt "$warm_until" ] 2>/dev/null; then printf '%s\n' "$oauth_until"; else printf '%s\n' "$warm_until"; fi
      return
      ;;
    heal) oauth_heal_backoff_until "$name"; return ;;
  esac
  now=$(date +%s)
  jq -r --arg name "$name" --argjson now "$now" '
    .[$name] // {} |
    if (.outcome // "") == "429" and ((.retry_after_until // 0) > $now)
    then .retry_after_until else 0 end' "$oauth_attempts_file" 2>/dev/null || printf '0'
}

# Direct refresh state must never gate the zero-cost heal path. Warm state is
# tracked separately so a failed warm can immediately fall back to oauth_refresh.
# A capacity-shaped warm failure (see warm_class_is_capacity) gets a short gate
# so weather doesn't lock an account out of healing for half an hour; only an
# auth-shaped warm cause (needs-relogin, profile-setup, unknown-account) keeps
# the long 30m gate.
oauth_heal_backoff_until() {
  local name="$1" now cause capacity_gate is_capacity=false
  now=$(date +%s)
  cause=$(oauth_warm_cause "$name")
  capacity_gate="${CLAUDEB_HEAL_GATE_CAPACITY:-90}"
  [[ "$capacity_gate" =~ ^[0-9]+$ ]] || capacity_gate=90
  warm_class_is_capacity "$cause" && is_capacity=true
  jq -r --arg name "$name" --argjson now "$now" --argjson capacity_gate "$capacity_gate" --argjson is_capacity "$is_capacity" '
    .[$name] // {} |
    (if (.warm_outcome // "") != "" then {outcome:.warm_outcome,attempted_at:(.warm_attempted_at // 0)}
     elif (.outcome // "") == "warm-failed" or (.outcome // "") == "warming"
     then {outcome:.outcome,attempted_at:(.attempted_at // 0)} else {} end) as $w |
    ($w.outcome // "") as $outcome | ($w.attempted_at // 0) as $attempted_at |
    (if $outcome == "warm-failed" then (if $is_capacity then $capacity_gate else 1800 end)
     elif $outcome == "warming" then 180
     else 0 end) as $window |
    if $window > 0 and ($now - $attempted_at) < $window then ($attempted_at + $window) else 0 end' \
    "$oauth_attempts_file" 2>/dev/null || printf '0'
}

oauth_backoff_outcome() {
  jq -r --arg name "$1" '.[$name].outcome // ""' "$oauth_attempts_file" 2>/dev/null || true
}

oauth_rejection_since() {
  jq -e --arg name "$1" --argjson since "$2" '
    .[$name] as $e |
    (($e.outcome // "") == "revoked" or ($e.outcome // "") == "auth-failed") and
    (($e.attempted_at | type) == "number" and $e.attempted_at >= $since)' \
    "$oauth_attempts_file" >/dev/null 2>&1
}

oauth_backoff_http() {
  jq -r --arg name "$1" '.[$name].http_status // 0' "$oauth_attempts_file" 2>/dev/null || printf '0'
}

oauth_warm_cause() {
  jq -r --arg name "$1" '.[$name].warm_cause // ""' "$oauth_attempts_file" 2>/dev/null || printf ''
}

warm_class_is_capacity() {
  case "$1" in
    timeout|warm-429|warm-failed|usage-probe-failed|frozen) return 0 ;;
    *) return 1 ;;
  esac
}

warm_cause_from_refresh() {
  local name="$1" refresh_rc="$2"
  case "$refresh_rc" in
    2) printf 'needs-relogin\n' ;;
    76) printf 'frozen\n' ;;
    75)
      if [ "$(oauth_backoff_outcome "$name")" = 429 ]; then printf 'warm-429\n'; else printf 'warm-failed\n'; fi
      ;;
    *) printf 'warm-failed\n' ;;
  esac
}

probe_http_from_refresh_failure() {
  local name="$1" refresh_rc="$2" refresh_outcome refresh_http
  case "$refresh_rc" in
    2) printf '401\n' ;;
    76) printf '000\n' ;;
    75)
      refresh_outcome=$(oauth_backoff_outcome "$name")
      if [ "$refresh_outcome" = 429 ]; then
        printf '429\n'
      else
        refresh_http=$(oauth_backoff_http "$name")
        if [ "$refresh_http" -gt 0 ] 2>/dev/null; then printf '%s\n' "$refresh_http"; else printf '000\n'; fi
      fi
      ;;
    *) printf '000\n' ;;
  esac
}

keychain_service() {
  local profile="$HOME/.claude-profiles/$1" hash
  hash=$(printf '%s' "$profile" | shasum -a 256 | awk '{print substr($1, 1, 8)}')
  printf 'Claude Code-credentials-%s\n' "$hash"
}

token_needs_refresh() {
  local name="$1" service credentials expires_at now_ms near_ms
  service=$(keychain_service "$name")
  credentials=$(security find-generic-password -s "$service" -w 2>/dev/null) || return 0
  expires_at=$(printf '%s' "$credentials" | jq -r '.claudeAiOauth.expiresAt // 0 | floor' 2>/dev/null) || expires_at=0
  [[ "$expires_at" =~ ^[0-9]+$ ]] || expires_at=0
  now_ms=$(($(date +%s) * 1000))
  near_ms=$(( ${CLAUDEB_TOKEN_NEAR_EXPIRY_SECONDS:-300} * 1000 ))
  [ "$expires_at" -le "$((now_ms + near_ms))" ]
}

oauth_attempt_begin() {
  local name="$1" credentials="${2:-}" now until bypass_attempted_at bypass_lock recorded_at
  now=$(date +%s)
  case "${CLAUDEB_OAUTH_BYPASS_BACKOFF:-false}" in
    1|true|TRUE|yes|YES|on|ON)
      bypass_lock="$oauth_attempts_file.bypass.$(printf '%s' "$name" | LC_ALL=C tr -c 'A-Za-z0-9._-' '_')"
      lock_acquire "$bypass_lock" || return 1
      bypass_attempted_at=$(jq -r --arg name "$name" '.[$name].bypass_attempted_at // 0' "$oauth_attempts_file" 2>/dev/null) || bypass_attempted_at=0
      [[ "$bypass_attempted_at" =~ ^[0-9]+$ ]] || bypass_attempted_at=0
      if [ "$((now - bypass_attempted_at))" -lt 60 ]; then
        lock_release "$bypass_lock"
        printf 'claudeb: %s: OAuth refresh bypass rate-limited until %s\n' "$name" "$(format_time "$((bypass_attempted_at + 60))")" >&2
        return 1
      fi
      oauth_attempt_update "$name" attempting 0 0 '' 0 0 "$now"
      recorded_at=$(jq -r --arg name "$name" '.[$name].bypass_attempted_at // 0' "$oauth_attempts_file" 2>/dev/null) || recorded_at=0
      lock_release "$bypass_lock"
      [ "$recorded_at" = "$now" ] || return 1
      return
      ;;
  esac
  until=$(oauth_backoff_until "$name" "$credentials")
  if [ "$until" -gt "$now" ] 2>/dev/null; then
    printf 'claudeb: %s: OAuth refresh backoff active until %s\n' "$name" "$(format_time "$until")" >&2
    return 1
  fi
  oauth_attempt_update "$name" attempting 0
}

# security -i takes the command on stdin, so the secret never appears in argv.
keychain_write() {
  local service="$1" value="$2" escaped account
  account=${USER:-$(id -un)}
  escaped=${value//\\/\\\\}
  escaped=${escaped//\"/\\\"}
  printf 'add-generic-password -U -a "%s" -s "%s" -w "%s"\n' "$account" "$service" "$escaped" | \
    security -i >/dev/null 2>&1
}

# Prints the rotated credentials JSON on success. Returns 2 only for a fresh
# token-endpoint auth rejection and 75 for transient endpoint weather. A corrupt
# keychain write logs the profile out of Claude Code, so the write is verified by
# re-read and the previous JSON is restored on any mismatch.
oauth_refresh() {
  local name="$1" service="$2" prev="$3" body response new_creds readback headers http rc=0 retry='' retry_until=0 weather_http=0 http_num=0 refresh_rc=1
  local prev_rt prev_expires_at current current_rt rlock='' lock_trap glock glock_held spacing
  # Freeze is weather, not a verdict: journal the skip, write no auth verdict, no
  # strike, no oauth-attempts change; the distinct rc 76 surfaces as cause `frozen`.
  if token_freeze_active && ! user_refresh_explicit; then
    token_journal "$name" curl-refresh frozen-skip
    return 76
  fi
  oauth_attempt_begin "$name" "$prev" || return 1
  prev_rt=$(printf '%s' "$prev" | jq -r '.claudeAiOauth.refreshToken // empty' 2>/dev/null) || prev_rt=''
  prev_expires_at=$(printf '%s' "$prev" | jq -r '.claudeAiOauth.expiresAt // 0 | floor' 2>/dev/null) || prev_expires_at=0
  [[ "$prev_expires_at" =~ ^[0-9]+$ ]] || prev_expires_at=0
  # Anthropic rotates (single-uses) the refresh token on every grant, so two
  # concurrent refreshers POSTing the same $prev_rt race: one wins, the other's
  # token is already consumed and comes back 429/invalid. Serialize per account.
  rlock="$oauth_attempts_file.rl.$(printf '%s' "$name" | LC_ALL=C tr -c 'A-Za-z0-9._-' '_')"
  if ! lock_acquire "$rlock"; then
    rlock=''
    current=$(security find-generic-password -s "$service" -w 2>/dev/null) || current=''
    current_rt=$(printf '%s' "$current" | jq -r '.claudeAiOauth.refreshToken // empty' 2>/dev/null) || current_rt=''
    if [ -n "$current" ] && [ -n "$prev_rt" ] && [ "$current_rt" != "$prev_rt" ]; then
      # Adopted a concurrent rotation — no token-endpoint POST happened; journal it
      # as `adopt`, not `curl-refresh`, so the freeze evidence stays honest.
      CLAUDEB_JOURNAL_KIND=adopt oauth_attempt_update "$name" success
      printf '%s' "$current"
      return 0
    fi
    return 1
  fi
  (
    printf -v lock_trap 'lock_release %q' "$rlock"
    trap "$lock_trap" EXIT
    current=$(security find-generic-password -s "$service" -w 2>/dev/null) || current=''
    current_rt=$(printf '%s' "$current" | jq -r '.claudeAiOauth.refreshToken // empty' 2>/dev/null) || current_rt=''
    if [ -n "$current" ] && [ -n "$prev_rt" ] && [ "$current_rt" != "$prev_rt" ]; then
      # A concurrent caller (another probe, a live profile session) already
      # rotated this account past $prev; adopt its fresher value instead of
      # racing the server with an already-consumed refresh token.
      CLAUDEB_JOURNAL_KIND=adopt oauth_attempt_update "$name" success
      printf '%s' "$current"
      current=''
      return 0
    fi
    current=''
    body=$(printf '%s' "$prev" | jq -c --arg client_id "$oauth_client_id" '
      .claudeAiOauth as $c |
      ($c.refreshToken | select(type == "string" and length > 0)) as $rt |
      {grant_type: "refresh_token", refresh_token: $rt, client_id: $client_id}
      + (([$c.scopes[]? | strings] | join(" ")) as $scope |
         if $scope == "" then {} else {scope: $scope} end)' 2>/dev/null) || return 1
    [ -n "$body" ] || return 1
    headers=$(mktemp "${TMPDIR:-/tmp}/claudeb-oauth.XXXXXX") || { oauth_attempt_update "$name" failed; return 1; }
    # Serialize DIFFERENT accounts' token POSTs (the rlock is per-account). The wait
    # must cover the worst-case hold — the default 2s budget times out and the herd returns.
    glock="$oauth_attempts_file.rl-global"
    glock_held=false
    if lock_acquire "$glock" 200; then
      glock_held=true
      printf -v lock_trap 'lock_release %q; lock_release %q' "$glock" "$rlock"
      trap "$lock_trap" EXIT
    fi
    spacing="${CLAUDEB_OAUTH_TOKEN_SPACING:-1}"
    [[ "$spacing" =~ ^[0-9]+$ ]] || spacing=1
    # Above 10s the hold (curl 8s + spacing) crosses the 30s stale threshold and waiters break a live glock.
    [ "$spacing" -le 10 ] || spacing=10
    if response=$(printf '%s' "$body" | curl -sS -m 8 -D "$headers" -o - -w $'\n%{http_code}' -X POST \
      -H 'Content-Type: application/json' -d @- "$oauth_token_url" 2>/dev/null); then :; else rc=$?; fi
    if [ "$glock_held" = true ]; then
      [ "$spacing" -le 0 ] || sleep "$spacing"
      lock_release "$glock"
      # Re-arm the trap off the glock the instant it is freed — lock_release has no
      # ownership check, so exiting later would rmdir another account's fresh glock.
      glock_held=false
      printf -v lock_trap 'lock_release %q' "$rlock"
      trap "$lock_trap" EXIT
    fi
    http=${response##*$'\n'}
    response=${response%$'\n'*}
    if [ "$rc" -ne 0 ] || [ "$http" != 200 ]; then
      [[ "$http" =~ ^[0-9]{3}$ ]] && http_num=$((10#$http))
      if [ "$http" = 429 ]; then
        retry=$(header_value "$headers" retry-after)
        if [[ "$retry" =~ ^[0-9]+$ ]]; then retry_until=$(($(date +%s) + retry)); fi
        printf 'claudeb: %s: OAuth token endpoint returned 429%s\n' "$name" "$([ -n "$retry" ] && printf ' (retry-after: %s)' "$retry")" >&2
        oauth_attempt_update "$name" 429 "$retry_until"
        refresh_rc=75
      elif [ "$rc" -ne 0 ]; then
        oauth_attempt_update "$name" weather 0 0 '' 0 "$rc"
        refresh_rc=75
      elif printf '%s' "$response" | grep -Eq 'invalid_grant|revoked'; then
        current=$(security find-generic-password -s "$service" -w 2>/dev/null) || current=''
        current_rt=$(printf '%s' "$current" | jq -r '.claudeAiOauth.refreshToken // empty' 2>/dev/null) || current_rt=''
        if [ -n "$current" ] && [ -n "$current_rt" ] && [ "$current_rt" != "$prev_rt" ]; then
          rm -f "$headers"
          oauth_attempt_update "$name" success-adopted
          printf '%s' "$current"
          current=''
          return 0
        else
          oauth_attempt_update "$name" revoked "$(($(date +%s) + 21600))" "$prev_expires_at"
          refresh_rc=2
        fi
      elif [ "$http" = 401 ] || [ "$http" = 403 ]; then
        oauth_attempt_update "$name" auth-failed
        refresh_rc=2
      elif [[ "$http" =~ ^5[0-9][0-9]$ ]] || [ "$http" = 000 ]; then
        weather_http=$((10#$http))
        oauth_attempt_update "$name" weather 0 0 '' "$weather_http"
        refresh_rc=75
      else
        oauth_attempt_update "$name" failed 0 0 '' "$http_num"
      fi
      rm -f "$headers"
      return "$refresh_rc"
    fi
    rm -f "$headers"
    body=""
    new_creds=$(jq -cn --argjson old "$prev" --argjson new "$response" \
      --argjson now_ms "$(($(date +%s) * 1000))" '
      ($new.access_token | select(type == "string" and length > 0)) as $at |
      $old
      | .claudeAiOauth.accessToken = $at
      | .claudeAiOauth.expiresAt = ($now_ms + (($new.expires_in // 0) * 1000) | floor)
      | (if ($new.refresh_token | type) == "string" and ($new.refresh_token | length) > 0
         then .claudeAiOauth.refreshToken = $new.refresh_token else . end)
      | (if ($new.refresh_token_expires_in | type) == "number"
         then .claudeAiOauth.refreshTokenExpiresAt = ($now_ms + ($new.refresh_token_expires_in * 1000) | floor)
         else . end)' 2>/dev/null) || return 1
    response=""
    [ -n "$new_creds" ] || { oauth_attempt_update "$name" failed; return 1; }
    current=$(security find-generic-password -s "$service" -w 2>/dev/null) || current=''
    current_rt=$(printf '%s' "$current" | jq -r '.claudeAiOauth.refreshToken // empty' 2>/dev/null) || current_rt=''
    if [ -n "$current" ] && [ "$current_rt" != "$prev_rt" ]; then
      # Rotated by someone else while our POST was in flight; our new_creds is
      # derived from an already-superseded refresh token — discard it and adopt
      # theirs instead of clobbering a fresher, already-verified rotation.
      CLAUDEB_JOURNAL_KIND=adopt oauth_attempt_update "$name" success
      printf '%s' "$current"
      current=''
      return 0
    fi
    current=''
    keychain_write "$service" "$new_creds" || true
    readback=$(security find-generic-password -s "$service" -w 2>/dev/null) || readback=""
    if [ "$readback" != "$new_creds" ]; then
      # A concurrent Claude Code session may have rotated the item after us; a
      # readback still holding valid credentials is theirs — restoring $prev over
      # it would log that session out. Restore only over a garbled write.
      if ! printf '%s' "$readback" | jq -e '.claudeAiOauth.refreshToken | select(type == "string" and length > 0)' >/dev/null 2>&1; then
        keychain_write "$service" "$prev" || true
      fi
      oauth_attempt_update "$name" failed
      return 1
    fi
    oauth_attempt_update "$name" success
    printf '%s' "$new_creds"
  )
}

messages_probe() {
  local name="$1" dir="$2" http=000 rc=0
  if http=$(printf 'header = "Authorization: Bearer %s"\n' "$(cat "$tokens_dir/$name")" | \
    curl -sK - -m 10 -D "$dir/$name.headers" -o /dev/null -w '%{http_code}' -X POST \
      -H 'anthropic-beta: oauth-2025-04-20' -H 'anthropic-version: 2023-06-01' \
      -H 'Content-Type: application/json' \
      -d '{"model":"claude-haiku-4-5-20251001","max_tokens":1,"messages":[{"role":"user","content":"hi"}]}' \
      https://api.anthropic.com/v1/messages 2>/dev/null); then
    :
  else
    rc=$?
  fi
  printf '%s %s' "$rc" "${http:-000}"
}

probe_one() {
  # rc=255 is a sentinel: the usage curl never ran (no/blocked credentials), as
  # opposed to a real transport failure — the weather classifier must not treat
  # a backoff-gated or credential-less probe as retryable network weather.
  local name="$1" dir="$2" allow_spend="$3" allow_refresh="${4:-true}" http=000 rc=255 attempt out sec_rc
  local service credentials access_token now_ms expires_at refreshed=false refresh_rc
  service=$(keychain_service "$name")
  sec_rc=0
  credentials=$(security find-generic-password -s "$service" -w 2>/dev/null) || sec_rc=$?
  # Affirmative logged-out before any token operation: keychain item-not-found
  # (exit 44) or a readable wipe (both tokens blank). No curl, no oauth-attempt.
  if [ "$sec_rc" -eq 44 ]; then
    mark_auth_needed "$name" 'no keychain credentials'
    printf 'logged-out 0 000\n' > "$dir/$name.result"
    return
  fi
  if [ "$sec_rc" -eq 0 ] && credentials_logged_out "$credentials"; then
    mark_auth_needed "$name"
    printf 'logged-out 0 000\n' > "$dir/$name.result"
    return
  fi
  if [ "$sec_rc" -eq 0 ]; then
    now_ms=$(($(date +%s) * 1000))
    expires_at=$(printf '%s' "$credentials" | jq -r '.claudeAiOauth.expiresAt // 0 | floor' 2>/dev/null) || expires_at=0
    [[ "$expires_at" =~ ^[0-9]+$ ]] || expires_at=0
    if [ "$expires_at" -le "$now_ms" ]; then
      if [ "$allow_refresh" = true ]; then
        refreshed=true
        if credentials=$(oauth_refresh "$name" "$service" "$credentials"); then
          :
        else
          refresh_rc=$?
          credentials=""
          http=$(probe_http_from_refresh_failure "$name" "$refresh_rc")
          [ "$refresh_rc" -ne 2 ] || mark_auth "$name" expired
        fi
      else
        # No refresh allowed here: a hard-expired ACCESS token is scheduled
        # expiry, not evidence the credentials are dead. Report the condition via
        # the probe result and leave the auth verdict to a refresh-capable caller
        # (heal_one); writing expired here would re-stamp checked_at on no proof.
        credentials=""
        http=401
      fi
    fi
    for attempt in 1 2; do
      [ -n "$credentials" ] || break
      access_token=$(printf '%s' "$credentials" | jq -er '.claudeAiOauth.accessToken | select(type == "string" and length > 0)' 2>/dev/null) || break
      rc=0
      if http=$(printf 'header = "Authorization: Bearer %s"\n' "$access_token" | \
        curl -sK - -m 10 -o "$dir/$name.usage" -w '%{http_code}' \
          -H 'anthropic-beta: oauth-2025-04-20' \
          -H 'User-Agent: claude-cli/2.1.207 (external, cli)' \
          https://api.anthropic.com/api/oauth/usage 2>/dev/null); then
        :
      else
        rc=$?
      fi
      access_token=""
      if [ "$rc" -eq 0 ] && [ "$http" = 200 ] && jq -e '.five_hour.utilization | type == "number"' "$dir/$name.usage" >/dev/null 2>&1; then
        credentials=""
        printf 'usage 0 200\n' > "$dir/$name.result"
        return
      fi
      if [ "$attempt" -eq 1 ] && [ "$http" = 401 ] && [ "$refreshed" != true ] && [ "$allow_refresh" = true ]; then
        refreshed=true
        if credentials=$(oauth_refresh "$name" "$service" "$credentials"); then
          :
        else
          refresh_rc=$?
          credentials=""
          http=$(probe_http_from_refresh_failure "$name" "$refresh_rc")
          [ "$refresh_rc" -ne 2 ] || mark_auth "$name" expired
        fi
      else
        # A 401 here is affirmative only when a refresh was possible this run, so
        # the token just used was known-fresh (refreshed above or in attempt 1);
        # a no-refresh probe on an unrefreshed token defers instead of concluding.
        if [ "$http" = 401 ] && [ "$allow_refresh" = true ]; then mark_auth "$name" expired; fi
        break
      fi
    done
    credentials=""
  fi
  if [ "$allow_spend" != true ]; then
    printf 'no-spend %s %s\n' "$rc" "${http:-000}" > "$dir/$name.result"
    return
  fi
  out=$(messages_probe "$name" "$dir")
  printf 'messages %s\n' "$out" > "$dir/$name.result"
}

messages_probe_and_mark() {
  local name="$1" dir="$2" mark_live="${3:-false}" out rc http
  out=$(messages_probe "$name" "$dir")
  rc=${out%% *}
  http=${out##* }
  if [ "$rc" = 0 ] && [ "$http" = 200 ] && merge_headers "$name" "$dir/$name.headers"; then
    [ "$mark_live" = true ] && grep -qx live "$dir/$name.display" 2>/dev/null || printf 'live*\n' > "$dir/$name.display"
    return 0
  fi
  if [ "$http" = 401 ] || [ "$http" = 403 ]; then
    # The response does not expose token freshness; defer a 401 to the refresh
    # outcome when the local access token is already due for refresh.
    if token_needs_refresh "$name"; then
      heal_refresh_verdict "$name" "messages probe $http"
    else
      mark_auth "$name" expired
    fi
    [ "$mark_live" = true ] && printf 'auth!\n' > "$dir/$name.display"
  fi
  return 1
}

# A fallback-probe 401/403 taken while the access token was already due for
# refresh is not proof the credentials are dead — the stale access token alone
# explains it. Refresh and let the token endpoint's own verdict decide. The
# verdict is read from the persisted outcome, not oauth_refresh's numeric return
# (which is unreliable across call contexts — see the oauth_refresh tests, which
# assert oauth_backoff_outcome rather than the rc): a printed credential proves
# the token still lives (auth ok), revoked/auth-failed is a real rejection
# (expired), and 429/weather/unresolved leaves the auth field untouched.
heal_refresh_verdict() {
  local name="$1" warm_cause="$2" service credentials refreshed outcome refresh_run_start
  # Under a freeze oauth_refresh returns 76/empty without touching the endpoint,
  # so the fall-through below would read a stale PRE-freeze revoked/auth-failed
  # outcome and stamp a false `expired`. Every caller reaches here only when the
  # token was already due for refresh, so there is no live fresh-token verdict to
  # salvage — end as weather, no auth write. (Mirrors heal_one's freeze guard for
  # the twin callers messages_probe_and_mark / process_probe_result.)
  if token_freeze_active && ! user_refresh_explicit; then
    printf 'claudeb: %s: capacity (%s, token endpoint frozen) — no auth verdict\n' "$name" "$warm_cause" >&2
    return
  fi
  service=$(keychain_service "$name")
  credentials=$(security find-generic-password -s "$service" -w 2>/dev/null) || credentials=''
  refresh_run_start=$(date +%s)
  if refreshed=$(oauth_refresh "$name" "$service" "$credentials" 2>/dev/null) && [ -n "$refreshed" ]; then
    mark_auth "$name" ok
    printf 'claudeb: %s: capacity (%s) — token refreshed, auth ok\n' "$name" "$warm_cause" >&2
    return
  fi
  outcome=$(oauth_backoff_outcome "$name")
  case "$outcome" in
    revoked|auth-failed)
      if oauth_rejection_since "$name" "$refresh_run_start"; then
        mark_auth "$name" expired "$warm_cause, refresh token rejected"
      else
        printf 'claudeb: %s: capacity (%s) — token refresh unresolved, no auth verdict\n' "$name" "$warm_cause" >&2
      fi
      ;;
    429|weather) printf 'claudeb: %s: capacity (%s, token refresh weather) — no auth verdict\n' "$name" "$warm_cause" >&2 ;;
    *) printf 'claudeb: %s: capacity (%s) — token refresh unresolved, no auth verdict\n' "$name" "$warm_cause" >&2 ;;
  esac
}

# Disabled accounts are only out of the worker pool; the user still watches their
# limits and wants them healed. Warm is zero-cost, so heal them too. The warm
# path uses the `claude` CLI's own OAuth rotation, not the curl refresh, so a
# token-endpoint 429/failed record must never gate it (see oauth_heal_backoff_until).
heal_one() {
  local dir="$1" name="$2" until_heal now_heal warm_out warm_skip_dir warm_cause cause source rc http until_refresh outcome retry_until run_start warm_gated=false
  local warm_reason='' retry_delay
  run_start=$(date +%s)
  until_heal=$(oauth_heal_backoff_until "$name")
  now_heal=$(date +%s)
  if [ "$until_heal" -gt "$now_heal" ] 2>/dev/null; then
    warm_gated=true
    warm_cause="warm backoff $(( (until_heal - now_heal + 59) / 60 ))m"
  else
    warm_gated=false
    warm_cause='warm failed'
  fi
  warm_skip_dir=$(mktemp -d "${TMPDIR:-/tmp}/claudeb-warm-skip.XXXXXX")
  if warm_out=$(CLAUDEB_WARM_FREE_ONLY=true CLAUDEB_WARM_BACKOFF_MODE=heal \
    CLAUDEB_WARM_SKIP_MARKER="$warm_skip_dir/skipped" warm_accounts "$name" 2>/dev/null); then
    # The marker is written by the skip itself, so a freeze that lifts between the call and
    # this check cannot turn a warm that never ran into a live account.
    if [ ! -e "$warm_skip_dir/skipped" ]; then
      rm -rf "$warm_skip_dir"
      printf 'live\n' > "$dir/$name.display"
      return
    fi
  fi
  rm -rf "$warm_skip_dir"
  warm_reason=$(oauth_warm_cause "$name")
  # Under a freeze a re-warm can only frozen-skip again, so the capacity retry
  # (a 20s sleep + repeat) is pure dead time, and a pre-freeze capacity-shaped
  # warm_cause is stale, not this run's evidence. Skip both capacity blocks and
  # fall through to the probe + freeze verdict below.
  if user_refresh_explicit || ! token_freeze_active; then
    if [ "$warm_gated" != true ] && warm_class_is_capacity "$warm_reason"; then
      retry_delay="${CLAUDEB_WARM_RETRY_DELAY:-20}"
      [[ "$retry_delay" =~ ^[0-9]+$ ]] || retry_delay=20
      [ "$retry_delay" -le 0 ] || sleep "$retry_delay"
      # The just-recorded warm-failed outcome would otherwise self-gate this
      # same-run retry under oauth_heal_backoff_until's 30m window.
      if warm_out=$(CLAUDEB_WARM_FREE_ONLY=true CLAUDEB_WARM_BACKOFF_MODE=retry-after warm_accounts "$name" 2>/dev/null); then
        printf 'live\n' > "$dir/$name.display"
        return
      fi
      warm_reason=$(oauth_warm_cause "$name")
    fi
    if [ "$warm_gated" != true ] && warm_class_is_capacity "$warm_reason" && ! token_needs_refresh "$name"; then
      mark_auth "$name" ok
      printf 'claudeb: %s: capacity (anthropic overload) — data kept, will retry (warm cause: %s)\n' "$name" "$warm_reason" >&2
      return
    fi
  fi
  probe_one "$name" "$dir" false true
  read -r source rc http < "$dir/$name.result"
  if [ "$source" = logged-out ]; then
    # probe_one recorded auth_needed; do not let the capacity/refresh path below
    # overwrite it with an "auth ok" verdict.
    printf 'login\n' > "$dir/$name.display"
    return
  fi
  if [ "$source" = usage ] && merge_usage "$name" "$dir/$name.usage"; then
    printf 'live\n' > "$dir/$name.display"
    return
  fi
  # Under a freeze the token endpoint never ran this cycle, so a stale backoff or
  # rejection outcome is pre-freeze, not current-run evidence — end as weather. A
  # live 4xx on a still-fresh token is endpoint-independent and still counts.
  if token_freeze_active && ! user_refresh_explicit; then
    if { [ "$http" = 401 ] || [ "$http" = 403 ]; } && ! token_needs_refresh "$name"; then
      mark_auth "$name" expired "fresh token rejected ($http)"
    else
      printf 'claudeb: %s: capacity (frozen) — token endpoint frozen, no auth verdict\n' "$name" >&2
    fi
    return
  fi
  now_heal=$(date +%s)
  until_refresh=$(oauth_backoff_until "$name")
  outcome=$(oauth_backoff_outcome "$name")
  if [ "$outcome" = revoked ] && oauth_rejection_since "$name" "$run_start"; then
    mark_auth "$name" expired 'needs re-login'
    return
  fi
  # An already-gated heal cycle keeps its own backoff-shaped cause regardless
  # of what this round's fallback probe returned; a live retry-after backoff
  # is likewise capacity, not proof of dead credentials — only a 401/403 left
  # unexplained by either is affirmative evidence.
  if [ "$warm_gated" = true ]; then
    retry_until="$until_heal"
    if [ "$until_refresh" -gt "$now_heal" ] 2>/dev/null && [ "$until_refresh" -lt "$retry_until" ] 2>/dev/null; then
      retry_until="$until_refresh"
    fi
    cause="backoff $(( (retry_until - now_heal + 59) / 60 ))m"
  elif [ "$until_refresh" -gt "$now_heal" ] 2>/dev/null; then
    cause="$warm_cause, token refresh backoff $(( (until_refresh - now_heal + 59) / 60 ))m"
  elif [ "$http" = 401 ] || [ "$http" = 403 ]; then
    if token_needs_refresh "$name"; then
      heal_refresh_verdict "$name" "$warm_cause"
    else
      mark_auth "$name" expired "$warm_cause, fresh token rejected ($http)"
    fi
    return
  else
    cause="$warm_cause, fallback probe HTTP ${http:-000}"
  fi
  if token_needs_refresh "$name"; then
    printf 'claudeb: %s: capacity (%s) — token unresolved, no auth verdict\n' "$name" "$cause" >&2
  else
    mark_auth "$name" ok
    printf 'claudeb: %s: capacity (%s) — token still valid, auth ok\n' "$name" "$cause" >&2
  fi
}

# Heal every auth-expired account concurrently. Each warm drives a `claude` CLI
# session capped at 90s; healing sequentially made the whole refresh scale with
# the number of expired accounts and overrun the collector's 300s bound, which
# left still-healing accounts marked expired in the snapshot the collector then
# read — surfacing a refresh_error for accounts that were healing fine.
heal_expired() {
  local dir="$1" name pid pids=''
  while IFS= read -r name; do
    [ "$(cat "$dir/$name.display" 2>/dev/null)" = 'auth!' ] || continue
    heal_one "$dir" "$name" &
    pid=$!
    pids="$pids $pid"
  done < <(account_names)
  for pid in $pids; do
    wait "$pid" || true
  done
}

process_probe_result() {
  local name="$1" dir="$2" source rc http
  read -r source rc http < "$dir/$name.result"
  if [ "$source" = logged-out ]; then
    # probe_one already wrote the auth_needed verdict; a login-needed account is
    # terminal, never a weather retry candidate.
    printf 'login\n' > "$dir/$name.display"
  elif [ "$source" = usage ] && merge_usage "$name" "$dir/$name.usage"; then
    printf 'live\n' > "$dir/$name.display"
  elif { [ "$http" = 401 ] || [ "$http" = 403 ]; }; then
    if [ "$source" = messages ]; then
      if token_needs_refresh "$name"; then
        heal_refresh_verdict "$name" "messages probe $http"
      else
        mark_auth "$name" expired
      fi
    fi
    printf 'auth!\n' > "$dir/$name.display"
  elif [ "$source" = messages ] && [ "$rc" -eq 0 ] && [ "$http" = 200 ] && merge_headers "$name" "$dir/$name.headers"; then
    printf 'live*\n' > "$dir/$name.display"
  else
    printf '!\n' > "$dir/$name.display"
  fi
}

# Fresh weather failure of THIS run only: a probe transport error, or a token-endpoint
# 429/weather stamped at/after run start. Auth rejections never qualify.
probe_weather_failed() {
  local name="$1" dir="$2" run_start="$3" source rc http outcome attempted_at
  read -r source rc http < "$dir/$name.result" 2>/dev/null || return 1
  [ "$source" != logged-out ] || return 1
  if [ "$rc" != 0 ] && [ "$rc" != 255 ]; then return 0; fi
  # Usage-endpoint 429/5xx/000 (rc=0, valid token) leaves no oauth-attempts trace; 401/403 stay out via the caller's display gate.
  case "$http" in 000|429|5[0-9][0-9]) return 0 ;; esac
  outcome=$(oauth_backoff_outcome "$name")
  attempted_at=$(jq -r --arg n "$name" '.[$n].attempted_at // 0' "$oauth_attempts_file" 2>/dev/null) || attempted_at=0
  [[ "$attempted_at" =~ ^[0-9]+$ ]] || attempted_at=0
  { [ "$outcome" = 429 ] || [ "$outcome" = weather ]; } && [ "$attempted_at" -ge "$run_start" ]
}

oauth_retry_remaining() {
  local name="$1" now until
  now=$(date +%s)
  until=$(oauth_backoff_until "$name")
  [[ "$until" =~ ^[0-9]+$ ]] || until=0
  if [ "$until" -gt "$now" ]; then printf '%s\n' "$((until - now))"; else printf '0\n'; fi
}

# Planned wait charged against the convergence budget; tests override the real sleep.
converge_backoff() {
  case "$1" in
    1) printf '5\n' ;;
    2) printf '15\n' ;;
    3) printf '30\n' ;;
    *) printf '60\n' ;;
  esac
}

# Refresh tokens at/near expiry (disabled accounts included — they may be re-enabled
# anytime) so the set never expires together overnight and forces a morning burst;
# weather failures wait for the next upkeep. No probes, no spend.
token_upkeep() {
  local name service credentials expires_at now_ms window_ms
  if token_freeze_active && ! user_refresh_explicit; then
    token_journal all upkeep frozen-skip
    return 0
  fi
  window_ms=$(( ${CLAUDEB_TOKEN_UPKEEP_WINDOW_S:-2700} * 1000 ))
  now_ms=$(($(date +%s) * 1000))
  while IFS= read -r name; do
    service=$(keychain_service "$name")
    credentials=$(security find-generic-password -s "$service" -w 2>/dev/null) || continue
    # A logged-out account has no token to refresh; skip it (item-not-found is
    # already caught by the read above).
    if credentials_logged_out "$credentials"; then continue; fi
    expires_at=$(printf '%s' "$credentials" | jq -r '.claudeAiOauth.expiresAt // 0 | floor' 2>/dev/null) || expires_at=0
    [[ "$expires_at" =~ ^[0-9]+$ ]] || expires_at=0
    [ "$expires_at" -le "$((now_ms + window_ms))" ] || continue
    if oauth_refresh "$name" "$service" "$credentials" >/dev/null 2>&1; then
      printf 'claudeb: token-upkeep: refreshed %s\n' "$name" >&2
    fi
  done < <(account_names)
  return 0
}

probe_accounts() {
  local dir="$1" allow_spend="$2" start_windows="${3:-false}" heal="${4:-false}" name pid pids="" now hreset allow_refresh=true
  local run_start retry_names="" rem min_rem converge_budget round spent wait actual
  run_start=$(date +%s)
  [ "$heal" != true ] || allow_refresh=false
  while IFS= read -r name; do
    probe_one "$name" "$dir" "$allow_spend" "$allow_refresh" &
    pid=$!
    pids="$pids $pid"
  done < <(account_names)
  # Publish in completion order — a wait-all barrier would hold every account's
  # fresh numbers hostage to the slowest probe. probe_one writes .result last on
  # every exit path, so a non-empty .result marks that account done.
  local done_list=' ' progress remaining
  while :; do
    progress=false
    remaining=false
    while IFS= read -r name; do
      case "$done_list" in *" $name "*) continue ;; esac
      if [ -s "$dir/$name.result" ]; then
        process_probe_result "$name" "$dir"
        done_list="$done_list$name "
        progress=true
      else
        remaining=true
      fi
    done < <(account_names)
    [ "$remaining" = true ] || break
    [ "$progress" = true ] || sleep 0.2
  done
  for pid in $pids; do
    wait "$pid" || true
  done
  # Weather leaves snapshots untouched and nothing else retries, so a partial refresh
  # would never converge; retry weather-failed accounts serially within the budget.
  converge_budget="${CLAUDEB_REFRESH_CONVERGE_S:-240}"
  [[ "$converge_budget" =~ ^[0-9]+$ ]] || converge_budget=240
  round=1
  spent=0
  while [ "$converge_budget" -gt 0 ]; do
    retry_names=""
    min_rem=""
    while IFS= read -r name; do
      [ "$(cat "$dir/$name.display" 2>/dev/null)" = '!' ] || continue
      if probe_weather_failed "$name" "$dir" "$run_start"; then
        retry_names="$retry_names $name"
        rem=$(oauth_retry_remaining "$name")
        if [ -z "$min_rem" ] || [ "$rem" -lt "$min_rem" ] 2>/dev/null; then min_rem="$rem"; fi
      fi
    done < <(account_names)
    [ -n "$retry_names" ] || break
    # Sleep to the SOONEST gated account's retry-after, not the farthest: one long
    # retry-after must not starve accounts that are ready to retry in seconds.
    wait=$(converge_backoff "$round")
    [ -n "$min_rem" ] && [ "$min_rem" -gt "$wait" ] 2>/dev/null && wait="$min_rem"
    [ "$((spent + wait))" -le "$converge_budget" ] 2>/dev/null || break
    actual="$wait"
    [ "${CLAUDEB_WEATHER_RETRY_DELAY:-}" = '' ] || actual="$CLAUDEB_WEATHER_RETRY_DELAY"
    [ "$actual" -le 0 ] 2>/dev/null || sleep "$actual" 2>/dev/null || true
    spent=$((spent + wait))
    for name in $retry_names; do
      [ "$(oauth_retry_remaining "$name")" -le 0 ] 2>/dev/null || continue
      probe_one "$name" "$dir" "$allow_spend" "$allow_refresh"
      process_probe_result "$name" "$dir"
    done
    round=$((round + 1))
  done
  [ "$heal" != true ] || heal_expired "$dir"
  [ "$start_windows" = true ] || return 0
  now=$(date +%s)
  local started=''
  while IFS= read -r name; do
    if is_disabled "$name"; then
      printf 'claudeb: %s: disabled; window not started\n' "$name" >&2
      continue
    fi
    case "$(cat "$dir/$name.display" 2>/dev/null)" in
      live|'live*') ;;
      auth!)
        messages_probe_and_mark "$name" "$dir" false || true
        continue
        ;;
      *)
        if [ "$(oauth_backoff_outcome "$name")" = failed ]; then
          messages_probe_and_mark "$name" "$dir" false || true
          continue
        fi
        printf 'claudeb: %s: usage probe failed; window state unknown, not starting a 5h window\n' "$name" >&2
        continue
        ;;
    esac
    hreset=$(jq -r '.five_hour.resets_at // 0' "$limits_dir/$name.json" 2>/dev/null) || hreset=0
    [[ "$hreset" =~ ^[0-9]+$ ]] || hreset=0
    [ "$hreset" -lt "$now" ] || continue
    if messages_probe_and_mark "$name" "$dir" true; then
      started="$started $name"
    elif [ "$(cat "$dir/$name.display" 2>/dev/null)" != 'auth!' ]; then
      printf 'claudeb: %s: window-open probe failed (weather); 5h window unconfirmed\n' "$name" >&2
    fi
  done < <(account_names)
  for name in $started; do
    reconcile_window "$name" "$dir"
  done
}

# The response to the window-opening /v1/messages can carry the just-expired
# window's reset; a follow-up free usage read returns the new window's
# authoritative resets_at. Advance-only: a usage read that still lags the fresh
# window must never roll resets_at back onto the value it just replaced.
reconcile_window() {
  local name="$1" dir="$2" file="$limits_dir/$name.json" rdir source rc http before before_reset after tmp lock
  before=$(jq -c '.five_hour // empty' "$file" 2>/dev/null) || before=''
  rdir=$(mktemp -d "${TMPDIR:-/tmp}/claudeb-reconcile.XXXXXX") || return 0
  probe_one "$name" "$rdir" false false
  read -r source rc http < "$rdir/$name.result" 2>/dev/null || source=''
  if [ "$source" = usage ] && merge_usage "$name" "$rdir/$name.usage" && [ -n "$before" ]; then
    before_reset=$(jq -r '.resets_at // 0' <<<"$before")
    lock="$file.lock"
    if ! lock_acquire "$lock"; then
      rm -rf "$rdir"
      return 0
    fi
    (
      trap 'lock_release "$lock"' EXIT
      after=$(jq -r '.five_hour.resets_at // 0' "$file" 2>/dev/null) || after=0
      if [ "${after:-0}" -lt "${before_reset:-0}" ] 2>/dev/null; then
        tmp="$limits_dir/.$name.json.rc.$$"
        if jq --argjson fh "$before" '.five_hour = $fh' "$file" > "$tmp" 2>/dev/null; then
          mv "$tmp" "$file" || rm -f "$tmp"
        else
          rm -f "$tmp"
        fi
      fi
    ) || true
  fi
  rm -rf "$rdir"
}

reserved_name() {
  case "$1" in
    .*|*/*|help|add|enable|disable|remove|use|accounts|status|st|profile|p|run|warm|token-upkeep) return 0 ;;
    *) return 1 ;;
  esac
}

add_account() {
  local name="${1:-}" token
  if [ -z "$name" ] || ! [[ "$name" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]] || [ "$name" = main ] || reserved_name "$name"; then
    printf 'usage: claudeb add <name> (must start with a letter, number, or underscore; use only letters, numbers, dots, underscores, and hyphens; not reserved words or "main")\n' >&2
    exit 2
  fi
  printf 'Run `claude setup-token` in any terminal, complete browser authentication, then paste the printed token here.\n'
  printf 'Token (input is visible): '
  IFS= read -r token
  token=$(printf '%s' "$token" | tr -d '[:space:]')
  if [ -z "$token" ]; then
    printf 'claudeb: EMPTY input — nothing was pasted; token NOT saved\n' >&2
    exit 1
  fi
  printf 'claudeb: got %s characters\n' "${#token}"
  case "$token" in
    sk-ant-oat01-*) ;;
    *)
      printf 'claudeb: this does not look like a setup-token (expected sk-ant-oat01-... prefix); NOT saved\n' >&2
      exit 1
      ;;
  esac
  printf 'claudeb: pinging the API with this token...\n'
  if reply=$(CLAUDE_CODE_OAUTH_TOKEN="$token" timeout 90 claude -p 'Reply with exactly: ok' --model haiku 2>&1); then
    printf 'claudeb: token WORKS (model replied: %s)\n' "$(printf '%s' "$reply" | tail -n 1)"
  else
    printf 'claudeb: token ping FAILED — NOT saved. Last output:\n%s\n' "$(printf '%s' "$reply" | tail -n 3)" >&2
    exit 1
  fi
  mkdir -p "$tokens_dir" "$limits_dir"
  chmod 700 "$base_dir" "$tokens_dir"
  (umask 077; printf '%s' "$token" > "$tokens_dir/$name")
  chmod 600 "$tokens_dir/$name"
  printf 'claudeb: saved and connected: %s\n' "$name"
}

write_state_file() {
  local name="$1" tmp
  mkdir -p "$base_dir"
  tmp="$state_file.tmp.$$"
  printf '%s\n' "$name" > "$tmp"
  mv "$tmp" "$state_file"
}

# A transcript records no account, so the only evidence of who paid for a session is the
# marker directory Claude Code stamps inside the profile home it ran under. Those markers
# live with the rest of a profile's session data and are pruned with it; this ledger is not,
# which is what lets spend still be attributed to an account months later. Harvesting on
# every launch picks up whatever the previous session left behind.
harvest_session_accounts() {
  local dir="$1" profile="$2" ledger="$base_dir/session-accounts.log"
  local marker session known started
  [ -d "$dir/session-env" ] || return 0
  mkdir -p "$base_dir" 2>/dev/null || return 0
  known=""
  [ -f "$ledger" ] && known=$(cut -f2 "$ledger" 2>/dev/null)
  for marker in "$dir"/session-env/*; do
    [ -e "$marker" ] || continue
    session="${marker##*/}"
    case "$known" in *"$session"*) continue ;; esac
    started=$(stat -f '%Sm' -t '%Y-%m-%dT%H:%M:%SZ' "$marker" 2>/dev/null) || started=""
    [ -n "$started" ] || started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    printf '%s\t%s\t%s\n' "$started" "$session" "$profile" >> "$ledger"
    known="$known
$session"
  done
}

enable_account() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    printf 'usage: claudeb enable <name>\n' >&2
    exit 2
  fi
  if [ ! -f "$tokens_dir/$name" ]; then
    printf 'claudeb: unknown account: %s\n' "$name" >&2
    exit 2
  fi
  if ! is_disabled "$name"; then
    printf 'claudeb: %s is already enabled\n' "$name"
    return
  fi
  set_disabled "$name" off
  printf 'claudeb: enabled %s\n' "$name"
}

disable_account() {
  local name="${1:-}" other enabled_left=0
  if [ -z "$name" ]; then
    printf 'usage: claudeb disable <name>\n' >&2
    exit 2
  fi
  if [ ! -f "$tokens_dir/$name" ]; then
    printf 'claudeb: unknown account: %s\n' "$name" >&2
    exit 2
  fi
  if is_disabled "$name"; then
    printf 'claudeb: %s is already disabled\n' "$name"
    return
  fi
  while IFS= read -r other; do
    if [ "$other" != "$name" ] && ! is_disabled "$other"; then
      enabled_left=$((enabled_left + 1))
    fi
  done < <(account_names)
  if [ "$enabled_left" -eq 0 ]; then
    printf 'claudeb: refusing to disable %s: it is the last enabled account\n' "$name" >&2
    exit 1
  fi
  set_disabled "$name" on
  printf 'claudeb: disabled %s\n' "$name"
}

remove_account() {
  local name='' force=false arg service creds tmp state sec_rc=0 exists=false alive=false attempts_lock
  local profiles_root="$HOME/.claude-profiles"
  local tiers_file="$base_dir/account-tiers"
  local fable_state_file="$base_dir/.claudeb-state-fable"
  for arg in "$@"; do
    case "$arg" in
      --force) force=true ;;
      -*) printf 'usage: claudeb remove <name> [--force]\n' >&2; exit 2 ;;
      *)
        if [ -n "$name" ]; then
          printf 'usage: claudeb remove <name> [--force]\n' >&2
          exit 2
        fi
        name="$arg"
        ;;
    esac
  done
  if [ -z "$name" ] || [ "$name" = main ] || ! [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    printf 'usage: claudeb remove <name> [--force]\n' >&2
    exit 2
  fi
  service=$(keychain_service "$name")
  # Distinguish "no keychain item" (exit 44) from a read error: a read error must
  # not read as empty creds, or the alive-guard below fails open on a live account.
  creds=$(security find-generic-password -s "$service" -w 2>/dev/null) || sec_rc=$?
  [ "$sec_rc" -eq 0 ] || creds=''
  # Existence spans every store, including metadata-only orphans (a stale
  # oauth-attempts entry, an account-tiers line, or a disabled flag) so they can
  # still be pruned after the token/profile/keychain are already gone.
  [ -f "$tokens_dir/$name" ] && exists=true
  [ -d "$profiles_root/$name" ] && exists=true
  [ -n "$creds" ] && exists=true
  if [ "$exists" != true ] && [ -r "$oauth_attempts_file" ] \
     && jq -e --arg n "$name" 'type == "object" and has($n)' "$oauth_attempts_file" >/dev/null 2>&1; then exists=true; fi
  if [ "$exists" != true ] && [ -r "$tiers_file" ] \
     && awk -F= -v n="$name" '{ k=$1; gsub(/^[ \t]+|[ \t]+$/, "", k); if (k == n) f=1 } END { exit !f }' "$tiers_file"; then exists=true; fi
  if [ "$exists" != true ] && is_disabled "$name"; then exists=true; fi
  if [ "$exists" != true ]; then
    printf 'claudeb: unknown account: %s\n' "$name" >&2
    exit 2
  fi
  # Aliveness depends on the account kind, which the keychain read distinguishes:
  #   sec_rc 0  → keychain account: judge the keychain blob (tokens/<name> is only
  #               the cached bearer, not proof of a live login);
  #   sec_rc 44 → no keychain item → setup-token account: a present, non-empty
  #               tokens/<name> IS its live token (claudeb add writes it there);
  #   other rc  → keychain read failed: cannot verify → fail closed (treat alive).
  if [ "$force" != true ]; then
    if [ "$sec_rc" -eq 0 ]; then
      { [ -n "$creds" ] && credentials_alive "$creds"; } && alive=true
    elif [ "$sec_rc" -eq 44 ]; then
      [ -s "$tokens_dir/$name" ] && alive=true
    else
      alive=true
    fi
    if [ "$alive" = true ]; then
      printf 'claudeb: refusing to remove %s: its credentials look alive (or could not be verified); log out first or pass --force\n' "$name" >&2
      exit 1
    fi
  fi

  rm -f "$tokens_dir/$name" "$limits_dir/$name.json"
  security delete-generic-password -s "$service" >/dev/null 2>&1 || true
  rm -rf "$profiles_root/$name"

  if [ -r "$oauth_attempts_file" ]; then
    # Same lock oauth_attempt_update takes, so a concurrent CLI writer is not
    # lost and the file is never left half-written.
    attempts_lock="$oauth_attempts_file.lock"
    if lock_acquire "$attempts_lock"; then
      tmp="$oauth_attempts_file.tmp.$$"
      if jq -c --arg name "$name" 'if type == "object" then del(.[$name]) else . end' \
          "$oauth_attempts_file" > "$tmp" 2>/dev/null; then
        mv "$tmp" "$oauth_attempts_file"
      else
        rm -f "$tmp"
      fi
      lock_release "$attempts_lock"
    fi
  fi
  # The bypass lock is a directory (mkdir-based lock_acquire) keyed by the same
  # tr-sanitized name oauth_attempt_begin uses — rm -rf, not rm -f, and match that
  # sanitization or a valid-but-non-identity name would leave an orphan dir.
  rm -rf "$oauth_attempts_file.bypass.$(printf '%s' "$name" | LC_ALL=C tr -c 'A-Za-z0-9._-' '_')"

  if [ -r "$tiers_file" ]; then
    tmp="$tiers_file.tmp.$$"
    if awk -F= -v n="$name" '{ k=$1; gsub(/^[ \t]+|[ \t]+$/, "", k); if (k != n) print }' \
        "$tiers_file" > "$tmp" 2>/dev/null; then
      mv "$tmp" "$tiers_file"
    else
      rm -f "$tmp"
    fi
  fi

  if is_disabled "$name"; then set_disabled "$name" off; fi

  if [ -r "$state_file" ]; then
    IFS= read -r state < "$state_file" || state=''
    [ "$state" = "$name" ] && rm -f "$state_file"
  fi
  if [ -r "$fable_state_file" ]; then
    IFS= read -r state < "$fable_state_file" || state=''
    [ "$state" = "$name" ] && rm -f "$fable_state_file"
  fi

  printf 'claudeb: removed %s\n' "$name"
}

show_help() {
  local bold='' cyan='' dim='' yellow='' reset=''
  if [ -t 1 ] && [ -n "${TERM:-}" ] && [ "${TERM:-}" != dumb ]; then
    bold=$'\033[1m'; cyan=$'\033[36m'; dim=$'\033[2m'; yellow=$'\033[33m'; reset=$'\033[0m'
  fi
  printf '%sclaudeb%s — multi-account launcher for Claude Code.\n\n' "$bold" "$reset"
  printf '  %s%sclaudeb profile <name>%s                  %sLaunch Claude with an explicit profile. Alias: p.%s\n' "$bold" "$cyan" "$reset" "$dim" "$reset"
  printf '  %s%sclaudeb -p <claude args...>%s             %sHeadless run; worker-pick chooses the account.%s\n' "$bold" "$cyan" "$reset" "$dim" "$reset"
  printf '  %s%sclaudeb --refresh [--spend] [--start-windows] [--heal]%s\n' "$bold" "$cyan" "$reset"
  printf '                                          %sFree refresh; --spend adds the 1-token fallback,%s\n' "$dim" "$reset"
  printf '                                          %s--start-windows pings expired 5h windows.%s\n' "$dim" "$reset"
  printf '  %s%sclaudeb warm [--start-window] [names...]%s %sHeal profiles and limits; free: session init + /usage only;%s\n' "$bold" "$cyan" "$reset" "$dim" "$reset"
  printf '                                          %sfalls back to a minimal paid prompt only if that fails.%s\n' "$dim" "$reset"
  printf '                                          %s--start-window pings an expired 5h window after a good warm.%s\n' "$dim" "$reset"
  printf '  %s%sclaudeb token-upkeep%s                    %sRefresh tokens near expiry (no probes/spend); for wake/cron pre-warm.%s\n' "$bold" "$cyan" "$reset" "$dim" "$reset"
  printf '  %s%sclaudeb status [--live] [--plain] [--spend] [--start-windows] [--heal]%s\n' "$bold" "$cyan" "$reset"
  printf '                                          %sShow cached limits (no network); --live probes now. Aliases: st, accounts.%s\n' "$dim" "$reset"
  printf '  %s%sclaudeb enable <name>%s                   %sReturn an account to worker selection.%s\n' "$bold" "$cyan" "$reset" "$dim" "$reset"
  printf '  %s%sclaudeb disable <name>%s                  %sExclude an account from worker selection.%s\n' "$bold" "$cyan" "$reset" "$dim" "$reset"
  printf '  %s%sclaudeb use <name>|--clear%s              %sPin worker selection to one account; no name prints the pin.%s\n' "$bold" "$cyan" "$reset" "$dim" "$reset"
  printf '  %s%sclaudeb add <name>%s                      %sValidate and save a setup-token.%s\n' "$bold" "$cyan" "$reset" "$dim" "$reset"
  printf '  %s%sclaudeb remove <name> [--force]%s          %sForget an account everywhere; --force overrides a live-creds guard.%s\n' "$bold" "$cyan" "$reset" "$dim" "$reset"
  printf '  %s↑/↓%s select  %s⏎%s launch profile  %s←/→%s sort  %sr%s refresh (async)  %sq/Esc%s exit interactive status\n\n' "$yellow" "$reset" "$yellow" "$reset" "$yellow" "$reset" "$yellow" "$reset" "$yellow" "$reset"
  printf '%sDATA%s\n' "$bold" "$reset"
  printf '  Tokens: %s/tokens/<account>\n' "$base_dir"
  printf '  Limits: %s/limits/<account>.json\n' "$base_dir"
  printf '  Guide:  ~/.claude-profiles/README.md\n'
}

# `-p`/`--print` is what separates a program calling claudeb from a human entering a session,
# and both callers need that distinction: a human must name the profile (the whole point of
# dropping rotation), a headless caller cannot know which account is affordable, and only an
# interactive launch defines "current" for the markers.
args_are_headless() {
  local arg
  for arg in "$@"; do
    case "$arg" in -p|--print|--print=*) return 0 ;; esac
  done
  return 1
}

# The sibling of the resolved script is preferred so both halves of the query contract normally
# come from one checkout; PATH is a fallback for an install that ships them separately, and there
# the two CAN be different versions — hence the explicit exit-code handling at the call site.
worker_pick_cmd() {
  if [ -n "${CLAUDEB_WORKER_PICK:-}" ]; then printf '%s' "$CLAUDEB_WORKER_PICK"; return 0; fi
  if [ -x "$claudeb_root/bin/worker-pick" ]; then
    printf '%s' "$claudeb_root/bin/worker-pick"
    return 0
  fi
  command -v worker-pick 2>/dev/null || return 1
}

# Headless callers (find-truth, usage-ai-report, any script) get the account from the same
# math the workers use. No wall, no hold, no retry: an unselectable pool is an immediate
# refusal, never a request parked until it turns into a 503.
routed_profile_command() {
  local pick account rc=0
  pick=$(worker_pick_cmd) || pick=""
  if [ -z "$pick" ] || [ ! -x "$pick" ]; then
    printf 'claudeb: cannot route without worker-pick; use `claudeb profile <name>`\n' >&2
    return 2
  fi
  account=$("$pick" --account claudeb) || rc=$?
  # The query's own exit 3 is passed through rather than flattened into a usage error: a caller
  # deciding between "retry after the window resets" and "this is misconfigured" needs them apart.
  if [ "$rc" -eq 3 ]; then
    printf 'claudeb: worker-pick selected no account; use `claudeb profile <name>`\n' >&2
    return 3
  fi
  if [ "$rc" -ne 0 ] || [ -z "$account" ]; then
    printf 'claudeb: worker-pick failed (exit %s); use `claudeb profile <name>`\n' "$rc" >&2
    return 2
  fi
  printf 'claudeb: worker-pick selected %s\n' "$account" >&2
  profile_command "$account" "$@"
}

profile_command() {
  local profiles_dir="$HOME/.claude-profiles" profile="${1:-}" dir d f near cred_state
  if [ "$profile" = --direct ]; then
    printf 'claudeb: --direct was removed; use `claudeb profile <name>`\n' >&2
    return 2
  fi
  if [ "$profile" = -h ] || [ "$profile" = --help ]; then
    show_help
    return
  fi
  if [ -z "$profile" ]; then
    profile_required
    return $?
  fi
  for d in "$@"; do
    if [ "$d" = --direct ]; then
      printf 'claudeb: --direct was removed; use `claudeb profile <name>`\n' >&2
      return 2
    fi
  done
  if ! [[ "$profile" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]]; then
    printf "claudeb: invalid profile name '%s' (must start with a letter, number, or underscore; use only letters, numbers, dots, underscores, and hyphens)\n" "$profile" >&2
    return 2
  fi
  # Creating a profile is allowed, but not under a name the rest of the tool cannot address:
  # `main` IS ~/.claude rather than a profile dir, and a reserved word can never be reached
  # again as a subcommand argument.
  if ! profile_has_credentials "$profile" && { [ "$profile" = main ] || reserved_name "$profile"; }; then
    printf "claudeb: '%s' is reserved and cannot be a new profile name\n" "$profile" >&2
    return 2
  fi
  # An unknown name is a new profile, not an error: Claude asks for the login and the profile
  # becomes real once credentials exist. So the only help worth giving is naming the
  # near-misses before the login window opens. Announced only on a PROVEN absence — an
  # unverifiable keychain must not tell someone their long-standing account is new.
  cred_state=0
  profile_credentials_state "$profile" || cred_state=$?
  if [ "$cred_state" -eq 1 ]; then
    printf 'claudeb: %s is new — Claude will ask you to log in; it stays a profile only if you do.\n' "$profile" >&2
    near=$(similar_account_names "$profile" || true)
    [ -z "$near" ] || printf 'claudeb: did you mean %s?\n' "$near" >&2
  fi
  shift
  dir="$profiles_dir/$profile"
  if [ ! -d "$dir" ]; then
    mkdir -p "$dir"
  fi
  # Restamp on every launch so a login that is being retried cannot age past the unclaimed
  # grace period and be pruned by a `status` running in another terminal mid-login.
  touch "$dir" 2>/dev/null || true
  # A profile isolates only auth (.claude.json + keychain entry); config AND
  # session data (resume transcripts, prompt history, rewind, plugins) are
  # shared with ~/.claude. Links are re-ensured on every launch so new shared
  # items propagate; a real (non-symlink) entry is never replaced.
  for f in settings.json settings.local.json keybindings.json CLAUDE.md agents commands skills \
           statusline.sh hooks plugins projects sessions file-history plans chrome history.jsonl; do
    if [ -e "$HOME/.claude/$f" ] && [ ! -e "$dir/$f" ] && [ ! -L "$dir/$f" ]; then
      ln -s "$HOME/.claude/$f" "$dir/$f"
    fi
  done
  # user-scope MCP servers live in ~/.claude.json, which cannot be shared
  # (it also holds oauthAccount); copy the servers over, profile keys win
  if command -v jq >/dev/null 2>&1 && [ -f "$HOME/.claude.json" ]; then
    servers=$(jq -c '.mcpServers // {}' "$HOME/.claude.json" 2>/dev/null || printf '{}')
    if [ -n "$servers" ] && [ "$servers" != '{}' ]; then
      if [ -f "$dir/.claude.json" ]; then
        tmp=$(mktemp)
        if jq --argjson s "$servers" '.mcpServers = ($s + (.mcpServers // {}))' \
             "$dir/.claude.json" >"$tmp" 2>/dev/null && [ -s "$tmp" ]; then
          mv "$tmp" "$dir/.claude.json"
        else
          rm -f "$tmp"
        fi
      else
        printf '{"mcpServers":%s}\n' "$servers" >"$dir/.claude.json"
      fi
    fi
  fi
  if [ "${CLAUDEB_PREPARE_ONLY:-false}" = true ]; then
    prepared_profile_dir="$dir"
    return
  fi
  if is_disabled "$profile"; then
    printf 'claudeb: note: %s is disabled for worker selection; using it directly\n' "$profile" >&2
  fi
  # Headless worker spawns run constantly on other accounts; letting them stamp the state file
  # would make the `*`/`●`/`cb:` markers name the last worker instead of the account the user
  # sits in.
  harvest_session_accounts "$dir" "$profile" || true
  args_are_headless "$@" || write_state_file "$profile"
  exec env -u ANTHROPIC_BASE_URL -u CLAUDE_CODE_OAUTH_TOKEN \
    CLAUDE_CONFIG_DIR="$dir" CLAUDE_LIMITS_ACCOUNT="$profile" claude "$@"
}

profile_required() {
  local name found=0
  printf 'claudeb: profile required — rotation has been removed.\n\n' >&2
  printf 'Available profiles:\n' >&2
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    if is_disabled "$name"; then
      printf '  %s (disabled)\n' "$name" >&2
    else
      printf '  %s (enabled)\n' "$name" >&2
    fi
    found=1
  done < <(account_names)
  [ "$found" -eq 1 ] || printf '  (none found)\n' >&2
  printf '\nUse: claudeb profile <name>\n' >&2
  printf '     claudeb profile <name> --resume <session-id>\n' >&2
  printf '\nOnly a headless run (-p) picks an account itself, through worker-pick.\n' >&2
  return 2
}

run_warm_session() {
  local dir="$1" name="$2" output="$3" prompt="$4"
  shift 4
  timeout 90 env CLAUDE_CONFIG_DIR="$dir" CLAUDE_LIMITS_ACCOUNT="$name" \
    claude -p "$prompt" "$@" --output-format json >"$output" 2>&1
}

persist_warm_output() {
  local name="$1" rc="$2" output="$3" log_dir="$base_dir/warm-logs" temporary outcome
  [ "$rc" -eq 0 ] && outcome=success || outcome=failed
  mkdir -p "$log_dir" || return 1
  temporary=$(mktemp "$log_dir/.${name}.log.XXXXXX") || return 1
  {
    printf 'timestamp=%s outcome=%s exit_code=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$outcome" "$rc"
    cat "$output"
  } >"$temporary" || {
    rm -f "$temporary"
    return 1
  }
  if ! mv -f "$temporary" "$log_dir/$name.log"; then
    rm -f "$temporary"
    return 1
  fi
}

warm_failure() {
  local name="$1" cause="$2" detail="$3"
  if [ "${warm_single_explicit:-false}" = true ]; then
    printf 'claudeb: warm failed account=%s cause=%s\n' "$name" "$cause" >&2
  else
    printf '%s: failed (%s)\n' "$name" "$detail"
  fi
}

warm_accounts() {
  local name dir output session_rc reason failure_cause service credentials expires_at now started probe_dir source rc http asof failed=0 until probe_ok usage_rate_limited backoff_mode explicit=false refresh_rc start_window=false hreset arg warm_manual_explicit=false
  local CLAUDEB_OAUTH_BYPASS_BACKOFF="${CLAUDEB_OAUTH_BYPASS_BACKOFF:-false}"
  local -a names
  names=()
  for arg in "$@"; do
    case "$arg" in
      --start-window) start_window=true ;;
      *) names+=("$arg") ;;
    esac
  done
  [ "${#names[@]}" -eq 0 ] || explicit=true
  backoff_mode="${CLAUDEB_WARM_BACKOFF_MODE:-$([ "$explicit" = true ] && printf retry-after || printf all)}"
  if [ "${#names[@]}" -eq 0 ]; then
    while IFS= read -r name; do
      is_disabled "$name" || names+=("$name")
    done < <(account_names)
  fi
  if [ "${#names[@]}" -eq 0 ]; then
    printf 'claudeb: no enabled accounts to warm\n' >&2
    return 1
  fi
  warm_single_explicit=false
  if [ "$explicit" = true ] && [ "${#names[@]}" -eq 1 ]; then warm_single_explicit=true; fi
  # Every refresh menu click supplies this signal; background callers do not.
  if user_refresh_explicit; then warm_manual_explicit=true; fi
  if [ "$warm_manual_explicit" != true ] && token_freeze_active; then
    for name in "${names[@]}"; do
      # An account that does not exist is a failure whether or not the freeze is on: skipping
      # first would report a refresh of a typo as successfully skipped.
      if [ ! -f "$tokens_dir/$name" ]; then
        warm_failure "$name" unknown-account 'unknown account'
        failed=1
        continue
      fi
      token_journal "$name" warm frozen-skip
      printf 'claudeb: %s: warm skipped — token-endpoint auto-refresh frozen (experiment)\n' "$name" >&2
      # The caller cannot tell a skip from a success by re-reading the freeze, which may lift
      # between the two reads; this says it happened, once, from inside the skip.
      [ -n "${CLAUDEB_WARM_SKIP_MARKER:-}" ] && : > "$CLAUDEB_WARM_SKIP_MARKER"
    done
    return "$failed"
  fi
  for name in "${names[@]}"; do
    if [ ! -f "$tokens_dir/$name" ]; then
      warm_failure "$name" unknown-account 'unknown account'
      failed=1
      continue
    fi
    case "$CLAUDEB_OAUTH_BYPASS_BACKOFF" in
      1|true|TRUE|yes|YES|on|ON) until=0 ;;
      *) until=$(oauth_warm_backoff_until "$name" "$backoff_mode") ;;
    esac
    now=$(date +%s)
    if [ "$until" -gt "$now" ] 2>/dev/null; then
      warm_failure "$name" warm-429 "warm backoff active until $(format_time "$until")"
      failed=1
      continue
    fi
    prepared_profile_dir=''
    CLAUDEB_PREPARE_ONLY=true profile_command "$name" || {
      warm_failure "$name" profile-setup 'profile setup'
      oauth_attempt_update "$name" warm-failed 0 0 profile-setup
      failed=1
      continue
    }
    dir="$prepared_profile_dir"
    service=$(keychain_service "$name")
    # A wiped/absent credential is logged out, not warmable: record auth_needed
    # and skip the warm session entirely (no token endpoint, no oauth-attempt).
    if detect_logged_out "$name"; then
      warm_failure "$name" needs-relogin 'logged out (no credentials)'
      failed=1
      continue
    fi
    output=$(mktemp "${TMPDIR:-/tmp}/claudeb-warm.XXXXXX") || return 1
    oauth_attempt_update "$name" warming 0
    started=$(date +%s)
    session_rc=0
    reason=''
    usage_rate_limited=false
    if run_warm_session "$dir" "$name" "$output" /usage; then :; else session_rc=$?; fi
    if [ "$session_rc" -ne 0 ] && grep -Eqi '429|rate.?limit' "$output" 2>/dev/null; then
      usage_rate_limited=true
    fi
    # A failed /usage warm reports and stops; it must not spend. The paid haiku
    # probe below only ever runs behind an explicit opt-in no automated caller
    # (menu refresh, heal, start-windows, selfcheck) ever sets.
    if [ "$session_rc" -ne 0 ] && [ "$usage_rate_limited" != true ] \
      && [ "${CLAUDEB_WARM_ALLOW_PAID:-false}" = true ] && [ "${CLAUDEB_WARM_FREE_ONLY:-false}" != true ]; then
      session_rc=0
      if run_warm_session "$dir" "$name" "$output" ok --model haiku; then :; else session_rc=$?; fi
    fi
    if ! persist_warm_output "$name" "$session_rc" "$output"; then
      printf 'claudeb: %s: failed to persist warm output\n' "$name" >&2
    fi
    if [ "$session_rc" -ne 0 ]; then
      reason="session exit $session_rc"
      failure_cause=warm-failed
      if [ "$session_rc" -eq 124 ]; then
        reason='timeout'
        failure_cause=timeout
      elif grep -Eqi '429|rate.?limit' "$output" 2>/dev/null; then
        reason='warm 429'
        failure_cause=warm-429
      elif grep -Eqi 'needs? re-?login|login required|not logged in|authentication required|run /login' "$output" 2>/dev/null; then
        credentials=$(security find-generic-password -s "$service" -w 2>/dev/null) || credentials=''
        if [ -z "$credentials" ]; then
          reason='needs re-login'
          failure_cause=needs-relogin
          mark_auth "$name" expired 'needs re-login'
        else
          if credentials=$(oauth_refresh "$name" "$service" "$credentials"); then
            refresh_rc=0
            mark_auth "$name" ok
          else
            refresh_rc=$?
          fi
          credentials=''
          if [ "$refresh_rc" -eq 0 ]; then
            reason='transient login prompt'
            failure_cause=warm-failed
          else
            failure_cause=$(warm_cause_from_refresh "$name" "$refresh_rc")
            if [ "$failure_cause" = needs-relogin ]; then
              reason='needs re-login'
              mark_auth "$name" expired 'needs re-login'
            else
              reason='token refresh weather'
            fi
          fi
        fi
      fi
      oauth_attempt_update "$name" warm-failed 0 0 "$failure_cause"
    fi
    if [ "$session_rc" -ne 0 ]; then
      rm -f "$output"
      warm_failure "$name" "$failure_cause" "$reason"
      failed=1
      continue
    fi
    rm -f "$output"
    credentials=$(security find-generic-password -s "$service" -w 2>/dev/null || true)
    expires_at=$(printf '%s' "$credentials" | jq -r '.claudeAiOauth.expiresAt // 0 | floor' 2>/dev/null || printf '0')
    now=$(date +%s)
    if ! [[ "$expires_at" =~ ^[0-9]+$ ]] || [ "$expires_at" -le "$((now * 1000))" ]; then
      if [ -z "$credentials" ]; then
        credentials=''
        mark_auth "$name" expired 'needs re-login'
        oauth_attempt_update "$name" warm-failed 0 0 needs-relogin
        warm_failure "$name" needs-relogin 'OAuth credentials missing'
        failed=1
        continue
      fi
      if credentials=$(oauth_refresh "$name" "$service" "$credentials"); then
        refresh_rc=0
        credentials=$(security find-generic-password -s "$service" -w 2>/dev/null || true)
        expires_at=$(printf '%s' "$credentials" | jq -r '.claudeAiOauth.expiresAt // 0 | floor' 2>/dev/null || printf '0')
        now=$(date +%s)
        if ! [[ "$expires_at" =~ ^[0-9]+$ ]] || [ "$expires_at" -le "$((now * 1000))" ]; then refresh_rc=1; fi
      else
        refresh_rc=$?
      fi
      if [ "$refresh_rc" -ne 0 ]; then
        failure_cause=$(warm_cause_from_refresh "$name" "$refresh_rc")
        if [ "$failure_cause" = needs-relogin ]; then
          reason='OAuth refresh rejected'
          mark_auth "$name" expired 'needs re-login'
        else
          reason='OAuth refresh weather'
        fi
        credentials=''
        oauth_attempt_update "$name" warm-failed 0 0 "$failure_cause"
        warm_failure "$name" "$failure_cause" "$reason"
        failed=1
        continue
      fi
    fi
    credentials=''
    probe_dir=$(mktemp -d "${TMPDIR:-/tmp}/claudeb-warm-probe.XXXXXX") || return 1
    probe_one "$name" "$probe_dir" false false
    read -r source rc http < "$probe_dir/$name.result"
    if [ "$source" = logged-out ]; then
      # Credentials went missing after the warm session; auth_needed is already
      # recorded — report and skip without writing an oauth-attempt entry.
      rm -rf "$probe_dir"
      warm_failure "$name" needs-relogin 'logged out (no credentials)'
      failed=1
      continue
    fi
    probe_ok=false
    if [ "$source" = usage ] && merge_usage "$name" "$probe_dir/$name.usage"; then probe_ok=true; fi
    if [ "$probe_ok" = true ]; then
      asof=$(jq -r '.five_hour.as_of // 0' "$limits_dir/$name.json" 2>/dev/null || printf '0')
      if [ "$asof" -ge "$started" ] 2>/dev/null && jq -e '.fable.as_of | type == "number"' "$limits_dir/$name.json" >/dev/null 2>&1; then
        CLAUDEB_JOURNAL_KIND=warm oauth_attempt_update "$name" success 0
        if [ "$start_window" = true ]; then
          hreset=$(jq -r '.five_hour.resets_at // 0' "$limits_dir/$name.json" 2>/dev/null) || hreset=0
          [[ "$hreset" =~ ^[0-9]+$ ]] || hreset=0
          now=$(date +%s)
          if [ "$hreset" -lt "$now" ]; then
            if messages_probe_and_mark "$name" "$probe_dir" true; then
              # Re-read usage for seven_day/fable, then let the ping's headers win
              # five_hour back: the usage endpoint can lag the just-opened window.
              probe_one "$name" "$probe_dir" false false
              read -r source rc http < "$probe_dir/$name.result"
              if [ "$source" = usage ] && merge_usage "$name" "$probe_dir/$name.usage"; then
                merge_headers "$name" "$probe_dir/$name.headers" \
                  || printf 'claudeb: %s: window opened but header re-merge failed; snapshot heals on next refresh\n' "$name" >&2
              fi
              printf '%s: 5h window started\n' "$name"
            elif [ "$(cat "$probe_dir/$name.display" 2>/dev/null)" != 'auth!' ]; then
              printf 'claudeb: %s: window-open probe failed (weather); 5h window unconfirmed\n' "$name" >&2
            fi
          fi
        fi
        printf '%s: warmed (expiresAt=%s, as_of=%s)\n' "$name" "$expires_at" "$asof"
        rm -rf "$probe_dir"
        continue
      fi
    fi
    rm -rf "$probe_dir"
    if [ "$http" = 401 ] || [ "$http" = 403 ]; then
      failure_cause=needs-relogin
    elif [ "$http" = 429 ]; then
      failure_cause=warm-429
    else
      failure_cause=usage-probe-failed
    fi
    oauth_attempt_update "$name" warm-failed 0 0 "$failure_cause"
    warm_failure "$name" "$failure_cause" "usage probe HTTP ${http:-000}"
    failed=1
  done
  return "$failed"
}

accounts_reselect() {
  accounts_result=$(selection)
  accounts_picked=$(printf '%s' "$accounts_result" | jq -r .picked)
  accounts_show_fable=$(printf '%s' "$accounts_result" | jq -r 'any(.data[]; .fable != null)')
}

collect_accounts() {
  local mode="$1"
  [ -z "${accounts_probe_dir:-}" ] || rm -rf "$accounts_probe_dir"
  accounts_probe_dir=""
  accounts_mode="$mode"
  if [ "$mode" = live ]; then
    accounts_probe_dir=$(mktemp -d "${TMPDIR:-/tmp}/claudeb.XXXXXX")
    probe_accounts "$accounts_probe_dir" "$accounts_allow_spend" "$accounts_start_windows" "$accounts_heal"
  fi
  accounts_reselect
}

# Background 'r' probe: all stdout+stderr goes to probe.log (per-attempt OAuth 429
# noise must never reach the TUI); completion is a .done sentinel — kill -0 is
# unreliable once the job is an unreaped zombie.
accounts_refresh_start() {
  [ -z "${accounts_refresh_pid:-}" ] || return 1
  accounts_refresh_dir=$(mktemp -d "${TMPDIR:-/tmp}/claudeb-refresh.XXXXXX") || { accounts_refresh_dir=''; return 1; }
  accounts_refresh_started=$(date +%s)
  # Job control puts the wrapper in its own process group, so cancelling can take
  # down the probe_one children with it — a bare kill orphans them mid-request.
  set -m
  {
    # The || true keeps set -e from aborting the subshell before the sentinel is
    # written; a hung probe would otherwise leave the spinner spinning forever.
    probe_accounts "$accounts_refresh_dir" "$accounts_allow_spend" "$accounts_start_windows" "$accounts_heal" || true
    printf 'done\n' >"$accounts_refresh_dir/.done"
  } >"$accounts_refresh_dir/probe.log" 2>&1 &
  accounts_refresh_pid=$!
  set +m
  return 0
}

accounts_refresh_running() {
  [ -n "${accounts_refresh_pid:-}" ] || return 1
  [ ! -e "$accounts_refresh_dir/.done" ]
}

accounts_refresh_kill() {
  if [ -n "${accounts_refresh_pid:-}" ]; then
    kill -- "-$accounts_refresh_pid" 2>/dev/null || kill "$accounts_refresh_pid" 2>/dev/null || true
    wait "$accounts_refresh_pid" 2>/dev/null || true
  fi
  [ -z "${accounts_refresh_dir:-}" ] || rm -rf "$accounts_refresh_dir"
  accounts_refresh_pid=''
  accounts_refresh_dir=''
}

accounts_refresh_finish() {
  wait "$accounts_refresh_pid" 2>/dev/null || true
  [ -z "${accounts_probe_dir:-}" ] || rm -rf "$accounts_probe_dir"
  accounts_probe_dir="$accounts_refresh_dir"
  accounts_mode=live
  accounts_reselect
  accounts_status_line=$(accounts_refresh_outcome "$accounts_probe_dir")
  # Ownership moved to accounts_probe_dir; drop the ref so kill/cleanup never double-frees.
  accounts_refresh_dir=''
  accounts_refresh_pid=''
}

accounts_refresh_cause() {
  local name="$1" state="$2" outcome
  if [ "$state" = 'auth!' ]; then printf 'auth'; return; fi
  if [ "$state" = login ]; then printf 'logged out'; return; fi
  outcome=$(oauth_backoff_outcome "$name")
  case "$outcome" in
    429) printf 'token 429' ;;
    weather) printf 'token weather' ;;
    failed) printf 'token error' ;;
    *) printf 'probe failed' ;;
  esac
}

accounts_refresh_outcome() {
  local dir="$1" name state stale='' cause
  while IFS= read -r name; do
    is_disabled "$name" && continue
    state=$(cat "$dir/$name.display" 2>/dev/null || printf '')
    case "$state" in
      live|'live*') ;;
      *)
        cause=$(accounts_refresh_cause "$name" "$state")
        stale="${stale:+$stale, }$name ($cause)"
        ;;
    esac
  done < <(account_names)
  if [ -z "$stale" ]; then
    printf '✓ refreshed %s' "$(date '+%H:%M')"
  else
    printf '⚠ %s not refreshed' "$stale"
  fi
}

accounts_spinner_frame() {
  local i="$1"
  local -a frames=('|' '/' '-' '\')
  printf '%s' "${frames[$(( i % ${#frames[@]} ))]}"
}

render_plain_accounts() {
  local row name h5 wk fable hreset wreset age marker age_text probe_state
  local dim='' sgr0='' h5_dim wk_dim fable_dim disabled h5_cell wk_cell fable_cell hcell wcell
  if [ -t 1 ] && [ -n "${TERM:-}" ] && [ "${TERM:-}" != dumb ]; then
    dim=$'\033[2m'; sgr0=$'\033[0m'
  fi
  if [ "$accounts_show_fable" = true ]; then
    printf '%-18s %7s %7s %7s %-11s %-11s %10s %s\n' NAME 5H WEEKLY FABLE '5H RESET' 'WEEKLY RESET' AGE PICK
  else
    printf '%-18s %7s %7s %-11s %-11s %10s %s\n' NAME 5H WEEKLY '5H RESET' 'WEEKLY RESET' AGE PICK
  fi
  while IFS= read -r row; do
    IFS=$'\x1f' read -r name h5 wk fable hreset wreset age h5_dim wk_dim fable_dim disabled < <(printf '%s' "$row" | jq -r '
      [.name, (.h5_raw | round | tostring),
       (if .wk_raw == null then "-" else ((.wk_raw | round | tostring) + "%") end),
       (if .fable_raw == null then "-" else ((.fable_raw | round | tostring) + "%") end),
       (.hreset | tostring), (.wreset | tostring), (.age | tostring),
       (.h5_dim | tostring), (.wk_dim | tostring), (.fable_dim | tostring),
       ((.disabled // false) | tostring)] | join("\u001f")')
    age_text=$(format_age "$age")
    if [ "$accounts_mode" = live ]; then
      probe_state=$(cat "$accounts_probe_dir/$name.display")
      if [ "$probe_state" = live ] || [ "$probe_state" = 'live*' ] || [ "$probe_state" = 'auth!' ] || [ "$probe_state" = login ]; then
        age_text="$probe_state"
      else
        age_text="${age_text}!"
      fi
    fi
    marker=""
    [ "$name" = "$accounts_picked" ] && marker="*"
    [ "$disabled" != true ] || marker="off"
    # Cells are padded before the SGR wrap so escape bytes never skew columns.
    h5_cell=$(printf '%6s%%' "$h5")
    hcell=$(printf '%-11s' "$(format_reset_time "$hreset")")
    if [ "$h5_dim" = true ] && [ -n "$dim" ]; then h5_cell="${dim}${h5_cell}${sgr0}"; hcell="${dim}${hcell}${sgr0}"; fi
    wk_cell=$(printf '%7s' "$wk")
    wcell=$(printf '%-11s' "$(format_reset_time "$wreset")")
    if [ "$wk_dim" = true ] && [ "$wk" != "-" ] && [ -n "$dim" ]; then wk_cell="${dim}${wk_cell}${sgr0}"; fi
    if [ "$wk_dim" = true ] && [ -n "$dim" ]; then wcell="${dim}${wcell}${sgr0}"; fi
    if [ "$accounts_show_fable" = true ]; then
      fable_cell=$(printf '%7s' "$fable")
      if [ "$fable_dim" = true ] && [ "$fable" != "-" ] && [ -n "$dim" ]; then fable_cell="${dim}${fable_cell}${sgr0}"; fi
      printf '%-18s %s %s %s %s %s %10s %s\n' "$name" "$h5_cell" "$wk_cell" "$fable_cell" "$hcell" "$wcell" "$age_text" "$marker"
    else
      printf '%-18s %s %s %s %s %10s %s\n' "$name" "$h5_cell" "$wk_cell" "$hcell" "$wcell" "$age_text" "$marker"
    fi
  done < <(printf '%s' "$accounts_result" | jq -c '.data[]')
}

interactive_cleanup() {
  if [ -t 1 ]; then
    stty sane echo </dev/tty >/dev/tty 2>/dev/null || true
    tput cnorm 2>/dev/null || true
  fi
}

colored_percent() {
  local value="$1" dim="${2:-false}" color pre=''
  if [ "$value" -lt 50 ]; then color=$'\033[32m'
  elif [ "$value" -lt 80 ]; then color=$'\033[33m'
  else color=$'\033[31m'
  fi
  [ "$dim" != true ] || pre=$'\033[2m'
  printf '%b%b%3s%%%b' "$pre" "$color" "$value" $'\033[0m'
}

render_sort_tab() {
  local label="$1" index="$2" active="$3"
  if [ "$index" -eq "$active" ]; then printf '\033[7m%s\033[0m' "$label"
  else printf '%s' "$label"
  fi
}

accounts_sort_filter() {
  case "$1" in
    name) printf '.data | sort_by(.name)[]' ;;
    h5) printf '.data | sort_by([-.h5, .name])[]' ;;
    wk) printf '.data | sort_by([-.wk, .name])[]' ;;
    fable) printf '.data | sort_by([-((.fable // -1)), .name])[]' ;;
    hreset) printf '.data | sort_by([(if .hreset > 0 then .hreset else 99999999999 end), .name])[]' ;;
    wreset) printf '.data | sort_by([(if .wreset > 0 then .wreset else 99999999999 end), .name])[]' ;;
  esac
}

sorted_account_names() {
  printf '%s' "$accounts_result" | jq -r "$(accounts_sort_filter "$1") | .name"
}

selection_after_move() {
  local dir="$1" cur="$2"; shift 2
  local -a names=("$@")
  local n=${#names[@]} i idx=-1
  if [ "$n" -eq 0 ]; then return 0; fi
  for i in "${!names[@]}"; do
    if [ "${names[$i]}" = "$cur" ]; then idx=$i; break; fi
  done
  if [ "$idx" -lt 0 ]; then
    if [ "$dir" = down ]; then idx=0; else idx=$((n - 1)); fi
  elif [ "$dir" = down ]; then
    [ "$idx" -lt $((n - 1)) ] && idx=$((idx + 1)) || true
  else
    [ "$idx" -gt 0 ] && idx=$((idx - 1)) || true
  fi
  printf '%s' "${names[$idx]}"
}

claudeb_exec() { exec "$@"; }

maybe_launch_profile() {
  [ -n "${accounts_launch:-}" ] || return 0
  # Terminal is already restored and traps cleared by the caller before this
  # runs, so the exec'd Claude session inherits a clean cooked terminal.
  claudeb_exec "$0" profile "$accounts_launch"
}

render_interactive_accounts() {
  local active="$1" sort_key="$2" sel="${3:-}" filter row name h5 wk fable hreset wreset age age_text marker off_text probe_state index=0
  local h5_dim wk_dim fable_dim disabled hcell wcell sep_width row_out inv=$'\033[7m' sgr0=$'\033[0m'
  printf '\033[H\033[2J'
  printf '  '
  render_sort_tab "$(printf '%-16s' NAME)" "$index" "$active"; index=$((index + 1)); printf ' '
  render_sort_tab "$(printf '%4s' 5H)" "$index" "$active"; index=$((index + 1)); printf '  '
  render_sort_tab "$(printf '%6s' WEEKLY)" "$index" "$active"; index=$((index + 1)); printf '  '
  if [ "$accounts_show_fable" = true ]; then
    render_sort_tab "$(printf '%6s' FABLE)" "$index" "$active"; index=$((index + 1)); printf '  '
  fi
  render_sort_tab "$(printf '%-11s' '5H RESET')" "$index" "$active"; index=$((index + 1)); printf ' '
  render_sort_tab "$(printf '%-11s' 'WEEKLY RESET')" "$index" "$active"
  printf ' AGE\n'
  sep_width=60
  [ "$accounts_show_fable" != true ] || sep_width=68
  printf '─%.0s' $(seq 1 "$sep_width"); printf '\n'
  filter=$(accounts_sort_filter "$sort_key")
  while IFS= read -r row; do
    IFS=$'\x1f' read -r name h5 wk fable hreset wreset age h5_dim wk_dim fable_dim disabled < <(printf '%s' "$row" | jq -r '
      [.name, (.h5_raw | round | tostring),
       (if .wk_raw == null then "" else (.wk_raw | round | tostring) end),
       (if .fable_raw == null then "" else (.fable_raw | round | tostring) end),
       (.hreset | tostring), (.wreset | tostring), (.age | tostring),
       (.h5_dim | tostring), (.wk_dim | tostring), (.fable_dim | tostring),
       ((.disabled // false) | tostring)] | join("\u001f")')
    age_text=$(format_age "$age")
    if [ "$accounts_mode" = live ]; then
      probe_state=$(cat "$accounts_probe_dir/$name.display")
      if [ "$probe_state" = live ] || [ "$probe_state" = 'live*' ] || [ "$probe_state" = 'auth!' ] || [ "$probe_state" = login ]; then age_text="$probe_state"
      else age_text="${age_text}!"
      fi
    fi
    marker=' '
    [ "$name" = "$accounts_picked" ] && marker='*'
    off_text=""
    [ "$disabled" != true ] || off_text=" off"
    hcell=$(printf '%-11s' "$(format_reset_time "$hreset")")
    [ "$h5_dim" != true ] || hcell=$'\033[2m'"$hcell"$'\033[0m'
    wcell=$(printf '%-11s' "$(format_reset_time "$wreset")")
    [ "$wk_dim" != true ] || wcell=$'\033[2m'"$wcell"$'\033[0m'
    row_out=$(
      printf '%s %-16s ' "$marker" "$name"
      colored_percent "$h5" "$h5_dim"; printf '  '
      if [ -n "$wk" ]; then printf '  '; colored_percent "$wk" "$wk_dim"; else printf '%6s' -; fi
      printf '  '
      if [ "$accounts_show_fable" = true ]; then
        if [ -n "$fable" ]; then printf '  '; colored_percent "$fable" "$fable_dim"; else printf '%6s' -; fi
        printf '  '
      fi
      printf '%s %s %s%s' "$hcell" "$wcell" "$age_text" "$off_text"
    )
    if [ -n "$sel" ] && [ "$name" = "$sel" ]; then
      # Re-assert reverse-video after every embedded reset so the whole row stays highlighted.
      printf '%s\n' "${inv}${row_out//$sgr0/$sgr0$inv}${sgr0}"
    else
      printf '%s\n' "$row_out"
    fi
  done < <(printf '%s' "$accounts_result" | jq -c "$filter")
  printf '\n\033[33m↑/↓ select  ⏎ launch  ←/→ sort  r refresh  q/Esc exit\033[0m\n'
  [ -z "${accounts_status_line:-}" ] || printf '%s\n' "$accounts_status_line"
}

interactive_accounts() {
  local active=0 key next final sort_count sel='' dir name rc spin_i=0 elapsed
  local -a sort_keys names
  accounts_launch=''
  accounts_refresh_pid=''
  accounts_refresh_dir=''
  accounts_status_line=''
  trap 'interactive_cleanup; accounts_refresh_kill' EXIT INT TERM
  tput civis || return 1
  while :; do
    sort_keys=(name h5 wk)
    [ "$accounts_show_fable" != true ] || sort_keys+=(fable)
    sort_keys+=(hreset wreset)
    sort_count=${#sort_keys[@]}
    [ "$active" -lt "$sort_count" ] || active=0
    if [ -n "$accounts_refresh_pid" ] && ! accounts_refresh_running; then
      accounts_refresh_finish
    fi
    if [ -n "$accounts_refresh_pid" ]; then
      elapsed=$(( $(date +%s) - accounts_refresh_started ))
      accounts_status_line=$(printf '\033[36m⟳ refreshing… %s (%ss)\033[0m' "$(accounts_spinner_frame "$spin_i")" "$elapsed")
      # Probes land per account; re-select each ~1s so fast accounts' fresh
      # numbers show while the convergence loop still retries stragglers.
      [ $(( spin_i % 3 )) -ne 0 ] || accounts_reselect
    fi
    render_interactive_accounts "$active" "${sort_keys[$active]}" "$sel" || return 1
    # In-flight: timeout read animates the spinner; idle stays blocking. rc goes
    # through ||, else a timeout's non-zero read trips set -e.
    if [ -n "$accounts_refresh_pid" ]; then
      rc=0
      IFS= read -rsn1 -t 0.3 key || rc=$?
      spin_i=$((spin_i + 1))
      if [ "$rc" -gt 128 ]; then continue; fi
      [ "$rc" -eq 0 ] || return 0
    else
      # Idle ticks re-read the store so an open TUI mirrors what the statusline,
      # menu refreshes, and upkeep keep writing — never a frozen open-time snapshot.
      rc=0
      IFS= read -rsn1 -t 5 key || rc=$?
      if [ "$rc" -gt 128 ]; then accounts_reselect; continue; fi
      [ "$rc" -eq 0 ] || return 0
    fi
    case "$key" in
      q|$'\003') return 0 ;;
      ''|$'\r'|$'\n')
        if [ -n "$sel" ]; then accounts_launch="$sel"; return 0; fi
        ;;
      r)
        [ -n "$accounts_refresh_pid" ] || accounts_refresh_start || true
        ;;
      $'\033')
        if ! IFS= read -rsn1 -t 0.08 next; then return 0; fi
        [ "$next" = '[' ] || return 0
        if ! IFS= read -rsn1 -t 0.08 final; then return 0; fi
        case "$final" in
          C) active=$(( (active + 1) % sort_count )) ;;
          D) active=$(( (active + sort_count - 1) % sort_count )) ;;
          A|B)
            names=()
            while IFS= read -r name; do names+=("$name"); done < <(sorted_account_names "${sort_keys[$active]}")
            if [ "$final" = A ]; then dir=up; else dir=down; fi
            if [ "${#names[@]}" -gt 0 ]; then sel=$(selection_after_move "$dir" "$sel" "${names[@]}"); fi
            ;;
        esac
        ;;
    esac
  done
}

show_accounts() {
  local mode="${1:-live}" force_plain="${2:-false}" allow_spend="${3:-false}" start_windows="${4:-false}" heal="${5:-false}"
  accounts_allow_spend="$allow_spend"
  accounts_start_windows="$start_windows"
  accounts_heal="$heal"
  accounts_probe_dir=''
  accounts_launch=''
  accounts_refresh_pid=''
  accounts_refresh_dir=''
  collect_accounts "$mode"
  trap 'interactive_cleanup; accounts_refresh_kill; [ -z "${accounts_probe_dir:-}" ] || rm -rf "$accounts_probe_dir"' EXIT
  if [ "$force_plain" != true ] && [ -t 1 ] && [ -n "${TERM:-}" ] && [ "${TERM:-}" != dumb ]; then
    if ! interactive_accounts; then
      interactive_cleanup
      render_plain_accounts
    fi
  else
    render_plain_accounts
  fi
  # Kill any still-running background refresh before the exec — maybe_launch_profile
  # replaces this process and would otherwise orphan the probe and leak its temp dir.
  accounts_refresh_kill
  [ -z "$accounts_probe_dir" ] || rm -rf "$accounts_probe_dir"
  accounts_probe_dir=''
  trap - EXIT INT TERM
  interactive_cleanup
  maybe_launch_profile
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
case "${1:-}" in
  --direct)
    printf 'claudeb: --direct was removed; use `claudeb profile <name>`\n' >&2
    exit 2
    ;;
  help|-h|--help)
    show_help
    ;;
  profile|p)
    shift
    profile_command "$@"
    ;;
  warm)
    shift
    warm_target_count=0
    for warm_arg in "$@"; do
      case "$warm_arg" in --start-window) ;; *) warm_target_count=$((warm_target_count + 1)) ;; esac
    done
    # Reaching this subcommand does not prove a user click; menu refreshes carry the
    # explicit signal in their child environment.
    if [ "$warm_target_count" -eq 1 ]; then
      CLAUDEB_OAUTH_BYPASS_BACKOFF=true warm_accounts "$@"
    else
      warm_accounts "$@"
    fi
    ;;
  token-upkeep)
    token_upkeep
    ;;
  add)
    shift
    add_account "${1:-}"
    ;;
  enable)
    shift
    enable_account "${1:-}"
    ;;
  disable)
    shift
    disable_account "${1:-}"
    ;;
  use)
    shift
    pin_account "${1:-}"
    ;;
  remove)
    shift
    remove_account "$@"
    ;;
  accounts|status|st)
    command_name="$1"
    shift
    # --spend/--no-spend/--start-windows/--heal are meaningless on cached data, so
    # they imply --live (and keep pre-cached-default callers' behavior intact).
    accounts_mode_arg=cached
    accounts_plain_arg=false
    accounts_spend_arg=false
    accounts_windows_arg=false
    accounts_heal_arg=false
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --cached) ;;
        --live) accounts_mode_arg=live ;;
        --plain) accounts_plain_arg=true ;;
        --spend) accounts_spend_arg=true; accounts_mode_arg=live ;;
        --no-spend) accounts_spend_arg=false; accounts_mode_arg=live ;;
        --start-windows) accounts_windows_arg=true; accounts_mode_arg=live ;;
        --heal) accounts_heal_arg=true; accounts_mode_arg=live ;;
        *) printf 'usage: claudeb %s [--cached] [--live] [--plain] [--spend] [--no-spend] [--start-windows] [--heal]\n' "$command_name" >&2; exit 2 ;;
      esac
      shift
    done
    show_accounts "$accounts_mode_arg" "$accounts_plain_arg" "$accounts_spend_arg" "$accounts_windows_arg" "$accounts_heal_arg"
    ;;
  --refresh)
    shift
    refresh_spend_arg=false
    refresh_windows_arg=false
    refresh_heal_arg=false
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --spend) refresh_spend_arg=true ;;
        --no-spend) refresh_spend_arg=false ;;
        --start-windows) refresh_windows_arg=true ;;
        --heal) refresh_heal_arg=true ;;
        *) printf 'usage: claudeb --refresh [--spend] [--no-spend] [--start-windows] [--heal]\n' >&2; exit 2 ;;
      esac
      shift
    done
    show_accounts live false "$refresh_spend_arg" "$refresh_windows_arg" "$refresh_heal_arg"
    ;;
  '')
    profile_required
    ;;
  *)
    if args_are_headless "$@"; then
      routed_rc=0
      routed_profile_command "$@" || routed_rc=$?
      exit "$routed_rc"
    fi
    # A near-miss on a read-only command runs: there is nothing to get wrong, and typing
    # `stauts` should not cost a second attempt. A near-miss on a mutating one only
    # suggests — autocorrecting into `remove` would eventually delete an account.
    # `|| true`: a failing awk must not take the whole CLI down under `set -e`.
    typo_target=$(similar_names "${1:-}" status accounts help warm token-upkeep add enable disable remove use || true)
    case "$typo_target" in
      '') profile_required ;;
      status|accounts|help)
        printf 'claudeb: assuming you meant %s\n' "$typo_target" >&2
        shift
        # Absolute path: $0 may be relative (`bin/claudeb`), and exec resolves it against
        # the current directory, which is not guaranteed to be the invocation directory.
        typo_self=${BASH_SOURCE[0]:-$0}
        case "$typo_self" in /*) ;; *) typo_self="$PWD/$typo_self" ;; esac
        exec "$typo_self" "$typo_target" "$@"
        ;;
      *)
        printf "claudeb: unknown command '%s'; did you mean %s?\n" "$1" "$typo_target" >&2
        exit 2
        ;;
    esac
    ;;
esac
fi

#!/usr/bin/env bash
# Is Fast really served on a codex account right now? Alternates Fast ON / OFF runs of one prompt and
# compares wall time; the response's own service_tier field is not evidence (DIAGNOSTICS, Fast Mode row).
set -uo pipefail

root=$(cd -P "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
. "$root/share/worker-model.sh"
. "$root/share/codex-accounts.sh"

usage() {
  printf 'usage: codex-fast-probe [--account <name>] [--model <family|slug>] [--runs <even n>=2>]\n' >&2
  printf '       prints one line per run and a verdict: FAST_SERVED | FAST_NOT_FASTER | FAST_NOT_OFFERED\n' >&2
  exit 2
}

account='' model='' runs=4
while [ "$#" -gt 0 ]; do
  [ "$#" -ge 2 ] || usage
  case "$1" in
    --account) account=$2; shift 2 ;;
    --model) model=$2; shift 2 ;;
    --runs) runs=$2; shift 2 ;;
    *) usage ;;
  esac
done
[[ "$runs" =~ ^[0-9]+$ ]] && [ "$runs" -ge 2 ] && [ $((runs % 2)) -eq 0 ] || usage
[ -n "$account" ] || account=$("$root/bin/worker-pick" --account codex 2>/dev/null) || true
[ -n "$account" ] || { printf 'codex-fast-probe: worker-pick names no codex account; pass --account\n' >&2; exit 2; }
if [ "$account" = main ]; then home="$HOME/.codex"; else home="${CODEXB_PROFILES_DIR:-$HOME/.codex-profiles}/$account"; fi
[ -d "$home" ] || { printf 'codex-fast-probe: unknown account %s\n' "$account" >&2; exit 2; }
slug=$(worker_model_codex_slug "${model:-$(worker_model_default_model codex)}" "$account") && [ -n "$slug" ] ||
  { printf 'codex-fast-probe: no codex model for %s\n' "${model:-default}" >&2; exit 2; }

codex_fast_offered "$home" "$slug"
case $? in
  0) ;;
  1) printf 'account=%s model=%s\nFAST_NOT_OFFERED: the catalog lists no priority tier for %s\n' "$account" "$slug" "$slug"; exit 3 ;;
  *) printf 'codex-fast-probe: %s has no readable models_cache.json\n' "$home" >&2; exit 2 ;;
esac

work=$(mktemp -d "${TMPDIR:-/tmp}/codex-fast-probe.XXXXXX")
trap 'rm -rf "$work"' EXIT
prompt='Print the integers from 1 to 400 separated by single spaces. Output nothing else.'
printf 'account=%s model=%s runs=%s\n' "$account" "$slug" "$runs"
on_times=() off_times=() hint_on=0 hint_off=0
for ((i = 0; i < runs; i++)); do
  if [ $((i % 2)) -eq 0 ]; then mode=on; tier=(--enable fast_mode -c 'service_tier="priority"')
  else mode=off; tier=(--disable fast_mode -c 'service_tier="default"'); fi
  start=$(perl -MTime::HiRes=time -e 'printf "%.3f", time')
  printf '%s' "$prompt" | CODEX_HOME="$home" RUST_LOG=trace codex exec --skip-git-repo-check -C "$work" \
    --sandbox read-only --color never -m "$slug" -c model_reasoning_effort=low "${tier[@]}" \
    -o "$work/out-$i" - >"$work/stdout-$i" 2>"$work/trace-$i"
  rc=$?
  end=$(perl -MTime::HiRes=time -e 'printf "%.3f", time')
  wall=$(awk -v a="$start" -v b="$end" 'BEGIN { printf "%.1f", b - a }')
  hint=$(grep -c 'tier=priority' "$work/trace-$i" 2>/dev/null || true)
  words=$(wc -w <"$work/out-$i" 2>/dev/null | tr -d ' ')
  printf 'run=%s mode=%s rc=%s wall=%ss words=%s priority_hint=%s\n' "$i" "$mode" "$rc" "$wall" "${words:-0}" "${hint:-0}"
  if [ "$rc" -ne 0 ]; then
    tail -n 3 "$work/trace-$i" | grep -v '^\s*$' | cut -c1-240 >&2
    printf 'codex-fast-probe: run %s failed; no verdict\n' "$i" >&2
    exit 1
  fi
  if [ "$mode" = on ]; then on_times+=("$wall"); [ "${hint:-0}" -eq 0 ] || hint_on=$((hint_on + 1))
  else off_times+=("$wall"); [ "${hint:-0}" -eq 0 ] || hint_off=$((hint_off + 1)); fi
done
median() { printf '%s\n' "$@" | sort -n | awk '{ v[NR] = $1 } END { printf "%.1f", (NR % 2) ? v[(NR + 1) / 2] : (v[NR / 2] + v[NR / 2 + 1]) / 2 }'; }
on=$(median "${on_times[@]}") off=$(median "${off_times[@]}")
printf 'median_on=%ss median_off=%ss hint_on=%s/%s hint_off=%s/%s\n' "$on" "$off" "$hint_on" "${#on_times[@]}" "$hint_off" "${#off_times[@]}"
# Measured 2026-09-13: served priority ran ~35% faster; under 15% is noise, not Fast.
if awk -v a="$on" -v b="$off" 'BEGIN { exit !(a < b * 0.85) }'; then
  printf 'FAST_SERVED\n'
else
  printf 'FAST_NOT_FASTER: offered in the catalog but ON was not faster than OFF\n'
  exit 4
fi

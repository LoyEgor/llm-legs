#!/usr/bin/env bash
# One group, parsed whole before it runs: bash reads a script as it goes, so an in-place edit
# mid-run fed a running leg shifted bytes (2026-10-02). The closing `exit` and `}` stay last.
{
set -euo pipefail

resolve_root() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}

usage() {
  printf 'usage: codex-image --dest <absolute path> --prompt <description> [--aspect <W:H> | --size <WxH>] [--ref <absolute image path>]... [--transparent] [--resume <session id>] [--account <profile>] [--route cli|web] [--region <x,y,w,h>] [--composite[=auto|x,y,w,h] | --no-composite]\n' >&2
  printf '       codex-image --route web --resume <chat id> --aspect <W:H> --dest <absolute path>   (re-aspect the chat'"'"'s last image)\n' >&2
  printf '       codex-image --route web (--resume <chat id> | --ref <image>) --point <x,y=text>... --dest <absolute path>   (point edits)\n' >&2
  printf '       codex-image --route web (--resume <chat id> | --ref <image>) --remove-bg --dest <absolute .png path>   (Remove BG)\n' >&2
  printf '       references: at most %s; transparency mode: %s\n' "$ref_max" "$transparent_mode" >&2
  exit 2
}

normalized_extension() {
  local value
  value=$(printf '%s' "${1##*.}" | tr '[:upper:]' '[:lower:]')
  case "$value" in jpeg) printf 'jpg' ;; *) printf '%s' "$value" ;; esac
}

# The answer's NAME says nothing: codex is told to save under the destination's own extension, so a
# JPEG handed back as `generated.png` matches by name and would be copied verbatim into a `.png`
# whose bytes are a JPEG. Unreadable bytes answer nothing and fall through to a re-encode.
actual_format() { # path
  local value
  value=$(sips -g format "$1" 2>/dev/null | awk '/format:/ {print $2; exit}')
  case "$value" in jpeg) printf 'jpg' ;; *) printf '%s' "$value" ;; esac
}

# The C2PA manifest's CBOR `softwareAgent {name, version}` is the only place the model names itself.
# Seen live 2026-09-23 (cli 0.156.1): {name: ChatGPT, version: gpt-image} — the product in `name`, the
# model family alone in `version`; older files carried {name: gpt-image, version: 2.0}.
c2pa_model() { # path -> the versioned gpt-image id, the bare family, or nothing
  python3 - "$1" <<'PY' 2>/dev/null || true
import re, sys
data = open(sys.argv[1], "rb").read()
def text(at):
    head = data[at]
    if head >> 5 != 3:
        raise ValueError
    size = head & 31
    if size == 24:
        return data[at + 2:at + 2 + data[at + 1]].decode(), at + 2 + data[at + 1]
    if size > 23:
        raise ValueError
    return data[at + 1:at + 1 + size].decode(), at + 1 + size
at = data.find(b"softwareAgent")
while at >= 0:
    pos = at + len(b"softwareAgent")
    try:
        pairs = data[pos] - 0xA0
        if not 0 < pairs < 24:
            raise ValueError
        pos += 1
        agent = {}
        for _ in range(pairs):
            key, pos = text(pos)
            value, pos = text(pos)
            agent[key] = value
        if agent.get("version", "").startswith("gpt-image"):
            print(agent["version"])
            break
        if agent.get("name") and agent.get("version"):
            print(agent["name"] + "-" + re.sub(r"\.0$", "", agent["version"]))
            break
    except (IndexError, ValueError, UnicodeDecodeError):
        pass
    at = data.find(b"softwareAgent", at + 1)
PY
}

# `%A` alone reports the channel, not its contents: a PNG carrying a fully opaque alpha channel
# answers `Blend` and would be delivered as a transparent asset that is nothing of the kind.
deliver_generated() {
  if [ "$remove_bg" = true ] && ! has_usable_alpha "$generated"; then
    printf 'codex-image: Remove BG returned no transparency; nothing delivered\n' >&2
    exit 1
  fi
  if [ "$remove_green" = true ]; then
    if [ "$transparent_native" = true ] && has_usable_alpha "$generated"; then
      if [ "$(actual_format "$generated")" = png ]; then
        cp "$generated" "$dest"
      else
        magick "$generated" "PNG:$dest"
      fi
    elif [ "$transparent_chroma" = true ]; then
      chroma_key_to_png "$generated" "$tmp_dir" "$dest"
    else
      printf 'codex-image: the generation carries no alpha and the manifest allows no chroma fallback\n' >&2
      exit 1
    fi
  elif [ "$extension" != "$(actual_format "$generated")" ]; then
    magick "$generated" "$dest"
  else
    cp "$generated" "$dest"
  fi
  IMAGE_LEG_COMPOSITE_LINES=$(image_leg_composite_take "$root" "$dest")

  sips_output=$(sips -g pixelWidth -g pixelHeight -g format "$dest")
  width=$(awk '/pixelWidth:/ {print $2; exit}' <<<"$sips_output")
  height=$(awk '/pixelHeight:/ {print $2; exit}' <<<"$sips_output")
  format=$(awk '/format:/ {print $2; exit}' <<<"$sips_output")
  [ -n "$width" ] && [ -n "$height" ] && [ -n "$format" ] || {
    printf 'codex-image: could not inspect output\n' >&2
    exit 1
  }
  printf 'dest=%s\nsize=%sx%s\nformat=%s\naccount=%s\nsession=%s\n' \
    "$dest" "$width" "$height" "$format" "$account" "${session:-none}"
}

lineage() {
  local lineage_region=$region
  [ -n "$lineage_region" ] || [ "${IMAGE_LEG_COMPOSITE_ASK:-auto}" = auto ] || lineage_region=$IMAGE_LEG_COMPOSITE_ASK
  image_leg_lineage codex "$route" "$dest" "${session:-none}" "$prompt" "$lineage_region" \
    "$(printf '%s\n' ${points[@]+"${points[@]}"})" ${edit_input:+"$edit_input"} ${refs[@]+"${refs[@]}"}
}

# Delivered as generated: a ratio off by more than 2% is reported, never cropped or resized.
aspect_check() {
  local want=$aspect
  [ -n "$want" ] || [ -z "$size" ] ||
    want=$(awk -v w="${size%x*}" -v h="${size#*x}" 'BEGIN { a = w; b = h; while (b) { t = a % b; a = b; b = t }; print w / a ":" h / a }')
  [ -n "$want" ] || return 0
  image_leg_aspect_fit "$want" "$width" "$height" ||
    printf 'codex-image: asked for %s, delivered %sx%s (%s); kept as generated\n' "$want" "$width" "$height" "$IMAGE_LEG_ACHIEVED" >&2
}

# The one place --aspect, --size and --transparent become prompt text: both routes send these words.
request_sentences() {
  local shape
  if [ "$remove_green" = true ] && [ "$transparent_native" = true ]; then
    printf 'Give it a genuinely transparent background: a PNG with an alpha channel.'
    [ "$transparent_chroma" = false ] || printf ' %s' "$chroma_fallback"
    printf '\n'
  fi
  if [ -n "$aspect" ]; then
    shape=$(awk -v w="${aspect%:*}" -v h="${aspect#*:}" 'BEGIN { print (w > h ? "landscape" : w < h ? "portrait" : "square") }')
    printf 'Make the image a %s %s frame: its width to height ratio exactly %s.\n' "$aspect" "$shape" "$aspect"
  fi
  [ -z "$size" ] || printf 'Make the image exactly %s pixels.\n' "$size"
  [ -z "$region" ] || printf 'Change only the area outlined in red; keep everything outside it exactly as it is, and leave no red outline in the result.\n'
}

command -v jq >/dev/null 2>&1 || {
  printf 'codex-image: jq is required to read the capability manifest\n' >&2
  exit 1
}
root=$(resolve_root)
. "$root/share/image-leg.sh"
. "$root/share/account-arg.sh"
image_leg_start codex-image image text_model
. "$root/share/image-caps.sh" ||
  { printf 'codex-image: share/image-caps.sh is missing; refusing to run unchecked\n' >&2; exit 4; }
ref_max=$(image_caps_get "$root" codex '.refs.max // "none"' 2>/dev/null) || ref_max=''
transparent_mode=$(image_caps_get "$root" codex '.transparent // empty' 2>/dev/null) || transparent_mode=''
[ -n "$ref_max" ] && [ -n "$transparent_mode" ] || {
  printf 'codex-image: share/image-caps/codex.json is unreadable; refusing to run unchecked\n' >&2
  exit 4
}
transparent_native=false
transparent_chroma=false
case "$transparent_mode" in
  native) transparent_native=true ;;
  native+chroma) transparent_native=true; transparent_chroma=true ;;
  chroma) transparent_chroma=true ;;
  *)
    printf 'codex-image: unknown transparency mode in the manifest: %s\n' "$transparent_mode" >&2
    exit 4
    ;;
esac

dest=''
prompt=''
size=''
aspect=''
region=''
points=()
remove_bg=false
account=''
resume_id=''
route=cli
remove_green=false
refs=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help) image_leg_help usage ;;
    --dest)
      [ "$#" -ge 2 ] || usage
      dest=$2
      shift 2
      ;;
    --prompt)
      [ "$#" -ge 2 ] || usage
      prompt=$2
      shift 2
      ;;
    --size)
      [ "$#" -ge 2 ] || usage
      size=$2
      shift 2
      ;;
    --ref)
      [ "$#" -ge 2 ] || usage
      refs+=("$2")
      shift 2
      ;;
    --transparent)
      remove_green=true
      shift
      ;;
    --resume)
      [ "$#" -ge 2 ] || usage
      resume_id=$2
      shift 2
      ;;
    --account)
      [ "$#" -ge 2 ] || usage
      account_arg "$2"
      account=$2
      shift 2
      ;;
    --route)
      [ "$#" -ge 2 ] || usage
      route=$2
      shift 2
      ;;
    --aspect)
      [ "$#" -ge 2 ] || usage
      aspect=$2
      shift 2
      ;;
    --region)
      [ "$#" -ge 2 ] || usage
      region=$2
      shift 2
      ;;
    --point)
      [ "$#" -ge 2 ] || usage
      points+=("$2")
      shift 2
      ;;
    --remove-bg)
      remove_bg=true
      shift
      ;;
    --composite | --composite=* | --no-composite)
      image_leg_composite_arg "$1" || usage
      shift
      ;;
    *) usage ;;
  esac
done

case "$route" in cli|web) IMAGE_LEG_ROUTE=$route ;; *) usage ;; esac
reaspect=false
if [ -z "$prompt" ] && [ -n "$resume_id" ] && [ -n "$aspect" ] && [ -z "$size$region" ] &&
  [ "$remove_green" = false ] && [ "${#refs[@]}" -eq 0 ] && [ "${#points[@]}" -eq 0 ] && [ "$remove_bg" = false ]; then
  reaspect=true
  if [ "$route" = cli ]; then
    printf 'codex-image: re-aspecting an existing image is web-only (the ChatGPT viewer'"'"'s Resize); pass --route web, or a --prompt to generate anew\n' >&2
    exit 2
  fi
  if [ -n "${IMAGE_LEG_COMPOSITE_ASK:-}" ]; then
    printf 'codex-image: a re-aspect changes the canvas, so nothing composites onto the input: no --composite\n' >&2
    exit 2
  fi
fi
[ -n "$dest" ] && { [ -n "$prompt" ] || [ "$reaspect" = true ] || [ "${#points[@]}" -gt 0 ] || [ "$remove_bg" = true ]; } ||
  usage
if [ -n "$aspect" ] && ! [[ "$aspect" =~ ^[0-9]+(\.[0-9]+)?:[0-9]+(\.[0-9]+)?$ && "$aspect" =~ [1-9].*:.*[1-9] ]]; then
  usage
fi
if [ -n "$aspect" ] && [ -n "$size" ]; then
  printf 'codex-image: pass --aspect or --size, not both\n' >&2
  exit 2
fi
if [ -n "$region" ]; then
  if [ "$route" = cli ]; then
    printf 'codex-image: --region is web-only (ChatGPT'"'"'s Markup): pass --route web; the CLI image_gen takes no mask or region, and prose is no region\n' >&2
    exit 2
  fi
  image_leg_region_ok "$region" || {
    printf 'codex-image: --region takes x,y,w,h as fractions of the image (0..1, inside it), not %s\n' "$region" >&2
    exit 2
  }
  if ! { [ -n "$resume_id" ] && [ "${#refs[@]}" -eq 0 ]; } && [ "${#refs[@]}" -ne 1 ]; then
    printf 'codex-image: --region edits one image: the chat'"'"'s last one (--resume <chat id>) or a single --ref\n' >&2
    exit 2
  fi
fi
if [ "${#points[@]}" -gt 0 ]; then
  if [ "$route" = cli ]; then
    printf 'codex-image: --point is web-only (ChatGPT'"'"'s Comment pins): pass --route web; the CLI image_gen takes no pinned comments\n' >&2
    exit 2
  fi
  for point in "${points[@]}"; do
    python3 -c 'import sys; s, _, t = sys.argv[1].partition("="); x, y = (float(n) for n in s.split(",")); sys.exit(not (0 <= x <= 1 and 0 <= y <= 1 and t.strip()))' \
      "$point" 2>/dev/null || {
      printf 'codex-image: --point takes x,y=<text> with x,y fractions of the image (0..1), not %s\n' "$point" >&2
      exit 2
    }
  done
  if [ -n "$prompt$aspect$size$region" ] || [ "$remove_green" = true ]; then
    printf 'codex-image: --point sends its pins alone (the Comment Send drops any other text): no --prompt, --aspect, --size, --transparent or --region; put a note into a pin\n' >&2
    exit 2
  fi
  if ! { [ -n "$resume_id" ] && [ "${#refs[@]}" -eq 0 ]; } && [ "${#refs[@]}" -ne 1 ]; then
    printf 'codex-image: --point edits one image: the chat'"'"'s last one (--resume <chat id>) or a single --ref\n' >&2
    exit 2
  fi
fi
if [ "$remove_bg" = true ]; then
  if [ "$route" = cli ]; then
    printf 'codex-image: --remove-bg is web-only (ChatGPT'"'"'s Remove BG): pass --route web; on the CLI ask for --transparent with a --prompt\n' >&2
    exit 2
  fi
  if [ -n "$prompt" ]; then
    printf 'codex-image: --remove-bg takes no --prompt: the viewer sends its own fixed instruction and drops a typed one\n' >&2
    exit 2
  fi
  if [ -n "$aspect$size$region" ] || [ "$remove_green" = true ] || [ "${#points[@]}" -gt 0 ]; then
    printf 'codex-image: --remove-bg runs alone: no --aspect, --size, --transparent, --region or --point\n' >&2
    exit 2
  fi
  if ! { [ -n "$resume_id" ] && [ "${#refs[@]}" -eq 0 ]; } && [ "${#refs[@]}" -ne 1 ]; then
    printf 'codex-image: --remove-bg edits one image: the chat'"'"'s last one (--resume <chat id>) or a single --ref\n' >&2
    exit 2
  fi
fi
[[ "$dest" = /* ]] || usage
extension=$(normalized_extension "${dest##*/}")
# An extensionless destination — a bare trailing dot included — names no format for `magick` to
# infer, and the mismatch below would hand it one anyway.
{ [[ "${dest##*/}" = *.* ]] && [ -n "$extension" ]; } || usage
[ -d "$(dirname "$dest")" ] || usage
if [ "$remove_green" = true ] && [ "$extension" != png ]; then
  printf 'codex-image: --transparent requires a .png destination\n' >&2
  exit 2
fi
if [ "$remove_bg" = true ] && [ "$extension" != png ]; then
  printf 'codex-image: --remove-bg requires a .png destination\n' >&2
  exit 2
fi
# Unconditional because the answer's own extension is what decides the conversion and no check here
# can know it yet: a `.jpg` destination answered with a `.png` needs `magick` too. A generation is
# billed the moment it is sent, so the missing tool costs a whole image if it is found afterwards.
command -v magick >/dev/null 2>&1 || {
  printf 'codex-image: magick is required for this output\n' >&2
  exit 1
}
if [ -n "$size" ] && ! [[ "$size" =~ ^[1-9][0-9]*x[1-9][0-9]*$ ]]; then
  usage
fi
ref_count=${#refs[@]}
if [[ "$ref_max" =~ ^[0-9]+$ ]] && [ "$ref_count" -gt "$ref_max" ]; then
  printf 'codex-image: %s references exceed the %s the imagegen tool takes\n' "$ref_count" "$ref_max" >&2
  exit 2
fi
if [ "$ref_count" -gt 0 ]; then
  for ref in "${refs[@]}"; do
    [[ "$ref" = /* ]] && [ -f "$ref" ] || usage
  done
fi
if [ -n "$account" ] && ! [[ "$account" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  usage
fi
# A thread NAME is a resume target for the CLI but not one this script can trace back to the
# account that holds it, and printed session ids are always UUIDs.
if [ -n "$resume_id" ] &&
  ! [[ "$resume_id" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
  printf 'codex-image: --resume takes the session UUID printed as session=, not %s\n' "$resume_id" >&2
  exit 2
fi
IMAGE_LEG_COMPOSITE_ARGS=()
[ -z "$region" ] || IMAGE_LEG_COMPOSITE_ARGS=(--mask "$region")
[ "${#points[@]}" -eq 0 ] || for point in "${points[@]}"; do IMAGE_LEG_COMPOSITE_ARGS+=(--point "$point"); done
repaint=false
[ "$remove_bg" = false ] && [ "$remove_green" = false ] || repaint=true
image_leg_composite_plan codex "$resume_id" "$repaint" ${refs[@]+"${refs[@]}"}
edit_input=$IMAGE_LEG_COMPOSITE_INPUT

base_home=$HOME
profiles_dir="${CODEX_PROFILES_DIR:-$base_home/.codex-profiles}"
. "$root/share/image-chroma.sh"

content=$prompt
# Only the chroma-ONLY mode edits the request: the word names the very thing the built-in tool is
# being asked for wherever native alpha is on offer, and stripping it there would spend the
# generation on an opaque image.
if [ "$remove_green" = true ] && [ "$transparent_native" = false ]; then
  content=$(printf '%s' "$content" | sed 's/[[:<:]][Tt][Rr][Aa][Nn][Ss][Pp][Aa][Rr][Ee][Nn][Tt][[:>:]]//g')
  content="$content on a flat solid #00FF00 green background"
fi
chroma_fallback='Only if real transparency is impossible, fill the background with one flat solid #00FF00 green instead.'

# The web route is chatgpt.com in the hidden Chrome: bin/chatgpt-web owns its accounts, rotation, pool
# check, lock and walls, so none of the CLI route's machinery below applies to it.
if [ "$route" = web ]; then
  tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/codex-image.XXXXXX")
  trap 'image_leg_exit; rm -rf "$tmp_dir"' EXIT
  sentences=$(request_sentences)
  web_prompt=$content
  [ -z "$sentences" ] || web_prompt+=$'\n\n'"$sentences"
  if [ "$reaspect" = true ]; then
    web_args=(resize --aspect "$aspect" --dest "$tmp_dir/web-image")
  elif [ "$remove_bg" = true ]; then
    web_args=(remove-bg --dest "$tmp_dir/web-image")
  elif [ "${#points[@]}" -gt 0 ]; then
    web_args=(comment --dest "$tmp_dir/web-image")
    for point in "${points[@]}"; do web_args+=(--point "$point"); done
  else
    web_args=(generate --prompt "$web_prompt" --dest "$tmp_dir/web-image")
  fi
  [ -z "$region" ] || web_args+=(--region "$region")
  [ "$ref_count" -eq 0 ] || for ref in "${refs[@]}"; do web_args+=(--ref "$ref"); done
  [ -z "$resume_id" ] || web_args+=(--resume "$resume_id")
  [ -z "$account" ] || web_args+=(--account "$account")
  image_leg_mark $((ref_count + 1))
  web_rc=0
  "${CODEX_IMAGE_WEB:-$root/bin/chatgpt-web}" "${web_args[@]}" >"$tmp_dir/web.out" || web_rc=$?
  web_result=$(tail -n 1 "$tmp_dir/web.out")
  account=$(jq -r '.account // empty' <<<"$web_result" 2>/dev/null) || account=''
  session=$(jq -r '.chat // empty' <<<"$web_result" 2>/dev/null) || session=''
  if [ "$web_rc" -ne 0 ]; then
    printf 'codex-image: web route: %s\n' \
      "$(jq -r '.reason // empty' <<<"$web_result" 2>/dev/null || true)" >&2
    case "$web_rc" in
      3) printf 'CODEX_USAGE_LIMIT\n' >&2; exit 3 ;;
      2|4) exit "$web_rc" ;;
      *) exit 1 ;;
    esac
  fi
  generated=$tmp_dir/web-image
  [ -s "$generated" ] || { printf 'codex-image: the web route saved no image\n' >&2; exit 1; }
  deliver_generated
  image_caps_model_check "$root" codex image "$(c2pa_model "$generated")"
  printf 'route=web\n'
  aspect_check
  lineage
  exit 0
fi
# Image generation is a worker launch like any other — it runs `codex` headless with CODEX_HOME
# set, never through codexb — so the pool answers here too.
. "$root/share/worker-pool.sh" ||
  { printf 'codex-image: share/worker-pool.sh is missing; refusing to run unchecked\n' >&2; exit 4; }
. "$root/share/worker-model.sh" ||
  { printf 'codex-image: share/worker-model.sh is missing; refusing to run unchecked\n' >&2; exit 4; }
. "$root/share/worker-claims.sh"
. "$root/share/account-roster.sh"

# A session lives inside one account's CODEX_HOME, and `codex exec resume` answers an id it cannot
# find by silently starting a NEW thread (openai/codex#15538) — so the account is recovered from
# the store rather than routed for, and an ambiguous answer is asked about instead of guessed.
resume_account_candidates() { # session id
  local id=$1 home name
  for name in $(CODEXB_PROFILES_DIR="$profiles_dir" account_roster codex); do
    if [ "$name" = main ]; then home="$base_home/.codex"; else home="$profiles_dir/$name"; fi
    [ -d "$home" ] || continue
    if [ -d "$home/generated_images/$id" ] ||
      [ -n "$(find "$home/sessions" -type f -name "*$id*" -print -quit 2>/dev/null)" ]; then
      printf '%s\n' "$name"
    fi
  done
}

if [ -n "$resume_id" ] && [ -z "$account" ]; then
  candidates=$(resume_account_candidates "$resume_id")
  candidate_count=$(printf '%s' "$candidates" | grep -c . || true)
  if [ "$candidate_count" -eq 1 ]; then
    account=$candidates
  else
    printf 'codex-image: %s accounts hold session %s; pass --account\n' \
      "$candidate_count" "$resume_id" >&2
    exit 2
  fi
fi

off_roster_rc=1
[ -z "$account" ] || off_roster_rc=2
picked=false
if [ -z "$account" ]; then
  pick_rc=0
  if command -v worker-pick >/dev/null 2>&1; then
    account=$(worker-pick --account codex --role image 2>/dev/null) || pick_rc=$?
  else
    pick_rc=127
  fi
  if [ "$pick_rc" -eq 3 ]; then
    printf 'CODEX_USAGE_LIMIT\n' >&2
    exit 3
  fi
  if [ "$pick_rc" -ne 0 ] || ! [[ "$account" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    account=$(worker_model_pin_first codex 2>/dev/null || true)
    account=${account:-main}
    if ! [[ "$account" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
      account=main
    fi
    printf 'codex-image: worker-pick unavailable; falling back to account %s\n' "$account" >&2
  else
    picked=true
  fi
fi

CODEXB_PROFILES_DIR="$profiles_dir" account_roster_refuse codex-image codex "$account" || exit "$off_roster_rc"
worker_pool_refuse_headless codex "$account" "$(worker_model_pin_csv < <(worker_model_pins codex))" || exit 4

# The model that drives image_gen: the table's family at its newest listed slug on this account, never
# the model a profile's config.toml still names. A resumed thread keeps its own.
text_model=''
if [ -z "$resume_id" ]; then
  text_model=$(worker_model_codex_slug "$(worker_model_default_model codex)" "$account") || text_model=''
  [ -n "$text_model" ] ||
    printf 'codex-image: no listed codex model for the default family; running the account config model\n' >&2
fi

if [ "$account" = main ]; then
  generated_images_dir="$base_home/.codex/generated_images"
  codex_home=''
else
  codex_home="$profiles_dir/$account"
  if [ ! -d "$codex_home" ]; then
    printf 'codex-image: account directory does not exist: %s\n' "$codex_home" >&2
    exit 1
  fi
  generated_images_dir="$codex_home/generated_images"
fi
if [ "$picked" = true ] && ! worker_claims_record codex "$account"; then
  printf 'codex-image: could not record the claim on %s\n' "$account" >&2
fi
if [ -z "$resume_id" ] && ! worker_starts_record codex "$account"; then
  printf 'codex-image: could not stamp the start on %s\n' "$account" >&2
fi

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/codex-image.XXXXXX")
lock_dir="${TMPDIR:-/tmp}/codex-image.$account.lock"
lock_held=false
cleanup() {
  if [ "$lock_held" = true ]; then
    rmdir "$lock_dir" 2>/dev/null || true
  fi
  rm -rf "$tmp_dir"
}
trap 'image_leg_exit; cleanup' EXIT
work_dir="$tmp_dir/work"
mkdir -p "$work_dir"
launch_marker="$tmp_dir/launch"
instruction_file="$tmp_dir/instruction"
stdout_file="$tmp_dir/stdout"
cli_stdout="$tmp_dir/codex.stdout"
cli_stderr="$tmp_dir/codex.stderr"

# Naming the imagegen skill cost a turn reading its SKILL.md, and asking for a copy another turn
# after the image (10-18 s each, 2026-10-02): the image is taken from generated_images/<thread> below.
{
  printf 'Call your built-in image_gen tool directly; do not read the imagegen skill or any SKILL.md first. Generate one image with this content:\n%s\n\n' "$content"
  # The fallback key in these sentences has to be ORDERED: asked for alpha and unable to deliver it,
  # the tool answers with an opaque background of its own choosing, and keying that costs the subject.
  request_sentences
  if [ "$remove_green" = true ] && [ "$transparent_native" = true ]; then
    printf 'Ask image_gen for it by setting its transparent_background argument to true, and preserve the alpha channel it returns; never flatten it onto a color.\n'
  fi
  [ -n "$size" ] || printf 'Use low quality.\n'
  if [ "$ref_count" -gt 0 ]; then
    printf 'Reference images: call view_image on each path below first, then pass exactly those paths as the image_gen referenced_image_paths argument and leave num_last_images_to_include unset.\n'
    printf -- '- %s\n' "${refs[@]}"
  elif [ -n "$resume_id" ]; then
    printf 'Edit the image generated earlier in this thread: set num_last_images_to_include to 1 and pass no referenced_image_paths.\n'
  fi
  printf 'Leave the image where image_gen saved it: do not copy, move or convert it. Once image_gen has returned, reply with just: done\n'
} >"$instruction_file"

# Rescue has no per-invocation filename key, so one account generates at a time.
lock_waited=0
while ! mkdir "$lock_dir" 2>/dev/null; do
  lock_mtime=$(stat -f %m "$lock_dir" 2>/dev/null || printf '0')
  now=$(date +%s)
  if [ "$lock_mtime" -gt 0 ] && [ $((now - lock_mtime)) -gt 1200 ]; then
    rmdir "$lock_dir" 2>/dev/null || true
  fi
  if [ "$lock_waited" -ge 600 ]; then
    printf 'codex-image: timed out waiting for account lock: %s\n' "$account" >&2
    exit 1
  fi
  sleep 2
  lock_waited=$((lock_waited + 2))
done
lock_held=true
image_leg_mark $((ref_count + 1))

# Backdated a second: -newer misses files that land in the marker's own mtime quantum.
: >"$launch_marker"
touch -A -01 "$launch_marker" 2>/dev/null || true
codex_cmd="${CODEX_IMAGE_CODEX:-codex}"
codex_deadline="${CODEX_IMAGE_DEADLINE:-900}"
[[ "$codex_deadline" =~ ^[0-9]+$ ]] && [ "$codex_deadline" -gt 0 ] || codex_deadline=900
# A deadline while the account lock is held: a hung codex would otherwise block
# this account forever (waiters cap at 600s, stale reclaim needs >1200s).
run_codex() {
  # Fast is workers-only; the account's config.toml tier is Egor's interactive pick and can say fast.
  local -a argv=(exec -C "$work_dir" --color never --skip-git-repo-check --experimental-json -o "$stdout_file"
    --disable fast_mode -c 'service_tier="default"')
  [ -z "$text_model" ] || argv+=(-m "$text_model")
  if [ -n "$resume_id" ]; then
    argv+=(resume "$resume_id")
  fi
  argv+=(-)
  "$codex_cmd" "${argv[@]}" <"$instruction_file" >"$cli_stdout" 2>"$cli_stderr" &
  local child=$!
  ( end=$(($(date +%s) + codex_deadline))
    while [ "$(date +%s)" -lt "$end" ]; do sleep 5; done
    : >"$tmp_dir/deadline"
    kill -TERM "$child" 2>/dev/null || exit 0
    sleep 10
    kill -KILL "$child" 2>/dev/null || true
  ) &
  local watchdog=$! rc=0
  wait "$child" || rc=$?
  kill "$watchdog" 2>/dev/null || true
  return "$rc"
}
codex_rc=0
if [ "$account" = main ]; then
  (unset CODEX_HOME; run_codex) || codex_rc=$?
else
  CODEX_HOME="$codex_home" run_codex || codex_rc=$?
fi

session=$(jq -Rr 'fromjson? | select(.type == "thread.started") | .thread_id // empty' \
  "$cli_stdout" 2>/dev/null | head -n 1) || session=''
if ! [[ "$session" =~ ^[0-9a-fA-F-]{36}$ ]]; then
  session=''
fi
if [ -n "$resume_id" ] && [ -n "$session" ] && [ "$session" != "$resume_id" ]; then
  printf 'codex-image: resume %s opened a new thread %s instead of continuing it\n' \
    "$resume_id" "$session" >&2
fi

if [ "$codex_rc" -ne 0 ]; then
  if [ -e "$tmp_dir/deadline" ]; then
    printf 'codex-image: generation exceeded %ss deadline\n' "$codex_deadline" >&2
    exit 1
  fi
  if grep -Eqi 'hit your usage limit|usage_limit|workspace is out of credits' "$stdout_file" "$cli_stdout" "$cli_stderr" 2>/dev/null; then
    printf 'CODEX_USAGE_LIMIT\n' >&2
    exit 3
  fi
  printf 'codex-image: generation failed\n' >&2
  tail -n 20 "$cli_stderr" "$cli_stdout" "$stdout_file" >&2 2>/dev/null || true
  exit 1
fi

newest_since_launch() { # directory
  local candidate newest=''
  while IFS= read -r candidate; do
    if [ -z "$newest" ] || [ "$candidate" -nt "$newest" ]; then
      newest=$candidate
    fi
  done < <(find "$1" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) \
    -newer "$launch_marker" -print 2>/dev/null)
  printf '%s' "$newest"
}

generated=''
# The built-in tool keys its output directory on the thread, so the harvested session narrows the
# search to this run's own images before the whole store is swept.
if [ -n "$session" ] && [ -d "$generated_images_dir/$session" ]; then
  generated=$(newest_since_launch "$generated_images_dir/$session")
fi
if [ -z "$generated" ] && [ -d "$generated_images_dir" ]; then
  generated=$(newest_since_launch "$generated_images_dir")
fi
rmdir "$lock_dir" 2>/dev/null || true
lock_held=false
if [ -z "$generated" ]; then
  # A walled image_gen call fails its item, not the turn, and codex still exits 0.
  if grep -Eq 'usageLimitExceeded|usage_limit_exceeded' "$cli_stdout" 2>/dev/null; then
    printf 'CODEX_USAGE_LIMIT\n' >&2
    exit 3
  fi
  printf 'codex-image: generated file not found\n' >&2
  tail -n 20 "$cli_stderr" "$cli_stdout" "$stdout_file" >&2 2>/dev/null || true
  exit 1
fi

deliver_generated
image_caps_model_check "$root" codex image "$(c2pa_model "$generated")"
image_caps_check "$root" codex "$codex_cmd"
aspect_check
lineage
exit
}

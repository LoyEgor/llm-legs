#!/usr/bin/env bash
set -u

usage() {
  echo "Usage: $(basename "$0") [app|terminal|auto|all] [extra-minutes] [-m|--message text]" >&2
}

# A signed integer and nothing else: a pattern admitting any mix of digits and hyphens took
# `10-`, which dies in the arithmetic below, and `1-2`, which quietly becomes a subtraction.
is_int() {
  case "${1#-}" in ''|*[!0-9]*) return 1 ;; esac
  return 0
}

surface=""
extra=""
custom_message=""
arm_all=0

while [ $# -gt 0 ]; do
  case "$1" in
    -m|--message)
      if [ $# -lt 2 ]; then usage; exit 2; fi
      custom_message=$2
      shift 2
      ;;
    --message=*)
      custom_message=${1#--message=}
      shift
      ;;
    app|terminal|auto|all)
      if [ -n "$surface" ]; then usage; exit 2; fi
      surface=$1
      shift
      ;;
    *)
      if is_int "$1" && [ -z "$extra" ]; then
        extra=$1
        shift
      else
        usage
        exit 2
      fi
      ;;
  esac
done

surface=${surface:-auto}
extra=${extra:-10}

case "$surface" in
  app|terminal) ;;
  all)
    arm_all=1
    surface=terminal
    ;;
  auto)
    if [ -n "${TERM_PROGRAM+x}" ]; then
      surface=terminal
    else
      surface=app
    fi
    ;;
  *)
    usage
    exit 2
    ;;
esac

is_int "$extra" || { usage; exit 2; }

run_bounded() {
  local seconds=$1 pid watchdog_pid timeout_cmd rc
  shift
  timeout_cmd=$(command -v timeout 2>/dev/null || command -v gtimeout 2>/dev/null || true)
  if [ -n "$timeout_cmd" ]; then
    "$timeout_cmd" "$seconds" "$@" >/dev/null 2>&1
    return $?
  fi
  "$@" >/dev/null 2>&1 &
  pid=$!
  (sleep "$seconds"; kill "$pid" 2>/dev/null || true) &
  watchdog_pid=$!
  wait "$pid" 2>/dev/null; rc=$?
  kill "$watchdog_pid" 2>/dev/null || true
  wait "$watchdog_pid" 2>/dev/null || true
  return "$rc"
}

# stdin here is a pipe (Claude Code Bash tool), so `tty` reports "not a tty";
# the controlling terminal is only visible on an ancestor process (claude/zsh).
detect_controlling_tty() {
  local pid=$$ t hops=0
  while [ -n "$pid" ] && [ "$pid" != "0" ] && [ "$hops" -lt 10 ]; do
    t=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
    case "$t" in
      ''|'??') ;;
      *) echo "/dev/$t"; return 0 ;;
    esac
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    hops=$((hops + 1))
  done
  return 1
}

account=${CLAUDE_LIMITS_ACCOUNT:-notcom}
[ "$account" = "-" ] && account=notcom
cache="$HOME/.llm-limits.json"

resolve_root() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}
legs_root=$(resolve_root) || legs_root=""
# The staleness threshold OF the five_hour bucket (not a five-hour one), from the one place it
# is written down (docs/shared-invariants.md row a) — never a literal of this script's own.
stale_after=""
if [ -n "$legs_root" ] && [ -r "$legs_root/share/limits-view.sh" ]; then
  . "$legs_root/share/limits-view.sh"
  stale_after=${LIMITS_STALE_FIVE_HOUR:-}
fi

# The `as_of` of a row the COLLECTOR itself calls fresh, and nothing for one it does not. Staleness
# is limits-view.sh's `limits_bucket_stale` — expired auth and a cached-origin reading as much as
# age — and a surface that re-derives any part of it from `as_of` alone trusts a row the rest of
# the system prints with a `~`. The age below is asked on top because that flag is frozen at the
# instant the collector wrote it and cannot go stale on its own. `expired` is a separate verdict
# from `stale` (a just-collected row whose window has already rolled is expired but not stale), and
# it is the one reading a refresh can actually replace: without it the arming below falls back to a
# blind 15 minutes off a row the collector already zeroed.
fresh_five_hour_as_of() {
  [ -f "$cache" ] || return 1
  jq -r --arg acct "$account" '
    (.vendors.claude.accounts[]? | select(.account == $acct) | .five_hour)
    | select(type == "object" and .stale == false and (.expired // false) == false)
    | .as_of | if type == "number" then . else empty end
  ' "$cache" 2>/dev/null | head -n1
}

# A refresh is real OAuth/usage traffic, and one spent on a reading minutes old buys nothing while
# self-inflicting 429s under capacity weather (Egor, 2026-07-17). Asked of the store first: only a
# row that is missing, unreadable, marked stale or expired, or past its own threshold is worth it.
if command -v llm-limits >/dev/null 2>&1; then
  as_of=$(fresh_five_hour_as_of)
  if [ -z "$as_of" ] || [ -z "$stale_after" ] ||
     [ "$(( $(date +%s) - ${as_of%%.*} ))" -ge "$stale_after" ]; then
    run_bounded 20 llm-limits --refresh
  fi
fi

# Same ISO8601-with-offset parser llm-limits.sh uses, so resets_at math stays in sync.
iso_def='def iso2epoch:
  if type != "string" then null
  else (capture("^(?<d>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(\\.[0-9]+)?(?<tz>[Zz]|[+-][0-9]{2}:?[0-9]{2})$") // null) as $c |
    if $c == null then null
    else ($c.d + "Z" | fromdateiso8601)
      - (if ($c.tz | ascii_upcase) == "Z" then 0
         else ($c.tz | capture("^(?<s>[+-])(?<h>[0-9]{2}):?(?<m>[0-9]{2})$")
               | (if .s == "-" then -1 else 1 end) * ((.h | tonumber) * 3600 + (.m | tonumber) * 60))
         end)
    end
  end;'

resets_epoch=""
if [ -f "$cache" ]; then
  resets_epoch=$(jq -r --arg acct "$account" "$iso_def"'
    (.vendors.claude.accounts[]? | select(.account == $acct) | .five_hour.resets_at) as $resets
    | if $resets == null then "" else (($resets | iso2epoch) // "") end
  ' "$cache" 2>/dev/null)
fi

now=$(date +%s)
fallback_reason=""

if [ -z "$resets_epoch" ]; then
  fallback_reason="no five_hour.resets_at for account '$account'"
elif ! is_int "$resets_epoch"; then
  fallback_reason="unparseable resets_at for account '$account'"
elif [ "$resets_epoch" -le "$now" ]; then
  fallback_reason="5h window for account '$account' already reset"
fi

if [ -n "$fallback_reason" ]; then
  minutes=15
else
  minutes=$(( (resets_epoch - now) / 60 + extra ))
  [ "$minutes" -ge 1 ] || minutes=1
fi

if ! command -v hs >/dev/null 2>&1; then
  echo "claude-resume-timer: 'hs' not found on PATH; is Hammerspoon's CLI installed?" >&2
  exit 1
fi

enumerate_claude_ttys() {
  ps -axo tty=,command= 2>/dev/null | awk '
    $1 ~ /^ttys[0-9]+$/ {
      n = split($2, parts, "/")
      if (parts[n] == "claude") print "/dev/" $1
    }
  ' | sort -u
}

lua_quote() {
  python3 -c 'import json,sys; print(json.dumps(sys.argv[1], ensure_ascii=False))' "$1"
}

arm_one() {
  local target_tty=$1 hs_output hs_status target_note="" lua_msg
  case "$target_tty" in
    /dev/tty*) ;;
    *) target_tty="" ;;
  esac
  if [ -n "$custom_message" ]; then
    lua_msg=$(lua_quote "$custom_message") || exit 1
    if [ -n "$target_tty" ]; then
      hs_output=$(hs -q -c "ClaudeContinue.startTimerFor(
\"$surface\", $minutes, $lua_msg, \"$target_tty\")" 2>&1)
    else
      hs_output=$(hs -q -c "ClaudeContinue.startTimerFor(
\"$surface\", $minutes, $lua_msg)" 2>&1)
    fi
  elif [ -n "$target_tty" ]; then
    hs_output=$(hs -q -c "ClaudeContinue.startTimerFor(\"$surface\", $minutes, nil, \"$target_tty\")" 2>&1)
  else
    hs_output=$(hs -q -c "ClaudeContinue.startTimerFor(\"$surface\", $minutes)" 2>&1)
  fi
  hs_status=$?
  if [ "$hs_status" -ne 0 ]; then
    echo "claude-resume-timer: could not reach hs (Hammerspoon CLI): $hs_output" >&2
    exit 1
  fi
  [ -n "$target_tty" ] && target_note=" (target $target_tty)"
  [ -n "$custom_message" ] && target_note="${target_note} (custom message)"
  if [ -n "$fallback_reason" ]; then
    echo "claude-resume-timer: $fallback_reason; armed $surface for +$minutes min (fires ~$fires_clock)$target_note"
  else
    echo "claude-resume-timer: armed $surface for $minutes min (fires ~$fires_clock)$target_note"
  fi
}

fires_epoch=$(( now + minutes * 60 ))
fires_clock=$(date -r "$fires_epoch" '+%H:%M' 2>/dev/null || date -j -f %s "$fires_epoch" '+%H:%M' 2>/dev/null || echo "?")

if [ "$arm_all" -eq 1 ]; then
  all_ttys=$(enumerate_claude_ttys)
  if [ -z "$all_ttys" ]; then
    echo "claude-resume-timer: no active Claude chat ttys" >&2
    exit 1
  fi
  while IFS= read -r target_tty; do
    [ -n "$target_tty" ] || continue
    arm_one "$target_tty"
  done <<EOF
$all_ttys
EOF
  exit 0
fi

target_tty=""
if [ "$surface" = terminal ]; then
  target_tty=$(detect_controlling_tty) || target_tty=""
fi
arm_one "$target_tty"

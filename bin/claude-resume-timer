#!/usr/bin/env bash
set -u

usage() {
  echo "Usage: $(basename "$0") [terminal|all] [extra-minutes] [--to <chat>] [--now] [-m|--message text]" >&2
}

# A signed integer and nothing else: a pattern admitting any mix of digits and hyphens took
# `10-`, which dies in the arithmetic below, and `1-2`, which quietly becomes a subtraction.
is_int() {
  case "${1#-}" in ''|*[!0-9]*) return 1 ;; esac
  return 0
}

surface=""
extra=""
custom_message=""
arm_all=0
to_chat=""
fire_now=0

while [ $# -gt 0 ]; do
  case "$1" in
    -m|--message)
      if [ $# -lt 2 ]; then usage; exit 2; fi
      custom_message=$2
      shift 2
      ;;
    --message=*)
      custom_message=${1#--message=}
      shift
      ;;
    --to)
      if [ $# -lt 2 ] || [ -z "$2" ]; then usage; exit 2; fi
      to_chat=$2
      shift 2
      ;;
    --now)
      fire_now=1
      shift
      ;;
    terminal|all)
      if [ -n "$surface" ]; then usage; exit 2; fi
      surface=$1
      shift
      ;;
    *)
      if is_int "$1" && [ -z "$extra" ]; then
        extra=$1
        shift
      else
        usage
        exit 2
      fi
      ;;
  esac
done

# A newline in the message would be typed into the chat as a submit, and the call it builds is
# invisible to the cross-repo guard on this entry point (shared-invariants row bh).
case $custom_message in
  *$'\n'*)
    echo "claude-resume-timer: -m/--message must be a single line" >&2
    exit 2
    ;;
esac

resolve_root() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}
legs_root=$(resolve_root) || legs_root=""

# Whatever is typed into a chat is read by the model sitting in it, never by Egor, so the message
# is measured exactly as every other model-to-model channel is.
CYRILLIC_MAX="${RESUME_TIMER_CYRILLIC_PCT:-15}"
CYRILLIC_SHARE="${RESUME_TIMER_CYRILLIC_SHARE:-$(command -v cyrillic-share 2>/dev/null)}"
[ -n "$CYRILLIC_SHARE" ] || CYRILLIC_SHARE="$legs_root/bin/cyrillic-share"
if [ -n "$custom_message" ] && [ -x "$CYRILLIC_SHARE" ]; then
  message_cyrillic=$(printf '%s' "$custom_message" | "$CYRILLIC_SHARE" 2>/dev/null) || message_cyrillic=''
  message_cyrillic=${message_cyrillic%% *}
  case $message_cyrillic in
    ''|*[!0-9]*) ;;
    *)
      [ "$message_cyrillic" -le "$CYRILLIC_MAX" ] || {
        echo "claude-resume-timer: text is in Russian ($message_cyrillic% Cyrillic outside «…»/code) but its reader is a model: write it in English, quote Egor's words only inside «…»" >&2
        exit 2
      }
      ;;
  esac
fi

[ "$surface" = all ] && arm_all=1
if [ "$arm_all" -eq 1 ] && [ -n "$to_chat" ]; then usage; exit 2; fi
surface=terminal
extra=${extra:-10}

is_int "$extra" || { usage; exit 2; }

run_bounded() {
  local seconds=$1 pid watchdog_pid timeout_cmd rc
  shift
  timeout_cmd=$(command -v timeout 2>/dev/null || command -v gtimeout 2>/dev/null || true)
  if [ -n "$timeout_cmd" ]; then
    "$timeout_cmd" "$seconds" "$@" >/dev/null 2>&1
    return $?
  fi
  "$@" >/dev/null 2>&1 &
  pid=$!
  (sleep "$seconds"; kill "$pid" 2>/dev/null || true) &
  watchdog_pid=$!
  wait "$pid" 2>/dev/null; rc=$?
  kill "$watchdog_pid" 2>/dev/null || true
  wait "$watchdog_pid" 2>/dev/null || true
  return "$rc"
}

# stdin here is a pipe (Claude Code Bash tool), so `tty` reports "not a tty";
# the controlling terminal is only visible on an ancestor process (claude/zsh).
detect_controlling_tty() {
  local pid=$$ t hops=0
  while [ -n "$pid" ] && [ "$pid" != "0" ] && [ "$hops" -lt 10 ]; do
    t=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
    case "$t" in
      ''|'??') ;;
      *) echo "/dev/$t"; return 0 ;;
    esac
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    hops=$((hops + 1))
  done
  return 1
}

# The argv forms a live chat actually runs under, mirrored from `commandIsClaude` in the
# hammerspoon repo's claude_cmd_keys.lua: a node/bun wrapper around claude-code is as much a
# claude tty as a bare `claude`, and a tty this misses is a chat that never gets its timer.
enumerate_claude_ttys() {
  ps -axo tty=,command= 2>/dev/null | awk '
    function base(path,   n, parts) { n = split(path, parts, "/"); return parts[n] }
    $1 ~ /^ttys[0-9]+$/ {
      if (base($2) == "claude" || index($2, "/claude/versions/")) { print "/dev/" $1; next }
      runtime = base($2)
      if (runtime != "node" && runtime != "bun") next
      if (index($3, "/@anthropic-ai/claude-code/") || index($3, "/claude-code/")) print "/dev/" $1
    }
  ' | sort -u
}

# The timer types into a chat, so only a chat may arm one, for itself or for every chat: a worker
# inherits its chat's tty and a caller outside every chat has none to aim at.
if [ -n "${WORKER_RUN_RECORD:-}" ]; then
  echo "claude-resume-timer: a worker run arms no timer; its chat does, on Egor's word" >&2
  exit 1
fi
target_tty=$(detect_controlling_tty) || target_tty=""
chat_ttys=$(enumerate_claude_ttys)
if [ "$arm_all" -eq 1 ] && [ -z "$chat_ttys" ]; then
  echo "claude-resume-timer: no active Claude chat ttys" >&2
  exit 1
fi
if [ -z "$target_tty" ] || ! grep -qxF "$target_tty" <<<"$chat_ttys"; then
  echo "claude-resume-timer: the caller sits in no Claude chat's terminal, so no timer is armed" >&2
  exit 1
fi

# Another chat, by the name peers address it by or its session id. Every profile's registry is read,
# since a chat on another account is as much his; the glob skips `.claudeb`, which is no profile.
# The name is share/chat_names.py's, never the registry's `.name`: that one carries the derived
# placeholders no chat is shown under, and lags a title set in the transcript.
chat_tty() {
  local file pid session tty found="" records names
  records=$(for file in "$HOME"/.claude/sessions/*.json "$HOME"/.claude-profiles/*/sessions/*.json; do
    [ -f "$file" ] && jq -r '[(.sessionId // "" | tostring), (.pid // "" | tostring)] | @tsv' "$file" 2>/dev/null
  done)
  names=$(cut -f1 <<<"$records" | grep -v '^$' | sort -u |
    python3 -c 'import sys
sys.path.insert(0, sys.argv[1])
from chat_names import chat_name, fold_session
for session in sys.stdin.read().split():
    print(session + "\t" + ((fold_session(session) == session and chat_name(session)) or ""))' \
      "${legs_root:-/nonexistent}/share" 2>/dev/null)
  while IFS=$'\t' read -r session pid; do
    [ -n "$session" ] || continue
    [ "$session" = "$1" ] || grep -qxF "$session"$'\t'"$1" <<<"$names" || continue
    case $pid in ''|*[!0-9]*) continue ;; esac
    tty=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
    case $tty in ''|'?'|'??') continue ;; esac
    found="$found/dev/${tty#/dev/}"$'\n'
  done <<<"$records"
  found=$(printf '%s' "$found" | sort -u)
  case $found in
    '') echo "claude-resume-timer: no live chat is named '$1'" >&2; return 1 ;;
    *$'\n'*) echo "claude-resume-timer: several live chats answer to '$1': $(tr '\n' ' ' <<<"$found")" >&2; return 1 ;;
  esac
  grep -qxF "$found" <<<"$chat_ttys" || {
    echo "claude-resume-timer: '$1' sits on $found, where no Claude chat runs" >&2
    return 1
  }
  printf '%s\n' "$found"
}
if [ -n "$to_chat" ]; then
  target_tty=$(chat_tty "$to_chat") || exit 1
fi

now=$(date +%s)
minutes=0
fallback_reason=""
if [ "$fire_now" -eq 0 ]; then
  cache="$HOME/.llm-limits.json"

  # WHICH quota this chat is waiting on, from the one resolver every surface asks (share/chat-account.sh):
  # a `claudegpt` chat spends `vendors.codex` under CLAUDEGPT_ACCOUNT, and timing it off a Claude
  # account nobody spent arms the resume for a window that was never the one that walled. A timer is
  # the wrong thing to guess at all — it types into a live chat — so an unreadable resolver refuses.
  if [ -z "$legs_root" ] || [ ! -r "$legs_root/share/chat-account.sh" ]; then
    echo "claude-resume-timer: cannot read share/chat-account.sh; refusing to guess this chat's account" >&2
    exit 1
  fi
  . "$legs_root/share/chat-account.sh"
  chat_account_resolve
  vendor=$CHAT_ACCOUNT_VENDOR
  account=${CHAT_ACCOUNT_NAME:-notcom}

  # The staleness threshold OF the five_hour bucket (not a five-hour one), from the one place it
  # is written down (docs/shared-invariants.md row a) — never a literal of this script's own.
  stale_after=""
  if [ -n "$legs_root" ] && [ -r "$legs_root/share/limits-view.sh" ]; then
    . "$legs_root/share/limits-view.sh"
    stale_after=${LIMITS_STALE_FIVE_HOUR:-}
  fi

  # The `as_of` of a row the COLLECTOR itself calls fresh, and nothing for one it does not. Staleness
  # is limits-view.sh's `limits_bucket_stale` — expired auth and a cached-origin reading as much as
  # age — and a surface that re-derives any part of it from `as_of` alone trusts a row the rest of
  # the system prints with a `~`. The age below is asked on top because that flag is frozen at the
  # instant the collector wrote it and cannot go stale on its own. `expired` is a separate verdict
  # from `stale` (a just-collected row whose window has already rolled is expired but not stale), and
  # it is the one reading a refresh can actually replace: without it the arming below falls back to a
  # blind 15 minutes off a row the collector already zeroed.
  fresh_five_hour_as_of() {
    [ -f "$cache" ] || return 1
    jq -r --arg acct "$account" --arg vendor "$vendor" '
      (.vendors[$vendor].accounts[]? | select(.account == $acct) | .five_hour)
      | select(type == "object" and .stale == false and (.expired // false) == false)
      | .as_of | if type == "number" then . else empty end
    ' "$cache" 2>/dev/null | head -n1
  }

  # A refresh is real OAuth/usage traffic, and one spent on a reading minutes old buys nothing while
  # self-inflicting 429s under capacity weather (Egor, 2026-07-17). Asked of the store first: only a
  # row that is missing, unreadable, marked stale or expired, or past its own threshold is worth it.
  if command -v llm-limits >/dev/null 2>&1; then
    as_of=$(fresh_five_hour_as_of)
    if [ -z "$as_of" ] || [ -z "$stale_after" ] ||
       [ "$(( $(date +%s) - ${as_of%%.*} ))" -ge "$stale_after" ]; then
      run_bounded 20 llm-limits --refresh
    fi
  fi

  # Same ISO8601-with-offset parser llm-limits.sh uses, so resets_at math stays in sync.
  iso_def='def iso2epoch:
    if type != "string" then null
    else (capture("^(?<d>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(\\.[0-9]+)?(?<tz>[Zz]|[+-][0-9]{2}:?[0-9]{2})$") // null) as $c |
      if $c == null then null
      else ($c.d + "Z" | fromdateiso8601)
        - (if ($c.tz | ascii_upcase) == "Z" then 0
           else ($c.tz | capture("^(?<s>[+-])(?<h>[0-9]{2}):?(?<m>[0-9]{2})$")
                 | (if .s == "-" then -1 else 1 end) * ((.h | tonumber) * 3600 + (.m | tonumber) * 60))
           end)
      end
    end;'

  resets_epoch=""
  if [ -f "$cache" ]; then
    resets_epoch=$(jq -r --arg acct "$account" --arg vendor "$vendor" "$iso_def"'
      (.vendors[$vendor].accounts[]? | select(.account == $acct) | .five_hour.resets_at) as $resets
      | if $resets == null then "" else (($resets | iso2epoch) // "") end
    ' "$cache" 2>/dev/null)
  fi

  now=$(date +%s)
  fallback_reason=""

  if [ -z "$resets_epoch" ]; then
    fallback_reason="no five_hour.resets_at for account '$vendor/$account'"
  elif ! is_int "$resets_epoch"; then
    fallback_reason="unparseable resets_at for account '$vendor/$account'"
  elif [ "$resets_epoch" -le "$now" ]; then
    fallback_reason="5h window for account '$vendor/$account' already reset"
  fi

  if [ -n "$fallback_reason" ]; then
    minutes=15
  else
    minutes=$(( (resets_epoch - now) / 60 + extra ))
    [ "$minutes" -ge 1 ] || minutes=1
  fi
fi

if ! command -v hs >/dev/null 2>&1; then
  echo "claude-resume-timer: 'hs' not found on PATH; is Hammerspoon's CLI installed?" >&2
  exit 1
fi

lua_quote() {
  python3 -c 'import json,sys; print(json.dumps(sys.argv[1], ensure_ascii=False))' "$1"
}

arm_one() {
  local target_tty=$1 hs_output hs_status target_note lua_msg=nil
  if [ -n "$custom_message" ]; then
    lua_msg=$(lua_quote "$custom_message") || exit 1
  fi
  hs_output=$(hs -q -c "ClaudeContinue.startTimerFor(\"$surface\", $minutes, $lua_msg, \"$target_tty\")" 2>&1)
  hs_status=$?
  if [ "$hs_status" -ne 0 ]; then
    echo "claude-resume-timer: could not reach hs (Hammerspoon CLI): $hs_output" >&2
    exit 1
  fi
  target_note=" (target $target_tty)"
  [ -n "$custom_message" ] && target_note="${target_note} (custom message)"
  if [ -n "$fallback_reason" ]; then
    echo "claude-resume-timer: $fallback_reason; armed $surface for +$minutes min (fires ~$fires_clock)$target_note"
  else
    echo "claude-resume-timer: armed $surface for $minutes min (fires ~$fires_clock)$target_note"
  fi
}

fires_epoch=$(( now + minutes * 60 ))
fires_clock=$(date -r "$fires_epoch" '+%H:%M' 2>/dev/null || date -j -f %s "$fires_epoch" '+%H:%M' 2>/dev/null || echo "?")

if [ "$arm_all" -eq 1 ]; then
  all_ttys=$(enumerate_claude_ttys)
  if [ -z "$all_ttys" ]; then
    echo "claude-resume-timer: no active Claude chat ttys" >&2
    exit 1
  fi
  while IFS= read -r target_tty; do
    [ -n "$target_tty" ] || continue
    arm_one "$target_tty"
  done <<EOF
$all_ttys
EOF
  exit 0
fi

arm_one "$target_tty"

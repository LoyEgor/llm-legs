#!/usr/bin/env python3
"""Pick a past chat and open it — ordered by when it was last SPOKEN in.

Claude Code's own picker ranks by file mtime, so merely looking into a chat
floats it to the top and the list stops meaning anything. This one asks
`chat-find --recent` for the last real message of every chat and never touches
mtime. Enter replaces this process with claude itself, so the chat lands in the
tab the picker was typed in.
"""

import curses
import datetime
import json
import locale
import math
import os
import re
import shlex
import subprocess
import sys
import threading
import time
import unicodedata

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "share"))
from chat_names import fold_session, project_label, resolve_session  # noqa: E402
import chat_resume  # noqa: E402

PROFILES = os.path.expanduser("~/.claude-profiles")
STATE = os.path.join(PROFILES, ".claudeb", ".claudeb-state")
TRACKS = os.environ.get("STATUSLINE_CACHE_DIR") or os.path.expanduser("~/.cache/claude-statusline")
# Fields of the statusline's track line the picker counts on, the version word being 0
# (invariant row `bj`).
TRACK_TS, TRACK_ACCOUNT = 1, 2
# A week covers what he is usually looking for; the rest loads when he scrolls
# past it or filters, so opening the picker never pays for a corpus he will not read.
WINDOWS = (7, 30, 120, 0)
# project, model, context — capped so a deep worktree name cannot push the
# conversation itself off the right edge.
CAPS = (22, 12, 10)
FOOTER = ("claudeb", "gpt")
USAGE = ("usage: chats --open-command SESSION [--timeout SECONDS]\n"
         "usage: chats [--days N | --all] [--print]\n"
         "  ↑↓ chat · ←→ account (one ring over both lines) · shift+↑↓ line\n"
         "  type to filter · enter opens it here\n"
         "  the account follows the chat's live cache, else the optimal one\n"
         "  mouse: click row · click again opens\n"
         "  scrolling past the last row, or filtering, loads more history")


class Fatal(Exception):
    """A message for the terminal, raised rather than printed: inside curses it has to
    travel out through the wrapper, which restores the screen, before it can be read."""


def die(message):
    raise Fatal(message)


def fetch_chats(days):
    command = [os.path.join(HERE, "chat-find"), "--recent", "--json"]
    if days:
        command += ["--days", str(days)]
    try:
        out = subprocess.run(command, capture_output=True, text=True, check=True).stdout
    except OSError as error:
        raise RuntimeError("cannot run chat-find: %s" % error)
    except subprocess.CalledProcessError as error:
        raise RuntimeError("chat-find failed: %s" % (error.stderr or "").strip())
    try:
        return json.loads(out)
    except ValueError:
        raise RuntimeError("chat-find returned no usable listing")


def fetcher(days):
    """One history window as a callable, bound to the days it asks for."""
    return lambda: fetch_chats(days)


class Job:
    """A call run off the key loop — one in flight at a time, its answer taken once.

    Every subprocess the picker needs goes through this, so the screen is painted
    before any of them and each lands into the loop on its own.
    """

    def __init__(self):
        self.thread = None
        self.result = None

    def start(self, work):
        if self.thread:
            return
        def run():
            try:
                self.result = work()
            except RuntimeError as error:
                self.result = error
        self.thread = threading.Thread(target=run, daemon=True)
        self.thread.start()

    def landed(self):
        return self.thread is not None and not self.thread.is_alive()

    def take(self, wait=False):
        """The answer (or the RuntimeError) of the finished call, else None."""
        if not self.thread or not (wait or self.landed()):
            return None
        self.thread.join()
        self.thread, result, self.result = None, self.result, None
        return result


def profiles():
    """Every account a chat can be reopened under, as (launcher, name).

    Two stores, and one name can be in both — `com` is a claudeb profile AND a gateway
    login — so the launcher travels with the name instead of being re-derived later.
    """
    try:
        entries = os.listdir(PROFILES)
    except OSError:
        entries = []
    # "main" is not a claudeb profile — it names ~/.claude itself, and claudeb
    # refuses it, so offering it would only ever produce a failed launch.
    names = [("claudeb", entry) for entry in sorted(entries)
             if not entry.startswith(".") and entry != "main"
             and os.path.isdir(os.path.join(PROFILES, entry))]
    names += [("gpt", name) for name in chat_resume.gateway_accounts()]
    if not names:
        die("no claudeb profiles under %s and no claudegpt account" % PROFILES)
    return names


def account_label(entry):
    """`gpt:` marks the gateway store, since the same name lives in both."""
    vendor, name = entry
    return name if vendor == "claudeb" else "gpt:" + name


def warm_account(row):
    """The account, claudeb or gateway, whose prompt cache still holds this chat, or None.

    A transcript never says which account a reply went through; the statusline
    learns that while the chat is open and leaves it in its track file, stamped
    with the reply it attributed. The bucket the cache lives in is the
    transcript's own reading; `until` is when it expires.
    """
    row["until"] = None
    spoke, ttl = row.get("spoke"), row.get("ttl")
    if not spoke or not ttl:
        return None
    try:
        with open(os.path.join(TRACKS, "cache-ttl-track-" + row["session"]),
                  encoding="utf-8") as handle:
            fields = handle.readline().split()
    except OSError:
        return None
    if len(fields) <= TRACK_ACCOUNT or fields[0] != "v2" or fields[TRACK_ACCOUNT] == "?":
        return None
    seen = fields[TRACK_TS]
    seen = int(seen) if seen.isdigit() else 0
    # The statusline stamps the newest reply of ANY kind, this row the newest one that SPOKE, so
    # the two name the same reply only until a chat ends on a tool call. A track that has moved
    # PAST this row is later knowledge of the same chat and refreshed the cache with it; one that
    # stands behind it proves nothing about whatever account answered since.
    if seen + 1 < spoke:
        return None
    row["until"] = max(spoke, seen) + ttl
    return fields[TRACK_ACCOUNT]


def annotate(chats):
    for row in chats:
        row["warm"] = warm_account(row)
    return chats


def warm_name(row, now):
    return row["warm"] if row.get("warm") and now < row["until"] else None


def worker_pick():
    """The selector to ask, resolved like the `chat-find` beside it: the sibling
    of this script first, so both halves of the picker's answer come from one
    checkout, and PATH only for an install that ships them apart."""
    override = os.environ.get("CLAUDEB_WORKER_PICK")
    if override:
        return override
    sibling = os.path.join(HERE, "worker-pick")
    return sibling if os.access(sibling, os.X_OK) else "worker-pick"


def ranking(timeout=10):
    """`worker-pick --list --role chat`, the one ranking the bar shows, as (order, used,
    hidden, chosen): every account in its order, the label each one's usage adds, the
    logged-out ones, and the claudeb account a chat would be given.

    Zero-token — it reads the cached limits table — and asked once, at startup. A gateway
    account spends the Codex subscription behind it, so the codex rows order the `gpt` line.
    """
    order, used, hidden, chosen = [], {}, set(), None
    try:
        done = subprocess.run([worker_pick(), "--list", "--role", "chat"],
                              capture_output=True, text=True, timeout=timeout)
    except Exception:
        return order, used, hidden, chosen
    if done.returncode != 0:
        return order, used, hidden, chosen
    for line in done.stdout.splitlines():
        fields = line.split("\t")
        if fields[0] == "NEXT":
            if fields[1:2] == ["claudeb"] and len(fields) == 3 and fields[2] != "-":
                chosen = fields[2]
            continue
        launcher = {"claudeb": "claudeb", "codex": "gpt"}.get(fields[0])
        if not launcher or len(fields) != 4:
            continue
        entry = (launcher, fields[1])
        order.append(entry)
        if fields[3] == "login":
            hidden.add(entry)
        mark = (fields[2] + "%" if fields[2].isdigit() else "") + \
            ("!" if fields[3] == "walled" else "")
        if mark:
            used[entry] = mark
    return order, used, hidden, chosen


def arrange(names, order, hidden):
    """The bar in worker-pick's order, freest first on each line, the logged-out accounts
    gone; one it does not list follows in directory order, since no data is not a logout."""
    rank = {entry: position for position, entry in enumerate(order)}
    kept = [entry for entry in names if entry not in hidden]
    return sorted(kept, key=lambda entry: (FOOTER.index(entry[0]), rank.get(entry, len(rank))))


def current_profile(names, chosen):
    """The account to open on: worker-pick's chat pick, else the last profile launched —
    a file read, so it stands in before the ranking lands."""
    try:
        with open(STATE, encoding="utf-8") as handle:
            state = handle.readline().strip()
    except OSError:
        state = ""
    for name in (chosen, state):
        if ("claudeb", name) in names:
            return names.index(("claudeb", name))
    return 0 if names else None


def restack(names, kept, positions):
    """The bar's positions after it is reordered: each follows the entry it named, and one
    whose account is gone falls back to the first, or to none when the bar is empty."""
    return [kept.index(names[position]) if names[position] in kept else (0 if kept else None)
            for position in positions]


def refollow(row, landed, profile, held):
    """Whether the account should be asked of this row again: on every new
    landing, and on a row already landed on as long as ←→ has not moved the
    account since — a cache expiring under a resting cursor must hand it back."""
    return row.get("session") != landed or profile == held


def account_for(row, now, names, default):
    """The account a landed row implies: the one whose cache still holds this
    chat, else back to the account the picker opened on.

    Never the claudegpt launch stamp: it outlives the one reopen it recorded, so a
    Claude chat once reopened through the gateway would resolve to gpt forever.
    """
    vendor = "gpt" if chat_resume.gateway_alias(row.get("model")) else "claudeb"
    warm = (vendor, warm_name(row, now))
    return names.index(warm) if warm[1] and warm in names else default


def widen(result, asked, level, chats, windows):
    """A landed load of window `asked`: the wider listing supersedes the narrower one,
    and a failed load leaves no wider window to ask for, or every keystroke would rerun
    it. A first load that fails has nothing to fall back on and ends the picker."""
    if isinstance(result, RuntimeError):
        if not chats:
            die(str(result))
        return level, chats, windows[:asked], str(result)
    return asked, annotate(result), windows, ""


def label(level, windows):
    days = windows[level]
    if not days:
        return "all time"
    return "last %gd · ↓ for more" % days if level + 1 < len(windows) else "last %gd" % days


def when_label(at, now, dated=False):
    """One column for when it was last spoken in: the clock for today, the date before it.

    The two never both matter — a chat from today is placed by its hour, an older one by its
    day. The year matters in the last window alone, which has no horizon: there two chats a year
    apart both read `07.04` and nothing on the row tells them apart.
    """
    spoken = datetime.datetime.fromtimestamp(at).astimezone()
    midnight = datetime.datetime.fromtimestamp(now).astimezone().replace(
        hour=0, minute=0, second=0, microsecond=0)
    if spoken >= midnight:
        return spoken.strftime("%H:%M")
    return spoken.strftime("%d.%m.%y") if dated else spoken.strftime("%d.%m")


def width(text):
    """Columns the text occupies on screen, not characters it is made of."""
    return sum(2 if unicodedata.east_asian_width(ch) in "WF" else 1 for ch in text)


def clip(text, room):
    """The longest prefix that fits in `room` columns.

    Every cut and every cursor position goes through this and `width`: curses
    counts an `addnstr` limit in characters at best and in UTF-8 bytes on some
    builds, so a CJK title handed to it wraps past the right edge, and the next
    write — placed by `getyx` — lands on top of the row it just drew.
    """
    if room <= 0:
        return ""
    kept, used = [], 0
    for ch in text:
        step = 2 if unicodedata.east_asian_width(ch) in "WF" else 1
        if used + step > room:
            break
        kept.append(ch)
        used += step
    return "".join(kept)


def pad(text, size, right=False):
    text = clip(text, size)
    fill = " " * (size - width(text))
    return fill + text if right else text + fill


def model_label(row):
    # The release date in a model id ("claude-haiku-4-5-20251001") is width the
    # column pays for one model and nobody reads.
    return chat_resume.model_label(row.get("model")) \
        or re.sub(r"-20\d{6}$", "", (row.get("model") or "").replace("claude-", ""))


def columns(row, now, dated=False):
    """One chat as the fields it is recognised by, each its own column."""
    said = " ".join((row.get("text") or "").split())
    if said:
        # Who spoke last says whether the chat is finished or waiting on him.
        said = ("you: " if row.get("role") == "user" else "claude: ") + said
    # A tab or newline inside a title moves the cursor as surely as an overlong
    # write does, so the name is collapsed exactly like the quote already is.
    name = " ".join((row.get("name") or "").split())
    return ["%*s" % (8 if dated else 5, when_label(row["at"], now, dated)),
            project_label(row.get("cwd")),
            model_label(row),
            warm_name(row, now) or ("%dk" % (row["ctx"] // 1000) if row.get("ctx") else ""),
            name or said or "—",
            said if name else ""]


def matches(row, needle):
    if not needle:
        return True
    hay = " ".join(str(row.get(key) or "") for key in
                   ("name", "text", "cwd", "branch", "model", "session")).lower()
    return all(word in hay for word in needle.lower().split())


def plan(rows):
    """Column widths, measured over the whole list so they never jump on scroll.

    Measured off the raw fields rather than off columns(): this runs on every
    keystroke, and formatting thousands of timestamps to learn how wide the
    project column is would be felt as lag while typing a filter.
    """
    sizes = [0] * len(CAPS)
    for row in rows:
        cells = (project_label(row.get("cwd")),
                 model_label(row),
                 row.get("warm") or ("%dk" % (row["ctx"] // 1000) if row.get("ctx") else ""))
        sizes = [max(size, width(cell)) for size, cell in zip(sizes, cells)]
    return [min(size, cap) for size, cap in zip(sizes, CAPS)]


def draw(screen, rows, view, names, profile, needle, used, note):
    # curses raises on a write that will not fit — a window narrowed mid-session
    # must leave the picker usable rather than end it with a traceback.
    try:
        paint(screen, rows, view, names, profile, needle, used, note)
    except curses.error:
        pass


def body_rows(screen):
    return max(1, screen.getmaxyx()[0] - 1 - len(FOOTER))


def account_lines(names, used, profile):
    """The account bar, one line per store in FOOTER order, as (position, label, attribute)."""
    lines = [[] for _ in FOOTER]
    for position, entry in enumerate(names):
        mark = used.get(entry)
        shown = account_label(entry)
        label = " %s %s " % (shown, mark) if mark else " %s " % shown
        attribute = curses.A_REVERSE if position == profile else curses.A_DIM
        lines[FOOTER.index(entry[0])].append((position, label, attribute))
    return lines


def line_jump(names, profile, step):
    """Shift+↑↓: the same place on the neighbouring line, clamped to that line's length."""
    lines = [line for line in ([position for position, entry in enumerate(names)
                                if entry[0] == vendor] for vendor in FOOTER) if line]
    here = next(number for number, line in enumerate(lines) if profile in line)
    there = lines[max(0, min(here + step, len(lines) - 1))]
    return there[min(lines[here].index(profile), len(there) - 1)]


def paint(screen, rows, view, names, profile, needle, used, note):
    screen.erase()
    height, span = screen.getmaxyx()
    body = body_rows(screen)
    header = "%d chats · %s · ↑↓ chat · ←→ account · type to filter" % (
        len(rows), view["window"])
    if needle:
        header += "   /%s" % needle
    if note:
        header += "   " + note
    screen.addstr(0, 0, pad(header, span - 1), curses.A_BOLD)

    sizes = plan(rows)
    for line in range(body):
        index = view["top"] + line
        if index >= len(rows):
            break
        cells = columns(rows[index], view["now"], view.get("dated", False))
        chosen = index == view["cursor"]
        fields = ["▸ " if chosen else "  ", cells[0]]
        for cell, size in zip(cells[1:3], sizes[:2]):
            fields.append(pad(cell, size))
        fields.append(pad(cells[3], sizes[2], right=True))
        head = clip(fields[0] + "  ".join(fields[1:]) + "  ", span - 1)
        attribute = curses.A_BOLD if chosen else curses.A_NORMAL
        screen.addstr(line + 1, 0, head, attribute)
        column = width(head)
        if column < span - 1:
            name = clip(cells[4], span - 1 - column)
            screen.addstr(line + 1, column, name, attribute)
            column += width(name)
        # The quote is dimmed because it answers a different question than the
        # name does: not what the chat is, but where it stopped.
        if cells[5] and column < span - 4:
            screen.addstr(line + 1, column, clip(" · " + cells[5], span - 1 - column),
                          curses.A_DIM)

    top = height - len(FOOTER)
    for number, line in enumerate(account_lines(names, used, profile)):
        screen.addstr(top + number, 0, " " * (span - 1))
        column = 0
        for _, label, attribute in line:
            if column >= span - 1:
                break
            label = clip(label, span - 1 - column)
            screen.addstr(top + number, column, label, attribute)
            column += width(label)
    hint = ("   ↵ open · ^C quit · esc clear · "
            "account: chat's cache, else optimal")
    if column < span - 1:
        screen.addstr(height - 1, column, clip(hint, span - 1 - column))
    screen.refresh()


def run(screen, chats, names, used, profile, level, windows):
    """The picker. Whatever is handed in as None is not known yet: it is loaded in the
    background and lands into the loop, so the first paint waits for no subprocess."""
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    try:
        curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
        curses.mouseinterval(0)
    except curses.error:
        pass
    # Draw on whatever background the terminal already has, so the picker is
    # light in a light theme and dark in a dark one; the only inverted thing is
    # the account in use.
    try:
        curses.start_color()
        curses.use_default_colors()
    except curses.error:
        pass
    screen.timeout(100)
    view = {"cursor": 0, "top": 0, "now": time.time()}
    needle, note, scrolled, landed = "", "", False, None
    listing, ranked = Job(), Job()
    ready, pending, pinned = chats is not None, None, False
    if not ready:
        chats, pending = [], 0
        listing.start(fetcher(windows[0]))
    if used is None:
        used = {}
        ranked.start(ranking)
    if names is None:
        names = profiles()
    if profile is None:
        # The last profile launched is a file read, so the bar opens on a plausible
        # account instead of an arbitrary one while worker-pick is still answering.
        profile = current_profile(names, None)
    default = held = profile
    while True:
        view["now"] = time.time()
        got = listing.take()
        if got is not None:
            level, chats, windows, note = widen(got, pending, level, chats, windows)
            pending, ready = None, ready or bool(chats)
            # An empty first window is not an empty history: widen until something is
            # there, so a week away from the machine does not look like no chats at all.
            if not ready:
                if level + 1 >= len(windows):
                    die("no chat found in that window (try: chats --all)")
                pending = level + 1
                listing.start(fetcher(windows[pending]))
        if ranked.landed():
            order, used, hidden, chosen = ranked.take()
            kept = arrange(names, order, hidden)
            profile, held, default = restack(names, kept, (profile, held, default))
            names = kept
            if not pinned:
                default = current_profile(names, chosen)
        rows = [row for row in chats if matches(row, needle)]
        # ←→ before the listing lands is a choice of the DEFAULT itself: no row has
        # spoken about its cache yet, so the account landing later must not take it back.
        if not ready and profile != held:
            default = held = profile
            pinned = True
        # Scrolling past the end is the ask for more history; a filter that matches
        # nothing also leaves the cursor past the last row, and it widens in the
        # background below instead of blocking on every keystroke.
        if scrolled and ready and view["cursor"] >= len(rows) and level + 1 < len(windows):
            view["window"] = "loading…"
            draw(screen, rows, view, names, profile, needle, used, note)
            if pending is None:
                pending = level + 1
                listing.start(fetcher(windows[pending]))
            level, chats, windows, note = widen(listing.take(wait=True), pending,
                                                level, chats, windows)
            pending, scrolled = None, False
            continue
        if needle and ready and pending is None and level + 1 < len(windows):
            pending = level + 1
            listing.start(fetcher(windows[pending]))
        view["window"] = "loading…" if not ready else \
            label(level, windows) + (" · searching…" if pending is not None else "")
        view["dated"] = not windows[level]
        view["cursor"] = max(0, min(view["cursor"], len(rows) - 1))
        # ←→ overrides only while the cursor stays put: the next landing re-asks
        # account_for, so a row with no live cache returns to the optimal account
        # rather than keeping whichever chat's cache was picked up on the way.
        if rows and refollow(rows[view["cursor"]], landed, profile, held):
            landed = rows[view["cursor"]].get("session")
            profile = held = account_for(rows[view["cursor"]], view["now"], names, default)
        height = body_rows(screen)
        view["top"] = max(min(view["top"], view["cursor"]), view["cursor"] - height + 1)
        view["top"] = max(0, min(view["top"], max(0, len(rows) - height)))
        draw(screen, rows, view, names, profile, needle, used, note)
        note = ""
        # The 100ms timeout exists only to notice a landed load; repainting on every
        # empty tick would redraw an idle picker ten times a second for nothing.
        key = None
        while key is None:
            try:
                key = screen.get_wch()
            except KeyboardInterrupt:
                return None
            except curses.error:
                if listing.landed() or ranked.landed():
                    break
        if key is None:
            continue

        if key == curses.KEY_MOUSE:
            scrolled = False
            try:
                _, x, y, _, bstate = curses.getmouse()
            except curses.error:
                continue
            if bstate & curses.BUTTON4_PRESSED:
                view["cursor"] -= 3
                continue
            # Builds whose ncurses encodes four buttons have no wheel-down bit at all, and
            # the five-button spelling of it is BUTTON4_DOUBLE_CLICKED there — a literal
            # fallback scrolls the list the wrong way on a doubled wheel-up.
            if bstate & getattr(curses, "BUTTON5_PRESSED", 0):
                view["cursor"] += 3
                scrolled = True
                continue
            # Ignore RELEASED so a press/release pair cannot also open the landed row.
            if not bstate & (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED |
                             curses.BUTTON1_DOUBLE_CLICKED):
                continue
            screen_height, span = screen.getmaxyx()
            footer = screen_height - len(FOOTER)
            if footer <= y < screen_height:
                column = 0
                for position, text, _ in account_lines(names, used, profile)[y - footer]:
                    end = column + width(clip(text, span - 1 - column))
                    if column <= x < end:
                        profile = position
                        break
                    column = end
                continue
            index = view["top"] + y - 1
            if not (1 <= y <= body_rows(screen) and 0 <= x < span - 1
                    and 0 <= index < len(rows)):
                continue
            if index != view["cursor"]:
                view["cursor"] = index
                if not bstate & curses.BUTTON1_DOUBLE_CLICKED:
                    continue
                landed = rows[index].get("session")
                profile = held = account_for(rows[index], view["now"], names, default)
            key = curses.KEY_ENTER

        # End goes to the last row he has; only stepping PAST it asks for more.
        scrolled = key in (curses.KEY_DOWN, "\x0e", curses.KEY_NPAGE)
        if key in (curses.KEY_DOWN, "\x0e"):
            view["cursor"] += 1
        elif key in (curses.KEY_UP, "\x10"):
            view["cursor"] -= 1
        elif key == curses.KEY_NPAGE:
            view["cursor"] += height
        elif key == curses.KEY_PPAGE:
            view["cursor"] -= height
        elif key == curses.KEY_HOME:
            view["cursor"] = 0
        elif key == curses.KEY_END:
            view["cursor"] = len(rows) - 1
        elif key == curses.KEY_LEFT and names:
            profile = (profile - 1) % len(names)
        elif key == curses.KEY_RIGHT and names:
            profile = (profile + 1) % len(names)
        elif key == curses.KEY_SR and names:
            profile = line_jump(names, profile, -1)
        elif key == curses.KEY_SF and names:
            profile = line_jump(names, profile, 1)
        elif key == "\x1b":
            # Never an exit: a terminal that is not in application-keypad mode
            # delivers arrow keys as a bare ESC followed by letters, and quitting
            # on it would drop him out of the picker every time he scrolled.
            needle = ""
        elif key == "\x04":
            return None
        elif key in (curses.KEY_BACKSPACE, "\x7f", "\b"):
            needle = needle[:-1]
        elif key in ("\n", "\r", curses.KEY_ENTER):
            if not rows:
                continue
            if not names:
                note = "no logged-in account to open it under"
                continue
            chosen = rows[view["cursor"]]
            # The chat's own directory, worktree and all: the project column shows the main
            # checkout, but the transcript slugs to where the chat was actually started.
            cwd = chosen.get("cwd")
            # claude resolves --resume against the project slug of the directory
            # it starts in, so a chat opened from anywhere else silently finds
            # no transcript. Refuse instead of launching into an empty session.
            if not cwd or not os.path.isdir(cwd):
                note = "no such directory: %s" % (cwd or "?")
                continue
            return names[profile], chosen, cwd
        elif isinstance(key, str) and key.isprintable():
            needle += key
        # Deliberately not clamped here: a cursor past the last row is the signal
        # the top of the loop reads as "widen the window". It clamps there.


def open_command(session, timeout):
    candidates = resolve_session(session)
    if len(candidates) != 1:
        die("session id is ambiguous: %s" % session)
    session = fold_session(candidates[0])
    if not session:
        die("no chat found for %s" % candidates[0])
    try:
        row = next((row for row in fetch_chats(0) if row["session"] == session), None)
    except RuntimeError as error:
        die(str(error).replace("\n", " "))
    if row is None:
        die("no chat found for %s" % session)
    cwd = row.get("cwd")
    if not cwd or not os.path.isdir(cwd):
        die("no such directory: %s" % (cwd or "?"))
    annotate([row])
    names = profiles()
    order, _, hidden, chosen = ranking(timeout)
    names = arrange(names, order, hidden)
    default = current_profile(names, chosen)
    position = account_for(row, time.time(), names, None)
    source = "cache" if position is not None else (
        "pick" if ("claudeb", chosen) in names else "fallback")
    position = default if position is None else position
    if position is None:
        die("no logged-in account to open it under")
    vendor, account = names[position]
    if chat_resume.is_gateway_chat(session, row.get("model")) and vendor != "gpt":
        command = chat_resume.resume_argv(session, account, row.get("model"))
        source = "cache"
    else:
        command = chat_resume.switch_argv(session, account, model_id=row.get("model"),
                                          gateway=vendor == "gpt")
    account = chat_resume.argv_account(command) or account
    if account == chat_resume.UNKNOWN_ACCOUNT:
        die("gateway account unknown for this chat")
    command[0] = os.path.join(HERE, command[0])
    command += ["--permission-mode", "bypassPermissions"]
    print(chat_resume.resume_line([shlex.quote(word) for word in command], cwd))
    print("account=%s source=%s" % (account, source))


def main():
    if sys.argv[1:2] == ["--open-command"]:
        args = sys.argv[2:]
        if len(args) not in (1, 3) or (len(args) == 3 and args[1] != "--timeout"):
            die("usage: chats --open-command SESSION [--timeout SECONDS]")
        try:
            timeout = float(args[2]) if len(args) == 3 else 1
            if not math.isfinite(timeout) or timeout <= 0:
                raise ValueError
        except ValueError:
            die("--timeout must be a positive number of seconds")
        open_command(args[0], timeout)
        return
    locale.setlocale(locale.LC_ALL, "")
    # A window asked for by name is the whole list he wants: widening on scroll
    # would quietly override it.
    windows = WINDOWS
    argv = [word for word in sys.argv[1:] if word != "--print"]
    show = len(argv) != len(sys.argv[1:])
    if argv[:1] == ["--days"] and len(argv) == 2:
        try:
            windows = (float(argv[1]),)
        except ValueError:
            die("--days takes a number of days, not %r" % argv[1])
    elif argv == ["--all"]:
        windows = (0,)
    elif argv in (["-h"], ["--help"]):
        print(USAGE)
        return
    elif argv:
        die(USAGE)

    if not sys.stdin.isatty() or not sys.stdout.isatty():
        die("this is a full-screen picker; run it from a terminal prompt "
            "(inside a chat: /exit first, then `chats`)")

    # Nothing is loaded before the screen: the listing and the account ranking are handed
    # in as None and run() loads both in the background, so the picker is up in
    # milliseconds instead of after sequential subprocesses.
    chosen = curses.wrapper(run, None, None, None, None, 0, windows)
    if not chosen:
        return
    (vendor, account), row, cwd = chosen
    # Pinned explicitly because a resumed session restores the mode it was left
    # in, not settings.json's defaultMode — one chat that ever drifted into auto
    # (the 2026-08-14 rollout flipped a batch) would reopen in auto forever.
    command = chat_resume.switch_argv(row["session"], account, model_id=row.get("model"),
                                      gateway=vendor == "gpt") \
        + ["--permission-mode", "bypassPermissions"]
    launch = "cd %s && %s" % (shlex.quote(cwd), shlex.join(command))
    if show:
        print(launch)
        return
    try:
        os.chdir(cwd)
        os.execvp(command[0], command)
    except OSError as error:
        die("cannot open the chat (%s); it is: %s" % (error, launch))


if __name__ == "__main__":
    try:
        main()
    except Fatal as reason:
        print("chats: %s" % reason, file=sys.stderr)
        raise SystemExit(1)

#!/usr/bin/env bash
set -u

PROFILES_DIR="$HOME/.claude-profiles"
GATEWAY_DIR="${CLAUDEGPT_HOME:-$HOME/.local/share/claudegpt}/accounts"
CHAT_RESUME="$(dirname "$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")")/share/chat_resume.py"

mode=unknown
die() { printf 'claude-chat-switch: mode=%s: %s\n' "$mode" "$*" >&2; exit 1; }

usage() {
  cat >&2 <<'EOF'
usage: claude-chat-switch [--front|--self] [--dry-run] [--gateway] [--model sol|astra] [--cwd <dir>] <profile> [session-id]

  <profile>     an existing account under ~/.claude-profiles (NOT "main"), or with
                --gateway an OpenAI account under the claudegpt store
  [session-id]  optional; defaults to $CLAUDE_CODE_SESSION_ID, else the newest
                transcript for the current directory's project
  --dry-run     print mode, pids, cwd and command without arming or typing
  --model       gateway model alias for a fresh launch
  --front       target the frontmost Terminal tab: launch fresh from a bare
                shell, or wait for a chat to go idle, /exit it and reopen it
  --self        same hands-free switch, but targeted at the CALLING chat's own
                tab, so it works without Terminal being frontmost (the path a
                chat uses to hand its tab to another conversation)
  --gateway     <profile> names a claudegpt (OpenAI) account; the same name
                in ~/.claude-profiles is a different account
  --cwd <dir>   directory to cd into before resuming — the project the target
                session belongs to, when that is not the chat's own; without it
                the chat's own directory travels with the switch

Arms a Hammerspoon one-shot that relaunches the target chat under <profile>. In
--front/--self mode the /exit is typed for you, once the chat goes idle; plain
mode waits for you to exit it (Ctrl+C twice or /exit). Nothing is killed.
EOF
  exit 2
}

list_profiles() {
  local d
  for d in "$PROFILES_DIR"/*/; do
    [ -d "$d" ] || continue
    printf '  %s\n' "$(basename "$d")"
  done
}

list_gateway_accounts() {
  local d
  for d in "$GATEWAY_DIR"/*/; do
    [ -d "$d" ] || continue
    printf '  %s\n' "$(basename "$d")"
  done
}

reopen_command() {
  local session=$1 account=$2
  local -a args=()
  if [ -n "$session" ]; then args=(switch "$session"); else args=(launch); fi
  args+=(--account "$account")
  [ "$gateway_mode" -eq 1 ] && args+=(--gateway)
  [ -n "$model_arg" ] && args+=(--model "$model_arg")
  python3 "$CHAT_RESUME" "${args[@]}"
}

# $1, when given, is the chat this switch is FOR: its own ancestor walk already named it, and the
# foreground pick below would answer with a different claude on the same tab. $2=true reads the tab
# as a bonus rather than as the target: --self already knows its chat, so a tab that will not
# classify (or classifies as some other process) leaves that answer alone instead of refusing.
classify_tab() {
  local known="${1:-0}" soft="${2:-false}" table result c_mode c_pid c_wait c_shell c_kind
  table=$(ps -t "${tty_dev#/dev/}" -o pid=,ppid=,stat=,comm=,command= 2>/dev/null) ||
    { [ "$soft" = true ] && return 1; die "cannot read tab processes"; }
  result=$(printf '%s\n' "$table" | CCS_KNOWN_CHAT_PID="$known" python3 -c '
import os, shlex, sys
rows = {}
for line in sys.stdin:
    fields = line.split(None, 4)
    if len(fields) == 5 and fields[0].isdigit() and fields[1].isdigit():
        pid, parent, stat, comm, command = fields
        rows[int(pid)] = (int(parent), stat, os.path.basename(comm), command)
chats = [p for p, r in rows.items() if r[2] == "claude" and "Z" not in r[1]]
known = int(os.environ.get("CCS_KNOWN_CHAT_PID") or 0)
if known in chats:
    chats = [known]
if chats:
    inner = next((p for p in chats if "+" in rows[p][1]), chats[0])
    outer, kind, current, seen = inner, "claude", inner, set()
    while current in rows and current not in seen:
        seen.add(current)
        parent, stat, comm, command = rows[current]
        try:
            argv = shlex.split(command)
        except ValueError:
            argv = command.split()
        wrapper = comm == "claudegpt" or (comm.lower().startswith("python") and
            any(os.path.basename(a) == "claudegpt" for a in argv[1:3]))
        if wrapper:
            outer, kind = current, "gateway"
        current = parent
    print("has_chat", inner, outer, 0, kind)
else:
    foreground = [(p, r) for p, r in rows.items() if "+" in r[1] and "Z" not in r[1]]
    shells = [(p, r) for p, r in foreground if r[2].lstrip("-") in
              ("sh", "bash", "zsh", "fish", "ksh", "tcsh", "csh", "dash")]
    if len(foreground) == 1 and len(shells) == 1:
        print("bare_shell", 0, 0, shells[0][0], "shell")
    else:
        print("unsupported", 0, 0, 0, "unknown")
') || { [ "$soft" = true ] && return 1; die "cannot classify tab processes"; }
  read -r c_mode c_pid c_wait c_shell c_kind <<<"$result"
  if [ "$soft" = true ]; then
    { [ "$c_mode" = has_chat ] && [ "$c_pid" = "$known" ]; } || return 1
  fi
  mode="$c_mode"; claude_pid="$c_pid"; wait_pid="$c_wait"
  shell_pid="$c_shell"; source_kind="$c_kind"
  [ "$mode" != unsupported ] || die "foreground process is not an idle shell or Claude chat on $tty_dev"
  if [ "$mode" = bare_shell ]; then
    resume_cwd=$(lsof -a -p "$shell_pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)
    [ -n "$resume_cwd" ] || resume_cwd="$HOME"
  elif ps eww -o command= -p "$claude_pid" 2>/dev/null | grep -qE '(^| )CLAUDEGPT_ACCOUNT=[^ ]+'; then
    source_kind=gateway
  fi
}

# claudeb's own reserved words (bin/claudeb reserved_name) plus "main", which is
# not a claudeb profile at all (it maps to ~/.claude itself, never an isolated
# account dir). Keep this list in sync with reserved_name in bin/claudeb.
is_reserved() {
  case "$1" in
    main|help|add|enable|disable|remove|use|accounts|status|st|profile|p|run|warm|token-upkeep) return 0 ;;
    .*|*/*) return 0 ;;
    *) return 1 ;;
  esac
}

# claude derives a project's transcript directory by replacing every character
# that is not a letter or digit in the REALPATH of the cwd with a hyphen. /tmp
# resolves to /private/tmp, so realpath (not $PWD) is what matches on disk.
project_slug() {
  local real
  real=$(cd "$1" 2>/dev/null && pwd -P) || real="$1"
  printf '%s' "$real" | sed 's/[^A-Za-z0-9]/-/g'
}

# Every profile's projects/ is a symlink to ~/.claude/projects today, which is what
# lets a session resume under a different account at all. They are still walked in
# order — the running chat's own config dir first — in case one ever stops being one.
transcript_roots() {
  local pid=$1 cfg d
  cfg=$(ps eww -o command= -p "$pid" 2>/dev/null \
        | grep -oE 'CLAUDE_CONFIG_DIR=[^ ]+' | head -1 | cut -d= -f2-)
  [ -n "$cfg" ] && printf '%s\n' "$cfg"
  printf '%s\n' "$HOME/.claude"
  for d in "$PROFILES_DIR"/*/; do
    [ -d "$d" ] && printf '%s\n' "${d%/}"
  done
}

transcript=""
resume_cwd=""
notes=""

# Anything the resolution had to guess at. The menu path throws this script's output
# away unless it exits non-zero, so a note only ever reaches him by travelling to the
# Hammerspoon log alongside the switch it belongs to.
note() {
  local text=$1
  text=${text//$'\n'/ }
  text=${text//$'\r'/ }
  notes="${notes:+$notes; }$text"
  printf 'claude-chat-switch: mode=%s: %s\n' "$mode" "$text" >&2
}

# The transcript of a session, wherever it lives; sets $transcript. Looking only under
# the slug of the chat's current directory is what silently downgraded live chats to
# fresh ones: a chat reopened from somewhere else keeps writing the transcript of the
# project it was started in, so its cwd is a hint and never a verdict.
find_transcript() {
  local sid=$1 hint=$2 pid=$3 root slug="" hit real seen="" found=0
  local -a roots=()
  transcript=""
  while IFS= read -r root; do
    [ -n "$root" ] && roots+=("$root")
  done < <(transcript_roots "$pid")
  [ -n "$hint" ] && slug=$(project_slug "$hint")
  for root in "${roots[@]}"; do
    if [ -n "$slug" ] && [ -f "$root/projects/$slug/$sid.jsonl" ]; then
      transcript="$root/projects/$slug/$sid.jsonl"
      return 0
    fi
  done
  # One id can hold transcripts under several projects at once (a session that moved,
  # a copied transcript). Glob order is alphabetical, which picks the abandoned one as
  # readily as the live one; the newest is the conversation still being written to.
  # Roots mostly symlink to one store, so the same file is seen once per root.
  for root in "${roots[@]}"; do
    for hit in "$root"/projects/*/"$sid.jsonl"; do
      [ -f "$hit" ] || continue
      real=$(cd -- "$(dirname "$hit")" 2>/dev/null && printf '%s/%s' "$(pwd -P)" "${hit##*/}")
      [ -n "$real" ] || real="$hit"
      case "|$seen|" in *"|$real|"*) continue ;; esac
      seen="${seen:+$seen|}$real"
      found=$((found + 1))
      if [ -z "$transcript" ] || [ "$hit" -nt "$transcript" ]; then transcript="$hit"; fi
    done
  done
  [ -n "$transcript" ] || return 1
  if [ "$found" -gt 1 ]; then
    note "session $sid has transcripts under $found projects; taking the newest, $transcript"
  fi
  return 0
}

# Where the resumed chat should land; sets $resume_cwd. The registry's cwd is only
# where the process was launched, and a cwd the transcript records can be one the
# conversation has since left. The directory the transcript LIVES in is the ground
# truth, so a candidate that does not slug to it belongs to some other project.
project_home() {
  local path=$1 fallback=$2 here recorded matched="" strayed=""
  resume_cwd="$fallback"
  here=$(basename "$(dirname "$path")")
  [ -n "$fallback" ] && [ "$(project_slug "$fallback")" = "$here" ] && return 0
  while IFS= read -r recorded; do
    { [ -n "$recorded" ] && [ -d "$recorded" ]; } || continue
    if [ "$(project_slug "$recorded")" = "$here" ]; then
      matched="$recorded"
      break
    fi
    [ -n "$strayed" ] || strayed="$recorded"
  done < <(head -20 "$path" 2>/dev/null | jq -r 'select(.cwd) | .cwd' 2>/dev/null)
  if [ -n "$matched" ]; then
    resume_cwd="$matched"
    [ -n "$strayed" ] && note "transcript $path records cwd $strayed outside its own project $here; resuming from $matched"
  elif [ -n "$strayed" ]; then
    note "transcript $path records only cwd $strayed, outside its own project $here; resuming from ${fallback:-whatever directory the tab is left in}"
  else
    note "transcript $path records no directory that still exists; resuming from ${fallback:-whatever directory the tab is left in}"
  fi
  return 0
}

# Claude Code keeps ~/.claude/sessions/<pid>.json per live interactive process
# (global: every profile's sessions dir symlinks here). procStart must equal the
# process's C-locale UTC start time, else the file is stale or the pid was reused;
# prints nothing in that case, and callers treat "no registry" as "cannot watch it".
live_registry() {
  local pid reg reg_proc_start ps_start
  pid=$1
  reg="$HOME/.claude/sessions/$pid.json"
  [ -f "$reg" ] || return 0
  reg_proc_start=$(jq -r '.procStart // ""' "$reg" 2>/dev/null)
  ps_start=$(env LC_ALL=C TZ=UTC ps -o lstart= -p "$pid" 2>/dev/null | sed 's/[[:space:]]*$//')
  [ -n "$reg_proc_start" ] && [ "$reg_proc_start" = "$ps_start" ] || return 0
  printf '%s' "$reg"
}

# Nearest claude ancestor of this script — the process that owns the chat and
# whose exit is the user "leaving". Walk the ppid chain; stop at the first
# process whose command basename is exactly "claude".
find_claude_pid() {
  local pid="$PPID" comm guard=0
  while [ -n "$pid" ] && [ "$pid" != "0" ] && [ "$pid" != "1" ] && [ "$guard" -lt 40 ]; do
    comm=$(ps -o comm= -p "$pid" 2>/dev/null)
    [ -n "$comm" ] || return 1
    case "${comm##*/}" in
      claude) printf '%s' "$pid"; return 0 ;;
    esac
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    guard=$((guard + 1))
  done
  return 1
}

[ $# -ge 1 ] || usage

front_mode=0
self_mode=0
gateway_mode=0
dry_run=0
model_arg=""
source_kind=claude
wait_pid=""
shell_pid=0
cwd_arg=""
while [ $# -gt 0 ]; do
  case "$1" in
    --gateway) gateway_mode=1; shift ;;
    --dry-run) dry_run=1; shift ;;
    --model) [ $# -ge 2 ] || usage; model_arg="$2"; shift 2 ;;
    --front) front_mode=1; shift ;;
    --self)  self_mode=1; shift ;;
    --cwd)   [ $# -ge 2 ] || usage; cwd_arg="$2"; shift 2 ;;
    --cwd=*) cwd_arg="${1#--cwd=}"; shift ;;
    -h|--help) usage ;;
    --*) usage ;;
    *) break ;;
  esac
done

[ $# -ge 1 ] || usage
[ "$front_mode" -eq 1 ] && [ "$self_mode" -eq 1 ] && die "--front and --self are mutually exclusive."

profile="$1"
session_id="${2:-}"

if [ -n "$cwd_arg" ]; then
  [ -d "$cwd_arg" ] || die "--cwd: no such directory: $cwd_arg"
  # `--` so a directory named like a flag still resolves; a cd that fails anyway
  # (unreadable directory) must not leave an empty cwd_arg, which would silently
  # drop the whole point of the flag and resume in the wrong project.
  cwd_arg=$(cd -- "$cwd_arg" 2>/dev/null && pwd -P) || die "--cwd: cannot enter directory: $cwd_arg"
  [ -n "$cwd_arg" ] || die "--cwd: cannot resolve directory"
  case "$cwd_arg" in *[$'\n\r']*) die "--cwd: path contains a newline" ;; esac
fi

if [ "$gateway_mode" -eq 1 ]; then
  # "main" is a real gateway login (its own OpenAI account), unlike claudeb's "main".
  if [ ! -d "$GATEWAY_DIR/$profile" ]; then
    { printf "claude-chat-switch: mode=$mode: no claudegpt account '%s' under %s\n" "$profile" "$GATEWAY_DIR"
      printf 'existing claudegpt accounts:\n'; list_gateway_accounts; } >&2
    exit 1
  fi
else
  is_reserved "$profile" && die "'$profile' is not a valid profile name (reserved; \"main\" is not a claudeb profile)."
  if [ ! -d "$PROFILES_DIR/$profile" ]; then
    { printf "claude-chat-switch: mode=$mode: no profile '%s' under %s\n" "$profile" "$PROFILES_DIR"
      printf 'existing profiles:\n'; list_profiles; } >&2
    exit 1
  fi
fi

[ "$dry_run" -eq 1 ] || command -v hs >/dev/null 2>&1 || die "'hs' (Hammerspoon CLI) not on PATH; is Hammerspoon running?"
command -v jq >/dev/null 2>&1 || die "'jq' is required for the sessions registry lookup but is not on PATH."

if [ "$self_mode" -eq 1 ]; then
  # tty->tab targeting is Apple Terminal AppleScript; elsewhere the arm would succeed
  # and only fail minutes later, after the caller already promised the switch.
  case "${TERM_PROGRAM:-}" in
    ''|Apple_Terminal) ;;
    *) die "this chat runs in ${TERM_PROGRAM}, not Apple Terminal; the switch can only be typed there." ;;
  esac
  claude_pid=$(find_claude_pid) || die "could not locate the claude process for this chat (no 'claude' ancestor)."
  tty_dev=$(ps -o tty= -p "$claude_pid" 2>/dev/null | tr -d '[:space:]')
  { [ -n "$tty_dev" ] && [ "$tty_dev" != "?" ] && [ "$tty_dev" != "??" ]; } \
    || die "this chat has no terminal (background/daemon session); nothing to type into."
  case "$tty_dev" in /dev/*) ;; *) tty_dev="/dev/$tty_dev" ;; esac
  # The chat may be running under a claudegpt wrapper that keeps the tty after the inner claude
  # exits; the resume has to wait for THAT pid, or it is typed into the wrapper's own prompt.
  classify_tab "$claude_pid" true || true
elif [ "$front_mode" -eq 1 ]; then
  front_app=$(osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null)
  [ "$front_app" = "Terminal" ] || die "Terminal is not the frontmost app (frontmost: ${front_app:-unknown})."

  tty_dev=$(osascript -e 'tell application "Terminal" to get tty of selected tab of front window' 2>/dev/null)
  [ -n "$tty_dev" ] || die "could not read the tty of the frontmost Terminal tab."

  classify_tab
fi

fresh_reason=""
if [ "$mode" = bare_shell ]; then
  [ -z "$cwd_arg" ] || die "--cwd cannot change a bare shell launch directory"
  # An id named on the command line is a conversation to reopen, shell prompt or not; only the
  # absence of one makes this tab a fresh launch. A transcript that is gone downgrades it loudly
  # rather than silently, the way a live chat's missing transcript does.
  resume_id=""
  if [ -n "$session_id" ]; then
    if find_transcript "$session_id" "" "$shell_pid"; then
      resume_id="$session_id"
      project_home "$transcript" "$resume_cwd"
    else
      fresh_reason="no transcript on disk for session $session_id"
      session_id=""
    fi
  fi
elif [ "$front_mode" -eq 1 ] || [ "$self_mode" -eq 1 ]; then
  mode=has_chat
  wait_pid=${wait_pid:-$claude_pid}
  registry=$(live_registry "$claude_pid")
  # --self is armed BY the chat it exits, usually mid-turn: without the registry
  # Hammerspoon has no idle signal and would type /exit into a running turn, where
  # it queues as composer text and the chat never quits. Refuse instead — the
  # caller can still fall back to handing over a pasteable resume line. --front is
  # a human clicking a menu item, so it keeps working without one.
  if [ "$self_mode" -eq 1 ] && [ -z "$registry" ]; then
    die "no live sessions-registry entry for claude pid $claude_pid; cannot tell when this chat is idle."
  fi

  json_cwd=""
  # An id named on the command line is another conversation than the one running in
  # this tab, so the tab's own cwd is no hint for it.
  if [ -z "$session_id" ]; then
    if [ -n "$registry" ]; then
      session_id=$(jq -r '.sessionId // ""' "$registry" 2>/dev/null)
      json_cwd=$(jq -r '.cwd // ""' "$registry" 2>/dev/null)
    fi
    if [ -z "$session_id" ]; then
      session_id=$(ps -o command= -p "$claude_pid" 2>/dev/null \
        | grep -oE -- '--resume[= ][0-9a-fA-F-]{36}' | head -1 | sed 's/^--resume[= ]//')
      json_cwd=""
    fi
    [ -n "$session_id" ] || die "cannot identify session for claude pid $claude_pid on $tty_dev (no live sessions-registry entry, no --resume in argv)."
  fi
  resume_id="$session_id"
  if find_transcript "$session_id" "$json_cwd" "$claude_pid"; then
    project_home "$transcript" "$json_cwd"
  else
    # A chat that never wrote a message has no transcript, and claude errors on
    # --resume of a nonexistent session — relaunch those as a fresh chat instead.
    resume_id=""
    fresh_reason="no transcript on disk for session $session_id"
  fi
else
  if [ -z "$session_id" ]; then
    session_id="${CLAUDE_CODE_SESSION_ID:-${CLAUDE_SESSION_ID:-}}"
  fi

  if [ -z "$session_id" ]; then
    # --cwd names the project being switched TO, so its newest chat is the one meant
    # here; falling back to $PWD's would only ever fail the transcript check below.
    slug=$(project_slug "${cwd_arg:-$PWD}")
    proj_dir="$HOME/.claude/projects/$slug"
    if [ -d "$proj_dir" ]; then
      session_file=$(ls -t "$proj_dir"/*.jsonl 2>/dev/null | head -1)
      [ -n "$session_file" ] && session_id=$(basename "$session_file" .jsonl)
    fi
  fi
fi

[ "$mode" = bare_shell ] || [ -n "$session_id" ] || die "could not determine a session id (not in \$CLAUDE_CODE_SESSION_ID and no transcript for this directory). Pass one explicitly: claude-chat-switch $profile <session-id>"

# --cwd names the project being switched TO, so one that does not hold the target's
# transcript is the wrong directory and would bring the chat back outside its own
# project. Catch it while the chat asking for the switch is still alive to report it.
if [ -n "$cwd_arg" ]; then
  target_slug=$(project_slug "$cwd_arg")
  [ -f "$HOME/.claude/projects/$target_slug/$session_id.jsonl" ] \
    || die "session $session_id has no transcript under $cwd_arg (project $target_slug) — wrong --cwd?"
fi

# Guard the charset before embedding into the hs -c lua string. Both are already
# constrained by their sources; this makes the string interpolation injection-safe.
case "$session_id" in *[!A-Za-z0-9._-]*) die "session id has unexpected characters: $session_id" ;; esac
case "$profile"    in *[!A-Za-z0-9._-]*) die "profile name has unexpected characters: $profile" ;; esac
if [ "$front_mode" -eq 1 ] || [ "$self_mode" -eq 1 ]; then
  case "$tty_dev" in *[!A-Za-z0-9/._-]*) die "tty has unexpected characters: $tty_dev" ;; esac
else
  claude_pid=$(find_claude_pid) || die "could not locate the claude process for this chat (no 'claude' ancestor)."
  mode=has_chat
  wait_pid=$claude_pid
fi

# Lua string literals, not shell: only backslash and the quote itself can break out,
# and the newline was already rejected above.
lua_str() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

# An explicit --cwd names the project being switched TO and outranks everything;
# otherwise the chat's own directory travels with it, so the resume no longer lands
# in whatever directory the shell that armed it happened to be sitting in.
case "$resume_cwd" in *[$'\n\r']*) resume_cwd="" ;; esac
[ -n "$resume_cwd" ] && [ ! -d "$resume_cwd" ] && resume_cwd=""
cd_target="$cwd_arg"
[ -n "$cd_target" ] || cd_target="$resume_cwd"

if [ "$front_mode" -eq 1 ] || [ "$self_mode" -eq 1 ]; then
  armed_id="$resume_id"
else
  armed_id="$session_id"
fi
resolver_err=$(mktemp)
launcher=$(reopen_command "$armed_id" "$profile" 2>"$resolver_err")
resolver_rc=$?
resolver_note=$(cat "$resolver_err")
rm -f "$resolver_err"
[ "$resolver_rc" -eq 0 ] && [ -n "$launcher" ] || die "cannot build launcher: $resolver_note"
[ -z "$resolver_note" ] || note "$resolver_note"
resume_cmd="$launcher"
# A bare shell launches fresh in whatever directory it is sitting in; the one exception is an id
# named on the command line, whose conversation belongs to its own project and not to this tab.
{ [ "$mode" = has_chat ] || { [ "$mode" = bare_shell ] && [ -n "$resume_id" ]; }; } &&
  [ -n "$cd_target" ] && resume_cmd="cd '${cd_target//\'/\'\\\'\'}' && $launcher"
if [ "$dry_run" -eq 1 ]; then
  printf 'mode=%s source_kind=%s claude_pid=%s wait_pid=%s shell_pid=%s tty=%s\ncwd=%s\ncommand=%s\n' \
    "$mode" "$source_kind" "$claude_pid" "$wait_pid" "$shell_pid" "${tty_dev:-}" "$cd_target" "$resume_cmd"
  exit 0
fi
opts="{mode=$(lua_str "$mode"), wait_pid=$wait_pid, cwd=$(lua_str "$cd_target"), registry=$(lua_str "${registry:-}"), freshReason=$(lua_str "$fresh_reason"), note=$(lua_str "$notes"), launcher=$(lua_str "$launcher")}"

if [ "$front_mode" -eq 1 ] || [ "$self_mode" -eq 1 ]; then
  call="ClaudeChatSwitch.switchChat(\"$profile\", \"$resume_id\", $claude_pid, \"$tty_dev\", $opts)"
else
  call="ClaudeChatSwitch.switchChat(\"$profile\", \"$session_id\", $claude_pid, nil, $opts)"
fi
hs_out=$(hs -q -c "return $call and 'armed' or 'refused'" 2>&1)
hs_rc=$?
# -q suppresses the console fan-out, but keep the last-line pick: the armed line
# echoes the cwd back — matching error words against the whole output would report a
# failed arm for any path containing "error" while the switch went ahead regardless.
hs_last=$(printf '%s\n' "$hs_out" | awk 'NF{line=$0} END{if (line) print line}')
if [ "$hs_rc" -ne 0 ] || [ "$hs_last" != "armed" ]; then
  die "could not arm Hammerspoon: ${hs_out:-unknown error}"
fi

printf 'claude-chat-switch: armed mode=%s. %s%scommand: %s\n' \
  "$mode" "${fresh_reason:+$fresh_reason; FRESH chat. }" "${notes:+$notes; }" "$resume_cmd"

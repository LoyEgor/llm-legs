#!/usr/bin/env bash
# Find an older mail letter in Apple Mail (every account: Gmail, iCloud; inbox, All Mail, spam), refreshing it meanwhile; a letter of today (--since 1d or less) gets the Gmail web read, Mail unopened: share/mail_find.py.
# usage: mail-find <words or from:addr> [--since 3h|2d] [--account <mailbox>] [--body N] [--json]
{
set -u
root=$(cd -P "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
exec python3 "$root/share/mail_find.py" "$@"
exit; }

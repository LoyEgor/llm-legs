#!/usr/bin/env python3
"""Headless Blender for stills, loops and web 3D: Cycles on the Metal GPU, OIDN denoise, AgX.

  blender-render doctor                      Blender, GPU devices, HDRIs, ffmpeg; a 10 s probe render
  blender-render logo --svg <abs> --out <abs .png|.mp4|.mov|.webm|.glb> [options]
  blender-render run <script.py> [-- args]   any bpy script, `import kit` available (share/blender)
  blender-render assets [list | fetch <polyhaven-id> [--res 2k|4k|8k]]
  blender-render encode <frames dir> --out <abs .mp4|.mov|.webm> [--fps 30]

The output extension picks the job: .png a still, .mp4 an H.264 loop, .mov ProRes 4444 with
alpha, .webm VP9 with alpha (web), .glb a Draco-compressed mesh for three.js.
Each render (doctor, logo, run) first takes a slot of the machine-wide `blender` pool: one Blender always runs
(unless a Blender outside the pool is running), another only while available memory covers its footprint
(the largest recent peak of the same script, else the median of recent runs, 9.5 GB until measured;
~/.cache/blender-render, BLENDER_RENDER_DIR); a waiter prints
`blender: waiting for a slot (N running, room R)` and raises a limiter hold.
Guide: llm-legs docs/blender.md.
"""

import argparse
import json
import os
import re
import shutil
import signal
import statistics
import subprocess
import sys
import tempfile
import time
import urllib.request

BLENDER = os.environ.get("BLENDER_BIN") or shutil.which("blender") or "/Applications/Blender.app/Contents/MacOS/Blender"
SHARE = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "share", "blender")
ASSETS = os.path.expanduser(os.environ.get("BLENDER_ASSETS", "~/.local/share/blender-assets"))
VIDEO = {".mp4", ".mov", ".webm"}
SIZE_RE = re.compile(r"^(\d{2,5})x(\d{2,5})$")
sys.path.insert(0, os.path.dirname(SHARE))
import machine_probe  # noqa: E402
import limiter_hold  # noqa: E402


class Usage(Exception):
    pass


STATE = os.path.expanduser(os.environ.get("BLENDER_RENDER_DIR", "~/.cache/blender-render"))
DEFAULT_FOOTPRINT_MB = 9728
MIN_PEAK_MB = 500  # older rows of waiters killed before Blender started measure a few MB
RECENT_RUNS = 9
SLOT_CEILING_S = 24 * 3600
# The slot's owner is this bash's $$, which execs into Blender: the slot ends with Blender, however it ends.
ADMIT = r'''
. "$1" || exit 75
dir=$2 count=$3 what=$4 log=$5 self=$6
shift 6
said=''
slot_room_mb() { "$self" slot-need "$$" "$dir" 2>/dev/null; }
waiting() { # once: what is running and how many Blenders memory admits now
  local running room=${count#*-} avail need
  [ -z "$said" ] || return 0
  said=1
  running=$(slots_held "$dir")
  if [[ "$SLOT_WHY" =~ ^available\ ([0-9]+)\ MB\ [\<]\ ([0-9]+)\ MB ]]; then
    avail=${BASH_REMATCH[1]} need=${BASH_REMATCH[2]}
    room=$((running + 1 - (need - avail + BLENDER_FOOTPRINT_MB - 1) / BLENDER_FOOTPRINT_MB))
  elif [ -n "$SLOT_WHY" ]; then
    room=$running
  fi
  [ "$room" -ge 1 ] || room=1
  printf 'blender: waiting for a slot (%s running, room %s)\n' "$running" "$room" >&3
}
exec 3>&2
slot_wait "$dir" "$count" "$SLOT_CEILING_S" blender "$what" waiting >/dev/null 2>&1 || {
  printf 'blender: no slot taken\n' >&2
  exit 75
}
exec "$@" >"$log" 2>&1 3>&-
'''


def peaks_file():
    return os.path.join(STATE, "peaks.jsonl")


def footprint_mb(what=None):
    """MB a run of `what` is expected to take: the largest of that script's recent peaks (one scene can take
    17 GB where another takes 2), else the median of the recent runs, DEFAULT_FOOTPRINT_MB until one is measured.
    Taking the largest peak of every script instead reserved ~18 GB of a 24 GB Mac and starved every run."""
    try:
        with open(peaks_file()) as handle:
            lines = handle.read().splitlines()
    except OSError:
        lines = []
    peaks = []
    for line in lines:
        try:
            row = json.loads(line)
            peaks.append((float(row["mb"]), row.get("what")))
        except (ValueError, KeyError, TypeError, AttributeError):
            pass
    peaks = [(mb, w) for mb, w in peaks if mb >= MIN_PEAK_MB]
    own = [mb for mb, w in peaks if what and w == what][-RECENT_RUNS:]
    if own:
        return round(max(own))
    recent = [mb for mb, _ in peaks][-RECENT_RUNS:]
    return round(statistics.median(recent)) if recent else DEFAULT_FOOTPRINT_MB


def outside_blender():
    """Whether a Blender runs that no slot of the pool accounts for (someone ran `blender -b` directly): then
    even the first slot waits for memory, since the guard would kill a second Blender."""
    try:
        pids = subprocess.run(["pgrep", "-x", "Blender"], capture_output=True, text=True).stdout.split()
    except OSError:
        return False
    held = {pid for _slot, pid in holders(slots_dir())}
    return any(int(pid) not in held for pid in pids if pid.isdigit())


def record_peak(mb, what):
    os.makedirs(STATE, exist_ok=True)
    with open(peaks_file(), "a") as handle:
        handle.write(json.dumps({"at": int(time.time()), "mb": round(mb), "what": what}) + "\n")
    with open(peaks_file()) as handle:
        lines = handle.read().splitlines()
    if len(lines) > 10 * RECENT_RUNS:
        with open(peaks_file() + ".tmp", "w") as handle:
            handle.write("\n".join(lines[-RECENT_RUNS:]) + "\n")
        os.replace(peaks_file() + ".tmp", peaks_file())


def slots_dir():
    return os.path.join(STATE, "slots")


def holders(directory):
    """(slot, pid) of every slot a live process holds."""
    found = []
    for slot in os.listdir(directory) if os.path.isdir(directory) else []:
        try:
            pid = int(open(os.path.join(directory, slot, "pid")).read().strip())
            os.kill(pid, 0)
        except (OSError, ValueError):
            continue
        found.append((slot, pid))
    return found


def release(directory, pid):
    """store_lock_release for the slot Blender held as `pid`: a dead owner's slot is free to the next taker
    anyway, but a recycled pid would hold it to the ceiling."""
    for slot in os.listdir(directory) if os.path.isdir(directory) else []:
        try:
            owner = open(os.path.join(directory, slot, "pid")).read().strip()
        except OSError:
            continue
        if owner == str(pid):
            shutil.rmtree(os.path.join(directory, slot), ignore_errors=True)


def slot_need(args):
    """MB one more Blender needs: its expected footprint, plus what each running one has yet to take of its own
    (a Blender just launched has not allocated yet, so available memory does not show it)."""
    expected = int(os.environ.get("BLENDER_FOOTPRINT_MB") or footprint_mb())
    need = expected
    for _slot, pid in holders(args.dir):
        if pid != args.pid:
            usage = machine_probe.proc_rusage(pid)
            need += max(0, expected - (usage[0] / 1048576 if usage else 0))
    print(round(need))
    return 0


def blender(script, args, log):
    """Run a bpy script in the background with share/blender on sys.path, once the machine-wide `blender` pool
    admits it; the log goes to `log`."""
    command = [BLENDER, "-b", "--factory-startup", "--python-exit-code", "3",
               "--python-expr", "import sys; sys.path.insert(0, %r)" % SHARE, "-P", script, "--", *args]
    what = "blender-render %s" % os.path.basename(script)
    expected = footprint_mb(what)
    memsize = machine_probe.sysctl("hw.memsize")[0]
    ceiling = max(1, int(memsize) // 1048576 // expected) if memsize.strip().isdigit() else 1
    directory = slots_dir()
    self = os.path.realpath(__file__)
    env = dict(os.environ, BLENDER_FOOTPRINT_MB=str(expected), SLOT_CEILING_S=str(SLOT_CEILING_S),
               SLOTS_CHECK_FLOOR="1" if outside_blender() else "0")
    launched = time.time() - 1
    process = subprocess.Popen(["bash", "-c", ADMIT, "_", os.path.join(os.path.dirname(SHARE), "slots.sh"),
                                directory, "1-%d" % ceiling, what, log, self, *command], env=env,
                               start_new_session=True)
    def forward(signum, _frame):
        try:
            os.killpg(process.pid, signum)
        except ProcessLookupError:
            pass

    handlers = {sig: signal.signal(sig, forward) for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT)}
    peak = 0
    try:
        while True:
            try:
                code = process.wait(timeout=1)
                break
            except subprocess.TimeoutExpired:
                usage = machine_probe.proc_rusage(process.pid)
                peak = max(peak, usage[0] if usage else 0)
    finally:
        for sig, handler in handlers.items():
            signal.signal(sig, handler)
        release(directory, process.pid)
        limiter_hold.hold_clear(os.path.join(limiter_hold.hold_dir(), "blender-%d.json" % process.pid),
                                reason="cancelled")
    started = os.path.exists(log) and os.path.getmtime(log) >= launched
    if code != 75 and peak and started:
        record_peak(peak / 1048576, what)
    text = open(log).read() if os.path.exists(log) else ""
    return code, text


def fail(log_text, code):
    tail = "\n".join(log_text.strip().splitlines()[-25:])
    print("blender-render: Blender exited %d\n%s" % (code, tail), file=sys.stderr)
    return 1


def results(log_text):
    return dict(re.findall(r"^RESULT (\w+)=(.*)$", log_text, re.MULTILINE))


def encode(frames_dir, out, fps):
    pattern = os.path.join(frames_dir, "f_%04d.png")
    ext = os.path.splitext(out)[1].lower()
    codec = {
        ".mp4": ["-c:v", "libx264", "-preset", "slow", "-crf", "14", "-pix_fmt", "yuv420p", "-movflags", "+faststart"],
        ".mov": ["-c:v", "prores_ks", "-profile:v", "4444", "-pix_fmt", "yuva444p10le"],
        ".webm": ["-c:v", "libvpx-vp9", "-b:v", "0", "-crf", "24", "-pix_fmt", "yuva420p", "-row-mt", "1"],
    }[ext]
    command = ["ffmpeg", "-y", "-loglevel", "error", "-framerate", str(fps), "-start_number", "0",
               "-i", pattern, *codec, out]
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        raise Usage("ffmpeg failed: %s" % result.stderr.strip()[-400:])
    return out


def absolute(path, flag):
    if not path or not os.path.isabs(path):
        raise Usage("%s needs an absolute path, got %r" % (flag, path))
    return path


def logo(args):
    svg = absolute(args.svg, "--svg")
    out = absolute(args.out, "--out")
    if not os.path.isfile(svg):
        raise Usage("no such SVG: %s" % svg)
    ext = os.path.splitext(out)[1].lower()
    if ext not in VIDEO | {".png", ".glb"}:
        raise Usage("--out must end in .png, .mp4, .mov, .webm or .glb")
    size = SIZE_RE.match(args.size)
    if not size:
        raise Usage("--size is WxH, got %r" % args.size)
    width, height = int(size.group(1)), int(size.group(2))
    samples = args.samples
    if args.preview:
        width, height, samples = width // 2, height // 2, min(samples, 48)
    transparent = args.transparent or ext in {".mov", ".webm"} and args.backdrop == "none"
    os.makedirs(os.path.dirname(out), exist_ok=True)
    color = args.color or single_fill(svg)
    work = tempfile.mkdtemp(prefix="blender-render-")
    kind = "glb" if ext == ".glb" else "frames" if ext in VIDEO else "still"
    frames = round(args.seconds * args.fps)
    spec = {
        "svg": svg, "out": out, "kind": kind, "size": [width, height], "samples": samples,
        "engine": args.engine, "transparent": transparent, "view": args.view, "look": args.look, "exposure": args.exposure,
        "fps": args.fps, "depth": args.depth, "bevel": args.bevel, "material": args.material,
        "color": color, "float": args.float, "backdrop": args.backdrop, "hdri": args.hdri,
        "hdri_strength": args.hdri_strength, "hdri_rotation": args.hdri_rotation,
        "lights": not args.no_lights, "key": args.key, "angle": angle(args.angle), "lens": args.lens,
        "margin": args.margin, "dof": args.dof, "save": args.save, "motion": args.motion,
        "frames": frames, "frames_dir": os.path.join(work, "frames"),
    }
    log = os.path.join(work, "blender.log")
    started = time.time()
    code, text = blender(os.path.join(SHARE, "logo_scene.py"), [json.dumps(spec)], log)
    if code != 0:
        return fail(text, code)
    found = results(text)
    if kind == "frames":
        encode(spec["frames_dir"], out, args.fps)
    shutil.rmtree(spec["frames_dir"], ignore_errors=True)
    if kind == "glb":
        print("blender-render: glb %s · %.0f KB · %.0f s" % (out, os.path.getsize(out) / 1024, time.time() - started))
    else:
        engine = "%s samples · %s" % (samples, found.get("device", "?")) if args.engine == "cycles" else "eevee"
        print("blender-render: %s %s · %dx%d · %s · %.0f s%s" % (
            kind, out, width, height, engine, time.time() - started,
            " · %d frames" % frames if kind == "frames" else ""))
    if args.save:
        print("blender-render: scene saved %s" % args.save)
    print("blender-render: log %s" % log)
    return 0


def single_fill(svg):
    """The SVG's one fill color, or None when it has several (each then keeps its own)."""
    text = open(svg, errors="replace").read()
    fills = {value.upper() for value in re.findall(r"fill\s*[:=]\s*[\"']?(#[0-9A-Fa-f]{6})\b", text)}
    return fills.pop() if len(fills) == 1 else None


def angle(text):
    if "," in text:
        azimuth, elevation = (float(part) for part in text.split(","))
        return [azimuth, elevation]
    return text


def run(args):
    script = os.path.abspath(args.script)
    if not os.path.isfile(script):
        raise Usage("no such script: %s" % script)
    work = tempfile.mkdtemp(prefix="blender-run-")
    log = os.path.join(work, "blender.log")
    code, text = blender(script, args.rest, log)
    if code != 0:
        return fail(text, code)
    for line in text.splitlines():
        if line.startswith("RESULT ") or line.startswith("Saved:"):
            print(line)
    print("blender-render: log %s" % log)
    return 0


def doctor(_args):
    ok = True
    version = subprocess.run([BLENDER, "--version"], capture_output=True, text=True).stdout.splitlines()
    print("blender   %s (%s)" % (version[0] if version else "MISSING", BLENDER))
    probe = os.path.join(tempfile.mkdtemp(prefix="blender-doctor-"), "probe.png")
    script = os.path.join(tempfile.mkdtemp(prefix="blender-doctor-"), "probe.py")
    with open(script, "w") as handle:
        handle.write(
            "import bpy, kit\n"
            "scene = kit.clear()\n"
            "kit.render_settings(scene, size=(320, 180), samples=32)\n"
            "print('RESULT devices=' + ', '.join(kit.gpu(scene)))\n"
            "bpy.ops.mesh.primitive_uv_sphere_add(radius=1, location=(0, 0, 1))\n"
            "sphere = bpy.context.active_object\n"
            "sphere.data.materials.append(kit.material('probe', 'gold'))\n"
            "kit.backdrop()\n"
            "kit.world_color(scene, '#FFFFFF', 0.8)\n"
            "kit.camera(scene, [sphere], 'hero')\n"
            "kit.render_still(scene, %r)\n" % probe)
    started = time.time()
    code, text = blender(script, (), os.path.join(os.path.dirname(script), "blender.log"))
    found = results(text)
    if code != 0 or not os.path.isfile(probe):
        ok = False
        print("render    FAILED (exit %d)\n%s" % (code, "\n".join(text.strip().splitlines()[-12:])))
    else:
        print("render    ok in %.1f s → %s" % (time.time() - started, probe))
    print("gpu       %s" % (found.get("devices") or "none — Cycles falls back to CPU"))
    ok = ok and bool(found.get("devices"))
    hdris = sorted(os.listdir(os.path.join(ASSETS, "hdri"))) if os.path.isdir(os.path.join(ASSETS, "hdri")) else []
    print("hdri      %d in %s%s" % (len(hdris), os.path.join(ASSETS, "hdri"), ": " + ", ".join(h.rsplit("_", 1)[0] for h in hdris) if hdris else ""))
    ok = ok and bool(hdris)
    print("ffmpeg    %s" % (shutil.which("ffmpeg") or "MISSING (brew install ffmpeg)"))
    ok = ok and bool(shutil.which("ffmpeg"))
    print("status    %s" % ("ok" if ok else "BROKEN"))
    return 0 if ok else 1


def assets(args):
    folder = os.path.join(ASSETS, "hdri")
    if args.action == "list":
        names = sorted(os.listdir(folder)) if os.path.isdir(folder) else []
        print("\n".join(names) or "no HDRIs; blender-render assets fetch studio_small_09")
        return 0
    if not args.id:
        raise Usage("assets fetch <polyhaven-id>")
    with urllib.request.urlopen("https://api.polyhaven.com/files/%s" % args.id, timeout=30) as response:
        files = json.load(response)
    try:
        url = files["hdri"][args.res]["hdr"]["url"]
    except KeyError:
        raise Usage("%s has no %s HDR on Poly Haven (only HDRIs are fetched here)" % (args.id, args.res))
    os.makedirs(folder, exist_ok=True)
    dest = os.path.join(folder, "%s_%s.hdr" % (args.id, args.res))
    urllib.request.urlretrieve(url, dest + ".part")
    os.replace(dest + ".part", dest)
    print("blender-render: %s (%.1f MB)" % (dest, os.path.getsize(dest) / 1e6))
    return 0


def encode_command(args):
    out = absolute(args.out, "--out")
    print("blender-render: %s" % encode(os.path.abspath(args.frames), out, args.fps))
    return 0


def main():
    parser = argparse.ArgumentParser(prog="blender-render", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("doctor").set_defaults(run=doctor)

    p = commands.add_parser("logo", help="an SVG extruded into a studio: still, loop or GLB")
    p.add_argument("--svg", required=True)
    p.add_argument("--out", required=True)
    p.add_argument("--material", default="gloss",
                   choices=["gloss", "matte", "satin", "metal", "brushed", "gold", "chrome", "copper",
                            "glass", "frosted", "clay", "emissive"])
    p.add_argument("--color", help="hex tint; default keeps each SVG fill color")
    p.add_argument("--depth", type=float, default=0.14, help="thickness, the logo is 2 m wide")
    p.add_argument("--bevel", type=float, default=0.012)
    p.add_argument("--float", type=float, default=0.0, help="lift above the floor, m")
    p.add_argument("--backdrop", default="#F2F0EA", help="hex sweep color, 'hdri' (show the HDRI) or 'none'")
    p.add_argument("--hdri", default="studio_small_09")
    p.add_argument("--hdri-strength", type=float, default=0.35)
    p.add_argument("--hdri-rotation", type=float, default=0.0)
    p.add_argument("--no-lights", action="store_true", help="HDRI only, no key/fill/rim")
    p.add_argument("--key", type=float, default=250.0, help="key light watts")
    p.add_argument("--angle", default="hero", help="front|hero|three-quarter|low|top|side or 'azimuth,elevation'")
    p.add_argument("--lens", type=float, default=70.0)
    p.add_argument("--margin", type=float, default=1.3)
    p.add_argument("--dof", type=float, help="f-stop; enables depth of field")
    p.add_argument("--size", default="2048x1152")
    p.add_argument("--samples", type=int, default=384)
    p.add_argument("--engine", default="cycles", choices=["cycles", "eevee"])
    p.add_argument("--view", choices=["neutral", "agx", "standard"], default="neutral")
    p.add_argument("--look", help="an AgX look, with --view agx (default AgX - Medium High Contrast)")
    p.add_argument("--exposure", type=float, default=0.0)
    p.add_argument("--transparent", action="store_true")
    p.add_argument("--motion", default="swing", choices=["swing", "turntable"])
    p.add_argument("--seconds", type=float, default=6.0)
    p.add_argument("--fps", type=int, default=30)
    p.add_argument("--save", help="also save the scene as this absolute .blend")
    p.add_argument("--preview", action="store_true", help="half size, 48 samples")
    p.set_defaults(run=logo)

    r = commands.add_parser("run", help="any bpy script with kit importable")
    r.add_argument("script")
    r.add_argument("rest", nargs=argparse.REMAINDER)
    r.set_defaults(run=run)

    a = commands.add_parser("assets", help="Poly Haven HDRIs")
    a.add_argument("action", choices=["list", "fetch"], nargs="?", default="list")
    a.add_argument("id", nargs="?")
    a.add_argument("--res", default="4k", choices=["1k", "2k", "4k", "8k"])
    a.set_defaults(run=assets)

    e = commands.add_parser("encode", help="a frame folder (f_0000.png…) into a video")
    e.add_argument("frames")
    e.add_argument("--out", required=True)
    e.add_argument("--fps", type=int, default=30)
    e.set_defaults(run=encode_command)

    n = commands.add_parser("slot-need")  # slot_room_mb of the blender pool, called from ADMIT
    n.add_argument("pid", type=int)
    n.add_argument("dir")
    n.set_defaults(run=slot_need)

    args = parser.parse_args()
    if getattr(args, "rest", None) and args.rest[0] == "--":
        args.rest = args.rest[1:]
    try:
        return args.run(args)
    except Usage as error:
        print("blender-render: %s" % error, file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())

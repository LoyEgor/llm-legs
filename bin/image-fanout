#!/usr/bin/env bash
{
set -euo pipefail

resolve_self() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")" && pwd
}

usage() {
  image_leg_cause "$@"
  printf 'usage: image-fanout --dest-dir <abs dir> (--prompt <text> | --jobs <abs jsonl>) [--vendors all|<vendor,...>] [--accounts all|pick] [--takes <n>] [--spare <n>] [--pack <1-4>] [--ref <abs img>]... [--edit <abs img>] [--aspect <W:H>] [--size <WxH>] [--upscale 2k] [--transparent] [--composite[=auto|x,y,w,h] | --no-composite] [--video] [--duration <s>] [--max-parallel <n>] [--dry-run]\n' >&2
  printf '  --jobs: one JSON object per line {prompt, dest, refs, edit, aspect, size, upscale, transparent, vendor, account, takes}; vendors = share/image-caps/*.json\n' >&2
  exit 2
}

usage_error() {
  printf 'image-fanout: %s\n' "$1" >&2
  exit 2
}

command -v jq >/dev/null 2>&1 || {
  printf 'image-fanout: jq is required\n' >&2
  exit 1
}

script_dir=$(resolve_self)
root=$(cd "$script_dir/.." && pwd)
. "$root/share/image-caps.sh"
. "$root/share/limiter-hold.sh"
. "$root/share/image-leg.sh"
trap image_leg_inputs_cleanup EXIT
. "$root/share/limit-hit.sh"

caps_root=${IMAGE_FANOUT_CAPS_ROOT:-$root}
bin_dir=${IMAGE_FANOUT_BIN_DIR:-$script_dir}
lister_dir=${IMAGE_FANOUT_LISTER_DIR:-$script_dir}
gap_ms=${IMAGE_FANOUT_LAUNCH_GAP_MS:-3000}
kill_wait_ms=${IMAGE_FANOUT_KILL_WAIT_MS:-5000}
lazy_spare_ms=${IMAGE_FANOUT_LAZY_SPARE_MS:-90000}
busy_retry_ms=${IMAGE_FANOUT_BUSY_RETRY_MS:-30000}
busy_giveup_ms=${IMAGE_FANOUT_BUSY_GIVEUP_MS:-900000}
lock_poll_ms=${IMAGE_FANOUT_LOCK_POLL_MS:-2000}
mem_poll_ms=${IMAGE_FANOUT_MEM_POLL_MS:-1000}
job_mb=${IMAGE_FANOUT_JOB_MB:-1200}
lock_wait=5

dest_dir=''
prompt=''
jobs_file=''
vendors_arg=all
accounts_mode=all
aspect=''
size=''
upscale=''
duration=''
edit=''
video=false
transparent=false
composite=''
dry_run=false
max_parallel=6
takes=''
spare=''
pack=''
refs=()
request_flags=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dest-dir) [ "$#" -ge 2 ] || usage; dest_dir=$2; shift 2 ;;
    --prompt) [ "$#" -ge 2 ] || usage; prompt=$2; request_flags=true; shift 2 ;;
    --jobs) [ "$#" -ge 2 ] || usage; jobs_file=$2; shift 2 ;;
    --vendors) [ "$#" -ge 2 ] || usage; vendors_arg=$2; shift 2 ;;
    --accounts) [ "$#" -ge 2 ] || usage; accounts_mode=$2; shift 2 ;;
    --ref) [ "$#" -ge 2 ] || usage; refs+=("$2"); request_flags=true; shift 2 ;;
    --region | --region=*) usage_error '--region is not supported by fan-out; use a plain composited edit: --edit <img> --ref <vector> --prompt "replace the logo at <spot>" (omit --region)' ;;
    --edit) [ "$#" -ge 2 ] || usage; edit=$2; request_flags=true; shift 2 ;;
    --aspect) [ "$#" -ge 2 ] || usage; aspect=$2; request_flags=true; shift 2 ;;
    --size) [ "$#" -ge 2 ] || usage; size=$2; request_flags=true; shift 2 ;;
    --upscale) [ "$#" -ge 2 ] || usage; upscale=$2; request_flags=true; shift 2 ;;
    --duration) [ "$#" -ge 2 ] || usage; duration=$2; shift 2 ;;
    --max-parallel) [ "$#" -ge 2 ] || usage; max_parallel=$2; shift 2 ;;
    --takes) [ "$#" -ge 2 ] || usage; takes=$2; shift 2 ;;
    --spare) [ "$#" -ge 2 ] || usage; spare=$2; shift 2 ;;
    --pack) [ "$#" -ge 2 ] || usage; pack=$2; shift 2 ;;
    --transparent) transparent=true; request_flags=true; shift ;;
    --composite | --composite=* | --no-composite) composite=$1; shift ;;
    --video) video=true; shift ;;
    --dry-run) dry_run=true; shift ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
done

[ -n "$dest_dir" ] || usage
[[ "$dest_dir" = /* ]] || usage
[ -d "$dest_dir" ] || { printf 'image-fanout: --dest-dir is not a directory: %s\n' "$dest_dir" >&2; exit 2; }
case "$accounts_mode" in all|pick) ;; *) usage ;; esac
if [ -n "$jobs_file" ]; then
  [ "$request_flags" = false ] || usage_error '--jobs carries each request: drop --prompt, --ref, --edit, --aspect, --size, --upscale and --transparent'
  [[ "$jobs_file" = /* ]] && [ -f "$jobs_file" ] || usage_error "--jobs must name an existing file by absolute path: $jobs_file"
else
  [ -n "$prompt" ] || usage
fi
if [ -n "$takes" ]; then
  [[ "$takes" =~ ^[1-9][0-9]*$ ]] && [ "$accounts_mode" = all ] || usage
fi
[[ "$max_parallel" =~ ^[1-9][0-9]*$ ]] || usage
[ -z "$spare" ] || [[ "$spare" =~ ^[0-9]+$ ]] || usage
[ -z "$pack" ] || [[ "$pack" =~ ^[1-4]$ ]] || usage
if [ -n "$duration" ] && ! [[ "$duration" =~ ^[0-9]+$ ]]; then usage; fi
[ "$video" = false ] || [ -z "$composite" ] || usage_error "$composite is image-only"
kind=image
[ "$video" = false ] || kind=video
ext=png
[ "$video" = false ] || ext=mp4

all_vendors=''
for manifest in "$caps_root"/share/image-caps/*.json; do
  [ -e "$manifest" ] || continue
  manifest=${manifest##*/}
  all_vendors="${all_vendors:+$all_vendors }${manifest%.json}"
done

resolve_vendors() { # spec -> space-separated vendors, 1 on an unknown name
  local spec=$1 vendor out=''
  if [ "$spec" = all ]; then
    printf '%s' "$all_vendors"
    return 0
  fi
  for vendor in ${spec//,/ }; do
    case " $all_vendors " in
      *" $vendor "*) out="${out:+$out }$vendor" ;;
      *) return 1 ;;
    esac
  done
  [ -n "$out" ] || return 1
  printf '%s' "$out"
}

resolve_vendors "$vendors_arg" >/dev/null || usage

# rq_refs holds newline-separated paths; rq_account is '' (every account, or the pool with takes),
# `pick`, or a pinned account name.
rq_n=0
rq_prompt=() rq_dest=() rq_refs=() rq_edit=() rq_aspect=() rq_size=() rq_transparent=() rq_vendors=() rq_account=() rq_takes=() rq_upscale=()

check_request() { # prompt aspect size edit refs-lines -> 0, or 1 with $why
  why=''
  local ref
  [ -n "$1" ] || { why='no prompt'; return 1; }
  if [ -n "$3" ] && [ -n "$2" ]; then why='pass --aspect or --size, not both'; return 1; fi
  if [ -n "$3" ] && ! [[ "$3" =~ ^[0-9]+x[0-9]+$ ]]; then why="bad size: $3"; return 1; fi
  if [ -n "$2" ] && ! [[ "$2" =~ ^([0-9]+(\.[0-9]+)?:[0-9]+(\.[0-9]+)?|auto)$ ]]; then why="bad aspect: $2"; return 1; fi
  if [ -n "$4" ] && { [[ "$4" != /* ]] || [ ! -f "$4" ]; }; then why="edit is not an absolute file: $4"; return 1; fi
  while IFS= read -r ref; do
    [ -n "$ref" ] || continue
    [[ "$ref" = /* ]] && [ -f "$ref" ] || { why="ref is not an absolute file: $ref"; return 1; }
  done <<<"$5"
  if [ "$video" = true ] && [ -z "$5" ]; then why='--video requires --ref'; return 1; fi
  return 0
}

add_request() { # prompt dest refs-lines edit aspect size transparent vendors account takes upscale
  local edit=$4 ref refs=()
  case ${11} in ""|2k) ;; *) usage_error "--upscale is 2k" ;; esac
  [ "$video" = false ] || [ -z "${11}" ] || usage_error "--upscale is image-only"
  while IFS= read -r ref; do [ -z "$ref" ] || refs+=("$ref"); done <<<"$3"
  image_leg_inputs "$root" "$edit"
  edit=$IMAGE_LEG_INPUT
  local ref_lines=''
  [ "${#refs[@]}" -eq 0 ] || ref_lines=$(printf '%s\n' "${refs[@]}")
  rq_n=$((rq_n + 1))
  rq_prompt[rq_n]=$1 rq_dest[rq_n]=$2 rq_refs[rq_n]=$ref_lines rq_edit[rq_n]=$edit rq_aspect[rq_n]=$5
  rq_size[rq_n]=$6 rq_transparent[rq_n]=$7 rq_vendors[rq_n]=$8 rq_account[rq_n]=$9 rq_takes[rq_n]=${10} rq_upscale[rq_n]=${11}
}

if [ -z "$jobs_file" ]; then
  ref_lines=''
  if [ ${#refs[@]} -gt 0 ]; then ref_lines=$(printf '%s\n' "${refs[@]}"); fi
  if ! check_request "$prompt" "$aspect" "$size" "$edit" "$ref_lines"; then
    case "$why" in
      --video*|*' not both') usage_error "$why" ;;
      *) usage ;;
    esac
  fi
  account=''
  [ "$accounts_mode" = all ] || account=pick
  add_request "$prompt" '' "$ref_lines" "$edit" "$aspect" "$size" "$transparent" "$vendors_arg" "$account" "$takes" "$upscale"
else
  line_n=0
  while IFS= read -r line || [ -n "$line" ]; do
    line_n=$((line_n + 1))
    [ -n "${line//[[:space:]]/}" ] || continue
    jq -e 'type == "object"' <<<"$line" >/dev/null 2>&1 || usage_error "--jobs line $line_n is not a JSON object"
    j_prompt=$(jq -r '.prompt // ""' <<<"$line")
    j_dest=$(jq -r '.dest // ""' <<<"$line")
    j_refs=$(jq -r '(.refs // [])[]' <<<"$line")
    j_edit=$(jq -r '.edit // ""' <<<"$line")
    j_aspect=$(jq -r '.aspect // ""' <<<"$line")
    j_upscale=$(jq -r '.upscale // ""' <<<"$line")
    j_size=$(jq -r '.size // ""' <<<"$line")
    j_transparent=$(jq -r 'if .transparent == true then "true" else "false" end' <<<"$line")
    j_vendors=$(jq -r '.vendor // "" | if type == "array" then join(",") else . end' <<<"$line")
    j_account=$(jq -r '.account // ""' <<<"$line")
    j_takes=$(jq -r '.takes // "" | tostring' <<<"$line")
    check_request "$j_prompt" "$j_aspect" "$j_size" "$j_edit" "$j_refs" || usage_error "--jobs line $line_n: $why"
    [[ "$j_dest" = /* ]] && [ -d "$(dirname "$j_dest")" ] && [[ "${j_dest##*/}" = *.* ]] ||
      usage_error "--jobs line $line_n: dest must be an absolute file path in an existing directory"
    [ -n "$j_vendors" ] || j_vendors=$vendors_arg
    resolve_vendors "$j_vendors" >/dev/null || usage_error "--jobs line $line_n: unknown vendor in $j_vendors"
    case "$j_account" in
      ''|all) j_account='' ;;
      pick) ;;
      *) [[ "$j_account" =~ ^[a-z0-9][a-z0-9-]*$ ]] || usage_error "--jobs line $line_n: bad account: $j_account" ;;
    esac
    [ -n "$j_account" ] || [ "$accounts_mode" = all ] || j_account=pick
    [ -n "$j_takes" ] || j_takes=${takes:-1}
    [[ "$j_takes" =~ ^[1-9][0-9]*$ ]] || usage_error "--jobs line $line_n: bad takes: $j_takes"
    [ "$j_account" != pick ] || [ "$j_takes" = 1 ] || usage_error "--jobs line $line_n: pick takes no takes"
    add_request "$j_prompt" "$j_dest" "$j_refs" "$j_edit" "$j_aspect" "$j_size" "$j_transparent" "$j_vendors" "$j_account" "$j_takes" "$j_upscale"
  done <"$jobs_file"
  [ "$rq_n" -gt 0 ] || usage_error "--jobs holds no job"
fi

find_bin() {
  local dir=$1 name=$2
  if [ -x "$dir/$name" ]; then printf '%s\n' "$dir/$name"; return 0; fi
  command -v "$name" 2>/dev/null
}

caps_get() { # vendor jq-filter
  image_caps_get "$caps_root" "$1" "$2"
}

# The manifest block that holds a route's limits, as route=block; the cli route's are top-level.
route_blocks='flow=flow_image web=web'
route_block() {
  local pair
  for pair in $route_blocks; do [ "${pair%%=*}" != "$1" ] || printf '%s' "${pair#*=}"; done
}
route_block_jq=''
for pair in $route_blocks; do route_block_jq+="if \$route == \"${pair%%=*}\" then .${pair#*=} el"; done
route_block_jq+='se null end'

# One manifest read: the first route's block is picked inside the same jq.
route_get() { # vendor jq-path-under-block top-level-fallback-filter [then-filter]
  caps_get "$1" "((.routes[0] // null) as \$route | $route_block_jq) as \$block
    | (if \$block != null and (\$block | $2) != null then \$block | $2 else $3 end)${4:+ | $4}"
}

# Every vendor-wide manifest fact the planner reads, one jq per vendor and run (each jq start is a fork
# of ~40 ms at load 100); one line per fact, empty where the filter yields nothing.
facts_jq="def line(f): [f] | if length == 0 then \"\" else .[0] | if type == \"string\" then . else tojson end end;
  ((.routes[0] // null) as \$route | $route_block_jq) as \$block
  | line(.video | if . == null then \"no\" else \"yes\" end),
    line(if \$block != null and (\$block | .image_policy) != null then \$block | .image_policy else null end),
    line(.scripts[\$kind] // empty),
    line(if \$block != null and (\$block | .refs_max) != null then \$block | .refs_max else .refs.max // empty end),
    line(.video.refs_max // empty),
    line(.exact_size | tostring), line(.transparent // \"\" | tostring),
    line(.aspects | if . == null then \"yes\" else \"no\" end),
    line(.routes[0] // empty),
    line(try ((if \$block != null and (\$block | .counts) != null then \$block | .counts else null end)
      | if type == \"array\" then max else 1 end) catch 1),
    line(try (.video.counts // null | if type == \"array\" then max else 1 end) catch 1),
    line(if \$block != null and (\$block | .counts_batch) != null then \$block | .counts_batch else false end)"
facts_v=() facts_out=()
facts_of() { # vendor; sets f_* globals from a cache, so never call it inside $(...) before the vendor's first read
  local i out='' found=0
  for ((i = 0; i < ${#facts_v[@]}; i++)); do
    if [ "${facts_v[i]}" = "$1" ]; then out=${facts_out[i]} found=1; break; fi
  done
  if [ "$found" = 0 ]; then
    out=$(image_caps_get "$caps_root" "$1" "$facts_jq" --arg kind "$kind")
    facts_v+=("$1")
    facts_out+=("$out")
  fi
  {
    IFS= read -r f_video; IFS= read -r f_policy; IFS= read -r f_script; IFS= read -r f_refs_max
    IFS= read -r f_video_refs_max; IFS= read -r f_exact_size; IFS= read -r f_transparent
    IFS= read -r f_aspects_null; IFS= read -r f_route0; IFS= read -r f_counts_image
    IFS= read -r f_counts_video; IFS= read -r f_counts_batch
  } <<<"$out" || :
}

reduce_ratio() { # W:H or WxH
  local spec=$1
  spec=${spec/x/:}
  awk -F: '{
    a=$1+0; b=$2+0
    if (a<=0 || b<=0) { print ""; exit }
    x=a; y=b
    while (y>0) { t=x%y; x=y; y=t }
    printf "%g:%g\n", a/x, b/x
  }' <<<"$spec"
}

nearest_int() { # want csv-or-range
  local want=$1 list=$2
  awk -v want="$want" -v list="$list" '
    BEGIN {
      if (list ~ /^[0-9]+-[0-9]+$/) {
        split(list, r, "-")
        lo=r[1]+0; hi=r[2]+0
        v=want+0
        if (v < lo) v = lo
        if (v > hi) v = hi
        print v+0
        exit
      }
      n = split(list, arr, ",")
      best = arr[1]+0; bestd = 1e99
      for (i = 1; i <= n; i++) {
        a = arr[i]+0
        d = (want+0) - a; if (d < 0) d = -d
        if (d < bestd) { bestd = d; best = a }
      }
      print best+0
    }
  '
}

aspect_list_for() { # vendor nrefs
  local vendor=$1 nrefs=$2
  if [ "$video" = true ]; then
    caps_get "$vendor" '.video.aspects // empty | if type=="array" then join(",") else empty end'
    return
  fi
  local list_kind=generate
  [ "$nrefs" -gt 0 ] && list_kind=edit
  route_get "$vendor" '.aspects' ".aspects | if . == null then empty else (.$list_kind // .generate // []) end" 'join(",")'
}

join_adapt() {
  local out='' item
  for item in "$@"; do
    [ -n "$item" ] || continue
    out="${out:+$out; }$item"
  done
  printf '%s' "$out"
}

kv_last() { # "key ..." files... -> the last value of each key, a line each in key order
  local keys=$1
  shift
  awk -v keys="$keys" '
    BEGIN { nk = split(keys, key, " ") }
    /^variant=/ { next }
    {
      n = split($0, a, /[[:space:]]+/)
      for (k = 1; k <= nk; k++) {
        prefix = key[k] "="
        for (i = 1; i <= n; i++) {
          if (index(a[i], prefix) == 1) val[k] = substr(a[i], length(prefix) + 1)
        }
        if (index($0, prefix) == 1) {
          rest = substr($0, length(prefix) + 1)
          if (rest !~ / [^ ]+=/) val[k] = rest
        }
      }
    }
    END { for (k = 1; k <= nk; k++) print val[k] }
  ' "$@"
}

# Roster rows as `name<TAB>lock file (- none named)<TAB>last used (ms, 0 unknown)<TAB>skip reason`; an empty
# reason is launchable. Only the last field may be empty: `read` with a tab IFS folds empty fields.
# A --jobs file plans every request against the same roster: one lister launch per vendor, not per request
# (each is a uv/Python start, ~1 s at load 300).
roster_v=() roster_out=()
roster_of() { # vendor -> roster_rows; sets globals, so never call it inside $(...)
  local i
  for ((i = 0; i < ${#roster_v[@]}; i++)); do
    if [ "${roster_v[i]}" = "$1" ]; then
      roster_rows=${roster_out[i]}
      return 0
    fi
  done
  roster_rows=$(list_accounts "$1") || roster_rows=''
  roster_v+=("$1")
  roster_out+=("$roster_rows")
}

list_accounts() { # vendor
  local vendor=$1 route lister out last item
  local -a argv=()
  facts_of "$vendor"
  route=$f_route0
  while IFS= read -r item; do argv+=("$item"); done < <(caps_get "$vendor" ".rosters[\"$route\"] // [] | .[]")
  [ ${#argv[@]} -gt 0 ] || return 1
  lister=$(find_bin "$lister_dir" "${argv[0]}") || return 1
  out=$("$lister" "${argv[@]:1}" 2>/dev/null) || return 1
  last=$(printf '%s\n' "$out" | tail -n 1)
  if jq -e '.accounts | type == "array"' <<<"$last" >/dev/null 2>&1; then
    jq -r --argjson now "$(date +%s)" '.accounts[] | select((.account // "") != "")
      | .account + "\t" + (.lock // "-" | if . == "" then "-" else . end) + "\t"
        + ((.last_used // 0 | tonumber? // 0) * 1000 | floor | tostring) + "\t"
        + (if .login == false then "login needed"
          elif .roster == false then "out of pool"
          elif ((.walled_until // 0) | tonumber? // 0) > $now then "walled"
          else "" end)' <<<"$last"
    return 0
  fi
  printf '%s\n' "$out" | awk '
    {
      idx = index($0, ":")
      if (idx < 1) next
      name = substr($0, 1, idx - 1)
      rest = substr($0, idx + 1)
      gsub(/[[:space:]]+$/, "", name)
      gsub(/^[[:space:]]+/, "", rest)
      if (name == "") next
      if (rest ~ /^(login needed|Not logged in)/) print name "\t-\t0\tlogin needed"
      else if (rest ~ /\(out of pool\)/) print name "\t-\t0\tout of pool"
      else print name "\t-\t0"
    }
  '
}

# Into clock_ms, never through $(...): the scheduler reads the clock ten times a second, a fork each.
now_ms() {
  if [ -n "${EPOCHREALTIME:-}" ]; then
    local t=${EPOCHREALTIME//[!0-9]/}
    clock_ms=${t:0:${#t}-3}
  else
    clock_ms="$(date +%s)000"
  fi
}

quote_cmd() {
  local out='' a
  for a in "$@"; do
    out="${out:+$out }$(printf '%q' "$a")"
  done
  printf '%s' "$out"
}

# NUL-separated: a prompt newline must not split flags.
write_argv() { # dest file, then args
  local dest=$1 a
  shift
  : >"$dest"
  for a in "$@"; do
    printf '%s\0' "$a" >>"$dest"
  done
}

# The memory guard's reader and its kill line, read from their sources; admission keeps one job's
# footprint above that line so a launch never walks the machine into the guard.
eval "$(sed -n '/^available_mb() {/,/^}/p' "$root/bin/memlogd" 2>/dev/null)"
guard_mb=$(sed -n 's/^GUARD_AVAIL_MB = \([0-9][0-9]*\).*/\1/p' "$root/bin/chat-load" 2>/dev/null | head -n 1)
mem_floor_mb=$((${guard_mb:-0} + job_mb))
mem_why=''
mem_hold=''

mem_admits() {
  local level avail
  level=$(sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null) || level=''
  # Warn (2) is this machine's resting state: on 2026-10-26 it held six fanouts 17-24 min at 5-6 GB available.
  if [[ "$level" =~ ^[0-9]+$ ]] && [ "$level" -ge 4 ]; then
    mem_why="memory pressure level $level"
    return 1
  fi
  declare -F available_mb >/dev/null || return 0
  avail=$(available_mb "$(vm_stat 2>/dev/null || true)")
  if [[ "$avail" =~ ^[0-9]+$ ]] && [ "$avail" -lt "$mem_floor_mb" ]; then
    mem_why="available ${avail} MB < ${mem_floor_mb} MB"
    return 1
  fi
  return 0
}

# perl and not setsid(1), absent on stock macOS (bin/worker-run's CHILD_GROUP_PREFIX).
CHILD_GROUP_PREFIX=()
if command -v perl >/dev/null 2>&1 && perl -MPOSIX -e 'exit 0' 2>/dev/null; then
  CHILD_GROUP_PREFIX=(perl -MPOSIX -e 'POSIX::setsid(); exec {$ARGV[0]} @ARGV or exit 127' --)
fi

group_alive() { kill -0 -- "-$1" 2>/dev/null || kill -0 "$1" 2>/dev/null; }

# Playwright starts Chrome in a session of its own, out of the unit's process group: it is found as a
# descendant by parent pid. Rows are `pid<TAB>command`, the command kept to tell a reused pid apart.
proc_tree() { # pid -> its descendants
  ps -Ao pid=,ppid=,comm= 2>/dev/null | awk -v root="$1" '
    { pid = $1; parent[pid] = $2; $1 = ""; $2 = ""; sub(/^ +/, ""); cmd[pid] = $0 }
    END {
      for (p in parent) {
        q = p; n = 0
        while ((q in parent) && q != root && q > 1 && n++ < 64) q = parent[q]
        if (q == root && p != root) print p "\t" cmd[p]
      }
    }' || :
}

tree_alive() { # tree rows -> the rows still running the same command
  local pids
  [ -n "$1" ] || return 0
  pids=$(cut -f1 <<<"$1" | paste -sd, -)
  # macOS awk refuses a multi-line -v value ("newline in string"), so the rows come through the env.
  ps -o pid=,comm= -p "$pids" 2>/dev/null | TREE_ROWS=$1 awk '
    BEGIN { n = split(ENVIRON["TREE_ROWS"], r, "\n"); for (i = 1; i <= n; i++) { split(r[i], f, "\t"); want[f[1]] = f[2] } }
    { pid = $1; $1 = ""; sub(/^ +/, ""); if (want[pid] == $0) print pid "\t" $0 }' || :
}

# The tree is recorded before the signal: a descendant whose parent dies first is reparented to
# launchd and can only be found again from this record.
signal_unit() { # unit signal: its process group and every descendant seen now or at an earlier signal
  local u=$1 pid=${u_pid[$1]} d
  u_tree[u]=$( { proc_tree "$pid"; tree_alive "${u_tree[u]:-}"; } | sort -u)
  kill -"$2" -- "-$pid" 2>/dev/null || :
  kill -"$2" "$pid" 2>/dev/null || :
  for d in $(cut -f1 <<<"${u_tree[u]}"); do
    kill -"$2" "$d" 2>/dev/null || :
  done
}

unit_alive() { # unit -> 0 while its group or a recorded descendant runs
  group_alive "${u_pid[$1]}" || [ -n "$(tree_alive "${u_tree[$1]:-}")" ]
}

jobs_dir=$(mktemp -d "${TMPDIR:-/tmp}/image-fanout.XXXXXX")
run_id="fanout-$(date -u +%Y%m%dT%H%M%SZ)-$$"
state_file=$(image_leg_work_file fanout "$dest_dir" fanout.state.json)
work_dir=${state_file%/*}
state_dirty=1

# Groups: one request x one vendor. Units: one launch (a take, or several packed into one --count).
g_n=0
g_req=() g_vendor=() g_target=() g_cancelable=() g_lazy=() g_delivered=() g_cancelled=() g_bin=() g_reason=() g_base=()
u_n=0
u_group=() u_take=() u_tid=() u_count=() u_mode=() u_pin=() u_state=() u_acct=() u_account=() u_dest=()
u_pid=() u_rc=() u_delivered=() u_notes=() u_not_before=() u_busy_since=() u_job=() u_spare=() u_row=()
u_route=() u_started=() u_kill_at=() u_tree=() u_killed=()
a_n=0
a_vendor=() a_name=() a_live=() a_excl=() a_cool=() a_launches=() a_used=() a_why=() a_lock=() a_held=()
limited_why=''
rq_tid=()

cleanup() { image_leg_inputs_cleanup; hold_clear "$mem_hold"; rm -rf "$jobs_dir"; }
trap cleanup EXIT

on_signal() {
  local u
  for ((u = 1; u <= u_n; u++)); do
    case "${u_state[u]}" in running|stopping) signal_unit "$u" TERM ;; esac
  done
  exit 143
}
trap on_signal INT TERM

account_index() { # vendor name -> account_at, its index (a_n + 1 when unknown)
  for ((account_at = 1; account_at <= a_n; account_at++)); do
    if [ "${a_vendor[account_at]}" = "$1" ] && [ "${a_name[account_at]}" = "$2" ]; then return 0; fi
  done
  return 0
}

register_account() { # vendor name [last used ms] [lock file]
  local i used=${3:-0} lock=${4:--}
  [[ "$used" =~ ^[0-9]+$ ]] || used=0
  [ "$lock" != - ] || lock=''
  account_index "$1" "$2"
  i=$account_at
  if [ "$i" -gt "$a_n" ]; then
    a_n=$i
    a_vendor[i]=$1 a_name[i]=$2 a_live[i]=0 a_excl[i]='' a_cool[i]=0 a_launches[i]=0 a_used[i]=$used
    a_lock[i]=$lock a_held[i]=0
  else
    [ "$used" -le "${a_used[i]}" ] || a_used[i]=$used
    [ -z "$lock" ] || a_lock[i]=$lock
  fi
}

add_static() { # vendor account status reason
  u_n=$((u_n + 1))
  u_group[u_n]=0 u_state[u_n]=static
  u_row[u_n]=$(printf '%s\t%s\t%s\t%s\t\t\t\t\t\t\t\t\t\t\t' "$1" "$2" "$3" "$4")
  if [ "$dry_run" = true ]; then
    printf '%s %s\t%s: %s\n' "$1" "$2" "$3" "$4"
  fi
}

add_unit() { # group take count mode pin spare
  local r=${g_req[$1]}
  u_n=$((u_n + 1))
  rq_tid[r]=$(( ${rq_tid[r]:-0} + 1 ))
  u_group[u_n]=$1 u_take[u_n]=$2 u_count[u_n]=$3 u_mode[u_n]=$4 u_pin[u_n]=$5 u_spare[u_n]=$6
  u_tid[u_n]=${rq_tid[r]} u_state[u_n]=pending u_acct[u_n]=0 u_account[u_n]=$5 u_dest[u_n]=''
  u_pid[u_n]='' u_rc[u_n]='' u_delivered[u_n]=0 u_notes[u_n]='' u_not_before[u_n]=0 u_busy_since[u_n]=''
  u_route[u_n]='' u_started[u_n]=0 u_kill_at[u_n]=0 u_tree[u_n]='' u_killed[u_n]=0
  u_job[u_n]="$run_id-$r-${rq_tid[r]}"
  mkdir -p "$jobs_dir/u$u_n"
  rq_tid[r]=$(( rq_tid[r] + $3 - 1 ))
}

unit_dest() { # unit account -> dest path
  local u=$1 account=$2 g r base
  g=${u_group[u]}
  r=${g_req[g]}
  if [ -n "${rq_dest[r]}" ]; then
    base=${g_base[g]}
  elif [ "${u_mode[u]}" = pick ]; then
    base="$dest_dir/${g_vendor[g]}-pick.$ext"
  else
    base="$dest_dir/${g_vendor[g]}-$account.$ext"
  fi
  if [ "${u_take[u]}" -gt 1 ]; then
    printf '%s-%s.%s' "${base%.*}" "${u_take[u]}" "${base##*.}"
  else
    printf '%s' "$base"
  fi
}

spare_count() { # vendor takes
  [ "$kind" = image ] || { printf 0; return; }
  if [ -n "$spare" ]; then printf '%s' "$spare"; return; fi
  caps_get "$1" ".spares.image // empty | [(.min // 0), (($2 * (.ratio // 0)) | ceil)] | max" | grep -E '^[0-9]+$' || printf 0
}

pack_size() { # vendor -> takes per launch, within the first route's counts (all of them by default)
  local max
  [ "$pack" != 1 ] || { printf 1; return; }
  facts_of "$1"
  if [ "$kind" = image ]; then max=$f_counts_image; else max=$f_counts_video; fi
  [[ "$max" =~ ^[0-9]+$ ]] && [ "$max" -ge 1 ] || max=1
  if [ -n "$pack" ] && [ "$pack" -le "$max" ]; then printf '%s' "$pack"; else printf '%s' "$max"; fi
}

# A spare rides in a primary pack only where the route renders a pack as one batch (Flow); in ChatGPT
# tabs it is one more generation the pack waits for, so there it gets its own lazy unit.
add_takes() { # group total mode pin first-spare-take
  local g=$1 total=$2 mode=$3 pin=$4 first_spare=$5 pack_n batch t c
  pack_n=$(pack_size "${g_vendor[g]}")
  facts_of "${g_vendor[g]}"
  batch=$f_counts_batch
  [ "$pack_n" -le 1 ] || g_lazy[g]=1
  for ((t = 1; t <= total; t += c)); do
    c=$pack_n
    [ $((t + c - 1)) -le "$total" ] || c=$((total - t + 1))
    [ "$batch" = true ] || [ "$t" -ge "$first_spare" ] || [ $((t + c)) -le "$first_spare" ] || c=$((first_spare - t))
    if [ "$t" -ge "$first_spare" ]; then
      add_unit "$g" "$t" "$c" "$mode" "$pin" 1
    else
      add_unit "$g" "$t" "$c" "$mode" "$pin" 0
    fi
  done
}

plan_group() { # request vendor
  local r=$1 vendor=$2 bin_name bin reason ref n_in n_used refs_max exact_size transparent_mode aspects_null
  local used_aspect='' used_size='' used_duration='' pass_transparent=false
  local adapt_refs='' adapt_aspect='' adapt_size='' adapt_duration='' adapt_trans='' size_aspect='' want_aspect list mapped
  local r_size=${rq_size[r]} r_aspect=${rq_aspect[r]} r_edit=${rq_edit[r]} mode rows accounts g n spares_n acct skip
  local every_n='' policy r_upscale=${rq_upscale[r]}
  local -a used_refs=() extra=()

  facts_of "$vendor"
  if [ "$video" = true ] && [ "$f_video" != yes ]; then
    add_static "$vendor" - skipped 'video unsupported'
    return
  fi
  if [ "$video" = false ]; then
    policy=$f_policy
    if [ "$policy" != null ] && ! jq -e --arg upscale "$r_upscale" '.upscale | index($upscale) != null' <<<"$policy" >/dev/null; then
      add_static "$vendor" - skipped "$(jq -r .refusal <<<"$policy")"
      return
    fi
    if [ -n "$r_upscale" ] && [ -z "$(route_get "$vendor" ".upscale[\"$r_upscale\"]" 'null' '. // empty')" ]; then
      add_static "$vendor" - skipped "--upscale $r_upscale unsupported"
      return
    fi
  fi
  bin_name=$f_script
  bin=''
  [ -z "$bin_name" ] || bin=$(find_bin "$bin_dir" "$bin_name") || bin=''
  if [ -z "$bin" ]; then
    add_static "$vendor" - failed "missing ${bin_name:-$kind script}"
    return
  fi

  while IFS= read -r ref; do
    [ -z "$ref" ] || used_refs+=("$ref")
  done <<<"${rq_refs[r]}"
  n_in=${#used_refs[@]}
  refs_max=$f_refs_max
  if [ "$video" = true ]; then
    list=$f_video_refs_max
    [ -z "$list" ] || refs_max=$list
  fi
  if [ -n "$r_edit" ] && [[ "$refs_max" =~ ^[1-9][0-9]*$ ]]; then refs_max=$((refs_max - 1)); fi
  if [[ "$refs_max" =~ ^[0-9]+$ ]] && [ "$n_in" -gt "$refs_max" ]; then
    used_refs=("${used_refs[@]:0:$refs_max}")
    adapt_refs="refs ${n_in}→${refs_max}"
  fi
  n_used=${#used_refs[@]}
  [ -z "$r_edit" ] || n_used=$((n_used + 1))

  exact_size=$f_exact_size transparent_mode=$f_transparent aspects_null=$f_aspects_null
  [ "$video" = false ] || aspects_null=no

  if [ "$video" = false ] && [ "${rq_transparent[r]}" = true ]; then
    pass_transparent=true
    [ -n "$transparent_mode" ] && adapt_trans="transparent $transparent_mode"
  fi

  if [ -n "$r_size" ]; then
    if [ "$exact_size" = true ] && [ "$video" = false ]; then
      used_size=$r_size
    else
      size_aspect=$(reduce_ratio "$r_size")
    fi
  fi
  want_aspect=$r_aspect
  if [ "$video" = false ] && [ -n "$r_edit" ] && [ -z "$r_aspect$r_size" ]; then
    want_aspect=$(image_caps_edit_aspect "$r_edit" "$(aspect_list_for "$vendor" "$n_used")")
  fi
  [ -n "$size_aspect" ] && want_aspect=$size_aspect

  if [ -n "$want_aspect" ]; then
    if [ "$video" = true ] && [ "$n_used" -eq 1 ]; then
      adapt_aspect="aspect ${want_aspect} dropped (image_to_video)"
    elif [ "$want_aspect" = auto ]; then
      list=$(aspect_list_for "$vendor" "$n_used")
      mapped=$(image_caps_nearest_aspect auto "$list")
      if [ "$mapped" = auto ]; then
        used_aspect=auto
      else
        adapt_aspect="aspect auto dropped (vendor default)"
      fi
    elif [ "$video" = false ] && [ "$aspects_null" = yes ]; then
      # No aspect argument in the tool: the script's own prompt builder words it, the same on every route.
      used_aspect=$want_aspect
      if [ -n "$r_size" ]; then
        adapt_size="size ${r_size}→prompt ${want_aspect}"
      else
        adapt_aspect="aspect ${want_aspect}→prompt"
      fi
    else
      list=$(aspect_list_for "$vendor" "$n_used")
      mapped=$want_aspect
      if [ -n "$list" ]; then
        mapped=$(image_caps_nearest_aspect "$want_aspect" "$list")
        [ -n "$mapped" ] || mapped=$want_aspect
      fi
      used_aspect=$mapped
      if [ -n "$r_size" ] && [ "$exact_size" != true ]; then
        adapt_size="size ${r_size}→aspect ${mapped}"
      elif [ "$mapped" != "$want_aspect" ]; then
        adapt_aspect="aspect ${want_aspect}→${mapped}"
      fi
    fi
  fi

  if [ "$video" = true ] && [ -n "$duration" ]; then
    if [ "$n_used" -le 1 ]; then
      list=$(caps_get "$vendor" '.video.durations | join(",")')
    else
      list=$(caps_get "$vendor" '.video.reference_durations // empty | join(",")')
      if [ -z "$list" ]; then
        list="$(caps_get "$vendor" '.video.reference_duration.min')-$(caps_get "$vendor" '.video.reference_duration.max')"
      fi
    fi
    used_duration=$(nearest_int "$duration" "$list")
    if [ "$used_duration" != "$duration" ]; then
      adapt_duration="duration ${duration}→${used_duration}"
    fi
  fi

  reason=$(join_adapt "$adapt_refs" "$adapt_size" "$adapt_aspect" "$adapt_duration" "$adapt_trans")

  g_n=$((g_n + 1))
  g=$g_n
  g_req[g]=$r g_vendor[g]=$vendor g_bin[g]=$bin g_reason[g]=$reason g_delivered[g]=0 g_cancelled[g]=0
  g_cancelable[g]=0 g_lazy[g]=0 g_target[g]=0 g_base[g]=''
  if [ -n "${rq_dest[r]}" ]; then
    g_base[g]=${rq_dest[r]}
    if [ "$(resolve_vendors "${rq_vendors[r]}" | wc -w | tr -d ' ')" -gt 1 ]; then
      g_base[g]="${rq_dest[r]%.*}-$vendor.${rq_dest[r]##*.}"
    fi
  fi
  if [ ${#used_refs[@]} -gt 0 ]; then
    for ref in "${used_refs[@]}"; do extra+=(--ref "$ref"); done
  fi
  [ -z "$r_edit" ] || extra+=(--edit "$r_edit")
  if [ -n "$used_aspect" ]; then extra+=(--aspect "$used_aspect"); fi
  if [ -n "$used_size" ]; then extra+=(--size "$used_size"); fi
  if [ -n "$used_duration" ]; then extra+=(--duration "$used_duration"); fi
  if [ "$pass_transparent" = true ]; then extra+=(--transparent); fi
  [ -z "$r_upscale" ] || extra+=(--upscale "$r_upscale")
  [ -z "$composite" ] || extra+=("$composite")
  extra+=(--lock-wait "$lock_wait")
  write_argv "$jobs_dir/g$g.extra" ${extra[@]+"${extra[@]}"}

  mode=every
  case "${rq_account[r]}" in
    pick) mode=pick ;;
    '') [ -z "${rq_takes[r]}" ] || mode=pool ;;
    *) mode=pinned ;;
  esac
  # Flow renders a pack as one batch and its accounts alike, so a take on every account becomes one pack of
  # that many takes: one Flow send instead of six (2026-10-15).
  if [ "$mode" = every ] && [ "$(pack_size "$vendor")" -gt 1 ] &&
    { [ "$kind" = video ] || [ "$f_counts_batch" = true ]; }; then
    mode=pool every_n=1
  fi

  case "$mode" in
    pick)
      g_target[g]=1
      add_unit "$g" 1 1 pick pick 0
      ;;
    pinned)
      # The roster only names the account's lock here: a pinned take never moves off it.
      roster_of "$vendor"
      register_account "$vendor" "${rq_account[r]}" 0 \
        "$(awk -F'\t' -v a="${rq_account[r]}" '$1 == a { print $2; exit }' <<<"$roster_rows")"
      g_target[g]=${rq_takes[r]}
      add_takes "$g" "${rq_takes[r]}" pinned "${rq_account[r]}" $((rq_takes[r] + 1))
      ;;
    every)
      roster_of "$vendor"; rows=$roster_rows
      if [ -z "$rows" ]; then
        add_static "$vendor" - skipped 'no accounts'
        return
      fi
      while IFS=$'\t' read -r acct lock used skip; do
        [ -n "$acct" ] || continue
        if [ -n "${skip:-}" ]; then
          add_static "$vendor" "$acct" skipped "$skip"
          continue
        fi
        register_account "$vendor" "$acct" "$used" "$lock"
        g_target[g]=$((g_target[g] + 1))
        add_unit "$g" 1 1 pinned "$acct" 0
      done <<<"$rows"
      ;;
    pool)
      roster_of "$vendor"; rows=$roster_rows
      accounts=$(printf '%s\n' "$rows" | awk -F'\t' '$1 != "" && $4 == "" { print $1 "\t" $3 "\t" $2 }')
      if [ -n "$every_n" ]; then
        while IFS=$'\t' read -r acct lock used skip; do
          [ -z "$acct" ] || [ -z "${skip:-}" ] || add_static "$vendor" "$acct" skipped "$skip"
        done <<<"$rows"
        [ -n "$accounts" ] || [ -z "$rows" ] || return
      fi
      if [ -z "$accounts" ]; then
        add_static "$vendor" - skipped 'no accounts'
        return
      fi
      while IFS=$'\t' read -r acct used lock; do register_account "$vendor" "$acct" "$used" "$lock"; done <<<"$accounts"
      n=${rq_takes[r]} spares_n=0
      if [ -n "$every_n" ]; then
        n=$(printf '%s\n' "$accounts" | wc -l | tr -d ' ')
        [ "$n" -le "$(pack_size "$vendor")" ] || n=$(pack_size "$vendor")
      else
        spares_n=$(spare_count "$vendor" "$n")
      fi
      g_target[g]=$n
      [ "$spares_n" -eq 0 ] || g_cancelable[g]=1
      add_takes "$g" $((n + spares_n)) pool '' $((n + 1))
      ;;
  esac
}

for ((r = 1; r <= rq_n; r++)); do
  for vendor in $(resolve_vendors "${rq_vendors[r]}"); do
    plan_group "$r" "$vendor"
  done
done

build_argv() { # unit account -> argv_args
  local u=$1 account=$2 g item accounts_mode
  g=${u_group[u]}
  accounts_mode=${u_mode[u]}
  argv_args=("${g_bin[g]}" --dest "$(unit_dest "$u" "$account")" --prompt "${rq_prompt[${g_req[g]}]}")
  {
    if [ "$accounts_mode" != pick ]; then
      argv_args+=(--account "${account%%#*}")
    fi
  }
  [ "${u_count[u]}" -le 1 ] || argv_args+=(--count "${u_count[u]}")
  [ -z "${u_route[u]}" ] || argv_args+=(--route "${u_route[u]}")
  while IFS= read -r -d '' item; do
    argv_args+=("$item")
  done <"$jobs_dir/g$g.extra"
}

if [ "$dry_run" = true ]; then
  for ((u = 1; u <= u_n; u++)); do
    [ "${u_state[u]}" = pending ] || continue
    g=${u_group[u]}
    case "${u_mode[u]}" in
      pick) key=pick account=pick ;;
      pinned) key=${u_pin[u]} account=${u_pin[u]} ;;
      pool)
        key="take${u_take[u]}"
        pool_accounts=()
        while IFS=$'\t' read -r _ name; do pool_accounts+=("$name"); done < <(
          for ((a = 1; a <= a_n; a++)); do
            [ "${a_vendor[a]}" != "${g_vendor[g]}" ] || printf '%s\t%s\n' "${a_used[a]}" "${a_name[a]}"
          done | sort -s -n -k1,1)
        account=${pool_accounts[$(( (u_take[u] - 1) / u_count[u] % ${#pool_accounts[@]} ))]}
        ;;
    esac
    build_argv "$u" "$account"
    printf '%s %s\t%s%s\n' "${g_vendor[g]}" "$key" "${g_reason[g]}" "$([ "${u_spare[u]}" = 1 ] && printf '\tspare' || true)"
    printf 'IMAGE_JOB_ID=%s %s\n' "${u_job[u]}" "$(quote_cmd "${argv_args[@]}")"
  done
fi

unit_status() { # unit -> "status<TAB>exit" for the state file; nothing = no cell
  local u=$1
  case "${u_state[u]}" in
    pending) printf 'waiting\t' ;;
    running) printf 'running\t' ;;
    cancelled|stopping) printf 'spare-cancelled\t' ;;
    final)
      if [ "${u_delivered[u]}" -gt 0 ] || [ "${u_rc[u]}" = 0 ]; then printf 'done\t0'
      elif [ "${u_rc[u]}" != 4 ]; then printf 'failed\t%s' "${u_rc[u]}"
      fi
      ;;
  esac
}

write_state() {
  local u st
  for ((u = 1; u <= u_n; u++)); do
    if [ "${u_state[u]}" = static ]; then
      awk -F'\t' '$3 == "usage_limit" { print $1 "\t" $2 "\tfailed\t3\t\t\t\t" } $3 == "failed" { print $1 "\t" $2 "\tfailed\t1\t\t\t\t" }' <<<"${u_row[u]}"
      continue
    fi
    st=$(unit_status "$u")
    [ -n "$st" ] || continue
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${g_vendor[${u_group[u]}]}" "${u_account[u]}" "$st" \
      "${u_job[u]}" "${u_dest[u]}" "${u_tid[u]}" "${g_req[${u_group[u]}]}"
  done | jq -Rn --arg kind "$kind" '{kind: $kind, cells: [inputs | split("\t")
    | {vendor: .[0], account: (if .[1] == "" then null else .[1] end), status: .[2]}
      + (if .[3] == "" then {} else {exit: (.[3] | tonumber)} end)
      + (if .[4] == "" then {} else {job: .[4], take: (.[6] | tonumber), request: (.[7] | tonumber)} end)
      + (if .[5] == "" then {} else {dest: .[5]} end)]}' \
    >"$state_file.tmp.$$" && mv -f "$state_file.tmp.$$" "$state_file"
}

# Read by the media work line (media-run's pointer names this file) while the jobs run.
refresh_state() {
  [ "$dry_run" = false ] && [ "$state_dirty" = 1 ] || return 0
  mkdir -p "$work_dir" 2>/dev/null || :
  if write_state; then state_dirty=0; else rm -f "$state_file.tmp.$$"; fi
}

add_note() { # unit note
  case "; ${u_notes[$1]}; " in
    *"; $2; "*) ;;
    *) u_notes[$1]=$(join_adapt "${u_notes[$1]}" "$2") ;;
  esac
}

variant_path() { # variant= line -> its path
  local path=${1#variant=}
  path=${path% session=*}
  printf '%s' "${path% size=*}"
}

count_delivered() { # unit -> files its dest= and variant= lines name that exist
  local dir="$jobs_dir/u$1" line path n=0
  [ -f "$dir/out" ] || { printf 0; return; }
  while IFS= read -r line; do
    case "$line" in
      dest=*) path=${line#dest=} ;;
      variant=*) path=$(variant_path "$line") ;;
      *) continue ;;
    esac
    [ -z "$path" ] || [ ! -e "$path" ] || n=$((n + 1))
  done <"$dir/out"
  printf '%s' "$n"
}

vendor_has_account() { # vendor -> 0 while any of its accounts is not excluded
  local a
  for ((a = 1; a <= a_n; a++)); do
    [ "${a_vendor[a]}" = "$1" ] && [ -z "${a_excl[a]}" ] && return 0
  done
  return 1
}

finalize() { # unit rc delivered
  local u=$1 g
  g=${u_group[u]}
  u_state[u]=final u_rc[u]=$2 u_delivered[u]=$3
  g_delivered[g]=$((g_delivered[g] + $3))
  state_dirty=1
  if [ "${g_cancelable[g]}" = 1 ] && [ "${g_cancelled[g]}" = 0 ] && [ "${g_delivered[g]}" -ge "${g_target[g]}" ]; then
    cancel_group "$g"
  fi
}

# Only image groups ever get spares (g_cancelable); the kind check keeps any later edit from
# reaching a video or audio job, which spends credits per take. A stopped unit keeps its account
# and slot until drain_stopping reaps it (KILL after kill_wait_ms).
cancel_group() { # group
  local g=$1 u
  [ "$kind" = image ] || return 0
  g_cancelled[g]=1
  for ((u = 1; u <= u_n; u++)); do
    [ "${u_group[u]}" = "$g" ] || continue
    case "${u_state[u]}" in
      pending) u_state[u]=cancelled ;;
      running)
        signal_unit "$u" TERM
        now_ms
        u_state[u]=stopping u_kill_at[u]=$((clock_ms + kill_wait_ms))
        ;;
    esac
  done
  state_dirty=1
}

drain_stopping() {
  local u rc g now
  for ((u = 1; u <= u_n; u++)); do
    [ "${u_state[u]}" = stopping ] || continue
    now_ms; now=$clock_ms
    if unit_alive "$u"; then
      if [ "$now" -ge "${u_kill_at[u]}" ]; then
        signal_unit "$u" KILL
        u_kill_at[u]=$((now + kill_wait_ms))
        # A descendant still up one grace after its KILL is not this unit's to wait for.
        [ "${u_killed[u]}" = 0 ] || u_tree[u]=''
        u_killed[u]=1
      fi
      continue
    fi
    rc=0
    wait "${u_pid[u]}" 2>/dev/null || rc=$?
    g=${u_group[u]}
    [ "${u_acct[u]}" -eq 0 ] || a_live[${u_acct[u]}]=0
    u_rc[u]=$rc
    u_delivered[u]=$(count_delivered "$u")
    if [ "${u_delivered[u]}" -gt 0 ]; then
      u_state[u]=final
      g_delivered[g]=$((g_delivered[g] + u_delivered[u]))
    else
      u_state[u]=cancelled
    fi
    state_dirty=1
  done
}

# Exit 3 is a usage limit or a flagged account; the wrapper's <VENDOR>_ACCOUNT_FLAGGED line tells them apart.
flagged_unit() { grep -Eqx '[A-Z0-9]+_ACCOUNT_FLAGGED' "$jobs_dir/u$1/err" 2>/dev/null; }

limit_cause() { # unit -> what its exit 3 was, after "after"
  if flagged_unit "$1"; then printf 'an account flag (unusual activity)'; else printf 'a usage limit'; fi
}

vendor_limited() { # vendor -> 0 when exit 3 retired one of its accounts, its cause in limited_why
  local a
  for ((a = 1; a <= a_n; a++)); do
    if [ "${a_vendor[a]}" = "$1" ] && [ "${a_excl[a]}" = 3 ]; then
      limited_why=${a_why[a]:-a usage limit}
      return 0
    fi
  done
  return 1
}

# The fan-out's last resort once a usage limit leaves a take no account on its route: the vendor's
# next route in the manifest, if that route can carry the unit's count. A pool take hands the
# account choice to the wrapper there, since that route has a roster of its own.
next_route() { # unit cause -> 0 with the unit pending on its vendor's next route
  local u=$1 vendor current next block max
  [ "$kind" = image ] || return 1
  vendor=${g_vendor[${u_group[u]}]}
  current=${u_route[u]:-$(caps_get "$vendor" '.routes[0] // empty')}
  next=$(IMAGE_LEG_ROUTE=$current image_leg_fallback_route "$caps_root" "$vendor" '' '' true)
  [ -n "$next" ] || return 1
  if [ "$next" = cli ] && [ "${IMAGE_LEG_CLI_OK:-}" != 1 ]; then
    add_note "$u" "CLI_NEEDS_CONSENT after $2: ask Egor, on his yes rerun with IMAGE_LEG_CLI_OK=1"
    return 1
  fi
  block=$(route_block "$next")
  max=$(caps_get "$vendor" "(${block:+.$block.counts // }.counts) | if type == \"array\" then max else 1 end")
  [[ "$max" =~ ^[0-9]+$ ]] && [ "${u_count[u]}" -le "$max" ] || return 1
  add_note "$u" "--route $next after $2"
  u_route[u]=$next u_state[u]=pending
  [ "${u_mode[u]}" != pool ] || u_mode[u]=pick
}

busy_gave_up() { # unit now held-accounts -> 0 once the unit has waited busy_giveup_ms on held accounts, finalized
  local u=$1 now=$2
  [ -n "${u_busy_since[u]}" ] || u_busy_since[u]=$now
  [ $((now - u_busy_since[u])) -ge "$busy_giveup_ms" ] || return 1
  limit_hit image-fanout.busy-giveup "$((busy_giveup_ms / 1000))" s skip "image unit $u: never launched while $3 stayed busy" \
    'bin/image-fanout:busy_giveup_ms=${' "$(((now - u_busy_since[u]) / 1000))"
  finalize "$u" 5 0
}

handle_exit() { # unit rc
  local u=$1 rc=$2 a delivered now g
  a=${u_acct[u]} g=${u_group[u]}
  [ "$a" -eq 0 ] || a_live[a]=0
  delivered=$(count_delivered "$u")
  now_ms; now=$clock_ms
  state_dirty=1
  if [ "$rc" -eq 5 ] && [ "$delivered" -eq 0 ]; then
    [ "$a" -eq 0 ] || a_cool[a]=$((now + busy_retry_ms))
    ! busy_gave_up "$u" "$now" "${u_account[u]}" || return 0
    add_note "$u" "requeued: ${u_account[u]} busy"
    [ "${u_mode[u]}" = pool ] || u_not_before[u]=$((now + busy_retry_ms))
    u_state[u]=pending
    return
  fi
  if { [ "$rc" -eq 3 ] || [ "$rc" -eq 4 ]; } && [ "${u_mode[u]}" = pool ] && [ "$delivered" -eq 0 ]; then
    a_excl[a]=$rc
    [ "$rc" -ne 3 ] || a_why[a]=$(limit_cause "$u")
    if vendor_has_account "${g_vendor[g]}"; then
      if [ "$rc" -eq 3 ]; then
        add_note "$u" "moved from ${u_account[u]} after ${a_why[a]}"
      else
        add_note "$u" "moved from ${u_account[u]} (pool disabled)"
      fi
      u_state[u]=pending
      return
    fi
    if vendor_limited "${g_vendor[g]}" && next_route "$u" "$limited_why"; then return; fi
  elif [ "$rc" -eq 3 ] && [ "$delivered" -eq 0 ] && next_route "$u" "$(limit_cause "$u")"; then
    return
  fi
  finalize "$u" "$rc" "$delivered"
}

reap() {
  local u rc
  for ((u = 1; u <= u_n; u++)); do
    [ "${u_state[u]}" = running ] || continue
    ! kill -0 "${u_pid[u]}" 2>/dev/null || continue
    rc=0
    wait "${u_pid[u]}" 2>/dev/null || rc=$?
    handle_exit "$u" "$rc"
  done
}

pick_account() { # unit now -> picked, the account index (0 = the script picks); 1 = none free now, 2 = none left
  local u=$1 now=$2 a best='' vendor
  picked=''
  vendor=${g_vendor[${u_group[u]}]}
  case "${u_mode[u]}" in
    pick) picked=0; return 0 ;;
    pinned)
      account_index "$vendor" "${u_pin[u]}"
      a=$account_at
      [ "${a_live[a]-}" = 0 ] && [ "${a_cool[a]}" -le "$now" ] || return 1
      picked=$a
      return 0
      ;;
  esac
  vendor_has_account "$vendor" || return 2
  for ((a = 1; a <= a_n; a++)); do
    [ "${a_vendor[a]}" = "$vendor" ] && [ -z "${a_excl[a]}" ] && [ "${a_live[a]}" = 0 ] && [ "${a_cool[a]}" -le "$now" ] || continue
    if [ -z "$best" ] || [ "${a_used[a]}" -lt "${a_used[best]}" ] ||
      { [ "${a_used[a]}" -eq "${a_used[best]}" ] && [ "${a_launches[a]}" -lt "${a_launches[best]}" ]; }; then
      best=$a
    fi
  done
  [ -n "$best" ] || return 1
  picked=$best
}

# Another run's job holds an account's lock file (the roster names it): a launch there only waits lock_wait and
# exits 5 (6,547 busy exits 2026-10-10…23). One perl flock probe, not a Python start, covers every account of
# the vendor free here; each held one is skipped for lock_poll_ms. Without perl or a named file nothing is held.
probe_locks() { # vendor now
  local a held=''
  local -a files=()
  for ((a = 1; a <= a_n; a++)); do
    [ "${a_vendor[a]}" = "$1" ] && [ -n "${a_lock[a]}" ] && [ -z "${a_excl[a]}" ] && [ "${a_live[a]}" = 0 ] &&
      [ "${a_cool[a]}" -le "$2" ] || continue
    files+=("${a_lock[a]}")
  done
  [ ${#files[@]} -gt 0 ] || return 0
  held=$(perl -MFcntl=:flock -e 'for (@ARGV) { open(my $h, "<", $_) or next; print "$_\n" unless flock($h, LOCK_EX | LOCK_NB) }' \
    "${files[@]}" 2>/dev/null) || held=''
  for ((a = 1; a <= a_n; a++)); do
    [ "${a_vendor[a]}" = "$1" ] && [ -n "${a_lock[a]}" ] || continue
    case $'\n'"$held"$'\n' in
      *$'\n'"${a_lock[a]}"$'\n'*) a_held[a]=1 a_cool[a]=$(($2 + lock_poll_ms)) ;;
      *) [ "${a_cool[a]}" -gt "$2" ] || a_held[a]=0 ;;
    esac
  done
}

# A pinned take waits on its own account's lock; a pool take only once no account of its vendor runs one of
# this fan-out's units (then it waits on its own work, not on another run).
lock_blocked() { # unit -> 0 when a held lock keeps it from launching, those accounts in held_names
  local u=$1 a vendor=${g_vendor[${u_group[$1]}]}
  held_names=''
  for ((a = 1; a <= a_n; a++)); do
    [ "${a_vendor[a]}" = "$vendor" ] && [ -z "${a_excl[a]}" ] || continue
    if [ "${u_mode[u]}" = pinned ]; then
      [ "${a_name[a]}" = "${u_pin[u]}" ] || continue
    elif [ "${a_live[a]}" != 0 ]; then
      held_names=''
      return 1
    fi
    [ "${a_held[a]}" != 1 ] || held_names="${held_names:+$held_names, }${a_name[a]}"
  done
  [ -n "$held_names" ]
}

launch_unit() { # unit account-index
  local u=$1 a=$2 account dir
  dir="$jobs_dir/u$u"
  account=pick
  [ "$a" -eq 0 ] || account=${a_name[a]}
  build_argv "$u" "$account"
  u_account[u]=$account u_acct[u]=$a
  u_dest[u]=$(unit_dest "$u" "$account")
  rm -f "$dir/out" "$dir/err"
  IMAGE_JOB_ID=${u_job[u]} IMAGE_LEG_SCHEDULER=1 ${CHILD_GROUP_PREFIX[@]+"${CHILD_GROUP_PREFIX[@]}"} "${argv_args[@]}" >"$dir/out" 2>"$dir/err" </dev/null &
  u_pid[u]=$!
  u_state[u]=running
  last_launch=$u
  now_ms
  last_launch_at=$clock_ms
  u_started[u]=$last_launch_at
  if [ "$a" -ne 0 ]; then
    a_live[a]=$u
    a_launches[a]=$((a_launches[a] + 1))
    a_used[a]=$last_launch_at
  fi
  state_dirty=1
}

# Browser starts are the memory spike: the next launch waits for the previous job's Chrome (or the gap).
last_launch=''
last_launch_at=0
gap_open() {
  local u=$last_launch
  [ -n "$u" ] && [ "$gap_ms" -gt 0 ] || return 1
  [ "${u_state[u]}" = running ] || return 1
  now_ms
  [ $((clock_ms - last_launch_at)) -lt "$gap_ms" ] || return 1
  ! proc_tree "${u_pid[u]}" | awk -F'\t' '{ n = split($2, p, "/"); if (tolower(p[n]) ~ /chrom/) up = 1 } END { exit !up }' || return 1
  return 0
}

# A packing vendor's spare launches only once its primaries ran lazy_spare_ms without delivering:
# the pack usually lands first, and a spare cancelled after sending still spends an image. Below a
# loaded pack's delivery (ChatGPT 3-pack 48-73 s, Flow 4-pack 26-37 s) the spare launched and sent
# every time, a second Flow account in the same burst.
spare_waits() { # unit now
  local u=$1 now=$2 v g
  [ "${u_spare[u]}" = 1 ] || return 1
  g=${u_group[u]}
  for ((v = 1; v <= u_n; v++)); do
    [ "${u_group[v]}" = "$g" ] && [ "${u_spare[v]}" = 0 ] && [ "${g_lazy[g]}" = 1 ] || continue
    case "${u_state[v]}" in
      pending) return 0 ;;
      running) [ $((now - u_started[v])) -ge "$lazy_spare_ms" ] || return 0 ;;
    esac
  done
  return 1
}

mem_checked_at=0
mem_holding=0
try_launch() { # -> 0 when a unit was launched; primary takes before spares
  local u now a pick_rc candidate='' cand_a='' spare_pass probed=' ' mem_wait=0
  now_ms; now=$clock_ms
  if [ "$mem_holding" = 1 ] && [ $((now - mem_checked_at)) -lt "$mem_poll_ms" ]; then mem_wait=1; fi
  for spare_pass in 0 1; do
    for ((u = 1; u <= u_n; u++)); do
      [ "${u_state[u]}" = pending ] && [ "${u_not_before[u]}" -le "$now" ] && [ "${u_spare[u]}" = "$spare_pass" ] || continue
      ! spare_waits "$u" "$now" || continue
      pick_rc=0
      pick_account "$u" "$now" || pick_rc=$?
      # Probed once a call per vendor, every free account at once: a held pick is cooled and picked again.
      if [ "$pick_rc" -eq 0 ] && [ "$mem_wait" = 0 ] && [ "$picked" -gt 0 ] && [ -n "${a_lock[picked]}" ] &&
        [[ "$probed" != *" ${a_vendor[picked]} "* ]]; then
        probed+="${a_vendor[picked]} "
        probe_locks "${a_vendor[picked]}" "$now"
        [ "${a_held[picked]}" = 0 ] || { pick_account "$u" "$now" || pick_rc=$?; }
      fi
      a=$picked
      if [ "$pick_rc" -eq 2 ]; then
        if vendor_limited "${g_vendor[${u_group[u]}]}"; then
          next_route "$u" "$limited_why" || { add_note "$u" 'no account left'; finalize "$u" 3 0; }
        else
          add_note "$u" 'no account left'
          finalize "$u" 4 0
        fi
        continue
      fi
      if [ "$pick_rc" -ne 0 ]; then
        if lock_blocked "$u"; then
          ! busy_gave_up "$u" "$now" "$held_names" || continue
          add_note "$u" 'waited: account held by another run'
        fi
        continue
      fi
      candidate=$u cand_a=$a
      break 2
    done
  done
  [ -n "$candidate" ] && [ "$mem_wait" = 0 ] || return 1
  mem_checked_at=$now
  if ! mem_admits; then
    if [ "$mem_holding" = 0 ]; then
      mem_hold=$(hold_raise image-fanout "$run_id" "$mem_why")
      printf 'image-fanout: holding launches: %s\n' "$mem_why" >&2
    fi
    mem_holding=1
    return 1
  fi
  mem_holding=0
  hold_clear "$mem_hold"
  mem_hold=''
  launch_unit "$candidate" "$cand_a"
  return 0
}

if [ "$dry_run" = false ]; then
  # The idle tick below is ~10 a second for the whole run: bash's own sleep, not a fork each.
  enable -f "${BASH%/bin/*}/lib/bash/sleep" sleep 2>/dev/null || :
  refresh_state
  while :; do
    reap
    drain_stopping
    running=0 pending=0
    for ((u = 1; u <= u_n; u++)); do
      case "${u_state[u]}" in
        running|stopping) running=$((running + 1)) ;;
        pending) pending=$((pending + 1)) ;;
      esac
    done
    [ $((running + pending)) -gt 0 ] || break
    launched=0
    if [ "$pending" -gt 0 ] && [ "$running" -lt "$max_parallel" ] && ! gap_open && try_launch; then
      launched=1
    fi
    refresh_state
    [ "$launched" = 1 ] || sleep 0.1
  done
  refresh_state
fi

ok_n=0
skipped_n=0
limit_n=0
failed_n=0
attempted_n=0
planned_n=0
stale_lines=''
glitch_lines=''

if [ "$dry_run" = true ]; then
  tsv="$jobs_dir/fanout.tsv"
else
  image_leg_work_prune "$state_file"
  mkdir -p "$work_dir"
  tsv="$work_dir/fanout.tsv"
fi

count_status() {
  case "$1" in
    ok) ok_n=$((ok_n + 1)); attempted_n=$((attempted_n + 1)) ;;
    skipped) skipped_n=$((skipped_n + 1)) ;;
    usage_limit) limit_n=$((limit_n + 1)); attempted_n=$((attempted_n + 1)) ;;
    failed) failed_n=$((failed_n + 1)); attempted_n=$((attempted_n + 1)) ;;
  esac
}

{
  printf 'vendor\taccount\tstatus\treason\tdest\tsize\tsession\tmodel\tmodel_caps\tcaps\tjob\troute\tfallback_from\tphases\tcomposite\n'
  for ((u = 1; u <= u_n; u++)); do
    if [ "${u_state[u]}" = static ]; then
      printf '%s\n' "${u_row[u]}"
      count_status "$(cut -f3 <<<"${u_row[u]}")"
      continue
    fi
    planned_n=$((planned_n + 1))
    [ "$dry_run" = false ] || continue
    g=${u_group[u]}
    vendor=${g_vendor[g]}
    account=${u_account[u]:--}
    reason=$(join_adapt "${g_reason[g]}" "${u_notes[u]}")
    dir="$jobs_dir/u$u"
    if [ "${u_state[u]}" = cancelled ]; then
      reason=$(join_adapt "$reason" "spare-cancelled after ${g_delivered[g]} of ${g_target[g]} takes delivered")
      printf '%s\t%s\tspare-cancelled\t%s\t%s\t\t\t\t\t\t%s\t\t\t\t\n' "$vendor" "$account" "$reason" "${u_dest[u]}" "${u_job[u]}"
      continue
    fi
    rc=${u_rc[u]:-1}
    combined=(/dev/null)
    [ ! -f "$dir/out" ] || combined+=("$dir/out")
    [ ! -f "$dir/err" ] || combined+=("$dir/err")
    { IFS= read -r got_dest; IFS= read -r got_size; IFS= read -r got_session; IFS= read -r got_model
      IFS= read -r got_model_caps; IFS= read -r got_caps; IFS= read -r got_account; IFS= read -r got_job
      IFS= read -r got_route; IFS= read -r got_fallback; IFS= read -r got_phases; IFS= read -r got_failed
    } < <(kv_last 'dest size session model model_caps caps account job route fallback_from phases failed' "${combined[@]}")
    got_composite=$(awk '/^composite=/ && prev !~ /^variant=/ {print substr($0, 11); exit} {prev = $0}' "${combined[@]}" |
      tr '\t' ' ')
    [ -n "$got_dest" ] || got_dest=${u_dest[u]}
    [ -n "$got_job" ] || got_job=${u_job[u]}
    [ -z "$got_account" ] || account=$got_account
    status=failed
    case "$rc" in
      0) status=ok ;;
      3) status=usage_limit ;;
      4) status=skipped ;;
    esac
    [ "${u_delivered[u]:-0}" -eq 0 ] || status=ok
    extra=''
    case "$status" in
      skipped) extra='pool disabled' ;;
      usage_limit) extra='usage limit'; ! flagged_unit "$u" || extra='account flagged (unusual activity)' ;;
      failed) extra="exit $rc"; [ "$rc" != 5 ] || extra='exit 5 (account busy)' ;;
      ok) [ -z "$got_failed" ] || extra="failed=$got_failed of ${u_count[u]}" ;;
    esac
    if [ -n "$extra" ]; then
      case "; $reason; " in
        *"; $extra; "*) ;;
        *) reason=$(join_adapt "$reason" "$extra") ;;
      esac
    fi
    if [ "$status" != ok ] && [ -s "$dir/err" ]; then
      stem=${u_dest[u]##*/}
      cp "$dir/err" "$work_dir/${stem%.*}.stderr"
      err_last=$(grep -v '^[[:space:]]*$' "$dir/err" | tail -n1 | tr '\t' ' ' | cut -c1-200)
      [ -z "$err_last" ] || reason=$(join_adapt "$reason" "$err_last")
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$vendor" "$account" "$status" "$reason" \
      "$got_dest" "$got_size" "$got_session" "$got_model" "$got_model_caps" "$got_caps" \
      "$got_job" "$got_route" "$got_fallback" "$got_phases" "$got_composite"
    count_status "$status"
    if [ -f "$dir/out" ]; then
      while IFS=$'\t' read -r line v_composite; do
        v_path=$(variant_path "$line")
        [ -e "$v_path" ] || continue
        v_size=$(sed -n 's/.* size=\([^ ]*\).*/\1/p' <<<"$line")
        v_session=$(sed -n 's/.* session=\([^ ]*\).*/\1/p' <<<"$line")
        [ -n "$v_composite" ] || v_composite=$got_composite
        printf '%s\t%s\tok\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$vendor" "$account" "$reason" \
          "$v_path" "$v_size" "$v_session" "$got_model" "$got_model_caps" "$got_caps" \
          "$got_job" "$got_route" "$got_fallback" "$got_phases" "${v_composite//$'\t'/ }"
        count_status ok
      done < <(awk '/^variant=/ {if (v != "") print v "\t"; v = $0; next}
                    v != "" {print v "\t" (/^composite=/ ? substr($0, 11) : ""); v = ""}
                    END {if (v != "") print v "\t"}' "$dir/out")
    fi
    stale_hit=''
    if grep -h -E -q '(^|[[:space:]])model_caps=stale' "${combined[@]}" 2>/dev/null; then
      stale_hit=model_caps=stale
    elif grep -h -E -q '(^|[[:space:]])caps=stale' "${combined[@]}" 2>/dev/null; then
      stale_hit=caps=stale
    fi
    if [ -n "$stale_hit" ]; then
      stale_lines="${stale_lines}STALE: ${vendor} ${account} ${stale_hit}"$'\n'
    fi
    # A video take's glitch verdict (docs/video-glitch.md) is the parent's to read, so it rides under the table.
    if [ -f "$dir/out" ] && found=$(grep -E '^(glitch|t)=' "$dir/out"); then
      glitch_lines="${glitch_lines}${found}"$'\n'
    fi
  done
} >"$tsv"

if [ "$dry_run" = false ]; then
  cat "$tsv"
  if [ -n "$stale_lines" ]; then
    printf '%s' "$stale_lines"
  fi
  printf '%s' "$glitch_lines"
fi
printf 'ok=%s skipped=%s usage_limit=%s failed=%s\n' "$ok_n" "$skipped_n" "$limit_n" "$failed_n"

if [ "$dry_run" = true ]; then
  [ "$planned_n" -gt 0 ] && exit 0
  exit 1
fi
[ "$ok_n" -gt 0 ] && exit 0
if [ "$attempted_n" -gt 0 ] && [ "$limit_n" -eq "$attempted_n" ]; then
  exit 3
fi
exit 1
exit; }

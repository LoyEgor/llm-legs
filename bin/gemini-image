#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'usage: gemini-image --dest <absolute path> --prompt <description> [--aspect <%s>] [--ref <absolute image path>]... [--transparent] [--account <profile>] [--resume <conversation-id> --account <profile>]\n' "$aspect_choices" >&2
  exit 2
}

normalized_extension() {
  local value
  value=$(printf '%s' "${1##*.}" | tr '[:upper:]' '[:lower:]')
  case "$value" in jpeg) printf 'jpg' ;; *) printf '%s' "$value" ;; esac
}

# The answer's NAME says nothing about its bytes, and a file named for the destination's own
# extension would be copied verbatim however it is encoded. Unreadable bytes fall through to a
# re-encode. Same reader in codex-image and grok-image.
actual_format() { # path
  local value
  value=$(sips -g format "$1" 2>/dev/null | awk '/format:/ {print $2; exit}')
  case "$value" in jpeg) printf 'jpg' ;; *) printf '%s' "$value" ;; esac
}

resolve_root() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}

root=$(resolve_root)
. "$root/share/image-caps.sh"
aspect_choices=$(image_caps_get "$root" gemini '.aspects.generate | join("|")')
dest=''
prompt=''
aspect=$(image_caps_get "$root" gemini '.aspects.default')
aspect_given=false
account=''
resume=''
remove_green=false
refs=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dest)
      [ "$#" -ge 2 ] || usage
      dest=$2
      shift 2
      ;;
    --prompt)
      [ "$#" -ge 2 ] || usage
      prompt=$2
      shift 2
      ;;
    --aspect)
      [ "$#" -ge 2 ] || usage
      aspect=$2
      aspect_given=true
      shift 2
      ;;
    --ref)
      [ "$#" -ge 2 ] || usage
      refs+=("$2")
      shift 2
      ;;
    --transparent)
      remove_green=true
      shift
      ;;
    --account)
      [ "$#" -ge 2 ] || usage
      account=$2
      shift 2
      ;;
    --resume)
      [ "$#" -ge 2 ] && [ -n "$2" ] || usage
      resume=$2
      shift 2
      ;;
    *) usage ;;
  esac
done

[ -n "$dest" ] && [ -n "$prompt" ] || usage
[[ "$dest" = /* ]] || usage
extension=$(normalized_extension "${dest##*/}")
# An extensionless destination — a bare trailing dot included — names no format for `magick` to
# infer, and the mismatch below would hand it one anyway.
{ [[ "${dest##*/}" = *.* ]] && [ -n "$extension" ]; } || usage
[ -d "$(dirname "$dest")" ] || usage
if [ "$remove_green" = true ] && [ "$extension" != png ]; then
  printf 'gemini-image: --transparent requires a .png destination\n' >&2
  exit 2
fi
# Unconditional because the answer's own extension is what decides the conversion and no check here
# can know it yet: a `.jpg` destination answered with a `.png` needs `magick` too. A generation is
# billed the moment it is sent, so the missing tool costs a whole image if it is found afterwards.
command -v magick >/dev/null 2>&1 || {
  printf 'gemini-image: magick is required for this output\n' >&2
  exit 1
}
ref_count=${#refs[@]}
aspect_kind=generate
[ "$ref_count" -eq 0 ] && [ -z "$resume" ] || aspect_kind=edit
# A resumed turn with no --aspect names none: the manifest default is 1:1, and sending it
# repainted a 16:9 result square (live, 2026-09-11); the conversation keeps its own ratio.
[ -z "$resume" ] || [ "$aspect_given" = true ] || aspect=''
[ -z "$aspect" ] || jq -e --arg aspect "$aspect" --arg kind "$aspect_kind" \
  '.aspects[$kind] | index($aspect) != null' "$(image_caps_file "$root" gemini)" >/dev/null || usage
ref_max=$(image_caps_get "$root" gemini '.refs.max')
[ "$ref_max" = null ] || [ "$ref_count" -le "$ref_max" ] || usage
if [ "$remove_green" = true ] && [ "$(image_caps_get "$root" gemini '.transparent')" != chroma ]; then
  printf 'gemini-image: unsupported manifest transparency mode\n' >&2
  exit 1
fi
if [ "$ref_count" -gt 0 ]; then
  for ref in "${refs[@]}"; do
    [[ "$ref" = /* ]] && [ -f "$ref" ] || usage
  done
fi
if [ -n "$account" ] && ! [[ "$account" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  usage
fi
if [ -n "$resume" ]; then
  [[ "$resume" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || usage
  if [ -z "$account" ]; then
    printf 'gemini-image: --resume requires --account from the original run\n' >&2
    exit 2
  fi
fi

base_home=$HOME
. "$root/share/image-chroma.sh"
gemini_base_home=$base_home
gemini_profiles_dir="${GEMINIB_PROFILES_DIR:-$base_home/.gemini-profiles}"
. "$root/share/gemini-accounts.sh"
. "$root/share/worker-model.sh"
. "$root/share/worker-pool.sh"
. "$root/share/worker-claims.sh"

picked=false
if [ -z "$account" ]; then
  pick_rc=0
  if command -v worker-pick >/dev/null 2>&1; then
    account=$(worker-pick --account gemini --role image 2>/dev/null) || pick_rc=$?
  else
    pick_rc=127
  fi
  if [ "$pick_rc" -eq 3 ]; then
    printf 'GEMINI_USAGE_LIMIT\n' >&2
    exit 3
  fi
  if [ "$pick_rc" -ne 0 ] || ! [[ "$account" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    account=$(worker_model_pin_first gemini 2>/dev/null || true)
    account=${account:-main}
    if ! [[ "$account" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
      account=main
    fi
    printf 'gemini-image: worker-pick unavailable; falling back to account %s\n' "$account" >&2
  else
    picked=true
  fi
fi

# Collected before the match, never piped into it: `grep -q` leaves on the first line and the
# roster writing into a closed pipe fails the whole pipeline under `pipefail`.
if ! grep -Fqx -- "$account" <<<"$(gemini_account_names)"; then
  printf 'gemini-image: unknown account: %s\n' "$account" >&2
  exit 1
fi
worker_pool_refuse_headless gemini "$account" "$(worker_model_pin_csv < <(worker_model_pins gemini))" || exit 4
if [ "$picked" = true ] && ! worker_claims_record gemini "$account"; then
  printf 'gemini-image: could not record the claim on %s\n' "$account" >&2
fi

profile_home=$(gemini_account_home "$account")
brain_dir="$profile_home/.gemini/antigravity-cli/brain"
conversations_dir="$profile_home/.gemini/antigravity-cli/conversations"
if [ -n "$resume" ] && [ ! -f "$conversations_dir/$resume.db" ]; then
  printf 'gemini-image: conversation not found in account %s\n' "$account" >&2
  exit 2
fi
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/gemini-image.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT
launch_marker="$tmp_dir/launch"
stdout_file="$tmp_dir/stdout"
log_file="$tmp_dir/agy.log"
content=$prompt
if [ "$remove_green" = true ]; then
  content=$(printf '%s' "$content" | sed 's/[[:<:]][Tt][Rr][Aa][Nn][Ss][Pp][Aa][Rr][Ee][Nn][Tt][[:>:]]//g')
  content="$content on a flat solid #00FF00 green background"
fi

if [ "$ref_count" -eq 0 ]; then
  image_paths='Omit ImagePaths.'
  if [ -n "$resume" ]; then
    image_paths='Use the last generated image from this conversation as ImagePaths; apply the edit instructions to it.'
  fi
else
  image_paths='ImagePaths:'
  for ref in "${refs[@]}"; do
    image_paths+=$'\n- '
    image_paths+="$ref"
  done
fi
# Unique per invocation: the fallback search below keys on it, and concurrent
# generations on one account share a single brain directory.
image_name="gemini_image$$_$(date +%s)"
instruction="Generate one image with this content:
$content

Call generate_image exactly once with these parameters:
ImageName: $image_name
${aspect:+AspectRatio: $aspect}
$image_paths
If that call fails with a quota error, do NOT wait or retry: reply with the single word QUOTA.
Reply with ONLY the absolute path of the generated file on the last line."

# Backdated a second: -newer misses files that land in the marker's own mtime quantum.
: >"$launch_marker"
touch -A -01 "$launch_marker" 2>/dev/null || true
generation_rc=0
resume_args=()
if [ -n "$resume" ]; then
  resume_args+=("$(image_caps_get "$root" gemini '.resume.flag')" "$resume")
fi
geminib profile "$account" --model gemini-3.6-flash-low --print-timeout 180s \
  ${resume_args[@]+"${resume_args[@]}"} --output-format stream-json \
  --dangerously-skip-permissions --log-file "$log_file" --print "$instruction" \
  >"$stdout_file" 2>"$tmp_dir/stderr" || generation_rc=$?
events_file="$tmp_dir/events.json"
jq -Rn '[inputs | fromjson? | select(type == "object")]' "$stdout_file" >"$events_file"
session=$(jq -r '([.[] | select(.event == "result") | .result.conversation_id // empty] | last) //
  ([.[] | select(.event == "init") | .conversation_id // empty] | last) // "none"' "$events_file")
response=$(jq -r '[.[] | select(.event == "result") | .result.response // empty] | last // ""' "$events_file")
jq -r '.[] | (.result.error // empty), (.step_update.tool_info.error // empty) |
  .. | strings' "$events_file" >"$tmp_dir/errors"
# The image model has its own per-account quota, invisible in the chat-model quota table.
if [ "$generation_rc" -eq 3 ] || [ "$(printf '%s\n' "$response" | tail -n 1 | tr -d '\r')" = QUOTA ] ||
   grep -Eq '^QUOTA[[:space:]]*$' "$stdout_file" ||
   grep -Eqi 'GEMINI_USAGE_LIMIT|RESOURCE_EXHAUSTED|Individual quota reached|usage limit|quota exceeded|image generation quota.*exceeded|rate limit' "$tmp_dir/errors"; then
  printf 'GEMINI_USAGE_LIMIT\n' >&2
  exit 3
fi
if [ "$generation_rc" -ne 0 ]; then
  if grep -Eqi 'GEMINI_USAGE_LIMIT|RESOURCE_EXHAUSTED|Individual quota reached|usage limit|quota exceeded|image generation quota.*exceeded|rate limit' \
      "$stdout_file" "$log_file" "$tmp_dir/stderr" 2>/dev/null; then
    printf 'GEMINI_USAGE_LIMIT\n' >&2
    exit 3
  fi
  if grep -Eqi 'out of the worker pool|treating every account as out of the pool' \
      "$stdout_file" "$log_file" "$tmp_dir/stderr" 2>/dev/null; then
    printf 'gemini-image: account refused by the worker pool\n' >&2
    exit 4
  fi
  printf 'gemini-image: generation failed\n' >&2
  tail -n 20 "$tmp_dir/stderr" >&2
  exit 1
fi

generated=''
while IFS= read -r candidate; do
  if [[ "$candidate" = /* ]] && [ -f "$candidate" ] && [ ! "$candidate" -ot "$launch_marker" ]; then
    generated=$candidate
  fi
done < <(jq -r '.[] | select(.event == "step_update") | .step_update |
  select(.state == "DONE" and .tool_name == "generate_image") | .tool_info.output // empty |
  select(type == "string") | split("\n")[] |
  select(startswith("Generated image is saved at ")) | ltrimstr("Generated image is saved at ") | rtrimstr(".")' "$events_file")
[ -n "$generated" ] || generated=$(printf '%s\n' "$response" | tail -n 1 | tr -d '\r')
if [[ "$generated" != /* ]] || [ ! -f "$generated" ] || [ "$generated" -ot "$launch_marker" ]; then
  generated=''
fi
if [ -z "$generated" ] && [ -d "$brain_dir" ]; then
  while IFS= read -r candidate; do
    if [ -z "$generated" ] || [ "$candidate" -nt "$generated" ]; then
      generated=$candidate
    fi
  done < <(find "$brain_dir" -type f -iname "${image_name}*" \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) \
    -newer "$launch_marker" -print 2>/dev/null)
fi
if [ -z "$generated" ]; then
  printf 'gemini-image: generated file not found\n' >&2
  tail -n 20 "$stdout_file" >&2
  exit 1
fi

if [ "$remove_green" = true ]; then
  chroma_key_to_png "$generated" "$tmp_dir" "$dest"
elif [ "$extension" != "$(actual_format "$generated")" ]; then
  magick "$generated" "$dest"
else
  cp "$generated" "$dest"
fi

sips_output=$(sips -g pixelWidth -g pixelHeight -g format "$dest")
width=$(awk '/pixelWidth:/ {print $2; exit}' <<<"$sips_output")
height=$(awk '/pixelHeight:/ {print $2; exit}' <<<"$sips_output")
format=$(awk '/format:/ {print $2; exit}' <<<"$sips_output")
[ -n "$width" ] && [ -n "$height" ] && [ -n "$format" ] || {
  printf 'gemini-image: could not inspect output\n' >&2
  exit 1
}
printf 'dest=%s\nsize=%sx%s\nformat=%s\naccount=%s\n' "$dest" "$width" "$height" "$format" "$account"
printf 'session=%s\n' "$session"
observed_model=''
# The stream's init.model is the chat model. Image provenance lives in the saved tool step.
if [[ "$session" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] && [ -f "$conversations_dir/$session.db" ] && command -v python3 >/dev/null 2>&1; then
  observed_model=$(python3 - "$conversations_dir/$session.db" "$generated" <<'PY' || true
import pathlib
import sqlite3
import sys

def varint(data, offset):
    value = 0
    for shift in range(0, 70, 7):
        byte = data[offset]
        offset += 1
        value |= (byte & 127) << shift
        if not byte & 128:
            return value, offset
    raise ValueError("invalid varint")

def fields(data):
    offset = 0
    while offset < len(data):
        tag, offset = varint(data, offset)
        wire = tag & 7
        if wire == 0:
            _, offset = varint(data, offset)
        elif wire in (1, 5):
            offset += 8 if wire == 1 else 4
        elif wire == 2:
            length, offset = varint(data, offset)
            end = offset + length
            if end > len(data):
                raise ValueError("truncated field")
            yield tag >> 3, data[offset:end]
            offset = end
        else:
            raise ValueError("unsupported wire type")

def image_model(data, uri, depth=0):
    if depth > 10:
        return None
    try:
        for number, value in fields(data):
            if number == 104:
                image = dict(fields(value))
                media = dict(fields(image.get(6, b"")))
                if media.get(5) == uri:
                    return image.get(5, b"").decode()
            found = image_model(value, uri, depth + 1)
            if found:
                return found
    except (ValueError, IndexError, UnicodeError):
        pass
    return None

try:
    uri = ("file://" + sys.argv[2]).encode()
    with sqlite3.connect(pathlib.Path(sys.argv[1]).as_uri() + "?mode=ro", uri=True) as db:
        for (payload,) in db.execute("SELECT step_payload FROM steps ORDER BY idx DESC"):
            if payload and uri in payload:
                model = image_model(payload, uri)
                if model and all(c.isalnum() or c in "-._" for c in model):
                    print(model)
                    break
except (sqlite3.Error, OSError):
    pass
PY
  )
fi
image_caps_model_check "$root" gemini image "$observed_model"
image_caps_check "$root" gemini "${AGY_BIN:-$base_home/.local/bin/agy}"

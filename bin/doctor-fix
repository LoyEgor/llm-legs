#!/usr/bin/env bash
set -u

resolve_script() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")" && printf '%s/%s\n' "$PWD" "$(basename "$source")"
}

script_path=$(resolve_script)
repo_root=$(cd "$(dirname "$script_path")/.." && pwd)
runs_dir="${DOCTORS_DIR:-$HOME/.cache/doctors}/runs"
projects_dir="${DOCTOR_FIX_PROJECTS:-/Volumes/Work/Projects}"
events_dir="${VENDOR_CLI_UPDATE_STATE_DIR:-$HOME/.cache/vendor-cli-update}/events"
DOC_MAX_AGE_S=7200
OPEN_RUN_MAX_S=43200
VERDICTS=' fixed ruled-out weather blind-spot handoff '
. "$repo_root/share/chat-open.sh"
. "$repo_root/share/store-lock.sh"
. "$repo_root/share/test-scope.sh"
. "$repo_root/share/night-worktree.sh"

JQ_EPOCH='def epoch: if type == "number" then . elif type == "string" then
  ((capture("^(?<d>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})([.][0-9]+)?(?<z>Z|(?<s>[+-])(?<h>[0-9]{2}):?(?<m>[0-9]{2}))$")
    | (.d + "Z" | fromdateiso8601) - (if .z == "Z" then 0
        else ((.h | tonumber) * 3600 + (.m | tonumber) * 60) * (if .s == "-" then -1 else 1 end) end)) // null)
  else null end;'
JQ_OPEN='def open: .closed_at == null and .abandoned_at == null and .failed_at == null;'
JQ_AREA='def area: .area // (if .doctor == "updater" then "release" else "all" end);'
JQ_COUNTS='"\(.problems | length) problems" + (if (.quiet // []) | length > 0 then " · \(.quiet | length) known, quiet" else "" end)'
TEST_SPEED_RULES=' test_long_pole test_daily_cost test_slow suites_at_once '
JQ_HAS_RULES='any(.problems[]; .rule as $r | $rules | split(" ") | index($r))'

die() { printf 'doctor-fix: %s\n' "$*" >&2; exit 1; }
stamp() { date -u +%Y-%m-%dT%H:%M:%SZ; }

pending_id=''
on_exit() {
  store_lock_release "$runs_dir/.lock"
  if [ -n "$pending_id" ]; then
    locked fail_run "$pending_id" "the launcher exited before the run opened" >/dev/null 2>&1
  fi
}
trap on_exit EXIT

locked() { # command... -> runs it under the runs-dir lock
  local status
  mkdir -p "$runs_dir" && store_lock_acquire "$runs_dir/.lock" || { printf 'doctor-fix: cannot lock %s\n' "$runs_dir" >&2; return 1; }
  "$@"
  status=$?
  store_lock_release "$runs_dir/.lock"
  return "$status"
}

doctor_env() { # doctor -> the env var of its state dir
  case $1 in llm) printf 'LLM_DOCTOR_DIR' ;; harness) printf 'HARNESS_DOCTOR_DIR' ;; updater) printf 'UPDATER_DOCTOR_DIR' ;; code) printf 'CODE_DOCTOR_DIR' ;; *) return 1 ;; esac
}

doc_path() { # doctor -> its latest.json
  local var
  var=$(doctor_env "$1") || return 1
  printf '%s/latest.json\n' "${!var:-$HOME/.cache/$1-doctor}"
}

doc_judge() { jq -r '.judge // ""' "${2:-$(doc_path "$1")}" 2>/dev/null; }

record_file() { printf '%s/%s.json\n' "$runs_dir" "$1"; }

record_set() { # id jq-filter args...
  local file filter=$2 tmp
  file=$(record_file "$1")
  shift 2
  tmp=$(mktemp "$runs_dir/.run.XXXXXX") || return 1
  jq "$@" "$filter" "$file" >"$tmp" && mv -f "$tmp" "$file" || { rm -f "$tmp"; return 1; }
}

run_state() { # id -> closed|abandoned|failed|open|pending
  jq -r "$(run_status)" "$(record_file "$1")"
}

fail_run() { # id note (locked)
  [ "$(run_state "$1")" = pending ] || [ "$(run_state "$1")" = open ] || return 0
  record_set "$1" '.failed_at = $t | .note = $n' --arg t "$(stamp)" --arg n "$2"
}

new_record() { # doctor area night (locked) -> id
  local id file tmp hex
  while :; do
    printf -v hex '%04x' "$RANDOM"
    id="$1-$2-$(date -u +%Y%m%dT%H%M%SZ)-$hex"
    file=$(record_file "$id")
    (set -C && : >"$file") 2>/dev/null && break
  done
  tmp=$(mktemp "$runs_dir/.run.XXXXXX") || { rm -f "$file"; return 1; }
  jq -n --arg id "$id" --arg doctor "$1" --arg area "$2" --arg night "$3" --arg t "$(stamp)" \
    '{id: $id, doctor: $doctor, area: $area, night: (if $night == "" then null else $night end), created_at: $t,
      launched_at: null, closed_at: null, abandoned_at: null, failed_at: null, account: null, session: null,
      command: null, branch: null, worktrees: [], judge_at_launch: null, judge_at_close: null,
      problems: [], quiet: [], decisions: [], note: null}' >"$tmp" && mv -f "$tmp" "$file" || { rm -f "$tmp" "$file"; return 1; }
  printf '%s\n' "$id"
}

all_records() { # -> every record as one JSON array, newest first
  local files=()
  [ -d "$runs_dir" ] && files=("$runs_dir"/*.json)
  [ -e "${files[0]:-}" ] || { printf '[]\n'; return 0; }
  jq -s 'sort_by(.created_at, .id) | reverse' "${files[@]}"
}

PY='
import glob, importlib.machinery, importlib.util, json, os, re, subprocess, sys

ROOT, PROJECTS, RUNS, HOME, DOCS = (os.environ["DF_" + k] for k in ("ROOT", "PROJECTS", "RUNS", "HOME", "DOCS"))
sys.path.insert(0, os.path.join(ROOT, "share"))
from report_frame import fit
from fix_commit import FIX_KEYS, fix_record_faults
DOCTORS = ("llm", "harness", "updater", "code")
HOOK_AREAS = ("Hooks", "Hook waits")
LLM_ENTRIES = {"reviewers": ("review-bench/bin/review-bench",), "workers": ("llm-legs/bin/worker-run",),
               "light": ("llm-legs/bin/light-research",), "image": ("llm-legs/share/image-leg.sh",),
               "debt": ("llm-legs/bin/llm-doctor",)}
with open(os.path.join(ROOT, "share", "doctor-areas.json")) as _areas:
    _vocabulary = json.load(_areas)
OWN_AREA, WHOLE_AREA = _vocabulary["own"], _vocabulary.get("whole") or {}
BROWSER_ENGINE = ("llm-legs/share/gemini_web.py", "llm-legs/share/gemini_music.py", "llm-legs/share/flow_music.py",
                  "llm-legs/share/chatgpt_web.py")
MENU_BUILDERS = {"automation": ("hammerspoon/automation_menu.lua", "llm-legs/hammerspoon/llm-limits.lua"),
                 "llm-limits": ("llm-legs/hammerspoon/llm-limits.lua",)}
SPEED_FILES = {"background/statusline": ("llm-legs/bin/statusline.sh",),
               "time/slot": ("llm-legs/share/slots.sh", "llm-legs/bin/worker-run"),
               "time/suite_wait": ("llm-legs/share/run-suites.sh", "llm-legs/share/slots.sh"),
               "time/suite_run": ("llm-legs/share/run-suites.sh",), "time/retries": ("llm-legs/bin/worker-run",),
               "time/locks": ("llm-legs/share/store-lock.sh",),
               "time/workers-active": ("llm-legs/bin/worker-run", "llm-legs/share/run-suites.sh")}
KNOBS = (
    ("settings model/effort/thinking", r"(^|/)settings(\.[\w-]+)?\.json$",
     r"\"(model|effortLevel|alwaysThinkingEnabled|MAX_THINKING_TOKENS|modelSettings)\"\s*:"),
    ("worker-model", r"(^|/)worker-model$", r"\S"),
    ("share/worker-model.sh table", r"(^|/)share/worker-model\.sh$", r"^(?!\s*#).*\b(low|medium|high|xhigh|max)\b"),
    ("share/worker-policy.md effort", r"(^|/)share/worker-policy\.md$", r"(?i)\beffort|^\|.*\b(low|medium|high|xhigh|max)\b"),
    ("review-bench tier effort/rater", r"(^|/)share/rbench/catalog\.py$",
     r"\"(low|medium|high|xhigh|max)\"|ROSTER|RATER|EFFORT|^\s*\(\"[\w.-]+\",\s*\d+\)"),
    ("agent model frontmatter", r"(^|/)agents/[^/]+\.md$", r"^(model|effort):"),
    ("claudeb default model", r"(^|/)(bin/claudeb|share/chat-open\.sh)$", r"CLAUDEB_CLAUDE_MODEL|--model|--effort"),
    ("brief-template EFFORT/MODEL", r"", r"^\s*(printf\s+[\x27\"])?(EFFORT|MODEL):\s*\S"),
)
UPDATER_MACHINERY = {rule: "llm-legs/bin/vendor-cli-update" for rule in ("pass-stale", "pass-failed", "cli-behind", "client-too-old")}
UPDATER_MACHINERY.update({rule: "llm-legs/bin/vendor-fingerprint" for rule in ("probe-broken", "catalog-missing", "event-stuck", "foreign-client")})
WIDTH = 200


def load(path, default=None):
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return default


def ledger_path(doctor):
    module = doctor_module(doctor)
    return module.ledger_path() if module else ""


def doctor_script(doctor):
    return os.path.join(ROOT, "bin", doctor + "-doctor")


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", str(text).lower()).strip("-") or "none"


def norm(path):
    path = os.path.realpath(os.path.expanduser(path))
    return re.sub(r"/\.claude/worktrees/[^/]+(?=/)", "", path, count=1)


MODULES = {}


def doctor_module(doctor):
    if doctor not in MODULES:
        try:
            loader = importlib.machinery.SourceFileLoader(doctor + "_doctor", doctor_script(doctor))
            module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
            loader.exec_module(module)
        except Exception:
            module = None
        MODULES[doctor] = module
    return MODULES[doctor]


def repos_dir(doctor):
    module = doctor_module(doctor)
    return module.repos_dir() if module and hasattr(module, "repos_dir") else PROJECTS


def rule_at(doctor, rule):
    try:
        with open(doctor_script(doctor)) as handle:
            for number, line in enumerate(handle, 1):
                if "\"%s\"" % rule in line:
                    return "bin/%s-doctor:%d" % (doctor, number)
    except OSError:
        pass
    return None


def dicts(value):
    return [item for item in value if isinstance(item, dict)] if isinstance(value, list) else []


def strings(value):
    return [item for item in value if isinstance(item, str)] if isinstance(value, list) else []


def snapshot(doctor, doc_file, night=None):
    doc, ledger = load(doc_file, {}), load(ledger_path(doctor), {}) or {}
    if doctor == "code" and doc.get("status") != "error":
        module = doctor_module("code")
        taken = [p.get("id") for path in glob.glob(os.path.join(RUNS, "*.json")) for run in [load(path, {})]
                 if night and isinstance(run, dict) and run.get("doctor") == "code" and run.get("night") == night
                 and run.get("launched_at") for p in run.get("problems") or () if isinstance(p, dict)]
        ranked = [p for p in module.night_snapshot(doc.get("problems") or [], night) if p.get("id") not in taken]
        doc["problems"] = ranked[:max(0, module.queue_k(module.accounting_summary(module.load_ledger())) - len(taken))]
    if doc.get("status") == "error":
        doc["problems"] = [{"id": "collector:error", "rule": "collector", "state": "new",
                            "fact": "the collector failed: %s" % ((doc.get("self") or {}).get("error") or "no error text")}]
    rows = {r.get("id"): r for r in ledger.get("rows") or () if isinstance(r, dict)}
    owners = ledger.get("owners") or {}
    sections, hooks = {}, []
    module = doctor_module("harness") if doctor == "harness" else None
    if module:
        for part in doc.get("sections") or ():
            try:
                rules = {v["rule"] for v in module.all_verdicts([part])}
            except Exception:
                rules = set()
            for rule in rules:
                sections.setdefault(rule, part.get("name"))
        try:
            hooks = [(module.hook_ident(h["command"]), module.hook_script(h["command"]), h["event"])
                     for h in module.settings_hooks()]
        except Exception:
            hooks = []
    problems = list(doc.get("problems") or ())
    if doc.get("status") != "error" and doctor != "code":
        seen = {p.get("ledger") for p in problems} | {str(p.get("id"))[7:] for p in problems if str(p.get("id")).startswith("ledger:")}
        problems += [{"id": r["id"], "rule": (r.get("match") if isinstance(r.get("match"), dict) else {}).get("rule"),
                      "ledger": r["id"], "state": "quiet", "fact": r.get("title")}
                     for r in rows.values() if r.get("status") == "open" and r.get("id") and r["id"] not in seen]
    kept, watched, opportunities = [], [], {}
    chosen = strings((doc.get("speed") or {}).get("selection")) if doctor == "harness" else []
    for problem in problems:
        pid, rule, state = problem.get("id"), problem.get("rule"), problem.get("state")
        if rule == "debt-handoff":
            continue
        row = rows.get(problem.get("ledger")) or (rows.get(pid[7:]) if str(pid).startswith("ledger:") else None)
        files, what = [], rule
        if doctor == "llm":
            block = (row or {}).get("block")
            if not isinstance(block, str) or row and isinstance(row.get("match"), dict) and "health" in row["match"]:
                block = None
            match = re.match(r"^leg-(?:failure|escape):([a-z]+)/", pid)
            block = block or (match and match.group(1))
            for part in doc.get("blocks") or ():
                classes = [c.get("class") for c in ((part.get("machinery") or {}).get("classes") or ())]
                if not block and (pid in [p.get("id") for p in part.get("problems") or ()]
                                  or (pid.startswith("machinery:") and pid[10:] in classes)):
                    block = part.get("block")
            match = (row or {}).get("match")
            match = match if isinstance(match, dict) else {}
            health = match.get("health") or next((part.get("name") for part in dicts(doc.get("health"))
                                                  if rule in [r.get("rule") for r in dicts(part.get("rules"))]), None)
            area = block or health or OWN_AREA
            files += [os.path.join(repos_dir(doctor), name)
                      for name in LLM_ENTRIES.get(area, ("llm-legs/bin/llm-doctor",))]
            what = "%s block · owner «%s»" % (area, owners.get(area) or ledger.get("owner"))
            word = str(match.get("word") or pid.partition("/")[2])
            if area == "image" and word.startswith("browser "):
                files += [os.path.join(repos_dir(doctor), path) for path in BROWSER_ENGINE]
                what = "hidden-Chrome route (Flow, the Gemini app, Flow Music, ChatGPT), step %s · %s" % (word[8:], what)
            if pid.startswith("machinery:"):
                what = "review-bench doctor class %s · %s" % (pid[10:], what)
        elif doctor == "harness":
            area = problem.get("group") if problem.get("speed") else sections.get(rule) or OWN_AREA
            kind, _, target = str((problem.get("opportunity") or {}).get("target") or "").partition("/")
            ident = target if kind == "hooks" else target.replace("/", ":", 1) if kind == "tests" else \
                (problem.get("opportunity") or {}).get("hook") if rule == "opportunity" and \
                (problem.get("opportunity") or {}).get("hook") else \
                pid.split(":", 1)[1] if ":" in pid else ""
            match = (row or {}).get("match")
            pattern = str((match if isinstance(match, dict) else {}).get("ident") or "")
            try:
                named_by_row = re.compile(pattern).fullmatch if pattern else lambda key: False
            except re.error:
                named_by_row = lambda key: False
            files += [script for key, script, event in hooks if script and (named_by_row(key) or ident
                      and (ident.split(":")[0] == key or ident == key or ident == "event:" + event))]
            if ident.startswith(("/", "~/")) and os.path.isfile(os.path.expanduser(ident)):
                files.append(ident)
            if (rule in ("test_slow", "test_load_fail", "test_long_pole", "test_daily_cost") or kind == "tests") \
                    and ident.count(":") == 1:
                repo, test = ident.split(":")
                files += [f for f in (os.path.join(repos_dir(doctor), repo, "tests", test + ext) for ext in (".sh", ".py", ""))
                          if os.path.isfile(f)][:1]
            if rule == "menu_build":
                files += [f for f in (os.path.join(repos_dir(doctor), name) for name in MENU_BUILDERS.get(
                    ident, MENU_BUILDERS["automation"])) if os.path.isfile(f)]
            if rule == "collector":
                files.append(doctor_script(doctor))
            if problem.get("speed") and rule == "opportunity":
                files += [os.path.join(repos_dir(doctor), name) for name in SPEED_FILES.get(pid[12:], ())]
            elif problem.get("speed") and rule == "time_floor" and "time/" + pid[11:] in SPEED_FILES:
                files += [os.path.join(repos_dir(doctor), name) for name in SPEED_FILES["time/" + pid[11:]]]
            elif problem.get("speed"):
                files.append(doctor_script("speed"))
        elif doctor == "code":
            area = WHOLE_AREA.get("code", "code")
            files += doctor_module("code").unit_paths(problem)
            what = "%s · %s" % (problem.get("group") or rule, problem.get("plan") or "plan in the judgment")
        else:
            if rule == "event-waiting":
                continue
            area = OWN_AREA
            files.append(os.path.join(repos_dir(doctor), UPDATER_MACHINERY.get(rule, "llm-legs/bin/updater-doctor")))
        for fix in dicts((row or {}).get("fixes")):
            files += [os.path.join(repos_dir(doctor), name) for name in strings(fix.get("files"))]
        entry = {"id": pid, "state": state, "fact": problem.get("fact"), "rule": rule, "ledger": problem.get("ledger"),
                 "area": slug(area), "component": {"what": what, "files": sorted({norm(f) for f in files}),
                                                   "rule_at": rule_at(doctor, rule)}}
        if doctor == "code":
            entry.update({key: problem.get(key) for key in ("group", "units", "files", "repos", "digest", "needs_egor")})
        if state not in ("watch", "fixed-pending"):
            kept.append(entry)
        elif rule == "opportunity" and problem.get("speed") \
                and (problem.get("opportunity") or {}).get("quality") == "equivalent":
            opportunities[pid] = entry
        elif state == "watch" and doctor == "harness" and area in HOOK_AREAS:
            watched.append(((problem.get("value") or 0) * (problem.get("exposure") or 0), entry))
    watched.sort(key=lambda pair: -pair[0])
    print(json.dumps(kept + [opportunities[pid] for pid in chosen if pid in opportunities]
                     + [entry for _, entry in watched[:8]]))


def git(folder, *args):
    try:
        out = subprocess.run(["git", "-C", folder] + list(args), capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return []
    return out.stdout.splitlines() if out.returncode == 0 else []


def texts(pattern):
    found = {}
    for path in sorted(glob.glob(pattern)):
        try:
            with open(path, errors="replace") as handle:
                found[path] = handle.read()
        except OSError:
            pass
    return found


def named(terms, text):
    return any(re.search(r"(?<![\w.-])%s(?![\w-])" % re.escape(t), text) for t in terms)


def packet(record_file, key):
    record = load(record_file, {})
    doctor = record.get("doctor")
    rows = {}
    if doctor in DOCTORS:
        rows = {r.get("id"): r for r in (load(ledger_path(doctor), {}) or {}).get("rows") or () if isinstance(r, dict)}
    earlier = {}
    for other in sorted((load(p, {}) for p in glob.glob(os.path.join(RUNS, "*.json"))), key=lambda r: r.get("created_at") or ""):
        if other.get("id") == record.get("id"):
            continue
        for decision in other.get("decisions") or ():
            earlier.setdefault(decision.get("id"), []).append("%s %s: %s" % (
                other.get("id"), decision.get("verdict"), decision.get("evidence") or ""))
    handoffs = texts(os.path.join(DOCS, "handoffs", "*.md"))
    invariants = [l for l in texts(os.path.join(DOCS, "shared-invariants.md")).get(
        os.path.join(DOCS, "shared-invariants.md"), "").splitlines() if l.startswith("| ")]
    memory = texts(os.path.join(HOME, ".claude-profiles", "*", "projects", "-Volumes-Work-Projects-*", "memory", "*.md"))
    history = {}
    for problem in record.get(key) or ():
        out = ["  %s\t%s\t%s" % (problem.get("id"), problem.get("state") or "-", problem.get("fact") or "")]
        row = rows.get(problem.get("ledger"))
        if row:
            out.append("ledger %s %s · %s" % (row.get("id"), row.get("status"), row.get("title") or ""))
            if row.get("note"):
                out.append("note: %s" % row["note"])
            for fix in dicts(row.get("fixes"))[-3:]:
                out.append("fix %s by %s: %s → %s%s" % (fix.get("at"), fix.get("by"), ", ".join(strings(fix.get("files"))),
                           fix.get("in"), " · regressed %s" % fix["regressed_at"] if fix.get("regressed_at") else ""))
            if strings(row.get("same_cause")):
                out.append("same cause: " + ", ".join(strings(row["same_cause"])))
            if row.get("handoff"):
                out.append("handoff: %s" % row["handoff"])
        for line in (earlier.get(problem.get("id")) or [])[-5:]:
            out.append("earlier " + line)
        component = problem.get("component") or {}
        if component:
            out.append("component: %s%s" % (component.get("what"), " · rule at " + component["rule_at"]
                                             if component.get("rule_at") else ""))
        for path in (component.get("files") or [])[:3]:
            if path not in history:
                folder = os.path.dirname(path)
                born = git(folder, "log", "--follow", "--diff-filter=A", "--format=%h %ad %s", "--date=short", "--", path)
                last = git(folder, "log", "-5", "--format=%h %ad %s", "--date=short", "--", path)
                history[path] = ["file %s" % path] + (["  created " + fit(born[-1], 120)] if born else []) + \
                    ["  " + fit(line, 120) for line in last]
            out += history[path]
        terms = {t for t in [problem.get("id"), problem.get("ledger")] + [os.path.basename(f) for f in component.get("files") or ()]
                 if t and len(t) >= 2}
        hits = [os.path.relpath(p, os.path.dirname(DOCS)) for p, text in handoffs.items() if named(terms, text)][:5]
        if hits:
            out.append("handoffs: " + ", ".join(hits))
        hits = [l.split("|")[1].strip() for l in invariants if named(terms, l)][:5]
        if hits:
            out.append("invariant rows: " + ", ".join(hits))
        hits = ["~/" + os.path.relpath(p, HOME) for p, text in memory.items() if named(terms, text)][:5]
        if hits:
            out.append("memory: " + ", ".join(hits))
        print(out[0])
        for line in out[1:24]:
            print("    " + fit(line, WIDTH))


def touches(record_file, pid, purpose):
    record = load(record_file, {})
    doctor = record.get("doctor")
    problem = next((p for p in record.get("problems") or () if p.get("id") == pid), None)
    if pid == "judge":
        component = [doctor_script(doctor), ledger_path(doctor)] if doctor in DOCTORS else []
    else:
        component = ((problem or {}).get("component") or {}).get("files") or []
    component = {norm(f) for f in component}
    if pid != "judge" and problem is not None and not component:
        return 3
    match = re.match(r"^([A-Za-z0-9._-]+)@([0-9a-f]{4,40})$", purpose)
    if match:
        top = os.path.join(PROJECTS, match.group(1))
        if not git(top, "rev-parse", "--verify", "--quiet", match.group(2) + "^{commit}"):
            return 1
        names = git(top, "diff-tree", "--no-commit-id", "--name-only", "-r", "--root", "--diff-merges=first-parent", match.group(2))
        return 0 if not component or any(norm(os.path.join(top, n)) in component for n in names) else 2
    path = re.sub(r":[0-9]+(-[0-9]+)?$", "", purpose)
    if not path:
        return 1
    bases = [""] if path.startswith("/") else [ROOT, PROJECTS] + list(record.get("worktrees") or ())
    found = [os.path.join(b, path) for b in bases if os.path.isfile(os.path.join(b, path))]
    if not found:
        return 1
    return 0 if not component or any(norm(f) in component for f in found) else 2


def live_knob_files():
    return {"settings": os.environ.get("HARNESS_SETTINGS") or os.path.join(HOME, ".claude", "settings.json"),
            "worker-model": os.environ.get("WORKER_PICK_CONFIG_FILE") or os.path.join(HOME, ".claude", "worker-model")}


def knob_site(path, text):
    return next((site for site, where, what in KNOBS if re.search(where, path) and re.search(what, text)), None)


def knob_lines():
    found = {}
    for site, path in live_knob_files().items():
        try:
            with open(path, errors="replace") as handle:
                found[path] = [line.rstrip("\n") for line in handle if knob_site(path, line.rstrip("\n"))]
        except OSError:
            found[path] = []
    return found


def knobs(record_file):
    """Lines of the run that set a model, effort or thinking knob: its worktrees against the night base (untracked
    files count as added); the live settings and worker-model files against their lines at launch only as notes, since
    a /model or effort change by Egor lands there too and no record says who wrote it."""
    record = load(record_file, {})
    base = "refs/night/%s/base" % record.get("night")
    hits = []
    for tree in strings(record.get("worktrees")):
        name = os.path.basename(os.path.dirname("".join(git(tree, "rev-parse", "--path-format=absolute", "--git-common-dir"))))
        path, old, new, header = "", 0, 0, False
        for line in git(tree, "diff", "-U0", "--no-color", "--no-ext-diff", base):
            hunk = re.match(r"^@@ -(\d+)(?:,\d+)? \+(\d+)", line)
            if line.startswith("diff --git "):
                header = True
            elif header and line.startswith(("--- a/", "+++ b/")):
                path = line[6:]
            elif hunk:
                old, new, header = int(hunk.group(1)), int(hunk.group(2)), False
            elif not header and line.startswith("+"):
                hits.append((knob_site(path, line[1:]), "%s/%s:%d" % (name, path, new), line))
                new += 1
            elif not header and line.startswith("-"):
                hits.append((knob_site(path, line[1:]), "%s/%s:%d" % (name, path, old), line))
                old += 1
        for rel in git(tree, "ls-files", "--others", "--exclude-standard"):
            try:
                with open(os.path.join(tree, rel), errors="replace") as handle:
                    hits += [(knob_site(rel, text.rstrip("\n")), "%s/%s:%d" % (name, rel, number), "+" + text.rstrip("\n"))
                             for number, text in enumerate(handle, 1)]
            except OSError:
                pass
    for site, where, line in hits:
        if site:
            print("model/effort knob, %s: %s: %s · speed never trades intelligence, the change is Egor alone to make"
                  % (site, where, fit(line, 120)))
    now = knob_lines()
    for path, then in (record.get("knobs_at_launch") or {}).items():
        lines = now.get(path, [])
        whole = texts(path).get(path, "").split("\n")
        live = [(knob_site(path, l), "%s:%d" % (path, whole.index(l) + 1), "+" + l) for l in lines if l not in then]
        live += [(knob_site(path, l), path, "-" + l) for l in then if l not in lines]
        for site, where, line in live:
            if site:
                print("doctor-fix: note: live model/effort knob changed since launch, %s: %s: %s · anyone may have made it, "
                      "so it holds no run open; Egor checks it" % (site, where, fit(line, 120)), file=sys.stderr)


def fix_faults(record_file, doctor):
    """Each fix record breaking the fix contract in the ledger of the run: its worktree copy where one exists,
    else the ledger the doctor reads."""
    path = ledger_path(doctor)
    if not path:
        return
    rel = os.path.relpath(os.path.realpath(path), os.path.realpath(ROOT))
    trees = [] if rel.startswith("..") else strings(load(record_file, {}).get("worktrees"))
    for ledger in [p for p in (os.path.join(tree, rel) for tree in trees) if os.path.isfile(p)] or [path]:
        for row, index, missing in fix_record_faults(load(ledger, {})):
            print("ledger %s: row %s fixes[%d] lacks %s: every fix record is {%s}"
                  % (ledger, row, index, ", ".join(missing), ", ".join(sorted(FIX_KEYS))))


if __name__ == "__main__":
    command = sys.argv[1]
    if command == "snapshot":
        snapshot(sys.argv[2], sys.argv[3], sys.argv[4] if len(sys.argv) > 4 else None)
    elif command == "packet":
        packet(sys.argv[2], sys.argv[3])
    elif command == "touches":
        sys.exit(touches(sys.argv[2], sys.argv[3], sys.argv[4]))
    elif command == "knob-lines":
        print(json.dumps(knob_lines()))
    elif command == "knobs":
        knobs(sys.argv[2])
    elif command == "fix-faults":
        fix_faults(sys.argv[2], sys.argv[3])
'

py() { DF_ROOT=$repo_root DF_PROJECTS=$projects_dir DF_RUNS=$runs_dir DF_HOME=$HOME DF_DOCS=${DOCTOR_FIX_DOCS:-$repo_root/docs} python3 -c "$PY" "$@"; }

check_doc() { # doctor -> dies unless its document is fresh and speaks contract 1; prints its problem count
  local doc facts contract age status count
  doc=$(doc_path "$1")
  [ -s "$doc" ] || die "no $1 doctor document at $doc. Refresh the doctor first."
  facts=$(jq -r "$JQ_EPOCH"' [(.contract // "none"), ((now - ((.as_of_s // (.as_of | epoch)) // 0)) | floor), (.status // "none"), (.problem_count // 0)] | @tsv' "$doc" 2>/dev/null) ||
    die "$doc is not a doctor document. Refresh the doctor first."
  IFS=$'\t' read -r contract age status count <<<"$facts"
  [ "$contract" = 1 ] || die "$doc speaks contract $contract, not 1. Refresh the doctor first."
  [ "$age" -le "$DOC_MAX_AGE_S" ] || die "the $1 doctor document is $((age / 3600)) h old. Refresh the doctor first."
  if [ "$count" = 0 ] && [ "$status" = ok ]; then printf 'none\n'; else printf '%s\n' "${count:-0}"; fi
}

claim_run() { # doctor area night problems-file -> id; refuses (exit 3) while an open run under 12 h holds the area (locked)
  local doctor=$1 area=$2 id age
  while IFS=$'\t' read -r id age; do
    [ -n "$id" ] || continue
    if [ "$age" -lt "$OPEN_RUN_MAX_S" ]; then
      printf 'run %s of the %s doctor is still open, launched %s h ago: close it with doctor-fix close %s, abandon it with doctor-fix abandon %s, or launch again once it is 12 h old.\n' \
        "$id" "$doctor" "$((age / 3600))" "$id" "$id" >&2
      return 3
    fi
    record_set "$id" '.abandoned_at = $t' --arg t "$(stamp)" || return 1
    printf 'run %s abandoned: open for %s h\n' "$id" "$((age / 3600))" >&2
  done < <(all_records | jq -r --arg d "$doctor" --arg a "$area" "$JQ_EPOCH $JQ_OPEN $JQ_AREA"' .[] | select(.doctor == $d and open
    and ($a == "all" or area == "all" or area == $a)) | [.id, ((now - ((.launched_at // .created_at) | epoch)) | floor)] | @tsv')
  id=$(new_record "$doctor" "$area" "$3") || return 1
  record_set "$id" '.judge_at_launch = ($doc[0].judge // null) | .problems = ($p[0] | map(select(.state != "quiet")))
    | .quiet = ($p[0] | map(select(.state == "quiet")))' \
    --slurpfile doc "$(doc_path "$doctor")" --slurpfile p "$4" || return 1
  printf '%s\n' "$id"
}

launch_day() { # llm|harness|code
  local doctor=$1 id prompt opened account session n count
  count=$(check_doc "$doctor") || exit 1
  py snapshot "$doctor" "$(doc_path "$doctor")" >"$runs_dir/.$$.problems" || die "cannot snapshot the $doctor doctor"
  [ "$count" != none ] || [ "$(jq 'map(select(.state == "quiet")) | length' "$runs_dir/.$$.problems")" != 0 ] ||
    { rm -f "$runs_dir/.$$.problems"; die "nothing to fix: the $doctor doctor reads ok with 0 problems and no quiet open ledger row."; }
  [ "$(jq length "$runs_dir/.$$.problems")" != 0 ] ||
    { rm -f "$runs_dir/.$$.problems"; die "nothing to fix: every $doctor doctor problem is held back (needs Egor, under active work or over its budget)."; }
  id=$(locked claim_run "$doctor" all '' "$runs_dir/.$$.problems") || { rm -f "$runs_dir/.$$.problems"; exit 1; }
  rm -f "$runs_dir/.$$.problems"
  pending_id=$id
  prompt="Doctor fixer run $id: read $repo_root/docs/doctor-fix.md in full and follow it for this run."
  if ! opened=$(CHAT_OPEN_OPENER="${DOCTOR_FIX_OPENER:-open -a Terminal}" \
    CHAT_OPEN_WORKER_PICK="${DOCTOR_FIX_WORKER_PICK:-$repo_root/bin/worker-pick}" \
    chat_open "$runs_dir/$id.command" "$repo_root" "$prompt" 2>&1); then
    locked fail_run "$id" "chat did not open: $opened"
    pending_id=''
    die "the $doctor fixer did not open: $opened"
  fi
  read -r account session <<<"$opened"
  locked record_set "$id" '.launched_at = $t | .account = $a | .session = $s | .command = $c' \
    --arg t "$(stamp)" --arg a "$account" --arg s "$session" --arg c "$runs_dir/$id.command" || die "cannot write run $id"
  pending_id=''
  printf '%s fixer opened: run %s, %s\n' "$doctor" "$id" "$(jq -r "$JQ_COUNTS" "$(record_file "$id")")"
}

worktree_top() {
  local top root
  [ -z "${DOCTOR_FIX_WORKTREE_REPO:-}" ] || { printf '%s\n' "$DOCTOR_FIX_WORKTREE_REPO"; return; }
  git_top "$repo_root" && printf '%s\n' "$root"
}

write_brief() { # id worktree -> the brief file
  local id=$1 wt=$2 file doctor area night branch decisions title
  file=$(record_file "$id")
  IFS=$'\t' read -r doctor area night branch < <(jq -r '[.doctor, .area, .night, .branch] | @tsv' "$file")
  mkdir -p "$runs_dir/$id.d" || return 1
  decisions="$runs_dir/$id.d/decisions.tsv"
  case $doctor in llm) title=LLM ;; harness) title=Harness ;; code) title=Code ;; *) title=Updater ;; esac
  {
    printf 'ROUND: none\n'
    jq -r '.worktrees[1:][] | "ADD-DIR: \(.)"' "$file"
    printf 'Working directory: %s\n\n# Night fixer run %s\n\n' "$wt" "$id"
    printf 'Night %s · %s doctor · area %s · %s. Worktree `%s` on branch `%s`.\n\n' \
      "$night" "$doctor" "$area" "$(jq -r "$JQ_COUNTS" "$file")" "$wt" "$branch"
    printf '1. Read `%s/docs/doctor-fix.md`: sections 0-6, "Night" and "%s doctor" only.\n' "$wt" "$title"
    printf '2. Your scope is the problems below and the known quiet rows after them, nothing else. Work only in the worktree and the `ADD-DIR:` worktrees of the other repositories your component lives in, all on the branch `%s`, started from their `refs/night/%s/base`; a change another repository needs is a handoff. Look at the older blocks around what you touch, not only at what you add: is a workaround there obsolete now, because the vendor does it natively or its reason is gone? Then remove it.\n' "$branch" "$night"
    printf '3. Commit on that branch; never push, never touch a main checkout, never ask Egor: decide what research settles (git log -S, the journals, the docs, the owning chat) and hand off to the next night, whose `night-run carry` makes every open handoff a job; Egor gets only a trade, a handoff whose `To:` names him carrying `Cost:`, `Loss:` and `Recommendation:` lines. Markdown is net zero at night: close refuses a worktree whose *.md bytes (handoffs included) grew since `refs/night/%s/base`, so for every line you add cut stale ones (closed handoffs first, then history, restated code, duplicated rules; ~/.claude/docs/context-file-hygiene.md).\n' "$night"
    printf '4. Close, from the worktree:\n\n'
    printf '       cd %q && DOCTORS_DIR=%q bin/doctor-fix close %s --decisions %q <one-line note>\n\n' \
      "$wt" "${runs_dir%/runs}" "$id" "$decisions"
    printf '   Close reruns `bin/%s-doctor --json` in this worktree itself; a `fixed` problem must read fixed-pending or be gone there.\n' "$doctor"
    printf '5. Whatever you found but did not fix, and every cause you ruled out, goes into the ledger (a row'"'"'s `note`, a new row or a `blind_spots` row), so the next fixer does not dig the same ground.\n'
    printf '6. Report: per problem the verdict and one line of why, the commits (repo@hash) and every handoff.\n\n'
    [ "$doctor" != code ] ||
      printf 'Code runs: every problem carries its judged plan and proof obligations; a deletion lands only through `bin/code-doctor check` (close runs it against `refs/night/%s/base`), never edit through a symlink into another repository, and a cross-repository merge lands in stages over nights (the shared module and the callers first, `merges: [{stage: "migrated", night}]` in the ledger row, the old copy on a later night). Record each landed cleanup with `bin/code-doctor record-fix <cause> --by <run> --files ... --lines-removed N [--mechanism M --canonical PATH --replaced PATH...]`.\n\n' "$night"
    ! jq -e --arg rules "$TEST_SPEED_RULES" "$JQ_HAS_RULES" "$file" >/dev/null ||
      printf 'Test speed is this run'"'"'s to fix, never a handoff (`close` refuses one): for `test_long_pole`, `test_daily_cost`, `test_slow` and `suites_at_once` make the suites faster yourself in any sweep repository (an `ADD-DIR:` worktree each): split a long pole into independent suite files that `tests/run-all` runs in parallel, cut redundant cases, make timing asserts load-robust, cache fixtures; every assert keeps its coverage.\n\n'
    ! jq -e --arg rules ' menu_build ' "$JQ_HAS_RULES" "$file" >/dev/null ||
      printf 'Menu delays (`menu_build`) are this run'"'"'s to fix, never a handoff (`close` refuses one): make the build in the files the packet names faster, measured by the menu journal the doctor reads.\n\n'
    [ "$doctor/$area" != llm/reviewers ] ||
      printf 'Settle every stuck review round (`machinery:closure_pending`) of the sweep repositories yourself, not only its machinery; never touch a round of another project: the LLM doctor section "Stuck review rounds".\n\n'
    printf '## Packet\n\n'
    show_run "$id"
  } >"$runs_dir/$id.brief.md" || return 1
  printf '%s\n' "$runs_dir/$id.brief.md"
}

component_repos() { # id top -> the main checkouts other than top that hold the run's component files
  local f d top root
  jq -r '.problems[].component.files[]?' "$(record_file "$1")" | while IFS= read -r f; do
    d=$(dirname "$f")
    while [ ! -d "$d" ]; do d=$(dirname "$d"); done
    git_top "$d" && [ "$root" != "$2" ] && printf '%s\n' "$root"
  done | sort -u
}

launch_night() { # doctor night
  local doctor=$1 night=$2 snap area id top wt branch err judge='' brief siblings repo repos failed=0
  [[ $night =~ ^[A-Za-z0-9._-]+$ ]] || die "night id '$night' is not branch-safe"
  check_doc "$doctor" >/dev/null || exit 1
  snap=$(py snapshot "$doctor" "$(doc_path "$doctor")" "$night") || die "cannot snapshot the $doctor doctor"
  [ "$doctor" != harness ] || jq -r '.speed | select(. != null and (.selection // []) == [])
    | "harness: Speed selects nothing: \(.why_none // "no reason recorded")"' "$(doc_path harness)" >&2 2>/dev/null || true
  [ "$snap" != '[]' ] || return 0
  top=$(worktree_top) || die "no repository at $repo_root"
  for area in $(jq -r 'map(.area) | unique[]' <<<"$snap"); do
    jq --arg a "$area" 'map(select(.area == $a))' <<<"$snap" >"$runs_dir/.$$.problems"
    id=$(locked claim_run "$doctor" "$area" "$night" "$runs_dir/.$$.problems")
    case $? in
      0) ;;
      3) continue ;;
      *) failed=1; continue ;;
    esac
    pending_id=$id
    [ "$doctor" != harness ] || locked record_set "$id" '.knobs_at_launch = $k' --argjson k "$(py knob-lines)"
    branch="night/$night/$id"
    wt="$top/.claude/worktrees/night-$night-$id"
    locked record_set "$id" '.branch = $b | .worktrees = [$w]' --arg b "$branch" --arg w "$wt"
    if ! err=$(night_worktree_add "$top" "$night" "$branch" "$wt" 2>&1 >/dev/null); then
      locked fail_run "$id" "worktree not created: ${err:-git worktree add failed}"
      printf 'run %s failed: worktree not created: %s\n' "$id" "$err" >&2
      pending_id='' failed=1
      continue
    fi
    repos=()
    while IFS= read -r repo; do repos+=("$repo"); done < <({ component_repos "$id" "$top"
      ! jq -e --arg rules "$TEST_SPEED_RULES" "$JQ_HAS_RULES" "$(record_file "$id")" >/dev/null ||
        grep -vxF -e "$top" -e '' "${NIGHT_RUN_SWEEP_REPOS:-$HOME/.claude/sweep-repos}" 2>/dev/null; } | sort -u)
    siblings=$(night_sibling_worktrees "$night" "$branch" "$id" ${repos[@]+"${repos[@]}"})
    [ -z "$siblings" ] || locked record_set "$id" '.worktrees += ($s | split("\n"))' --arg s "$siblings"
    [ -n "$judge" ] || judge=$( (cd "$wt" && "bin/$doctor-doctor" --json 2>/dev/null) | jq -r '.judge // empty' 2>/dev/null)
    [ -z "$judge" ] || locked record_set "$id" '.judge_at_launch = $j' --arg j "$judge"
    if ! brief=$(write_brief "$id" "$wt"); then
      locked fail_run "$id" "brief not written"
      printf 'run %s failed: brief not written\n' "$id" >&2
      pending_id='' failed=1
      continue
    fi
    if ! locked record_set "$id" '.launched_at = $t' --arg t "$(stamp)"; then
      locked fail_run "$id" "launched_at not written"
      printf 'run %s failed: launched_at not written\n' "$id" >&2
      pending_id='' failed=1
      continue
    fi
    pending_id=''
    printf '%s\t%s\t%s\n' "$id" "$brief" "$wt"
  done
  rm -f "$runs_dir/.$$.problems"
  return "$failed"
}

launch() { # llm|harness|updater|code [--night <id>]
  local doctor=${1:-} reason
  mkdir -p "$runs_dir" || die "cannot make $runs_dir"
  if [ "$doctor" = code ]; then
    reason=$(jq -r '.scope.report_only // empty' "$(doc_path code)" 2>/dev/null)
    [ -z "$reason" ] || die "$reason"
  fi
  case "$doctor:${2:-}" in
    llm: | harness: | code:) launch_day "$doctor" ;;
    updater:) "${DOCTOR_FIX_VENDOR_CLI_UPDATE:-$repo_root/bin/vendor-cli-update}" now ;;
    llm:--night | harness:--night | updater:--night | code:--night) [ -n "${3:-}" ] && [ $# -eq 3 ] || usage; launch_night "$doctor" "$3" ;;
    *) usage ;;
  esac
}

record_updater() { # --session S --account A --command F | --night N --branch B --worktree W..., then --problems id...
  local session='' account='' command='' night='' branch='' worktree='' worktrees=() id event problems=()
  while [ $# -gt 0 ]; do
    case $1 in
      --session) session=${2:-}; shift 2 || usage ;;
      --account) account=${2:-}; shift 2 || usage ;;
      --command) command=${2:-}; shift 2 || usage ;;
      --night) night=${2:-}; shift 2 || usage ;;
      --branch) branch=${2:-}; shift 2 || usage ;;
      --worktree) worktree=${2:-}; worktrees+=("$worktree"); shift 2 || usage ;;
      --problems) shift; problems=("$@"); break ;;
      *) usage ;;
    esac
  done
  [ ${#problems[@]} -gt 0 ] || usage
  if [ -n "$night$branch$worktree" ]; then
    [ -n "$night" ] && [ -n "$branch" ] && [ -n "$worktree" ] && [ -z "$session$account$command" ] || usage
  else
    [ -n "$session" ] && [ -n "$account" ] && [ -n "$command" ] || usage
  fi
  mkdir -p "$runs_dir" || die "cannot make $runs_dir"
  for event in "${problems[@]}"; do
    jq -c --arg id "$event" '{id: $id, state: "open", fact: "\(.vendor) \(.from) → \(.to): \((.substantive // []) | if length > 0 then join(", ") else "manual request" end)"}' \
      "$events_dir/$event.json" 2>/dev/null || jq -nc --arg id "$event" '{id: $id, state: "open", fact: null}'
  done | jq -s . >"$runs_dir/.$$.problems"
  id=$(locked new_record updater release "$night") || die "cannot write a run record under $runs_dir"
  locked record_set "$id" 'def opt: if . == "" then null else . end;
    .launched_at = .created_at | .account = ($a | opt) | .session = ($s | opt) | .command = ($c | opt)
    | .branch = ($b | opt) | .worktrees = $w
    | .judge_at_launch = ($j | opt) | .problems = $p[0]' \
    --arg a "$account" --arg s "$session" --arg c "$command" --arg b "$branch" --arg j "$(doc_judge updater)" \
    --argjson w "$(jq -nc '$ARGS.positional' --args ${worktrees[@]+"${worktrees[@]}"})" \
    --slurpfile p "$runs_dir/.$$.problems" || { rm -f "$runs_dir/.$$.problems"; die "cannot write run $id"; }
  rm -f "$runs_dir/.$$.problems"
  printf '%s\n' "$id"
}

refuse_unless_open() { # id -> dies unless the run is open
  case $(run_state "$1") in
    open) ;;
    closed) die "run $1 is already closed" ;;
    abandoned) die "run $1 was abandoned: it closes no more" ;;
    failed) die "run $1 failed to launch: $(jq -r '.note // ""' "$(record_file "$1")")" ;;
    *) die "run $1 never opened" ;;
  esac
}

commit_record_close() { # id decisions-json-file note (locked)
  refuse_unless_open "$1"
  record_set "$1" '.closed_at = $t | .judge_at_close = (if $j == "" then null else $j end) | .decisions = $d[0] | .note = $n' \
    --arg t "$(stamp)" --arg j "$(doc_judge updater)" --slurpfile d "$2" --arg n "$3"
}

record_close() { # id --decisions <json-file> note...
  local id=${1:-} file
  file=$(record_file "$id")
  [ -n "$id" ] && [ -f "$file" ] || die "no run $id"
  [ "${2:-}" = --decisions ] && [ -r "${3:-}" ] || usage
  jq -e "$JQ_AREA"' .doctor == "updater" and area == "release"' "$file" >/dev/null || die "run $id is no updater release run"
  (locked commit_record_close "$id" "$3" "${*:4}") || exit 1
}

commit_close() { # id decisions-file judge note unverified-ids (locked)
  refuse_unless_open "$1"
  record_set "$1" '.closed_at = $t | .judge_at_close = (if $j == "" then null else $j end) | .note = $n
    | ($u | split("\n")) as $u
    | .decisions = [$lines | split("\n")[] | split("\t") | select(length >= 4 and (.[0] | length) > 0)
        | {id: .[0], verdict: .[1], purpose: .[2], evidence: .[3]}
        + (if .[0] as $p | $u | index([$p]) then {component: "unverified"} else {} end)]' \
    --arg t "$(stamp)" --arg j "$3" --arg n "$4" --arg u "${5:-}" --rawfile lines "$2"
}

rerun_doc() { # id doctor -> the document the doctor prints from the run's worktree, kept run-local
  local wt out
  wt=$(jq -r '.worktrees[0] // ""' "$(record_file "$1")")
  [ -n "$wt" ] && [ -x "$wt/bin/$2-doctor" ] || die "run $1 has no worktree with bin/$2-doctor to rerun the doctor in"
  mkdir -p "$runs_dir/$1.d" || die "cannot make $runs_dir/$1.d"
  out="$runs_dir/$1.d/latest.json"
  (cd "$wt" && "bin/$2-doctor" --json) >"$out" 2>/dev/null
  printf '%s\n' "$out"
}

md_growth() { # worktree base -> the net *.md byte growth, then the 3 largest growers; fails without the base ref
  local wt=$1 base=$2 f old new delta total=0 rows=''
  git -C "$wt" rev-parse -q --verify "$base^{commit}" >/dev/null 2>&1 || return 1
  while IFS= read -r -d '' f; do
    old=$(git -C "$wt" cat-file -s "$base:$f" 2>/dev/null) || old=0
    new=0
    [ ! -f "$wt/$f" ] || new=$(wc -c <"$wt/$f" | tr -d ' ')
    delta=$((new - old))
    total=$((total + delta))
    [ "$delta" -le 0 ] || rows+="$delta"$'\t'"$f"$'\n'
  done < <({ git -C "$wt" diff -z --name-only --no-renames "$base" -- '*.md'
    git -C "$wt" ls-files -z --others --exclude-standard -- '*.md'; } | sort -zu)
  printf '%s\n' "$total"
  printf '%s' "$rows" | sort -t$'\t' -k1,1nr | head -n 3 | awk -F'\t' '{ printf "%s +%s\n", $2, $1 }'
}

untraded_handoff() { # record evidence -> the cited handoff addressed to Egor that lacks Cost:/Loss:/Recommendation:
  local word dir path key missing words
  read -ra words <<<"$2"
  for word in ${words[@]+"${words[@]}"}; do
    word=${word#[(\`]}
    word=${word%%[,;:)\`]*}
    while [[ $word == *[.!?\"\'] ]]; do word=${word%?}; done
    [[ $word == *.md ]] || continue
    for path in "$word" $(jq -r '.worktrees[]? + "/" + $w' --arg w "$word" "$1") "$repo_root/$word" \
      "${DOCTOR_FIX_DOCS:-$repo_root/docs}/${word#docs/}"; do
      [ -f "$path" ] || continue
      grep -iE '^[*_ ]*To[*_ ]*:' "$path" | grep -qiw egor || break
      missing=''
      for key in Cost Loss Recommendation; do
        grep -qE "^[*_ >-]*$key[*_ ]*:" "$path" || missing+=" $key:"
      done
      [ -z "$missing" ] || { printf '%s lacks%s\n' "$word" "$missing"; return; }
      break
    done
  done
}

close_run() { # id --decisions <file> note...
  local id=${1:-} decisions='' doc file doctor as_of launched judge_then judge_now line_no=0
  local pid verdict purpose evidence decided='' unverified='' problems bad=() touch state failure line rule base wt growth
  file=$(record_file "$id")
  [ -n "$id" ] && [ -f "$file" ] || die "no run $id"
  shift
  [ "${1:-}" = --decisions ] && [ -n "${2:-}" ] || usage
  decisions=$2
  shift 2
  [ -r "$decisions" ] || die "cannot read $decisions"
  doctor=$(jq -r .doctor "$file")
  case $doctor in
    llm | harness | code) ;;
    updater) [ "$(jq -r "$JQ_AREA area" "$file")" != release ] ||
      die "run $id is an updater release run: it closes with its last event, through vendor-fingerprint close" ;;
    *) die "run $id names no doctor" ;;
  esac
  refuse_unless_open "$id"
  if jq -e '.night == null' "$file" >/dev/null; then
    doc=$(doc_path "$doctor")
  else
    doc=$(rerun_doc "$id" "$doctor") || exit 1
  fi
  jq -e --arg d "$doctor" '.contract == 1 and .doctor == $d' "$doc" >/dev/null 2>&1 ||
    die "$doc is no contract-1 $doctor doctor document"
  as_of=$(jq -r "$JQ_EPOCH"' (.as_of_s // (.as_of | epoch)) // 0' "$doc" 2>/dev/null) || as_of=0
  launched=$(jq -r "$JQ_EPOCH"' .launched_at | epoch' "$file")
  [ "${as_of%.*}" -gt "${launched%.*}" ] ||
    die "rerun the $doctor doctor, the proof reads its fresh numbers: its document is not newer than this run's launch"
  while IFS=$'\x1f' read -r pid verdict purpose evidence; do
    line_no=$((line_no + 1))
    [ -n "$pid$verdict$purpose$evidence" ] || continue
    if [ "$pid" = judge ]; then
      [ "$verdict" = changed ] || { bad+=("line $line_no (judge): verdict must be changed"); continue; }
    elif [[ $VERDICTS != *" $verdict "* ]]; then
      bad+=("line $line_no ($pid): verdict '$verdict' is not one of fixed|ruled-out|weather|blind-spot|handoff")
      continue
    elif [ "$verdict" = handoff ] && rule=$(jq -r --arg p "$pid" \
      'first((.problems + (.quiet // []))[] | select(.id == $p) | .rule) // ""' "$file") && [ -n "$rule" ] &&
      [[ "$TEST_SPEED_RULES menu_build " == *" $rule "* ]]; then
      bad+=("line $line_no ($pid): handoff refused: test speed and menu delays are this run's to fix")
      continue
    fi
    py touches "$file" "$pid" "$purpose"
    touch=$?
    [ "$touch" != 3 ] || { unverified+="$pid"$'\n'; touch=0; }
    [ "$touch" != 1 ] ||
      { bad+=("line $line_no ($pid): purpose '$purpose' resolves to no commit (repo@hash) and no file"); continue; }
    [ "$touch" = 0 ] ||
      { bad+=("line $line_no ($pid): purpose '$purpose' does not touch the component: cite one of its files or a commit that changed one (doctor-fix show $id)"); continue; }
    [ -n "$evidence" ] || { bad+=("line $line_no ($pid): no evidence"); continue; }
    if [ "$verdict" = handoff ] && failure=$(untraded_handoff "$file" "$evidence") && [ -n "$failure" ]; then
      bad+=("line $line_no ($pid): handoff to Egor $failure: Egor decides only a trade (each way's cost and loss, the recommendation); otherwise hand it to an owner or decide what research settles")
      continue
    fi
    if [ "$verdict" = fixed ]; then
      failure=$(jq -r 'if .status == "error" then (.self.error // "no error text") else "" end' "$doc")
      [ -z "$failure" ] ||
        { bad+=("line $line_no ($pid): fixed, but the rerun $doctor doctor fails: $failure"); continue; }
      state=$(jq -r --arg p "$pid" 'first(.problems[]? | select(.id == $p and (.state == "new" or .state == "open"
        or .state == "regressed")) | .state) // ""' "$doc")
      [ -z "$state" ] ||
        { bad+=("line $line_no ($pid): fixed, but the rerun $doctor doctor still reads it $state: a fix leaves it fixed-pending or gone"); continue; }
    fi
    decided+="$pid"$'\n'
  done < <(awk -F'\t' '{ printf "%s\037%s\037%s\037%s\n", $1, $2, $3, $4 }' "$decisions")
  problems=$(jq -r '.problems[].id' "$file")
  while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    printf '%s' "$decided" | grep -qxF -- "$pid" || bad+=("$pid: undecided")
  done <<<"$problems"
  judge_then=$(jq -r '.judge_at_launch // ""' "$file")
  judge_now=$(doc_judge "$doctor" "$doc")
  if [ "$judge_then" != "$judge_now" ] && ! printf '%s' "$decided" | grep -qxF judge; then
    bad+=("judge: the $doctor doctor's judge changed since launch (${judge_then:0:12} -> ${judge_now:0:12}); add judge<TAB>changed<TAB>purpose<TAB>why")
  fi
  if [ "$doctor" = code ]; then
    while IFS= read -r line; do
      [ -z "$line" ] || bad+=("code-doctor check: $line")
    done < <("${DOCTOR_FIX_CODE_DOCTOR:-$repo_root/bin/code-doctor}" check "$file" \
      $(jq -r 'if .night then "--base\nrefs/night/\(.night)/base" else empty end' "$file") 2>&1)
  fi
  if jq -e '.night != null' "$file" >/dev/null; then
    base="refs/night/$(jq -r .night "$file")/base"
    while IFS= read -r wt; do
      growth=$(md_growth "$wt" "$base") || { bad+=("markdown: no $base in $wt to measure it against"); continue; }
      [ "${growth%%$'\n'*}" -gt 0 ] || continue
      bad+=("markdown grew by ${growth%%$'\n'*} bytes since $base in $wt ($(sed 1d <<<"$growth" | paste -sd, - | sed 's/,/, /g')): markdown is net zero at night — cut stale lines (closed handoffs first, then history, restated code, duplicated rules; ~/.claude/docs/context-file-hygiene.md) until it does not grow")
    done < <(jq -r '.worktrees[]?' "$file")
  fi
  if [ "$doctor" = harness ] && jq -e '.night != null' "$file" >/dev/null; then
    while IFS= read -r line; do
      [ -z "$line" ] || bad+=("$line")
    done < <(py knobs "$file")
  fi
  while IFS= read -r line; do
    [ -z "$line" ] || bad+=("$line")
  done < <(py fix-faults "$file" "$doctor")
  if [ ${#bad[@]} -gt 0 ]; then
    printf 'doctor-fix: run %s stays open; rows are id<TAB>fixed|ruled-out|weather|blind-spot|handoff<TAB>purpose<TAB>evidence, purpose a repo@hash or a file of the component stating why it exists:\n' "$id" >&2
    printf '%s\n' "${bad[@]}" >&2
    exit 1
  fi
  (locked commit_close "$id" "$decisions" "$judge_now" "$*" "$unverified") || exit 1
  printf 'run %s closed: %s decisions\n' "$id" "$(jq '.decisions | length' "$file")"
}

abandon_locked() { # id reason
  case $(run_state "$1") in
    closed) die "run $1 is already closed" ;;
    abandoned | failed) printf 'run %s is already %s\n' "$1" "$(run_state "$1")"; return 0 ;;
  esac
  record_set "$1" '.abandoned_at = $t | .note = (if $n == "" then .note else $n end)' --arg t "$(stamp)" --arg n "$2" &&
    printf 'run %s abandoned\n' "$1"
}

abandon_run() { # id [--reason TEXT]
  local id=${1:-} reason=''
  [ -n "$id" ] && [ -f "$(record_file "$id")" ] || die "no run $id"
  case "${2:-}" in
    '') ;;
    --reason) reason=${3:-} ;;
    *) usage ;;
  esac
  (locked abandon_locked "$id" "$reason") || exit 1
}

run_status() { printf '%s' 'if .closed_at then "closed" elif .abandoned_at then "abandoned" elif .failed_at then "failed" elif .launched_at then "open" else "pending" end'; }

show_run() { # id
  local file
  file=$(record_file "${1:-}")
  [ -n "${1:-}" ] && [ -f "$file" ] || die "no run ${1:-}"
  jq -r "def status: $(run_status); $JQ_AREA"' "run \(.id) · \(.doctor) doctor · area \(area) · \(status)",
    "created \(.created_at) · launched \(.launched_at // "-") · closed \(.closed_at // "-")\(if .abandoned_at then " · abandoned \(.abandoned_at)" else "" end)\(if .failed_at then " · failed \(.failed_at)" else "" end)",
    (if .night then "night \(.night) · branch \(.branch // "-") · worktrees \((.worktrees // []) | join(" "))" else "account \(.account // "-") · command \(.command // "-")" end),
    "judge at launch \((.judge_at_launch // "-")[:12]) · at close \((.judge_at_close // "-")[:12])",
    "problems (\(.problems | length)):"' "$file"
  py packet "$file" problems
  jq -e '(.quiet // []) | length > 0' "$file" >/dev/null &&
    printf 'known, quiet (%s): open ledger rows the doctor did not see in its window. Check in the code whether each cause still stands, then fix it, or write in the row'"'"'s note why not:\n' \
      "$(jq '.quiet | length' "$file")" && py packet "$file" quiet
  jq -r '(if (.decisions | length) > 0 then "decisions (\(.decisions | length)):", (.decisions[] | "  \(.id)\t\(.verdict)\t\(.purpose // "-")\t\(.evidence)\(if .component then "\tcomponent \(.component)" else "" end)") else empty end),
    (if .note then "note: \(.note)" else empty end)' "$file"
}

list_runs() { # [doctor] [--open] [--json]
  local doctor='' open=false json=false
  while [ $# -gt 0 ]; do
    case $1 in
      --open) open=true ;;
      --json) json=true ;;
      llm | harness | updater | code) doctor=$1 ;;
      *) usage ;;
    esac
    shift
  done
  all_records | jq --arg d "$doctor" --argjson open "$open" "$JQ_OPEN"'
    map(select(($d == "" or .doctor == $d) and (($open | not) or (.launched_at != null and open))))' |
    if $json; then cat; else
      jq -r "def status: $(run_status);"' .[] | [.id, status, (.launched_at // .created_at), "\(.problems | length) problems", (.note // "" | .[:80])] | @tsv'
    fi
}

usage_text() {
  cat <<'EOF'
usage: doctor-fix launch llm|harness|updater|code [--night <night-id>]
       doctor-fix show <id>
       doctor-fix runs [llm|harness|updater|code] [--open] [--json]
       doctor-fix close <id> --decisions <file> <note...>   (a night run reruns its doctor in its worktree)
       doctor-fix abandon <id> [--reason TEXT]
       doctor-fix record updater --session <s> --account <a> --command <file> --problems <event id>...   (internal)
       doctor-fix record updater --night <night-id> --branch <b> --worktree <w> [--worktree <w>...] --problems <event id>...   (internal)
       doctor-fix record-close <id> --decisions <json-file> <note...>   (internal, updater release runs)
       doctor-fix touches <record-file> <id> <purpose>   (internal: 0 resolves and touches, 1 resolves nowhere, 2 misses the component, 3 the problem's component names no file: close records it component unverified)
EOF
}
usage() { usage_text >&2; exit 2; }

case "${1:-}" in
  launch) launch "${@:2}" ;;
  record) [ "${2:-}" = updater ] || usage; record_updater "${@:3}" ;;
  record-close) record_close "${@:2}" ;;
  show) show_run "${2:-}" ;;
  runs) list_runs "${@:2}" ;;
  close) close_run "${@:2}" ;;
  abandon) abandon_run "${@:2}" ;;
  touches) [ $# -eq 4 ] && [ -f "$2" ] || usage; py touches "${@:2}" ;;
  -h | --help | help) usage_text ;;
  *) usage ;;
esac

#!/usr/bin/env bash
{
set -u
umask 077
ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/claude-reports"
CAP=16000
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=${self%/*}/$link ;; esac
done
share=$(cd -P "${self%/*}/.." 2>/dev/null && pwd)/share
FRAME=${REPORT_FRAME:-$share/report_frame.py}
# memlogd install-agent deploys this file and store-lock.sh into ~/.local/libexec, where ../share is
# not llm-legs' share.
lib=${self%/*}
[ -r "$lib/store-lock.sh" ] || lib=$share
. "$lib/store-lock.sh"
locked=false
tmp=''
usage() { printf 'report-bus: invalid arguments (post | emit | lose | flush | list | doctor); emit exits 3 on a duplicate\n' >&2; exit 2; }
refuse_body() { printf 'report-bus: the body must be a block document {"word":…,"rows":[[label,value],…]}: %s\n' "$1" >&2; exit 2; }
valid_name() { case "$1" in ''|.|..|*[!A-Za-z0-9._-]*) return 1 ;; esac; }
# shellcheck disable=SC2329
cleanup() {
  [ -z "$tmp" ] || rm -f "$tmp"
  [ "$locked" = false ] || store_lock_release "$ROOT/.lock"
}
# A post signalled before its queue file landed exited 0 with the report gone and no trace of it.
signalled() {
  case "${verb:-}" in post|emit) [ "${landed:-false}" = true ] || [ -z "${body:-}" ] || problem 'interrupted before the report was queued' ;; esac
  exit 0
}
live_guard() {
  [ -n "${REPORT_BUS_LIVE_ROOT:-}" ] || return 0
  local here live
  here=$(cd -P "$ROOT" 2>/dev/null && pwd) || here=$ROOT
  live=$(cd -P "$REPORT_BUS_LIVE_ROOT" 2>/dev/null && pwd) || live=$REPORT_BUS_LIVE_ROOT
  [ "$here" = "$live" ] || return 0
  printf 'report-bus: a suite reached the live queue %s: %s --kind %s --id %s\n' "$live" "$verb" "${kind:-}" "${id:-}" |
    tee -a "${REPORT_BUS_LEAK_LOG:-/dev/null}" >&2
  exit 4
}
trap 'cleanup' EXIT
trap 'signalled' HUP INT TERM
keep_lost() { # reason
  local row
  row=$(jq -cn --arg k "${kind:-}" --arg i "${id:-}" --arg s "${session:-}" --arg r "$1" --arg b "${body:-}" \
    '{epoch:now|floor, session:$s, kind:$k, id:$i, reason:$r, body:$b}' 2>/dev/null) || row=${body:-}
  if ! { printf '%s\n' "$row" >>"$ROOT/lost.log"; } 2>/dev/null; then
    printf 'report-bus: lost.log is unwritable; body follows\n%s\n' "${body:-}" >&2
  fi
}
problem() {
  printf 'report-bus: %s\n' "$1" >&2
  keep_lost "$1"
  exit 0
}
lock_store() { # tries
  mkdir -p "$ROOT" 2>/dev/null && [ -w "$ROOT" ] || return 1
  LLM_STORE_LOCK_RETRIES=${1:-100} LLM_STORE_LOCK_DELAY=0.05 store_lock_acquire "$ROOT/.lock" || return 1
  locked=true
}
resolve_session() {
  local current='' next owner entry runroot seen='|' pid hop registry
  [ -z "$session" ] || return 0
  runroot="${WORKER_RUN_DIR:-$HOME/.cache/claude-worker-runs}"
  if [ -n "${WORKER_RUN_DIR:-}" ] && [ -r "$WORKER_RUN_DIR/launcher" ]; then
    current=$(cat "$WORKER_RUN_DIR/launcher")
    runroot=${WORKER_RUN_DIR%/*}
  fi
  valid_name "$current" || current=${CLAUDE_LAUNCHER_SESSION:-}
  valid_name "$current" || current=${CLAUDE_CODE_SESSION_ID:-}
  if ! valid_name "$current"; then
    current=''
    pid=$$
    registry="${REVIEW_BENCH_SESSION_DIR:-$HOME/.claude/sessions}"
    for ((hop=0; hop<15; hop++)); do
      [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ] || break
      next=$(jq -r '.sessionId // empty' "$registry/$pid.json" 2>/dev/null) || next=''
      if valid_name "$next"; then current=$next; break; fi
      pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    done
  fi
  if ! valid_name "$current"; then session=_orphan; return; fi
  while :; do
    seen="$seen$current|"
    next=''
    # One grep for every run: a grep per run directory cost each stop notice 7 s at 1400 runs.
    while IFS= read -r entry; do
      owner=$(cat "${entry%/worker-session}/launcher" 2>/dev/null) || owner=''
      valid_name "$owner" || continue
      if [ -n "$next" ] && [ "$next" != "$owner" ]; then next=''; break; fi
      next=$owner
    done < <(grep -lxF -- "$current" "$runroot"/*/worker-session 2>/dev/null)
    valid_name "$next" || break
    case "$seen" in *"|$next|"*) break ;; esac
    current=$next
  done
  session=$current
}
skip_flush() {
  [ "${CLAUDEB_WORKER:-}" = 1 ] && return 0
  [ -z "$agent" ] || return 0
  case "$transcript" in */subagents/*) return 0 ;; esac
  case "$agent_type" in
    codex-worker|claudeb-worker|gemini-worker|grok-worker|light-worker|light-research) return 0 ;;
  esac
  return 1
}
render() {
  jq -er '
    if type != "object" or (.body | type) != "string"
    then error("invalid report") else
      (.body | sub("^\n+"; "") | sub("\n+$"; ""))
    end' "$1"
}
undelivered_block() {
  printf '{"word":"reports","rows":[["undelivered",%s]]}' "$1" | python3 "$FRAME" block 2>/dev/null ||
    printf 'report-bus: %s report(s) undelivered\n' "$1"
}
hook_output() {
  jq -cn --arg m "$1" --arg c "${2:-}" --arg e "${3:-PostToolUse}" '
    {systemMessage:("\n" + $m)} + (if $c == "" then {} else
      {hookSpecificOutput:{hookEventName:$e,additionalContext:$c}} end)'
}

duplicate() {
  local entry
  for entry in "$ROOT/$session/pending/"*"__${kind}__${id}.txt" "$ROOT/$session/delivered/"*"__${kind}__${id}.txt" "$ROOT/_orphan/pending/"*"__${kind}__${id}.txt" "$ROOT/_orphan/delivered/"*"__${kind}__${id}.txt"; do
    [ ! -f "$entry" ] || return 0
  done
  [ -f "$ROOT/history.log" ] || return 1
  jq -se --arg s "$session" --arg k "$kind" --arg i "$id" \
    'any(.[]; (.session == $s or .source_session == $s or .source_session == "_orphan" or $s == "_orphan") and .kind == $k and .id == $i)' \
    "$ROOT/history.log" >/dev/null 2>&1
}
history_row() {
  jq -c --arg s "$session" --arg event "$event" --arg text "$2" \
    '{epoch:now|floor, session:$s, kind, id, bytes:($text|utf8bytelength), event:$event,
      source_session:.session, text:$text}' "$1"
}
mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null; }
pending_files() {
  local entry base
  for base in "$ROOT/$session/pending" "$ROOT/_orphan/pending"; do
    for entry in "$base"/*.txt; do
      [ -f "$entry" ] || continue
      printf '%s\t%s\n' "$(mtime "$entry")" "$entry"
    done
    [ "$session" != _orphan ] || break
  done | LC_ALL=C sort -n -k1,1 -k2 | cut -f2-
}
# Every PostToolUse flushes: with nothing pending and nothing to prune it takes no lock, and the
# delivered reports are stat'ed only past the cap, never one stat per report on every call.
has_pending() {
  local entry
  for entry in "$ROOT/$session/pending"/*.txt "$ROOT/_orphan/pending"/*.txt; do
    [ -f "$entry" ] && return 0
  done
  return 1
}
over_cap() {
  set -- "$ROOT/$session/delivered"/*.txt
  [ "$#" -gt 200 ]
}
prune() {
  local entry n=0
  over_cap || return 0
  while IFS= read -r entry; do
    n=$((n + 1))
    [ "$n" -le 200 ] || rm -f "$entry"
  done < <(for entry in "$ROOT/$session/delivered"/*.txt; do
    [ -f "$entry" ] || continue
    printf '%s\t%s\n' "$(mtime "$entry")" "$entry"
  done | LC_ALL=C sort -rn -k1,1 -k2 | cut -f2-)
}
verb=${1:-}; [ "$#" -gt 0 ] || usage; shift
kind='' id='' session='' file='' event='' context='' reason='' last=10
while [ "$#" -gt 0 ]; do
  case "$1" in
    --kind|--id|--session|--event|--context|--reason|--last)
      [ "$#" -ge 2 ] && [ -n "$2" ] || usage
      case "$verb:$1" in
        post:--kind|emit:--kind|lose:--kind) kind=$2 ;;
        post:--id|emit:--id|lose:--id) id=$2 ;;
        post:--session|lose:--session|flush:--session|list:--session) session=$2; valid_name "$session" || usage ;;
        lose:--reason) reason=$2 ;;
        flush:--event|emit:--event) event=$2 ;;
        emit:--context) context=$2 ;;
        list:--last) last=$2; [[ "$last" =~ ^[0-9]+$ ]] || usage ;;
        *) usage ;;
      esac
      shift 2 ;;
    -*) usage ;;
    *) case "$verb" in post|emit|lose) [ -z "$file" ] || usage; file=$1; shift ;; *) usage ;; esac ;;
  esac
done
case "$verb" in post|emit|lose|flush) live_guard ;; esac
case "$verb" in
  post|emit)
    case "$kind" in review|commit|push|notice|unresolved) ;; *) usage ;; esac
    id=$(printf '%s' "$id" | LC_ALL=C tr -c 'A-Za-z0-9._-\n' '-' | tr '\n' '-')
    case "$id" in .|..) id="report-$id" ;; esac
    body=$(if [ -n "$file" ]; then cat "$file"; else cat; fi; rc=$?; printf '\001'; exit "$rc") || problem 'cannot read body'
    body=${body%$'\001'}
    resolve_session
    [ -n "$id" ] || id=$(printf '%s' "$body" | shasum -a 256 | cut -c1-12)
    document=$body
    if [ "$session" = _orphan ]; then
      document=$(printf '%s' "$body" | jq -c '.rows = [["chat", "unknown"]] + .rows' 2>/dev/null) ||
        refuse_body 'not JSON'
    fi
    tmp=$(mktemp "${TMPDIR:-/tmp}/report-bus.XXXXXX") || problem 'cannot create temporary file'
    rc=0
    rendered=$(printf '%s' "$document" | python3 "$FRAME" block 2>"$tmp") || rc=$?
    if [ "$rc" -ne 0 ]; then
      [ "$rc" = 2 ] && grep -q '^report_frame: ' "$tmp" 2>/dev/null ||
        problem "cannot render report: $(tail -n 1 "$tmp" 2>/dev/null)"
      refuse_body "$(sed 's/^report_frame: //' "$tmp" 2>/dev/null)"
    fi
    body=$rendered
    rm -f "$tmp"
    tmp=''
    valid_name "$id" || problem 'cannot hash body'
    lock_store 2400 || problem 'cannot write queue root or acquire lock'
    if duplicate; then case "$verb" in emit) exit 3 ;; *) exit 0 ;; esac; fi
    mkdir -p "$ROOT/$session/pending" "$ROOT/$session/delivered" 2>/dev/null || problem 'cannot create queue'
    tmp=$(mktemp "$ROOT/.post.XXXXXX") || problem 'cannot create temporary report'
    printf '%s' "$body" | jq -Rs --arg kind "$kind" --arg id "$id" --arg session "$session" \
      '{kind:$kind,id:$id,session:$session,body:.,epoch:now}' \
      >"$tmp" 2>/dev/null || problem 'cannot encode report'
    if [ "$verb" = post ]; then
      stamp=$(jq -r '.epoch * 1000000000 | floor' "$tmp") || problem 'cannot timestamp report'
      mv "$tmp" "$ROOT/$session/pending/${stamp}__${kind}__${id}.txt" 2>/dev/null || problem 'cannot write report'
      tmp='' landed=true
    else
      block=$(render "$tmp" 2>/dev/null) || problem 'cannot render report'
      output=$(hook_output "$block" "$context" "${event:-PostToolUse}") || problem 'cannot encode hook output'
      event=emit
      row=$(history_row "$tmp" "$block") || problem 'cannot encode history'
      printf '%s\n' "$row" >>"$ROOT/history.log" || problem 'cannot append history'
      printf '%s\n' "$output"
      landed=true
    fi ;;
  lose)
    case "$kind" in review|commit|push|notice|unresolved) ;; *) usage ;; esac
    [ -n "$id" ] && [ -n "$reason" ] || usage
    body=$(if [ -n "$file" ]; then cat "$file"; else cat; fi; printf '\001')
    body=${body%$'\001'}
    resolve_session
    mkdir -p "$ROOT" 2>/dev/null
    keep_lost "$reason"
    jq -cn --arg what "$kind $id" --arg r "$reason" --arg log "$ROOT/lost.log" \
      '{word:"report lost", rows:[["lost",$what],["why",$r],["kept in",$log]]}' |
      "$self" post --kind notice --id "lost-$id" --session "$session" ;;
  flush)
    case "$event" in PostToolUse|SubagentStop|Stop|UserPromptSubmit) ;; *) usage ;; esac
    agent='' transcript='' agent_type=''
    if [ -z "$session" ]; then
      payload=$(cat)
      fields=$(printf '%s' "$payload" | jq -er '[.session_id // "", .agent_id // "", .transcript_path // "", .agent_type // ""] | .[]' 2>/dev/null) || exit 0
      { IFS= read -r session; IFS= read -r agent; IFS= read -r transcript; IFS= read -r agent_type; } <<<"$fields"
    fi
    skip_flush && exit 0
    [ -n "$session" ] || resolve_session
    valid_name "$session" || exit 0
    [ -d "$ROOT" ] || exit 0
    has_pending || over_cap || exit 0
    lock_store || { printf 'report-bus: cannot acquire flush lock\n' >&2; exit 0; }
    blocks='' files=() selected=() rows=() total=0 remaining=0
    while IFS= read -r entry; do
      files[total]=$entry
      total=$((total + 1))
    done < <(pending_files)
    reserve=0
    if [ "$event" = Stop ]; then
      reserve=$(printf '\n\n%s' "$(undelivered_block "$total")" | wc -c | tr -d ' ')
    fi
    mkdir -p "$ROOT/$session/delivered" 2>/dev/null || exit 0
    for entry in ${files[@]+"${files[@]}"}; do
      block=$(render "$entry" 2>/dev/null) || continue
      candidate="$blocks${blocks:+$'\n\n'}$block"
      bytes=$(printf '%s' "$candidate" | wc -c | tr -d ' ')
      [ "$((bytes + reserve + 1))" -le "$CAP" ] || [ "${#selected[@]}" -eq 0 ] || break
      row=$(history_row "$entry" "$block" 2>/dev/null) || continue
      selected+=("$entry"); rows+=("$row")
      blocks=$candidate
      [ "$bytes" -le "$CAP" ] || break
    done
    remaining=$((total - ${#selected[@]}))
    if [ "$event" = Stop ] && [ "$remaining" -gt 0 ]; then
      blocks="$blocks${blocks:+$'\n\n'}$(undelivered_block "$remaining")"
    fi
    # A body that renders to nothing is still a delivered report: gating on the text alone
    # left it pending forever, re-read by every later flush and counted undelivered.
    if [ "${#selected[@]}" -gt 0 ] || [ -n "$blocks" ]; then
      output=$(hook_output "$blocks") || exit 0
      printf '%s\n' "$output" || exit 0
      for ((index=0; index<${#selected[@]}; index++)); do
        entry=${selected[index]}
        printf '%s\n' "${rows[index]}" >>"$ROOT/history.log" || continue
        mv "$entry" "$ROOT/$session/delivered/${entry##*/}" || continue
      done
    fi
    prune ;;
  list)
    resolve_session
    [ -f "$ROOT/history.log" ] || exit 0
    jq -rs --arg s "$session" --argjson n "$last" \
      '[.[] | select(.session == $s)] | if $n == 0 then [] else .[-$n:] end | map(.text) | join("\n\n")' "$ROOT/history.log" ;;
  doctor)
    now=$(date +%s)
    live='|_orphan|' parked=0 ended=0
    if [ -n "${REVIEW_BENCH_SESSION_DIR:-}" ]; then registries=("$REVIEW_BENCH_SESSION_DIR"/*.json)
    else registries=("$HOME"/.claude/sessions/*.json "$HOME"/.claude-profiles/*/sessions/*.json); fi
    for entry in "${registries[@]}"; do
      pid=${entry##*/}; pid=${pid%.json}
      [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || continue
      live="$live$(jq -r '.sessionId // empty' "$entry" 2>/dev/null)|"
    done
    for directory in "$ROOT"/*/pending; do
      [ -d "$directory" ] || continue
      stale=0
      for entry in "$directory"/*.txt; do
        [ -f "$entry" ] || continue
        age=$((now - $(mtime "$entry")))
        [ "$age" -le 600 ] || stale=$((stale + 1))
      done
      [ "$stale" -gt 0 ] || continue
      chat=$(basename "${directory%/pending}")
      case "$live" in
        *"|$chat|"*) printf '%s: %s pending older than 10 min — %s\n' "$chat" "$stale" "$directory" ;;
        *) parked=$((parked + stale)); ended=$((ended + 1)) ;;
      esac
    done
    [ "$ended" -eq 0 ] || printf 'ended chats: %s report(s) kept for a resume in %s chat(s)\n' "$parked" "$ended"
    size=0; [ ! -f "$ROOT/lost.log" ] || size=$(wc -c <"$ROOT/lost.log" | tr -d ' ')
    orphan=0
    for entry in "$ROOT/_orphan/pending"/*.txt; do [ ! -f "$entry" ] || orphan=$((orphan + 1)); done
    printf 'lost.log: %s bytes\norphans: %s\n' "$size" "$orphan" ;;
  *) usage ;;
esac
exit 0
exit; }

#!/usr/bin/env python3
"""Per-model leg weather across review cells and worker runs, read passively off the run stores."""
import argparse
import calendar
import json
import os
import re
import statistics
import sys
import time

DEFAULT_WINDOW_H = 24
TREND_D = 7
SLOW_FACTOR = 2
SLOW_MIN_LEGS = 5
TREND_MIN_BAD = 3
MAX_INCIDENTS = 5
DETAIL_MAX = 40
CLASS_ORDER = ("walled", "strayed", "stalled", "killed", "empty", "slow")

# Copied from review-bench share/rbench/panel.py FAILURE_REASONS (and catalog.py's status anchors);
# review-bench is not importable from here, so the two tables drift unless both are edited.
HTTP_STATUS_PREFIX = (r"(?:HTTP(?:/[0-9.]+)?(?:\s+error)?\s*:?\s+"
                      r"|\"?status(?:_code)?\"?\s*[:=]\s*)")
FAILURE_REASONS = (
    ("killed memory", re.compile(r"SIGKILLed by the memory guard")),
    ("pool empty", re.compile(r"has no \w+ account left", re.IGNORECASE)),
    ("walled", re.compile(
        r"GoUsageLimitError|limitName|usage limit|out of credits|usage balance exhaust"
        r"|402 Payment Required|Individual quota reached|RESOURCE_EXHAUSTED"
        r"|exhausted your capacity on this model|walled off while"
        r"|hit the (?:rate|credit) limit for your plan|free-usage-exhausted", re.IGNORECASE)),
    ("throttled", re.compile(
        r"provider_rate_limit_exceeded|rate_limit_error|provider rate limit"
        r"|rate limit exceeded|too many requests", re.IGNORECASE)),
    ("bare 429", re.compile(r"\b429\b")),
    ("bad output", re.compile(
        r"no parseable finding|malformed (?:Markdown|JSON)|no explicit no-issues"
        r"|did not declare a clean review|stopped before reviewing|returned empty content"
        r"|no result event|no assistant message|stopped at the \d+-turn budget"
        r"|without a final message",
        re.IGNORECASE)),
    ("capacity", re.compile(r"at capacity|temporarily unavailable|overloaded", re.IGNORECASE)),
    ("server error", re.compile(HTTP_STATUS_PREFIX + r"(?:5[0-9][0-9]|000)\b")),
    ("root commit", re.compile(r"root commit", re.IGNORECASE)),
    ("permission", re.compile(r"tool required the .command. permission", re.IGNORECASE)),
    ("bad command", re.compile(r"cannot be used with", re.IGNORECASE)),
    ("stalled", re.compile(r"rater stalled", re.IGNORECASE)),
    ("timeout", re.compile(r"timed out|timeout", re.IGNORECASE)),
    ("crashed", re.compile(
        r"rater task crashed|account lookup failed|codex_core::|sandbox_apply", re.IGNORECASE)),
    ("auth", re.compile(
        r"not logged in|not signed in|credentials were rejected|session has expired"
        r"|unauthor|forbidden|\b40[13]\b", re.IGNORECASE)),
    ("not found", re.compile(r"(?:" + HTTP_STATUS_PREFIX + r"404\b|\b404\s+Not\s+Found\b)",
                             re.IGNORECASE)),
    ("chunks unread", re.compile(r"chunks unread", re.IGNORECASE)),
)
WALL_REASONS = ("pool empty", "walled", "throttled")
EMPTY_ZERO_FINDING_REASONS = ("bad output",)

BENCH_ID_RE = re.compile(r"^(\d{8}T\d{6}Z)-[0-9a-f]+$")
WORKER_ID_RE = re.compile(r"^[a-z][a-z0-9]*-(\d{9,11})-\d+-[0-9a-z]+$")
USAGE_LIMIT_RE = re.compile(r"^OUTCOME: \w*_USAGE_LIMIT\b", re.MULTILINE)
OUTSIDE_WRITE_RE = re.compile(
    r"^UNKNOWN: transcript names a write outside the snapshotted repository[^\n]*?: (/[^\n]*)$",
    re.MULTILINE)
UNREPORTED_RE = re.compile(r"^(\d+) path\(s\) changed in the run's window that its own listing does not name",
                           re.MULTILINE)
UNREPORTED_STRAYED = 3
TIMEOUT_RE = re.compile(r"print timeout|timed out", re.IGNORECASE)
PRINT_TIMEOUT_RE = re.compile(r"print timeout after (?:(\d+)m)?(?:(\d+)s)?")
TIMED_OUT_RE = re.compile(r"timed out after (\d+)\s*(?:s\b|seconds)")
SERVED_FLASH_RE = re.compile(r"(?i)gemini[- ]3\.(\d+)[- ]flash")
SERVED_PRO_RE = re.compile(r"(?i)\bpro\b")
ID_LIKE_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-|^[0-9a-f]{12,}$", re.IGNORECASE)


def failure_reason(stderr):
    text = stderr or ""
    for reason, pattern in FAILURE_REASONS:
        if pattern.search(text):
            return reason
    return "unclassified" if text.strip() else "no output"


def base_home():
    return os.environ.get("HOME") or os.path.expanduser("~")


def weather_dir():
    return os.environ.get("LLM_WEATHER_DIR") or os.path.join(base_home(), ".cache", "llm-weather")


def stats_dir():
    return os.environ.get("WORKER_STATS_DIR") or os.path.join(
        base_home(), ".claude-profiles", ".claudeb", "worker-stats")


def runs_dir():
    return os.environ.get("WORKER_RUN_DIR") or os.path.join(base_home(), ".cache", "claude-worker-runs")


def read_json(path):
    try:
        with open(path, encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            return handle.read()
    except OSError:
        return None


def mtime_of(path):
    try:
        return os.stat(path).st_mtime
    except OSError:
        return None


def iso_epoch(value):
    if not isinstance(value, str) or len(value) < 19:
        return None
    try:
        return calendar.timegm(time.strptime(value[:19], "%Y-%m-%dT%H:%M:%S"))
    except ValueError:
        return None


def as_int(value):
    if isinstance(value, bool):
        return None
    if isinstance(value, int):
        return value
    try:
        return int(str(value).strip())
    except (TypeError, ValueError):
        return None


def project_of(path):
    if not isinstance(path, str) or not path:
        return ""
    parts = path.rstrip("/").split("/")
    name = parts[-1]
    for index in range(1, len(parts) - 2):
        if parts[index] == ".claude" and parts[index + 1] == "worktrees":
            name = "%s/%s" % (parts[index - 1], parts[index + 2])
    return "" if ID_LIKE_RE.search(name) else name


def bench_project(meta):
    repo = meta.get("repo")
    if isinstance(repo, str) and "/worker-stats/merged/" in repo:
        for entry in meta.get("repos") or []:
            if isinstance(entry, dict):
                return project_of(entry.get("repo")) or project_of(entry.get("label"))
        return ""
    return project_of(repo)


def bench_model(cell):
    served = cell.get("served_model")
    if isinstance(served, str) and served:
        flash = SERVED_FLASH_RE.search(served)
        if flash:
            return "flash3" + flash.group(1)
        if SERVED_PRO_RE.search(served):
            return "pro"
    model = str(cell.get("model") or "")
    for prefix in ("agy-", "oc-"):
        if model.startswith(prefix):
            return model[len(prefix):]
    return model


def seconds_text(seconds):
    return "" if seconds is None else "%ds" % int(round(seconds))


def timeout_detail(stderr, timeout_s):
    printed = PRINT_TIMEOUT_RE.search(stderr)
    if printed and (printed.group(1) or printed.group(2)):
        seconds = int(printed.group(1) or 0) * 60 + int(printed.group(2) or 0)
        return "print timeout %dm" % (seconds // 60) if seconds >= 60 else "print timeout %ds" % seconds
    timed_out = TIMED_OUT_RE.search(stderr)
    if timed_out:
        return "timeout %ss" % timed_out.group(1)
    if isinstance(timeout_s, (int, float)) and not isinstance(timeout_s, bool) and timeout_s > 0:
        return "timeout %ds" % timeout_s
    return "timeout"


def is_scratch_path(path):
    roots = ["/tmp", "/private/tmp", "/var/folders", "/private/var/folders",
             os.path.join(base_home(), ".cache")]
    if os.environ.get("TMPDIR"):
        roots.append(os.environ["TMPDIR"])
    if "/scratchpad/" in path + "/":
        return True
    return any(path == root.rstrip("/") or path.startswith(root.rstrip("/") + "/") for root in roots)


def age_text(seconds):
    if seconds < 3600:
        return "%dm" % (seconds // 60)
    if seconds < 86400:
        return "%dh" % (seconds // 3600)
    return "%dd" % (seconds // 86400)


def classify_bench(cell, escaped):
    killed = cell.get("killed")
    exit_code = cell.get("exit_code")
    stderr = cell.get("stderr") or ""
    failed = bool(cell.get("errored")) or exit_code not in (0, None) or bool(killed)
    reason = failure_reason(stderr) if failed or stderr.strip() else "no output"
    duration = cell.get("duration_ms")
    duration_s = duration / 1000.0 if isinstance(duration, (int, float)) and duration > 0 else None
    if failed and reason in WALL_REASONS:
        return "walled", reason
    if escaped:
        return "strayed", "outside write"
    stalled_s = cell.get("stalled_s")
    if killed == "stall" or (isinstance(stalled_s, (int, float)) and stalled_s > 0):
        seconds = stalled_s if isinstance(stalled_s, (int, float)) and stalled_s > 0 else duration_s
        return "stalled", ("stall " + seconds_text(seconds)).strip()
    if killed in ("watchdog", "panel", "memory") or exit_code == 124:
        return "killed", ("%s %s" % (killed or "exit 124", seconds_text(duration_s))).strip()
    if failed and TIMEOUT_RE.search(stderr):
        return "killed", timeout_detail(stderr, cell.get("timeout_s"))
    if cell.get("errored") or exit_code not in (0, None):
        return "empty", reason
    if cell.get("findings") == 0 and exit_code == 0 and stderr.strip() \
            and reason in EMPTY_ZERO_FINDING_REASONS:
        return "empty", reason
    return None, ""


def bench_legs(cutoff, now):
    root = os.path.join(stats_dir(), "benches")
    try:
        names = os.listdir(root)
    except OSError:
        return []
    legs = []
    for name in names:
        match = BENCH_ID_RE.match(name)
        run_dir = os.path.join(root, name)
        if match:
            started = calendar.timegm(time.strptime(match.group(1), "%Y%m%dT%H%M%SZ"))
        else:
            started = mtime_of(run_dir)
        if started is None or started < cutoff - 86400:
            continue
        meta = read_json(os.path.join(run_dir, "meta.json"))
        if not isinstance(meta, dict) or meta.get("cancelled"):
            continue
        escapers = set()
        for key in ("write_evidence", "clone_escapes"):
            for hit in meta.get(key) or []:
                if isinstance(hit, (list, tuple)) and hit:
                    escapers.add(hit[0])
        project = bench_project(meta)
        for cell in meta.get("rater_runs") or []:
            if not isinstance(cell, dict):
                continue
            duration = cell.get("duration_ms")
            duration_s = duration / 1000.0 if isinstance(duration, (int, float)) and duration > 0 else None
            ended = iso_epoch(cell.get("finished_at"))
            if ended is None:
                begun = iso_epoch(cell.get("started_at"))
                ended = (begun if begun is not None else started) + (duration_s or 0)
            if ended < cutoff or ended > now + 3600:
                continue
            klass, detail = classify_bench(cell, cell.get("rater") in escapers)
            legs.append({
                "surface": "review", "model": bench_model(cell), "at": ended, "duration": duration_s,
                "class": klass, "detail": detail, "project": project, "ref": name,
            })
    return legs


def kill_detail(line):
    words = line.split()
    if not words:
        return ""
    if len(words) > 1:
        number = words[1].rstrip("s")
        if number.isdigit():
            return "%s %ss" % (words[0], number)
    return words[0]


def classify_worker(run_dir, killed, exit_code):
    kill_word = killed.split()[0] if killed else ""
    if kill_word == "wall":
        return "walled", "wall"
    result = read_text(os.path.join(run_dir, "result")) or ""
    if USAGE_LIMIT_RE.search(result):
        return "walled", "usage limit"
    if os.path.exists(os.path.join(run_dir, "workdir-escape")):
        return "strayed", "workdir-escape"
    note = read_text(os.path.join(run_dir, "files-note")) or ""
    if any(not is_scratch_path(path.strip()) for path in OUTSIDE_WRITE_RE.findall(note)):
        return "strayed", "outside write"
    unreported = max((int(n) for n in UNREPORTED_RE.findall(note)), default=0)
    if unreported >= UNREPORTED_STRAYED:
        return "strayed", "%d unreported paths" % unreported
    if kill_word in ("silent", "idle"):
        return "stalled", kill_detail(killed)
    if kill_word in ("deadline", "term", "signal"):
        return "killed", kill_detail(killed)
    if exit_code in (137, 143):
        return "killed", "exit %d" % exit_code
    if exit_code not in (0, None):
        return "empty", "exit %d" % exit_code
    return None, ""


def worker_legs(cutoff, now):
    root = runs_dir()
    try:
        names = os.listdir(root)
    except OSError:
        return []
    legs = []
    for name in names:
        run_dir = os.path.join(root, name)
        match = WORKER_ID_RE.match(name)
        started = int(match.group(1)) if match else mtime_of(run_dir)
        if started is None or started < cutoff - 86400:
            continue
        tag = read_text(os.path.join(run_dir, "tag"))
        if not tag:
            continue
        fields = [field.strip() for field in tag.strip().split("·")]
        if len(fields) < 2 or not fields[1]:
            continue
        exit_path = os.path.join(run_dir, "exit_code")
        killed_path = os.path.join(run_dir, "killed")
        killed_text = read_text(killed_path)
        killed = (killed_text or "").strip().splitlines()[0].strip() if (killed_text or "").strip() else ""
        exit_text = read_text(exit_path)
        if exit_text is None and not killed:
            continue
        exit_code = as_int(exit_text) if exit_text is not None else None
        ended = mtime_of(exit_path) or mtime_of(killed_path) or started
        if ended < cutoff or ended > now + 3600:
            continue
        klass, detail = classify_worker(run_dir, killed, exit_code)
        meta = read_json(os.path.join(run_dir, "meta.json")) or {}
        legs.append({
            "surface": "worker", "model": fields[1], "at": ended,
            "duration": ended - started if match and ended > started else None,
            "class": klass, "detail": detail, "project": project_of(meta.get("workdir")), "ref": name,
        })
    return legs


def mark_slow(legs):
    durations = {}
    for leg in legs:
        if leg["duration"] is not None:
            durations.setdefault((leg["surface"], leg["model"]), []).append(leg["duration"])
    medians = {key: statistics.median(values) for key, values in durations.items()
               if len(values) >= SLOW_MIN_LEGS}
    for leg in legs:
        median = medians.get((leg["surface"], leg["model"]))
        if leg["class"] is None and median and leg["duration"] is not None \
                and leg["duration"] > SLOW_FACTOR * median:
            leg["class"] = "slow"
            unit = 60 if median >= 60 else 1
            leg["detail"] = "%d%s vs %d%s median" % (
                round(leg["duration"] / unit), "m" if unit == 60 else "s", round(median / unit),
                "m" if unit == 60 else "s")


def trend_of(window_legs, window_bad, trend_legs, trend_bad):
    rate = window_bad / window_legs if window_legs else 0.0
    trend_rate = trend_bad / trend_legs if trend_legs else 0.0
    if window_bad >= TREND_MIN_BAD and rate >= 2 * trend_rate:
        return "up"
    if trend_bad >= TREND_MIN_BAD and rate <= 0.5 * trend_rate:
        return "down"
    return ""


def collect(window_h, now):
    trend_h = max(TREND_D * 24, window_h)
    trend_cutoff = now - trend_h * 3600
    window_cutoff = now - window_h * 3600
    legs = bench_legs(trend_cutoff, now) + worker_legs(trend_cutoff, now)
    mark_slow(legs)
    per_model = {}
    for leg in legs:
        entry = per_model.setdefault(leg["model"], {
            "surfaces": set(), "legs": 0, "bad": 0, "classes": {}, "trend_legs": 0, "trend_bad": 0,
            "incidents": [],
        })
        entry["trend_legs"] += 1
        entry["trend_bad"] += 1 if leg["class"] else 0
        if leg["at"] < window_cutoff:
            continue
        entry["surfaces"].add(leg["surface"])
        entry["legs"] += 1
        if leg["class"]:
            entry["bad"] += 1
            entry["classes"][leg["class"]] = entry["classes"].get(leg["class"], 0) + 1
            entry["incidents"].append(leg)
    models = []
    for model, entry in per_model.items():
        if not entry["legs"] or not model:
            continue
        incidents = []
        for leg in sorted(entry["incidents"], key=lambda item: -item["at"])[:MAX_INCIDENTS]:
            age = max(0, int(now - leg["at"]))
            incidents.append({
                "age_s": age, "age": age_text(age), "surface": leg["surface"], "project": leg["project"],
                "class": leg["class"], "detail": leg["detail"][:DETAIL_MAX], "ref": leg["ref"],
            })
        models.append({
            "model": model,
            "surfaces": [surface for surface in ("review", "worker") if surface in entry["surfaces"]],
            "legs": entry["legs"],
            "bad": entry["bad"],
            "classes": {name: entry["classes"][name] for name in CLASS_ORDER if entry["classes"].get(name)},
            "trend": trend_of(entry["legs"], entry["bad"], entry["trend_legs"], entry["trend_bad"]),
            "incidents": incidents,
        })
    models.sort(key=lambda item: (-item["bad"], -item["legs"], item["model"]))
    worst = []
    for item in models:
        if item["bad"] <= 0 or len(worst) == 2:
            break
        top = max(item["classes"].items(), key=lambda pair: (pair[1], -CLASS_ORDER.index(pair[0])))
        worst.append("%s %s ×%d" % (item["model"], top[0], top[1]))
    return {"as_of": int(now), "window_h": window_h, "trend_d": TREND_D, "models": models,
            "worst": " · ".join(worst)}


def write_cache(report):
    directory = weather_dir()
    os.makedirs(directory, exist_ok=True)
    target = os.path.join(directory, "latest.json")
    temporary = "%s.tmp.%d" % (target, os.getpid())
    with open(temporary, "w", encoding="utf-8") as handle:
        json.dump(report, handle, ensure_ascii=False, indent=1)
        handle.write("\n")
    os.replace(temporary, target)
    return target


def main(argv):
    parser = argparse.ArgumentParser(prog="llm-weather", description=__doc__.splitlines()[0])
    parser.add_argument("--window", type=int, default=DEFAULT_WINDOW_H, metavar="H")
    parser.add_argument("--json", action="store_true", help="print the document instead of writing it")
    parser.add_argument("--dry-run", action="store_true", help="do not write latest.json")
    args = parser.parse_args(argv)
    if args.window <= 0:
        parser.error("--window must be a positive number of hours")
    now_override = os.environ.get("LLM_WEATHER_NOW")
    now = float(now_override) if now_override else time.time()
    report = collect(args.window, now)
    if args.json:
        sys.stdout.write(json.dumps(report, ensure_ascii=False) + "\n")
        return 0
    if not args.dry_run:
        try:
            write_cache(report)
        except OSError as error:
            print("llm-weather: cache not written: %s" % error, file=sys.stderr)
            return 1
    print("llm-weather: %d models · %s" % (len(report["models"]), report["worst"] or "ok"))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

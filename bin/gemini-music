#!/usr/bin/env bash
# One group, parsed whole before it runs: bash reads a script as it goes, so an in-place edit
# mid-run fed a running leg shifted bytes (2026-10-02). The closing `exit` and `}` stay last.
{
set -euo pipefail

command -v jq >/dev/null 2>&1 || { printf 'gemini-music: jq is required\n' >&2; exit 1; }

resolve_root() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}

root=$(resolve_root)
. "$root/share/image-leg.sh"
. "$root/share/account-arg.sh"
image_leg_start gemini-music audio observed_model
. "$root/share/image-caps.sh"
caps() { image_caps_get "$root" gemini "$1"; }

usage() {
  image_leg_cause "$@"
  printf 'usage: gemini-music --dest <absolute .wav|.mp3|.mp4 path> --prompt <brief> [--route app|flow] [--model %s] [--length short|standard] [--instrumental | --vocals] [--genre <%s>] [--ref-image <absolute image>] [--video <absolute mp4>] [--count 1|2|3] [--account <profile>] [--dry-run]\n' \
    "$(caps '.flow_music.models | keys | join("|")')" "$(caps '.music.genres | join("|")')" >&2
  printf '  flow only: [--format %s] [--duration <%s-%s s>] [--lyrics <text>] [--bpm <n>] [--seed <n>] [--ref-audio <absolute audio, <= %s MB>] [--stems] [--accounts 1-%s]\n' \
    "$(caps '.flow_music.formats | keys | join("|")')" "$(caps '.flow_music.duration_s[0]')" "$(caps '.flow_music.duration_s[1]')" \
    "$(caps '.flow_music.ref_audio_max_mb')" "$(caps '.flow_music.max_accounts')" >&2
  printf '  edit (implies --route flow): --edit <library title | absolute audio> --mode %s [--from <s>] [--to <s>] [--strength 0-1] [--prompt <instruction>] [--lyrics <text>] [--seed <n>] [--stems]\n' \
    "$(caps '.flow_music.edit | keys | join("|")')" >&2
  printf '  a library title needs the --account it lives on; a file a flow run saved edits its library song on its account (Title:/Account: in <file>.txt); any other audio is uploaded, which Flow refuses in this region\n' >&2
  printf '  --route app (default): the Gemini app'\''s Create music tool (Lyria 3.5) on a subscription account, through the hidden Chrome of gemini-web\n' >&2
  printf '  --route flow: Google Flow Music (flowmusic.app; --model lyria-3-pro implies it), %s credits a song from its own pool; the dest extension is the download format (.mp3 .wav .m4a); --stems saves <dest>-<stem>.<ext> next to the track; --accounts N runs N accounts at once and keeps every take\n' \
    "$(caps '.flow_music.price_per_song')" >&2
  printf '  short is about 60 s, standard 2-3 min; the track comes as mp3 192 kb/s (a .wav dest is decoded from it) or an mp4 with cover art\n' >&2
  printf '  <dest>.txt keeps the tool'\''s own description of the take (tempo, sections with start times) and Gemini'\''s reply\n' >&2
  printf '  timed hit points belong in the prompt as words ("at 24 s the energy builds"); see docs/image-vendors/gemini.md\n' >&2
  exit 2
}

say() {
  image_leg_cause "$1"
  exit 2
}

dest=''
prompt=''
length=''
vocals=''
genre=''
account=''
count=1
dry_run=false
attach=()
route=''
model=''
format=''
duration=''
lyrics=''
bpm=''
seed=''
ref_audio=''
stems=false
accounts=1
flow_flags=()
edit=''
mode=''
from_s=''
to_s=''
strength=''
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help) image_leg_help usage ;;
    --dest) [ "$#" -ge 2 ] || usage "$1 needs a value"; dest=$2; shift 2 ;;
    --prompt) [ "$#" -ge 2 ] || usage "$1 needs a value"; prompt=$2; shift 2 ;;
    --length) [ "$#" -ge 2 ] || usage "$1 needs a value"; length=$2; shift 2 ;;
    --instrumental) [ -z "$vocals" ] || usage "pass --instrumental or --vocals once"; vocals=instrumental; shift ;;
    --vocals) [ -z "$vocals" ] || usage "pass --instrumental or --vocals once"; vocals=on; shift ;;
    --genre) [ "$#" -ge 2 ] || usage "$1 needs a value"; genre=$2; shift 2 ;;
    --ref-image | --video) [ "$#" -ge 2 ] || usage "$1 needs a value"; attach+=("$1=$2"); shift 2 ;;
    --count) [ "$#" -ge 2 ] || usage "$1 needs a value"; count=$2; shift 2 ;;
    --account) [ "$#" -ge 2 ] || usage "$1 needs a value"; account_arg "$2"; account=$2; shift 2 ;;
    --dry-run) dry_run=true; shift ;;
    --route) [ "$#" -ge 2 ] || usage "$1 needs a value"; route=$2; shift 2 ;;
    --model) [ "$#" -ge 2 ] || usage "$1 needs a value"; model=$2; shift 2 ;;
    --format) [ "$#" -ge 2 ] || usage "$1 needs a value"; format=$2; flow_flags+=(--format); shift 2 ;;
    --duration) [ "$#" -ge 2 ] || usage "$1 needs a value"; duration=$2; flow_flags+=(--duration); shift 2 ;;
    --lyrics) [ "$#" -ge 2 ] || usage "$1 needs a value"; lyrics=$2; flow_flags+=(--lyrics); shift 2 ;;
    --bpm) [ "$#" -ge 2 ] || usage "$1 needs a value"; bpm=$2; flow_flags+=(--bpm); shift 2 ;;
    --seed) [ "$#" -ge 2 ] || usage "$1 needs a value"; seed=$2; flow_flags+=(--seed); shift 2 ;;
    --ref-audio) [ "$#" -ge 2 ] || usage "$1 needs a value"; ref_audio=$2; flow_flags+=(--ref-audio); shift 2 ;;
    --stems) stems=true; flow_flags+=(--stems); shift ;;
    --accounts) [ "$#" -ge 2 ] || usage "$1 needs a value"; accounts=$2; shift 2 ;;
    --edit) [ "$#" -ge 2 ] || usage "$1 needs a value"; edit=$2; shift 2 ;;
    --mode) [ "$#" -ge 2 ] || usage "$1 needs a value"; mode=$2; shift 2 ;;
    --from) [ "$#" -ge 2 ] || usage "$1 needs a value"; from_s=$2; shift 2 ;;
    --to) [ "$#" -ge 2 ] || usage "$1 needs a value"; to_s=$2; shift 2 ;;
    --strength) [ "$#" -ge 2 ] || usage "$1 needs a value"; strength=$2; shift 2 ;;
    *) usage "unknown argument $1" ;;
  esac
done

[ -n "$dest" ] || usage "missing --dest"
[ -n "$edit" ] || [ -z "$mode$from_s$to_s$strength" ] || usage "--mode, --from, --to and --strength edit a song: add --edit"
[ -n "$edit" ] || [ -n "$prompt" ] || usage "missing --prompt"
[[ "$dest" = /* ]] || say "--dest must be an absolute path, not $dest"
[ -d "$(dirname "$dest")" ] || say "--dest folder $(dirname "$dest") does not exist"
ext=$(printf '%s' "${dest##*.}" | tr '[:upper:]' '[:lower:]')
[ -z "$model" ] || jq -e --arg v "$model" '.flow_music.models | has($v)' "$(image_caps_file "$root" gemini)" >/dev/null ||
  say "--model is one of: $(caps '.flow_music.models | keys | join(", ")')"
check_audio() { # flag path
  [[ "$2" = /* ]] && [ -f "$2" ] || say "$1 needs an absolute path to a file"
  case "$(printf '%s' "${2##*.}" | tr '[:upper:]' '[:lower:]')" in mp3 | wav | m4a | aac | flac | ogg) ;;
    *) say "$1 takes an mp3, wav, m4a, aac, flac or ogg file" ;; esac
  [ "$(wc -c <"$2")" -le $(($(caps '.flow_music.ref_audio_max_mb') * 1048576)) ] ||
    say "$1 is over Flow Music's $(caps '.flow_music.ref_audio_max_mb') MB upload limit"
}
if [ -n "$edit" ]; then
  [ "$route" != app ] || say "--edit runs on --route flow: the Gemini app's music tool edits no audio"
  route=flow
  [ -n "$mode" ] || say "--edit needs --mode $(caps '.flow_music.edit | keys | join("|")')"
  jq -e --arg v "$mode" '.flow_music.edit | has($v)' "$(image_caps_file "$root" gemini)" >/dev/null ||
    say "--mode is one of: $(caps '.flow_music.edit | keys | join(", ")')"
  for item in "--duration:$duration" "--length:$length" "--bpm:$bpm" "--genre:$genre" "--ref-audio:$ref_audio" \
    "--model:$model" "--instrumental/--vocals:$vocals"; do
    [ -z "${item#*:}" ] || say "${item%%:*} makes a new song; an --edit keeps its source's model, length and style"
  done
  case "$mode" in
    variation | trim)
      [ -z "$prompt$lyrics$seed" ] || say "--mode $mode takes no --prompt, --lyrics or --seed" ;;
    *) [ -n "$prompt$lyrics" ] || say "--mode $mode needs --prompt (the instruction) or --lyrics" ;;
  esac
  for number in "$from_s" "$to_s"; do [ -z "$number" ] || [[ "$number" =~ ^[0-9]+$ ]] || say "--from and --to are whole seconds"; done
  case "$mode" in
    cover | variation) [ -z "$from_s$to_s" ] || say "--mode $mode edits the whole song: no --from or --to" ;;
    extend)
      [ -n "$to_s" ] || say "--mode extend needs --to <s>, the new total length"
      [ -z "$from_s" ] || { [ "$((to_s - from_s))" -ge "$(caps '.flow_music.edit.extend.window_s[0]')" ] &&
        [ "$((to_s - from_s))" -le "$(caps '.flow_music.edit.extend.window_s[1]')" ]; } ||
        say "--mode extend makes $(caps '.flow_music.edit.extend.window_s | join("-")') s of new music: --to minus --from" ;;
    *) [ -n "$from_s" ] && [ -n "$to_s" ] && [ "$from_s" -lt "$to_s" ] || say "--mode $mode needs --from <s> before --to <s>" ;;
  esac
  [ -z "$strength" ] || [ "$mode" = cover ] || say "--strength belongs to --mode cover"
  [ -z "$strength" ] || [[ "$strength" =~ ^(0(\.[0-9]{1,2})?|1(\.0{1,2})?)$ ]] || say "--strength is 0 to 1 in steps of 0.01"
  [ "$mode" != trim ] || [ "$count" = 1 ] || say "--mode trim cuts one exact span: --count 1"
  if [[ "$edit" = /* ]] && [ -f "$edit.txt" ] && grep -q '^Title: ' "$edit.txt" && grep -q '^Account: ' "$edit.txt"; then
    owner=$(sed -n 's/^Account: //p' "$edit.txt" | head -n 1)
    [ -z "$account" ] || [ "$account" = "$owner" ] || say "--edit $edit is a Flow Music song on $owner, not $account"
    account=$owner
    edit=$(sed -n 's/^Title: //p' "$edit.txt" | head -n 1)
  elif [[ "$edit" = /* ]]; then
    check_audio --edit "$edit"
  else
    [ -n "$account" ] || say "--edit $edit is a library title, which lives on one account: add --account"
  fi
  [[ "$edit" = /* ]] || [ "$accounts" -eq 1 ] || say "a library song lives on one account: no --accounts"
fi
if [ "$model" = lyria-3-pro ]; then
  [ "$route" != app ] || say "lyria-3-pro is not offered by the Gemini app's music tool; it runs on --route flow"
  route=flow
fi
route=${route:-app}
case "$route" in app | flow) ;; *) say "--route is app or flow" ;; esac
[[ "$accounts" =~ ^[1-9][0-9]*$ ]] && [ "$accounts" -le "$(caps '.flow_music.max_accounts')" ] ||
  say "--accounts is 1 to $(caps '.flow_music.max_accounts')"
if [ "$route" = app ]; then
  [ "${flow_flags[0]:-}" != --duration ] ||
    say "the app's music tool takes no exact length: --length short (about 60 s) or standard (2-3 min), then cut to picture; --route flow takes --duration"
  [ "${#flow_flags[@]}" -eq 0 ] ||
    say "${flow_flags[0]} runs on --route flow (Google Flow Music); the Gemini app's music tool takes no exact length, lyrics, bpm, seed, reference audio, stems or download format"
  [ "$accounts" -eq 1 ] || say "--accounts runs on --route flow; the app route moves to the next account on its own"
  jq -e --arg ext "$ext" '.music.dests | index($ext) != null' "$(image_caps_file "$root" gemini)" >/dev/null ||
    say "--dest must end in .$(caps '.music.dests | join(" .")')"
else
  [ "${#attach[@]}" -eq 0 ] || say "${attach[0]%%=*} runs on the app route; Flow Music takes reference audio (--ref-audio), no image or video"
  jq -e --arg ext "$ext" '.flow_music.formats | has($ext)' "$(image_caps_file "$root" gemini)" >/dev/null ||
    say "--dest on --route flow must end in .$(caps '.flow_music.formats | keys | join(" .")')"
  [ -z "$format" ] || [ "$format" = "$ext" ] || say "--format $format needs a .$format dest"
  [ -z "$duration" ] || { [[ "$duration" =~ ^[0-9]+$ ]] && [ "$duration" -ge "$(caps '.flow_music.duration_s[0]')" ] &&
    [ "$duration" -le "$(caps '.flow_music.duration_s[1]')" ]; } ||
    say "--duration is $(caps '.flow_music.duration_s[0]') to $(caps '.flow_music.duration_s[1]') seconds on Flow Music"
  [ -z "$duration" ] || [ -z "$length" ] || say "--duration and --length are one choice"
  for number in "$bpm" "$seed"; do [ -z "$number" ] || [[ "$number" =~ ^[0-9]+$ ]] || say "--bpm and --seed are whole numbers"; done
  [ -z "$lyrics" ] || [ "$vocals" != instrumental ] || say "--lyrics and --instrumental are one choice"
  [ -z "$ref_audio" ] || check_audio --ref-audio "$ref_audio"
fi
[ -z "$length" ] || jq -e --arg v "$length" '.music.lengths | has($v)' "$(image_caps_file "$root" gemini)" >/dev/null ||
  say "--length is short or standard"
[ -z "$genre" ] || jq -e --arg v "$genre" '.music.genres | index($v) != null' "$(image_caps_file "$root" gemini)" >/dev/null ||
  say "--genre is one of: $(caps '.music.genres | join(", ")')"
jq -e --argjson n "${count//[^0-9]/0}" '.music.counts | index($n) != null' "$(image_caps_file "$root" gemini)" >/dev/null 2>&1 ||
  say "--count is 1, 2 or 3"
[ -z "$account" ] || [[ "$account" =~ ^[a-z0-9][a-z0-9-]*$ ]] || usage "--account $account is not a profile name"
[ -z "$account" ] || [ "$accounts" -eq 1 ] || say "--account names one account; --accounts picks several"
engine_args=(generate)
[ -z "$prompt" ] || engine_args+=(--prompt "$prompt")
engine_args+=(--count "$count")
for item in ${attach[@]+"${attach[@]}"}; do
  path=${item#*=}
  [[ "$path" = /* ]] && [ -f "$path" ] || say "${item%%=*} needs an absolute path to a file"
  case "${item%%=*}:$(printf '%s' "${path##*.}" | tr '[:upper:]' '[:lower:]')" in
    --ref-image:png | --ref-image:jpg | --ref-image:jpeg | --ref-image:webp | --video:mp4 | --video:mov) ;;
    *) say "--ref-image takes a png, jpg or webp image, --video an mp4 or mov" ;;
  esac
  engine_args+=(--attach "$path")
done
[ -z "$length" ] || engine_args+=(--length "$length")
[ -z "$vocals" ] || engine_args+=(--vocals "$vocals")
[ -z "$genre" ] || engine_args+=(--genre "$genre")
if [ "$route" = flow ]; then
  [ "$vocals" != custom ] || vocals=''
  engine_args+=(--format "$ext" --title "$(basename "${dest%.*}")" --accounts "$accounts")
  [ -z "$model" ] || engine_args+=(--model "$model")
  [ -z "$duration" ] || engine_args+=(--duration "$duration")
  [ -z "$lyrics" ] || engine_args+=(--lyrics "$lyrics")
  [ -z "$bpm" ] || engine_args+=(--bpm "$bpm")
  [ -z "$seed" ] || engine_args+=(--seed "$seed")
  [ -z "$ref_audio" ] || engine_args+=(--ref-audio "$ref_audio")
  [ "$stems" = false ] || engine_args+=(--stems)
  [ -z "$edit" ] || engine_args+=(--edit "$edit" --mode "$mode")
  [ -z "$from_s" ] || engine_args+=(--from "$from_s")
  [ -z "$to_s" ] || engine_args+=(--to "$to_s")
  [ -z "$strength" ] || engine_args+=(--strength "$strength")
fi
[ -z "$account" ] || engine_args+=(--account "$account")
[ "$dry_run" = false ] || engine_args+=(--dry-run)
command -v ffmpeg >/dev/null 2>&1 || { printf 'gemini-music: ffmpeg is required\n' >&2; exit 1; }

started=$(date +%s)
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/gemini-music.XXXXXX")
trap 'image_leg_exit; rm -rf "$tmp_dir"' EXIT
engine_args+=(--out-dir "$tmp_dir")
image_leg_mark "$((count * accounts))"
rc=0
engine_file=gemini_music.py
engine_override=${GEMINI_MUSIC_ENGINE:-}
if [ "$route" = flow ]; then
  engine_file=flow_music.py
  engine_override=${FLOW_MUSIC_ENGINE:-}
fi
if [ -n "$engine_override" ]; then
  "$engine_override" "${engine_args[@]}" >"$tmp_dir/engine.out" 2>"$tmp_dir/engine.err" || rc=$?
else
  uv_cmd=${GEMINI_WEB_UV:-$(command -v uv || printf /opt/homebrew/bin/uv)}
  "$uv_cmd" run -q --script "$root/share/$engine_file" "${engine_args[@]}" >"$tmp_dir/engine.out" 2>"$tmp_dir/engine.err" || rc=$?
fi
grep '^BROWSER_' "$tmp_dir/engine.err" >&2 || true
result=$(grep '^{' "$tmp_dir/engine.out" | tail -n 1 || true)
if ! jq -e . >/dev/null 2>&1 <<<"$result"; then
  tail -n 15 "$tmp_dir/engine.err" >&2
  printf 'gemini-music: the engine printed no result (exit %s)\n' "$rc" >&2
  exit 1
fi
if [ "$(jq -r '.ok' <<<"$result")" != true ]; then
  reason=$(jq -r '.reason // "unknown failure"' <<<"$result")
  case "$rc" in
    3) printf 'GEMINI_USAGE_LIMIT\ngemini-music: %s\n' "$reason" >&2; exit 3 ;;
    4) printf 'gemini-music: %s\n' "$reason" >&2; exit 4 ;;
    2) printf 'gemini-music: %s\n' "$reason" >&2; exit 2 ;;
    *) printf 'gemini-music: %s\n' "$reason" >&2; exit 1 ;;
  esac
fi
account=$(jq -r '.account' <<<"$result")
if [ "$(jq -r '.dry_run // false' <<<"$result")" = true ]; then
  if [ "$route" = flow ]; then
    printf 'dry_run=ok\naccount=%s\ncontrols=%s\n' "$account" "$(jq -c '.controls // .runs' <<<"$result")"
  else
    printf 'dry_run=ok\naccount=%s\nchips=%s\n' "$account" "$(jq -c '.chips' <<<"$result")"
  fi
  exit 0
fi

variant_of() { # index
  if [ "$1" -eq 1 ]; then printf '%s' "$dest"; else printf '%s-%s.%s' "${dest%.*}" "$1" "$ext"; fi
}
takes=$(jq -r '.takes | length' <<<"$result")
[ "$takes" -ge 1 ] || { printf 'gemini-music: the engine returned no take\n' >&2; exit 1; }
index=0
footer=''
while [ "$index" -lt "$takes" ]; do
  take=$(jq -c ".takes[$index]" <<<"$result")
  index=$((index + 1))
  out=$(variant_of "$index")
  audio=$(jq -r '.audio' <<<"$take")
  [ -s "$audio" ] || { printf 'gemini-music: take %s has no audio file\n' "$index" >&2; exit 1; }
  case "$route:$ext" in
    flow:*) cp "$audio" "$out" ;;
    *:mp3) cp "$audio" "$out" ;;
    *:wav) ffmpeg -v error -y -i "$audio" -c:a pcm_s16le -ar 48000 -ac 2 "$out" ||
      { printf 'gemini-music: could not decode take %s to wav\n' "$index" >&2; exit 1; } ;;
    *:mp4)
      video=$(jq -r '.video // empty' <<<"$take")
      [ -n "$video" ] && [ -s "$video" ] ||
        { printf 'gemini-music: take %s came without its mp4: %s\n' "$index" "$(jq -r '.video_error // "none offered"' <<<"$take")" >&2; exit 1; }
      cp "$video" "$out" ;;
  esac
  [ "$ext" = mp4 ] || [ "$(jq -r '.video_error // empty' <<<"$take")" = '' ] ||
    printf 'gemini-music: take %s: the cover-art mp4 did not download (%s); the audio is fine\n' "$index" "$(jq -r '.video_error' <<<"$take")" >&2
  if [ "$route" = flow ]; then
    jq -r '.notes' <<<"$take" >"$out.txt"
  else
    jq -r '"Model: \(.model // "unknown")\nChat: \(.url)\n\nThe music tool'"'"'s description of the take:\n\(.description)\n\nGemini'"'"'s reply:\n\(.text)"' <<<"$take" >"$out.txt"
  fi
  stem_lines=''
  while IFS=$'\t' read -r stem_name stem_file; do
    [ -n "$stem_name" ] || continue
    [ -s "$stem_file" ] || { printf 'gemini-music: take %s has no %s stem file\n' "$index" "$stem_name" >&2; exit 1; }
    cp "$stem_file" "${out%.*}-$stem_name.$ext"
    stem_lines+="stem=${out%.*}-$stem_name.$ext"$'\n'
  done < <(jq -r '(.stems // {}) | to_entries[] | "\(.key)\t\(.value)"' <<<"$take")
  seconds=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$out" 2>/dev/null | head -n 1)
  observed_model=$(jq -r '.model // empty' <<<"$take")
  if [ "$index" -eq 1 ]; then
    footer+="dest=$out"$'\n'"duration=$(awk -v s="$seconds" 'BEGIN { printf "%.2f", s }')"$'\n'
    footer+="format=$ext"$'\n'"chat=$(jq -r '.url' <<<"$take")"$'\n'"$stem_lines"
  else
    take_account=$(jq -r '.account // empty' <<<"$take")
    footer+="variant=$out duration=$(awk -v s="$seconds" 'BEGIN { printf "%.2f", s }') chat=$(jq -r '.url' <<<"$take")"
    [ -z "$take_account" ] || [ "$take_account" = "$account" ] || footer+=" account=$take_account"
    footer+=$'\n'"$stem_lines"
  fi
done
short=$(jq -r '.short // empty' <<<"$result")
if [ -n "$short" ]; then
  printf 'gemini-music: only %s\n' "$short" >&2
  footer+="short=$short"$'\n'
fi
if [ "$route" = flow ]; then
  credits=$(jq -r '"\([.takes[] | (.charged // 0) + (.stems_charged // 0)] | add) charged from the Flow Music pool; left: \([.takes[] | "\(.account) \(.credits)"] | unique | join(", "))"' <<<"$result")
else
  credits='unmetered (the Gemini app shows no music balance)'
fi
printf '%saccount=%s\nmodel=%s\ncredits=%s\nseconds=%s\n' \
  "$footer" "$account" "${observed_model:-unknown}" "$credits" "$(($(date +%s) - started))"
exit
}

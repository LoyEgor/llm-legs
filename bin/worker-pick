#!/usr/bin/env bash
# Token-free routing advisor for worker=auto: reads ~/.llm-limits.json,
# account tiers and claudebd state, prints codex/claude pressure and a
# concrete NEXT/POLICY recommendation the orchestrator follows when choosing
# the implementation worker. Also writes a compact one-line cache for the
# statusline (per own-account, since routing excludes the session's account).
#
# Key rules encoded here (thresholds live ONLY in this script):
# - codex pressure: <50% FRESH, <85% OK, <95% TIGHT, else WALLED.
# - accounts are weighted by subscription tier (~/.claude-profiles/.claudeb/
#   account-tiers, `name=usd`, default 100): 30% left on a $20 account is far
#   less real headroom than 30% on a $100 one.
# - the session's OWN account is excluded from worker routing so heavy
#   delegation can never wall the session that still has work to finish.
set -u

LIMITS_FILE="${LLM_LIMITS_FILE:-$HOME/.llm-limits.json}"
WORKER_FILE="$HOME/.claude/worker-model"
TIERS_FILE="${CLAUDEB_DIR:-$HOME/.claude-profiles/.claudeb}/account-tiers"
CACHE_DIR="$HOME/.cache"
now=$(date +%s)

conf() { sed -n "s/^$1=//p" "$WORKER_FILE" 2>/dev/null | head -n1; }

own="${CLAUDE_LIMITS_ACCOUNT:-}"
if [ -z "$own" ] || [ "$own" = "-" ]; then
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ] && [ "$CLAUDE_CONFIG_DIR" != "$HOME/.claude" ]; then
    own=$(basename "$CLAUDE_CONFIG_DIR")
  else
    own=main
  fi
fi
cache_file="$CACHE_DIR/worker-pick.line.$own"

write_cache() {
  # Atomic: statusline polls this file every 5s and must never see a torn read.
  tmp="$cache_file.tmp.$$"
  printf '%s\n' "$1" > "$tmp" 2>/dev/null && mv -f "$tmp" "$cache_file" 2>/dev/null
  rm -f "$tmp" 2>/dev/null
}

fail_safe() {
  echo "NEXT: claudeb (rotating) — $1"
  write_cache 'cb~?'
  exit 0
}

[ -r "$LIMITS_FILE" ] || fail_safe "no limits data, fail-safe to Claude side"

tiers_json=$(awk -F= 'NF==2 {printf "%s\"%s\":%s", sep, $1, $2; sep=","} END {print ""}' sep="" "$TIERS_FILE" 2>/dev/null)
tiers_json="{${tiers_json:-}}"
printf '%s' "$tiers_json" | jq -e . >/dev/null 2>&1 || tiers_json='{}'

cb_model=$(conf claudeb_model); cb_model=${cb_model:-opus}
cb_effort=$(conf claudeb_effort); cb_effort=${cb_effort:-high}
cx_effort=$(conf codex_effort); cx_effort=${cx_effort:-high}
cb_pin=$(conf claudeb_profile)

summary=$(jq -r --argjson now "$now" --argjson tiers "$tiers_json" --arg own "$own" '
  def epoch:
    if type == "number" then .
    elif type == "string" then
      (capture("^(?<d>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(\\.[0-9]+)?(?<tz>Z|[+-][0-9]{2}:?[0-9]{2})?$") // null
       | if . == null then null
         else (.d + "Z" | fromdateiso8601)
           - (if .tz == null or .tz == "Z" then 0
              else (.tz | capture("^(?<s>[+-])(?<h>[0-9]{2}):?(?<m>[0-9]{2})$")
                    | (if .s == "-" then -1 else 1 end) * ((.h | tonumber) * 3600 + (.m | tonumber) * 60))
              end)
         end)
    else null end;
  def eff(b): (b // {}) as $b | (($b.resets_at // null) | epoch) as $r |
    if (($b.used_pct // null) | type) != "number" then null
    elif $r != null and $r <= $now then 0
    else ($b.effective_pct // $b.used_pct) end;
  def reset_str(b): ((b // {}).resets_at // null) | epoch |
    if . == null then "?" elif (. - $now) < 86400 then strflocaltime("%H:%M") else strflocaltime("%b %d %H:%M") end;

  (.fetched_at | epoch) as $fetched |
  (if $fetched == null then "no timestamp"
   elif ($now - $fetched) > 7200 then "STALE (\((($now - $fetched) / 60) | floor) min old)"
   else "fresh (\((($now - $fetched) / 60) | floor) min old)" end) as $age |

  (.vendors.codex as $cx |
   if ($cx.available // false) != true then {state: "WALLED", line: "codex: unavailable", acct: ""}
   else
     ([($cx.accounts // [{account:"main", five_hour:($cx.five_hour // {}), weekly:($cx.weekly // {})}])[]
       | select(.auth_needed != true)
       | {name: .account,
          p: ([eff(.five_hour), eff(.weekly)] | map(select(. != null)) | (if length == 0 then 0 else max end)),
          r5: reset_str(.five_hour), rw: reset_str(.weekly)}] | sort_by(.p)) as $accs |
     if ($accs | length) == 0 then {state: "WALLED", line: "codex: no authenticated accounts", acct: ""}
     else ($accs[0]) as $best |
       {state: (if $best.p < 50 then "FRESH" elif $best.p < 85 then "OK" elif $best.p < 95 then "TIGHT" else "WALLED" end),
        acct: $best.name,
        line: ("codex: " + ($accs | map("\(.name) \(.p)% (5h→\(.r5), wk→\(.rw))") | join(", ")))}
     end
   end) as $codex |

  ([.vendors.claude.accounts[]? | select(.enabled == true)
    | {name: .account,
       tier: ($tiers[.account] // 100),
       own: (.account == $own),
       h5: (eff(.five_hour) // 100), r5: reset_str(.five_hour),
       wk: (eff(.weekly) // 100),
       soon: ((((.five_hour // {}).resets_at // null) | epoch) as $r | $r != null and ($r - $now) < 3600 and ($r - $now) > 0)}
    | .headroom = (.tier * (100 - .h5) / 100)
   ] | sort_by(-.headroom)) as $cl |

  ($cl | map(select((.own | not) and .h5 < 85 and .wk < 95))) as $eligible |
  (if ($eligible | length) > 0 then $eligible[0].name else "" end) as $rec |
  ($cl | map(select((.own | not) and .soon and .h5 >= 30 and .h5 < 85 and .wk < 95)
             | "\(.name) ($\(.tier), 5h resets \(.r5))") | join(", ")) as $soon |

  {codex_state: $codex.state, codex_acct: $codex.acct, codex_line: $codex.line,
   claude_line: ("claude: " + (if ($cl | length) == 0 then "no enabled accounts"
     else ($cl | map("\(.name)($\(.tier))\(if .own then "*" else "" end) 5h \(.h5)% →\(.r5) wk \(.wk)%") | join(" | ")) end)),
   rec: $rec, soon: $soon, age: $age}
  | [.codex_state, .codex_acct, .codex_line, .claude_line, .rec, .soon, .age] | join("")
' "$LIMITS_FILE" 2>/dev/null) || fail_safe "limits parse failed, fail-safe to Claude side"
[ -n "$summary" ] || fail_safe "limits parse failed, fail-safe to Claude side"

IFS=$'\x1f' read -r cx_state cx_acct cx_line cl_line rec soon age <<< "$summary"

if [ -n "$cb_pin" ]; then
  cb_next="claudeb $cb_pin · $cb_model · $cb_effort (pinned via /worker)"
  cb_cache="cb@$cb_pin"
elif [ -n "$rec" ]; then
  cb_next="claudeb $rec · $cb_model · $cb_effort — put \"ACCOUNT: $rec\" in the brief"
  cb_cache="cb~$rec"
else
  cb_next="claudeb (rotating — no account clearly better than the daemon's pick)"
  cb_cache="cb~?"
fi

case "$cx_state" in
  FRESH) cx_mark="✓"; policy="codex is fresh — prefer codex (Sol high ≈ Opus-level, faster) for well-specified implementation and design tasks, up to ~5 of 10; claudeb for long/multi-step or repo-convention-heavy work. Codex EFFORT per task: medium for average tasks, high for genuinely complex ones (limits allow it)." ;;
  OK)    cx_mark="✓"; policy="codex has headroom — use it where speed or design taste pays (~3 of 10); claudeb otherwise. Codex EFFORT: medium; raise to high only for genuinely complex tasks." ;;
  TIGHT) cx_mark="!"; policy="codex is tight — claudeb for everything; codex only if Egor explicitly asks, then EFFORT: medium." ;;
  *)     cx_mark="✗"; policy="codex is walled/unavailable — claudeb for everything." ;;
esac
[ -n "$soon" ] && policy="$policy Use-it-or-lose-it 5h headroom on: $soon."
policy="$policy Never route workers to the session's own account ($own, marked *)."

case "$cx_effort" in medium) cx_eff_abbr=med ;; high) cx_eff_abbr=hi ;; xhigh) cx_eff_abbr=xh ;; *) cx_eff_abbr=$cx_effort ;; esac
case "$cb_effort" in medium) cb_eff_abbr=med ;; high) cb_eff_abbr=hi ;; xhigh) cb_eff_abbr=xh ;; *) cb_eff_abbr=$cb_effort ;; esac
case "$cb_model" in sonnet) cb_model_abbr=son ;; haiku) cb_model_abbr=hai ;; fable) cb_model_abbr=fab ;; *) cb_model_abbr=$cb_model ;; esac
write_cache "$(printf 'cx%s%s·%s %s·%s·%s' "$cx_mark" "$cx_acct" "$cx_eff_abbr" "$cb_cache" "$cb_model_abbr" "$cb_eff_abbr")"

echo "NEXT: $cb_next  |  codex $cx_acct · $cx_effort — $cx_state"
echo "$cx_line"
echo "$cl_line   (* = this session's account, excluded from routing)"
echo "POLICY: $policy"
echo "DATA: $age"

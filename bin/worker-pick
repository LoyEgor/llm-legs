#!/usr/bin/env bash
set -u

# Selection follows docs/routing-contract.md: candidates are pool members with live auth and a
# daily budget the shared limits view can compute, the answer is the pin or the largest budget,
# and only a wall (effective 100% or dead auth) skips an account. The two softenings are the
# five-hour deferral and the claim, both below.

# `--account <vendor>` is the machine-readable face of the same rules: one bare account name on
# stdout, nothing else, so a caller that must pick an account shares this selection instead of
# reimplementing it. `--exclude` is how a caller that just watched an account wall says "the next
# one, not that": the account is dropped from consideration for this query only, and running out
# of candidates is exit 3 rather than a quieter answer.
# Unknown arguments are refused rather than ignored — a silently dropped flag means the caller
# believes it constrained the answer while it got the unconstrained one.
query_vendor=""
query_exclude=""
query_exclude_given=false
query_role=workers
query_role_given=false
query_fable=false
query_claim=false
usage() {
  printf 'usage: worker-pick [--account claudeb|codex|gemini|grok [--exclude name[,name...]] [--role workers|reviewers|chat] [--fable] [--claim]]\n' >&2
  exit 2
}
while [ "$#" -gt 0 ]; do
  case "$1" in
    --account)
      [ "$#" -ge 2 ] || usage
      query_vendor="$2"
      case "$query_vendor" in
        claudeb|codex|gemini|grok) ;;
        *) printf 'worker-pick: unknown vendor %s\n' "$query_vendor" >&2; usage ;;
      esac
      shift 2
      ;;
    --exclude)
      [ "$#" -ge 2 ] || usage
      query_exclude="$2"
      query_exclude_given=true
      shift 2
      ;;
    --role)
      [ "$#" -ge 2 ] || usage
      query_role="$2"
      query_role_given=true
      case "$query_role" in
        workers|reviewers|chat) ;;
        *) printf 'worker-pick: unknown role %s\n' "$query_role" >&2; usage ;;
      esac
      shift 2
      ;;
    # Only a task that asks for Fable spends the fable bucket, so the caller names that bucket.
    --fable) query_fable=true; shift ;;
    # A caller that is about to spend the answer says so; a surface that only reports never does.
    --claim) query_claim=true; shift ;;
    *) printf 'worker-pick: unexpected argument %s\n' "$1" >&2; usage ;;
  esac
done
if [ "$query_exclude_given" = true ] && [ -z "$query_vendor" ]; then
  printf 'worker-pick: --exclude only means something with --account\n' >&2
  usage
fi
if [ "$query_role_given" = true ] && [ -z "$query_vendor" ]; then
  printf 'worker-pick: --role only means something with --account\n' >&2
  usage
fi
if [ "$query_fable" = true ] && [ "$query_vendor" != claudeb ]; then
  printf 'worker-pick: --fable only means something with --account claudeb\n' >&2
  usage
fi
if [ "$query_claim" = true ] && [ -z "$query_vendor" ]; then
  printf 'worker-pick: --claim only means something with --account\n' >&2
  usage
fi
query_exclude_json='[]'
if [ "$query_exclude_given" = true ]; then
  # Both failures below would hand back a WIDER answer than the caller asked for, which is the
  # one outcome an exclusion must never produce: it would route straight back to the account the
  # caller just watched wall.
  # `-Rs`, not `-R`: with raw input jq sees no lines at all for an empty value and prints
  # nothing, which would reach the selection as an unparsable argument instead of an empty list.
  query_exclude_json=$(printf '%s' "$query_exclude" |
    jq -Rsc 'rtrimstr("\n") | split(",") | map(select(length > 0))') ||
    { printf 'worker-pick: could not read the --exclude list\n' >&2; exit 2; }
  if [ -z "$query_exclude_json" ] || [ "$query_exclude_json" = '[]' ]; then
    printf 'worker-pick: --exclude needs at least one account name\n' >&2
    usage
  fi
fi

worker_pick_root() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}
worker_pick_share="$(worker_pick_root)/share"
. "$worker_pick_share/worker-model.sh"
. "$worker_pick_share/limits-view.sh"
. "$worker_pick_share/worker-claims.sh"

LIMITS_FILE="${LLM_LIMITS_FILE:-$HOME/.llm-limits.json}"
WORKER_FILE="${WORKER_PICK_CONFIG_FILE:-$HOME/.claude/worker-model}"
TIERS_FILE="${WORKER_PICK_TIERS_FILE:-${CLAUDEB_DIR:-$HOME/.claude-profiles/.claudeb}/account-tiers}"
CACHE_DIR="${WORKER_PICK_CACHE_DIR:-$HOME/.cache}"
now="${WORKER_PICK_NOW:-$(date +%s)}"

# Derive codex model short label from ~/.codex/config.toml; fallback "sol" defined here.
codex_model_short_label() {
  local toml="${1:-$HOME/.codex/config.toml}" label=""
  [ -r "$toml" ] && label=$(grep -m1 '^model[[:space:]]*=' "$toml" 2>/dev/null \
    | sed 's/.*"\([^"]*\)".*/\1/; s/.*-//')
  [[ "$label" =~ ^[A-Za-z0-9]+$ ]] || label=sol
  printf '%s' "$label"
}

conf() { sed -n "s/^$1=//p" "$WORKER_FILE" 2>/dev/null | head -n1; }
worker_mode=$(conf worker); worker_mode=${worker_mode:-sonnet}
cb_model=$(conf claudeb_model); cb_model=${cb_model:-opus}
cb_effort=$(conf claudeb_effort); cb_effort=${cb_effort:-high}
cx_effort=$(conf codex_effort); cx_effort=${cx_effort:-high}
gm_model=$(conf gemini_model); gm_model=${gm_model:-pro}
gm_effort=$(conf gemini_effort); gm_effort=${gm_effort:-high}
# `auto` is a real value here, not a missing one: resolving it to a model id is worker-run's job,
# and this line only reports the knob.
gr_model=$(conf grok_model); gr_model=${gr_model:-auto}
gr_effort=$(conf grok_effort); gr_effort=${gr_effort:-high}
cb_pin=$(conf claudeb_profile)
cx_pin=$(conf codex_profile)
gm_pin=$(conf gemini_profile)
gr_pin=$(conf grok_profile)
# How far the wall already standing when the pin was placed runs (share/worker-model.sh writes it).
# Absent for a pin placed on a free account, and for one written by hand.
cb_pin_wall=$(conf claudeb_profile_wall)
cx_pin_wall=$(conf codex_profile_wall)
gm_pin_wall=$(conf gemini_profile_wall)
gr_pin_wall=$(conf grok_profile_wall)
case "$gm_effort" in medium) gm_eff_abbr=med ;; high) gm_eff_abbr=hi ;; *) gm_eff_abbr=$gm_effort ;; esac

# The ladder is pin > roles > pool: a role toggle walls the vendor for everything the pool would
# choose, and a usable pin still answers over it the way it answers over pool exclusion. So a
# workers wall cannot be decided here — whether the pin serves is only known once selection ran.
role_off() { [ "$(conf "$1_$2")" = off ]; }
query_role_wall=false
# `chat` has no role wall of its own — the pool toggle is the only gate — so no `<vendor>_chat`
# key is ever read, and a workers/reviewers closure says nothing about it.
if [ -n "$query_vendor" ] && [ "$query_role" != chat ] && role_off "$query_vendor" "$query_role"; then
  if [ "$query_role" = workers ]; then
    query_role_wall=true
  else
    printf 'worker-pick: %s is switched off for %s\n' "$query_vendor" "$query_role" >&2
    exit 3
  fi
fi
# The pin is Egor's override for workers only. A rater or a chat handed it would spend an account
# he aimed at implementation, so those queries are answered by the pool alone and the pinned
# account stands in them as an ordinary candidate.
case "$query_role" in reviewers|chat) cb_pin=""; cx_pin=""; gm_pin=""; gr_pin="" ;; esac
# The table is the workers view, and a vendor closed for that role is not a candidate in it: the
# flags are read here so selection, ordering and the ALL WALLED verdict are all decided without
# it, the way a deliberately empty pool is.
cb_role_off=false; cx_role_off=false; gm_role_off=false; gr_role_off=false
if [ -z "$query_vendor" ]; then
  ! role_off claudeb workers || cb_role_off=true
  ! role_off codex workers || cx_role_off=true
  ! role_off gemini workers || gm_role_off=true
  ! role_off grok workers || gr_role_off=true
fi

own="${CLAUDE_LIMITS_ACCOUNT:-}"
if [ -z "$own" ] || [ "$own" = "-" ]; then
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ] && [ "$CLAUDE_CONFIG_DIR" != "$HOME/.claude" ]; then
    own=$(basename "$CLAUDE_CONFIG_DIR")
  else
    own=main
  fi
fi
cache_file="$CACHE_DIR/worker-pick.line.$own"
mkdir -p "$CACHE_DIR" 2>/dev/null || true

# The contract's first soft rule: an account this deep into its five-hour window walls after the
# first task, so it ranks behind everything below the threshold — and no further, since below
# 100% nothing is a hard wall.
FIVE_HOUR_DEFER_PCT=80

# The second: an account a caller claimed minutes ago is already carrying a run this data has not
# seen yet, so it ranks behind every unclaimed candidate and no further. A query that cannot read
# the claims answers as if there were none rather than refusing to route.
claims_json() {
  local list
  list=$(worker_claims_fresh "$1" 2>/dev/null |
    jq -Rsc 'split("\n") | map(select(length > 0))' 2>/dev/null)
  printf '%s' "${list:-[]}"
}
cb_claims=$(claims_json claudeb)
cx_claims=$(claims_json codex)
gm_claims=$(claims_json gemini)
gr_claims=$(claims_json grok)

write_cache() {
  # A query answers a caller; it does not announce a routing decision, so it leaves the
  # statusline's prediction to the real invocation that owns that file.
  [ -z "$query_vendor" ] || return 0
  # The statusline polls this file concurrently and must never observe a torn prediction.
  tmp="$cache_file.tmp.$$"
  printf '%s\n' "$1" >"$tmp" 2>/dev/null && mv -f "$tmp" "$cache_file" 2>/dev/null
  rm -f "$tmp" 2>/dev/null
  # These files are predictions, not records: only their producer runs, so a sibling nobody has
  # rewritten for a day belongs to an account that was renamed or removed. The name exclusion is
  # for a clock that jumped backwards, which would age the line just written.
  find "$CACHE_DIR" -maxdepth 1 -type f -name 'worker-pick.line.*' \
    ! -name "${cache_file##*/}" -mmin +1440 -delete 2>/dev/null || true
}

fail_safe() {
  # A query has no fail-safe: printing a guessed account would send a caller at an account this
  # data cannot vouch for. Fail loudly and let the caller name a profile itself.
  if [ -n "$query_vendor" ]; then
    printf 'worker-pick: cannot select a %s account (%s)\n' "$query_vendor" "$1" >&2
    exit 3
  fi
  case "$worker_mode" in
    gemini) printf 'NEXT: gemini %s · %s · %s — unavailable (%s)\n' "${gm_pin:-?}" "$gm_model" "$gm_effort" "$1" ;;
    grok) printf 'NEXT: grok %s · %s · %s — unavailable (%s)\n' "${gr_pin:-?}" "$gr_model" "$gr_effort" "$1" ;;
    auto) printf 'NEXT: claudeb (rotating) — %s  |  gemini unavailable\n' "$1" ;;
    *) printf 'NEXT: claudeb (rotating) — %s\n' "$1" ;;
  esac
  printf 'codex: unavailable\n'
  printf 'gemini: unavailable\n'
  printf 'grok: unavailable\n'
  printf 'claude: unavailable\n'
  printf 'DATA: unavailable\n'
  printf 'SESSION: unavailable\n'
  write_cache "cx✗·? cb~? gx✗?·${gm_model}·${gm_eff_abbr}"
  exit 0
}

[ -r "$LIMITS_FILE" ] || fail_safe "no limits data"

tiers_json=$(awk -F= 'NF==2 && $2 ~ /^[0-9]+([.][0-9]+)?$/ {printf "%s\"%s\":%s", sep, $1, $2; sep=","} END {print ""}' sep="" "$TIERS_FILE" 2>/dev/null)
tiers_json="{${tiers_json:-}}"
printf '%s' "$tiers_json" | jq -e . >/dev/null 2>&1 || tiers_json='{}'

summary=$(jq -r \
  --argjson now "$now" --argjson tiers "$tiers_json" --arg own "$own" --arg pin "$cb_pin" \
  --argjson defer5h "$FIVE_HOUR_DEFER_PCT" \
  --arg cx_pin "$cx_pin" --arg gm_pin "$gm_pin" --arg gr_pin "$gr_pin" \
  --arg cb_off "$cb_role_off" --arg cx_off "$cx_role_off" --arg gm_off "$gm_role_off" \
  --arg gr_off "$gr_role_off" \
  --argjson cb_claims "$cb_claims" --argjson cx_claims "$cx_claims" \
  --argjson gm_claims "$gm_claims" --argjson gr_claims "$gr_claims" \
  --argjson qx "$query_exclude_json" "$LIMITS_VIEW_JQ"'
  # Local names for the store-reading defs of share/limits-view.sh, which the pin writes its wall
  # record from as well; never a second copy of them.
  def epoch: limits_store_epoch;
  def eff($b): limits_store_eff($b; $now);
  def reset_str($b):
    (($b.resets_at // null) | epoch) as $reset |
    if $reset == null then "?"
    elif ($reset - $now) < 86400 then ($reset | strflocaltime("%H:%M"))
    else ($reset | strflocaltime("%b %d %H:%M")) end;
  def pct_str: if type == "number" then ((round | tostring) + "%") else "?" end;
  def bool_or($value; $fallback): if ($value | type) == "boolean" then $value else $fallback end;
  def auth_ok: .auth_needed != true and ((.auth.status? // "ok") | IN("expired", "failed") | not);
  # Grok is the one vendor whose CLI refreshes an expired access token itself, so `expired` is a
  # live candidate that merely ranks behind a signed-in one; `needs_login` has no refresh token
  # left and is dead auth like anywhere else.
  def gr_auth: (.auth.status? // "ok");
  def gr_auth_ok: .auth_needed != true and (gr_auth | IN("ok", "expired"));
  def gemini_group: ((.group // "") | ascii_downcase | contains("gemini"));
  def account_as_of:
    [.five_hour?, .weekly?, .fable? |
      select(type == "object" and (.used_pct | type) == "number") |
      (.as_of? | epoch)] |
    map(select(. != null));
  def excluded: .name | IN($qx[]);
  def claimed_in($list): (.name | IN($list[]));
  # Rule 2 of the contract, defined once so all four vendors rank identically: the five-hour
  # deferral first, then a fresh claim, then a refreshable-but-expired auth, then the largest
  # daily budget. Only grok rows ever set `auth_late`; on the rest it is null, which jq reads as
  # false, so the key is a no-op there rather than a ranking function of its own. The budget is
  # negated because the sort ascends, and coalesced for the unmeasured rows the display sort
  # carries: jq refuses to negate null.
  def rank_keys: [(if .defer5h then 1 else 0 end), (if .claimed then 1 else 0 end), (if .auth_late then 1 else 0 end), (0 - (.budget // 0)), .name];
  def rank: sort_by(rank_keys);
  # Display bands are applied only while rendering, and within a band the order stays the
  # selection order (shared-invariants g), so the render sorts on the same keys.
  # A vendor whose every account sits outside the pool was switched off deliberately, not
  # walled, and the query path must be able to say which of the two it is.
  # Keyed on the toggle alone: --exclude names accounts that walled during one run, and reading
  # those as an empty pool would blame the user for a limit.
  # Gemini is counted over its raw source rather than the quota-filtered rows: an account with
  # no measured Gemini Models group is still a pool member, and dropping it first would report an
  # empty pool while one stands enabled.
  # `== false`, never `(.enabled // true) | not`: the alternative operator in jq swallows a literal
  # `false` along with null, so that spelling answered "no" for every roster and left an emptied
  # pool reported as a usage limit. An absent key still means in-pool, which is what the raw
  # gemini source carries.
  def pool_empty($rows): if ($rows | length) > 0 and ($rows | all(.enabled == false))
    then "yes" else "no" end;
  def display_band($selected): if .name == $selected then 0 elif .eligible then 1 elif .in_pool then 2 else 3 end;
  def display_sort($selected): sort_by([display_band($selected)] + rank_keys);
  # Weekly is the spending bucket; a vendor that reports no weekly percentage at all is measured
  # by its five-hour reading, the only number it has.
  def spending: .wk // .h5;
  # The one pace metric, per docs/routing-contract.md: what is left of the weekly window divided
  # by the days left in it (share/limits-view.sh owns both halves). A vendor with no weekly bucket
  # is paced over the neutral window instead, since its five-hour reset says nothing about a week.
  def spend_budget:
    if (.wk | type) == "number"
    then limits_daily_budget(.wk; limits_days_remaining(.wk_reset; $now))
    else limits_daily_budget(.h5; null) end;
  def walled_at($spend): (.auth_ok | not) or (($spend // -1) >= 100) or ((.h5 // -1) >= 100);
  # Unlike the tiebreak below, an absent five-hour reading must NOT coalesce high here: nobody
  # measured that window, which is no evidence of a wall to defer for.
  def deferring: (.h5 | type) == "number" and .h5 >= $defer5h;
  def eligibility:
    .measured = (.budget != null) |
    .defer5h = deferring |
    .eligible = (.enabled and .auth_ok and .measured and (.walled | not) and (excluded | not)) |
    .in_pool = (.enabled and (excluded | not));
  def pin_lapse($pin; $row; $selected):
    if $pin == "" or $selected != null then ""
    elif ($pin | IN($qx[])) then "excluded"
    elif $row == null then "absent"
    # Pool exclusion is not among the reasons and never can be: the pin is the one override above
    # the toggle (contract rules 2 and 4).
    elif ($row.auth_ok | not) then "auth unavailable"
    elif ($row.measured | not) then "no quota data"
    elif $row.walled then "exhausted"
    else "unavailable" end;

  # A weekly bucket stamped origin `headers` was never measured (shared-invariants n). The
  # collector no longer emits one, but a cache written before that rule can still be on
  # disk, and routing on a synthetic 100 walls an account that is actually free.
  walk(if type == "object" and (.weekly.origin? == "headers") then del(.weekly) else . end) |
  (.fetched_at | epoch) as $fetched |
  (.vendors.codex // {}) as $cx |
  (.vendors.gemini // {}) as $gm |
  (.vendors.grok // {}) as $gr |
  # A vendor this machine has no collector for is not a routing option and not a wall either, so
  # the whole grok render hangs off the store carrying the key at all.
  ((.vendors.grok | type) == "object") as $gr_present |
  (if $cx.available == true and (($cx.accounts | type) == "array") then $cx.accounts
   elif $cx.available == true then [{account:"main",five_hour:($cx.five_hour // {}),weekly:($cx.weekly // {})}]
   else [] end) as $cx_source |
  (if ($gm.accounts | type) == "array" then $gm.accounts
   elif $gm.auth_needed == true or $gm.removed == true or ($gm | gemini_group) then
     [$gm + {account:"main",is_current:true,enabled:($gm.enabled != false)}]
   else [] end) as $gm_source |
  (if $gr.available == true and (($gr.accounts | type) == "array") then $gr.accounts
   elif $gr.available == true then [{account:"main",weekly:($gr.weekly // {})}]
   else [] end) as $gr_source |
  # Disabled accounts are not polled by the collector, so their frozen as_of would
  # brand the whole DATA line STALE while every routable account is fresh. Routable
  # mirrors the per-vendor selection predicate (claude demands enabled == true),
  # plus the vendor pin — a pin overrides pool exclusion, so the age of a pinned
  # account counts even when it is off. Nothing routable falls back to the oldest
  # timestamp of ALL accounts, never straight to the store write time.
  ([($cx_source[] | select(.enabled != false or (.account // "main") == $cx_pin) | account_as_of[]),
    ($gm_source[] | select(.enabled != false or (.account // "main") == $gm_pin) | account_as_of[]),
    ($gr_source[] | select(.enabled != false or (.account // "main") == $gr_pin) | account_as_of[]),
    (.vendors.claude.accounts[]? | select(.enabled == true or (.account // "main") == $pin) | account_as_of[])]
   | min) as $routable_as_of |
  ($routable_as_of //
   ([($cx_source[] | account_as_of[]), ($gm_source[] | account_as_of[]),
     ($gr_source[] | account_as_of[]),
     (.vendors.claude.accounts[]? | account_as_of[])] | min) // $fetched) as $data_as_of |
  (if $data_as_of == null then "no timestamp"
   elif ($now - $data_as_of) > 7200 then "STALE (\((([($now - $data_as_of), 0] | max) / 60) | floor) min old)"
   else "fresh (\((([($now - $data_as_of), 0] | max) / 60) | floor) min old)" end) as $age |

  ([$cx_source[] |
    {name:(.account // "main"),
     enabled:(.enabled != false),auth_ok:auth_ok,
     h5:eff(.five_hour),wk:eff(.weekly),wk_reset:((.weekly.resets_at? // null) | epoch),
     credits:(if .reset_credits_stale == true then 0
              elif (.reset_credits | type) == "number" then .reset_credits else 0 end),
     r5:reset_str(.five_hour),rw:reset_str(.weekly)} |
    .spend = spending | .budget = spend_budget | .claimed = claimed_in($cx_claims) |
    .walled = walled_at(.spend) | eligibility]) as $cx_accounts |
  ($cx_accounts | map(select(.eligible)) | rank) as $cx_eligible |
  (first($cx_accounts[] | select(.name == $cx_pin)) // null) as $cx_pin_row |
  ($cx_accounts | map(select(.name == $cx_pin and (.walled | not) and .measured and
                            (excluded | not))) | .[0] // null) as $cx_pinned |
  pin_lapse($cx_pin; $cx_pin_row; $cx_pinned) as $cx_pin_lapse |
  ($cx_pinned // $cx_eligible[0] // null) as $cx_best |
  (($cx_best.name // "") as $sel |
   (if $cx_best == null then "no selectable account" else $sel end) as $target |
   {selected:($cx_best != null),acct:$sel,pct:(($cx_best.spend // 0) | round),
    pinned:($cx_pinned != null),budget:(($cx_best.budget // 0)),
    line:("codex: " +
      (if $cx_pin_lapse != "" then "pin \($cx_pin) \($cx_pin_lapse) → \($target) | " else "" end) +
      (if ($cx_accounts | length) == 0 then
         (if ($cx.available // false) != true then "unavailable" else "no quota data" end)
       elif ($cx_accounts | all(.auth_ok | not)) then "login needed"
       else ($cx_accounts | display_sort($sel) | map(
         "\(.name) \(.spend | pct_str) 5h \(.h5 | pct_str) ↻\(.credits)\(if .name == $sel and $cx_pinned != null then " PINNED" else "" end)\(if .walled then " WALLED" else "" end)\(if .defer5h then " 5h!" else "" end)\(if .auth_ok then "" else " auth!" end)\(if .enabled then "" else " off" end) (5h→\(.r5), wk→\(.rw))") | join(" | ")) end))}) as $codex |

  ([$gm_source[] | select(.removed != true and gemini_group) |
    {name:(.account // "main"),
     enabled:(.enabled != false),auth_ok:auth_ok,
     h5:eff(.five_hour),wk:eff(.weekly),wk_reset:((.weekly.resets_at? // null) | epoch),
     r5:reset_str(.five_hour),rw:reset_str(.weekly)} |
    .spend = spending | .budget = spend_budget | .claimed = claimed_in($gm_claims) |
    .walled = walled_at(.spend) | eligibility]) as $gm_accounts |
  ($gm_accounts | map(select(.eligible)) | rank) as $gm_eligible |
  (first($gm_accounts[] | select(.name == $gm_pin)) // null) as $gm_pin_row |
  ($gm_accounts | map(select(.name == $gm_pin and (.walled | not) and .measured and
                            (excluded | not))) | .[0] // null) as $gm_pinned |
  pin_lapse($gm_pin; $gm_pin_row; $gm_pinned) as $gm_pin_lapse |
  ($gm_pinned // $gm_eligible[0] // null) as $gm_best |
  (($gm_best.name // "") as $sel |
   (if $gm_best == null then "no selectable account" else $sel end) as $target |
   {selected:($gm_best != null),acct:$sel,pinned:($gm_pinned != null),
    budget:(($gm_best.budget // 0)),
    line:("gemini: " +
      (if $gm_pin_lapse != "" then "pin \($gm_pin) \($gm_pin_lapse) → \($target) | " else "" end) +
      (if ($gm_accounts | length) == 0 then
         (if any($gm_source[]; .auth_needed == true) then "login needed"
          elif ($gm_source | length) > 0 or $gm.available == true then "no Gemini Models quota data"
          else "unavailable" end)
       elif ($gm_accounts | all(.auth_ok | not)) then "login needed"
       else ($gm_accounts | display_sort($sel) | map(
         "\(.name) \(.spend | pct_str) 5h \(.h5 | pct_str)\(if .name == $sel and $gm_pinned != null then " PINNED" else "" end)\(if .walled then " WALLED" else "" end)\(if .defer5h then " 5h!" else "" end)\(if .auth_ok then "" else " auth!" end)\(if .enabled then "" else " off" end) (5h→\(.r5), wk→\(.rw))") | join(" | ")) end))}) as $gemini |

  # Weekly is the only bucket grok measures, so `spending` finds no five-hour reading to fall back
  # on and the deferral of rule 2 never fires here.
  ([$gr_source[] |
    {name:(.account // "main"),
     enabled:(.enabled != false),auth_ok:gr_auth_ok,
     auth_late:(gr_auth_ok and gr_auth == "expired"),
     credits:(if .reset_credits_stale == true then 0
              elif (.reset_credits | type) == "number" then .reset_credits else 0 end),
     wk:eff(.weekly),wk_reset:((.weekly.resets_at? // null) | epoch),rw:reset_str(.weekly)} |
    .spend = spending | .budget = spend_budget | .claimed = claimed_in($gr_claims) |
    .walled = walled_at(.spend) | eligibility]) as $gr_accounts |
  ($gr_accounts | map(select(.eligible)) | rank) as $gr_eligible |
  (first($gr_accounts[] | select(.name == $gr_pin)) // null) as $gr_pin_row |
  ($gr_accounts | map(select(.name == $gr_pin and (.walled | not) and .measured and
                            (excluded | not))) | .[0] // null) as $gr_pinned |
  pin_lapse($gr_pin; $gr_pin_row; $gr_pinned) as $gr_pin_lapse |
  ($gr_pinned // $gr_eligible[0] // null) as $gr_best |
  (($gr_best.name // "") as $sel |
   (if $gr_best == null then "no selectable account" else $sel end) as $target |
   {selected:($gr_best != null),acct:$sel,pct:(($gr_best.spend // 0) | round),
    pinned:($gr_pinned != null),budget:(($gr_best.budget // 0)),
    line:("grok: " +
      (if $gr_pin_lapse != "" then "pin \($gr_pin) \($gr_pin_lapse) → \($target) | " else "" end) +
      (if ($gr_accounts | length) == 0 then
         # No accounts and no snapshot are one state to a reader — and the NEXT line above renders
         # both as `no quota data`, so a second word here would have the two disagree.
         "no quota data"
       elif ($gr_accounts | all(.auth_ok | not)) then "login needed"
       else ($gr_accounts | display_sort($sel) | map(
         "\(.name) \(.spend | pct_str) ↻\(.credits)\(if .name == $sel and $gr_pinned != null then " PINNED" else "" end)\(if .walled then " WALLED" else "" end)\(if .auth_ok then "" else " auth!" end)\(if .auth_late then " auth expired" else "" end)\(if .enabled then "" else " off" end) (wk→\(.rw))") | join(" | ")) end))}) as $grok |

  ([.vendors.claude.accounts[]? |
    {name:.account,tier:($tiers[.account] // 100),own:(.account == $own),
     enabled:(.enabled == true),auth_ok:auth_ok,
     general_usable:bool_or(.rotation.usable.general?; true),
     fable_capable:bool_or(.rotation.usable.fable?; true),
     h5:eff(.five_hour),wk:eff(.weekly),fb:eff(.fable),
     wk_reset:((.weekly.resets_at? // null) | epoch),
     fb_reset:((.fable.resets_at? // null) | epoch),
     r5:reset_str(.five_hour),rw:reset_str(.weekly),rf:reset_str(.fable)} |
    .blocked = (.general_usable | not) |
    .spend = spending | .budget = spend_budget | .claimed = claimed_in($cb_claims) |
    .walled = walled_at(.spend) | eligibility |
    .eligible = (.eligible and (.blocked | not)) |
    # Fable exhaustion never disqualifies ordinary work, so the fable bucket carries its own
    # candidacy: the account must be able to run Fable at all and have a measured fable window.
    .fable_pinnable = (.auth_ok and .fable_capable and (.fb | type) == "number" and
                       (walled_at(.fb) | not) and (excluded | not)) |
    .fable_ok = (.enabled and .fable_pinnable)]) as $cl_accounts |
  ($cl_accounts | map(select(.eligible)) | rank) as $cl_eligible |
  (first($cl_accounts[] | select(.name == $pin)) // null) as $pin_account |
  # Usable FOR A PIN is auth alive, a reading, and no wall. Not the pool toggle — the pin is the one
  # override above it (rule 4) — and so not `blocked` either, which carries that toggle inside it.
  (if $pin_account != null and $pin_account.auth_ok and
      ($pin_account.walled | not) and $pin_account.measured and
      (($pin_account | excluded) | not)
   then $pin_account else null end) as $pin_rec |
  pin_lapse($pin; $pin_account; $pin_rec) as $pin_lapse |
  ($pin_rec // $cl_eligible[0] // null) as $cl_best |
  # The same rules read against the fable bucket, paced by the reset that bucket carries.
  ($cl_accounts | map(select(.fable_ok) |
    .budget = limits_daily_budget(.fb; limits_days_remaining(.fb_reset; $now))) | rank)
    as $fb_eligible |
  (first($cl_accounts[] | select(.name == $pin and .fable_pinnable) |
    .budget = limits_daily_budget(.fb; limits_days_remaining(.fb_reset; $now))) // null)
    as $fb_pinned |
  ($fb_pinned // $fb_eligible[0] // null) as $fb_best |
  (($cl_best.name // "") as $sel |
   (if $cl_best == null then "no selectable account" else $sel end) as $target |
   ("claude: " +
    (if $pin_lapse != "" then "pin \($pin) \($pin_lapse) → \($target) | " else "" end) +
    (if ($cl_accounts | length) == 0 then "no accounts"
     else ($cl_accounts | display_sort($sel) | map(
       # `score` and `cap` are remaining windows — in the spending bucket, and to the nearest wall
       # — under the token names review-bench greps until it reads `--account` directly.
       "\(.name)($\(.tier))\(if .own then "*" else "" end) 5h \(.h5 | pct_str) wk \(.wk | pct_str) fb \(.fb | pct_str) score \(100 - (.spend // 100) | round) cap \([100 - ([(.spend // 100), (.h5 // 100)] | max), 0] | max | round)%\(if .name == $sel and $pin_rec != null then " PINNED" else "" end)\(if .walled then " WALLED" else "" end)\(if .defer5h then " 5h!" else "" end)\(if .auth_ok then "" else " auth!" end)\(if .fable_capable then "" else " no-Fable" end)\(if .blocked then " blocked" else "" end)\(if .enabled then "" else " off" end)") | join(" | ")) end))) as $claude_line |

  # Only pool members count: an out-of-pool account that happens to be at 0% would otherwise
  # hide an ALL WALLED verdict behind quota nobody is allowed to spend. A vendor closed for
  # workers is out of the same reckoning unless its pin serves: its quota is untouched and
  # counting it turns a switch Egor flipped into a verdict about limits.
  (((if $cx_off == "true" and $cx_pinned == null then [] else $cx_accounts end) +
    (if $gm_off == "true" and $gm_pinned == null then [] else $gm_accounts end) +
    (if $gr_off == "true" and $gr_pinned == null then [] else $gr_accounts end) +
    (if $cb_off == "true" and $pin_rec == null then [] else $cl_accounts end)
    | map(select(.in_pool and .measured)) | length) > 0) as $had_pool |

  [(if $codex.selected then "yes" else "no" end),$codex.acct,($codex.pct | tostring),
   (if $codex.pinned then "yes" else "no" end),$codex.line,$cx_pin_lapse,
   ($codex.budget | tostring),
   (if $gemini.selected then "yes" else "no" end),$gemini.acct,
   (if $gemini.pinned then "yes" else "no" end),$gemini.line,$gm_pin_lapse,
   ($gemini.budget | tostring),
   (if $grok.selected then "yes" else "no" end),$grok.acct,($grok.pct | tostring),
   (if $grok.pinned then "yes" else "no" end),$grok.line,$gr_pin_lapse,
   ($grok.budget | tostring),
   $claude_line,($cl_best.name // ""),(if $pin_rec != null then "yes" else "no" end),
   $pin_lapse,(($cl_best.budget // 0) | tostring),
   ($fb_best.name // ""),(($fb_best.fb // 0) | round | tostring),(($fb_best.wk // 0) | round | tostring),
   $age,(if $had_pool then "yes" else "no" end),
   pool_empty($cx_accounts),pool_empty($gm_source),pool_empty($gr_accounts),
   pool_empty($cl_accounts),(if $gr_present then "yes" else "no" end),
   (if ($gr_accounts | any(.measured)) then "yes" else "no" end),
   (if ($cx_accounts | any(.measured)) then "yes" else "no" end)] | join("\u001f")
' "$LIMITS_FILE" 2>/dev/null) || fail_safe "limits parse failed"
[ -n "$summary" ] || fail_safe "limits parse failed"

IFS=$'\x1f' read -r cx_selected cx_acct cx_pct cx_pinned cx_line cx_pin_lapse cx_budget \
  gm_selected gm_acct gm_pinned gm_line gm_pin_lapse gm_budget \
  gr_selected gr_acct gr_pct gr_pinned gr_line gr_pin_lapse gr_budget \
  cl_line cl_acct cl_pinned cl_pin_lapse cl_budget \
  fb_acct fb_fb fb_wk age had_pool cx_pool_empty gm_pool_empty gr_pool_empty \
  cl_pool_empty gr_present gr_measured cx_measured <<<"$summary"

# A pin that served outranks the switch, so the vendor is not closed at all this run.
[ "$cl_pinned" != yes ] || cb_role_off=false
[ "$cx_pinned" != yes ] || cx_role_off=false
[ "$gm_pinned" != yes ] || gm_role_off=false
[ "$gr_pinned" != yes ] || gr_role_off=false
if [ "$cb_role_off" = true ]; then cl_acct=""; cl_pinned=no; cl_pin_lapse=""; fi
if [ "$cx_role_off" = true ]; then cx_selected=no; cx_acct=""; cx_pin_lapse=""; fi
if [ "$gm_role_off" = true ]; then gm_selected=no; gm_acct=""; gm_pin_lapse=""; fi
if [ "$gr_role_off" = true ]; then gr_selected=no; gr_acct=""; gr_pin_lapse=""; fi

# A vendor the store carries no row for is not installed here, so the render leaves it out
# entirely rather than reporting a wall or a failed lookup. The switch, the mode and the pin are
# statements Egor made about grok, and each of them is worth an answer even with no data behind it.
gr_known=false
if [ "$gr_present" = yes ] || [ "$gr_role_off" = true ] || [ "$worker_mode" = grok ] ||
   [ -n "$gr_pin" ]; then
  gr_known=true
fi

# A pin the account has spent is over: `exhausted` is the usage wall alone, and the other lapses
# are conditions that pass (a login to fix, a toggle to flip, a reading yet to arrive), so they
# leave the pin where Egor put it. Stale data clears nothing — the wall it reports may already
# have reset.
clear_walled_pin() {
  [ "$3" = exhausted ] || return 0
  # A wall that was ALREADY standing when the pin was placed is not the pin being spent — the point
  # of such a pin is the window after it. Only a wall outliving the recorded horizon ends the pin.
  if [[ "$5" =~ ^[0-9]+$ ]] && [ "$now" -le "$5" ]; then return 0; fi
  worker_model_clear_walled_pin "$1" "$2" || return 0
  printf 'worker-pick: %s pin %s hit its wall — cleared, workers follow the pool again\n' \
    "$4" "$2" >&2
}
case "$age" in
  fresh*)
    clear_walled_pin claudeb_profile "$cb_pin" "$cl_pin_lapse" claudeb "$cb_pin_wall"
    clear_walled_pin codex_profile "$cx_pin" "$cx_pin_lapse" codex "$cx_pin_wall"
    clear_walled_pin gemini_profile "$gm_pin" "$gm_pin_lapse" gemini "$gm_pin_wall"
    clear_walled_pin grok_profile "$gr_pin" "$gr_pin_lapse" grok "$gr_pin_wall"
    ;;
esac

if [ "$query_fable" = true ]; then
  cl_acct=$fb_acct
fi

# ALL WALLED is a verdict about quota, so it is read over the vendors actually open for workers:
# a vendor Egor switched off has an answer he already knows, and counting it would send him
# hunting for limits that are fine.
all_walled=no
if [ "$had_pool" = yes ] && [ -z "$cl_acct" ] && [ "$cx_selected" != yes ] &&
   [ "$gm_selected" != yes ] && [ "$gr_selected" != yes ] &&
   { [ "$cb_role_off" = false ] || [ "$cx_role_off" = false ] || [ "$gm_role_off" = false ] ||
     { [ "$gr_known" = true ] && [ "$gr_role_off" = false ]; }; }; then
  all_walled=yes
fi

if [ -n "$query_vendor" ]; then
  case "$query_vendor" in
    claudeb)
      query_pin="$cb_pin"; query_pinned="$cl_pinned"
      query_answer="$cl_acct"
      # The ordinary-work line can name a perfectly selectable account, which reads as a
      # contradiction when what ran out was the fable bucket.
      if [ "$query_fable" = true ]; then
        query_reason="no fable-capable account with a fable bucket below 100%"
      else
        query_reason="$cl_line"
      fi
      ;;
    codex)
      query_pin="$cx_pin"; query_pinned="$cx_pinned"
      query_answer=""
      [ "$cx_selected" = yes ] && query_answer="$cx_acct"
      query_reason="$cx_line"
      ;;
    gemini)
      query_pin="$gm_pin"; query_pinned="$gm_pinned"
      query_answer=""
      [ "$gm_selected" = yes ] && query_answer="$gm_acct"
      query_reason="$gm_line"
      ;;
    grok)
      query_pin="$gr_pin"; query_pinned="$gr_pinned"
      query_answer=""
      [ "$gr_selected" = yes ] && query_answer="$gr_acct"
      query_reason="$gr_line"
      ;;
  esac
  # Under a workers wall the pin is the only thing left that can answer, so the pool's own
  # candidate is refused here rather than handed over as if the switch were advice.
  if [ "$query_role_wall" = true ] &&
     { [ "$query_pinned" != yes ] || [ "$query_answer" != "$query_pin" ]; }; then
    printf 'worker-pick: %s is switched off for workers\n' "$query_vendor" >&2
    exit 3
  fi
  if [ -n "$query_answer" ]; then
    # The claim is recorded only once the answer is settled, so a refused or empty query leaves
    # no account marked as taken.
    if [ "$query_claim" = true ]; then
      worker_claims_record "$query_vendor" "$query_answer" ||
        printf 'worker-pick: could not record the claim on %s\n' "$query_answer" >&2
    fi
    printf '%s\n' "$query_answer"
    exit 0
  fi
  query_pool_empty=no
  case "$query_vendor" in
    claudeb) query_pool_empty=$cl_pool_empty ;;
    codex) query_pool_empty=$cx_pool_empty ;;
    gemini) query_pool_empty=$gm_pool_empty ;;
    grok) query_pool_empty=$gr_pool_empty ;;
  esac
  if [ "$query_pool_empty" = yes ]; then
    printf 'worker-pick: every %s account is out of the worker pool (%s)\n' "$query_vendor" "$query_reason" >&2
    exit 3
  fi
  printf 'worker-pick: no selectable %s account (%s)\n' "$query_vendor" "$query_reason" >&2
  exit 3
fi

# A parked vendor gets its own cache shape: `~?` is the statusline's word for a prediction it
# could not make, and rendering a switch Egor flipped as a failed lookup is what sends him
# looking at limits.
if [ "$cb_role_off" = true ]; then
  cb_next="claudeb — off for workers"
  cb_cache="cb⏸off"
elif [ "$cl_pinned" = yes ]; then
  cb_next="claudeb $cl_acct · $cb_model · $cb_effort — ACCOUNT: $cl_acct (PINNED)"
  cb_cache="cb@$cl_acct"
elif [ -n "$cb_pin" ] && [ -z "$cl_acct" ]; then
  cb_next="claudeb pin $cb_pin $cl_pin_lapse → no selectable account"
  cb_cache="cb~?"
elif [ -n "$cb_pin" ]; then
  cb_next="claudeb pin $cb_pin $cl_pin_lapse → $cl_acct · $cb_model · $cb_effort — ACCOUNT: $cl_acct"
  cb_cache="cb~$cl_acct"
elif [ -n "$cl_acct" ]; then
  cb_next="claudeb $cl_acct · $cb_model · $cb_effort — ACCOUNT: $cl_acct"
  cb_cache="cb~$cl_acct"
elif [ "$all_walled" = yes ]; then
  cb_next="ALL WALLED, ask Egor"
  cb_cache="cb~?"
elif [ "$cl_pool_empty" = yes ]; then
  cb_next="claudeb unavailable — every account is out of the worker pool"
  cb_cache="cb~?"
else
  cb_next="claudeb unavailable — no selectable account"
  cb_cache="cb~?"
fi

if [ "$cx_role_off" = true ]; then
  cx_next="codex — off for workers"
  cx_mark="⏸"; cx_acct=off
elif [ "$cx_selected" = yes ]; then
  cx_next="codex $cx_acct · $cx_effort — ${cx_pct}%"
  [ "$cx_pinned" != yes ] || cx_next="$cx_next PINNED"
  cx_mark="✓"
elif [ "$cx_pool_empty" = yes ]; then
  cx_next="codex unavailable · $cx_effort — every account is out of the worker pool"
  cx_mark="✗"
elif [ "$cx_measured" = no ]; then
  # Nothing measured here, so there is no wall to report: `WALLED` would send Egor looking for a
  # limit that does not exist, the same misreport the grok arm below refuses.
  cx_next="codex unavailable · $cx_effort — no quota data"
  cx_mark="✗"
else
  cx_next="codex unavailable · $cx_effort — WALLED"
  cx_mark="✗"
fi
# A pin that could not serve is announced where the routing decision is read, not only in the
# vendor line: silently routing elsewhere reads as the pin having been honoured.
[ -z "$cx_pin_lapse" ] || cx_next="codex pin $cx_pin $cx_pin_lapse → ${cx_next#codex }"

if [ "$gm_role_off" = true ]; then
  gm_next="gemini — off for workers"
  gm_mark="⏸"; gm_acct=off
elif [ "$gm_selected" = yes ]; then
  gm_next="gemini $gm_acct · $gm_model · $gm_effort — ACCOUNT: $gm_acct"
  [ "$gm_pinned" != yes ] || gm_next="$gm_next PINNED"
  gm_mark="✓"
elif [ "$gm_pool_empty" = yes ]; then
  gm_next="gemini unavailable — every account is out of the worker pool"
  gm_mark="✗"
else
  gm_next="gemini unavailable"
  gm_mark="✗"
fi
[ -z "$gm_pin_lapse" ] || gm_next="gemini pin $gm_pin $gm_pin_lapse → ${gm_next#gemini }"

gr_next=""; gr_cache=""
if [ "$gr_known" = true ]; then
  if [ "$gr_role_off" = true ]; then
    gr_next="grok — off for workers"
    gr_mark="⏸"; gr_acct=off
  elif [ "$gr_selected" = yes ]; then
    gr_next="grok $gr_acct · $gr_model · $gr_effort — ${gr_pct}%"
    [ "$gr_pinned" != yes ] || gr_next="$gr_next PINNED"
    gr_mark="✓"
  elif [ "$gr_pool_empty" = yes ]; then
    gr_next="grok unavailable · $gr_model · $gr_effort — every account is out of the worker pool"
    gr_mark="✗"
  elif [ "$gr_measured" = no ]; then
    # A vendor nobody has measured has no wall to report: while the collector is still landing,
    # `WALLED` here would send Egor looking for a limit that does not exist.
    gr_next="grok unavailable · $gr_model · $gr_effort — no quota data"
    gr_mark="✗"
  else
    gr_next="grok unavailable · $gr_model · $gr_effort — WALLED"
    gr_mark="✗"
  fi
  [ -z "$gr_pin_lapse" ] || gr_next="grok pin $gr_pin $gr_pin_lapse → ${gr_next#grok }"
fi

case "$cx_effort" in medium) cx_eff_abbr=med ;; high) cx_eff_abbr=hi ;; xhigh) cx_eff_abbr=xh ;; *) cx_eff_abbr=$cx_effort ;; esac
case "$cb_effort" in medium) cb_eff_abbr=med ;; high) cb_eff_abbr=hi ;; xhigh) cb_eff_abbr=xh ;; *) cb_eff_abbr=$cb_effort ;; esac
case "$cb_model" in sonnet) cb_model_abbr=son ;; haiku) cb_model_abbr=hai ;; fable) cb_model_abbr=fab ;; *) cb_model_abbr=$cb_model ;; esac
case "$gr_effort" in medium) gr_eff_abbr=med ;; high) gr_eff_abbr=hi ;; xhigh) gr_eff_abbr=xh ;; *) gr_eff_abbr=$gr_effort ;; esac
codex_model=$(codex_model_short_label)
[ "$gr_known" = false ] ||
  gr_cache=$(printf ' gr%s%s·%s·%s' "$gr_mark" "${gr_acct:-?}" "$gr_model" "$gr_eff_abbr")
write_cache "$(printf 'cx%s%s·'"$codex_model"'·%s %s·%s·%s gx%s%s·%s·%s%s' \
  "$cx_mark" "$cx_acct" "$cx_eff_abbr" "$cb_cache" "$cb_model_abbr" "$cb_eff_abbr" \
  "$gm_mark" "${gm_acct:-?}" "$gm_model" "$gm_eff_abbr" "$gr_cache")"

# The leading segment is the routing answer, so a vendor closed for workers trails the line
# whatever the mode's usual order is: it is a statement about the switch, not a candidate.
# `cxw` is the shortened codex segment the walled shapes print, which a closed or unmeasured codex
# replaces — reading `codex — WALLED` off a vendor with untouched quota is the misreport this whole
# gate exists to avoid.
print_next() {
  local name text off open="" deferred=""
  for name in "$@"; do
    off=false
    case "$name" in
      cb) text=$cb_next; off=$cb_role_off ;;
      cx) text=$cx_next; off=$cx_role_off ;;
      cxw) if [ "$cx_role_off" = true ]; then text=$cx_next; off=true
           elif [ "$cx_measured" = no ]; then text=$cx_next
           else text="codex — WALLED"; fi ;;
      gm) text=$gm_next; off=$gm_role_off ;;
      gr) text=$gr_next; off=$gr_role_off ;;
      allw) text="ALL WALLED, ask Egor" ;;
    esac
    # A vendor with nothing to say is left out of the line rather than rendered as a blank segment.
    [ -n "$text" ] || continue
    if [ "$off" = true ]; then
      deferred="${deferred:+$deferred  |  }$text"
    else
      open="${open:+$open  |  }$text"
    fi
  done
  [ -z "$deferred" ] || open="${open:+$open  |  }$deferred"
  printf 'NEXT: %s\n' "$open"
}

if [ "$all_walled" = yes ]; then
  walled_segments=(allw cxw)
  [ "$cb_role_off" = false ] || walled_segments+=(cb)
  [ "$gm_role_off" = false ] || walled_segments+=(gm)
  [ "$gr_role_off" = false ] || walled_segments+=(gr)
  print_next "${walled_segments[@]}"
elif [ "$worker_mode" = gemini ]; then
  print_next gm cb cx gr
elif [ "$worker_mode" = grok ]; then
  print_next gr cb cx gm
elif [ "$worker_mode" = auto ]; then
  # Auto ranks vendors by the same metric that ranks accounts inside one: the daily budget of the
  # account each vendor selected. A vendor with nothing selectable has no budget to compare and
  # takes the tail in the vendor order the tokens spell, which is also how equal budgets break.
  auto_seq=""
  for vendor in $(
    { [ -z "$cl_acct" ] || printf '%s\tcb\n' "$cl_budget"
      [ "$cx_selected" != yes ] || printf '%s\tcx\n' "$cx_budget"
      [ "$gm_selected" != yes ] || printf '%s\tgm\n' "$gm_budget"
      [ "$gr_selected" != yes ] || printf '%s\tgr\n' "$gr_budget"
    } | sort -t $'\t' -k1,1gr -k2,2 | cut -f2); do
    auto_seq="$auto_seq $vendor"
  done
  for vendor in cb cx gm gr; do
    case " $auto_seq " in *" $vendor "*) ;; *) auto_seq="$auto_seq $vendor" ;; esac
  done
  print_next $auto_seq
else
  print_next cb cx
fi
printf '%s\n' "$cx_line"
printf '%s\n' "$gm_line"
[ "$gr_known" = false ] || printf '%s\n' "$gr_line"
printf '%s   (* = this session account)\n' "$cl_line"
printf 'DATA: %s\n' "$age"
if [ -n "$fb_acct" ]; then
  printf 'SESSION: %s — fb %s%%, wk %s%%\n' "$fb_acct" "$fb_fb" "$fb_wk"
else
  printf 'SESSION: no healthy Fable-capable account\n'
fi

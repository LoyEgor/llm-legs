#!/usr/bin/env bash
set -u

# Selection follows docs/routing-contract.md: candidates are pool members with live auth and a
# daily budget the shared limits view can compute, the answer is the pin or the largest budget,
# and only a wall (effective 100% or dead auth) skips an account. The two softenings are the
# five-hour deferral and the claim, both below.

# `--account <vendor>` is the machine-readable face of the same rules: one bare account name on
# stdout, nothing else, so a caller that must pick an account shares this selection instead of
# reimplementing it. `--exclude` is how a caller that just watched an account wall says "the next
# one, not that": the account is dropped from consideration for this query only, and running out
# of candidates is exit 3 rather than a quieter answer.
# Unknown arguments are refused rather than ignored — a silently dropped flag means the caller
# believes it constrained the answer while it got the unconstrained one.
query_vendor=""
query_exclude=""
query_exclude_given=false
query_role=workers
query_role_given=false
query_fable=false
query_claim=false
usage() {
  printf 'usage: worker-pick [--account claudeb|codex|gemini|grok [--exclude name[,name...]] [--role workers|reviewers|chat] [--fable] [--claim]]\n' >&2
  exit 2
}
while [ "$#" -gt 0 ]; do
  case "$1" in
    --account)
      [ "$#" -ge 2 ] || usage
      query_vendor="$2"
      case "$query_vendor" in
        claudeb|codex|gemini|grok) ;;
        *) printf 'worker-pick: unknown vendor %s\n' "$query_vendor" >&2; usage ;;
      esac
      shift 2
      ;;
    --exclude)
      [ "$#" -ge 2 ] || usage
      query_exclude="$2"
      query_exclude_given=true
      shift 2
      ;;
    --role)
      [ "$#" -ge 2 ] || usage
      query_role="$2"
      query_role_given=true
      case "$query_role" in
        workers|reviewers|chat) ;;
        *) printf 'worker-pick: unknown role %s\n' "$query_role" >&2; usage ;;
      esac
      shift 2
      ;;
    # Only a task that asks for Fable spends the fable bucket, so the caller names that bucket.
    --fable) query_fable=true; shift ;;
    # A caller that is about to spend the answer says so; a surface that only reports never does.
    --claim) query_claim=true; shift ;;
    *) printf 'worker-pick: unexpected argument %s\n' "$1" >&2; usage ;;
  esac
done
if [ "$query_exclude_given" = true ] && [ -z "$query_vendor" ]; then
  printf 'worker-pick: --exclude only means something with --account\n' >&2
  usage
fi
if [ "$query_role_given" = true ] && [ -z "$query_vendor" ]; then
  printf 'worker-pick: --role only means something with --account\n' >&2
  usage
fi
if [ "$query_fable" = true ] && [ "$query_vendor" != claudeb ]; then
  printf 'worker-pick: --fable only means something with --account claudeb\n' >&2
  usage
fi
if [ "$query_claim" = true ] && [ -z "$query_vendor" ]; then
  printf 'worker-pick: --claim only means something with --account\n' >&2
  usage
fi
query_exclude_json='[]'
if [ "$query_exclude_given" = true ]; then
  # Both failures below would hand back a WIDER answer than the caller asked for, which is the
  # one outcome an exclusion must never produce: it would route straight back to the account the
  # caller just watched wall.
  # `-Rs`, not `-R`: with raw input jq sees no lines at all for an empty value and prints
  # nothing, which would reach the selection as an unparsable argument instead of an empty list.
  query_exclude_json=$(printf '%s' "$query_exclude" |
    jq -Rsc 'rtrimstr("\n") | split(",") | map(select(length > 0))') ||
    { printf 'worker-pick: could not read the --exclude list\n' >&2; exit 2; }
  if [ -z "$query_exclude_json" ] || [ "$query_exclude_json" = '[]' ]; then
    printf 'worker-pick: --exclude needs at least one account name\n' >&2
    usage
  fi
fi

worker_pick_root() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}
worker_pick_share="$(worker_pick_root)/share"
. "$worker_pick_share/worker-model.sh"
. "$worker_pick_share/limits-view.sh"
. "$worker_pick_share/worker-claims.sh"

LIMITS_FILE="${LLM_LIMITS_FILE:-$HOME/.llm-limits.json}"
WORKER_FILE="${WORKER_PICK_CONFIG_FILE:-$HOME/.claude/worker-model}"
CACHE_DIR="${WORKER_PICK_CACHE_DIR:-$HOME/.cache}"
now="${WORKER_PICK_NOW:-$(date +%s)}"

# Derive codex model short label from ~/.codex/config.toml; fallback "sol" defined here.
codex_model_short_label() {
  local toml="${1:-$HOME/.codex/config.toml}" label=""
  [ -r "$toml" ] && label=$(grep -m1 '^model[[:space:]]*=' "$toml" 2>/dev/null \
    | sed 's/.*"\([^"]*\)".*/\1/; s/.*-//')
  [[ "$label" =~ ^[A-Za-z0-9]+$ ]] || label=sol
  printf '%s' "$label"
}

conf() { sed -n "s/^$1=//p" "$WORKER_FILE" 2>/dev/null | head -n1; }
# A paused vendor is parked for months and must not exist for this router: the collectors drop
# `vendors.<key>` for it, and nothing here may put it back. So the pause sits ABOVE the pin — the
# one place in the ladder where the pin does not win — and above the mode with it.
vendor_paused() { [ "$(conf "$1_paused")" = on ]; }
cb_paused=false; cx_paused=false; gm_paused=false; gr_paused=false
! vendor_paused claudeb || cb_paused=true
! vendor_paused codex || cx_paused=true
! vendor_paused gemini || gm_paused=true
! vendor_paused grok || gr_paused=true
# The one state that names a pause on this surface: with every vendor parked there is no answer to
# give, and an empty NEXT with no reason reads as a router that broke rather than one Egor switched
# off. Anywhere else the absence is the whole render.
NOTHING_ROUTABLE='nothing routable — every vendor is paused'
all_paused=false
[ "$cb_paused" = false ] || [ "$cx_paused" = false ] || [ "$gm_paused" = false ] ||
  [ "$gr_paused" = false ] || all_paused=true
if [ -n "$query_vendor" ] && vendor_paused "$query_vendor"; then
  printf 'worker-pick: %s is paused (%s_paused=on in ~/.claude/worker-model)\n' \
    "$query_vendor" "$query_vendor" >&2
  exit 3
fi
worker_mode=$(conf worker); worker_mode=${worker_mode:-auto}
# The native Sonnet subagent is gone — implementation always runs on a relay worker's account — so
# a `worker=sonnet` line left behind in the file is read as `auto` rather than as a fifth vendor.
if [ "$worker_mode" = sonnet ]; then
  printf 'worker-pick: worker=sonnet is no longer a worker toggle value; routing as auto\n' >&2
  worker_mode=auto
fi
# Silently, unlike the `sonnet` note above: that value is a leftover Egor never chose, while a
# pause is a decision he made after setting the toggle, and a warning on every run would be noise.
case "$worker_mode" in
  claudeb) [ "$cb_paused" = false ] || worker_mode=auto ;;
  codex) [ "$cx_paused" = false ] || worker_mode=auto ;;
  gemini) [ "$gm_paused" = false ] || worker_mode=auto ;;
  grok) [ "$gr_paused" = false ] || worker_mode=auto ;;
esac
cb_model=$(conf claudeb_model); cb_model=${cb_model:-opus}
cb_effort=$(conf claudeb_effort); cb_effort=${cb_effort:-high}
cx_effort=$(conf codex_effort); cx_effort=${cx_effort:-high}
gm_model=$(conf gemini_model); gm_model=${gm_model:-flash38}
gm_effort=$(conf gemini_effort); gm_effort=${gm_effort:-high}
# `auto` is a real value here, not a missing one: resolving it to a model id is worker-run's job,
# and this line only reports the knob.
gr_model=$(conf grok_model); gr_model=${gr_model:-auto}
gr_effort=$(conf grok_effort); gr_effort=${gr_effort:-high}
cb_pin=$(conf claudeb_profile)
cx_pin=$(conf codex_profile)
gm_pin=$(conf gemini_profile)
gr_pin=$(conf grok_profile)
# Read past, never cleared: a pause is meant to be lifted, and the pin Egor placed has to be there
# when it is.
[ "$cb_paused" = false ] || cb_pin=""
[ "$cx_paused" = false ] || cx_pin=""
[ "$gm_paused" = false ] || gm_pin=""
[ "$gr_paused" = false ] || gr_pin=""
# How far the wall already standing when the pin was placed runs (share/worker-model.sh writes it).
# Absent for a pin placed on a free account, and for one written by hand.
cb_pin_wall=$(conf claudeb_profile_wall)
cx_pin_wall=$(conf codex_profile_wall)
gm_pin_wall=$(conf gemini_profile_wall)
gr_pin_wall=$(conf grok_profile_wall)
case "$gm_effort" in medium) gm_eff_abbr=med ;; high) gm_eff_abbr=hi ;; *) gm_eff_abbr=$gm_effort ;; esac

# What the `model·eff` column says a dispatch would launch. The model is the short alias of the one
# model that vendor's workers run, never a version: grok's `auto` IS `grok-4.6` (shared-invariants
# row `bk`), so printing the placeholder would name a knob where the column names a model.
codex_model=$(codex_model_short_label)
eff_display() { case "$1" in medium) printf med ;; *) printf '%s' "$1" ;; esac; }
case "$gr_model" in auto | grok-*) gr_model_display=grok ;; *) gr_model_display=$gr_model ;; esac
# The column is padded to a fixed width, and the family name spelled out costs it four characters
# every vendor row pays for; `f38` keeps it exactly as wide as the `pro` it replaced.
case "$gm_model" in flash38) gm_model_display=f38 ;; *) gm_model_display=$gm_model ;; esac
cb_display="${cb_model}·$(eff_display "$cb_effort")"
cx_display="${codex_model}·$(eff_display "$cx_effort")"
gm_display="${gm_model_display}·$(eff_display "$gm_effort")"
gr_display="${gr_model_display}·$(eff_display "$gr_effort")"

# The ladder is pin > roles > pool: a role toggle walls the vendor for everything the pool would
# choose, and a usable pin still answers over it the way it answers over pool exclusion. So a
# workers wall cannot be decided here — whether the pin serves is only known once selection ran.
role_off() { [ "$(conf "$1_$2")" = off ]; }
query_role_wall=false
# `chat` has no role wall of its own — the pool toggle is the only gate — so no `<vendor>_chat`
# key is ever read, and a workers/reviewers closure says nothing about it.
if [ -n "$query_vendor" ] && [ "$query_role" != chat ] && role_off "$query_vendor" "$query_role"; then
  if [ "$query_role" = workers ]; then
    query_role_wall=true
  else
    printf 'worker-pick: %s is switched off for %s\n' "$query_vendor" "$query_role" >&2
    exit 3
  fi
fi
# The pin is Egor's override for workers only. A rater or a chat handed it would spend an account
# he aimed at implementation, so those queries are answered by the pool alone and the pinned
# account stands in them as an ordinary candidate.
case "$query_role" in reviewers|chat) cb_pin=""; cx_pin=""; gm_pin=""; gr_pin="" ;; esac
# The table is the workers view, and a vendor closed for that role is not a candidate in it: the
# flags are read here so selection, ordering and the ALL WALLED verdict are all decided without
# it, the way a deliberately empty pool is.
cb_role_off=false; cx_role_off=false; gm_role_off=false; gr_role_off=false
if [ -z "$query_vendor" ]; then
  ! role_off claudeb workers || cb_role_off=true
  ! role_off codex workers || cx_role_off=true
  ! role_off gemini workers || gm_role_off=true
  ! role_off grok workers || gr_role_off=true
fi

own="${CLAUDE_LIMITS_ACCOUNT:-}"
if [ -z "$own" ] || [ "$own" = "-" ]; then
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ] && [ "$CLAUDE_CONFIG_DIR" != "$HOME/.claude" ]; then
    own=$(basename "$CLAUDE_CONFIG_DIR")
  else
    own=main
  fi
fi
cache_file="$CACHE_DIR/worker-pick.line.$own"
mkdir -p "$CACHE_DIR" 2>/dev/null || true

# The contract's first soft rule: an account this deep into its five-hour window walls after the
# first task, so it ranks behind everything below the threshold — and no further, since below
# 100% nothing is a hard wall.
FIVE_HOUR_DEFER_PCT=80

# The second: an account a caller claimed minutes ago is already carrying a run this data has not
# seen yet, so it ranks behind every unclaimed candidate and no further. A query that cannot read
# the claims answers as if there were none rather than refusing to route.
claims_json() {
  local list
  list=$(worker_claims_fresh "$1" 2>/dev/null |
    jq -Rsc 'split("\n") | map(select(length > 0))' 2>/dev/null)
  printf '%s' "${list:-[]}"
}
cb_claims=$(claims_json claudeb)
cx_claims=$(claims_json codex)
gm_claims=$(claims_json gemini)
gr_claims=$(claims_json grok)

write_cache() {
  # A query answers a caller; it does not announce a routing decision, so it leaves the
  # statusline's prediction to the real invocation that owns that file.
  [ -z "$query_vendor" ] || return 0
  # The statusline polls this file concurrently and must never observe a torn prediction.
  tmp="$cache_file.tmp.$$"
  printf '%s\n' "$1" >"$tmp" 2>/dev/null && mv -f "$tmp" "$cache_file" 2>/dev/null
  rm -f "$tmp" 2>/dev/null
  # These files are predictions, not records: only their producer runs, so a sibling nobody has
  # rewritten for a day belongs to an account that was renamed or removed. The name exclusion is
  # for a clock that jumped backwards, which would age the line just written.
  find "$CACHE_DIR" -maxdepth 1 -type f -name 'worker-pick.line.*' \
    ! -name "${cache_file##*/}" -mmin +1440 -delete 2>/dev/null || true
}

fail_safe() {
  # A query has no fail-safe: printing a guessed account would send a caller at an account this
  # data cannot vouch for. Fail loudly and let the caller name a profile itself.
  if [ -n "$query_vendor" ]; then
    printf 'worker-pick: cannot select a %s account (%s)\n' "$query_vendor" "$1" >&2
    exit 3
  fi
  fs_next=""
  case "$worker_mode" in
    gemini) fs_next=$(printf 'gemini %s · %s · %s — unavailable (%s)' "${gm_pin:-?}" "$gm_model" "$gm_effort" "$1") ;;
    grok) fs_next=$(printf 'grok %s · %s · %s — unavailable (%s)' "${gr_pin:-?}" "$gr_model" "$gr_effort" "$1") ;;
    # No data means no ranking, so the lead is the first vendor of the fixed order still running:
    # claudeb rotating where it is, and its successor where Egor parked it.
    *) if [ "$cb_paused" = false ]; then
         fs_next=$(printf 'claudeb (rotating) — %s' "$1")
         [ "$worker_mode" != auto ] || [ "$gm_paused" = true ] ||
           fs_next="$fs_next  |  gemini unavailable"
       elif [ "$cx_paused" = false ]; then fs_next=$(printf 'codex unavailable (%s)' "$1")
       elif [ "$gm_paused" = false ]; then fs_next=$(printf 'gemini unavailable (%s)' "$1")
       elif [ "$gr_paused" = false ]; then fs_next=$(printf 'grok unavailable (%s)' "$1")
       fi ;;
  esac
  [ -n "$fs_next" ] || [ "$all_paused" = false ] || fs_next=$NOTHING_ROUTABLE
  printf 'NEXT: %s\n' "$fs_next"
  [ "$cx_paused" = true ] || printf 'codex: unavailable\n'
  [ "$gm_paused" = true ] || printf 'gemini: unavailable\n'
  [ "$gr_paused" = true ] || printf 'grok: unavailable\n'
  [ "$cb_paused" = true ] || printf 'claude: unavailable\n'
  printf 'DATA: unavailable\n'
  fs_cache=""
  [ "$cx_paused" = true ] || fs_cache="cx✗·?"
  [ "$cb_paused" = true ] || fs_cache="${fs_cache:+$fs_cache }cb~?"
  [ "$gm_paused" = true ] || fs_cache="${fs_cache:+$fs_cache }gx✗?·${gm_model}·${gm_eff_abbr}"
  write_cache "$fs_cache"
  exit 0
}

[ -r "$LIMITS_FILE" ] || fail_safe "no limits data"

summary=$(jq -r \
  --argjson now "$now" --arg own "$own" --arg pin "$cb_pin" \
  --arg cb_disp "$cb_display" --arg cx_disp "$cx_display" \
  --arg gm_disp "$gm_display" --arg gr_disp "$gr_display" \
  --argjson defer5h "$FIVE_HOUR_DEFER_PCT" --argjson stale_thr "$LIMITS_STALE_ROUTING" \
  --arg cx_pin "$cx_pin" --arg gm_pin "$gm_pin" --arg gr_pin "$gr_pin" \
  --arg cb_off "$cb_role_off" --arg cx_off "$cx_role_off" --arg gm_off "$gm_role_off" \
  --arg gr_off "$gr_role_off" \
  --arg cb_par "$cb_paused" --arg cx_par "$cx_paused" --arg gm_par "$gm_paused" \
  --arg gr_par "$gr_paused" \
  --argjson cb_claims "$cb_claims" --argjson cx_claims "$cx_claims" \
  --argjson gm_claims "$gm_claims" --argjson gr_claims "$gr_claims" \
  --argjson qx "$query_exclude_json" "$LIMITS_VIEW_JQ"'
  # Local names for the store-reading defs of share/limits-view.sh, which the pin writes its wall
  # record from as well; never a second copy of them.
  def epoch: limits_store_epoch;
  def eff($b): limits_store_eff($b; $now);
  def reset_str($b): limits_reset_text((($b.resets_at // null) | epoch); $now);
  def bool_or($value; $fallback): if ($value | type) == "boolean" then $value else $fallback end;
  def auth_ok: .auth_needed != true and ((.auth.status? // "ok") | IN("expired", "failed") | not);
  # Grok is the one vendor whose CLI refreshes an expired access token itself, so `expired` is a
  # live candidate that merely ranks behind a signed-in one; `needs_login` has no refresh token
  # left and is dead auth like anywhere else.
  def gr_auth: (.auth.status? // "ok");
  def gr_auth_ok: .auth_needed != true and (gr_auth | IN("ok", "expired"));
  def gemini_group: ((.group // "") | ascii_downcase | contains("gemini"));
  def account_as_of:
    [.five_hour?, .weekly?, .fable? |
      select(type == "object" and (.used_pct | type) == "number") |
      (.as_of? | epoch)] |
    map(select(. != null));
  # One row of the DATA line: the name a reader can find the account by, and the oldest of the
  # measured buckets on it (shared-invariants row v) as the age of that row.
  def aged_row($vendor):
    (account_as_of | min) as $as_of |
    if $as_of == null then empty
    else {label: ($vendor + "/" + (.account // "main")), as_of: $as_of} end;
  def excluded: .name | IN($qx[]);
  def claimed_in($list): (.name | IN($list[]));
  # Rule 2 of the contract, defined once so all four vendors rank identically: the five-hour
  # deferral first, then a fresh claim, then a refreshable-but-expired auth, then the largest
  # daily budget. Only grok rows ever set `auth_late`; on the rest it is null, which jq reads as
  # false, so the key is a no-op there rather than a ranking function of its own. The budget is
  # negated because the sort ascends, and coalesced for the unmeasured rows the display sort
  # carries: jq refuses to negate null.
  def rank_keys: [(if .defer5h then 1 else 0 end), (if .claimed then 1 else 0 end), (if .auth_late then 1 else 0 end), (0 - (.budget // 0)), .name];
  def rank: sort_by(rank_keys);
  # Display bands are applied only while rendering, and within a band the order stays the
  # selection order (shared-invariants g), so the render sorts on the same keys.
  # A vendor whose every account sits outside the pool was switched off deliberately, not
  # walled, and the query path must be able to say which of the two it is.
  # Keyed on the toggle alone: --exclude names accounts that walled during one run, and reading
  # those as an empty pool would blame the user for a limit.
  # Gemini is counted over its raw source rather than the quota-filtered rows: an account with
  # no measured Gemini Models group is still a pool member, and dropping it first would report an
  # empty pool while one stands enabled.
  # `== false`, never `(.enabled // true) | not`: the alternative operator in jq swallows a literal
  # `false` along with null, so that spelling answered "no" for every roster and left an emptied
  # pool reported as a usage limit. An absent key still means in-pool, which is what the raw
  # gemini source carries.
  def pool_empty($rows): if ($rows | length) > 0 and ($rows | all(.enabled == false))
    then "yes" else "no" end;
  def display_band($selected): if .name == $selected then 0 elif .eligible then 1 elif .in_pool then 2 else 3 end;
  def display_sort($selected): sort_by([display_band($selected)] + rank_keys);
  # Weekly is the spending bucket; a vendor that reports no weekly percentage at all is measured
  # by its five-hour reading, the only number it has.
  def spending: .wk // .h5;
  # The one pace metric, per docs/routing-contract.md: what is left of the weekly window divided
  # by the days left in it (share/limits-view.sh owns both halves). A vendor with no weekly bucket
  # is paced over the neutral window instead, since its five-hour reset says nothing about a week.
  def spend_budget:
    if (.wk | type) == "number"
    then limits_daily_budget(.wk; limits_days_remaining(.wk_reset; $now))
    else limits_daily_budget(.h5; null) end;
  # The divisor that budget was paced over, so a row printing the metric states the whole division
  # instead of a number a reader cannot check against the reset beside it.
  def spend_days:
    limits_budget_days(if (.wk | type) == "number" then limits_days_remaining(.wk_reset; $now)
                       else null end);
  # Always one place, `7` included: a bare integer in a column of decimals is read as a different
  # column, and every cell here is padded to a fixed width.
  def one_dp: (. * 10 | round) as $tenths |
    (($tenths / 10) | floor | tostring) + "." + (($tenths % 10) | tostring);
  def rpad($n): . + (" " * ($n - length));
  def lpad($n): (" " * ($n - length)) + .;
  def pct_cell($value):
    if ($value | type) == "number" then (($value | round | tostring) + "%") else "?" end;
  # The metric that ranked the row, as the division it is (shared-invariants row `bl`): the rate
  # beside the window it was paced over, which is the CLAMPED one — a window minutes from its
  # reset reads `×0.3d` rather than the vanishing remainder that would make the rate unreadable.
  def budget_cell:
    if (.budget | type) != "number" then "-"
    else ((.budget | one_dp) | lpad(4)) + "%/d ×" + (.budget_days | one_dp) + "d" end;
  # Every state a row can be in that is not a number, in one place so the four vendors cannot
  # spell them differently. `5h!` is the deferral of rule 2, visible where the answer is read.
  def flag_text($selected; $pinned):
    [(if .name == $selected and $pinned then "PINNED" else empty end),
     (if .walled then "WALLED" else empty end),
     (if .defer5h then "5h!" else empty end),
     (if .auth_ok then empty else "login needed" end),
     (if .auth_late then "auth expired" else empty end),
     (if .blocked then "blocked" else empty end),
     (if .enabled then empty else "off" end)] | join(" ");
  # One cell set per account, rendered two ways below: the aligned table a human reads and the
  # one-line reason a refused query carries. Two renderers over one set, never two row builders.
  # `$five_hour` is passed rather than read, because a vendor with no such window at all (grok)
  # must print `–` where a vendor whose window nobody measured prints `?`.
  def cells($selected; $pinned; $five_hour; $display):
    {key: .name, budget: budget_cell, wk: pct_cell(.wk), h5: $five_hour,
     name: (.name + (if .own then "*" else "" end)), display: $display,
     reset: (if .rs == "-" then "" else "↺ " + .rs end),
     flags: flag_text($selected; $pinned)};
  def table_row:
    ((.budget | rpad(16)) + (.wk | rpad(6)) + (.h5 | rpad(6)) + (.name | rpad(17)) +
     (.display | rpad(13)) + (.reset | rpad(13)) + .flags | sub(" +$"; ""));
  def next_row($vendor):
    ((.budget | rpad(16)) + (.wk | rpad(6)) + (.h5 | rpad(6)) +
     (($vendor + "/" + .name) | rpad(21)) + (.display | rpad(13)) + .flags | sub(" +$"; ""));
  def compact_row:
    (.name + " " + .wk + (if .h5 == "–" then "" else " 5h " + .h5 end) + " " +
     (.budget | sub("^ +"; "")) + (if .flags == "" then "" else " " + .flags end));
  # A vendor section is either its account rows or ONE line saying why there are none. A role the
  # owner closed is that one line too: nothing is routed there, and what those accounts hold is
  # for the vendor menu section to show, not for this router.
  # The switch is read first, exactly as `vendor_reason` reads it: a closed role with no rows left
  # in the store would otherwise blame the data for what the owner turned off.
  def vendor_state($accounts; $off; $pinned; $empty_text):
    if $off == "true" and $pinned == null then "off for workers"
    elif ($accounts | length) == 0 then $empty_text
    elif ($accounts | all(.auth_ok | not)) then "login needed"
    else "" end;
  # A pin that could not serve is announced above the rows it did not choose: routing elsewhere in
  # silence reads as the pin having been honoured.
  def pin_note($pin; $lapse; $target):
    if $lapse == "" then [] else ["pin \($pin) \($lapse) → \($target)"] end;
  # Rows travel to the shell as one field; the record separator is what a `read` cannot split on.
  def section($rows; $state; $note):
    $note + (if $state != "" then [$state] else ($rows | map(table_row)) end) | join("\u001e");
  # The NEXT table ranks ACCOUNTS across the vendors, so a vendor contributes every candidate it
  # holds and not only the one it would answer with. Each row travels with the keys that ordered it
  # inside its vendor — the rank vector of rule 2, plus whether the pin is what chose it — so the
  # shell merges four such lists under the same rule instead of re-deriving any of it. The selected
  # account leads its list, because a pin outside the pool is a candidate no ranking carries.
  def next_cells($cells; $best; $pinned; $order; $vendor):
    if $best == null then ""
    else ([$best] + ($order | map(select(.name != $best.name)))) |
      map(. as $a |
        [(if $pinned != null and $a.name == $pinned.name then "0" else "1" end),
         (if $a.defer5h then "1" else "0" end),
         (if $a.claimed then "1" else "0" end),
         (if $a.auth_late then "1" else "0" end),
         ((0 - ($a.budget // 0)) | tostring),
         $a.name, $vendor,
         ($cells | map(select(.key == $a.name)) | .[0] | next_row($vendor))] | join("\u001d")) |
      join("\u001e")
    end;
  # The one-line face of the same rows, for the stderr of a query that could not answer.
  def reason($rows; $state; $note):
    ($note | map(. + " | ") | join("")) +
    (if $state != "" then $state else ($rows | map(compact_row) | join(" | ")) end);
  # A wall is a USAGE verdict and nothing else. Dead auth keeps an account out of every answer
  # just as firmly, but it is a login to fix rather than a window to wait out, so the two are
  # separate here and on the rows: `WALLED` over an account whose quota nobody spent sends the
  # reader hunting for a limit that does not exist.
  def usage_walled($spend): (($spend // -1) >= 100) or ((.h5 // -1) >= 100);
  # Unlike the tiebreak below, an absent five-hour reading must NOT coalesce high here: nobody
  # measured that window, which is no evidence of a wall to defer for.
  def deferring: (.h5 | type) == "number" and .h5 >= $defer5h;
  def eligibility:
    .measured = (.budget != null) |
    .defer5h = deferring |
    .unavailable = ((.auth_ok | not) or .walled) |
    .eligible = (.enabled and .auth_ok and .measured and (.walled | not) and (excluded | not)) |
    .in_pool = (.enabled and (excluded | not));
  def pin_lapse($pin; $row; $selected):
    if $pin == "" or $selected != null then ""
    elif ($pin | IN($qx[])) then "excluded"
    elif $row == null then "absent"
    # Pool exclusion is not among the reasons and never can be: the pin is the one override above
    # the toggle (contract rules 2 and 4).
    elif ($row.auth_ok | not) then "auth unavailable"
    elif ($row.measured | not) then "no quota data"
    elif $row.walled then "exhausted"
    else "unavailable" end;

  # A weekly bucket stamped origin `headers` was never measured (shared-invariants n). The
  # collector no longer emits one, but a cache written before that rule can still be on
  # disk, and routing on a synthetic 100 walls an account that is actually free.
  walk(if type == "object" and (.weekly.origin? == "headers") then del(.weekly) else . end) |
  (.fetched_at | epoch) as $fetched |
  (.vendors.codex // {}) as $cx |
  (.vendors.gemini // {}) as $gm |
  (.vendors.grok // {}) as $gr |
  # A vendor this machine has no collector for, or one Egor paused, is not a routing option and not
  # a wall either, so the whole render of it hangs off the store carrying the key at all.
  ((.vendors.grok | type) == "object") as $gr_present |
  ((.vendors.codex | type) == "object") as $cx_present |
  ((.vendors.gemini | type) == "object") as $gm_present |
  ((.vendors.claude | type) == "object") as $cl_present |
  (if $cx.available == true and (($cx.accounts | type) == "array") then $cx.accounts
   elif $cx.available == true then [{account:"main",five_hour:($cx.five_hour // {}),weekly:($cx.weekly // {})}]
   else [] end) as $cx_source |
  (if ($gm.accounts | type) == "array" then $gm.accounts
   elif $gm.auth_needed == true or $gm.removed == true or ($gm | gemini_group) then
     [$gm + {account:"main",is_current:true,enabled:($gm.enabled != false)}]
   else [] end) as $gm_source |
  (if $gr.available == true and (($gr.accounts | type) == "array") then $gr.accounts
   elif $gr.available == true then [{account:"main",weekly:($gr.weekly // {})}]
   else [] end) as $gr_source |
  # Disabled accounts are not polled by the collector, so their frozen as_of would
  # brand the whole DATA line STALE while every routable account is fresh. Routable
  # mirrors the per-vendor selection predicate (claude demands enabled == true),
  # plus the vendor pin — a pin overrides pool exclusion, so the age of a pinned
  # account counts even when it is off. Nothing routable falls back to the oldest
  # timestamp of ALL accounts, never straight to the store write time.
  # A parked vendor is not polled and not routed, so its frozen timestamp counts for nothing here
  # either: the age is read off exactly the vendors the store would carry, absence and pause alike.
  (if $cx_par == "true" then [] else $cx_source end) as $cx_aged |
  (if $gm_par == "true" then [] else $gm_source end) as $gm_aged |
  (if $gr_par == "true" then [] else $gr_source end) as $gr_aged |
  (if $cb_par == "true" then [] else [.vendors.claude.accounts[]?] end) as $cl_aged |
  ([($cx_aged[] | select(.enabled != false or (.account // "main") == $cx_pin) |
     aged_row("codex")),
    ($gm_aged[] | select(.enabled != false or (.account // "main") == $gm_pin) |
     aged_row("gemini")),
    ($gr_aged[] | select(.enabled != false or (.account // "main") == $gr_pin) |
     aged_row("grok")),
    ($cl_aged[] | select(.enabled == true or (.account // "main") == $pin) |
     aged_row("claude"))]) as $routable_rows |
  (if ($routable_rows | length) > 0 then $routable_rows
   else [($cx_aged[] | aged_row("codex")), ($gm_aged[] | aged_row("gemini")),
         ($gr_aged[] | aged_row("grok")), ($cl_aged[] | aged_row("claude"))] end) as $age_rows |
  (($age_rows | map(.as_of) | min) // $fetched) as $data_as_of |
  # Which rows are old, not whether the table is: a verdict over the whole reading sent Egor
  # looking for a collector that had in fact answered for every account he was routing on. The
  # rows named ARE the ones the age is read off, so the verdict and the names cannot disagree.
  ([$age_rows[] | select(($now - .as_of) > $stale_thr)]) as $stale_rows |
  (if $data_as_of == null then "no timestamp"
   elif ($stale_rows | length) > 0 then
     "STALE — " + ($stale_rows | map("\(.label) \(limits_age_text($now - .as_of))") | join(", "))
   elif ($now - $data_as_of) > $stale_thr then
     "STALE — store written \(limits_age_text($now - $data_as_of)) ago, no account reading behind it"
   else "fresh (\((([($now - $data_as_of), 0] | max) / 60) | floor) min old)" end) as $age |

  ([$cx_source[] |
    {name:(.account // "main"),
     enabled:(.enabled != false),auth_ok:auth_ok,
     h5:eff(.five_hour),wk:eff(.weekly),wk_reset:((.weekly.resets_at? // null) | epoch),
     rs:reset_str(.weekly)} |
    .spend = spending | .budget = spend_budget | .budget_days = spend_days |
    .claimed = claimed_in($cx_claims) |
    .walled = usage_walled(.spend) | eligibility]) as $cx_accounts |
  ($cx_accounts | map(select(.eligible)) | rank) as $cx_eligible |
  (first($cx_accounts[] | select(.name == $cx_pin)) // null) as $cx_pin_row |
  ($cx_accounts | map(select(.name == $cx_pin and (.unavailable | not) and .measured and
                            (excluded | not))) | .[0] // null) as $cx_pinned |
  pin_lapse($cx_pin; $cx_pin_row; $cx_pinned) as $cx_pin_lapse |
  ($cx_pinned // $cx_eligible[0] // null) as $cx_best |
  (($cx_best.name // "") as $sel |
   (if $cx_best == null then "no selectable account" else $sel end) as $target |
   ($cx_accounts | display_sort($sel) |
     map(cells($sel; $cx_pinned != null; pct_cell(.h5); $cx_disp))) as $rows |
   vendor_state($cx_accounts; $cx_off; $cx_pinned;
     (if ($cx.available // false) != true then "unavailable" else "no quota data" end)) as $state |
   pin_note($cx_pin; $cx_pin_lapse; $target) as $note |
   {selected:($cx_best != null),acct:$sel,pct:(($cx_best.spend // 0) | round),
    pinned:($cx_pinned != null),budget:(($cx_best.budget // 0)),
    rows:section($rows; $state; $note),state:$state,
    next:next_cells($rows; $cx_best; $cx_pinned; $cx_eligible; "codex"),
    line:reason($rows; $state; $note)}) as $codex |

  ([$gm_source[] | select(.removed != true and gemini_group) |
    {name:(.account // "main"),
     enabled:(.enabled != false),auth_ok:auth_ok,
     h5:eff(.five_hour),wk:eff(.weekly),wk_reset:((.weekly.resets_at? // null) | epoch),
     rs:reset_str(.weekly)} |
    .spend = spending | .budget = spend_budget | .budget_days = spend_days |
    .claimed = claimed_in($gm_claims) |
    .walled = usage_walled(.spend) | eligibility]) as $gm_accounts |
  ($gm_accounts | map(select(.eligible)) | rank) as $gm_eligible |
  (first($gm_accounts[] | select(.name == $gm_pin)) // null) as $gm_pin_row |
  ($gm_accounts | map(select(.name == $gm_pin and (.unavailable | not) and .measured and
                            (excluded | not))) | .[0] // null) as $gm_pinned |
  pin_lapse($gm_pin; $gm_pin_row; $gm_pinned) as $gm_pin_lapse |
  ($gm_pinned // $gm_eligible[0] // null) as $gm_best |
  (($gm_best.name // "") as $sel |
   (if $gm_best == null then "no selectable account" else $sel end) as $target |
   ($gm_accounts | display_sort($sel) |
     map(cells($sel; $gm_pinned != null; pct_cell(.h5); $gm_disp))) as $rows |
   vendor_state($gm_accounts; $gm_off; $gm_pinned;
     (if any($gm_source[]; .auth_needed == true) then "login needed"
      elif ($gm_source | length) > 0 or $gm.available == true then "no Gemini Models quota data"
      else "unavailable" end)) as $state |
   pin_note($gm_pin; $gm_pin_lapse; $target) as $note |
   {selected:($gm_best != null),acct:$sel,pinned:($gm_pinned != null),
    budget:(($gm_best.budget // 0)),
    rows:section($rows; $state; $note),state:$state,
    next:next_cells($rows; $gm_best; $gm_pinned; $gm_eligible; "gemini"),
    line:reason($rows; $state; $note)}) as $gemini |

  # Weekly is the only bucket grok measures, so `spending` finds no five-hour reading to fall back
  # on and the deferral of rule 2 never fires here.
  ([$gr_source[] |
    {name:(.account // "main"),
     enabled:(.enabled != false),auth_ok:gr_auth_ok,
     auth_late:(gr_auth_ok and gr_auth == "expired"),
     wk:eff(.weekly),wk_reset:((.weekly.resets_at? // null) | epoch),rs:reset_str(.weekly)} |
    .spend = spending | .budget = spend_budget | .budget_days = spend_days |
    .claimed = claimed_in($gr_claims) |
    .walled = usage_walled(.spend) | eligibility]) as $gr_accounts |
  ($gr_accounts | map(select(.eligible)) | rank) as $gr_eligible |
  (first($gr_accounts[] | select(.name == $gr_pin)) // null) as $gr_pin_row |
  ($gr_accounts | map(select(.name == $gr_pin and (.unavailable | not) and .measured and
                            (excluded | not))) | .[0] // null) as $gr_pinned |
  pin_lapse($gr_pin; $gr_pin_row; $gr_pinned) as $gr_pin_lapse |
  ($gr_pinned // $gr_eligible[0] // null) as $gr_best |
  (($gr_best.name // "") as $sel |
   (if $gr_best == null then "no selectable account" else $sel end) as $target |
   # `–`, not `?`: grok has no five-hour window at all, and an unmeasured reading is a different
   # answer from a window that does not exist.
   ($gr_accounts | display_sort($sel) |
     map(cells($sel; $gr_pinned != null; "–"; $gr_disp))) as $rows |
   # No accounts and no snapshot are one state to a reader, so both read `no quota data`.
   vendor_state($gr_accounts; $gr_off; $gr_pinned; "no quota data") as $state |
   pin_note($gr_pin; $gr_pin_lapse; $target) as $note |
   {selected:($gr_best != null),acct:$sel,pct:(($gr_best.spend // 0) | round),
    pinned:($gr_pinned != null),budget:(($gr_best.budget // 0)),
    rows:section($rows; $state; $note),state:$state,
    next:next_cells($rows; $gr_best; $gr_pinned; $gr_eligible; "grok"),
    line:reason($rows; $state; $note)}) as $grok |

  ([.vendors.claude.accounts[]? |
    {name:.account,own:(.account == $own),
     enabled:(.enabled == true),auth_ok:auth_ok,
     general_usable:bool_or(.rotation.usable.general?; true),
     fable_capable:bool_or(.rotation.usable.fable?; true),
     h5:eff(.five_hour),wk:eff(.weekly),fb:eff(.fable),
     wk_reset:((.weekly.resets_at? // null) | epoch),
     fb_reset:((.fable.resets_at? // null) | epoch),
     rs:reset_str(.weekly)} |
    .blocked = (.general_usable | not) |
    .spend = spending | .budget = spend_budget | .budget_days = spend_days |
    .claimed = claimed_in($cb_claims) |
    .walled = usage_walled(.spend) | eligibility |
    .eligible = (.eligible and (.blocked | not)) |
    # Fable exhaustion never disqualifies ordinary work, so the fable bucket carries its own
    # candidacy: the account must be able to run Fable at all and have a measured fable window.
    .fable_pinnable = (.auth_ok and .fable_capable and (.fb | type) == "number" and
                       (usage_walled(.fb) | not) and (excluded | not)) |
    .fable_ok = (.enabled and .fable_pinnable)]) as $cl_accounts |
  ($cl_accounts | map(select(.eligible)) | rank) as $cl_eligible |
  (first($cl_accounts[] | select(.name == $pin)) // null) as $pin_account |
  # Usable FOR A PIN is auth alive, a reading, and no wall. Not the pool toggle — the pin is the one
  # override above it (rule 4) — and so not `blocked` either, which carries that toggle inside it.
  (if $pin_account != null and $pin_account.auth_ok and
      ($pin_account.walled | not) and $pin_account.measured and
      (($pin_account | excluded) | not)
   then $pin_account else null end) as $pin_rec |
  pin_lapse($pin; $pin_account; $pin_rec) as $pin_lapse |
  ($pin_rec // $cl_eligible[0] // null) as $cl_best |
  # The same rules read against the fable bucket, paced by the reset that bucket carries.
  ($cl_accounts | map(select(.fable_ok) |
    .budget = limits_daily_budget(.fb; limits_days_remaining(.fb_reset; $now))) | rank)
    as $fb_eligible |
  (first($cl_accounts[] | select(.name == $pin and .fable_pinnable) |
    .budget = limits_daily_budget(.fb; limits_days_remaining(.fb_reset; $now))) // null)
    as $fb_pinned |
  ($fb_pinned // $fb_eligible[0] // null) as $fb_best |
  (($cl_best.name // "") as $sel |
   (if $cl_best == null then "no selectable account" else $sel end) as $target |
   ($cl_accounts | display_sort($sel) |
     map(cells($sel; $pin_rec != null; pct_cell(.h5); $cb_disp))) as $rows |
   vendor_state($cl_accounts; $cb_off; $pin_rec; "no accounts") as $state |
   pin_note($pin; $pin_lapse; $target) as $note |
   # The `*` replaces a line of its own: what a reader needs from it is which row is this chat.
   (section($rows; $state; $note) as $body |
    if $state == "" and ($rows | any(.name | endswith("*")))
    then $body + "\u001e* = this session account" else $body end) as $cl_rows |
   {rows:$cl_rows,state:$state,next:next_cells($rows; $cl_best; $pin_rec; $cl_eligible; "claude"),
    line:reason($rows; $state; $note)}) as $claude |

  # Only pool members count: an out-of-pool account that happens to be at 0% would otherwise
  # hide an ALL WALLED verdict behind quota nobody is allowed to spend. A vendor closed for
  # workers is out of the same reckoning unless its pin serves: its quota is untouched and
  # counting it turns a switch Egor flipped into a verdict about limits. A paused vendor drops out
  # whatever the store still says: its rows survive until the next collector run, and one such
  # ghost would answer ALL WALLED where the open vendors are merely out of pool.
  (((if $cx_par == "true" or ($cx_off == "true" and $cx_pinned == null) then [] else $cx_accounts end) +
    (if $gm_par == "true" or ($gm_off == "true" and $gm_pinned == null) then [] else $gm_accounts end) +
    (if $gr_par == "true" or ($gr_off == "true" and $gr_pinned == null) then [] else $gr_accounts end) +
    (if $cb_par == "true" or ($cb_off == "true" and $pin_rec == null) then [] else $cl_accounts end)
    | map(select(.in_pool and .measured)) | length) > 0) as $had_pool |

  [(if $codex.selected then "yes" else "no" end),$codex.acct,
   (if $codex.pinned then "yes" else "no" end),$codex.line,$cx_pin_lapse,
   ($codex.budget | tostring),
   (if $gemini.selected then "yes" else "no" end),$gemini.acct,
   (if $gemini.pinned then "yes" else "no" end),$gemini.line,$gm_pin_lapse,
   ($gemini.budget | tostring),
   (if $grok.selected then "yes" else "no" end),$grok.acct,
   (if $grok.pinned then "yes" else "no" end),$grok.line,$gr_pin_lapse,
   ($grok.budget | tostring),
   $claude.line,($cl_best.name // ""),(if $pin_rec != null then "yes" else "no" end),
   $pin_lapse,(($cl_best.budget // 0) | tostring),
   ($fb_best.name // ""),
   $age,(if $had_pool then "yes" else "no" end),
   pool_empty($cx_accounts),pool_empty($gm_source),pool_empty($gr_accounts),
   pool_empty($cl_accounts),(if $gr_present then "yes" else "no" end),
   (if ($gr_accounts | any(.measured)) then "yes" else "no" end),
   (if ($cx_accounts | any(.measured)) then "yes" else "no" end),
   (if ($gm_accounts | any(.measured)) then "yes" else "no" end),
   (if ($cl_accounts | any(.measured)) then "yes" else "no" end),
   (if $cx_present then "yes" else "no" end),(if $gm_present then "yes" else "no" end),
   (if $cl_present then "yes" else "no" end),
   $codex.rows,$codex.next,$codex.state,$gemini.rows,$gemini.next,$gemini.state,
   $grok.rows,$grok.next,$grok.state,
   $claude.rows,$claude.next,$claude.state] | join("\u001f")
' "$LIMITS_FILE" 2>/dev/null) || fail_safe "limits parse failed"
[ -n "$summary" ] || fail_safe "limits parse failed"

IFS=$'\x1f' read -r cx_selected cx_acct cx_pinned cx_line cx_pin_lapse cx_budget \
  gm_selected gm_acct gm_pinned gm_line gm_pin_lapse gm_budget \
  gr_selected gr_acct gr_pinned gr_line gr_pin_lapse gr_budget \
  cl_line cl_acct cl_pinned cl_pin_lapse cl_budget \
  fb_acct age had_pool cx_pool_empty gm_pool_empty gr_pool_empty \
  cl_pool_empty gr_present gr_measured cx_measured gm_measured cl_measured \
  cx_present gm_present cl_present \
  cx_rows cx_nextrows cx_state gm_rows gm_nextrows gm_state \
  gr_rows gr_nextrows gr_state cl_rows cl_nextrows cl_state <<<"$summary"

# A pin that served outranks the switch, so the vendor is not closed at all this run.
[ "$cl_pinned" != yes ] || cb_role_off=false
[ "$cx_pinned" != yes ] || cx_role_off=false
[ "$gm_pinned" != yes ] || gm_role_off=false
[ "$gr_pinned" != yes ] || gr_role_off=false
if [ "$cb_role_off" = true ]; then cl_acct=""; cl_pinned=no; cl_pin_lapse=""; cl_nextrows=""; fi
if [ "$cx_role_off" = true ]; then cx_selected=no; cx_acct=""; cx_pin_lapse=""; cx_nextrows=""; fi
if [ "$gm_role_off" = true ]; then gm_selected=no; gm_acct=""; gm_pin_lapse=""; gm_nextrows=""; fi
if [ "$gr_role_off" = true ]; then gr_selected=no; gr_acct=""; gr_pin_lapse=""; gr_nextrows=""; fi

# A vendor the store carries no row for is not installed here, so the render leaves it out entirely
# rather than reporting a wall or a failed lookup. The switch, the mode and the pin are statements
# Egor made about the vendor, and each is worth an answer even with no data behind it — a PAUSE
# overrides all three, and is read here as well as off the store because the collector only drops
# the vendor on its next run.
vendor_known() {
  [ "$5" = false ] &&
    { [ "$1" = yes ] || [ "$2" = true ] || [ "$worker_mode" = "$3" ] || [ -n "$4" ]; }
}
cb_known=false; cx_known=false; gm_known=false; gr_known=false
! vendor_known "$cl_present" "$cb_role_off" claudeb "$cb_pin" "$cb_paused" || cb_known=true
! vendor_known "$cx_present" "$cx_role_off" codex "$cx_pin" "$cx_paused" || cx_known=true
! vendor_known "$gm_present" "$gm_role_off" gemini "$gm_pin" "$gm_paused" || gm_known=true
! vendor_known "$gr_present" "$gr_role_off" grok "$gr_pin" "$gr_paused" || gr_known=true
# A vendor that is not here selected nothing, whatever a snapshot older than the pause still says;
# left standing, its account would keep the ALL WALLED verdict from ever being reached.
[ "$cb_known" = true ] || { cl_acct=""; cl_pinned=no; cl_pin_lapse=""; cl_nextrows=""; }
[ "$cx_known" = true ] || { cx_selected=no; cx_acct=""; cx_pin_lapse=""; cx_nextrows=""; }
[ "$gm_known" = true ] || { gm_selected=no; gm_acct=""; gm_pin_lapse=""; gm_nextrows=""; }
[ "$gr_known" = true ] || { gr_selected=no; gr_acct=""; gr_pin_lapse=""; gr_nextrows=""; }

# A pin the account has spent is over: `exhausted` is the usage wall alone, and the other lapses
# are conditions that pass (a login to fix, a toggle to flip, a reading yet to arrive), so they
# leave the pin where Egor put it. Stale data clears nothing — the wall it reports may already
# have reset.
clear_walled_pin() {
  [ "$3" = exhausted ] || return 0
  # A wall that was ALREADY standing when the pin was placed is not the pin being spent — the point
  # of such a pin is the window after it. Only a wall outliving the recorded horizon ends the pin.
  if [[ "$5" =~ ^[0-9]+$ ]] && [ "$now" -le "$5" ]; then return 0; fi
  worker_model_clear_walled_pin "$1" "$2" || return 0
  printf 'worker-pick: %s pin %s hit its wall — cleared, workers follow the pool again\n' \
    "$4" "$2" >&2
}
case "$age" in
  fresh*)
    clear_walled_pin claudeb_profile "$cb_pin" "$cl_pin_lapse" claudeb "$cb_pin_wall"
    clear_walled_pin codex_profile "$cx_pin" "$cx_pin_lapse" codex "$cx_pin_wall"
    clear_walled_pin gemini_profile "$gm_pin" "$gm_pin_lapse" gemini "$gm_pin_wall"
    clear_walled_pin grok_profile "$gr_pin" "$gr_pin_lapse" grok "$gr_pin_wall"
    ;;
esac

if [ "$query_fable" = true ]; then
  cl_acct=$fb_acct
fi

# ALL WALLED is a verdict about quota, so it is read over the vendors actually open for workers:
# a vendor Egor switched off has an answer he already knows, and counting it would send him
# hunting for limits that are fine.
all_walled=no
if [ "$had_pool" = yes ] && [ -z "$cl_acct" ] && [ "$cx_selected" != yes ] &&
   [ "$gm_selected" != yes ] && [ "$gr_selected" != yes ] &&
   { { [ "$cb_known" = true ] && [ "$cb_role_off" = false ]; } ||
     { [ "$cx_known" = true ] && [ "$cx_role_off" = false ]; } ||
     { [ "$gm_known" = true ] && [ "$gm_role_off" = false ]; } ||
     { [ "$gr_known" = true ] && [ "$gr_role_off" = false ]; }; }; then
  all_walled=yes
fi

if [ -n "$query_vendor" ]; then
  case "$query_vendor" in
    claudeb)
      query_pin="$cb_pin"; query_pinned="$cl_pinned"
      query_answer="$cl_acct"
      # The ordinary-work line can name a perfectly selectable account, which reads as a
      # contradiction when what ran out was the fable bucket.
      if [ "$query_fable" = true ]; then
        query_reason="no fable-capable account with a fable bucket below 100%"
      else
        query_reason="$cl_line"
      fi
      ;;
    codex)
      query_pin="$cx_pin"; query_pinned="$cx_pinned"
      query_answer=""
      [ "$cx_selected" = yes ] && query_answer="$cx_acct"
      query_reason="$cx_line"
      ;;
    gemini)
      query_pin="$gm_pin"; query_pinned="$gm_pinned"
      query_answer=""
      [ "$gm_selected" = yes ] && query_answer="$gm_acct"
      query_reason="$gm_line"
      ;;
    grok)
      query_pin="$gr_pin"; query_pinned="$gr_pinned"
      query_answer=""
      [ "$gr_selected" = yes ] && query_answer="$gr_acct"
      query_reason="$gr_line"
      ;;
  esac
  # Under a workers wall the pin is the only thing left that can answer, so the pool's own
  # candidate is refused here rather than handed over as if the switch were advice.
  if [ "$query_role_wall" = true ] &&
     { [ "$query_pinned" != yes ] || [ "$query_answer" != "$query_pin" ]; }; then
    printf 'worker-pick: %s is switched off for workers\n' "$query_vendor" >&2
    exit 3
  fi
  if [ -n "$query_answer" ]; then
    # The claim is recorded only once the answer is settled, so a refused or empty query leaves
    # no account marked as taken.
    if [ "$query_claim" = true ]; then
      worker_claims_record "$query_vendor" "$query_answer" ||
        printf 'worker-pick: could not record the claim on %s\n' "$query_answer" >&2
    fi
    printf '%s\n' "$query_answer"
    exit 0
  fi
  query_pool_empty=no
  case "$query_vendor" in
    claudeb) query_pool_empty=$cl_pool_empty ;;
    codex) query_pool_empty=$cx_pool_empty ;;
    gemini) query_pool_empty=$gm_pool_empty ;;
    grok) query_pool_empty=$gr_pool_empty ;;
  esac
  if [ "$query_pool_empty" = yes ]; then
    printf 'worker-pick: every %s account is out of the worker pool (%s)\n' "$query_vendor" "$query_reason" >&2
    exit 3
  fi
  printf 'worker-pick: no selectable %s account (%s)\n' "$query_vendor" "$query_reason" >&2
  exit 3
fi
# A parked vendor gets its own cache shape: `~?` is the statusline's word for a prediction it
# could not make, and rendering a switch Egor flipped as a failed lookup is what sends him
# looking at limits. Marks, `off` and `?` here are the CACHE's alphabet (shared-invariants row
# `c`) and not the table's: the statusline reads this line, a human reads the rows below.
cx_mark="✗"; gm_mark="✗"; gr_mark="✗"
if [ "$cb_role_off" = true ]; then cb_cache="cb⏸off"
elif [ "$cl_pinned" = yes ]; then cb_cache="cb@$cl_acct"
elif [ -n "$cl_acct" ]; then cb_cache="cb~$cl_acct"
else cb_cache="cb~?"
fi
[ "$cb_known" = true ] || cb_cache=""
if [ "$cx_role_off" = true ]; then cx_mark="⏸"; cx_acct=off
elif [ "$cx_selected" = yes ]; then cx_mark="✓"
fi
if [ "$gm_role_off" = true ]; then gm_mark="⏸"; gm_acct=off
elif [ "$gm_selected" = yes ]; then gm_mark="✓"
fi
if [ "$gr_role_off" = true ]; then gr_mark="⏸"; gr_acct=off
elif [ "$gr_selected" = yes ]; then gr_mark="✓"
fi

case "$cx_effort" in medium) cx_eff_abbr=med ;; high) cx_eff_abbr=hi ;; xhigh) cx_eff_abbr=xh ;; *) cx_eff_abbr=$cx_effort ;; esac
case "$cb_effort" in medium) cb_eff_abbr=med ;; high) cb_eff_abbr=hi ;; xhigh) cb_eff_abbr=xh ;; *) cb_eff_abbr=$cb_effort ;; esac
case "$cb_model" in sonnet) cb_model_abbr=son ;; haiku) cb_model_abbr=hai ;; fable) cb_model_abbr=fab ;; *) cb_model_abbr=$cb_model ;; esac
case "$gr_effort" in medium) gr_eff_abbr=med ;; high) gr_eff_abbr=hi ;; xhigh) gr_eff_abbr=xh ;; *) gr_eff_abbr=$gr_effort ;; esac
# Every field is optional and the order never moves, which is what lets the consumer find a vendor
# by its tag alone: a vendor absent from the store contributes no field, and the statusline's
# reader answers "no prediction" for a tag it does not find, exactly as it does for `cb~?`.
cx_cache=""; gm_cache=""; gr_cache=""
[ "$cx_known" = false ] ||
  cx_cache=$(printf 'cx%s%s·%s·%s' "$cx_mark" "$cx_acct" "$codex_model" "$cx_eff_abbr")
[ "$cb_known" = false ] ||
  cb_cache=$(printf '%s·%s·%s' "$cb_cache" "$cb_model_abbr" "$cb_eff_abbr")
[ "$gm_known" = false ] ||
  gm_cache=$(printf 'gx%s%s·%s·%s' "$gm_mark" "${gm_acct:-?}" "$gm_model" "$gm_eff_abbr")
[ "$gr_known" = false ] ||
  gr_cache=$(printf 'gr%s%s·%s·%s' "$gr_mark" "${gr_acct:-?}" "$gr_model" "$gr_eff_abbr")
cache_line=""
for cache_field in "$cx_cache" "$cb_cache" "$gm_cache" "$gr_cache"; do
  [ -n "$cache_field" ] || continue
  cache_line="${cache_line:+$cache_line }$cache_field"
done
write_cache "$cache_line"

# The table is one flat ranking of ACCOUNTS across the vendors — several rows of one vendor are
# ordinary, since what a reader needs is where the next runs go, not one nominee per leg — and row
# 1 IS the answer: `ACCOUNT:` under it is the same value printed a second time for a brief to copy,
# so the two can never disagree. A vendor answering nothing has no row — what it is doing instead
# is its own section below, and the reason reaches this block only when NOTHING answers.
NEXT_MAX_ROWS=5
# The two separators jq packs a candidate row with: keys inside a row, rows inside a vendor's blob.
NEXT_KEY_SEP=$'\x1d'
NEXT_ROW_SEP=$'\x1e'
vendor_label() {
  case "$1" in cb) printf claude ;; cx) printf codex ;; gm) printf gemini ;; gr) printf grok ;; esac
}
vendor_reason() {
  local known off state pool measured
  case "$1" in
    cb) known=$cb_known; off=$cb_role_off; state=$cl_state; pool=$cl_pool_empty
        measured=$cl_measured ;;
    cx) known=$cx_known; off=$cx_role_off; state=$cx_state; pool=$cx_pool_empty
        measured=$cx_measured ;;
    gm) known=$gm_known; off=$gm_role_off; state=$gm_state; pool=$gm_pool_empty
        measured=$gm_measured ;;
    gr) known=$gr_known; off=$gr_role_off; state=$gr_state; pool=$gr_pool_empty
        measured=$gr_measured ;;
  esac
  [ "$known" = true ] || return 0
  if [ "$off" = true ]; then printf 'off for workers'
  elif [ -n "$state" ]; then printf '%s' "$state"
  elif [ "$pool" = yes ]; then printf 'every account is out of the worker pool'
  # Nothing measured is no evidence of a wall: `WALLED` would send Egor hunting for a limit that
  # does not exist, and worker-run reads this wording to report UNAVAILABLE over a usage limit.
  elif [ "$measured" = no ]; then printf 'no quota data'
  else printf WALLED
  fi
}
print_next() {
  local force_lead=$1
  shift
  local name blob acct text line rank=0 pick="" reason="" lead="" stream="" merged=""
  local -a ranked=()
  for name in "$@"; do
    case "$name" in
      cb) blob=$cl_nextrows; acct=$cl_acct ;;
      cx) blob=$cx_nextrows; acct=$cx_acct ;;
      gm) blob=$gm_nextrows; acct=$gm_acct ;;
      gr) blob=$gr_nextrows; acct=$gr_acct ;;
    esac
    if [ -z "$blob" ]; then
      text=$(vendor_reason "$name")
      [ -z "$text" ] || reason="${reason:+$reason  |  }$(vendor_label "$name") $text"
      continue
    fi
    # Row 1 belongs to the vendor the MODE named, whose sequence put it first: `worker=grok` is an
    # order and not a budget, and `ACCOUNT:` under the table has to name what that vendor answered.
    # In `auto` the sequence is itself the pin-then-budget ranking, so this key changes nothing.
    if [ "$force_lead" = true ] && [ -z "$lead" ]; then
      lead="$acct$NEXT_KEY_SEP$(vendor_label "$name")"
    fi
    stream="${stream:+$stream$NEXT_ROW_SEP}$blob"
  done
  if [ -n "$stream" ]; then
    merged=$(printf '%s\n' "$stream" | tr "$NEXT_ROW_SEP" '\n' |
      awk -F"$NEXT_KEY_SEP" -v OFS="$NEXT_KEY_SEP" -v lead="$lead" \
        '{ print (($6 OFS $7) == lead ? 0 : 1), $0 }' |
      LC_ALL=C sort -t "$NEXT_KEY_SEP" -k1,1n -k2,2n -k3,3n -k4,4n -k5,5n -k6,6g -k7,7 -k8,8 |
      cut -d "$NEXT_KEY_SEP" -f7,9)
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      [ "$rank" -lt "$NEXT_MAX_ROWS" ] || break
      rank=$((rank + 1))
      ranked+=("$(printf '%-7s%s' " $rank" "${line#*"$NEXT_KEY_SEP"}")")
      [ "$rank" -ne 1 ] || pick="${line%%"$NEXT_KEY_SEP"*}"
    done <<<"$merged"
  fi
  if [ "${#ranked[@]}" -gt 0 ]; then
    printf '%-7s%-16s%-6s%-6s%-21s%s\n' NEXT budget wk 5h vendor/account 'model·eff'
    printf '%s\n' "${ranked[@]}"
    printf 'ACCOUNT: %s\n' "$pick"
    return 0
  fi
  # A verdict about quota outranks the per-vendor reasons that produced it, and a pause outranks
  # everything: with every vendor parked there is no router to report on.
  [ "$all_walled" != yes ] || reason='ALL WALLED, ask Egor'
  [ "$all_paused" = false ] || reason=$NOTHING_ROUTABLE
  printf 'NEXT: %s\n' "$reason"
}

if [ "$worker_mode" = gemini ]; then
  print_next true gm cb cx gr
elif [ "$worker_mode" = grok ]; then
  print_next true gr cb cx gm
elif [ "$worker_mode" = codex ]; then
  print_next true cx cb gm gr
elif [ "$worker_mode" = auto ]; then
  print_next false cb cx gm gr
else
  print_next true cb cx gm gr
fi

# One line per account, under the vendor that holds it: the columns are the NEXT block's, two
# characters further in, and the reset the budget was paced over closes the row.
print_section() {
  local label=$1 blob=$2 first=yes row
  [ -n "$blob" ] || return 0
  local IFS=$'\x1e'
  set -f
  for row in $blob; do
    if [ "$first" = yes ]; then
      printf '%-9s%s\n' "$label:" "$row"
      first=no
    else
      printf '%-9s%s\n' "" "$row"
    fi
  done
  set +f
}
[ "$cx_known" = false ] || print_section codex "$cx_rows"
[ "$gm_known" = false ] || print_section gemini "$gm_rows"
[ "$gr_known" = false ] || print_section grok "$gr_rows"
[ "$cb_known" = false ] || print_section claude "$cl_rows"
printf 'DATA: %s\n' "$age"

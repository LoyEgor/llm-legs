#!/usr/bin/env bash
{
set -u

resolve_script() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")" && printf '%s/%s\n' "$PWD" "$(basename "$source")"
}

script_path=$(resolve_script)
repo_root=$(cd "$(dirname "$script_path")/.." && pwd)
. "$repo_root/share/processes.sh"
. "$repo_root/share/worktree.sh"

die() { printf 'worktree: %s\n' "$*" >&2; exit 1; }

usage() {
  cat >&2 <<'EOF'
usage: worktree new <repo> <branch> [--add-dir <repo>]...
       worktree land <worktree-or-branch> [--repo <repo>] [--review <round>]... [--suites-passed]
new: <repo>/.claude/worktrees/<branch, / -> -> on branch, .claude/worktrees/ git-excluded first; an existing
  branch is reused, a new one starts from main, a night/<id>/* one from refs/night/<id>/base; prints its
  path, then `ADD-DIR: <path>` per --add-dir repository on the same branch (one it cannot make is named on
  stderr and skipped)
land: the gates (every --review round settled; a branch ending in a Code fixer run passes code-doctor check
  --landing, --suites-passed attesting green suites), a rebase onto main (a night branch still on its
  night's base: --onto main refs/night/<id>/base; a conflict aborts it), git merge --ff-only in the main
  checkout, the git hooks' push proven on origin main (WORKTREE_PUSH_WAIT_S, 120), then the worktree and
  branch removed here and on origin; prints `landed <repo> <branch> commits=<repo>:<hash>,...` and a
  `kept <what>: <why>` line for what stays (a process or ignored files inside, a Code fixer run, which
  night-run finish prunes later). A refusal is one line on stderr, exit 1, everything left in place.
  It never runs suites: the caller verified.
EOF
  exit 2
}

cmd_new() {
  local repo=${1:-} branch=${2:-} adds=() path
  [ $# -ge 2 ] || usage
  shift 2
  while [ $# -gt 0 ]; do
    case $1 in
      --add-dir) [ $# -ge 2 ] || usage; adds+=("$2"); shift 2 ;;
      *) usage ;;
    esac
  done
  path=$(worktree_new "$repo" "$branch") || exit 1
  printf '%s\n' "$path"
  worktree_siblings "$branch" ${adds[@]+"${adds[@]}"} | sed 's/^/ADD-DIR: /'
}

cmd_land() {
  local target=${1:-} repo='' reviews=() suites='' wt='' branch top night='' run='' round why base out files
  local before tip commits wait start dirty
  [ -n "$target" ] || usage
  shift
  while [ $# -gt 0 ]; do
    case $1 in
      --repo) [ $# -ge 2 ] || usage; repo=$2; shift 2 ;;
      --review) [ $# -ge 2 ] || usage; reviews+=("$2"); shift 2 ;;
      --suites-passed) suites=passed; shift ;;
      *) usage ;;
    esac
  done
  if [ -z "$repo" ] && [ -d "$target" ]; then
    wt=$(git -C "$target" rev-parse --show-toplevel 2>/dev/null) || die "$target is no git checkout"
    branch=$(git -C "$wt" symbolic-ref -q --short HEAD) || die "$wt is on a detached HEAD: land its branch by name"
    repo=$wt
  else
    branch=$target
  fi
  top=$(worktree_main "${repo:-.}") || die "no repository at ${repo:-$PWD}"
  [ "$branch" != main ] || die "main is no branch to land"
  git -C "$top" show-ref --verify --quiet "refs/heads/$branch" || die "no branch $branch in $top"
  [ "$(git -C "$top" symbolic-ref -q HEAD)" = refs/heads/main ] || die "the main checkout $top is not on main"
  [ -n "$wt" ] || wt=$(git -C "$top" worktree list --porcelain |
    awk -v b="branch refs/heads/$branch" '/^worktree / { w = substr($0, 10) } $0 == b { print w; exit }')
  if [ -n "$wt" ]; then
    dirty=$(git -C "$wt" status --porcelain --untracked-files=all | wc -l | tr -d ' ')
    [ "$dirty" = 0 ] || die "$wt has $dirty uncommitted files: commit them first"
  fi
  [[ $branch == night/*/* ]] && night=${branch#night/} && night=${night%%/*}
  for round in ${reviews[@]+"${reviews[@]}"}; do
    why=$(review_refusal "$branch" "$round")
    [ -z "$why" ] || die "$why"
  done
  if run=$(code_run_of "$branch"); then
    why=$(code_refusal "$night" "$run" "$suites")
    [ -z "$why" ] || die "$(tr -s '\n' ' ' <<<"$why")"
  fi
  if ! git -C "$top" merge-base --is-ancestor refs/heads/main "refs/heads/$branch"; then
    [ -n "$wt" ] || die "$branch is behind main and has no worktree to rebase in"
    base=''
    [ -z "$night" ] || ! git -C "$top" merge-base --is-ancestor "refs/night/$night/base" "refs/heads/$branch" 2>/dev/null ||
      base="refs/night/$night/base"
    if [ -n "$base" ]; then set -- --onto main "$base"; else set -- main; fi
    if ! out=$(git -C "$wt" rebase -q "$@" 2>&1); then
      files=$(git -C "$wt" diff --name-only --diff-filter=U | head -5 | paste -sd ' ' -)
      git -C "$wt" rebase --abort >/dev/null 2>&1
      die "the rebase of $branch onto main stopped${files:+ on conflicts in $files}: resolve it in $wt and land again"
    fi
  fi
  before=$(git -C "$top" rev-parse refs/heads/main)
  out=$(git -C "$top" merge -q --ff-only "$branch" 2>&1) ||
    die "git refused to fast-forward main in $top to $branch: $(grep -v '^$' <<<"$out" | tr -s '\n\t' '  ')"
  tip=$(git -C "$top" rev-parse refs/heads/main)
  commits=$(git -C "$top" rev-list --reverse "$before..$tip" | sed "s|^|$(basename "$top"):|" | paste -sd , -)
  if git -C "$top" remote get-url origin >/dev/null 2>&1; then
    wait=${WORKTREE_PUSH_WAIT_S:-120} start=$SECONDS
    while why=$(origin_refusal "$top" "$tip") && [ -n "$why" ] && [ $((SECONDS - start)) -lt "$wait" ]; do sleep 2; done
    [ -z "$why" ] ||
      die "main of $top holds $branch, but origin main lacks ${tip:0:12} after $wait s (the git hooks push it): the worktree and branch stay; land again once it is pushed"
  fi
  printf 'landed %s %s commits=%s\n' "$(basename "$top")" "$branch" "$commits"
  if [ -n "$wt" ] && why=$(landed_keep "$wt"); then
    printf 'kept %s: %s\n' "$wt" "$why"
  elif [ -n "$run" ]; then
    printf 'kept %s: code-doctor check reads the Code fixer run from it; night-run finish prunes it\n' "${wt:-$branch}"
  elif ! out=$({ [ -z "$wt" ] || git -C "$top" worktree remove "$wt"; } 2>&1 && git -C "$top" branch -q -D "$branch" 2>&1); then
    printf 'kept %s: git refused its removal: %s\n' "${wt:-$branch}" "$(tr -s '\n' ' ' <<<"$out")"
  elif git -C "$top" ls-remote --exit-code --heads origin "refs/heads/$branch" >/dev/null 2>&1 &&
    ! out=$(git -C "$top" push -q origin --delete "$branch" 2>&1) &&
    git -C "$top" ls-remote --exit-code --heads origin "refs/heads/$branch" >/dev/null 2>&1; then
    printf 'kept origin %s: %s\n' "$branch" "$(tr -s '\n' ' ' <<<"$out")"
  fi
}

case ${1:-} in
  new) shift; cmd_new "$@" ;;
  land) shift; cmd_land "$@" ;;
  *) usage ;;
esac
exit; }

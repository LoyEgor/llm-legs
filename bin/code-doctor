def base_home():
    return os.environ.get("HOME") or os.path.expanduser("~")


def scoped():
    return bool(SCOPE) and sorted(SCOPE) != sorted(default_repos())


def state_dir():
    base = os.environ.get("CODE_DOCTOR_DIR") or os.path.join(base_home(), ".cache", "code-doctor")
    if scoped():
        return os.path.join(base, "scopes", scope_slug(SCOPE))
    return base


def ledger_path():
    return os.environ.get("CODE_DOCTOR_LEDGER") or os.path.join(ROOT_DIR, "share", "code-ledger.json")


def mechanisms_path():
    return os.environ.get("CODE_DOCTOR_MECHANISMS") or os.path.join(ROOT_DIR, "share", "canonical-mechanisms.json")


def harness_dir():
    return os.environ.get("HARNESS_DOCTOR_DIR") or os.path.join(base_home(), ".cache", "harness-doctor")


def statusline_cache():
    return os.environ.get("STATUSLINE_CACHE_DIR") or os.path.join(base_home(), ".cache", "claude-statusline")


def worker_run_cmd():
    return os.environ.get("CODE_DOCTOR_WORKER_RUN") or os.path.join(ROOT_DIR, "bin", "worker-run")


def repos_dir():
    return os.environ.get("DOCTOR_FIX_PROJECTS") or "/Volumes/Work/Projects"


def default_repos():
    listed = os.environ.get("CODE_DOCTOR_REPOS")
    if listed:
        paths = [p for p in listed.split(":") if p]
    else:
        sweep = os.environ.get("NIGHT_RUN_SWEEP_REPOS") or os.path.join(base_home(), ".claude", "sweep-repos")
        try:
            with open(sweep) as handle:
                paths = [line.strip() for line in handle if line.strip()]
        except OSError:
            paths = []
    return [os.path.realpath(p) for p in paths if os.path.isdir(p)]


def repo_paths():
    return SCOPE or default_repos()


def scope_slug(tops):
    names = re.sub(r"[^A-Za-z0-9._+-]+", "-", "+".join(repo_name(t) for t in sorted(tops)))[:60]
    return "%s-%s" % (names, sha(":".join(sorted(tops)))[:8])


def set_scope(paths):
    tops = []
    for path in paths or ():
        if not os.path.isdir(path):
            raise SystemExit("code-doctor: --repo %s is not a directory" % path)
        top = (git(path, "rev-parse", "--show-toplevel") or "").strip() or path
        tops.append(os.path.realpath(top))
    SCOPE[:] = sorted(set(tops))


def foreign_repos(doc=None):
    home = set(default_repos())
    found = {top for top in repo_paths() if top not in home}
    found.update(((doc or {}).get("scope") or {}).get("foreign") or ())
    return sorted(found)


def report_only(doc=None):
    foreign = foreign_repos(doc)
    if not foreign:
        return None
    return "report-only scope: %s is not a sweep repository, so no fixer edits it" % ", ".join(foreign)


def now_s():
    return float(os.environ.get("CODE_DOCTOR_NOW") or time.time())


def read_json(path, default=None):
    try:
        with open(path, encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return default


def loose_json(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            text = handle.read(500000)
    except OSError:
        return None
    text = re.sub(r"(\"(?:\\.|[^\"\\])*\")|//[^\n]*|/\*.*?\*/", lambda m: m.group(1) or "", text, flags=re.S)
    try:
        value = json.loads(re.sub(r",(\s*[}\]])", r"\1", text))
    except ValueError:
        return None
    return value if isinstance(value, dict) else None


def write_json(path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    handle, temporary = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp.")
    with os.fdopen(handle, "w", encoding="utf-8") as out:
        json.dump(value, out, ensure_ascii=False, indent=1, sort_keys=True)
        out.write("\n")
    os.replace(temporary, path)


def append_jsonl(path, row):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")


def read_jsonl(path):
    rows = []
    try:
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                if isinstance(row, dict):
                    rows.append(row)
    except OSError:
        pass
    return rows


def iso_time(epoch):
    if epoch is None:
        return None
    return datetime.datetime.fromtimestamp(epoch).astimezone().isoformat(timespec="seconds")


def iso_epoch(text):
    if not isinstance(text, str) or not text:
        return None
    try:
        return datetime.datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def clip(text, limit=EXCERPT_MAX):
    text = text or ""
    return text if len(text) <= limit else text[: limit - 1] + "…"


def sha(text):
    return hashlib.sha256(text.encode() if isinstance(text, str) else text).hexdigest()


def git(folder, *args, timeout=60, raw=False):
    try:
        out = subprocess.run(["git", "-C", folder] + list(args), capture_output=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    return out.stdout if raw else out.stdout.decode("utf-8", "replace")


def repo_name(top):
    return os.path.basename(top.rstrip("/"))




def file_lang(rel, head):
    ext = os.path.splitext(rel)[1].lower()
    if ext in EXT_LANG:
        return EXT_LANG[ext]
    first = head.split("\n", 1)[0]
    if first.startswith("#!"):
        words = first[2:].split()
        if words and words[0].rsplit("/", 1)[-1] == "env":
            first = "#!/" + " ".join(w for w in words[1:] if not w.startswith("-") and "=" not in w)
        for word, lang in SHEBANG_LANG:
            if word in first:
                return lang
        return "undeclared:" + first[2:].split()[0].rsplit("/", 1)[-1] if first[2:].split() else "undeclared:?"
    return "undeclared:" + (ext.lstrip(".") or "none")


def file_kind(rel, lang):
    if FIXTURE_PART.search(rel):
        return "fixture"
    if INSTRUCTION_PART.search(rel):
        return "instruction"
    if rel.endswith("tests/run-all"):
        return "code"
    if TEST_PART.search(rel) and lang not in ("doc", "data"):
        return "test"
    if lang == "doc":
        return "doc"
    if lang == "data":
        return "data"
    return "code"


def comment_line(line, lang):
    mark = COMMENT.get(lang)
    stripped = line.lstrip()
    return bool(mark) and stripped.startswith(mark) and not stripped.startswith("#!")


def tokens_of(text):
    found = set()
    for token in TOKEN_RE.findall(text):
        token = token.rstrip(".-/")
        if len(token) >= 3:
            found.add(token)
    return found


def normalize(text, lang):
    words = []
    for line in text.splitlines():
        if comment_line(line, lang) or not line.strip():
            continue
        line = STRING_RE.sub(" S ", line)
        for word in WORD_RE.findall(line):
            words.append("N" if word.isdigit() else word.lower())
    return words


def sketch(words):
    if len(words) < SHINGLE:
        return []
    hashes = {zlib.crc32(" ".join(words[i:i + SHINGLE]).encode()) for i in range(len(words) - SHINGLE + 1)}
    return sorted(heapq.nsmallest(SKETCH_K, hashes))


def touchpoints(text, lang):
    found = set()
    for line in text.splitlines():
        if comment_line(line, lang):
            continue
        for match in STRING_RE.finditer(line):
            literal = match.group(1) or match.group(2)
            if " " not in literal and re.search(r"[-./:]", literal):
                found.add("lit:" + literal)
        if lang == "bash":
            for segment in re.split(r"\|\||&&|[|;]|\$\(|`", line):
                words = segment.strip().split()
                while words and "=" in words[0]:
                    words = words[1:]
                if words and re.fullmatch(r"[a-z][a-z0-9_.\-]+", words[0]) and words[0] not in BASH_WORDS:
                    found.add("cmd:" + words[0])
        elif lang == "python":
            for module in re.findall(r"^\s*(?:from\s+([\w.]+)\s+import|import\s+([\w.]+))", line):
                found.add("mod:" + (module[0] or module[1]))
            for call in re.findall(r"\[\s*[\"']([a-z][\w.\-]+)[\"']\s*,", line):
                found.add("cmd:" + call)
            for call in re.findall(r"\b([a-z_]\w*\.[a-z_]\w*)\(", line):
                found.add("call:" + call)
        elif lang == "lua":
            for call in re.findall(r"\b(hs\.[\w.]+)", line):
                found.add("call:" + call)
        elif lang == "js":
            for call in re.findall(r"\b(?:page|browser|context)\.(\w+)\(", line):
                found.add("call:" + call)
            for module in re.findall(r"require\(\s*[\"']([^\"']+)[\"']\)|from\s+[\"']([^\"']+)[\"']", line):
                found.add("mod:" + (module[0] or module[1]))
    return found


def glyphs_of(text):
    return {c for c in text if ord(c) > 0x7f and unicodedata.category(c)[0] in "SP"}


def literal_features(text, lang):
    found = set()
    for number, line in enumerate(text.splitlines(), 1):
        if comment_line(line, lang):
            continue
        for match in LITERAL_RE.finditer(line):
            literal = next(g for g in match.groups() if g is not None)
            skeleton = re.sub(r"\s+", " ", TEMPLATE_RE.sub("{}", literal)).strip()
            joined = "{}" * line[:match.start()].rstrip().endswith(("..", "+")) + skeleton + \
                "{}" * line[match.end():].lstrip().startswith(("..", "+"))
            for glyph in glyphs_of(literal):
                found.add(("glyph:" + glyph, number, 2 if re.search(r"\{\}[^{}]{0,3}%s[^{}]{0,3}\{\}" % re.escape(glyph), joined) else 0))
            if len(literal) > 120 or REGEX_MARK.search(literal):
                continue
            fixed = skeleton.replace("{}", " ")
            if "{}" in skeleton and " " in skeleton and "/" not in fixed and (re.search(r"[A-Za-z]{3}", fixed) or glyphs_of(fixed)):
                found.add(("tpl:" + skeleton, number, 1))
    return sorted([f, n, t] for f, n, t in found)


def layout_sections(text):
    sections, heading, start, body, fence, fenced, prose_fence, fences = [], "", 1, [], [], False, False, []

    def close():
        joined = " ".join(line.strip() for _, line in body)
        marks = {"row": sum(1 for m in ROW_TEMPLATE_RE.finditer(joined) if ROW_SEPARATOR_RE.search(m.group(0))),
                 "enum": 2 if len(ENUM_PART_RE.findall(joined)) >= 3 else 0, "fence": 2 * len(fences),
                 "words": len(LAYOUT_WORDS.findall(joined))}
        if OUTPUT_WORDS.search(joined) and sum(marks.values()) >= LIMITS["layout_score"]:
            hits = [n for n, line in body if ENUM_PART_RE.search(line) or LAYOUT_WORDS.search(line) or "`<" in line] + fences
            sections.append([heading or "(top)", min(hits or [start]), sum(marks.values()), ",".join(k for k in marks if marks[k])])

    for number, line in enumerate(text.splitlines(), 1):
        if line.lstrip().startswith("```"):
            if fenced and prose_fence and sum(1 for f in fence if re.match(r"\s*(#|\||[-*] |\*\*|<[A-Za-z][^>]*>|[A-Z][\w ]{0,20}:)", f)) >= 2:
                fences.append(number - len(fence))
            prose_fence = not fenced and line.strip()[3:].strip().lower() in ("", "text", "txt", "md", "markdown")
            fenced, fence = not fenced, []
            continue
        if fenced:
            fence.append(line)
            continue
        heading_match = HEADING_RE.match(line)
        if heading_match:
            close()
            heading, start, body, fences = heading_match.group(1).strip(), number, [], []
            continue
        body.append((number, line))
    close()
    return sections


def prose_sentences(chunks):
    out = []
    for start, chunk in chunks:
        offset = 0
        for piece in SENTENCE_SPLIT.split(chunk):
            at = chunk.find(piece, offset)
            offset = at + len(piece)
            out.append((start + chunk.count("\n", 0, max(at, 0)), re.sub(r"\s+", " ", piece).strip()))
    return out


def markdown_chunks(text):
    chunks, para, start, fenced = [], [], 0, False
    for number, line in enumerate(text.splitlines(), 1):
        stripped = line.strip()
        item = re.match(r"([-*+]|\d+[.)])\s+", stripped)
        if stripped.startswith("```") or fenced or not stripped or HEADING_RE.match(stripped) or stripped.startswith("|") or item:
            if para:
                chunks.append((start, "\n".join(para)))
            para = []
        if stripped.startswith("```"):
            fenced = not fenced
            continue
        if fenced or not stripped or HEADING_RE.match(stripped) or re.fullmatch(r"[\s|:-]+", stripped):
            continue
        if stripped.startswith("|"):
            chunks.append((number, stripped.strip("|")))
            continue
        if not para:
            start = number
        para.append(stripped[item.end():] if item else stripped)
    if para:
        chunks.append((start, "\n".join(para)))
    return chunks


def code_chunks(rel, text, lang, symbols):
    lines = text.splitlines()
    if HOOK_PART.search(rel):
        return [(n, lit) for n, line in enumerate(lines, 1) if not comment_line(line, lang)
                for lit in (next(g for g in m.groups() if g is not None) for m in LITERAL_RE.finditer(line))
                if len(lit.split()) >= 5], None
    if not CLI_PART.search(rel):
        return [], None
    chunks = []
    if lang == "python":
        doc = re.match(r"\s*(?:#[^\n]*\n\s*)*[rbu]?(\"\"\"|''')(.*?)\1", text, re.S)
        if doc:
            chunks.append((text[:doc.start(2)].count("\n") + 1, doc.group(2)))
        for match in re.finditer(r"\b(?:help|description|epilog)\s*=\s*[rbuf]*(\"(?:[^\"\\\n]|\\.)*\"|'(?:[^'\\\n]|\\.)*')", text):
            chunks.append((text[:match.start()].count("\n") + 1, match.group(1)[1:-1]))
    for symbol in symbols:
        if not re.search(r"usage|help", symbol["name"], re.I):
            continue
        heredoc = None
        for number in range(symbol["start"], min(symbol["end"], len(lines)) + 1):
            line = lines[number - 1]
            if heredoc:
                if line.strip() == heredoc:
                    heredoc = None
                else:
                    chunks.append((number, line))
                continue
            opened = re.search(r"<<-?\s*['\"]?(\w+)", line)
            heredoc = opened.group(1) if opened else None
            chunks += [(number, next(g for g in m.groups() if g is not None)) for m in LITERAL_RE.finditer(line)]
    return chunks, os.path.basename(rel)


def claim_of(sentence, implicit=None):
    masked = re.sub(r"`[^`\n]*`", lambda m: " " * len(m.group(0)), sentence)
    names = []
    for match in NAME_RE.finditer(sentence):
        if match.group(1):
            words = match.group(1).split()
            if not words:
                continue
            name = " ".join(words[:2]) if len(words) > 1 and re.fullmatch(r"[a-z][a-z-]{1,20}", words[1]) else words[0]
        else:
            name = match.group(2) or match.group(3)
        name = name.rstrip(".,:;")
        if name:
            names.append((match.start(), name))
    for match in EFFECT_RE.finditer(masked):
        if not CLAUSE_SPLIT.split(sentence[:match.start()])[-1].strip(" *_>\"«("):
            continue
        if implicit or any(at < match.start() for at, _ in names):
            found = sorted({n for _, n in names} | ({implicit} if implicit else set()))
            return RISKS[next(i for i, g in enumerate(match.groups()) if g)], found
    return None


def claims_of(rel, text, lang, symbols):
    if lang == "doc":
        chunks, implicit = markdown_chunks(text), None
    else:
        chunks, implicit = code_chunks(rel, text, lang, symbols)
    out, seen = [], set()
    for line, sentence in prose_sentences(chunks):
        found = claim_of(sentence, implicit) if len(sentence.split()) >= 4 else None
        if not found:
            continue
        digest = sha(re.sub(r"\s+", " ", re.sub(r"[*_`]", "", sentence)).strip().lower())[:12]
        if digest not in seen:
            seen.add(digest)
            out.append([digest, line, clip(sentence, 400), found[0], found[1]])
    return out


def block_end(lines, start, lang, indent):
    if lang == "python":
        for index in range(start + 1, len(lines)):
            line = lines[index]
            if line.strip() and not line.lstrip().startswith("#") and len(line) - len(line.lstrip()) <= indent:
                return index
        return len(lines)
    depth, opened = 0, False
    closer = "end" if lang == "lua" else "}"
    for index in range(start, len(lines)):
        line = lines[index]
        if comment_line(line, lang):
            continue
        if lang == "lua":
            line = re.sub(r"--.*", "", LITERAL_RE.sub(" ", line))
            depth += len(re.findall(r"\b(function|do|then)\b", line)) - len(re.findall(r"\belseif\b", line))
            depth -= len(re.findall(r"\bend\b", line))
            opened = True
        else:
            depth += line.count("{") - line.count("}")
            opened = opened or "{" in line
        if opened and depth <= 0 and (closer in line or index > start):
            return index + 1
    return len(lines)


def symbols_of(text, lang, offset=0):
    lines = text.splitlines()
    pattern = SYMBOL_RE.get(lang)
    out = []
    if not pattern:
        return out
    for index, line in enumerate(lines):
        match = pattern.match(line)
        if not match:
            continue
        if lang == "python":
            indent, name = len(match.group(1)), match.group(2)
        else:
            indent, name = 0, next(g for g in match.groups() if g)
        end = block_end(lines, index, lang, indent)
        body = "\n".join(lines[index:end])
        words = normalize(body, lang)
        out.append({"name": name, "start": offset + index + 1, "end": offset + end, "lines": end - index,
                    "lang": lang, "digest": sha(body)[:16], "sketch": sketch(words) if end - index >= LIMITS["reuse_min_lines"] else [],
                    "touch": sorted(touchpoints(body, lang)),
                    "branches": len(re.findall(r"\b(if|elif|elseif|case|while|for)\b", body))})
    return out


def embedded_blocks(text):
    lines = text.splitlines()
    out, index = [], 0
    while index < len(lines):
        line = lines[index]
        match = HEREDOC_RE.search(line)
        assign = ASSIGN_BLOCK_RE.match(line)
        if match:
            lang = {"python": "python", "python3": "python", "jq": "jq", "lua": "lua", "node": "js"}[match.group(1)]
            tag = match.group(2)
            end = next((j for j in range(index + 1, len(lines)) if lines[j].strip() == tag), len(lines))
            out.append((lang, index + 1, "\n".join(lines[index + 1:end])))
            index = end + 1
            continue
        if assign:
            end = next((j for j in range(index + 1, len(lines)) if lines[j].strip() == "'"), None)
            if end is not None:
                body = "\n".join(lines[index + 1:end])
                if re.search(r"^\s*(def |import |from \w+ import )", body, re.M):
                    out.append(("python", index + 1, body))
                    index = end + 1
                    continue
        index += 1
    return out


def parse_file(rel, data):
    text = data.decode("utf-8", "replace")
    lang = file_lang(rel, text[:200])
    kind = file_kind(rel, lang)
    code, comment = set(), set()
    globs = []
    code_lang = lang if lang in DECLARED else None
    for line in text.splitlines():
        target = comment if code_lang and comment_line(line, code_lang) else code
        target.update(tokens_of(line))
        if target is code and code_lang:
            for match in GLOB_RE.finditer(line):
                globs.append([match.group(1).split("/")[-1], match.group(2), match.group(3)])
            templated = TEMPLATE_RE.sub("*", line)
            if templated != line:
                for match in GLOB_RE.finditer(templated):
                    spec = [match.group(1).split("/")[-1] or "@here", match.group(2), match.group(3)]
                    if (spec[0] != "@here" or spec[1] or spec[2]) and spec not in globs:
                        globs.append(spec)
    record = {"lang": lang, "kind": kind, "lines": text.count("\n") + 1, "symbols": [], "touch": [],
              "refs": {"code": sorted(code), "comment": sorted(comment - code)}, "globs": globs}
    if lang in DECLARED:
        record["symbols"] = symbols_of(text, lang)
        if lang == "bash":
            for inner, offset, body in embedded_blocks(text):
                record["symbols"] += symbols_of(body, inner, offset)
        record["touch"] = sorted(touchpoints(text, lang))
        record["imports"] = imports_of(text, lang)
        record["lits"] = literal_features(text, lang)
        record["claims"] = claims_of(rel, text, lang, record["symbols"])
    elif lang == "doc" and PROSE_PART.search(rel):
        record["layout"] = layout_sections(text)
    if lang == "doc" and kind != "fixture" and rel.endswith(".md"):
        record["claims"] = claims_of(rel, text, lang, ())
    return record


def imports_of(text, lang):
    found = set()
    if lang == "bash":
        found.update("-m " + module for module in re.findall(r"\bpython[\d.]*(?:\s+-\w+)*\s+-m\s+([A-Za-z_][\w.]*)", text))
    elif lang == "js":
        for line in text.splitlines():
            if not comment_line(line, lang):
                found.update(g for match in JS_IMPORT_RE.finditer(line) for g in match.groups() if g)
    elif lang == "python":
        for source, grouped, names, plain in PY_IMPORT_RE.findall(text):
            if plain:
                found.update(m.strip() for m in plain.split(","))
                continue
            found.add(source)
            for name in re.split(r"[\s,]+", re.sub(r"#[^\n]*", "", grouped or names)):
                if re.fullmatch(r"[A-Za-z_]\w*", name) and name != "as":
                    found.add(source + name if source.endswith(".") else source + "." + name)
    return sorted(found)


def list_files(top):
    out = git(top, "ls-files", "-z", "--cached", "--others", "--exclude-standard")
    if out is None:
        found = []
        for folder, dirs, files in os.walk(top):
            dirs[:] = [d for d in dirs if d not in (".git", "node_modules") and not (d == "worktrees" and folder.endswith(".claude"))]
            found += [os.path.relpath(os.path.join(folder, f), top) for f in files]
        return sorted(found)
    return sorted({p for p in out.split("\0") if p and "/.claude/worktrees/" not in "/" + p
                   and not p.startswith("node_modules/") and "/node_modules/" not in p})


def index_repo(top, cache):
    name = repo_name(top)
    path = os.path.join(state_dir(), "index", name + ".json")
    old = read_json(path, {}) or {}
    old_all = old.get("files") or {}
    old_files = old_all if old.get("parser") == PARSER_VERSION else {}
    files, changed, reused, skipped = {}, [], 0, []
    for rel in list_files(top):
        full = os.path.join(top, rel)
        try:
            info = os.stat(full)
        except OSError:
            continue
        if not os.path.isfile(full):
            continue
        prior = old_files.get(rel)
        link = os.path.islink(full)
        target = os.path.realpath(full) if link else None
        if prior and prior.get("size") == info.st_size and prior.get("mtime_ns") == info.st_mtime_ns and prior.get("link") == link \
                and prior.get("target") == target:
            files[rel] = prior
            reused += 1
            continue
        if info.st_size > MAX_FILE_BYTES:
            skipped.append(rel)
            continue
        try:
            with open(full, "rb") as handle:
                data = handle.read()
        except OSError:
            continue
        if b"\0" in data[:8192]:
            continue
        digest = sha(data)
        lang = file_lang(rel, data.decode("utf-8", "replace")[:200])
        key = (digest, lang, file_kind(rel, lang), bool(PROSE_PART.search(rel)),
               os.path.basename(rel) if CLI_PART.search(rel) or HOOK_PART.search(rel) else None)
        if prior and prior.get("digest") == digest:
            record = dict(prior)
        elif key in cache:
            record = dict(cache[key])
        else:
            record = parse_file(rel, data)
            record["digest"] = digest
        record.update(size=info.st_size, mtime_ns=info.st_mtime_ns, link=link, target=target, exec=bool(info.st_mode & 0o111))
        cache[key] = record
        files[rel] = record
        if (old_all.get(rel) or {}).get("digest") != digest:
            changed.append(rel)
    snapshot = sha("\n".join("%s %s" % (rel, files[rel]["digest"]) for rel in sorted(files)))
    previous = old.get("cursor") or {}
    cursor = {"snapshot": snapshot, "head": (git(top, "rev-parse", "HEAD") or "").strip() or None,
              "at": iso_time(now_s()), "previous": previous.get("snapshot"),
              "changed": sorted(set(changed) | set(old_all) - set(files)) if previous else None,
              "fresh": fresh_symbols(files, old_all, changed, previous.get("fresh") or {}) if previous else {}}
    doc = {"repo": name, "top": top, "parser": PARSER_VERSION, "cursor": cursor, "files": files, "skipped": skipped}
    write_json(path, doc)
    return doc, len(changed), reused


def fresh_symbols(files, old_files, changed, carried):
    cutoff, now = now_s() - LIMITS["fresh_days"] * 86400, iso_time(now_s())
    out = {}
    for rel, record in files.items():
        symbols = {s["name"]: s["digest"] for s in record.get("symbols") or ()}
        symbols.update(("promise:" + c[0], c[0]) for c in record.get("claims") or ())
        kept = {name: seen for name, seen in (carried.get(rel) or {}).items()
                if symbols.get(name) == seen[0] and (iso_epoch(seen[1]) or 0) > cutoff}
        if rel in changed:
            before = {s["digest"] for s in (old_files.get(rel) or {}).get("symbols") or ()} | {
                c[0] for c in (old_files.get(rel) or {}).get("claims") or ()}
            kept.update({name: [digest, now] for name, digest in symbols.items() if digest not in before and name not in kept})
        if kept:
            out[rel] = kept
    return out


def run_index():
    started = time.time()
    cache, summary = {}, []
    for top in repo_paths():
        doc, changed, reused = index_repo(top, cache)
        summary.append({"repo": doc["repo"], "files": len(doc["files"]), "parsed": changed, "reused": reused,
                        "snapshot": doc["cursor"]["snapshot"][:12]})
    account(None, None, "collector", cpu_s=cpu_seconds(), wall_s=time.time() - started, note="index")
    return summary


def load_indexes():
    out = {}
    for top in repo_paths():
        doc = read_json(os.path.join(state_dir(), "index", repo_name(top) + ".json"))
        if isinstance(doc, dict) and doc.get("top") == top:
            out[doc["repo"]] = doc
    return out


def cpu_seconds():
    usage = resource.getrusage(resource.RUSAGE_SELF)
    return round(usage.ru_utime + usage.ru_stime, 3)




def journal_sources():
    base = harness_dir()
    out = {}
    for path in glob.glob(os.path.join(base, "hooks", "*.tsv")) + glob.glob(os.path.join(base, "hooks", "folded", "*.tsv")):
        stem = os.path.basename(path)[:-4]
        if stem.isdigit():
            day = time.strftime("%Y-%m-%d", time.gmtime(int(stem) * 86400))
            out.setdefault(("hooks", day), []).append(path)
    for sub in ("menu", "statusline"):
        for path in glob.glob(os.path.join(base, sub, "*.tsv")):
            day = os.path.basename(path)[:10]
            if re.fullmatch(r"\d{4}-\d\d-\d\d", day):
                out.setdefault((sub, day), []).append(path)
    return out


def run_rollup():
    if foreign_repos():
        return 0
    folder = os.path.join(state_dir(), "rollup")
    today = time.strftime("%Y-%m-%d", time.localtime(now_s()))
    written = 0
    for (source, day), paths in sorted(journal_sources().items()):
        hits, ms, sessions = {}, {}, set()
        for path in paths:
            try:
                with open(path, errors="replace") as handle:
                    for line in handle:
                        fields = line.rstrip("\n").split("\t")
                        if len(fields) < 3 or not fields[0].isdigit() or not fields[1].isdigit():
                            continue
                        if source == "hooks":
                            if not fields[2].split():
                                continue
                            key = "hook:" + fields[2].split()[0]
                        elif source == "menu":
                            key = "menu:" + fields[2]
                        else:
                            key = "statusline"
                            sessions.add(fields[2])
                        hits[key] = hits.get(key, 0) + 1
                        ms[key] = ms.get(key, 0) + max(0, (int(fields[1]) - int(fields[0])) // 1000)
            except OSError:
                continue
        path = os.path.join(folder, day + ".json")
        doc = read_json(path, {}) or {"day": day, "sources": {}}
        doc["sources"][source] = {"hits": hits, "ms": ms, "sessions": len(sessions) if source == "statusline" else None}
        doc["complete"] = day < today
        write_json(path, doc)
        written += 1
    for events in sorted(glob.glob(os.path.join(harness_dir(), "events", "*.jsonl"))):
        day = os.path.basename(events)[:-6]
        if not re.fullmatch(r"\d{4}-\d\d-\d\d", day):
            continue
        hits, refs, reasons, rows = {}, {}, {}, []
        try:
            with open(events, encoding="utf-8", errors="replace") as handle:
                for line in handle:
                    if line.startswith('["o",'):
                        try:
                            rows.append(json.loads(line))
                        except ValueError:
                            continue
        except OSError:
            continue
        for row in rows:
            if len(row) >= 6:
                key = "overclaim:%s" % row[2]
                hits[key] = hits.get(key, 0) + 1
                refs[key] = (refs.get(key, []) + ["%s %s" % (row[3], row[4])])[-EVIDENCE_MAX:]
                reasons[key] = sorted(set(reasons.get(key, [])) | {row[5]})
        path = os.path.join(folder, day + ".json")
        doc = read_json(path, {}) or {"day": day, "sources": {}}
        if not hits and "overclaims" not in doc["sources"]:
            continue
        doc["sources"]["overclaims"] = {"hits": hits, "ms": {}, "refs": refs, "reasons": reasons}
        doc["complete"] = day < today
        write_json(path, doc)
        written += 1
    return written


def rollup_days():
    days = {}
    for path in glob.glob(os.path.join(state_dir(), "rollup", "*.json")):
        doc = read_json(path)
        if isinstance(doc, dict) and doc.get("day"):
            days[doc["day"]] = doc
    return days


def coverage(days, source="hooks"):
    covered = sorted(day for day, doc in days.items() if source in (doc.get("sources") or {}) and doc.get("complete"))
    if not covered:
        return {"source": source, "start": None, "end": None, "days": 0, "gaps": [], "tail_days": 0}
    start = datetime.date.fromisoformat(covered[0])
    end = datetime.date.fromisoformat(covered[-1])
    present = set(covered)
    gaps, tail, day = [], 0, end
    probe = start
    while probe <= end:
        if probe.isoformat() not in present:
            gaps.append(probe.isoformat())
        probe += datetime.timedelta(days=1)
    while day.isoformat() in present:
        tail += 1
        day -= datetime.timedelta(days=1)
    return {"source": source, "start": covered[0], "end": covered[-1], "days": len(covered), "gaps": gaps,
            "tail_days": tail, "tail_start": (end - datetime.timedelta(days=tail - 1)).isoformat()}


def rollup_totals(days, since=None):
    hits, ms, sessions, counted = {}, {}, [], 0
    for day, doc in days.items():
        if since and day < since or not doc.get("complete"):
            continue
        counted += 1
        for source in (doc.get("sources") or {}).values():
            for key, value in (source.get("hits") or {}).items():
                hits[key] = hits.get(key, 0) + value
            for key, value in (source.get("ms") or {}).items():
                ms[key] = ms.get(key, 0) + value
            if source.get("sessions"):
                sessions.append(source["sessions"])
    return hits, ms, (sum(sessions) / len(sessions)) if sessions else None, counted




def settings_commands(tops=()):
    claude = os.path.join(base_home(), ".claude")
    files = [("settings.json", os.path.join(claude, "settings.json")),
             ("settings.local.json", os.path.join(claude, "settings.local.json"))]
    for top in tops:
        for name in ("settings.json", "settings.local.json"):
            files.append(("%s/.claude/%s" % (repo_name(top), name), os.path.join(top, ".claude", name)))
    out = []
    for label, path in files:
        settings = read_json(path, {})
        if not isinstance(settings, dict):
            continue
        hooks = settings.get("hooks")
        for event, groups in (hooks.items() if isinstance(hooks, dict) else ()):
            for group in groups if isinstance(groups, list) else ():
                for hook in (group.get("hooks") if isinstance(group, dict) else None) or []:
                    if isinstance(hook, dict) and hook.get("command"):
                        out.append(("settings", "%s hooks.%s" % (label, event), str(hook["command"])))
        status = settings.get("statusLine")
        if isinstance(status, dict) and status.get("command"):
            out.append(("settings", "%s statusLine" % label, str(status["command"])))
    return out


def launch_agents():
    out = []
    folder = os.path.join(base_home(), "Library", "LaunchAgents")
    for path in sorted(glob.glob(os.path.join(folder, "*.plist"))):
        plist = read_plist(path)
        if plist is None:
            continue
        args = [str(a) for a in (plist.get("ProgramArguments") or [])] + ([str(plist["Program"])] if plist.get("Program") else [])
        text = " ".join(args)
        for arg in args:
            arg = os.path.expanduser(arg)
            if os.path.isfile(arg) and os.path.dirname(os.path.realpath(arg)) == os.path.realpath(os.path.join(base_home(), ".local", "libexec")):
                try:
                    with open(arg, errors="replace") as handle:
                        text += "\n" + handle.read(20000)
                except OSError:
                    pass
        out.append(("launchd", path, text))
    return out


def path_links():
    out = []
    folder = os.path.join(base_home(), ".local", "bin")
    for path in sorted(glob.glob(os.path.join(folder, "*"))):
        if os.path.islink(path):
            out.append(("path", path, os.path.realpath(path)))
        elif os.path.isfile(path) and os.path.getsize(path) < 200000:
            try:
                with open(path, errors="replace") as handle:
                    text = handle.read()
            except OSError:
                continue
            if "\0" not in text[:2000]:
                out.append(("path", path, text))
    return out


def claude_instructions():
    out = []
    claude = os.path.join(base_home(), ".claude")
    for pattern in ("CLAUDE.md", "skills/*/SKILL.md", "skills/*/*.md", "commands/*.md", "agents/*.md", "docs/*.md"):
        for path in sorted(glob.glob(os.path.join(claude, pattern))):
            try:
                with open(path, errors="replace") as handle:
                    out.append(("instructions", path, handle.read(200000)))
            except OSError:
                pass
    return out


def outside_roots(tops=()):
    return settings_commands(tops) + launch_agents() + path_links() + claude_instructions()




class Graph:
    def __init__(self, indexes, ledger):
        self.indexes = indexes
        self.ledger = ledger
        self.files = {}
        self.by_base, self.by_stem, self.by_real, self.pkg, self.real = {}, {}, {}, {}, {}
        for repo, doc in indexes.items():
            top = doc["top"]
            for rel, record in doc["files"].items():
                fid = "%s/%s" % (repo, rel)
                self.files[fid] = record
                base = os.path.basename(rel)
                self.by_base.setdefault(base, []).append(fid)
                stem = os.path.splitext(base)[0]
                self.by_stem.setdefault(stem, []).append(fid)
                real = self.real[fid] = os.path.realpath(os.path.join(top, rel))
                if not record.get("link") or real not in self.by_real:
                    self.by_real[real] = fid
                if base == "__init__.py":
                    self.pkg.setdefault(os.path.basename(os.path.dirname(rel)), []).append(fid)
        self.tops = {repo: doc["top"] for repo, doc in indexes.items()}
        self.aliases = None

    def local(self, repo, rel):
        rel = os.path.normpath(rel)
        fid = "%s/%s" % (repo, rel)
        return fid if not rel.startswith("..") and fid in self.files else None

    def js_file(self, repo, rel):
        stem, ext = os.path.splitext(rel)
        tries = [rel] + [rel + e for e in JS_EXTS] + [os.path.join(rel, "index" + e) for e in JS_EXTS]
        if ext in (".js", ".jsx", ".mjs", ".cjs"):
            tries += [stem + e for e in (".ts", ".tsx", ".mts", ".cts")]
        return next((fid for fid in (self.local(repo, path) for path in tries) if fid), None)

    def py_module(self, repo, here, spec):
        hits = self.py_files(repo, here, spec)
        for fid in list(hits):
            folder = os.path.dirname(fid.split("/", 1)[1])
            if os.path.basename(fid) == "__init__.py":
                folder = os.path.dirname(folder)
            while folder and self.local(repo, os.path.join(folder, "__init__.py")):
                hits.append(self.local(repo, os.path.join(folder, "__init__.py")))
                folder = os.path.dirname(folder)
        return hits

    def py_files(self, repo, here, spec):
        dots = len(spec) - len(spec.lstrip("."))
        parts = [p for p in spec[dots:].split(".") if p]
        if dots:
            base = here
            for _ in range(dots - 1):
                base = os.path.dirname(base)
            path = os.path.join(base, *parts) if parts else base
            return [f for f in (self.local(repo, path + ".py"), self.local(repo, os.path.join(path, "__init__.py"))) if f]
        if not parts:
            return []
        tail = "/".join(parts)
        hits = [f for f in self.by_base.get(parts[-1] + ".py", []) if f.startswith(repo + "/")
                and ("/" + f.split("/", 1)[1]).endswith("/" + tail + ".py")]
        return hits + [f for f in self.pkg.get(parts[-1], []) if f.startswith(repo + "/")
                       and ("/" + f.split("/", 1)[1]).endswith("/" + tail + "/__init__.py")]

    def alias_paths(self, repo, rel, spec):
        if self.aliases is None:
            self.aliases = {}
            for fid in self.files:
                if os.path.basename(fid) in ("tsconfig.json", "jsconfig.json") and self.files[fid].get("kind") != "fixture":
                    options = (loose_json(os.path.join(self.top_of(fid), fid.split("/", 1)[1])) or {}).get("compilerOptions") or {}
                    folder = os.path.dirname(fid.split("/", 1)[1])
                    base = os.path.join(folder, options.get("baseUrl") or ".") if isinstance(options.get("baseUrl"), str) else folder
                    paths = options.get("paths") if isinstance(options.get("paths"), dict) else {}
                    self.aliases.setdefault(fid.split("/", 1)[0], []).append((folder, base, paths, "baseUrl" in options))
        out = []
        for folder, base, paths, has_base in self.aliases.get(repo, ()):
            if folder and not rel.startswith(folder + "/"):
                continue
            for pattern, targets in paths.items():
                prefix, star, suffix = pattern.partition("*")
                if star and spec.startswith(prefix) and spec.endswith(suffix) and len(spec) >= len(prefix) + len(suffix):
                    rest = spec[len(prefix):len(spec) - len(suffix)]
                elif not star and spec == pattern:
                    rest = ""
                else:
                    continue
                out += [os.path.join(base, t.replace("*", rest)) for t in targets if isinstance(t, str)]
            if has_base:
                out.append(os.path.join(base, spec))
        return out

    def import_targets(self, fid, record):
        repo, rel = fid.split("/", 1)
        here, out = os.path.dirname(rel), set()
        for spec in record.get("imports") or ():
            if record.get("lang") in ("python", "bash"):
                out.update(self.py_module(repo, here, spec[3:] if spec.startswith("-m ") else spec))
                continue
            for path in [os.path.join(here, spec)] if spec.startswith(".") else self.alias_paths(repo, rel, spec):
                hit = self.js_file(repo, path)
                if hit:
                    out.add(hit)
                    break
        return out

    def top_of(self, fid):
        return self.tops[fid.split("/", 1)[0]]

    def canonical(self, fid):
        return self.by_real.get(self.real.get(fid), fid)

    def is_cli(self, fid):
        record = self.files[fid]
        return "/bin/" in "/" + fid.split("/", 1)[1] and record.get("exec")

    def resolve(self, token, source_repo=None, anywhere=False):
        if token.startswith(("/", "~/")):
            real = os.path.realpath(os.path.expanduser(token))
            if real in self.by_real:
                return [self.by_real[real]]
            for prefix in list(self.tops.values()):
                if real.startswith(prefix + "/"):
                    return []
        name = token.rsplit("/", 1)[-1]
        if "/" in token or "." in name:
            hits = self.by_base.get(name, [])
            if "/" in token and len(hits) > 1:
                tail = token.lstrip("~./")
                narrowed = [h for h in hits if h.endswith("/" + tail) or h.split("/", 1)[1] == tail]
                hits = narrowed or [h for h in hits if h.endswith("/" + "/".join(tail.split("/")[-2:]))] or hits
            return hits
        out = []
        for fid in self.by_stem.get(name, []) + self.pkg.get(name, []):
            if anywhere or fid.split("/", 1)[0] == source_repo or self.is_cli(fid):
                out.append(fid)
        return out

    def glob_targets(self, source, spec):
        folder, prefix, suffix = spec
        repo, here = source.split("/", 1)[0], os.path.dirname(source.split("/", 1)[1])
        out = []
        for fid in self.files:
            if fid.split("/", 1)[0] != repo:
                continue
            rel = fid.split("/", 1)[1]
            parent, base = os.path.split(rel)
            if folder == "@here":
                if parent != here:
                    continue
            elif folder and not parent.endswith(folder):
                continue
            if base.startswith(prefix) and base.endswith(suffix):
                out.append(fid)
        return out

    def edges(self):
        out = {}
        for fid, record in self.files.items():
            repo = fid.split("/", 1)[0]
            targets = set()
            for token in (record.get("refs") or {}).get("code") or ():
                targets.update(self.resolve(token, repo))
            for spec in record.get("globs") or ():
                targets.update(self.glob_targets(fid, spec))
            targets.update(self.import_targets(fid, record))
            if record.get("link") and record.get("target") in self.by_real:
                targets.add(self.by_real[record["target"]])
            targets.discard(fid)
            out[fid] = targets
        return out

    def comment_edges(self):
        out = {}
        for fid, record in self.files.items():
            repo = fid.split("/", 1)[0]
            targets = set()
            for token in (record.get("refs") or {}).get("comment") or ():
                targets.update(self.resolve(token, repo))
            targets.discard(fid)
            out[fid] = targets
        return out


def repo_entry_roots(graph):
    roots = {}
    for fid, record in graph.files.items():
        rel = fid.split("/", 1)[1]
        if rel == "tests/run-all" or rel == "init.lua" and os.path.realpath(graph.top_of(fid)) == os.path.realpath(
                os.path.join(base_home(), ".hammerspoon")) or record.get("kind") == "instruction":
            roots.setdefault(fid, []).append("repo entry %s" % rel)
    for fid, why in generic_roots(graph):
        roots.setdefault(fid, []).append(why)
    return roots


def command_files(graph, repo, base, text):
    out = set()
    words = re.findall(r"[\w@~.\-/:]+", text)
    for index, word in enumerate(words):
        if index and words[index - 1] == "-m":
            out.update(graph.py_module(repo, base, word))
            continue
        word = word.split("=", 1)[-1].rstrip(".:")
        if "/" not in word and "." not in word.lstrip("."):
            continue
        if word.startswith("/"):
            parts = word.strip("/").split("/")
            tries = ["/".join(parts[i:]) for i in range(len(parts))]
        else:
            tries = [os.path.join(base, word), word]
        hit = next((f for f in (graph.js_file(repo, t) for t in tries if t) if f), None)
        if hit:
            out.add(hit)
    return out


def package_refs(value, key=None):
    if isinstance(value, str):
        return [value] if key != "types" else []
    if isinstance(value, dict):
        return [ref for k, v in value.items() if k not in ("types", "typings") for ref in package_refs(v, k)]
    if isinstance(value, list):
        return [ref for item in value for ref in package_refs(item)]
    return []


def entry_specs(rel, text):
    name = os.path.basename(rel)
    if name == "pyproject.toml":
        try:
            import tomllib
            doc = tomllib.loads(text)
        except Exception:
            return []
        project, poetry = doc.get("project") or {}, ((doc.get("tool") or {}).get("poetry")) or {}
        groups = [project.get("scripts"), project.get("gui-scripts"), poetry.get("scripts")]
        groups += list((project.get("entry-points") or {}).values()) + list((poetry.get("plugins") or {}).values())
        values = [v for group in groups if isinstance(group, dict) for v in group.values()]
        return [v if isinstance(v, str) else (v or {}).get("reference") or (v or {}).get("callable") or "" for v in values]
    if name == "setup.cfg":
        section = re.search(r"^\[options\.entry_points\][^\n]*\n(.*?)(?=^\[|\Z)", text, re.M | re.S)
        return re.findall(r"=\s*([\w.]+(?::[\w.]+)?)\s*$", section.group(1), re.M) if section else []
    return re.findall(r"[\"'][\w.\- ]+=\s*([\w.]+:[\w.]+)", text)


def workflow_runs(text):
    out, block, indent = [], None, 0
    for line in text.splitlines():
        if block is not None:
            if not line.strip() or len(line) - len(line.lstrip()) > indent:
                block.append(line)
                continue
            out.append("\n".join(block))
            block = None
        match = re.match(r"^(\s*)(?:-\s*)?run:\s*(.*)$", line)
        if match:
            if match.group(2).strip()[:1] in ("|", ">"):
                block, indent = [], len(match.group(1))
            else:
                out.append(match.group(2))
    if block:
        out.append("\n".join(block))
    return out


def generic_roots(graph):
    roots, bases = [], {}
    for fid, record in graph.files.items():
        if record.get("kind") == "fixture":
            continue
        repo, rel = fid.split("/", 1)
        name, here = os.path.basename(rel), os.path.dirname(rel)
        if name in ("package.json", "pyproject.toml", "setup.cfg", "setup.py"):
            bases.setdefault(repo, set()).add(here)
        if record.get("kind") == "test":
            roots.append((fid, "test file"))
        elif record.get("kind") == "code" and (TOOL_CONFIG_RE.match(name) or name == "__main__.py"):
            roots.append((fid, "tool convention %s" % name))
        reader = name in ("package.json", "pyproject.toml", "setup.cfg", "setup.py") or MAKE_FILES.match(name) \
            or DOCKER_FILES.match(name) or re.match(r"^\.github/workflows/[^/]+\.ya?ml$", rel)
        if not reader:
            continue
        try:
            with open(os.path.join(graph.top_of(fid), rel), encoding="utf-8", errors="replace") as handle:
                text = handle.read(500000)
        except OSError:
            continue
        found = set()
        if name == "package.json":
            doc = loose_json(os.path.join(graph.top_of(fid), rel)) or {}
            for ref in package_refs([doc.get(k) for k in ("bin", "main", "module", "browser", "exports")]):
                if "*" in ref:
                    pattern = os.path.normpath(os.path.join(here, ref))
                    found.update(f for f in graph.files if f.startswith(repo + "/") and fnmatch.fnmatch(f.split("/", 1)[1], pattern))
                else:
                    found.update(f for f in [graph.js_file(repo, os.path.join(here, ref))] if f)
            scripts = doc.get("scripts") if isinstance(doc.get("scripts"), dict) else {}
            found.update(command_files(graph, repo, here, "\n".join(str(v) for v in scripts.values())))
        elif name in ("pyproject.toml", "setup.cfg", "setup.py"):
            for spec in entry_specs(rel, text):
                found.update(graph.py_module(repo, here, spec.split(":", 1)[0].strip()))
        elif DOCKER_FILES.match(name):
            lines = [l for l in text.splitlines() if re.match(r"^\s*(CMD|ENTRYPOINT)\b", l, re.I)]
            found.update(command_files(graph, repo, here, "\n".join(lines)))
        elif MAKE_FILES.match(name):
            found.update(command_files(graph, repo, here, text))
        else:
            found.update(command_files(graph, repo, "", "\n".join(workflow_runs(text))))
        roots += [(f, "%s %s" % (name, rel)) for f in found if f != fid]
    for fid, record in graph.files.items():
        if record.get("kind") != "code":
            continue
        repo, rel = fid.split("/", 1)
        for base in bases.get(repo, set()) | {""}:
            sub = rel[len(base) + 1:] if base and rel.startswith(base + "/") else rel if not base else None
            if sub and re.match(r"^(src/)?(%s)/" % "|".join(ROUTE_DIRS), sub):
                roots.append((fid, "route %s" % sub.split("/", 2)[0 if not sub.startswith("src/") else 1]))
                break
    return roots


def entry_roots(graph):
    roots = repo_entry_roots(graph)
    dangling = []
    for kind, source, text in outside_roots(graph.tops.values()):
        found = set()
        if kind == "path" and os.path.isabs(text) and "\n" not in text:
            if text in graph.by_real:
                found.add(graph.by_real[text])
            elif any(text.startswith(top + "/") for top in graph.tops.values()) and not os.path.exists(text):
                dangling.append({"kind": kind, "source": source, "target": text})
        else:
            for token in tokens_of(text):
                hits = graph.resolve(token, anywhere=True)
                found.update(hits)
                if not hits and token.startswith(("/", "~/")):
                    real = os.path.realpath(os.path.expanduser(token))
                    if any(real.startswith(top + "/") for top in graph.tops.values()) and not os.path.exists(real):
                        dangling.append({"kind": kind, "source": source, "target": real})
        for fid in found:
            roots.setdefault(fid, []).append("%s %s" % (kind, source))
    return roots, dangling


def protected_units(ledger):
    out = {}
    for row in ledger.get("protected") or ():
        if isinstance(row, dict) and row.get("path"):
            out[row["path"]] = "protected: %s" % (row.get("why") or "listed in the ledger")
    for row in ledger.get("retired") or ():
        for unit in (row or {}).get("exceptions") or ():
            out[unit] = "retirement exception of %s" % row.get("id")
    return out


def reachable(graph, edges, roots):
    seen = set(roots)
    queue = list(roots)
    while queue:
        fid = queue.pop()
        source_kind = graph.files[fid].get("kind")
        for target in edges.get(fid, ()):
            if target in seen:
                continue
            target_kind = graph.files[target].get("kind")
            if source_kind == "test" and target_kind not in ("test", "fixture"):
                continue
            if source_kind in ("doc", "data", "fixture"):
                continue
            seen.add(target)
            queue.append(target)
    return seen


def components(nodes, edges):
    parent = {n: n for n in nodes}

    def find(n):
        while parent[n] != n:
            parent[n] = parent[parent[n]]
            n = parent[n]
        return n

    for node in nodes:
        for target in edges.get(node, ()):
            if target in parent:
                parent[find(node)] = find(target)
    groups = {}
    for node in nodes:
        groups.setdefault(find(node), []).append(node)
    return list(groups.values())




def unit_id(fid, symbol=None):
    return fid + ("#" + symbol["name"] if symbol else "")


def unit_span(fid, record, symbol=None):
    if symbol:
        return {"unit": unit_id(fid, symbol), "file": fid, "start": symbol["start"], "end": symbol["end"],
                "digest": symbol["digest"], "lines": symbol["lines"]}
    return {"unit": fid, "file": fid, "start": 1, "end": record.get("lines") or 1, "digest": record["digest"][:16],
            "lines": record.get("lines") or 0}


def overlaps(a, b):
    return a["file"] == b["file"] and a["start"] <= b["end"] and b["start"] <= a["end"]


def shared_invariant_rows(indexes):
    rows = []
    for repo, doc in indexes.items():
        path = os.path.join(doc["top"], "docs", "shared-invariants.md")
        try:
            with open(path, errors="replace") as handle:
                for line in handle:
                    if line.startswith("| ") and line.count("|") >= 5:
                        tokens = tokens_of(line)
                        rows.append((tokens, {t.rsplit("/", 1)[-1] for t in tokens}))
        except OSError:
            pass
    return rows


def names_file(row, fid):
    tokens, bases = row
    rel = fid.split("/", 1)[1]
    if rel.rsplit("/", 1)[-1] not in bases:
        return False
    for token in tokens:
        bare = token.lstrip("~./")
        if token == fid or bare == rel or "/" in bare and rel.endswith("/" + bare):
            return True
    return False


def intentional(a, b, rows, ledger):
    if any(names_file(row, a) and names_file(row, b) for row in rows):
        return True
    for row in ledger.get("intentional") or ():
        units = (row or {}).get("units") or ()
        if any(a == u or a.startswith(u + "#") for u in units) and any(b == u or b.startswith(u + "#") for u in units):
            return True
    return False


def sketch_similarity(a, b):
    union = sorted(set(a) | set(b))[:SKETCH_K]
    both = set(a) & set(b)
    return sum(1 for v in union if v in both) / float(len(union) or 1)


def touch_overlap(common, a, b, idf):
    score = sum(idf(t) for t in common)
    return score, score / (sum(idf(t) for t in set(a) | set(b)) or 1)


def clone_pairs(graph):
    symbols, postings = [], {}
    for fid, record in graph.files.items():
        if record.get("kind") not in ("code", "test") or graph.canonical(fid) != fid:
            continue
        for symbol in record.get("symbols") or ():
            if symbol.get("sketch") and symbol["lines"] >= LIMITS["clone_min_lines"]:
                index = len(symbols)
                symbols.append((fid, record, symbol))
                for value in symbol["sketch"]:
                    postings.setdefault(value, []).append(index)
    shared = {}
    for members in postings.values():
        if len(members) > COMMON_DF or len(members) < 2:
            continue
        for i in range(len(members)):
            for j in range(i + 1, len(members)):
                key = (members[i], members[j])
                shared[key] = shared.get(key, 0) + 1
    pairs = []
    for (i, j), count in shared.items():
        if count < LIMITS["clone_shared"]:
            continue
        a, b = symbols[i], symbols[j]
        if a[2]["lang"] != b[2]["lang"]:
            continue
        span_a, span_b = unit_span(a[0], a[1], a[2]), unit_span(b[0], b[1], b[2])
        if overlaps(span_a, span_b):
            continue
        estimate = sketch_similarity(a[2]["sketch"], b[2]["sketch"])
        if estimate >= LIMITS["clone_jaccard"]:
            pairs.append((span_a, span_b, "clone", round(estimate, 2)))
    return pairs


def touch_pairs(graph):
    symbols, df = [], {}
    for fid, record in graph.files.items():
        if record.get("kind") != "code" or graph.canonical(fid) != fid:
            continue
        for symbol in record.get("symbols") or ():
            if symbol["lines"] >= LIMITS["clone_min_lines"] and symbol.get("touch"):
                symbols.append((fid, record, symbol))
                for touch in set(symbol["touch"]):
                    df[touch] = df.get(touch, 0) + 1
    total = max(len(symbols), 1)
    idf = {t: math.log(total / float(n)) for t, n in df.items()}
    postings = {}
    for index, (_, _, symbol) in enumerate(symbols):
        for touch in set(symbol["touch"]):
            if df[touch] <= TOUCH_COMMON_DF and df[touch] >= 2:
                postings.setdefault(touch, []).append(index)
    shared = {}
    for touch, members in postings.items():
        for i in range(len(members)):
            for j in range(i + 1, len(members)):
                shared.setdefault((members[i], members[j]), []).append(touch)
    pairs = []
    for (i, j), common in shared.items():
        if len(common) < LIMITS["touch_shared"]:
            continue
        a, b = symbols[i], symbols[j]
        score, weighted = touch_overlap(common, a[2]["touch"], b[2]["touch"], lambda t: idf.get(t, 0))
        if score < LIMITS["touch_min_idf"] or weighted < LIMITS["touch_jaccard"]:
            continue
        span_a, span_b = unit_span(a[0], a[1], a[2]), unit_span(b[0], b[1], b[2])
        if overlaps(span_a, span_b):
            continue
        pairs.append((span_a, span_b, "touchpoints", round(weighted, 2)))
    return pairs


def site_span(graph, fid, line):
    record = graph.files[fid]
    inside = [s for s in record.get("symbols") or () if s["start"] <= line <= s["end"]]
    return unit_span(fid, record, min(inside, key=lambda s: s["lines"]) if inside else None)


def is_fresh(fresh, span):
    repo, rel = span["file"].split("/", 1)
    names = (fresh.get(repo) or {}).get(rel) or {}
    return bool(names) and ("#" not in span["unit"] or span["unit"].rsplit("#", 1)[1] in names)


def literal_index(graph):
    files = [fid for fid, r in graph.files.items() if r.get("kind") == "code" and graph.canonical(fid) == fid]
    sites, atoms = {}, {}
    for fid in files:
        for feature, line, templated in graph.files[fid].get("lits") or ():
            sites.setdefault(feature, {}).setdefault(fid, []).append((line, templated))
        for token in {t.lower() for t in (graph.files[fid].get("refs") or {}).get("code") or ()}:
            atoms[token] = atoms.get(token, 0) + 1
    total = float(max(len(files), 1))

    def info(feature):
        if feature.startswith("glyph:"):
            return math.log(total / len(sites[feature]))
        fixed = feature[4:].replace("{}", " ")
        weights = [math.log(total / (atoms.get(w.lower()) or 1)) for w in re.findall(r"[A-Za-z_][A-Za-z0-9_]{2,}", fixed)]
        weights += [math.log(total / len(sites["glyph:" + g])) for g in glyphs_of(fixed) if "glyph:" + g in sites]
        return max(weights or [0.0])
    return sites, info, int(total)


def concept_signals(graph, sites, info, total, fresh, rows, ledger):
    signals = []
    for feature, where in sorted(sites.items()):
        files = sorted(where)
        if not 2 <= len(files) <= LIMITS["concept_max_sites"] or sum(1 for f in files if any(t for _, t in where[f])) < 2:
            continue
        if info(feature) < LIMITS["concept_min_idf"]:
            continue
        if all(intentional(a, b, rows, ledger) for i, a in enumerate(files) for b in files[i + 1:]):
            continue
        spans, loose = {}, []
        for fid in files:
            for line, _ in where[fid]:
                span = site_span(graph, fid, line)
                if "#" in span["unit"]:
                    spans.setdefault(span["unit"], span)
                else:
                    loose.append("%s:%d" % (fid, line))
        if not spans:
            continue
        units = [spans[u] for u in sorted(spans)]
        literal = feature.split(":", 1)[1]
        signals.append({"group": "duplicate", "rule": "concept", "units": units, "fresh": any(is_fresh(fresh, u) for u in units),
                        "detail": "the rare literal «%s» (%d of %d code files) is spelled in %s%s: one concept computed in %d places" % (
                            literal, len(files), total, ", ".join(files[:6]),
                            " (top level: %s)" % ", ".join(loose[:4]) if loose else "", len(files)),
                        "value": len(files) - 1})
    return signals


def reuse_signals(graph, sites, info, fresh, rows, ledger, held=()):
    new, helpers = [], []
    for fid, record in graph.files.items():
        if record.get("kind") not in ("code", "test") or graph.canonical(fid) != fid:
            continue
        repo, rel = fid.split("/", 1)
        names = (fresh.get(repo) or {}).get(rel) or {}
        for symbol in record.get("symbols") or ():
            if symbol["name"] in names or unit_id(fid, symbol) in held:
                new.append((fid, record, symbol))
            elif record["kind"] == "code" or "/lib/" in "/" + rel:
                helpers.append((fid, record, symbol))
    if not new:
        return []
    by_sketch, by_touch, by_feature = {}, {}, {}
    for index, (fid, record, symbol) in enumerate(helpers):
        for value in symbol.get("sketch") or ():
            by_sketch.setdefault(value, []).append(index)
        for touch in set(symbol.get("touch") or ()):
            by_touch.setdefault(touch, []).append(index)
    for feature, where in sites.items():
        if len(where) <= LIMITS["reuse_max_sites"] and info(feature) >= LIMITS["concept_min_idf"]:
            for fid, hits in where.items():
                by_feature.setdefault(feature, []).extend((fid, line) for line, t in hits if t)
    total = float(max(len(helpers), 1))
    positions = {(h[0], h[2]["start"]): i for i, h in enumerate(helpers)}

    def idf(touch):
        return math.log(total / len(by_touch[touch])) if touch in by_touch else math.log(total)

    signals = []
    for fid, record, symbol in new:
        span = unit_span(fid, record, symbol)
        found = {}
        if symbol["lines"] >= LIMITS["reuse_min_lines"]:
            shared = {}
            for value in symbol.get("sketch") or ():
                members = by_sketch.get(value, ())
                if len(members) <= COMMON_DF:
                    for index in members:
                        shared[index] = shared.get(index, 0) + 1
            for index, count in shared.items():
                other = helpers[index][2]
                if count < LIMITS["reuse_shared"] or other["lang"] != symbol["lang"]:
                    continue
                estimate = sketch_similarity(symbol["sketch"], other["sketch"])
                if estimate >= LIMITS["reuse_jaccard"]:
                    found[index] = (estimate, "clone %.2f" % estimate)
            common = {}
            for touch in set(symbol.get("touch") or ()):
                members = by_touch.get(touch, ())
                if 1 <= len(members) <= TOUCH_COMMON_DF:
                    for index in members:
                        common.setdefault(index, []).append(touch)
            for index, touches in common.items():
                if len(touches) < LIMITS["reuse_touch_shared"]:
                    continue
                _, weighted = touch_overlap(touches, symbol.get("touch") or (), helpers[index][2].get("touch") or (), idf)
                if weighted >= LIMITS["touch_jaccard"] and weighted > (found.get(index) or (0,))[0]:
                    found[index] = (weighted, "touchpoints %.2f" % weighted)
        mine = {feature for feature, line, t in record.get("lits") or ()
                if t and symbol["start"] <= line <= symbol["end"] and feature in by_feature}
        for feature in sorted(mine):
            for other_fid, line in by_feature[feature]:
                if other_fid == fid and symbol["start"] <= line <= symbol["end"]:
                    continue
                other = site_span(graph, other_fid, line)
                index = positions.get((other_fid, other["start"])) if "#" in other["unit"] else None
                if index is not None and (found.get(index) or (0,))[0] < 1:
                    found[index] = (1, "shares «%s»" % feature.split(":", 1)[1])
        ranked = sorted(found.items(), key=lambda item: (-item[1][0], item[0]))
        matches = []
        for index, (score, why) in ranked:
            other = unit_span(helpers[index][0], helpers[index][1], helpers[index][2])
            if overlaps(span, other) or intentional(fid, other["file"], rows, ledger):
                continue
            matches.append((other, why))
            if len(matches) >= LIMITS["reuse_matches"]:
                break
        if matches:
            signals.append({"group": "duplicate", "rule": "reuse", "units": [span] + [m for m, _ in matches], "subject": span["unit"],
                            "fresh": is_fresh(fresh, span),
                            "detail": "new %s may re-do what %s already does" % (span["unit"], ", ".join(
                                "%s (%s)" % (m["unit"], why) for m, why in matches)),
                            "value": symbol["lines"]})
    return signals


def prose_signals(graph):
    renderers = sorted(f for name in RENDERERS for f in graph.by_base.get(name, ())
                       if graph.files[f].get("kind") == "code" and graph.canonical(f) == f)
    if not renderers:
        return []
    signals = []
    for fid, record in sorted(graph.files.items()):
        layout = record.get("layout")
        if not layout or graph.canonical(fid) != fid:
            continue
        sections = "; ".join("§%s L%d (%s)" % (heading, line, kinds) for heading, line, _, kinds in layout)
        signals.append({"group": "duplicate", "rule": "prose-layout", "units": [unit_span(fid, record)], "reuse": renderers,
                        "detail": "%s tells the model to write a user-facing layout by hand (%s) while %s render user-facing "
                                  "blocks: render via the shared frame, the model writes only the meaning" % (
                                      fid, sections, " and ".join(renderers)),
                        "value": sum(score for _, _, score, _ in layout)})
    return signals


def fixture_unit(graph, span):
    record = graph.files[span["file"]]
    if record.get("kind") != "test":
        return False
    name = span["unit"].rsplit("#", 1)[1] if "#" in span["unit"] else ""
    symbol = next((s for s in record.get("symbols") or () if s["name"] == name and s["start"] == span["start"]), None)
    return not symbol or bool(re.match(r"test", name, re.I)) or symbol["lang"] != record.get("lang")


def heavy_tests(graph):
    rows = read_jsonl(os.path.join(statusline_cache(), "test-history.jsonl"))
    cutoff = now_s() - 28 * 86400
    secs = {}
    for row in rows:
        if isinstance(row.get("secs"), (int, float)) and (row.get("end") or 0) >= cutoff and row.get("label"):
            repo = row.get("repo") or os.path.basename(str(row.get("repo_root") or ""))
            secs.setdefault((repo, row["label"]), []).append(row["secs"])
    out = []
    for (repo, label), values in secs.items():
        values.sort()
        median = values[len(values) // 2]
        if median < LIMITS["heavy_test_s"]:
            continue
        fid = next((f for f in ("%s/tests/%s.sh" % (repo, label), "%s/tests/%s.py" % (repo, label)) if f in graph.files), None)
        if fid:
            out.append((fid, median, len(values)))
    return out, sorted({repo for repo, _ in secs})


def test_requirement(graph, fid):
    for row in graph.ledger.get("keep") or ():
        if isinstance(row, dict) and row.get("path") == fid:
            return row.get("requirement") or "kept by the ledger"
    try:
        with open(os.path.join(graph.top_of(fid), fid.split("/", 1)[1]), errors="replace") as handle:
            head = "".join(handle.readline() for _ in range(15))
    except OSError:
        return None
    match = KEEP_WORDS.search(head)
    return ("protects %s" % match.group(0)) if match else None


def instruction_costs(graph, sessions):
    out = []
    for fid, record in graph.files.items():
        rel = fid.split("/", 1)[1]
        weight = None
        if os.path.basename(rel) in ("CLAUDE.md", "CLAUDE.local.md"):
            weight = 1.0
        elif rel.endswith("SKILL.md"):
            weight = 0.05
        if weight is None:
            continue
        out.append((fid, record, weight))
        if os.path.basename(rel) == "CLAUDE.md":
            try:
                with open(os.path.join(graph.top_of(fid), rel), errors="replace") as handle:
                    text = handle.read()
            except OSError:
                continue
            for target in told_to_read(graph, fid, text):
                out.append((target, graph.files[target], 1.0))
    found = {}
    measured = read_rates()
    by_real = {os.path.realpath(path): entry for path, entry in (measured or {}).items()}
    for fid, record, weight in out:
        tokens = (record.get("size") or 0) / 4.0
        entry = by_real.get(graph.real.get(fid))
        if measured is None:
            per_day, source = tokens * weight * (sessions or 1), None
        elif not entry:
            continue
        else:
            month = entry.get("monthly") or {}
            loaded = tokens * (month.get("loads") or 0) if entry.get("mode") == "always_on" else 0
            per_day, source = (loaded + (month.get("read_tokens") or 0)) / 30.0, entry.get("mode")
        if per_day >= LIMITS["token_day"]:
            found[fid] = (round(tokens), round(per_day), source)
    return found


def told_to_read(graph, fid, text):
    out = []
    for line in text.splitlines():
        if re.search(r"\bread\b", line, re.I):
            for token in re.findall(r"`([^`]+\.md)`", line):
                out += graph.resolve(token, fid.split("/", 1)[0])
    return out


def claim_sources(graph):
    sources, instructions = {}, []
    for fid, record in sorted(graph.files.items()):
        rel = fid.split("/", 1)[1]
        if graph.canonical(fid) != fid or record.get("kind") == "fixture" or re.search(r"-disabled/", rel):
            continue
        if record.get("kind") == "code" and record.get("claims"):
            sources[fid] = "hook text" if HOOK_PART.search(rel) else "usage text"
        elif INSTRUCTION_PART.search(rel) or PROSE_PART.search(rel):
            sources[fid] = "instruction"
            instructions.append(fid)
    for fid in instructions:
        try:
            with open(os.path.join(graph.top_of(fid), fid.split("/", 1)[1]), errors="replace") as handle:
                text = handle.read(400000)
        except OSError:
            continue
        for target in told_to_read(graph, fid, text):
            if graph.files[target].get("lang") == "doc" and not re.search(r"-disabled/", target):
                sources.setdefault(graph.canonical(target), "read by " + fid)
    return sources


def monthly_reads(graph):
    measured = read_rates() or {}
    by_real = {os.path.realpath(path): entry for path, entry in measured.items()}
    out = {}
    for fid in graph.files:
        entry = by_real.get(graph.real.get(fid))
        if entry:
            month = entry.get("monthly") or {}
            out[fid] = (month.get("loads") or 0) + (month.get("read_loads") or 0)
    return out


def claim_binding(graph, edges, fid, names, writers):
    repo, bound, tools = fid.split("/", 1)[0], [], []
    for name in names:
        if name in TOOL_NAMES:
            tools.append(name)
            continue
        word = (name.split() or [""])[0]
        hits = [h for h in graph.resolve(word, repo) if graph.files[h].get("kind") == "code" and graph.canonical(h) == h]
        if not hits and DATA_FILE.search(word):
            hits = writers.get(os.path.basename(word), [])
        if 0 < len(hits) <= LIMITS["promise_binds"]:
            bound += [h for h in hits if h not in bound]
    if tools and not bound:
        bound = sorted(t for t in edges.get(fid, ()) if graph.files[t].get("kind") == "code" and graph.is_cli(t))
    return bound[:LIMITS["promise_binds"]], tools


def data_writers(graph):
    writers = {}
    for fid, record in graph.files.items():
        if record.get("kind") == "code" and graph.canonical(fid) == fid:
            for token in (record.get("refs") or {}).get("code") or ():
                if DATA_FILE.search(token) and fid not in writers.setdefault(os.path.basename(token), []):
                    writers[os.path.basename(token)].append(fid)
    return writers


def promise_signals(graph, edges, fresh):
    reads, writers, signals = monthly_reads(graph), data_writers(graph), []
    for fid, source in claim_sources(graph).items():
        record = graph.files[fid]
        for digest, line, sentence, risk, names in record.get("claims") or ():
            bound, tools = claim_binding(graph, edges, fid, names, writers)
            if not bound:
                continue
            claim = {"unit": "%s#promise:%s" % (fid, digest), "file": fid, "start": line, "end": line, "digest": digest, "lines": 1}
            bucket = int(math.log(1 + reads.get(fid, 0), 2))
            signals.append({"group": "promise", "rule": "claim", "cause": claim["unit"], "risk": risk, "claim": sentence,
                            "units": [claim] + [unit_span(b, graph.files[b]) for b in bound], "fresh": is_fresh(fresh, claim),
                            "detail": "%s:%d (%s, %s) claims: %s · bound to %s%s" % (
                                fid, line, source, risk, sentence, ", ".join(bound), (" · tools %s" % ", ".join(tools)) if tools else ""),
                            "value": bucket * len(RISKS) + len(RISKS) - 1 - RISKS.index(risk)})
    return signals


def overclaim_signals(graph, days):
    seen = {}
    for day in sorted(days):
        source = ((days[day].get("sources") or {}).get("overclaims")) or {}
        for key, count in (source.get("hits") or {}).items():
            entry = seen.setdefault(key.split(":", 1)[1], {"count": 0, "refs": [], "reasons": set()})
            entry["count"] += count
            entry["refs"] = (entry["refs"] + (source.get("refs") or {}).get(key, []))[-EVIDENCE_MAX:]
            entry["reasons"].update((source.get("reasons") or {}).get(key, []))
    signals = []
    for mechanism, entry in sorted(seen.items()):
        word = mechanism.split()[0]
        if word in TOOL_NAMES:
            bound = sorted(f for f, r in graph.files.items() if r.get("kind") in ("code", "instruction")
                           and graph.canonical(f) == f and word in ((r.get("refs") or {}).get("code") or ()))
        else:
            bound = [h for h in graph.resolve(word) if graph.files[h].get("kind") == "code" and graph.canonical(h) == h]
        if not 0 < len(bound) <= LIMITS["promise_binds"]:
            continue
        signals.append({"group": "promise", "rule": "overclaim", "cause": "overclaim:" + mechanism, "risk": "delivery",
                        "units": [unit_span(b, graph.files[b]) for b in bound], "sightings": entry["refs"],
                        "detail": "%d times a model reported a finished effect right after `%s` said %s" % (
                            entry["count"], mechanism, " or ".join(sorted(entry["reasons"])) or "otherwise"),
                        "value": len(RISKS) * 8 + entry["count"]})
    return signals


def read_rates():
    path = os.environ.get("TOKENMAP_RATES") or os.path.join(base_home(), ".local", "share", "tokenmap", "read-rates.json")
    doc = read_json(path)
    entries = ((doc or {}).get("paths") or {}).get("entries") if isinstance(doc, dict) else None
    return entries if isinstance(entries, dict) else None


def retired_hits(graph):
    out = []
    for row in graph.ledger.get("retired") or ():
        if not isinstance(row, dict) or not row.get("match"):
            continue
        try:
            pattern = re.compile(row["match"])
        except re.error:
            continue
        exceptions = set(row.get("exceptions") or ())
        for fid, record in graph.files.items():
            if record.get("kind") != "code":
                continue
            for symbol in record.get("symbols") or ():
                unit = unit_id(fid, symbol)
                if unit in exceptions or not pattern.search(symbol["name"]):
                    continue
                out.append((unit_span(fid, record, symbol), row))
    return out


def dead_symbols(graph, live, edges_all_tokens):
    out = []
    for fid in live:
        record = graph.files[fid]
        if record.get("kind") != "code" or record.get("lang") not in DECLARED:
            continue
        for symbol in record.get("symbols") or ():
            name = symbol["name"].rsplit(".", 1)[-1].rsplit(":", 1)[-1]
            if len(name) < 4 or name.startswith("__") or symbol["lines"] < 3:
                continue
            # PyObjC selectors (mouseUp_) are called by the Objective-C runtime, never by name.
            if record.get("lang") == "python" and name.endswith("_") and not name.startswith("_"):
                continue
            if edges_all_tokens.get(name, 0) <= 1:
                out.append(unit_span(fid, record, symbol))
    return out


def code_token_counts(graph):
    counts = {}
    for fid, record in graph.files.items():
        if record.get("kind") not in ("code", "instruction"):
            continue
        for token in (record.get("refs") or {}).get("code") or ():
            for part in re.split(r"[./:]", token):
                if part:
                    counts[part] = counts.get(part, 0) + 1
    return counts


def symbol_mentions(graph, fid, name):
    try:
        with open(os.path.join(graph.top_of(fid), fid.split("/", 1)[1]), errors="replace") as handle:
            text = handle.read()
    except OSError:
        return 2
    return len(re.findall(r"(?<![\w-])%s(?![\w-])" % re.escape(name), text))


def build_candidates():
    started = time.time()
    indexes = load_indexes()
    ledger = load_ledger()
    if not indexes:
        return None
    graph = Graph(indexes, ledger)
    edges = graph.edges()
    roots, dangling = entry_roots(graph)
    protected = protected_units(ledger)
    live = reachable(graph, edges, set(roots) | {u for u in protected if u in graph.files})
    days = rollup_days()
    cover = coverage(days)
    hits, _, sessions, _ = rollup_totals(days)
    signals = []

    dead_files = [fid for fid, record in graph.files.items()
                  if record.get("kind") == "code" and fid not in live and record.get("lang") in DECLARED
                  and not record.get("link")]
    dead_set = set(dead_files)
    for fid, record in graph.files.items():
        if record.get("kind") != "test" or fid in dead_set:
            continue
        targets = [t for t in edges.get(fid, ()) if graph.files[t].get("kind") == "code"]
        if targets and all(t in dead_set for t in targets):
            dead_files.append(fid)
    for group in components(dead_files, edges):
        spans = [unit_span(f, graph.files[f]) for f in sorted(group)]
        kept = [s for s in spans if s["unit"] in protected]
        spans = [s for s in spans if s["unit"] not in protected]
        if spans:
            signals.append({"group": "dead", "rule": "unreachable", "units": spans,
                            "detail": "no entry point reaches %s" % ", ".join(s["unit"] for s in spans[:4]),
                            "value": sum(s["lines"] for s in spans)})
        for span in kept:
            signals.append({"group": "dead", "rule": "unreachable", "units": [span], "protected": protected[span["unit"]],
                            "detail": "no entry point reaches %s" % span["unit"], "value": 0})
    token_counts = code_token_counts(graph)
    for span in dead_symbols(graph, live, token_counts):
        if span["unit"] in protected or span["file"] in protected:
            continue
        name = span["unit"].rsplit("#", 1)[1].rsplit(".", 1)[-1].rsplit(":", 1)[-1]
        if symbol_mentions(graph, span["file"], name) <= 1:
            signals.append({"group": "dead", "rule": "uncalled", "units": [span],
                            "detail": "%s is defined and never called" % span["unit"], "value": span["lines"]})
    for span, row in retired_hits(graph):
        signals.append({"group": "dead", "rule": "retired", "units": [span], "record": row.get("id"),
                        "detail": "%s matches the retired behavior %s (%s)" % (span["unit"], row.get("id"), row.get("record")),
                        "value": span["lines"]})
    for item in dangling:
        research = registration_research(item, graph)
        if research is None:
            continue
        step = registration_step(item, research)
        edit, trade = registration_owner(item, research, graph, step)
        signals.append({"group": "dead", "rule": "registration", "units": [], "research": research,
                        "needs_egor": bool(trade), "trade": trade, "files": [edit] if edit else [],
                        "registration": item, "anchor": "registration:%s" % item["target"],
                        "detail": registration_detail(item, research), "step": step, "value": 1})
    if cover["tail_days"] >= LIMITS["silent_days"]:
        for kind, source, command in settings_commands(graph.tops.values()):
            words = command.split()
            script = os.path.realpath(os.path.expanduser(words[0])) if words else ""
            fid = graph.by_real.get(script)
            if not fid:
                continue
            try:
                with open(script, errors="replace") as handle:
                    journaled = "hook-time.sh" in handle.read(200000)
            except OSError:
                journaled = False
            key = "hook:" + os.path.basename(script)
            if journaled and not hits.get(key):
                born = (git(graph.top_of(fid), "log", "--diff-filter=A", "--date=short", "--format=%ad", "--",
                            fid.split("/", 1)[1], timeout=20) or "").split()
                since = max([cover["tail_start"]] + born[-1:])
                silent_days = (datetime.date.fromisoformat(cover["end"]) - datetime.date.fromisoformat(since)).days + 1
                if silent_days < LIMITS["silent_days"]:
                    continue
                item = {"kind": "settings", "source": source, "target": script, "command": command}
                signals.append({"group": "dead", "rule": "silent", "units": [unit_span(fid, graph.files[fid])],
                                "registration": item, "step": registration_step(item),
                                "detail": "%s fired 0 times over %d covered days since %s" % (
                                    os.path.basename(script), silent_days, since),
                                "value": graph.files[fid].get("lines") or 0})

    slow, timed = heavy_tests(graph)
    foreign = set(foreign_repos())
    for fid, median, runs in slow:
        if graph.top_of(fid) not in foreign:
            continue
        requirement = test_requirement(graph, fid)
        signal = {"group": "heavy", "rule": "test", "units": [unit_span(fid, graph.files[fid])],
                  "detail": "%s takes %ds per run (median of %d runs in 28 d)" % (fid, median, runs), "value": round(median / 6.0)}
        if requirement:
            signal["protected"] = requirement
        signals.append(signal)
    for fid, (tokens, per_day, source) in instruction_costs(graph, sessions).items():
        how = ("measured %s by tokenmap over 30 d" % source.replace("_", "-")) if source else \
            "estimated as read by %s sessions a day" % (round(sessions) if sessions else "an unknown number of")
        signals.append({"group": "heavy", "rule": "tokens", "units": [unit_span(fid, graph.files[fid])],
                        "detail": "%s is ~%d tokens, ~%d a day, %s" % (fid, tokens, per_day, how),
                        "value": round(per_day / 100000.0)})
    for fid, record in graph.files.items():
        if record.get("kind") != "code":
            continue
        for symbol in record.get("symbols") or ():
            if symbol["lines"] >= LIMITS["complex_lines"]:
                signals.append({"group": "heavy", "rule": "complex", "units": [unit_span(fid, record, symbol)],
                                "detail": "%s is %d lines with %d branches" % (unit_id(fid, symbol), symbol["lines"], symbol["branches"]),
                                "value": 0})

    rows = shared_invariant_rows(indexes)
    for a, b, rule, score in clone_pairs(graph) + touch_pairs(graph):
        if intentional(a["file"], b["file"], rows, ledger):
            continue
        value = min(a["lines"], b["lines"])
        fixture = fixture_unit(graph, a) and fixture_unit(graph, b)
        signals.append({"group": "duplicate", "rule": rule, "units": [a, b],
                        "detail": "%s and %s share %s (%.2f)%s" % (a["unit"], b["unit"], rule, score,
                                                                   ", test fixture boilerplate" if fixture else ""),
                        "value": max(1, int(value * LIMITS["fixture_weight"])) if fixture else value})
    fresh = {repo: doc["cursor"].get("fresh") or {} for repo, doc in indexes.items()}
    sites, info, total = literal_index(graph)
    signals += concept_signals(graph, sites, info, total, fresh, rows, ledger)
    verdicts = load_verdicts()
    held = {unit for c in load_candidates() if (verdicts.get(c["id"]) or {}).get("verdict") == "problem"
            for unit in c.get("subjects") or ()}
    signals += reuse_signals(graph, sites, info, fresh, rows, ledger, held)
    signals += prose_signals(graph)
    signals += promise_signals(graph, edges, fresh)
    signals += overclaim_signals(graph, days)

    candidates = cluster(signals, graph, edges, roots, ledger, indexes, hits)
    path = os.path.join(state_dir(), "candidates.jsonl")
    os.makedirs(state_dir(), exist_ok=True)
    with open(path + ".tmp", "w", encoding="utf-8") as handle:
        for candidate in candidates:
            handle.write(json.dumps(candidate, ensure_ascii=False, sort_keys=True) + "\n")
    os.replace(path + ".tmp", path)
    blind = blind_languages(graph)
    write_json(os.path.join(state_dir(), "graph.json"), {
        "at": iso_time(now_s()), "files": len(graph.files), "live": len(live), "roots": len(roots),
        "blind_languages": blind, "coverage": cover, "timed_repos": timed,
        "snapshots": {repo: doc["cursor"]["snapshot"] for repo, doc in indexes.items()}})
    account(None, None, "collector", cpu_s=cpu_seconds(), wall_s=time.time() - started, note="candidates")
    return candidates


def registration_file(item, graph):
    if item["kind"] != "settings":
        return item["source"]
    label = item["source"].partition(" ")[0]
    repo, _, rest = label.partition("/")
    return os.path.join(graph.tops.get(repo, "/nonexistent"), rest) if rest else os.path.join(base_home(), ".claude", label)


def tracked_anywhere(top, rel):
    out = git(top, "log", "--all", "-1", "--format=%h", "--", rel)
    return out is None or bool(out.strip())


def registration_research(item, graph):
    target = item["target"]
    top = max((t for t in graph.tops.values() if target.startswith(t + "/")), key=len, default=None)
    if not top:
        return {}
    rel = os.path.relpath(target, top)
    if git(top, "cat-file", "-e", "HEAD:" + rel) is not None:
        return None
    found = {"repo": repo_name(top), "rel": rel, "name": os.path.basename(target), "refs": []}
    log = git(top, "log", "-1", "-M", "--diff-filter=DR", "--date=short", "--format=%h%x1f%ad%x1f%s", "--", rel)
    if log is None:
        return None
    if log.strip():
        found["commit"], found["date"], found["subject"] = log.strip().split("\x1f", 2)
        shown = git(top, "show", "-M", "--name-status", "--format=", found["commit"])
        if shown is None:
            return None
        for line in shown.splitlines():
            parts = line.split("\t")
            if len(parts) == 3 and parts[0].startswith("R") and parts[1] == rel and os.path.exists(os.path.join(top, parts[2])):
                found["renamed_to"], found["renamed_rel"] = os.path.join(top, parts[2]), parts[2]
    else:
        ever = git(top, "log", "-1", "--format=%h", "--", rel)
        if ever is None:
            return None
        if not ever.strip():
            if tracked_anywhere(top, rel):
                return None
            found["never_tracked"] = True
    source = os.path.realpath(registration_file(item, graph))
    for repo, repo_top in sorted(graph.tops.items()):
        out = git(repo_top, "grep", "-l", "-z", "-w", "-F", "-e", found["name"], "--", ".",
                  ":(exclude,glob)**/docs/**", ":(exclude,glob)**/*.md") or ""
        found["refs"] += ["%s/%s" % (repo, p) for p in out.split("\0")
                          if p and os.path.realpath(os.path.join(repo_top, p)) != source]
    return found


def read_plist(path):
    try:
        with open(path, "rb") as handle:
            plist = plistlib.load(handle)
    except Exception:
        return None
    return plist if isinstance(plist, dict) else None


def launchd_programs_of(args):
    found = set(os.path.realpath(a) for a in args[:1])
    if args and re.match(r"^((ba|z)?sh|python[\d.]*|node|perl|ruby|osascript)$", os.path.basename(args[0])):
        found.update(os.path.realpath(a) for a in args[1:2])
    return found


def launchd_programs(path):
    plist = read_plist(path) or {}
    args = [os.path.expanduser(str(a)) for a in (plist.get("ProgramArguments") or [])]
    if plist.get("Program"):
        args.insert(0, os.path.expanduser(str(plist["Program"])))
    found = launchd_programs_of(args)
    if args and os.path.dirname(os.path.realpath(args[0])) == os.path.realpath(os.path.join(base_home(), ".local", "libexec")):
        try:
            with open(args[0], errors="replace") as handle:
                text = handle.read(20000)
        except OSError:
            return found
        names = dict(re.findall(r"^\s*(?:export\s+)?([A-Za-z_]\w*)=[\"']?([^\"'\s;]+)", text, re.M))
        for line in re.findall(r"^\s*exec\s+(.+)$", text, re.M):
            line = re.sub(r"\$\{?([A-Za-z_]\w*)\}?", lambda m: names.get(m.group(1), m.group(0)), line)
            try:
                found |= launchd_programs_of([os.path.expanduser(w) for w in shlex.split(line, comments=True)])
            except ValueError:
                continue
    return found


def registration_owner(item, research, graph, step):
    settled = research.get("commit") or research.get("never_tracked")
    if not settled:
        return None, "Cost: removing it stops nothing that runs; Loss: no commit says why %s went, so a planned restore " \
            "loses it; Recommendation: remove it (steps)" % research.get("name")
    if item["kind"] == "path":
        return None, None
    if item["kind"] == "launchd":
        if research.get("renamed_to"):
            return None, "Cost: repointing reloads %s; Loss: keeping it, each run misses %s, now %s; " \
                "Recommendation: point it at the new path (steps)" % (
                    os.path.basename(item["source"])[:-6], research["name"], research["renamed_rel"])
        if item["target"] in launchd_programs(item["source"]):
            return None, None
        return None, "Cost: bootout stops %s, whose program still exists; Loss: keeping it, each run misses %s; " \
            "Recommendation: boot it out (steps)" % (os.path.basename(item["source"])[:-6], research["name"])
    path = os.path.realpath(registration_file(item, graph))
    for repo, top in sorted(graph.tops.items()):
        if path.startswith(top + "/"):
            return "%s/%s" % (repo, os.path.relpath(path, top)), None
    return None, "Cost: %s is in no repository, so no fixer may edit it; Loss: keeping it, each call misses %s; " \
        "Recommendation: remove it (steps)" % (os.path.basename(path), research["name"])


def registration_detail(item, research):
    detail = "%s registration %s points at %s, which no repository holds" % (item["kind"], item["source"], item["target"])
    if not (research.get("commit") or research.get("never_tracked")):
        return detail
    home = base_home().rstrip("/") + "/"
    source = "~/" + item["source"][len(home):] if item["source"].startswith(home) else item["source"]
    if research.get("never_tracked"):
        why = "never tracked by %s" % research["repo"]
    else:
        why = "%s by %s@%s %s «%s»" % ("renamed to %s" % research["renamed_rel"]
                                      if research.get("renamed_to") else "removed", research["repo"], research["commit"],
                                      research["date"], clip(research["subject"], 60))
    refs = research["refs"]
    used = "referenced by %s%s" % (", ".join(refs[:5]), " (+%d)" % (len(refs) - 5) if len(refs) > 5 else "") if refs else \
        "nothing references %s" % research["name"]
    return "%s → %s/%s %s; %s" % (source, research["repo"], research["rel"], why, used)


def registration_proofs(research):
    if not research or not (research.get("commit") or research.get("never_tracked")):
        return ["the target path is absent"]
    proofs = ["the target path is absent and untracked at %s HEAD" % research["repo"]]
    if research.get("never_tracked"):
        proofs.append("git log of %s/%s is empty: never tracked" % (research["repo"], research["rel"]))
    else:
        proofs.append("git log -1 --diff-filter=DR -- %s: %s@%s %s «%s»%s" % (
            research["rel"], research["repo"], research["commit"], research["date"], research["subject"],
            ", new path %s" % research["renamed_to"] if research.get("renamed_to") else ""))
    proofs.append("tracked non-markdown files outside docs/ naming %s: %s" % (research["name"], ", ".join(research["refs"]) or "none"))
    return proofs


def registration_step(item, research=None):
    research = research or {}
    if research.get("refs"):
        why = " as %s@%s says" % (research["repo"], research["commit"]) if research.get("commit") else ""
        return "migrate %s off %s%s, then %s" % (", ".join(research["refs"][:5]), research["name"], why,
                                                registration_step(item, dict(research, refs=[])))
    if research.get("renamed_to"):
        if item["kind"] == "path":
            return "ln -sfn %s %s" % (research["renamed_to"], item["source"])
        return "point %s at %s instead of %s" % (item["source"], research["renamed_to"], item["target"])
    if item["kind"] == "settings":
        label, _, key = item["source"].partition(" ")
        return "remove the hook command %r from %s in %s" % (item.get("command") or item["target"], key,
                                                              label if "/" in label else "~/.claude/" + label)
    if item["kind"] == "launchd":
        label = os.path.basename(item["source"])[:-6]
        return "launchctl bootout gui/$(id -u)/%s && rm %s (and its ~/.local/libexec wrapper)" % (label, item["source"])
    if item["kind"] == "path":
        return "rm %s" % item["source"]
    return "remove the reference to %s from %s" % (item["target"], item["source"])


def blind_languages(graph):
    out = {}
    for fid, record in graph.files.items():
        lang = record.get("lang") or ""
        if lang.startswith("undeclared:") and record.get("kind") not in ("fixture",):
            out.setdefault(lang[11:], []).append(fid)
    return {lang: {"files": len(fids), "examples": sorted(fids)[:3]} for lang, fids in sorted(out.items())}


def cluster(signals, graph, edges, roots, ledger, indexes, hits):
    parent = list(range(len(signals)))

    def find(i):
        while parent[i] != i:
            parent[i] = parent[parent[i]]
            i = parent[i]
        return i

    spans = [(i, span) for i, signal in enumerate(signals) if signal["group"] != "promise" for span in signal["units"]]
    by_file = {}
    for i, span in spans:
        by_file.setdefault(span["file"], []).append((i, span))
    for members in by_file.values():
        for x in range(len(members)):
            for y in range(x + 1, len(members)):
                (i, a), (j, b) = members[x], members[y]
                if i == j or not overlaps(a, b):
                    continue
                if a["unit"] == b["unit"] or not (signals[i]["rule"] in SITE_RULES or signals[j]["rule"] in SITE_RULES):
                    parent[find(i)] = find(j)
    by_anchor = {}
    for i, signal in enumerate(signals):
        if signal.get("anchor") and not signal["units"] and not signal.get("cause"):
            parent[find(i)] = find(by_anchor.setdefault(signal["anchor"], i))
    groups = {}
    for i in range(len(signals)):
        groups.setdefault(find(i), []).append(signals[i])
    inbound = {}
    for source, targets in edges.items():
        for target in targets:
            inbound.setdefault(target, set()).add(source)
    snapshots = {repo: doc["cursor"]["snapshot"] for repo, doc in indexes.items()}
    changed = {repo: set(doc["cursor"].get("changed") or ()) for repo, doc in indexes.items()}
    out = []
    for members in groups.values():
        units = {}
        for signal in members:
            for span in signal["units"]:
                units.setdefault(span["unit"], span)
        anchors = sorted(s["cause"] for s in members if s.get("cause")) or sorted(units) or sorted(
            s.get("anchor") for s in members if s.get("anchor"))
        if not anchors:
            continue
        group = min((s["group"] for s in members), key=lambda g: GROUP_RANK[g])
        files = sorted({span["file"] for span in units.values()} | {f for s in members for f in s.get("files") or ()})
        protected = [s.get("protected") for s in members if s.get("protected")]
        rules = sorted({s["rule"] for s in members})
        registrations = sorted({json.dumps(s["registration"], sort_keys=True) for s in members if s.get("registration")}
                               | {r for f in files for r in roots.get(f, ())})
        purpose = sorted({s["record"] for s in members if s.get("record")}
                         | {row.get("id") for row in ledger.get("keep") or () if isinstance(row, dict) and row.get("path") in files}
                         | {u for u in protected_units(ledger) if u in units or u in files})
        refs = sorted({r for f in files for r in inbound.get(f, ())})
        repos = sorted({f.split("/", 1)[0] for f in files})
        candidate = {
            "id": "cause:" + anchors[0], "group": group, "rules": rules,
            "units": [units[u] for u in sorted(units)], "files": files, "repos": repos,
            "detail": "; ".join(dict.fromkeys(s["detail"] for s in members))[:600],
            "value": sum(s.get("value") or 0 for s in members),
            "protected": "; ".join(protected) if protected and len(protected) == len(members) else None,
            "needs_egor": any(s.get("needs_egor") for s in members),
            "steps": [s["step"] for s in members if s.get("step")],
            "callers": refs[:40], "registrations": registrations, "purpose": purpose,
            "research": next((s["research"] for s in members if s.get("research")), None),
            "trade": next((s["trade"] for s in members if s.get("trade")), None),
            "snapshot": {repo: snapshots.get(repo) for repo in repos},
            "new": any(s.get("fresh") for s in members) or any(f.split("/", 1)[1] in changed.get(f.split("/", 1)[0], ()) for f in files),
            "fresh": any(s.get("fresh") for s in members),
            "reuse": sorted({r for s in members for r in s.get("reuse") or ()}),
            "subjects": sorted({s["subject"] for s in members if s.get("subject")}),
            "slice": "/".join(files[0].split("/")[:2]) if files else anchors[0],
            "runtime_hits": {k: hits[k] for k in ("hook:" + os.path.basename(f) for f in files) if k in hits},
        }
        if group == "promise":
            candidate.update(callers=[], registrations=[], purpose=[], risk=members[0]["risk"], claim=members[0].get("claim"),
                             sightings=members[0].get("sightings") or [])
        candidate["evidence_digest"] = evidence_digest(candidate)
        out.append(candidate)
    out.sort(key=lambda c: (-c["value"], c["id"]))
    return out


def evidence_digest(candidate):
    if candidate.get("group") == "promise":
        return sha(json.dumps({"units": [[u["unit"], u["digest"]] for u in candidate["units"]], "rules": candidate["rules"],
                               "detector": GROUP_DETECTOR["promise"]}, sort_keys=True))[:24]
    structural = {
        "units": [[u["unit"], u["digest"]] for u in candidate["units"]],
        "callers": candidate["callers"],
        "registrations": candidate["registrations"],
        "purpose": candidate["purpose"],
        "rules": candidate["rules"],
        "detector": GROUP_DETECTOR.get(candidate.get("group"), DETECTOR_VERSION),
    }
    return sha(json.dumps(structural, sort_keys=True))[:24]


def load_candidates():
    return read_jsonl(os.path.join(state_dir(), "candidates.jsonl"))




def load_ledger():
    ledger = read_json(ledger_path(), {}) or {}
    return ledger if isinstance(ledger, dict) else {}


def ledger_faults(ledger):
    faults = []
    for index, row in enumerate(ledger.get("rows") or ()):
        if not isinstance(row, dict) or not row.get("id"):
            faults.append(("rows[%d]" % index, "no id"))
            continue
        match = row.get("match")
        cause = match.get("cause") if isinstance(match, dict) else None
        identity = match.get("identity") if isinstance(match, dict) else None
        if not (isinstance(cause, str) and cause.startswith("cause:") and len(cause) > 8) and not (
                isinstance(identity, dict) and identity.get("sketch")):
            faults.append((row["id"], "match names no exact cause and no identity"))
        elif row.get("status") in DISMISSED and not cause:
            faults.append((row["id"], "a dismissal row needs an exact cause"))
    return faults


def identity_of(candidate, indexes):
    sketches, touch = set(), set()
    for span in candidate.get("units") or ():
        repo, rel = span["file"].split("/", 1)
        record = ((indexes.get(repo) or {}).get("files") or {}).get(rel) or {}
        symbols = [s for s in record.get("symbols") or () if unit_id(span["file"], s) == span["unit"]] or record.get("symbols") or []
        for symbol in symbols:
            sketches.update(symbol.get("sketch") or ())
            touch.update(symbol.get("touch") or ())
    return {"sketch": sorted(sketches)[:SKETCH_K * 2], "touch": sorted(touch)[:40]}


def identity_match(identity, candidate, indexes):
    if not identity or not identity.get("sketch"):
        return False
    mine = identity_of(candidate, indexes)
    a, b = set(identity["sketch"]), set(mine["sketch"])
    return bool(a and b) and len(a & b) / float(min(len(a), len(b))) >= LIMITS["clone_jaccard"]




def verdicts_path():
    return os.path.join(state_dir(), "verdicts.json")


def load_verdicts():
    return read_json(verdicts_path(), {}) or {}


def verdict_valid(verdict, candidate, now):
    if not isinstance(verdict, dict) or verdict.get("digest") != candidate["evidence_digest"]:
        return False
    if verdict.get("verdict") == "not-now":
        return (iso_epoch(verdict.get("expires")) or 0) > now
    return verdict.get("verdict") in ("problem", "kept")


def git_history(top, rel):
    born = git(top, "log", "--follow", "--diff-filter=A", "--format=%h %ad %s", "--date=short", "--", rel, timeout=20) or ""
    last = git(top, "log", "-3", "--format=%h %ad %s", "--date=short", "--", rel, timeout=20) or ""
    lines = born.strip().splitlines()[-1:] + last.strip().splitlines()
    return [clip(line, 160) for line in lines]


def candidate_lines(candidate, indexes):
    lines = ["Group: %s · rules: %s" % (candidate["group"], ", ".join(candidate["rules"])),
             "Signal: %s" % candidate["detail"], "", "Units (repo/path#symbol lines digest):"]
    for span in candidate["units"]:
        lines.append("- %s L%d-%d digest %s" % (span["unit"], span["start"], span["end"], span["digest"]))
    lines += ["", "Callers (code files that reference it): %s" % (", ".join(candidate["callers"][:20]) or "none"),
              "Entry points and registrations: %s" % (", ".join(candidate["registrations"][:10]) or "none"),
              "Purpose and retirement records: %s" % (", ".join(candidate["purpose"]) or "none"),
              "Runtime hits (rollup): %s" % (json.dumps(candidate.get("runtime_hits") or {}) or "none")]
    if candidate.get("reuse"):
        lines.append("Existing mechanism it should call: %s" % ", ".join(candidate["reuse"]))
    if candidate.get("fresh") and candidate["group"] != "promise":
        lines.append("Fresh: added or changed since the last index; judge whether it re-does an existing helper")
    if candidate["group"] == "promise":
        lines.append("Risk class: %s" % candidate.get("risk"))
        if candidate.get("claim"):
            lines.append("Claim, verbatim: %s" % candidate["claim"])
        if candidate.get("sightings"):
            lines.append("Sightings (transcript under ~/.claude/projects, session and line): %s" % "; ".join(candidate["sightings"]))
    for fid in candidate["files"][:3]:
        repo, rel = fid.split("/", 1)
        top = (indexes.get(repo) or {}).get("top")
        if top:
            lines.append("History of %s: %s" % (fid, " | ".join(git_history(top, rel)) or "untracked"))
    return lines


def judge_brief(batch, indexes):
    lines = ["ROUND: none", "# Code doctor judge: %d candidates" % len(batch), "",
             "You judge %d candidates of the Code doctor (llm-legs docs/code-doctor-design.md), each on its own. "
             "Read-only: change nothing." % len(batch)]
    for candidate in batch:
        lines += ["", "## Candidate %s" % candidate["id"], ""] + candidate_lines(candidate, indexes)
    lines += ["", "## How to judge", "",
              "Decide each candidate from the code, its git history and its records:",
              "- `problem`: real dead, heavy or duplicate code whose fix is clear. Give a concrete plan and its proof obligations "
              "(deletion: no live entry point, no rollup hits over a covered window, the purpose or retirement record you quote, "
              "green suites; a merge: the shared module first, callers migrated, the old copy deleted on a later night).",
              "- `not-now`: anything else, with the reason and what would re-open it.",
              "Reuse first, for every candidate: does an existing mechanism (a helper, a renderer such as share/report_frame.py "
              "behind bin/report-bus, a shared invariant of docs/shared-invariants.md) already do what this code or prose does? "
              "If yes, the plan is to call it and the plan names it (path and function); a new shared module only where none "
              "exists. `concept`: one rare literal spelled in several places; also find the places that produce the same "
              "concept without the literal (the same label built another way) and put them in the plan. `prose-layout`: an "
              "instruction tells the model to write a user-facing layout by hand; the plan renders it via the shared frame and "
              "leaves the model only the meaning. `reuse`: fresh code matched against existing helpers on relaxed thresholds.",
              "A test is kept for the requirement it protects, never for being quiet; a merge needs net benefit.",
              ] + (PROMISE_BRIEF if any(c["group"] == "promise" for c in batch) else []) + [
              "Research before any verdict, and decide what it settles. A hook that never fired (`silent`): find why it "
              "exists (`git log -S<its name>` in its repository, the commit subjects, the docs) and how often the event it "
              "guards happens (the hook, statusline and menu journals), and quote both in `reason`.",
              "Egor decides only what research cannot settle, and only as a trade: then add `\"needs_egor\": true, \"trade\": "
              "\"Cost: <each way's cost>; Loss: <what each way loses>; Recommendation: <yours>\"`. Without a trade the plan is "
              "the fixer's.",
              "", "End your answer with ONE JSON object per candidate, each on its own line, its `id` copied exactly "
              "from the candidate's heading:",
              '{"id": "<candidate id>", "verdict": "problem" | "not-now", "fact": "<one English line for the menu>", '
              '"plan": "<the fix>", "proofs": ["<obligation>", ...], "reason": "<why, quoting the record>", '
              '"triggers": ["<what re-opens it>"], "value": <net lines or minutes saved>}']
    if any(c["group"] == "promise" for c in batch):
        lines += ['A `promise` candidate adds `"kind": "broken" | "untested"` and `"fix": "code" | "claim"` to a problem, '
                  'and its `kept` verdict is `{"id": ..., "verdict": "kept", "kept_by": "<file:line>", "test": "<file:line or none>", '
                  '"fact": ..., "reason": ...}`.']
    return "\n".join(lines) + "\n"


def json_objects(text):
    decoder = json.JSONDecoder()
    position = 0
    while True:
        start = text.find("{", position)
        if start < 0:
            return
        try:
            value, consumed = decoder.raw_decode(text[start:])
        except ValueError:
            position = start + 1
            continue
        if isinstance(value, dict):
            yield value
        position = start + max(consumed, 1)


def parse_results(text, ids):
    found = {}
    for value in json_objects(text):
        if value.get("verdict") in ("problem", "not-now", "kept") and value.get("id") in ids:
            if value["verdict"] != "kept" or value.get("kept_by") and (value["id"].startswith("cause:overclaim:")
                                                                     or "#promise:" in value["id"]):
                found[value["id"]] = value
    return found


def report_tokens(report, brief, result):
    match = re.search(r"^COST: ([0-9.]+)(k|M)? tok-eq", report, re.M)
    if match:
        return int(float(match.group(1)) * {"k": 1e3, "M": 1e6, None: 1}[match.group(2)])
    return int((len(brief) + len(result)) / 4)


def judge_sessions():
    sessions = {}
    for row in read_jsonl(os.path.join(state_dir(), "accounting.jsonl")):
        if row.get("stage") == "judge" and (row.get("tokens") or 0) > 0:
            key = row.get("run") or row.get("note")
            sessions[key] = sessions.get(key, 0) + row["tokens"]
    return list(sessions.values())


def session_estimate(history, brief):
    recent = history[-JUDGE_HISTORY:]
    if recent:
        return sum(recent) / float(len(recent))
    return len(brief) / 4.0 * TOKEN_ESTIMATE_FACTOR + JUDGE_BASE_TOKENS


def batches_of(pending, size):
    queue = list(pending)
    while queue:
        repo = queue[0]["repos"][:1]
        batch = [c for c in queue if c["repos"][:1] == repo][:size]
        taken = {c["id"] for c in batch}
        queue = [c for c in queue if c["id"] not in taken]
        yield batch


def split_tokens(tokens, count):
    share = tokens // count
    return [tokens - share * (count - 1)] + [share] * (count - 1)


def worker_judge(brief_file, workdir, vendor, remaining):
    """(run id, report, error): one judge brief through worker-run, waited on at most `remaining` seconds."""
    started = time.time()
    try:
        launch = subprocess.run([worker_run_cmd(), "start", vendor, "--brief", brief_file, "--workdir", workdir,
                                 "--effort", "low"], capture_output=True, text=True)
    except OSError as exc:
        return None, "", "worker-run start: %s" % exc
    run_id = next((l[5:].strip() for l in launch.stdout.splitlines() if l.startswith("RUN: ")), None)
    if launch.returncode != 0 or not run_id:
        output = " | ".join(part.strip() for part in (launch.stderr, launch.stdout) if part.strip())
        return None, "", "worker-run start rc %d: %s" % (launch.returncode, output[-LAUNCH_ERROR_MAX:] or "no output")
    waited = subprocess.run([worker_run_cmd(), "wait", run_id, "--max", str(int(max(1, remaining)))],
                            capture_output=True, text=True).stdout
    collector_runs.worker_launched("code", started, "CODE_DOCTOR_DIR", run_id, waited)
    return run_id, subprocess.run([worker_run_cmd(), "report", run_id], capture_output=True, text=True).stdout, None


def review_debt_cmd():
    return os.environ.get("CODE_DOCTOR_REVIEW_DEBT") or os.path.join(base_home(), ".local", "bin", "review-debt")


def critical_brief(top, rows):
    lines = ["ROUND: none", "# Code doctor critical judge: %d debt paths of %s" % (len(rows), top), "",
             "Judge each path below on its own: is it CRITICAL — code that many other parts of this repository or of "
             "the running setup depend on, so a bug in it breaks much else (a shared library, a gate every call "
             "passes, a store or contract other programs read)? A leaf script, a test, a doc, a fixture or a one-off "
             "tool is not. Read the file and how it is used; the fan-in is how many other tracked files load it by "
             "name, a hint only. Read-only: change nothing."]
    for row in rows:
        lines += ["", "## Candidate %s" % row["path"], "", "fan-in hint: %s" % row["fan_in"]]
    lines += ["", "End your answer with ONE JSON object per path, each on its own line, its `id` copied exactly from "
              "the path's heading:", '{"id": "<path>", "critical": true | false, "reason": "<one English line>"}']
    return "\n".join(lines) + "\n"


def unjudged_debt(top):
    try:
        proc = subprocess.run([review_debt_cmd(), "--repo", top, "--list", "--split"], capture_output=True, text=True)
    except OSError as exc:
        return [], "review-debt --list: %s" % exc
    if proc.returncode != 0:
        return [], "review-debt --list rc %d: %s" % (proc.returncode, (proc.stderr or proc.stdout).strip()[-LAUNCH_ERROR_MAX:])
    rows = []
    for line in proc.stdout.splitlines():
        cells = line.split("\t")
        if len(cells) == 6 and cells[3] == "unjudged":
            rows.append({"path": cells[0], "blob": cells[4], "fan_in": cells[5]})
    return rows, None


def run_critical(night, max_tokens, max_wall, vendor, batch_size=JUDGE_BATCH):
    started = time.time()
    spent, judged, waiting, stop, error = 0, 0, 0, "done", None
    history = []
    folder = os.path.join(state_dir(), "critical", night or "day")
    os.makedirs(folder, exist_ok=True)
    for top in repo_paths():
        pending, list_error = unjudged_debt(top)
        if list_error:
            if stop == "done":
                stop, error = "list-failed", list_error
            break
        waiting += len(pending)
        while pending and stop == "done":
            batch, pending = pending[: max(1, batch_size)], pending[max(1, batch_size):]
            brief = critical_brief(top, batch)
            remaining = max_wall - (time.time() - started)
            if spent + session_estimate(history, brief) > max_tokens:
                stop = "tokens"
            elif remaining <= 0:
                stop = "wall"
            if stop != "done":
                break
            brief_file = os.path.join(folder, "%s-%d.md" % (os.path.basename(top), judged + 1))
            with open(brief_file, "w", encoding="utf-8") as handle:
                handle.write(brief)
            call_start = time.time()
            run_id, report, error = worker_judge(brief_file, top, vendor, remaining)
            if error:
                stop = "launch-failed"
                break
            result = report.split("RESULT:\n", 1)[1] if "RESULT:\n" in report else ""
            tokens = report_tokens(report, brief, result)
            spent += tokens
            history.append(tokens)
            found = {value.get("id"): value for value in json_objects(result) if isinstance(value.get("critical"), bool)}
            verdicts = [{"path": row["path"], "blob": row["blob"], "critical": found[row["path"]]["critical"],
                         "reason": found[row["path"]].get("reason") or ""} for row in batch if row["path"] in found]
            try:
                recorded = subprocess.run([review_debt_cmd(), "--repo", top, "--record-critical"], capture_output=True,
                                          text=True, input="".join(json.dumps(verdict) + "\n" for verdict in verdicts))
                if recorded.returncode != 0:
                    error = "review-debt --record-critical rc %d: %s" % (
                        recorded.returncode, (recorded.stderr or recorded.stdout).strip()[-LAUNCH_ERROR_MAX:])
            except OSError as exc:
                error = "review-debt --record-critical: %s" % exc
            account(night, "critical:%s" % os.path.basename(top), "critical", tokens=tokens,
                    wall_s=time.time() - call_start, note=error or run_id, run=run_id)
            if error:
                stop = "record-failed"
                break
            judged += len(verdicts)
            if re.search(r"^STATUS: running", report, re.M):
                stop = "wall"
    record = {"night": night, "at": iso_time(now_s()), "stop": stop, "judged": judged, "pending": waiting - judged,
              "tokens": spent, "wall_s": round(time.time() - started, 1), "error": error}
    append_jsonl(os.path.join(state_dir(), "critical-runs.jsonl"), record)
    return record


def run_judge(night, max_tokens, max_wall, vendor, limit=None, batch_size=JUDGE_BATCH):
    started = time.time()
    now = now_s()
    indexes = load_indexes()
    verdicts = load_verdicts()
    candidates = [c for c in load_candidates() if not c.get("protected")]
    pending = [c for c in candidates if not verdict_valid(verdicts.get(c["id"]), c, now) and not auto_verdict(c)]
    slices = read_json(os.path.join(state_dir(), "slices.json"), {}) or {}
    pending.sort(key=lambda c: (not c.get("fresh"), c["slice"] in slices, not c.get("new"), -c["value"], c["id"]))
    history = judge_sessions()
    spent, judged, stop, error = 0, 0, "done", None
    folder = os.path.join(state_dir(), "judge", night or "day")
    os.makedirs(folder, exist_ok=True)
    for number, batch in enumerate(batches_of(pending, max(1, batch_size)), 1):
        if limit is not None:
            if judged >= limit:
                stop = "limit"
                break
            batch = batch[: limit - judged]
        brief = judge_brief(batch, indexes)
        if spent + session_estimate(history, brief) > max_tokens:
            stop = "tokens"
            break
        remaining = max_wall - (time.time() - started)
        if remaining <= 0:
            stop = "wall"
            break
        ids = [c["id"] for c in batch]
        brief_file = os.path.join(folder, "batch-%03d-%s.md" % (number, re.sub(r"[^A-Za-z0-9._-]+", "_", ids[0])[:100]))
        with open(brief_file, "w", encoding="utf-8") as handle:
            handle.write(brief)
        repo_top = (indexes.get(batch[0]["repos"][0]) or {}).get("top") if batch[0]["repos"] else ROOT_DIR
        call_start = time.time()
        run_id, report, error = worker_judge(brief_file, repo_top or ROOT_DIR, vendor, remaining)
        if error:
            account(night, ids[0], "judge", tokens=0, wall_s=time.time() - call_start, note="launch failed: " + error, batch=ids)
            stop = "launch-failed"
            break
        result = report.split("RESULT:\n", 1)[1] if "RESULT:\n" in report else ""
        tokens = report_tokens(report, brief, result)
        spent += tokens
        history.append(tokens)
        wall = time.time() - call_start
        shares = split_tokens(tokens, len(batch))
        if re.search(r"^STATUS: running", report, re.M):
            for cid, share in zip(ids, shares):
                account(night, cid, "judge", tokens=share, wall_s=wall / len(batch), run=run_id,
                        note="wall budget hit mid-judgment, run %s" % run_id)
            stop = "wall"
            break
        found = parse_results(result, set(ids))
        for candidate, share in zip(batch, shares):
            account(night, candidate["id"], "judge", tokens=share, wall_s=wall / len(batch), note=run_id, run=run_id)
            verdict = found.get(candidate["id"])
            if not verdict:
                account(night, candidate["id"], "retries", tokens=0, wall_s=0, note="no verdict in the result")
                continue
            judged += 1
            entry = {"verdict": verdict["verdict"], "digest": candidate["evidence_digest"], "at": iso_time(now_s()),
                     "fact": clip(verdict.get("fact") or candidate["detail"], 200), "plan": verdict.get("plan"),
                     "proofs": verdict.get("proofs") or [], "reason": verdict.get("reason"),
                     "triggers": verdict.get("triggers") or [], "value": verdict.get("value"), "run": run_id,
                     "needs_egor": verdict.get("needs_egor") is True, "trade": verdict.get("trade"),
                     "group": candidate["group"], "snapshot": candidate["snapshot"], "night": night,
                     "first_at": (verdicts.get(candidate["id"]) or {}).get("first_at") or iso_time(now_s())}
            if candidate["group"] == "promise":
                entry.update({k: verdict[k] for k in ("kind", "fix", "kept_by", "test") if verdict.get(k)})
                if entry["verdict"] == "problem" and entry.get("kind") == "untested" and candidate.get("risk") == "other":
                    entry.update(verdict="not-now", reason="untested outside the risk classes; %s" % (entry.get("reason") or ""))
            if entry["verdict"] == "not-now":
                entry["expires"] = iso_time(now_s() + NOT_NOW_DAYS * 86400)
            verdicts[candidate["id"]] = entry
            slices[candidate["slice"]] = {"at": iso_time(now_s()), "snapshot": candidate["snapshot"]}
        write_json(verdicts_path(), verdicts)
        write_json(os.path.join(state_dir(), "slices.json"), slices)
        if spent >= max_tokens:
            stop = "tokens"
            break
    record = {"night": night, "at": iso_time(now_s()), "stop": stop, "judged": judged, "pending": len(pending) - judged,
              "tokens": spent, "wall_s": round(time.time() - started, 1), "max_tokens": max_tokens, "max_wall_s": max_wall,
              "error": error}
    append_jsonl(os.path.join(state_dir(), "judge-runs.jsonl"), record)
    return record




def account(night, cause, stage, tokens=0, wall_s=0.0, cpu_s=0.0, note=None, **extra):
    row = {"at": iso_time(now_s()), "night": night, "cause": cause, "stage": stage, "tokens": int(tokens or 0),
           "wall_s": round(float(wall_s or 0), 2), "cpu_s": round(float(cpu_s or 0), 3), "note": note}
    row.update(extra)
    append_jsonl(os.path.join(state_dir(), "accounting.jsonl"), row)


def accounting_summary(ledger):
    rows = read_jsonl(os.path.join(state_dir(), "accounting.jsonl"))
    per_cause, totals = {}, {"tokens": 0, "wall_s": 0.0, "cpu_s": 0.0}
    critical_tokens = 0
    for row in rows:
        totals["tokens"] += row.get("tokens") or 0
        if row.get("stage") == "critical":
            critical_tokens += row.get("tokens") or 0
        totals["wall_s"] += row.get("wall_s") or 0
        totals["cpu_s"] += row.get("cpu_s") or 0
        if row.get("cause"):
            entry = per_cause.setdefault(row["cause"], {})
            stage = entry.setdefault(row.get("stage") or "?", {"tokens": 0, "wall_s": 0.0})
            stage["tokens"] += row.get("tokens") or 0
            stage["wall_s"] += row.get("wall_s") or 0
    gained = {"lines_removed": 0, "suite_s_saved": 0, "tokens_cut": 0, "causes_closed": 0}
    for row in ledger.get("rows") or ():
        if not isinstance(row, dict):
            continue
        if row.get("status") in ("fixed", "fixed-pending"):
            gained["causes_closed"] += 1
        for fix in row.get("fixes") or ():
            for key in ("lines_removed", "suite_s_saved", "tokens_cut"):
                gained[key] += int(((fix or {}).get("yield") or {}).get(key) or 0)
    totals = {k: round(v, 1) if isinstance(v, float) else v for k, v in totals.items()}
    return {"totals": totals, "per_cause": per_cause, "yield": gained, "critical_tokens": critical_tokens}


def queue_k(summary):
    spent = summary["totals"]["tokens"] - summary.get("critical_tokens", 0)
    if spent < 100000:
        return TOP_K
    gained = summary["yield"]["lines_removed"] + summary["yield"]["suite_s_saved"] / 6.0 + summary["yield"]["tokens_cut"] / 1000.0
    return TOP_K if gained / (spent / 1000.0) >= LOW_YIELD_PER_KTOK else TOP_K_LOW_YIELD




def judge_digest():
    digest = hashlib.sha256()
    with open(os.path.realpath(__file__), "rb") as handle:
        digest.update(handle.read())
    ledger = load_ledger()
    judged = {key: ledger.get(key) for key in ("protected", "keep", "intentional", "retired")}
    judged["rows"] = [{k: row.get(k) for k in ("id", "match", "status")} for row in ledger.get("rows") or ()
                      if isinstance(row, dict) and row.get("status") in DISMISSED]
    digest.update(json.dumps(judged, sort_keys=True).encode())
    digest.update(json.dumps({"limits": LIMITS, "detector": DETECTOR_VERSION, "top_k": TOP_K}, sort_keys=True).encode())
    return digest.hexdigest()


def problem_of(candidate, verdict):
    units = candidate["units"]
    evidence = [{"at": verdict.get("at"), "ref": "%s@%s" % (span["unit"], span["digest"][:8]), "account": None,
                 "excerpt": clip(verdict.get("reason") or candidate["detail"])} for span in units[:EVIDENCE_MAX]]
    if not units and candidate.get("registrations"):
        evidence = [{"at": verdict.get("at"), "ref": candidate["id"], "account": None, "excerpt": clip(candidate["detail"])}]
    fact = verdict.get("fact") or candidate["detail"]
    trade = candidate.get("trade") or (verdict.get("needs_egor") and verdict.get("trade")) or None
    needs_egor = bool(candidate.get("needs_egor") or trade)
    if needs_egor:
        fact = "needs Egor: " + (trade or fact)
    problem = {"id": candidate["id"], "rule": candidate["rules"][0], "rules": candidate["rules"], "group": candidate["group"],
            "state": "new", "fact": clip(fact, 200), "value": verdict.get("value") if isinstance(verdict.get("value"), (int, float)) else candidate["value"],
            "limit": 0, "unit": "lines", "window_h": None, "exposure": max(len(units), 1), "count": None,
            "first_seen": verdict.get("first_at") or verdict.get("at"), "last_seen": verdict.get("at"),
            "evidence": evidence, "ledger": None, "plan": verdict.get("plan"), "proofs": verdict.get("proofs") or [],
            "needs_egor": needs_egor, "trade": trade, "steps": candidate.get("steps") or [],
            "units": units, "files": candidate["files"], "repos": candidate["repos"], "snapshot": candidate["snapshot"],
            "digest": candidate["evidence_digest"]}
    if candidate["group"] == "promise":
        problem.update(kind=verdict.get("kind") or "broken", fix=verdict.get("fix"), risk=candidate.get("risk"))
        problem["proofs"] = problem["proofs"] + [PROMISE_PROOF]
    return problem


def auto_verdict(candidate):
    if candidate["rules"] == ["registration"]:
        return {"verdict": "problem", "digest": candidate["evidence_digest"], "at": iso_time(now_s()),
                "fact": candidate["detail"], "plan": "; ".join(candidate["steps"]),
                "reason": "the registration's target does not exist", "proofs": registration_proofs(candidate.get("research"))}
    return None


def retire_launch_agent(night, cause, item):
    plist = item["source"]
    if not os.path.isfile(plist) or os.path.exists(item["target"]) or item["target"] not in launchd_programs(plist):
        return None
    label = str((read_plist(plist) or {}).get("Label") or os.path.basename(plist)[:-6])
    bootout = subprocess.run([os.environ.get("CODE_DOCTOR_LAUNCHCTL") or "launchctl", "bootout", "gui/%d/%s" % (os.getuid(), label)],
                             capture_output=True, text=True)
    folder = os.path.join(state_dir(), "retired-launchagents")
    os.makedirs(folder, exist_ok=True)
    dest = os.path.join(folder, os.path.basename(plist))
    if os.path.exists(dest):
        dest = "%s.%d" % (dest, int(now_s()))
    shutil.move(plist, dest)
    what = "booted out %s (launchctl rc %d), %s moved to %s" % (label, bootout.returncode, plist, dest)
    account(night, cause, "fix", note=what, plist=plist, moved_to=dest, label=label, bootout_rc=bootout.returncode)
    return what


def settle_registrations(night):
    done = []
    for candidate in load_candidates():
        research = candidate.get("research") or {}
        if candidate["rules"] != ["registration"] or candidate.get("needs_egor") or research.get("refs"):
            continue
        for text in candidate["registrations"]:
            try:
                item = json.loads(text)
            except ValueError:
                continue
            if not isinstance(item, dict):
                continue
            rel = research.get("rel") or ""
            if research.get("never_tracked") and (not item["target"].endswith("/" + rel) or
                                                  tracked_anywhere(item["target"][:-len(rel) - 1], rel)):
                continue
            if item["kind"] == "launchd":
                what = retire_launch_agent(night, candidate["id"], item)
                done += [what] if what else []
                continue
            link = item["source"]
            if item["kind"] != "path" or not os.path.islink(link) or os.path.exists(link) or os.path.realpath(link) != item["target"]:
                continue
            old = os.readlink(link)
            os.unlink(link)
            if research.get("renamed_to"):
                os.symlink(research["renamed_to"], link)
            what = "relinked %s -> %s (was %s)" % (link, research["renamed_to"], old) if research.get("renamed_to") else \
                "unlinked %s -> %s" % (link, old)
            account(night, candidate["id"], "fix", note=what, link=link, readlink=old, relinked=research.get("renamed_to"))
            done.append(what)
    return done


def apply_ledger(problems, candidates, ledger, indexes):
    rows = [r for r in ledger.get("rows") or () if isinstance(r, dict)]
    faulty = {rid for rid, _ in ledger_faults(ledger)}
    by_id = {c["id"]: c for c in candidates}
    kept = []
    for rid, why in ledger_faults(ledger):
        kept.append({"id": "ledger:%s" % rid, "rule": "ledger", "group": "ledger", "state": "new",
                     "fact": "ledger row %s: %s, so it judges nothing" % (rid, why), "value": 1, "limit": 0, "unit": "rows",
                     "window_h": None, "exposure": len(rows), "count": 1, "first_seen": None, "last_seen": None,
                     "evidence": [], "ledger": rid})
    seen_rows = set()
    for problem in problems:
        row = None
        for candidate_row in rows:
            if candidate_row.get("id") in faulty:
                continue
            match = candidate_row.get("match") or {}
            if match.get("cause") == problem["id"] or (match.get("identity") and by_id.get(problem["id"])
                                                       and identity_match(match["identity"], by_id[problem["id"]], indexes)):
                row = candidate_row
                break
        if row:
            status = row.get("status")
            if status in DISMISSED:
                continue
            seen_rows.add(row.get("id"))
            problem["cause"] = problem["id"]
            problem["ledger"] = problem["id"] = row.get("id")
            if status == "fixed-pending":
                problem["state"] = "fixed-pending"
            elif status == "fixed":
                problem["state"] = "regressed"
            else:
                problem["state"] = "open"
        kept.append(problem)
    for row in rows:
        if row.get("status") == "fixed-pending" and row.get("id") not in seen_rows and row.get("id") not in faulty:
            kept.append({"id": row["id"], "rule": "fix-proof", "group": (row.get("group") or "dead"), "state": "fixed-pending",
                         "fact": "%s · fixed, its candidate is gone" % (row.get("title") or row["id"]), "value": 0, "limit": 0,
                         "unit": "lines", "window_h": None, "exposure": 1, "count": None, "first_seen": None,
                         "last_seen": None, "evidence": [], "ledger": row["id"], "units": [], "files": row.get("files") or []})
    return kept


def document(started):
    now = now_s()
    ledger = load_ledger()
    indexes = load_indexes()
    graph_info = read_json(os.path.join(state_dir(), "graph.json"), {}) or {}
    candidates = load_candidates()
    verdicts = load_verdicts()
    blind = []
    if not indexes:
        blind.append("index")
    if not os.path.exists(os.path.join(state_dir(), "candidates.jsonl")):
        blind.append("candidates")
    problems, waiting, protected = [], [], 0
    for candidate in candidates:
        if candidate.get("protected"):
            protected += 1
            continue
        verdict = verdicts.get(candidate["id"])
        if not verdict_valid(verdict, candidate, now):
            verdict = auto_verdict(candidate)
        if verdict and verdict.get("verdict") == "problem":
            problems.append(problem_of(candidate, verdict))
        elif not verdict_valid(verdicts.get(candidate["id"]), candidate, now):
            waiting.append(candidate)
    problems = apply_ledger(problems, candidates, ledger, indexes)
    groups = {g: 0 for g in GROUPS}
    for problem in problems:
        if problem["state"] in COUNTED:
            groups[problem.get("group") or "dead"] = groups.get(problem.get("group") or "dead", 0) + 1
    count = sum(groups.values())
    summary = accounting_summary(ledger)
    days = rollup_days()
    cover = coverage(days)
    foreign = foreign_repos()
    spots = [] if foreign else list(ledger.get("blind_spots") or [])
    for lang, info in (graph_info.get("blind_languages") or {}).items():
        spots.append({"id": "language:%s" % lang, "what": "%s: %d files no detector reads" % (lang, info["files"]),
                      "reason": "only bash, python, lua, js and jq are parsed; e.g. %s" % ", ".join(info["examples"]),
                      "since": None, "would_catch_if": "a parser for %s" % lang})
    if foreign:
        spots.append({"id": "runtime:no-journal", "what": "heavy: hot code and runtime silence not measured in %s" % (
            ", ".join(repo_name(t) for t in foreign)), "reason": "no hook, menu or statusline journal records its runtime",
            "since": None, "would_catch_if": "a runtime journal of that repository"})
        untimed = [repo_name(t) for t in foreign if repo_name(t) not in (graph_info.get("timed_repos") or ())]
        if untimed:
            spots.append({"id": "tests:untimed", "what": "heavy tests: no timing source for %s" % ", ".join(untimed),
                          "reason": "no suite run of it is in the statusline test history", "since": None,
                          "would_catch_if": "its suites run under statusline-work-probe's journal"})
    elif not cover["start"]:
        spots.append({"id": "rollup:none", "what": "runtime silence: no rollup day yet",
                      "reason": "the harness journals were never rolled up", "since": None,
                      "would_catch_if": "code-doctor rollup runs before the journals' 3-day prune"})
    elif cover["tail_days"] < LIMITS["silent_days"]:
        spots.append({"id": "rollup:short", "what": "runtime silence: %d covered days since %s, %d needed" % (
            cover["tail_days"], cover.get("tail_start"), LIMITS["silent_days"]),
            "reason": "silence is never claimed past the rollup's start" + (" (gaps: %s)" % ", ".join(cover["gaps"][:3]) if cover["gaps"] else ""),
            "since": cover["start"], "would_catch_if": "%d more covered days" % (LIMITS["silent_days"] - cover["tail_days"])})
    for what, why in () if foreign else (("CLI invocations through the PATH shims", "no shim journals a CLI call"),
                                         ("gate branches", "no journal records which branch of a gate fired"),
                                         ("superseded machinery", "no detector reads vendor capability changes yet")):
        spots.append({"id": "runtime:" + re.sub(r"\W+", "-", what.lower()).strip("-"), "what": what + ": not measured",
                      "reason": why, "since": None, "would_catch_if": "a journal or detector for it"})
    status = "blind" if blind else ("problems" if count else "ok")
    slices = read_json(os.path.join(state_dir(), "slices.json"), {}) or {}
    all_slices = sorted({c["slice"] for c in candidates})
    last_judge = (read_jsonl(os.path.join(state_dir(), "judge-runs.jsonl")) or [None])[-1]
    per_night = max(1, int(BUDGET["tokens"] // session_estimate(judge_sessions(), ""))) * JUDGE_BATCH
    return {
        "contract": 1, "doctor": "code", "as_of": iso_time(now), "as_of_s": int(now), "judge": judge_digest(),
        "status": status, "problem_count": count, "groups": groups, "problems": problems,
        "blind_spots": spots, "blind": blind,
        "scope": {"repos": repo_paths(), "foreign": foreign, "report_only": report_only()},
        "candidates": {"total": len(candidates), "waiting": len(waiting), "protected": protected,
                       "judged": len(candidates) - len(waiting) - protected,
                       "waiting_by_group": {g: sum(1 for c in waiting if c["group"] == g) for g in GROUPS},
                       "top": [{"id": c["id"], "group": c["group"], "detail": clip(c["detail"], 160), "value": c["value"]}
                               for c in waiting[:5]]},
        "cost": summary["totals"], "cost_per_cause": summary["per_cause"], "yield": summary["yield"],
        "queue_k": queue_k(summary), "last_judge": last_judge,
        "coverage": {"rollup": cover, "deep_pass": {"slices": len(all_slices), "covered": sum(1 for s in all_slices if s in slices)},
                     "judge": {"per_night": per_night, "nights_to_cover": -(-len(waiting) // per_night),
                               "promise": {"total": sum(1 for c in candidates if c["group"] == "promise"),
                                           "waiting": sum(1 for c in waiting if c["group"] == "promise")}}},
        "index": {repo: {"files": len(doc.get("files") or {}), "snapshot": (doc.get("cursor") or {}).get("snapshot"),
                         "at": (doc.get("cursor") or {}).get("at")} for repo, doc in indexes.items()},
        "self": {"collector_s": round(time.time() - started, 3), "error": None},
    }


def write_document(doc):
    write_json(os.path.join(state_dir(), "latest.json"), doc)
    if not scoped():
        collector_runs.problem_day("code", doc, "CODE_DOCTOR_DIR")


def view(doc):
    lines = ["Code doctor: %s · %d problems · %d candidates waiting" % (
        doc["status"], doc["problem_count"], (doc.get("candidates") or {}).get("waiting", 0))]
    for group in GROUPS:
        lines.append("  %-9s %d" % (group, doc["groups"].get(group, 0)))
    for problem in doc["problems"]:
        lines.append("  %-13s %-9s %s" % (problem["state"], problem.get("group"), problem["fact"]))
    return "\n".join(lines)




def porcelain(top, *paths):
    entries = (git(top, "status", "--porcelain", "-z", "--no-renames", "--untracked-files=all", "--", *paths) or "").split("\0")
    return [(entry[:2].strip() or "M", entry[3:]) for entry in entries if len(entry) > 3]


def diff_entries(tree, base):
    span = [base, "HEAD"] if base == EMPTY_TREE else [base + "...HEAD"]
    fields = (git(tree, "diff", "--name-status", "-z", "--no-renames", *span) or "").split("\0")
    return [(fields[i], fields[i + 1]) for i in range(0, len(fields) - 1, 2) if fields[i]]


def rebase_onto(tree):
    branch = (git(tree, "symbolic-ref", "-q", "HEAD") or "").strip()
    for line in (git(tree, "reflog", "show", "--format=%gs", branch) or "").splitlines() if branch else ():
        match = re.match(r"rebase \(finish\): \S+ onto ([0-9a-f]{40})$", line)
        if match:
            onto = match.group(1)
            return onto if git(tree, "merge-base", "--is-ancestor", onto, "HEAD") is not None else None
    return None


def active_work(indexes, exclude_branch=None):
    out = {}
    for repo, doc in indexes.items():
        top = doc["top"]
        paths = {}
        for _, rel in porcelain(top):
            paths[rel] = "uncommitted in %s" % top
        listing = git(top, "worktree", "list", "--porcelain") or ""
        for block in listing.strip().split("\n\n"):
            fields = dict(line.split(" ", 1) for line in block.splitlines() if " " in line)
            tree, branch = fields.get("worktree"), (fields.get("branch") or "").replace("refs/heads/", "")
            if not tree or os.path.realpath(tree) == os.path.realpath(top) or branch == exclude_branch:
                continue
            for _, rel in porcelain(tree):
                paths.setdefault(rel, "uncommitted in worktree %s" % tree)
            if branch:
                for rel in (git(top, "diff", "--name-only", "-z", "--no-renames", "HEAD..." + branch) or "").split("\0"):
                    if rel:
                        paths.setdefault(rel, "changed on live branch %s" % branch)
        for rel, claim in review_claims(top).items():
            if isinstance(claim, dict) and (claim.get("until") or 0) > now_s():
                paths.setdefault(rel, "under an open review claim of %s" % claim.get("session"))
        out[repo] = paths
    return out


def review_claims(top):
    search = os.pathsep.join((os.environ.get("PATH", ""), os.path.join(base_home(), ".local", "bin")))
    binary = shutil.which("review-anchors", path=search)
    if not binary:
        return {}
    try:
        done = subprocess.run([binary, "list", "--repo", top, "--json"], capture_output=True, text=True, timeout=30)
        return (json.loads(done.stdout) or {}).get("claims") or {} if done.returncode == 0 else {}
    except (OSError, subprocess.SubprocessError, ValueError, AttributeError):
        return {}


def unit_digest_at(top, ref, span):
    rel = span["file"].split("/", 1)[1]
    if ref:
        data = git(top, "show", "%s:%s" % (ref, rel), raw=True)
        if data is None:
            return None
    else:
        try:
            with open(os.path.join(top, rel), "rb") as handle:
                data = handle.read()
        except OSError:
            return None
    if "#" not in span["unit"]:
        return sha(data)[:16]
    name = span["unit"].rsplit("#", 1)[1]
    if name.startswith("promise:"):
        return span["digest"] if any(c[0] == span["digest"] for c in parse_file(rel, data).get("claims") or ()) else None
    named = [s for s in parse_file(rel, data).get("symbols") or () if s["name"] == name]
    if not named:
        return None
    return min(named, key=lambda s: (s["digest"] != span["digest"], abs(s["start"] - span["start"])))["digest"]


def revalidate(problem, ref=None, tops=None):
    tops = tops or {repo: doc["top"] for repo, doc in load_indexes().items()}
    changed = []
    for span in problem.get("units") or ():
        top = tops.get(span["file"].split("/", 1)[0])
        if not top:
            changed.append("%s: its repository is not indexed" % span["unit"])
            continue
        repo_ref = ref.get(span["file"].split("/", 1)[0]) if isinstance(ref, dict) else ref
        at = repo_ref if repo_ref and git(top, "rev-parse", "--verify", "--quiet", repo_ref + "^{commit}") else None
        if unit_digest_at(top, at, span) != span["digest"]:
            changed.append("%s changed since the judgment" % span["unit"])
    return changed


def send_back(cause, why):
    verdicts = load_verdicts()
    if cause in verdicts:
        verdicts[cause]["digest"] = None
        verdicts[cause]["sent_back"] = {"at": iso_time(now_s()), "why": why}
        write_json(verdicts_path(), verdicts)


def unit_paths(problem):
    tops = {repo: doc["top"] for repo, doc in load_indexes().items()}
    out = []
    for fid in problem.get("files") or ():
        repo, rel = fid.split("/", 1)
        out.append(os.path.join(tops.get(repo) or os.path.join(repos_dir(), repo), rel))
    return out


def night_snapshot(problems, night):
    indexes = load_indexes()
    work = active_work(indexes)
    kept = []
    for problem in problems:
        if problem.get("state") not in COUNTED or problem.get("needs_egor"):
            continue
        if any(f.split("/", 1)[1] in work.get(f.split("/", 1)[0], {}) for f in problem.get("files") or ()):
            continue
        ref = "refs/night/%s/base" % night if night else None
        changed = revalidate(problem, ref, {r: d["top"] for r, d in indexes.items()}) if problem.get("units") else []
        if changed:
            send_back(problem.get("cause") or problem["id"], "; ".join(changed))
            continue
        kept.append(problem)
    kept.sort(key=lambda p: (-(p.get("value") or 0), p["id"]))
    return kept


def symlink_escape(top, rel):
    path = top
    for part in rel.split("/"):
        path = os.path.join(path, part)
        if os.path.islink(path):
            real = os.path.realpath(path)
            if not real.startswith(os.path.realpath(top) + "/"):
                return "%s is a symlink into %s" % (os.path.relpath(path, top), real)
    return None


def files_under(path, limit=20000):
    if not os.path.isdir(path):
        return [path]
    out = []
    for folder, dirs, files in os.walk(path):
        dirs[:] = [d for d in dirs if d != ".git"]
        out += [os.path.join(folder, name) for name in files]
        if len(out) >= limit:
            break
    return out


def symlink_edits(tree, since):
    out = []
    for line in (git(tree, "ls-files", "-s", "-z") or "").split("\0"):
        meta, _, rel = line.partition("\t")
        if not meta.startswith("120000"):
            continue
        real = os.path.realpath(os.path.join(tree, rel))
        if real.startswith(os.path.realpath(tree) + "/") or not os.path.exists(real):
            continue
        top = (git(real if os.path.isdir(real) else os.path.dirname(real), "rev-parse", "--show-toplevel") or "").strip()
        inside = os.path.relpath(real, top) if top else None
        if top and git(top, "ls-files", "-z", "--", inside):
            paths = [os.path.join(top, path) for _, path in porcelain(top, inside)]
        else:
            top, paths = top or real, files_under(real)
        for path in paths:
            try:
                touched = os.path.getmtime(path) >= since
            except OSError:
                touched = True
            if touched:
                out.append("%s: edited through the symlink %s into %s: refused, a change there is that repository's own run"
                           % (path, rel, top))
    return out


EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"


def removed_symbols(tree, base, rel):
    before = git(tree, "show", "%s:%s" % (base, rel))
    try:
        with open(os.path.join(tree, rel), "rb") as handle:
            after = handle.read()
    except OSError:
        return []
    if before is None:
        return []
    names = {}
    for symbol in parse_file(rel, before.encode()).get("symbols") or ():
        names[symbol["name"]] = names.get(symbol["name"], 0) + 1
    for symbol in parse_file(rel, after).get("symbols") or ():
        names[symbol["name"]] = names.get(symbol["name"], 0) - 1
    return sorted(name for name, left in names.items() if left > 0)


def day_trees(record, tops):
    launched = record.get("launched_at") or record.get("created_at")
    out = {}
    for top in tops.values() if launched else ():
        if not git(top, "rev-parse", "--verify", "--quiet", "HEAD"):
            continue
        before = (git(top, "rev-list", "-1", "--before=%s" % launched, "HEAD") or "").strip()
        out[top] = before or EMPTY_TREE
    return out


def check_run(record, base):
    errors = [report_only()] if report_only() else []
    since = iso_epoch(record.get("launched_at")) or iso_epoch(record.get("created_at")) or 0
    indexes = load_indexes()
    tops = {repo: doc["top"] for repo, doc in indexes.items()}
    doc = read_json(os.path.join(state_dir(), "latest.json"), {}) or {}
    problems = {p["id"]: p for p in (record.get("problems") or ())}
    current = {p["id"]: p for p in doc.get("problems") or ()}
    judged = {pid: snap if snap.get("units") else current.get(pid) or snap for pid, snap in problems.items()}
    deleted_ok, unit_ok = {}, {}
    for pid, problem in judged.items():
        for span in problem.get("units") or ():
            deleted_ok.setdefault(span["file"], []).append((pid, problem))
            unit_ok.setdefault(span["unit"], []).append((pid, problem))
    ledger = load_ledger()
    verdicts = load_verdicts()
    work = active_work(indexes, exclude_branch=record.get("branch"))
    candidates = {c["id"]: c for c in load_candidates()}
    graph = Graph(indexes, ledger) if indexes else None
    live, edges = set(), {}
    if graph:
        roots, _ = entry_roots(graph)
        edges = graph.edges()
        live = reachable(graph, edges, set(roots) | {u for u in protected_units(ledger) if u in graph.files})
    hits, _, _, _ = rollup_totals(rollup_days())
    cover = coverage(rollup_days())

    def deletion_proof(label, fid, owners, whole_file):
        for pid, problem in owners:
            verdict = verdicts.get(problem.get("cause") or pid) or {}
            if problem.get("needs_egor"):
                errors.append("%s: %s needs Egor, the fixer never edits it" % (label, pid))
            record_of = graph.files.get(fid) if graph and whole_file else None
            if record_of and record_of.get("kind") == "test":
                covered = [t for t in edges.get(fid, ()) if graph.files[t].get("kind") == "code" and t in live]
                if covered:
                    errors.append("%s: deletion proof: it still tests live code (%s)" % (label, ", ".join(covered[:3])))
            elif whole_file and fid in live:
                errors.append("%s: deletion proof: a live entry point still reaches it" % label)
            key = "hook:" + os.path.basename(fid.split("/", 1)[1])
            if whole_file and hits.get(key):
                errors.append("%s: deletion proof: %d rollup hits since %s" % (label, hits[key], cover.get("start")))
            if not (verdict.get("reason") or "").strip():
                errors.append("%s: deletion proof: the judgment quotes no purpose or retirement reason" % label)
            if len(problem.get("repos") or ()) > 1 and problem.get("group") == "duplicate":
                staged = [m for row in ledger.get("rows") or ()
                          if isinstance(row, dict) and row.get("id") in (pid, problem.get("ledger"))
                          for m in row.get("merges") or ()
                          if isinstance(m, dict) and m.get("stage") == "migrated"
                          and m.get("night") and m.get("night") != record.get("night")]
                if not staged:
                    errors.append("%s: cross-repo merge: the old copy is deleted on a later night, after the new path is proven" % label)

    day = {} if record.get("worktrees") else day_trees(record, tops)
    if not record.get("worktrees") and not (record.get("launched_at") or record.get("created_at")):
        errors.append("the run records no launch time: nothing bounds its changes in the main checkouts")
    tree_of = {}
    for tree in record.get("worktrees") or sorted(day):
        if not os.path.isdir(tree):
            errors.append("%s: the run's worktree is gone, nothing proves its changes: they land through a new Code fixer run" % tree)
            continue
        common = (git(tree, "rev-parse", "--path-format=absolute", "--git-common-dir") or "").strip()
        repo = os.path.basename(os.path.dirname(common)) if common else os.path.basename(os.path.realpath(tree))
        tree_of[repo] = tree
        onto = rebase_onto(tree) if base and tree not in day else None
        tree_base = day.get(tree) or onto or base
        entries = diff_entries(tree, tree_base) if tree_base else []
        if tree not in day:
            entries += porcelain(tree)
            errors += symlink_edits(tree, since)
        for kind, rel in entries:
            escape = symlink_escape(tree, rel)
            if escape:
                errors.append("%s/%s: edit through a cross-repo symlink refused (%s)" % (repo, rel, escape))
                continue
            fid = "%s/%s" % (repo, rel)
            if "D" in kind:
                owners = deleted_ok.get(fid)
                if not owners:
                    errors.append("%s: deleted, but no judged problem of this run names it" % fid)
                else:
                    deletion_proof(fid, fid, owners, True)
                continue
            if not any(span["unit"] == fid for _, problem in deleted_ok.get(fid, ()) for span in problem.get("units") or ()):
                for name in removed_symbols(tree, tree_base or "HEAD", rel):
                    unit = "%s#%s" % (fid, name)
                    owners = unit_ok.get(unit)
                    if not owners:
                        errors.append("%s: deleted, but no judged problem of this run names it" % unit)
                    else:
                        deletion_proof(unit, fid, owners, False)
    for pid, problem in judged.items():
        if not problem.get("units"):
            continue
        changed = revalidate(problem, base, tops) if base else []
        busy = ["%s: %s" % (f, work[f.split("/", 1)[0]][f.split("/", 1)[1]]) for f in problem.get("files") or ()
                if f.split("/", 1)[1] in work.get(f.split("/", 1)[0], {})]
        if busy:
            errors.append("%s: in active work (%s): it waits, its verdict stands" % (pid, ", ".join(busy)))
        elif base:
            changed += [c for c in revalidate(problem, None, tops) if c not in changed]
        if changed:
            send_back(problem.get("cause") or pid, "; ".join(changed))
            errors.append("%s: its input changed since the judgment (%s): sent back to the judge" % (pid, "; ".join(changed)))
        candidate = candidates.get(problem.get("cause") or pid)
        if candidate and candidate.get("evidence_digest") != problem.get("digest") and problem.get("digest"):
            errors.append("%s: its evidence changed since the snapshot: sent back to the judge" % pid)
        fixed = any(isinstance(row, dict) and pid in (row.get("id"), isinstance(row.get("match"), dict) and row["match"].get("cause"))
                    and any(isinstance(fix, dict) and fix.get("by") == record.get("id") for fix in row.get("fixes") or ())
                    for row in ledger.get("rows") or ())
        if fixed and record.get("id") and all(
                unit_digest_at(tree_of.get(span["file"].split("/", 1)[0]) or tops.get(span["file"].split("/", 1)[0]) or "",
                               None, span) == span["digest"] for span in problem["units"]):
            errors.append("%s: recorded fixed by this run, but the re-check reads every unit as judged" % pid)
    return errors




def record_fix(cause, by, files, lines_removed, suite_s, tokens_cut, mechanism, canonical, replaced):
    ledger = load_ledger()
    rows = ledger.setdefault("rows", [])
    candidates = {c["id"]: c for c in load_candidates()}
    candidate = candidates.get(cause) or {}
    row = next((r for r in rows if isinstance(r, dict) and (r.get("id") == cause or isinstance(r.get("match"), dict)
                                                           and r["match"].get("cause") == cause)), None)
    if not row:
        row = {"id": cause, "title": clip(candidate.get("detail") or cause, 160), "match": {"cause": cause},
               "group": candidate.get("group"), "status": "open", "fixes": [], "same_cause": [], "last_reviewed": None,
               "reviewed_by": None, "note": None, "handoff": None}
        rows.append(row)
    if not isinstance(row.get("match"), dict):
        row["match"] = {"cause": cause}
    if candidate:
        row["match"]["identity"] = identity_of(candidate, load_indexes())
    row["status"] = "fixed-pending"
    row.setdefault("fixes", []).append({"at": iso_time(now_s()), "by": by, "files": files, "in": None, "regressed_at": None,
                                        "yield": {"lines_removed": lines_removed, "suite_s_saved": suite_s, "tokens_cut": tokens_cut}})
    write_json(ledger_path(), ledger)
    if mechanism and canonical:
        registry = read_json(mechanisms_path(), {}) or {}
        entries = registry.setdefault("mechanisms", [])
        entries[:] = [e for e in entries if not (isinstance(e, dict) and e.get("mechanism") == mechanism)]
        entries.append({"mechanism": mechanism, "canonical": canonical, "replaced": replaced, "cause": cause,
                        "at": iso_time(now_s())})
        registry.setdefault("about", "Canonical modules recorded by landed Code doctor cleanups; review-bench's fit lens reads it.")
        write_json(mechanisms_path(), registry)
    return row




def doc_or_error(started):
    try:
        return document(started)
    except Exception as error:
        now = now_s()
        return {"contract": 1, "doctor": "code", "as_of": iso_time(now), "as_of_s": int(now), "judge": None,
                "status": "error", "problem_count": 0, "groups": {g: 0 for g in GROUPS}, "problems": [],
                "blind_spots": [], "blind": [],
                "self": {"collector_s": round(time.time() - started, 3),
                         "error": clip("%s: %s" % (type(error).__name__, error), 200)}}


def main(argv=None):
    parser = argparse.ArgumentParser(prog="code-doctor", description=__doc__.split("\n")[0])
    parser.add_argument("--json", action="store_true", help="print the document and write nothing")
    parser.add_argument("--quiet", action="store_true", help="print nothing")
    sub = parser.add_subparsers(dest="command")
    scoped = argparse.ArgumentParser(add_help=False)
    scoped.add_argument("--repo", action="append", default=[], metavar="PATH",
                        help="scope to this repository instead of the sweep repositories (repeatable); state goes to scopes/<slug>/")
    sub.add_parser("index", parents=[scoped], help="index the sweep repositories incrementally (working tree included)")
    sub.add_parser("rollup", parents=[scoped], help="roll the harness journals up into durable daily hit counts")
    sub.add_parser("candidates", parents=[scoped], help="recompute candidates.jsonl from the index and the rollup")
    refresh = sub.add_parser("refresh", parents=[scoped], help="index, rollup, candidates, then the document (night start, menu Refresh)")
    refresh.add_argument("--quiet", action="store_true", dest="refresh_quiet")
    judge = sub.add_parser("judge", parents=[scoped], help="judge waiting candidates through worker-run under the night's budget")
    judge.add_argument("--night")
    judge.add_argument("--max-tokens", type=int, default=BUDGET["tokens"])
    judge.add_argument("--max-wall", type=float, default=BUDGET["wall_s"])
    judge.add_argument("--vendor", default=os.environ.get("CODE_DOCTOR_JUDGE_VENDOR") or "claudeb")
    judge.add_argument("--limit", type=int)
    judge.add_argument("--batch", type=int, default=JUDGE_BATCH, help="candidates per worker session")
    critical = sub.add_parser("critical", parents=[scoped],
                              help="judge which unjudged review-debt paths are critical, through worker-run under a budget")
    critical.add_argument("--night")
    critical.add_argument("--max-tokens", type=int, default=BUDGET["tokens"])
    critical.add_argument("--max-wall", type=float, default=BUDGET["wall_s"])
    critical.add_argument("--vendor", default=os.environ.get("CODE_DOCTOR_JUDGE_VENDOR") or "claudeb")
    critical.add_argument("--batch", type=int, default=JUDGE_BATCH, help="paths per worker session")
    check = sub.add_parser("check", parents=[scoped], help="the fixer's safety gate over a doctor-fix run record")
    check.add_argument("record")
    check.add_argument("--base")
    snap = sub.add_parser("snapshot", parents=[scoped], help="internal: the problems a fixer run takes, top-K by value, revalidated")
    snap.add_argument("doc")
    snap.add_argument("--night")
    fix = sub.add_parser("record-fix", help="the fixer records a landed cleanup: ledger row and canonical mechanism")
    fix.add_argument("cause")
    fix.add_argument("--by", required=True)
    fix.add_argument("--files", nargs="+", required=True)
    fix.add_argument("--lines-removed", type=int, default=0)
    fix.add_argument("--suite-s-saved", type=int, default=0)
    fix.add_argument("--tokens-cut", type=int, default=0)
    fix.add_argument("--mechanism")
    fix.add_argument("--canonical")
    fix.add_argument("--replaced", nargs="*", default=[])
    acct = sub.add_parser("account", help="record a cost the doctor did not see (fix, review, tests, retries)")
    acct.add_argument("--cause", required=True)
    acct.add_argument("--stage", required=True, choices=("fix", "review", "tests", "retries"))
    acct.add_argument("--tokens", type=int, default=0)
    acct.add_argument("--wall", type=float, default=0)
    acct.add_argument("--night")
    args = parser.parse_args(argv)
    started = time.time()
    set_scope(getattr(args, "repo", None))

    if args.command == "index":
        for row in run_index():
            print("%(repo)s: %(files)d files · %(parsed)d parsed · %(reused)d reused · snapshot %(snapshot)s" % row)
        return 0
    if args.command == "rollup":
        print("rollup: %d day-sources written%s" % (run_rollup(), " (no runtime journal outside the sweep repositories)"
                                                     if foreign_repos() else ""))
        return 0
    if args.command == "candidates":
        candidates = build_candidates()
        if candidates is None:
            print("code-doctor: no index yet, run code-doctor index", file=sys.stderr)
            return 1
        print("candidates: %d (%s)" % (len(candidates), ", ".join("%s %d" % (g, sum(1 for c in candidates if c["group"] == g)) for g in GROUPS)))
        return 0
    if args.command == "refresh":
        run_index()
        run_rollup()
        build_candidates()
        doc = doc_or_error(started)
        write_document(doc)
        if not (args.quiet or args.refresh_quiet):
            print(view(doc) if doc["status"] != "error" else "Code doctor: error · %s" % doc["self"]["error"])
        return 0 if doc["status"] != "error" else 1
    if args.command == "judge":
        record = run_judge(args.night, args.max_tokens, args.max_wall, args.vendor, args.limit, args.batch)
        if args.night and not args.repo:
            for line in settle_registrations(args.night):
                print("registration: " + line)
        write_document(doc_or_error(started))
        print("judge: %(judged)d judged · %(pending)d waiting · %(tokens)d tokens · %(wall_s)ss · stop %(stop)s" % record)
        return 0
    if args.command == "critical":
        record = run_critical(args.night, args.max_tokens, args.max_wall, args.vendor, args.batch)
        print("critical: %(judged)d judged · %(pending)d waiting · %(tokens)d tokens · %(wall_s)ss · stop %(stop)s" % record)
        if record["error"]:
            print("critical: " + record["error"], file=sys.stderr)
        return 0 if record["stop"] not in ("launch-failed", "list-failed", "record-failed") else 1
    if args.command == "check":
        record = read_json(args.record, {}) or {}
        errors = check_run(record, args.base)
        for line in errors:
            print(line)
        return 1 if errors else 0
    if args.command == "snapshot":
        doc = read_json(args.doc, {}) or {}
        if report_only(doc):
            print("[]")
            return 0
        kept = night_snapshot(doc.get("problems") or [], args.night)
        print(json.dumps(kept[: queue_k(accounting_summary(load_ledger()))]))
        return 0
    if args.command == "record-fix":
        row = record_fix(args.cause, args.by, args.files, args.lines_removed, args.suite_s_saved, args.tokens_cut,
                         args.mechanism, args.canonical, args.replaced)
        print("%s: fixed-pending" % row["id"])
        return 0
    if args.command == "account":
        account(args.night, args.cause, args.stage, tokens=args.tokens, wall_s=args.wall)
        return 0

    doc = doc_or_error(started)
    if args.json:
        print(json.dumps(doc, ensure_ascii=False, indent=1))
        return 0 if doc["status"] != "error" else 1
    write_document(doc)
    if not args.quiet:
        print(view(doc) if doc["status"] != "error" else "Code doctor: error · %s" % doc["self"]["error"])
    return 0 if doc["status"] != "error" else 1


COLLECTOR_COMMANDS = (None, "index", "rollup", "candidates", "refresh", "judge", "critical")

if __name__ == "__main__":
    started = time.time()
    command = next((word for word in sys.argv[1:] if not word.startswith("-")), None)
    code = main()
    if command in COLLECTOR_COMMANDS:
        collector_runs.record("code", started, command)
    sys.exit(code)

#!/bin/bash
# One Sidecar/Continuity presence sample. Run from launchd (com.egor.sidecar-presence)
# every 5 min, replacing the old in-Hammerspoon hs.timer loop whose hs.task objects
# accumulated and made hs.reload GC spin.
set -u

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

SIDECAR="$HOME/.local/bin/sidecar"
LOG="$HOME/.hammerspoon/sidecar_presence.log"
STATE="$HOME/.hammerspoon/sidecar_presence.state"
MAXLINES=5000
KEEPLINES=2000

ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)

refresh_capped() {
    local out_file
    out_file=$(mktemp)
    "$SIDECAR" refresh >"$out_file" 2>/dev/null &
    local rpid=$!
    ( sleep 15; kill "$rpid" 2>/dev/null ) &
    local kpid=$!
    wait "$rpid" 2>/dev/null
    kill "$kpid" 2>/dev/null
    cat "$out_file"
    rm -f "$out_file"
}

list_out=$("$SIDECAR" list 2>/dev/null)
ipad_in_list=no
iphone_in_list=no
printf '%s\n' "$list_out" | grep -qi ipad && ipad_in_list=yes
printf '%s\n' "$list_out" | grep -qi iphone && iphone_in_list=yes

if [ "$ipad_in_list" = yes ]; then
    ipad=yes
    iphone=$iphone_in_list
else
    refresh_out=$(refresh_capped)
    ipad_in_refresh=no
    iphone_in_refresh=no
    printf '%s\n' "$refresh_out" | grep -qi ipad && ipad_in_refresh=yes
    printf '%s\n' "$refresh_out" | grep -qi iphone && iphone_in_refresh=yes
    if [ "$ipad_in_refresh" = yes ]; then ipad=refresh-only; else ipad=no; fi
    if [ "$iphone_in_list" = yes ] || [ "$iphone_in_refresh" = yes ]; then iphone=yes; else iphone=no; fi
fi

jump=n/a
sidecar_display=n/a
ipad_present=n/a
if command -v hs >/dev/null 2>&1; then
    ctx=$(hs -c 'local function rs(m,f) if _G[m] and type(_G[m][f])=="function" then local ok,v=pcall(_G[m][f]); if ok and v~=nil then return tostring(v) end end return "n/a" end; print(rs("IpadMode","getJumpConnected").."|"..rs("IpadTrigger","getSidecarActive").."|"..rs("IpadMode","isOn"))' 2>/dev/null | tail -1)
    if [ -n "$ctx" ]; then
        jump=${ctx%%|*}
        rest=${ctx#*|}
        sidecar_display=${rest%%|*}
        ipad_present=${rest#*|}
    fi
fi

wifi_dev=$(networksetup -listallhardwareports 2>/dev/null | awk '/Wi-Fi/{getline; print $2}')
ssid=unknown
if [ -n "$wifi_dev" ]; then
    s=$(ipconfig getsummary "$wifi_dev" 2>/dev/null | awk -F' : ' '/ SSID :/{print $2; exit}')
    [ -n "$s" ] && ssid=$s
fi

line="$ts ipad=$ipad iphone=$iphone jump=$jump sidecar_display=$sidecar_display ipad_present=$ipad_present ssid=$ssid"

# Prev state persists in its own file so a TRANSITION is never lost to log truncation or a
# crash that leaves no derivable prior sample. Fall back to the log for the first run after
# this file is introduced; an empty prev means unknown and yields no (fake) transition.
prev=""
if [ -f "$STATE" ]; then
    prev=$(cat "$STATE" 2>/dev/null)
fi
if [ -z "$prev" ]; then
    prev=$(grep -v '^TRANSITION' "$LOG" 2>/dev/null | tail -1 | sed -n 's/.* ipad=\([^ ]*\).*/\1/p')
fi

printf '%s\n' "$line" >> "$LOG"
if [ -n "$prev" ] && [ "$prev" != "$ipad" ]; then
    printf 'TRANSITION: %s -> %s at %s\n' "$prev" "$ipad" "$ts" >> "$LOG"
fi
printf '%s\n' "$ipad" > "$STATE"

lines=$(wc -l < "$LOG" 2>/dev/null | tr -d ' ')
if [ -n "$lines" ] && [ "$lines" -gt "$MAXLINES" ]; then
    tmp=$(mktemp)
    tail -n "$KEEPLINES" "$LOG" > "$tmp" && mv "$tmp" "$LOG"
fi

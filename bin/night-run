#!/usr/bin/env bash
set -u

resolve_script() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")" && printf '%s/%s\n' "$PWD" "$(basename "$source")"
}

script_path=$(resolve_script)
repo_root=$(cd "$(dirname "$script_path")/.." && pwd)
nights_dir="${DOCTORS_DIR:-$HOME/.cache/doctors}/nights"
lock_dir="$nights_dir/.lock"
sweep_repos="${NIGHT_RUN_SWEEP_REPOS:-$HOME/.claude/sweep-repos}"
KINDS=' fixer vendor debt leftover '
STATES=' pending merged left failed-launch blocked-on-egor nothing-to-do '
. "$repo_root/share/chat-open.sh"
. "$repo_root/share/store-lock.sh"
. "$repo_root/share/test-scope.sh"
. "$repo_root/share/night-worktree.sh"

die() { printf 'night-run: %s\n' "$*" >&2; exit 1; }
stamp() { date -u +%Y-%m-%dT%H:%M:%SZ; }

usage() {
  cat >&2 <<'EOF'
usage: night-run start [--cleanup | --resume <id> [--job <ref>]]
       night-run base <id>
       night-run job <id> add <fixer|vendor|debt|leftover> <ref> [--branch B]
       night-run job <id> set <ref> key=value...   (state, reason, branch, review, commits, pushed)
       night-run finish <id>
       night-run leftovers [--json]
       night-run report [<id>]
       night-run latest --menu

start opens the orchestrator chat: --cleanup lands finished night branches and runs the debt round
  only; --resume reopens night <id> under a new orchestrator for its unfinished jobs (one with --job,
  else all plus a cleanup job), the old session kept in previous_sessions
Nights live in ${DOCTORS_DIR:-~/.cache/doctors}/nights/<id>.json.
states: pending merged left failed-launch blocked-on-egor nothing-to-do (left needs reason=)
commits=<repo>:<hash>[,<repo>:<hash>...]  replaces the job's list; <repo> is a sweep-repos
  basename or an absolute path; a changed list clears pushed unless pushed=true comes with it
leftover: ref is a leftover branch, adopted in every sweep repository where it is one: its WIP
  committed, night/<id>/leftover-<slug> made at its tip with its night worktree, the old worktree and
  branch removed; the job's ref becomes leftover-<slug>
leftovers lists every non-main branch and worktree of the sweep repositories: live ones stay, landed
  ones go at finish, every other is a leftover to carry; finish records those under the night's leftovers
pushed=true is refused unless every commit of the job is on its repository's origin main and not
  in the night's refs/night/<id>/base
state=merged with a review is refused while `review-bench fix <review> --print` names open findings:
  the round is fixed through its brief or closed with `review-bench close <review> --nofix`
EOF
  exit 2
}

lock() {
  mkdir -p "$nights_dir" || die "cannot create $nights_dir"
  store_lock_acquire "$lock_dir" || die "the nights lock $lock_dir is held"
  trap 'store_lock_release "$lock_dir"' EXIT
}

unlock() { store_lock_release "$lock_dir"; trap - EXIT; }

night_file() { printf '%s/%s.json\n' "$nights_dir" "$1"; }

night_set() { # id jq-filter args...
  local file tmp filter=$2
  file=$(night_file "$1")
  shift 2
  tmp=$(mktemp "$nights_dir/.night.XXXXXX") || return 1
  jq "$@" "$filter" "$file" >"$tmp" && mv -f "$tmp" "$file" || { rm -f "$tmp"; return 1; }
}

known_night() { # id
  case $1 in */* | '' | .*) die "not a night id: $1" ;; esac
  [ -s "$(night_file "$1")" ] || die "no night $1 under $nights_dir"
}

all_nights() { # -> every night as one JSON array, newest first
  local files=()
  [ -d "$nights_dir" ] && files=("$nights_dir"/*.json)
  [ -e "${files[0]:-}" ] || { printf '[]\n'; return 0; }
  jq -s 'sort_by(.started_at, .id) | reverse' "${files[@]}"
}

doctor_read() { # jq-filter -> {"llm": value|null, "harness": value|null, "updater": value|null} off each latest.json
  local llm harness updater
  llm="${LLM_DOCTOR_DIR:-$HOME/.cache/llm-doctor}/latest.json"
  harness="${HARNESS_DOCTOR_DIR:-$HOME/.cache/harness-doctor}/latest.json"
  updater="${UPDATER_DOCTOR_DIR:-$HOME/.cache/updater-doctor}/latest.json"
  jq -n \
    --argjson ln "$(jq -c "$1" "$llm" 2>/dev/null || echo null)" \
    --argjson hn "$(jq -c "$1" "$harness" 2>/dev/null || echo null)" \
    --argjson un "$(jq -c "$1" "$updater" 2>/dev/null || echo null)" \
    '{llm: $ln, harness: $hn, updater: $un}'
}

doctor_counts() { doctor_read '.problem_count // null'; }

# proved: a fix the doctor proved (harness `fixed · E events since · 0 matched`; the LLM doctor drops a
# proved row instead); pending: a fix awaiting its commit or its proof.
doctor_states() {
  doctor_read '[.problems[]? | (.fact // "") as $f
    | if (.state == "fixed-pending" or .state == "watch") and ($f | test("^fixed · [0-9]+ events since · 0 matched")) then "proved"
      elif .state == "fixed-pending" or .rule == "fix-proof" then "pending" else .state end] as $s
    | reduce ("proved", "pending", "open", "new", "regressed") as $k ({}; .[$k] = ($s | map(select(. == $k)) | length))'
}

main_checkout() {
  local top root
  git_top "$repo_root" && printf '%s\n' "$root" || printf '%s\n' "$repo_root"
}

night_status() { # night-file -> finished, running, or unfinished when its orchestrator chat is gone
  local session
  session=$(jq -r 'if .finished_at != null then "finished" else .session // "opener:\(.opener // 0)" end' "$1")
  case $session in
    finished) printf 'finished\n' ;;
    opener:*)
      if [ "${session#opener:}" != 0 ] && kill -0 "${session#opener:}" 2>/dev/null; then printf 'running\n'
      else printf 'unfinished\n'; fi ;;
    *) if pgrep -f -- "--(session-id|resume) $session" >/dev/null; then printf 'running\n'; else printf 'unfinished\n'; fi ;;
  esac
}

open_nights() { # -> ids of nights whose orchestrator chat still runs
  local id
  all_nights | jq -r '.[] | select(.finished_at == null) | .id' | while IFS= read -r id; do
    [ "$(night_status "$(night_file "$id")")" != running ] || printf '%s\n' "$id"
  done
}

JQ_UNFINISHED='def unfinished: .state == "left" or .state == "pending";'

resume_night() { # id job-ref-or-empty (locked): reopens the night for a new orchestrator, the old session kept
  local id=$1 job=$2 file
  known_night "$id"
  file=$(night_file "$id")
  if [ -n "$job" ]; then
    jq -e --arg r "$job" "$JQ_UNFINISHED"' any(.jobs[]; .ref == $r and unfinished)' "$file" >/dev/null ||
      die "night $id has no unfinished job $job"
  else
    jq -e "$JQ_UNFINISHED"' any(.jobs[]; unfinished)' "$file" >/dev/null || die "night $id has no unfinished job"
  fi
  night_set "$id" "$JQ_UNFINISHED"' .previous_sessions = ((.previous_sessions // []) + [.session | values])
    | .session = null | .opener = $opener | .finished_at = null | .doctors_after = null | .doctor_states_after = null | .note = null
    | .jobs |= map(if unfinished and ($job == "" or .ref == $job) then .state = "pending" else . end)
    | if $job == "" and ([.jobs[] | select(.kind == "debt" and .state == "pending")] | length) == 0
      then .jobs += [{kind: "debt", ref: "debt-\([.jobs[] | select(.kind == "debt")] | length + 1)", state: "pending",
        reason: null, branch: null, review: null, commits: [], pushed: false}] else . end' --arg job "$job" \
    --argjson opener "$$" ||
    die "cannot write night $id"
}

cmd_start() {
  local id open file opened account session scope=all resume='' job='' marker=''
  while [ $# -gt 0 ]; do
    case $1 in
      --cleanup) scope=cleanup; shift ;;
      --resume) [ -n "${2:-}" ] || usage; scope=resume resume=$2; shift 2 ;;
      --job) [ -n "${2:-}" ] || usage; job=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -z "$job" ] || [ -n "$resume" ] || usage
  [ "$scope" = all ] || marker=" $scope"
  lock
  open=$(open_nights | head -1)
  [ -z "$open" ] || die "night $open is still running: its orchestrator chat is open; night-run finish $open closes it."
  if [ -n "$resume" ]; then
    id=$resume
    resume_night "$id" "$job"
  else
    id="$(date -u +%Y%m%dT%H%M%SZ)-$(od -An -N2 -tx1 /dev/urandom | tr -d ' \n')"
    file=$(night_file "$id")
    [ ! -e "$file" ] || die "night id $id is taken"
    jq -n --arg id "$id" --arg t "$(stamp)" --argjson before "$(doctor_counts)" --argjson states "$(doctor_states)" \
      --argjson opener "$$" '{id: $id, started_at: $t, finished_at: null, session: null, account: null, command: null, note: null,
        doctors_before: $before, doctors_after: null, doctor_states_before: $states, doctor_states_after: null, jobs: [],
        opener: $opener}' >"$file.tmp" && mv -f "$file.tmp" "$file" ||
      { rm -f "$file.tmp"; die "cannot write $file"; }
  fi
  unlock
  if ! opened=$(CHAT_OPEN_OPENER="${NIGHT_RUN_OPENER:-open -a Terminal}" \
    CHAT_OPEN_WORKER_PICK="${NIGHT_RUN_WORKER_PICK:-$repo_root/bin/worker-pick}" \
    CHAT_OPEN_PREFIX="caffeinate -i" \
    chat_open "$nights_dir/$id.command" "$(main_checkout)" "сделай чистку — night run $id$marker" 2>&1); then
    lock
    night_set "$id" '.note = $n | .finished_at = $t | del(.opener)' --arg n "orchestrator chat did not open: $opened" --arg t "$(stamp)"
    die "night $id: the orchestrator chat did not open: $opened"
  fi
  read -r account session <<<"$opened"
  lock
  night_set "$id" '.session = $s | .account = $a | .command = $c | del(.opener)' \
    --arg s "$session" --arg a "$account" --arg c "$nights_dir/$id.command" || die "cannot write night $id"
  printf 'night %s %s: orchestrator on %s\n' "$id" "$([ -n "$resume" ] && echo resumed || echo started)" "$account"
}

repo_dir() { # name-or-path -> repository directory
  local line
  case $1 in /*) printf '%s\n' "$1"; return 0 ;; esac
  [ -r "$sweep_repos" ] || return 1
  while IFS= read -r line; do
    [ -n "$line" ] && [ "$(basename "$line")" = "$1" ] && { printf '%s\n' "$line"; return 0; }
  done <"$sweep_repos"
  return 1
}

review_refusal() { # ref round -> why the merged job's review round blocks it, empty when it is settled
  local open err
  err=$(mktemp) || { printf 'cannot ask review-bench about round %s\n' "$2"; return; }
  open=$(review-bench fix "$2" --print 2>"$err") || {
    printf 'job %s: review round %s cannot be read: %s\n' "$1" "$2" "$(tr '\n' ' ' <"$err")"; rm -f "$err"; return; }
  rm -f "$err"
  [ -z "$open" ] || printf "job %s cannot be merged while its review round %s has open findings: fix them (review-bench fix %s --brief <file>, its worker RESUMEd on that brief) or close the round (review-bench close %s --nofix --reason '<why>')\n" \
    "$1" "$2" "$2" "$2"
}

push_refusal() { # dir hash night -> why hash is no pushed night commit, empty when it is one
  local main
  git -C "$1" cat-file -e "$2^{commit}" 2>/dev/null || { printf 'commit %s is not in %s\n' "$2" "$1"; return; }
  main=$(git -C "$1" ls-remote origin refs/heads/main 2>/dev/null | cut -f1)
  [ -z "$main" ] || git -C "$1" cat-file -e "$main^{commit}" 2>/dev/null || git -C "$1" fetch -q origin refs/heads/main 2>/dev/null
  [ -n "$main" ] && git -C "$1" merge-base --is-ancestor "$2" "$main" 2>/dev/null ||
    { printf 'commit %s is not on origin main of %s: push it first\n' "$2" "$1"; return; }
  git -C "$1" rev-parse -q --verify "refs/night/$3/base^{commit}" >/dev/null ||
    { printf '%s has no refs/night/%s/base to tell a night commit by\n' "$1" "$3"; return; }
  ! git -C "$1" merge-base --is-ancestor "$2" "refs/night/$3/base" ||
    printf 'commit %s is already in refs/night/%s/base of %s: no commit of this night\n' "$2" "$3" "$1"
}

SNAPSHOT_MAX_BYTES=$((5 * 1024 * 1024))

tree_commit() { # dir message what -> commit on HEAD of the checkout as it stands, uncommitted and untracked included
  local dir index tree commit meta path sha status size reason drops=()
  dir=$(mktemp -d) || return 1
  index=$dir/index
  GIT_INDEX_FILE=$index git -C "$1" read-tree HEAD &&
    GIT_INDEX_FILE=$index git -C "$1" add -A . || { rm -rf "$dir"; return 1; }
  while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
    read -r _ _ _ sha status <<<"$meta"
    [ "$status" != D ] || continue
    reason=''
    if [ "$status" = A ]; then
      case ${path##*/} in .env | *.pem | *.key | id_*) reason='an untracked secret name' ;; esac
    fi
    if [ -z "$reason" ]; then
      size=$(git -C "$1" cat-file -s "$sha" 2>/dev/null) || size=0
      [ "$size" -le "$SNAPSHOT_MAX_BYTES" ] || reason="a $((size / 1048576)) MB blob"
    fi
    [ -n "$reason" ] || continue
    drops+=("$path")
    printf 'night-run: %s of %s drops %s: %s\n' "$3" "$1" "$path" "$reason" >&2
  done < <(GIT_INDEX_FILE=$index git -C "$1" diff-index -z --cached HEAD)
  [ ${#drops[@]} -eq 0 ] || GIT_INDEX_FILE=$index git --literal-pathspecs -C "$1" reset -q HEAD -- "${drops[@]}" ||
    { rm -rf "$dir"; return 1; }
  tree=$(GIT_INDEX_FILE=$index git -C "$1" write-tree) &&
    commit=$(git -C "$1" -c user.name=night-run -c user.email=night-run@localhost commit-tree "$tree" -p HEAD -m "$2") &&
    printf '%s\n' "$commit"
  local rc=$?
  rm -rf "$dir"
  return "$rc"
}

snapshot() { # dir id -> refs/night/<id>/base: the checkout as it stands
  local commit
  commit=$(tree_commit "$1" "night $2 base: the checkout as pressed" 'the base') &&
    git -C "$1" update-ref "refs/night/$2/base" "$commit" && printf '%s\n' "$commit"
}

# Night worktrees start from refs/night/<id>/base, not HEAD: main carries days of uncommitted work
# (the doctors themselves among it), and a branch from HEAD would fix code that no longer exists.
cmd_base() {
  local id=$1 line commit bases='{}'
  known_night "$id" || die "no night $id"
  [ -r "$sweep_repos" ] || die "cannot read $sweep_repos"
  while IFS= read -r line; do
    [ -n "$line" ] && [ -d "$line" ] || continue
    commit=$(snapshot "$line" "$id") || die "cannot snapshot $line"
    bases=$(jq -c --arg r "$(basename "$line")" --arg c "$commit" '. + {($r): $c}' <<<"$bases")
    printf '%s\t%s\n' "$(basename "$line")" "$commit"
  done <"$sweep_repos"
  lock
  night_set "$id" '.bases = $b' --argjson b "$bases" || die "cannot write night $id"
}

# A leftover moves into the night's own namespace, where the review-flow gate lets workers commit:
# night/<id>/leftover-<slug> at its tip, its WIP committed first, in every sweep repository where the
# branch is a leftover; the old worktree and branch go once the night branch holds every commit.
adopt_leftover() { # id branch -> sets branch and adopted (JSON)
  local id=$1 old=$2 rows row repo br wt landed ahead behind dirty state why tip wip path
  branch="night/$id/leftover-${old//\//-}" adopted='[]'
  rows=$(branch_rows | awk -F '\t' -v b="$old" '$2 == b')
  [ -n "$rows" ] || die "no branch $old in the sweep repositories besides main"
  row=$(awk -F '\t' '$8 == "live"' <<<"$rows" | head -1)
  [ -z "$row" ] || die "$old is live in $(basename "${row%%$'\t'*}"): $(cut -f9 <<<"$row")"
  rows=$(awk -F '\t' '$8 == "leftover"' <<<"$rows")
  [ -n "$rows" ] || die "$old is no leftover: landed, finish prunes it"
  jq -e --arg r "${branch##*/}" 'any(.jobs[]; .ref == $r)' "$(night_file "$id")" >/dev/null &&
    die "night $id already has job ${branch##*/}"
  while IFS=$'\t' read -r repo _ _ _ _ _ _ _ _; do
    git -C "$repo" rev-parse -q --verify "refs/night/$id/base^{commit}" >/dev/null ||
      die "no refs/night/$id/base in $repo: run night-run base $id first"
    ! git -C "$repo" show-ref --verify --quiet "refs/heads/$branch" || die "$branch already exists in $repo"
  done <<<"$rows"
  while IFS=$'\t' read -r repo br wt landed ahead behind dirty state why; do
    tip=$(git -C "$repo" rev-parse "refs/heads/$old")
    if [ "$dirty" != 0 ]; then
      wip=$(tree_commit "$wt" "Leftover WIP from $old, adopted by night $id" 'the WIP commit') &&
        git -C "$wt" update-ref "refs/heads/$old" "$wip" "$tip" && git -C "$wt" reset -q &&
        tip=$wip || die "cannot commit the WIP of $wt"
    fi
    path="$repo/.claude/worktrees/night-$id-${branch##*/}"
    git -C "$repo" branch -q "$branch" "$tip" && night_worktree_add "$repo" "$id" "$branch" "$path" ||
      die "cannot make $branch in $repo"
    adopted=$(jq -c --arg r "$repo" --arg b "$old" --arg w "$wt" --arg t "$tip" --arg p "$path" \
      '. + [{repo: $r, branch: $b, worktree: (if $w == "-" then null else $w end), tip: $t, night_worktree: $p}]' <<<"$adopted")
    if { [ "$wt" = - ] || git -C "$repo" worktree remove "$wt"; } && git -C "$repo" branch -q -D "$old"; then
      printf 'adopted %s %s into %s at %s\n' "$(basename "$repo")" "$old" "$branch" "$path"
    else
      printf 'adopted %s %s into %s at %s; the old one stays, git refused its removal\n' "$(basename "$repo")" "$old" "$branch" "$path"
    fi
  done <<<"$rows"
}

cmd_job() {
  local id=${1:-} verb=${2:-} kind ref branch='' adopted=''
  [ -n "$id" ] || usage
  known_night "$id"
  case $verb in
    add)
      kind=${3:-} ref=${4:-}
      [[ "$KINDS" == *" $kind "* ]] && [ -n "$ref" ] || usage
      shift 4
      while [ $# -gt 0 ]; do
        case $1 in
          --branch) [ -n "${2:-}" ] || usage; branch=$2; shift 2 ;;
          *) usage ;;
        esac
      done
      if [ "$kind" = leftover ]; then
        [ -z "$branch" ] || usage
        adopt_leftover "$id" "$ref"
        ref=${branch##*/}
      fi
      lock
      jq -e --arg r "$ref" 'any(.jobs[]; .ref == $r)' "$(night_file "$id")" >/dev/null &&
        die "night $id already has job $ref"
      night_set "$id" '.jobs += [{kind: $k, ref: $r, state: "pending", reason: null,
        branch: (if $b == "" then null else $b end), review: null, commits: [], pushed: false}
        + (if $a == null then {} else {adopted: $a} end)]' \
        --arg k "$kind" --arg r "$ref" --arg b "$branch" --argjson a "${adopted:-null}" || die "cannot write night $id"
      printf 'night %s: job %s %s added\n' "$id" "$kind" "$ref" ;;
    set) shift 2; job_set "$id" "$@" ;;
    *) usage ;;
  esac
}

job_of() { # night-file ref patch -> the job with patch applied, empty when there is none
  jq -c --arg r "$2" --argjson p "$3" 'first(.jobs[] | select(.ref == $r)) + $p' "$1"
}

job_set() { # id ref key=value...
  local id=$1 ref=${2:-} pair key value patch='{}' item repo hash dir commits_set=false pushed=''
  [ -n "$ref" ] && [ $# -ge 3 ] || usage
  shift 2
  for pair in "$@"; do
    [[ "$pair" == *=* ]] || usage
    key=${pair%%=*} value=${pair#*=}
    case $key in
      state) [[ "$STATES" == *" $value "* ]] || die "state $value is none of:$STATES"
        patch=$(jq -c --arg v "$value" '.state = $v' <<<"$patch") ;;
      reason | branch | review) patch=$(jq -c --arg k "$key" --arg v "$value" '.[$k] = (if $v == "" then null else $v end)' <<<"$patch") ;;
      commits) commits_set=true
        patch=$(jq -c --arg v "$value" '.commits = [$v | splits(",") | select(. != "")
          | capture("^(?<repo>.+):(?<hash>[0-9a-f]{7,40})$") // error("not <repo>:<hash>: \(.)")]' <<<"$patch" 2>/dev/null) ||
          die "commits takes <repo>:<hash>[,<repo>:<hash>...], not $value" ;;
      pushed) case $value in true | false) pushed=$value ;; *) die "pushed takes true or false, not $value" ;; esac
        patch=$(jq -c --argjson v "$value" '.pushed = $v' <<<"$patch") ;;
      *) die "no job key $key: state, reason, branch, review, commits or pushed" ;;
    esac
  done
  local file job checked='' refusal='' round
  file=$(night_file "$id")
  if [ "$pushed" = true ]; then
    job=$(job_of "$file" "$ref" "$patch")
    [ -n "$job" ] || die "night $id has no job $ref"
    checked=$(jq -c '.commits' <<<"$job")
    [ "$checked" != '[]' ] || die "pushed=true needs the job's commits first"
    while IFS=$'\t' read -r repo hash; do
      dir=$(repo_dir "$repo") || die "no repository $repo: not an absolute path nor a basename in $sweep_repos"
      refusal=$(push_refusal "$dir" "$hash" "$id")
      [ -z "$refusal" ] || die "$refusal"
    done < <(jq -r '.commits[] | [.repo, .hash] | @tsv' <<<"$job")
  fi
  if jq -e 'has("state") or has("review")' <<<"$patch" >/dev/null; then
    job=$(job_of "$file" "$ref" "$patch")
    [ -n "$job" ] || die "night $id has no job $ref"
    round=$(jq -r 'select(.state == "merged") | .review // empty' <<<"$job")
    [ -z "$round" ] || refusal=$(review_refusal "$ref" "$round")
    [ -z "$refusal" ] || die "$refusal"
  fi
  lock
  job=$(job_of "$file" "$ref" "$patch")
  [ -n "$job" ] || die "night $id has no job $ref"
  if $commits_set && [ -z "$pushed" ] &&
    [ "$(jq -c --arg r "$ref" 'first(.jobs[] | select(.ref == $r)) | .commits' "$file")" != "$(jq -c '.commits' <<<"$job")" ]; then
    patch=$(jq -c '.pushed = false' <<<"$patch")
    job=$(jq -c '.pushed = false' <<<"$job")
  fi
  [ "$(jq -r '.state' <<<"$job")" != left ] || [ "$(jq -r '.reason // ""' <<<"$job")" != "" ] ||
    die "state left needs reason=<why it stayed>"
  [ "$pushed" != true ] || [ "$(jq -c '.commits' <<<"$job")" = "$checked" ] ||
    die "the job's commits changed while origin was checked: set pushed=true again"
  night_set "$id" '.jobs |= map(if .ref == $r then . + $p else . end)' --arg r "$ref" --argjson p "$patch" ||
    die "cannot write night $id"
  printf 'night %s: job %s %s\n' "$id" "$ref" "$(jq -r '[.state, (if .pushed then "pushed" else empty end)] | join(" ")' <<<"$job")"
}

cmd_finish() {
  local id=${1:-} pruned
  [ -n "$id" ] && [ $# -eq 1 ] || usage
  known_night "$id"
  lock
  jq -e '.finished_at == null' "$(night_file "$id")" >/dev/null || die "night $id is already finished"
  night_set "$id" '.finished_at = $t | .doctors_after = $after | .doctor_states_after = $states
    | .jobs |= map(if .state == "pending" then .state = "left" | .reason = "no outcome recorded by the close" else . end)' \
    --arg t "$(stamp)" --argjson after "$(doctor_counts)" --argjson states "$(doctor_states)" || die "cannot write night $id"
  unlock
  printf 'night %s finished\n' "$id"
  pruned=$(prune_landed)
  [ -z "$pruned" ] || printf '%s\n' "$pruned"
  lock
  night_set "$id" '.leftovers = [$p | split("\n")[] | capture("^leftover (?<repo>[^ ]+) (?<branch>[^:]+): (?<why>.*)$")]' \
    --arg p "$pruned" || die "cannot write night $id"
}

# A chat at work moves its branch (create, commit and rebase each write the reflog) or leaves files dirty:
# their newest time marks a non-night branch live, without walking the tree or reading `git status`'s
# own index refresh.
LIVE_S=$((6 * 3600))

branch_row() { # repo worktree-or-empty branch-or-empty main-checkout(0|1) locked(0|1) cwds now -> TSV row
  local repo=$1 wt=$2 branch=$3 ref head behind ahead landed=false dirty=0 night='' why='' state=live newest t
  ref=${branch:+refs/heads/$branch}
  head=$(git -C "${wt:-$repo}" rev-parse -q --verify "${ref:-HEAD}^{commit}") || return 0
  read -r behind ahead < <(git -C "$repo" rev-list --left-right --count "refs/heads/main...$head")
  [[ $branch == night/*/* ]] && night=${branch#night/} && night=${night%%/*}
  if git -C "$repo" merge-base --is-ancestor "$head" refs/heads/main; then landed=true
  elif [ -n "$night" ] && [ "$head" = "$(git -C "$repo" rev-parse -q --verify "refs/night/$night/base")" ]; then landed=true; fi
  [ -z "$wt" ] || dirty=$(GIT_OPTIONAL_LOCKS=0 git -C "$wt" status --porcelain --untracked-files=all 2>/dev/null | wc -l | tr -d ' ')
  if [ "$4" = 1 ]; then why='main checkout'
  elif [ "$5" = 1 ]; then why='locked'
  elif [ -n "$wt" ] && grep -qxE "$(printf '%s' "$wt" | sed 's/[][\.*^$+?(){}|]/\\&/g')(/.*)?" <<<"$6"; then why='a process inside'
  elif [ -n "$night" ]; then
    [ ! -s "$(night_file "$night")" ] || [ "$(night_status "$(night_file "$night")" 2>/dev/null)" != running ] || why="night $night running"
  else
    newest=$(git -C "${wt:-$repo}" log -g -1 --date=unix --format=%gd "${ref:-HEAD}" 2>/dev/null)
    newest=${newest##*@\{} newest=${newest%\}}
    [[ $newest =~ ^[0-9]+$ ]] || newest=0
    if [ "$dirty" != 0 ]; then
      t=$(cd "$wt" && { git ls-files -z -m -o --exclude-standard; git diff -z --cached --name-only; } |
        xargs -0 stat -f %m 2>/dev/null | sort -n | tail -1)
      [ "${t:-0}" -le "$newest" ] || newest=$t
    fi
    [ $(($7 - newest)) -ge "$LIVE_S" ] || why="active $((($7 - newest) / 60))m ago"
  fi
  if [ -z "$why" ]; then
    state=landed
    $landed || { state=leftover why="$ahead unlanded commits"; }
    [ "$dirty" = 0 ] || { state=leftover why="${why:+$why, }$dirty uncommitted files"; }
    [ "$state" = landed ] || [ -n "$branch" ] || why="$why, detached HEAD"
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$repo" "${branch:--}" "${wt:--}" "$landed" "$ahead" "$behind" "$dirty" "$state" "$why"
}

# Every non-main branch and worktree of the sweep repositories, every night's included: repo branch|-
# worktree|- landed ahead behind dirty live|landed|leftover why. Landed = in main, or a night branch still
# at its night's base, since a nothing-to-do job never committed. `-`, not an empty field: a tab is IFS
# whitespace, so read would shift every field after an empty one.
branch_rows() {
  local repo line wt branch main locked cwds now seen
  [ -r "$sweep_repos" ] || return 0
  cwds=$(lsof -a -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')
  now=$(date +%s)
  while IFS= read -r repo; do
    [ -n "$repo" ] && [ -d "$repo" ] || continue
    git -C "$repo" rev-parse -q --verify refs/heads/main >/dev/null || continue
    wt='' branch='' main=1 locked=0 seen=' main '
    while IFS= read -r line; do
      case $line in
        "worktree "*) wt=${line#worktree } branch='' locked=0 ;;
        "branch refs/heads/"*) branch=${line#branch refs/heads/} ;;
        locked | "locked "*) locked=1 ;;
        '')
          [ -z "$wt" ] || [ "$branch" = main ] || [ ! -d "$wt" ] ||
            { seen="$seen$branch "; branch_row "$repo" "$wt" "$branch" "$main" "$locked" "$cwds" "$now"; }
          wt='' main=0 ;;
      esac
    done < <(git -C "$repo" worktree list --porcelain; echo)
    while IFS= read -r branch; do
      [[ "$seen" == *" $branch "* ]] || branch_row "$repo" '' "$branch" 0 0 "$cwds" "$now"
    done < <(git -C "$repo" for-each-ref --format='%(refname:short)' refs/heads)
  done <"$sweep_repos"
}

cmd_leftovers() {
  case ${1:-} in
    '') branch_rows | awk -F '\t' '{ n = split($1, p, "/")
      printf "%s %s · %s · %s · +%s/-%s main · %s dirty · %s%s\n", p[n], ($2 == "-" ? "(detached)" : $2),
        ($3 == "-" ? "no worktree" : $3), ($4 == "true" ? "landed" : "unlanded"), $5, $6, $7, $8, ($9 == "" ? "" : " (" $9 ")") }' ;;
    --json) branch_rows | jq -Rsc '[split("\n")[] | select(. != "") | split("\t")
      | {repo: .[0], branch: (if .[1] == "-" then null else .[1] end), worktree: (if .[2] == "-" then null else .[2] end),
         landed: (.[3] == "true"), ahead: (.[4] | tonumber), behind: (.[5] | tonumber), dirty: (.[6] | tonumber),
         live: (.[7] == "live"), state: .[7], why: (if .[8] == "" then null else .[8] end)}]' ;;
    *) usage ;;
  esac
}

prune_landed() {
  local repo branch wt landed ahead behind dirty state why name
  while IFS=$'\t' read -r repo branch wt landed ahead behind dirty state why; do
    [ "$branch" != - ] && name="$(basename "$repo") $branch" || name="$(basename "$repo") $wt"
    case $state in
      live | leftover) printf '%s %s: %s\n' "$state" "$name" "$why" ;;
      landed)
        { [ "$wt" = - ] || git -C "$repo" worktree remove "$wt"; } &&
          { [ "$branch" = - ] || git -C "$repo" branch -q -D "$branch"; } && printf 'pruned %s\n' "$name" ;;
    esac
  done < <(branch_rows)
}

JQ_TOTALS='def totals: [.jobs[] | .state] as $s
  | {merged: ($s | map(select(. == "merged")) | length), left: ($s | map(select(. == "left")) | length),
     failed: ($s | map(select(. == "failed-launch")) | length),
     blocked: ($s | map(select(. == "blocked-on-egor")) | length),
     nothing: ($s | map(select(. == "nothing-to-do")) | length),
     pending: ($s | map(select(. == "pending")) | length),
     unpushed: ([.jobs[] | select(.state == "merged" and .pushed != true)] | length),
     unfinished: ($status == "unfinished"), running: ($status == "running")};
def hm: if . == null then "-" else fromdateiso8601 | strflocaltime("%H:%M") end;
def doctor_lines: . as $n | ["llm", "harness", "updater"][] as $d
  | "\($d) \($n.doctors_before[$d] // "-") → \(if $n.doctors_after then ($n.doctors_after[$d] // "-") else "?" end)"
    + ($n.doctor_states_after[$d]? // null | if . then " · proved \(.proved) · pending \(.pending) · new \(.new) · regressed \(.regressed)"
       else "" end);
def count(n; word): if n > 0 then "\(n) \(word)" else empty end;'

pick_night() { # [id] -> night file
  local id=${1:-}
  if [ -z "$id" ]; then
    id=$(all_nights | jq -r '.[0].id // empty')
    [ -n "$id" ] || die "no night under $nights_dir"
  fi
  known_night "$id"
  night_file "$id"
}

code_lines() { # night-file -> {"<ref>": [added, removed], or null when a commit cannot be read}
  local ref repo hash dir
  jq -r '.jobs[] | .ref as $r | .commits[] | [$r, .repo, .hash] | @tsv' "$1" |
    while IFS=$'\t' read -r ref repo hash; do
      if dir=$(repo_dir "$repo") && git -C "$dir" cat-file -e "$hash^{commit}" 2>/dev/null; then
        git -C "$dir" diff --numstat "$hash^" "$hash" -- . ':(glob,exclude)**/tests/**' ':(glob,exclude)**/test_*' |
          awk -v r="$ref" -F '\t' '{ if ($1 != "-") { a += $1; d += $2 } } END { printf "%s\t%d\t%d\n", r, a, d }'
      else
        printf '%s\t?\t?\n' "$ref"
      fi
    done | jq -Rsc '[split("\n")[] | select(. != "") | split("\t")] | group_by(.[0])
      | map({(.[0][0]): (if any(.[]; .[1] == "?") then null
          else [(map(.[1] | tonumber) | add), (map(.[2] | tonumber) | add)] end)}) | add // {}'
}

cmd_report() {
  local file unverified run
  [ $# -le 1 ] || usage
  file=$(pick_night "${1:-}")
  unverified=$(jq -r '.jobs[].ref' "$file" | while IFS= read -r ref; do
    run="${nights_dir%/*}/runs/$ref.json"
    [ ! -f "$run" ] || jq -c --arg r "$ref" '{($r): [.decisions[]? | select(.component == "unverified") | .id]}' "$run"
  done | jq -sc 'add // {}')
  jq -r --argjson u "$unverified" --argjson lines "$(code_lines "$file")" --arg status "$(night_status "$file")" \
    "$JQ_TOTALS"' totals as $t
    | "night \(.id) · \(.started_at | hm)–\(.finished_at | hm)"
      + (if $t.running then " · running" elif $t.unfinished then " · UNFINISHED" else "" end),
      (if .note then "note · \(.note)" else empty end),
      doctor_lines,
      (.jobs[] | ([.state, .kind, .ref]
        + (if .branch and .state != "merged" then [.branch] else [] end)
        + (if .review then ["review \(.review)"] else [] end)
        + [.commits[] | "\(.repo | split("/") | last)@\(.hash[0:7])"]
        + (.ref as $r | if ($lines | has($r)) | not then []
            elif $lines[$r] == null then ["code ?"] else ["code +\($lines[$r][0])/-\($lines[$r][1])"] end)
        + (if .state == "merged" then [if .pushed then "pushed" else "NOT PUSHED" end] else [] end)
        + (if .reason then [.reason] else [] end)) | join(" · ")),
      (.leftovers[]? | "leftover · \(.repo) · \(.branch) · \(.why)"),
      ($u | to_entries[] | select(.value | length > 0) | "unverified component · \(.key) · \(.value | join(", "))"),
      ("total · " + ([count($t.merged; "merged"), count($t.left; "left"), count($t.failed; "failed-launch"),
        count($t.blocked; "blocked-on-egor"), count($t.nothing; "nothing-to-do"), count($t.pending; "pending")]
        + [if $t.unpushed > 0 then "\($t.unpushed) not pushed" elif $t.merged > 0 then "pushed" else empty end]
        | if length == 0 then "no jobs" else join(" · ") end))' "$file"
}

cmd_latest() {
  local id
  [ "${1:-}" = --menu ] && [ $# -eq 1 ] || usage
  id=$(all_nights | jq -r '.[0].id // empty')
  [ -n "$id" ] || return 0
  jq -r --arg status "$(night_status "$(night_file "$id")")" --slurpfile areas "$repo_root/share/doctor-areas.json" \
    "$JQ_TOTALS$JQ_UNFINISHED"'
    def flat: tostring | gsub("[\t\r\n]+"; " ");
    def gist: split(":")[0] | split(",")[0] | split(";")[0] | split(" ") | map(select(. != ""))
      | if length > 6 then .[0:6] + ["…"] else . end | join(" ");
    def name: .ref as $r | if .kind == "debt" then (if $r | test("^debt(-[0-9]+)?$") then "cleanup" else "cleanup \($r)" end)
      elif .kind == "leftover" then "leftover \(.adopted[0].branch // $r)"
      elif .kind == "vendor" then "\(.branch // "" | split("/") | if length > 2 then last else $r | sub("-[0-9]{8}T[0-9]{6}Z.*$"; "") end) update"
      else ($r | capture("^(?<d>llm|harness|updater)(-(?<a>.+?))?-[0-9]{8}T[0-9]{6}Z(-[0-9a-f]+)?$")
        | ($areas[0].renamed["\(.d)-\(.a)"] // .a) as $a
        | ({llm: "LLM", harness: "Harness", updater: "Updater"}[.d] + " fixer"
          + (if $a and $a != $areas[0].own then ": " + ($a | gsub("-"; " ")) else "" end))) // $r end;
    def word: {merged: (if .pushed then "" else "not pushed yet" end), left: "unfinished",
      "failed-launch": "failed to launch", "blocked-on-egor": "needs you", "nothing-to-do": "nothing to do",
      pending: (if $status == "running" then "in progress" else "unfinished" end)}[.state] // .state;
    def tone: if .state == "failed-launch" or .state == "blocked-on-egor" then 1
      elif .state == "nothing-to-do" or (.state == "merged" and .pushed) then 0 else 2 end;
    totals as $t
    | (if $t.running then "Night run since \(.started_at | hm)"
       else "Last night \(.started_at | fromdateiso8601 | strflocaltime("%d %b") | ltrimstr("0"))"
         + (if $t.unfinished then ", stopped early" else "" end) end) as $when
    | ($t.merged + $t.nothing) as $done
    | (if (.jobs | length) == 0 then [if .note then "did not start" else "no jobs" end]
       else ["\($done) of \(.jobs | length)"]
         + [count($t.unpushed; "not pushed yet"),
            count($t.left + (if $t.running then 0 else $t.pending end); "unfinished"),
            count(if $t.running then $t.pending else 0 end; "in progress"),
            count($t.failed; "failed to launch"), count($t.blocked; "need you")] end) as $parts
    | "\($when): \($parts | join(" · "))\t\(if $t.failed + $t.blocked > 0 or .note != null then 1
        elif $t.running or ([.jobs[] | tone] | index(2)) then 2 else 0 end)\t\(
        if $t.running then 1 else 0 end)\t\(.id)",
      (if .note then "orchestrator chat did not open\t1\t\(.note | flat)" else empty end),
      (.jobs[] | "\([name, word, (.reason // empty | flat | gist)] | map(select(. != null and . != "")) | join(" · "))\t\(
        tone)\t\(.reason // "" | flat)\t\(
        .ref | flat)\t\(.kind)\t\(if unfinished and ($t.running | not) then 1 else 0 end)")' \
    "$(night_file "$id")"
}

case "${1:-}" in
  start) shift; cmd_start "$@" ;;
  base) shift; [ $# -eq 1 ] || usage; cmd_base "$1" ;;
  job) shift; cmd_job "$@" ;;
  finish) shift; cmd_finish "$@" ;;
  report) shift; cmd_report "$@" ;;
  latest) shift; cmd_latest "$@" ;;
  leftovers) shift; [ $# -le 1 ] || usage; cmd_leftovers "$@" ;;
  *) usage ;;
esac

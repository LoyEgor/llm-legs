#!/usr/bin/env bash
{
[ "${1:-}" = wall ] && [ -r ~/.claude/hooks/lib/hook-time.sh ] && . ~/.claude/hooks/lib/hook-time.sh
set -u

resolve_script() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")" && printf '%s/%s\n' "$PWD" "$(basename "$source")"
}

script_path=$(resolve_script)
repo_root=$(cd "$(dirname "$script_path")/.." && pwd)
nights_dir="${DOCTORS_DIR:-$HOME/.cache/doctors}/nights"
lock_dir="$nights_dir/.lock"
holds_dir="$nights_dir/holds"
sweep_repos="${NIGHT_RUN_SWEEP_REPOS:-$HOME/.claude/sweep-repos}"
# a faked sweep list means a test: the real helpers would get its night refs
helper_repos="${NIGHT_RUN_HELPER_REPOS-${NIGHT_RUN_SWEEP_REPOS:+/dev/null}}"
helper_repos="${helper_repos:-$repo_root/share/night-helper-repos}"
KINDS=' fixer vendor debt leftover handoff suite owner-chat trade '
STATES=' pending merged left failed-launch blocked-on-egor nothing-to-do '
SPEED_WINDOW_H=6
JQ_SPEED_RUN='def speed_run: .doctor == "harness" and (.area // "" | test("^speed(-|$)"));'
JQ_DONE_JOB='def done_job: .state == "nothing-to-do" or .state == "settled"; def job_branch($n): .branch // "night/\($n)/\(.ref)";'
. "$repo_root/share/chat-open.sh"
. "$repo_root/share/store-lock.sh"
. "$repo_root/share/test-scope.sh"
. "$repo_root/share/worktree.sh"
. "$repo_root/share/processes.sh"
. "$repo_root/share/slots.sh"

die() { printf 'night-run: %s\n' "$*" >&2; exit 1; }
stamp() { date -u +%Y-%m-%dT%H:%M:%SZ; }

usage() {
  cat >&2 <<'EOF'
usage: night-run start [--cleanup | --resume <id> [--job <ref>]]
       night-run base <id>
       night-run job <id> add <fixer|vendor|debt|leftover|handoff|suite|owner-chat|trade> <ref> [--branch B] [--ready "<why>" [--repo R]...]
       night-run carry <id>
       night-run suites <id> [--wait]
       night-run job <id> set <ref> key=value...   (state, reason, branch, review, commits, pushed, suites, answer, done)
       night-run finish <id>
       night-run leftovers [--json]
       night-run survey [--post] [<repo>...]
       night-run hold
       night-run speed-gate <id> <ref>
       night-run report [<id>] [--post]
       night-run latest --menu
       night-run wall                 (StopFailure hook: JSON on stdin)
       night-run failover <id> <session>

wall: a running night's orchestrator stopped by a usage wall (error rate_limit) is handed to a detached
  failover, which waits until worker-pick names a Claude account with room, ends the walled chat and
  resumes the night (start --resume) under a new orchestrator; events wall, wall-moved, wall-gave-up
start opens the orchestrator chat: --cleanup lands finished night branches and runs the debt round
  only; --resume reopens night <id> under a new orchestrator for its unfinished jobs (one with --job,
  else all plus a cleanup job), the old session kept in previous_sessions
  First it re-checks every answered trade (a blocked-on-egor job) of the other nights: one whose answer is
  carried out goes settled with its evidence; one not carried out becomes a pending trade job
  trade-<ref> of this night, carry giving it a worktree and a brief; an unanswered one stays. Recorded
  answers only: the job's answer= with every done= check holding, or a handoff job's doc whose Status:
  reads settled; prints `trade <night> <ref> settled: <evidence>` or `trade <night> <ref> -> <new ref>`
Nights live in ${DOCTORS_DIR:-~/.cache/doctors}/nights/<id>.json.
report opens with share/time_budget.py's comparison table: this night and the two previous finished
  nights with jobs, a column each, oldest left, facts only, – where a value has no source, a blank line
  after it; then share/night_spend.py's header: duration, jobs, the orchestrator's worker runs and
  hours, its review rounds, token spend of fixers, reviews and orchestrator weighted in input-token
  equivalents (input 1, cache write 1.25, cache read 0.1, output 5) against the previous finished night;
  then share/night_churn.py's churn, the jobs, and last share/time_budget.py's ledger (worker wall split
  into model, slot queue and own tests; lines by jobs and outside them; problems; spend and what was
  deferred) with the trend of the last 7 nights; --post sends the comparison table to the chat as one
  report-bus block instead of printing it, so the final message has no table to retype
survey: the sweep's opening report, default the sweep repositories: per repository `<name> · debt N
  lines/M files · due D lines/E files · K dirty · whole|N chunks` (review-bench review --debt [--due] …
  --tier T2 --price; due = stable or critical, what the bugs round reads), per linked
  worktree `<branch> · +ahead/-behind main · K dirty · debt N · take|keep (<reason>)`, keep = live or
  held as in leftovers, then `total · …`; --post also sends it to the chat as one report-bus block
states: pending merged left failed-launch blocked-on-egor nothing-to-do (left and blocked-on-egor need reason=)
commits=<repo>:<hash>[,<repo>:<hash>...]  replaces the job's list; <repo> is a sweep-repos
  basename or an absolute path; a changed list clears pushed unless pushed=true comes with it
  A merged job whose branch exists records its own commits instead: those its branch's reflog made
  (commit, commit (amend), commit (cherry-pick), cherry-pick, revert; never a merge) and what it was created with past the night's base, each as landed on main
  (author, author time and subject survive a rebase), else as on the branch; every other listed commit
  is kept under integration, never as the job's own
answer="<Egor's words>" on a blocked-on-egor job records his answer to its trade {words, at, by, done};
  done=<check>[,<check>...] names how its carrying out shows: commit:<repo>:<hash> (on main),
  file:<abs path> (exists), gone:<abs path> (does not), keep (nothing to carry out); every check
  holding, the trade settles at once, else the next start carries it
leftover: ref is a leftover branch, adopted in every sweep repository where it is one: its WIP
  committed, night/<id>/leftover-<slug> made at its tip with its night worktree, the old worktree and
  branch removed; the job's ref becomes leftover-<slug>; --ready "<why>" records its owner's handover
  {by, at, why, owner_verified: whether by worked in its worktree} on the job;
  --repo R (a sweep-repos basename or absolute path, repeatable) limits the adoption to those
  repositories, and --ready refuses a branch found in more than one of them without it;
  a held branch is refused, --ready or not
leftovers lists every non-main branch and worktree of the sweep repositories: live (main checkout, locked,
  a running night's branch) and held ones stay, recent activity or a process inside keeps none,
  landed ones go at finish, every other is a leftover to carry; finish records those under the night's
  leftovers and held. A night branch whose job is nothing-to-do or settled is superseded: never adopted
  nor added by job add --branch; finish prunes it once its tip is kept under refs/night/<night>/pruned/
  and in its job's pruned[], a dirty worktree staying
hold, run by the chat Egor said `сделай холд` in (word family night-hold), holds that chat's worktrees
  in the sweep repositories out of the nights until the next one finishes (a running one: it, named):
  nights/holds/<session>.json, a second hold of the chat adding to the first
carry: first an owner-chat job per owner chat (share/handoffs.py --batches: the ledger row naming the
  handoff, else its first addressee) with a decision section or two or more open handoffs: its night
  worktree, and its chat resumed with the batch (live: the sweep SendMessages it); at most
  NIGHT_RUN_OWNER_CHATS (3) pending at once and none while share/slots.sh slot_room finds no room,
  a deferred owner's handoffs staying night jobs; prints
  <ref>\t<prompt>\topened <account> <session>|message <owner>. Then one handoff job per other open
  docs/handoffs/*.md of the sweep repositories not addressed to a chat live now, and one suite job per
  suite the newest earlier night's full run failed; each gets its night worktree and a brief; prints
  <ref>\t<brief>\t<worktree>. A handoff job blocked-on-egor needs the trade in reason= as Cost:,
  Loss: and Recommendation:
speed-gate, run by worker-run once a night worker takes its slot: exits 3 while a process stands in the
  job's night worktree (a resumed night's earlier worker), naming it, the job untouched; a Speed fixer (a harness run of area
  speed-<lever>, one per lever or per levers sharing a file) whose first start comes SPEED_WINDOW_H (6) hours or more after the night's started_at exits 3,
  its job left with reason `speed window closed (6 h)` and its run abandoned; an earlier start is
  recorded as a speed-start event, after which a resumed worker of that fixer always passes
suites: every sweep repository's tests/run-all, one after another, detached unless --wait, into the
  night's suites {started_at, finished_at, repos: [{repo, exit, passed, failed[], log}]}
pushed=true is refused unless every commit of the job, its integration ones included, is on its
  repository's origin main and not in the night's refs/night/<id>/base
state=merged with a review is refused while `review-bench fix <review> --print` names open findings:
  the round is fixed through its brief or closed with `review-bench close <review> --nofix`
state=merged of a Code fixer job (ref code-*, or a leftover carrying a code-* branch) is refused unless `code-doctor check` passes on its run
  record against refs/night/<id>/base and the main checkouts now; suites=passed attests its green suites
EOF
  exit 2
}

lock() {
  mkdir -p "$nights_dir" || die "cannot create $nights_dir"
  store_lock_acquire "$lock_dir" || die "the nights lock $lock_dir is held"
  trap 'store_lock_release "$lock_dir"' EXIT
}

unlock() { store_lock_release "$lock_dir"; trap - EXIT; }

night_file() { printf '%s/%s.json\n' "$nights_dir" "$1"; }

night_set() { # id jq-filter args...
  local file tmp filter=$2
  file=$(night_file "$1")
  shift 2
  tmp=$(mktemp "$nights_dir/.night.XXXXXX") || return 1
  jq "$@" "$filter" "$file" >"$tmp" && mv -f "$tmp" "$file" || { rm -f "$tmp"; return 1; }
}

# pred: the job's previous event, `"last"` the night's previous one, `"jobs"` every job's last.
JQ_EVENTS='def events($new; $t): reduce $new[] as $x (.; (.events // []) as $e
  | .events = $e + [{id: ($e | length + 1), at: ($x.at // $t), phase: $x.phase, job: ($x.job // null),
      pred: (if $x.pred == "last" then [$e[-1].id // empty]
        elif $x.pred == "jobs" then [$e | map(select(.job != null)) | group_by(.job)[] | last.id] | sort
        elif ($x.job // null) == null then []
        else [$e[] | select(.job == $x.job) | .id] | .[-1:] end)}
    + ($x | del(.at, .phase, .job, .pred))]);'

night_events() { # id events-json (locked)
  night_set "$1" "$JQ_EVENTS"' events($e; $t)' --argjson e "$2" --arg t "$(stamp)"
}

known_night() { # id
  case $1 in */* | '' | .*) die "not a night id: $1" ;; esac
  [ -s "$(night_file "$1")" ] || die "no night $1 under $nights_dir"
}

all_nights() { # -> every night as one JSON array, newest first
  local files=()
  [ -d "$nights_dir" ] && files=("$nights_dir"/*.json)
  [ -e "${files[0]:-}" ] || { printf '[]\n'; return 0; }
  jq -s 'sort_by(.started_at, .id) | reverse' "${files[@]}"
}

doctor_read() { # jq-filter -> {"llm": value|null, "harness": value|null, "updater": value|null, "code": value|null, "system": value|null} off each latest.json
  local llm harness updater code system
  llm="${LLM_DOCTOR_DIR:-$HOME/.cache/llm-doctor}/latest.json"
  harness="${HARNESS_DOCTOR_DIR:-$HOME/.cache/harness-doctor}/latest.json"
  updater="${UPDATER_DOCTOR_DIR:-$HOME/.cache/updater-doctor}/latest.json"
  code="${CODE_DOCTOR_DIR:-$HOME/.cache/code-doctor}/latest.json"
  system="${SYSTEM_DOCTOR_DIR:-$HOME/.cache/system-doctor}/latest.json"
  jq -n \
    --argjson ln "$(jq -c "$1" "$llm" 2>/dev/null || echo null)" \
    --argjson hn "$(jq -c "$1" "$harness" 2>/dev/null || echo null)" \
    --argjson un "$(jq -c "$1" "$updater" 2>/dev/null || echo null)" \
    --argjson cn "$(jq -c "$1" "$code" 2>/dev/null || echo null)" \
    --argjson sn "$(jq -c "$1" "$system" 2>/dev/null || echo null)" \
    '{llm: $ln, harness: $hn, updater: $un, code: $cn, system: $sn}'
}

doctor_counts() { doctor_read '.problem_count // null'; }

JQ_PROBLEM_NORM='def norm_problem: (.fact // "") as $f
  | if (.state == "fixed-pending" or .state == "watch") and (($f | test("^fixed · [0-9]+ events since · 0 matched"))
      or (.proof | if type == "object" then .verdict else null end) == "proven") then "proved"
    elif .state == "fixed-pending" or .rule == "fix-proof" then "pending" else .state end;'

# proved: a fix the doctor proved (harness `fixed · E events since · 0 matched`, the System doctor's
# `proof.verdict` proven; the LLM doctor drops a proved row instead); pending: a fix awaiting its commit or its proof.
doctor_states() {
  doctor_read "$JQ_PROBLEM_NORM"' [.problems[]? | norm_problem] as $s
    | reduce ("proved", "pending", "open", "new", "regressed") as $k ({}; .[$k] = ($s | map(select(. == $k)) | length))'
}

doctor_problems() {
  doctor_read "$JQ_PROBLEM_NORM"' reduce (.problems[]? | select(.id != null)) as $p ({}; .[$p.id] = ($p | norm_problem))'
}

main_checkout() {
  local top root
  git_top "$repo_root" && printf '%s\n' "$root" || printf '%s\n' "$repo_root"
}

night_status() { # night-file -> finished, running, or unfinished when its orchestrator chat is gone
  local session
  session=$(jq -r 'if .finished_at != null then "finished" else .session // "opener:\(.opener // 0)" end' "$1")
  case $session in
    finished) printf 'finished\n' ;;
    opener:*)
      if [ "${session#opener:}" != 0 ] && kill -0 "${session#opener:}" 2>/dev/null; then printf 'running\n'
      else printf 'unfinished\n'; fi ;;
    *) if pgrep -f -- "--(session-id|resume) $session" >/dev/null; then printf 'running\n'; else printf 'unfinished\n'; fi ;;
  esac
}

orchestrator_caller() { # night-file -> whether this process is the night's orchestrator chat: its session, or under its process
  local session pid chat
  session=$(jq -r '.session // empty' "$1")
  [ -n "$session" ] || return 1
  [ "${CLAUDE_CODE_SESSION_ID:-}" != "$session" ] || return 0
  chat=$(pgrep -f -- "--(session-id|resume) $session") pid=$$
  while [[ $pid =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ]; do
    grep -qxF "$pid" <<<"$chat" && return 0
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d '[:space:]')
  done
  return 1
}

open_nights() { # -> ids of nights whose orchestrator chat still runs
  local id
  all_nights | jq -r '.[] | select(.finished_at == null) | .id' | while IFS= read -r id; do
    [ "$(night_status "$(night_file "$id")")" != running ] || printf '%s\n' "$id"
  done
}

JQ_UNFINISHED='def unfinished: .state == "left" or .state == "pending";'

resume_night() { # id job-ref-or-empty (locked): reopens the night for a new orchestrator, the old session kept
  local id=$1 job=$2 file
  known_night "$id"
  file=$(night_file "$id")
  if [ -n "$job" ]; then
    jq -e --arg r "$job" "$JQ_UNFINISHED"' any(.jobs[]; .ref == $r and unfinished)' "$file" >/dev/null ||
      die "night $id has no unfinished job $job"
  else
    jq -e "$JQ_UNFINISHED"' .finished_at == null or any(.jobs[]; unfinished)' "$file" >/dev/null || die "night $id has no unfinished job"
  fi
  night_set "$id" "$JQ_UNFINISHED$JQ_EVENTS"' .previous_sessions = ((.previous_sessions // []) + [.session | values])
    | .session = null | .opener = $opener | .finished_at = null | .doctors_after = null | .doctor_states_after = null | .doctor_problems_after = null | .note = null
    | .jobs |= map(if unfinished and ($job == "" or .ref == $job) then .state = "pending" else . end)
    | if $job == "" and ([.jobs[] | select(.kind == "debt" and .state == "pending")] | length) == 0
      then .jobs += [{kind: "debt", ref: "debt-\([.jobs[] | select(.kind == "debt")] | length + 1)", state: "pending",
        reason: null, branch: null, review: null, commits: [], pushed: false}] else . end
    | events([{phase: "resume", pred: "last"} + (if $job == "" then {} else {scope: $job} end)]; $t)' --arg job "$job" \
    --argjson opener "$$" --arg t "$(stamp)" ||
    die "cannot write night $id"
}

trade_check() { # check -> its evidence; fails when it does not hold
  local spec=$1 repo dir
  case $spec in
    keep) printf 'keep: nothing to carry out\n' ;;
    commit:*) repo=${spec#commit:} repo=${repo%:*}
      dir=$(repo_dir "$repo") && git -C "$dir" merge-base --is-ancestor "${spec##*:}" refs/heads/main 2>/dev/null &&
        printf 'commit %s@%s on main\n' "$repo" "${spec##*:}" ;;
    file:*) [ -e "${spec#file:}" ] && printf 'file %s exists\n' "${spec#file:}" ;;
    gone:*) [ ! -e "${spec#gone:}" ] && printf 'file %s is gone\n' "${spec#gone:}" ;;
    *) return 1 ;;
  esac
}

# Only a recorded answer moves a trade: a handoff doc's settled Status, or answer= with its done= checks.
trade_settle() { # night ref by (locked) -> 0 settled with its evidence, 1 answered but not carried out, 2 unanswered
  local night=$1 ref=$2 id=$3 job path status check line evidence='[]'
  job=$(jq -c --arg r "$ref" 'first(.jobs[] | select(.ref == $r))' "$(night_file "$night")")
  path=$(jq -r 'select(.kind == "handoff") | .path // empty' <<<"$job") status=''
  if [ -z "$path" ] && [[ $ref == handoff-* ]]; then
    path=$(sed "s|\$|/docs/handoffs/${ref#handoff-}.md|" "$sweep_repos" 2>/dev/null | while IFS= read -r line; do
      [ ! -f "$line" ] || printf '%s\n' "$line"; done)
    [ "$(grep -c . <<<"$path")" = 1 ] || path=''
  fi
  [ -z "$path" ] || status=$(python3 -B "$repo_root/share/handoffs.py" --status "$path" 2>/dev/null)
  if [[ $status == [Ss]ettled* ]]; then
    evidence=$(jq -cn --arg e "$path: Status: $status" '[$e]')
  elif jq -e '.answer.words != null' <<<"$job" >/dev/null; then
    while IFS= read -r check; do
      line=$(trade_check "$check") || { evidence='[]'; break; }
      evidence=$(jq -c --arg e "$line" '. + [$e]' <<<"$evidence")
    done < <(jq -r '.answer.done[]?' <<<"$job")
  else
    return 2
  fi
  [ "$evidence" != '[]' ] || return 1
  night_set "$night" "$JQ_EVENTS"' .jobs |= map(if .ref == $r then .state = "settled" | .settled = {at: $t, night: $id, evidence: $e} else . end)
    | events([{phase: "trade-settled", job: $r, night: $id}]; $t)' \
    --arg r "$ref" --arg id "$id" --argjson e "$evidence" --arg t "$(stamp)" || die "cannot write night $night"
  printf 'trade %s %s settled: %s\n' "$night" "$ref" "$(jq -r 'join("; ")' <<<"$evidence")"
}

trades_recheck() { # id (locked) -> per answered trade of the other nights: settled with its evidence, or carried into night id
  local id=$1 night ref job new rc
  while IFS=$'\t' read -r night ref; do
    rc=0
    trade_settle "$night" "$ref" "$id" || rc=$?
    [ "$rc" = 1 ] || continue
    job=$(jq -c --arg r "$ref" 'first(.jobs[] | select(.ref == $r))' "$(night_file "$night")")
    new="trade-$ref"
    ! jq -e --arg r "$new" 'any(.jobs[]; .ref == $r)' "$(night_file "$id")" >/dev/null || new="$new-${night##*-}"
    night_set "$id" "$JQ_EVENTS"' .jobs += [{kind: "trade", ref: $n, state: "pending", reason: null, branch: "night/\($id)/\($n)",
        review: null, commits: [], pushed: false, answer: $j.answer,
        from: {night: $night, ref: $j.ref, kind: $j.kind, trade: $j.reason, path: ($j.path // null)}}]
      | events([{phase: "add", job: $n, kind: "trade"}]; $t)' \
      --arg n "$new" --arg id "$id" --arg night "$night" --argjson j "$job" --arg t "$(stamp)" || die "cannot write night $id"
    night_set "$night" "$JQ_EVENTS"' .jobs |= map(if .ref == $r then .carried = {at: $t, night: $id, ref: $n} else . end)
      | events([{phase: "trade-carried", job: $r, night: $id}]; $t)' \
      --arg r "$ref" --arg id "$id" --arg n "$new" --arg t "$(stamp)" || die "cannot write night $night"
    printf 'trade %s %s -> %s\n' "$night" "$ref" "$new"
  done < <(all_nights | jq -r --arg id "$id" '.[] | select(.id != $id) | .id as $n
    | .jobs[] | select(.state == "blocked-on-egor" and .carried == null) | [$n, .ref] | @tsv')
}

cmd_start() {
  local id open file opened account session scope=all resume='' job='' marker=''
  while [ $# -gt 0 ]; do
    case $1 in
      --cleanup) scope=cleanup; shift ;;
      --resume) [ -n "${2:-}" ] || usage; scope=resume resume=$2; shift 2 ;;
      --job) [ -n "${2:-}" ] || usage; job=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -z "$job" ] || [ -n "$resume" ] || usage
  [ "$scope" = all ] || marker=" $scope"
  lock
  open=$(open_nights | head -1)
  [ -z "$open" ] || die "night $open is still running: $(jq -r '"its orchestrator chat \(.session // "(opening, pid \(.opener))") has run since \(.started_at)"' \
    "$(night_file "$open")") and finishes the night itself; a new night starts after that."
  if [ -n "$resume" ]; then
    id=$resume
    resume_night "$id" "$job"
  else
    id="$(date -u +%Y%m%dT%H%M%SZ)-$(od -An -N2 -tx1 /dev/urandom | tr -d ' \n')"
    file=$(night_file "$id")
    [ ! -e "$file" ] || die "night id $id is taken"
    jq -n --arg id "$id" --arg t "$(stamp)" --argjson before "$(doctor_counts)" --argjson states "$(doctor_states)" \
      --argjson problems "$(doctor_problems)" \
      --argjson opener "$$" '{id: $id, started_at: $t, finished_at: null, session: null, account: null, command: null, note: null,
        doctors_before: $before, doctors_after: null, doctor_states_before: $states, doctor_states_after: null,
        doctor_problems_before: $problems, doctor_problems_after: null, jobs: [],
        opener: $opener}' >"$file.tmp" && mv -f "$file.tmp" "$file" ||
      { rm -f "$file.tmp"; die "cannot write $file"; }
  fi
  trades_recheck "$id"
  unlock
  if ! opened=$(CHAT_OPEN_OPENER="${NIGHT_RUN_OPENER:-open -a Terminal}" \
    CHAT_OPEN_WORKER_PICK="${NIGHT_RUN_WORKER_PICK:-$repo_root/bin/worker-pick}" \
    CHAT_OPEN_PREFIX="caffeinate -i" \
    chat_open "$nights_dir/$id.command" "$(main_checkout)" "сделай чистку — night run $id$marker" 2>&1); then
    lock
    night_set "$id" '.note = $n | .finished_at = $t | del(.opener)
      | if $resume == "" then .jobs = [] else .jobs |= map(if .state == "pending" then .state = "left" | .reason = (.reason // $n) else . end) end' \
      --arg n "orchestrator chat did not open: $opened" --arg t "$(stamp)" --arg resume "$resume"
    [ -n "$resume" ] || all_nights | jq -r --arg id "$id" '.[] | select(any(.jobs[]; .carried.night? == $id)) | .id' |
      while IFS= read -r file; do
        night_set "$file" '.jobs |= map(if .carried.night? == $id then del(.carried) else . end)' --arg id "$id"
      done
    die "night $id: the orchestrator chat did not open: $opened"
  fi
  read -r account session <<<"$opened"
  lock
  night_set "$id" '.session = $s | .account = $a | .command = $c | del(.opener)' \
    --arg s "$session" --arg a "$account" --arg c "$nights_dir/$id.command" || die "cannot write night $id"
  printf 'night %s %s: orchestrator on %s\n' "$id" "$([ -n "$resume" ] && echo resumed || echo started)" "$account"
}

repo_dir() { # name-or-path -> repository directory
  local line
  case $1 in /*) printf '%s\n' "$1"; return 0 ;; esac
  [ -r "$sweep_repos" ] || return 1
  while IFS= read -r line; do
    [ -n "$line" ] && [ "$(basename "$line")" = "$1" ] && { printf '%s\n' "$line"; return 0; }
  done < <(cat "$sweep_repos" "$helper_repos" 2>/dev/null)
  return 1
}

SNAPSHOT_MAX_BYTES=$((5 * 1024 * 1024))

tree_commit() { # dir message what -> commit on HEAD of the checkout as it stands, uncommitted and untracked included
  local dir index tree commit meta path sha status size reason drops=()
  dir=$(mktemp -d) || return 1
  index=$dir/index
  GIT_INDEX_FILE=$index git -C "$1" read-tree HEAD &&
    GIT_INDEX_FILE=$index git -C "$1" add -A . || { rm -rf "$dir"; return 1; }
  while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
    read -r _ _ _ sha status <<<"$meta"
    [ "$status" != D ] || continue
    reason=''
    if [ "$status" = A ]; then
      case ${path##*/} in .env | *.pem | *.key | id_*) reason='an untracked secret name' ;; esac
    fi
    if [ -z "$reason" ]; then
      size=$(git -C "$1" cat-file -s "$sha" 2>/dev/null) || size=0
      [ "$size" -le "$SNAPSHOT_MAX_BYTES" ] || reason="a $((size / 1048576)) MB blob"
    fi
    [ -n "$reason" ] || continue
    drops+=("$path")
    printf 'night-run: %s of %s drops %s: %s\n' "$3" "$1" "$path" "$reason" >&2
  done < <(GIT_INDEX_FILE=$index git -C "$1" diff-index -z --cached HEAD)
  [ ${#drops[@]} -eq 0 ] || GIT_INDEX_FILE=$index git --literal-pathspecs -C "$1" reset -q HEAD -- "${drops[@]}" ||
    { rm -rf "$dir"; return 1; }
  tree=$(GIT_INDEX_FILE=$index git -C "$1" write-tree) &&
    commit=$(git -C "$1" -c user.name=night-run -c user.email=night-run@localhost commit-tree "$tree" -p HEAD -m "$2") &&
    printf '%s\n' "$commit"
  local rc=$?
  rm -rf "$dir"
  return "$rc"
}

snapshot() { # dir id -> refs/night/<id>/base: the checkout as it stands
  local commit
  commit=$(tree_commit "$1" "night $2 base: the checkout as pressed" 'the base') &&
    git -C "$1" update-ref "refs/night/$2/base" "$commit" && printf '%s\n' "$commit"
}

# Night worktrees start from refs/night/<id>/base, not HEAD: main carries days of uncommitted work
# (the doctors themselves among it), and a branch from HEAD would fix code that no longer exists.
cmd_base() {
  local id=$1 line commit bases='{}' at=$(stamp) began=$SECONDS
  known_night "$id" || die "no night $id"
  [ -r "$sweep_repos" ] || die "cannot read $sweep_repos"
  while IFS= read -r line; do
    [ -n "$line" ] && [ -d "$line" ] || continue
    commit=$(snapshot "$line" "$id") || die "cannot snapshot $line"
    bases=$(jq -c --arg r "$(basename "$line")" --arg c "$commit" '. + {($r): $c}' <<<"$bases")
    printf '%s\t%s\n' "$(basename "$line")" "$commit"
  done < <(cat "$sweep_repos" "$helper_repos" 2>/dev/null)
  lock
  night_set "$id" "$JQ_EVENTS"' .bases = $b | events([{phase: "base", at: $at, secs: $s, repos: ($b | length)}]; $t)' \
    --argjson b "$bases" --arg at "$at" --argjson s "$((SECONDS - began))" --arg t "$(stamp)" || die "cannot write night $id"
}

# A leftover moves into the night's own namespace, where the review-flow gate lets workers commit:
# night/<id>/leftover-<slug> at its tip, its WIP committed first, in every sweep repository where the
# branch is a leftover; the old worktree and branch go once the night branch holds every commit.
adopt_leftover() { # id branch ready-why repos -> sets branch and adopted (JSON)
  local id=$1 old=$2 repos=$4 rows row repo br wt landed ahead behind dirty state why tip wip path keep ignored
  branch="night/$id/leftover-${old//\//-}" adopted='[]'
  rows=$(ROWS_BRANCH=$old branch_rows)
  [ -n "$rows" ] || die "no branch $old in the sweep repositories besides main"
  if [ -n "$repos" ]; then
    rows=$(awk -F '\t' 'NR == FNR { keep[$0]; next } $1 in keep' <(printf '%s\n' "$repos") - <<<"$rows")
    [ -n "$rows" ] || die "no branch $old in $(sed 's|.*/||' <<<"$repos" | paste -sd ' ' -)"
  elif [ -n "$3" ] && [ "$(wc -l <<<"$rows")" -gt 1 ]; then
    die "$old is in $(cut -f1 <<<"$rows" | sed 's|.*/||' | paste -sd ' ' -): --ready hands over one chat's branch, so name the repositories it covers and retry with $(cut -f1 <<<"$rows" | sed 's|.*/|--repo |' | paste -sd '|' - | sed 's/|/ or /g')"
  fi
  row=$(awk -F '\t' '$8 == "live" || $8 == "held" || $8 == "superseded"' <<<"$rows" | head -1)
  [ -z "$row" ] || die "$old is $(cut -f8 <<<"$row") in $(basename "${row%%$'\t'*}"): $(cut -f9 <<<"$row")"
  rows=$(awk -F '\t' '$8 == "leftover"' <<<"$rows")
  [ -n "$rows" ] || die "$old is no leftover: landed, finish prunes it"
  jq -e --arg r "${branch##*/}" 'any(.jobs[]; .ref == $r)' "$(night_file "$id")" >/dev/null &&
    die "night $id already has job ${branch##*/}"
  while IFS=$'\t' read -r repo _ _ _ _ _ _ _ _; do
    git -C "$repo" rev-parse -q --verify "refs/night/$id/base^{commit}" >/dev/null ||
      die "no refs/night/$id/base in $repo: run night-run base $id first"
    ! git -C "$repo" show-ref --verify --quiet "refs/heads/$branch" || die "$branch already exists in $repo"
    path="$repo/.claude/worktrees/night-$id-${branch##*/}"
    [ ! -e "$path" ] || die "$path already exists"
  done <<<"$rows"
  while IFS=$'\t' read -r repo br wt landed ahead behind dirty state why; do
    tip=$(git -C "$repo" rev-parse "refs/heads/$old")
    if [ "$dirty" != 0 ]; then
      wip=$(tree_commit "$wt" "Leftover WIP from $old, adopted by night $id" 'the WIP commit') &&
        git -C "$wt" update-ref "refs/heads/$old" "$wip" "$tip" && git -C "$wt" reset -q &&
        tip=$wip || { adopt_undo "$branch" "$adopted"; die "cannot commit the WIP of $wt"; }
    fi
    path="$repo/.claude/worktrees/night-$id-${branch##*/}"
    adopted=$(jq -c --arg r "$repo" --arg b "$old" --arg w "$wt" --arg t "$tip" --arg p "$path" \
      '. + [{repo: $r, branch: $b, worktree: (if $w == "-" then null else $w end), tip: $t, night_worktree: $p}]' <<<"$adopted")
    git -C "$repo" branch -q "$branch" "$tip" && worktree_new "$repo" "$branch" >/dev/null ||
      { adopt_undo "$branch" "$adopted"; die "cannot make $branch in $repo"; }
  done <<<"$rows"
  while IFS=$'\t' read -r repo wt path; do
    keep=''
    if [ "$wt" != - ]; then
      if [[ $old =~ code-code-[0-9]{8}T[0-9]{6}Z(-[0-9a-f]+)?$ ]]; then
        keep='code-doctor check reads the Code fixer run from it'
      else
        ignored=$(git -C "$wt" ls-files -o -i --exclude-standard --directory | head -3 | paste -sd ' ' -)
        [ -z "$ignored" ] || keep="it holds ignored files ($ignored)"
      fi
      [ -n "$keep" ] || keep=$(cwd_held "$wt")
    fi
    if [ -n "$keep" ]; then
      printf 'adopted %s %s into %s at %s; the old one stays: %s\n' "$(basename "$repo")" "$old" "$branch" "$path" "$keep"
    elif { [ "$wt" = - ] || git -C "$repo" worktree remove "$wt"; } && git -C "$repo" branch -q -D "$old"; then
      printf 'adopted %s %s into %s at %s\n' "$(basename "$repo")" "$old" "$branch" "$path"
    else
      printf 'adopted %s %s into %s at %s; the old one stays, git refused its removal\n' "$(basename "$repo")" "$old" "$branch" "$path"
    fi
  done < <(jq -r '.[] | [.repo, (.worktree // "-"), .night_worktree] | @tsv' <<<"$adopted")
}

adopt_undo() { # branch adopted -> drops the night branch and worktree of every repository adopted so far
  local repo path
  while IFS=$'\t' read -r repo path; do
    git -C "$repo" worktree remove --force "$path" 2>/dev/null
    git -C "$repo" branch -q -D "$1" 2>/dev/null
  done < <(jq -r '.[] | [.repo, .night_worktree] | @tsv' <<<"$2")
}

cmd_job() {
  local id=${1:-} verb=${2:-} kind ref branch='' row adopted='' at=$(stamp) began=$SECONDS adopt='{}' ready='' repos='' handover=null tops=''
  [ -n "$id" ] || usage
  known_night "$id"
  case $verb in
    add)
      kind=${3:-} ref=${4:-}
      [[ "$KINDS" == *" $kind "* ]] && [ -n "$ref" ] || usage
      shift 4
      while [ $# -gt 0 ]; do
        case $1 in
          --branch) [ -n "${2:-}" ] || usage; branch=$2; shift 2 ;;
          --ready) [ -n "${2:-}" ] || usage; ready=$2; shift 2 ;;
          --repo) [ -n "${2:-}" ] || usage
            repos+=$(repo_dir "$2")$'\n' || die "no repository $2: not an absolute path nor a basename in $sweep_repos"
            shift 2 ;;
          *) usage ;;
        esac
      done
      [ -z "$ready$repos" ] || [ "$kind" = leftover ] || usage
      [ -z "$branch" ] || ! row=$(ROWS_BRANCH=$branch branch_rows | awk -F '\t' '$8 == "superseded"' | head -1) || [ -z "$row" ] ||
        die "$branch is superseded in $(basename "${row%%$'\t'*}"): $(cut -f9 <<<"$row"); it never lands"
      if [ "$kind" = leftover ]; then
        [ -z "$branch" ] || usage
        [ -z "$ready" ] || [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] || tops=$(chat_tops "$CLAUDE_CODE_SESSION_ID")
        adopt_leftover "$id" "$ref" "$ready" "${repos%$'\n'}"
        ref=${branch##*/}
        adopt="{\"adopt_secs\": $((SECONDS - began))}"
        [ -z "$ready" ] || handover=$(jq -nc --arg by "${CLAUDE_CODE_SESSION_ID:-${USER:-?}}" --arg at "$at" --arg why "$ready" \
          --arg tops "$tops" --argjson a "$adopted" '{by: $by, at: $at, why: $why,
            owner_verified: (($tops | split("\n")) as $t | any($a[]; .worktree != null and (.worktree | IN($t[]))))}')
      fi
      lock
      jq -e --arg r "$ref" 'any(.jobs[]; .ref == $r)' "$(night_file "$id")" >/dev/null &&
        die "night $id already has job $ref"
      night_set "$id" "$JQ_EVENTS"' .jobs += [{kind: $k, ref: $r, state: "pending", reason: null,
        branch: (if $b == "" then null else $b end), review: null, commits: [], pushed: false}
        + (if $a == null then {} else {adopted: $a} end) + (if $h == null then {} else {handover: $h} end)]
        | events([{phase: "add", at: $at, job: $r, kind: $k} + $adopt]; $t)' \
        --arg k "$kind" --arg r "$ref" --arg b "$branch" --argjson a "${adopted:-null}" --argjson h "$handover" \
        --arg at "$at" --argjson adopt "$adopt" --arg t "$(stamp)" || die "cannot write night $id"
      printf 'night %s: job %s %s added\n' "$id" "$kind" "$ref" ;;
    set) shift 2; job_set "$id" "$@" ;;
    *) usage ;;
  esac
}

job_of() { # night-file ref patch -> the job with patch applied, empty when there is none
  jq -c --arg r "$2" --argjson p "$3" 'first(.jobs[] | select(.ref == $r)) + $p' "$1"
}

# A refusal never waits on a held nights lock, so it is recorded only when the lock is free at once.
checked_event() { # check; reads job_set's id, ref, at, began and refusal, appends to its events
  events=$(jq -c --arg r "$ref" --arg c "$1" --arg at "$at" --argjson s "$((SECONDS - began))" --arg why "$refusal" \
    '. + [{phase: "validate", at: $at, job: $r, check: $c, ok: ($why == ""), secs: $s}]' <<<"$events")
  [ -n "$refusal" ] || return 0
  if LLM_STORE_LOCK_RETRIES=1 store_lock_acquire "$lock_dir"; then
    night_events "$id" "$events" || :
    store_lock_release "$lock_dir"
  fi
  die "$refusal"
}

# Rebase, cherry-pick and conflict resolution keep a commit's author, author time and subject, so they
# find the landed copy of a commit the branch made; the branch tip alone would also hold every job landed before.
own_commits() { # id branch -> [{repo, hash}] the branch made, each as landed on main, else as on the branch; null when no repository has the branch
  local id=$1 branch=$2 repo log created stop made out='[]' found=false hash fmt='%H%x1f%ae%x1f%at%x1f%s'
  while IFS= read -r repo; do
    [ -n "$repo" ] && git -C "$repo" rev-parse -q --verify "refs/heads/$branch^{commit}" >/dev/null 2>&1 || continue
    found=true
    log=$(git -C "$repo" reflog show --format='%H%x09%gs' "refs/heads/$branch" --) && [ -n "$log" ] || continue
    created=$(tail -n 1 <<<"$log" | cut -f1)
    stop=$(git -C "$repo" rev-parse -q --verify "refs/night/$id/base^{commit}") ||
      stop=$(git -C "$repo" merge-base refs/heads/main "$created") || continue
    made=$({ awk -F '\t' '$2 ~ /^(commit( \((amend|cherry-pick)\))?|cherry-pick|revert): / { print $1 }' <<<"$log"
      git -C "$repo" rev-list "$created" "^$stop"; } | sort -u)
    [ -n "$made" ] || continue
    while IFS= read -r hash; do
      out=$(jq -c --arg r "$(basename "$repo")" --arg h "$hash" '. + [{repo: $r, hash: $h}]' <<<"$out")
    done < <(awk -F '\037' 'FILENAME == ARGV[1] { mine[$2 FS $3 FS $4]; next }
        { key = $2 FS $3 FS $4 } (key in mine) && !(key in seen) { seen[key]; print $1 }' \
      <(git -C "$repo" log --no-walk --ignore-missing --format="$fmt" $made) \
      <(git -C "$repo" log --reverse --format="$fmt" refs/heads/main "^$stop"
        git -C "$repo" log --reverse --format="$fmt" "refs/heads/$branch" "^$stop" ^refs/heads/main))
  done < <(cat "$sweep_repos" "$helper_repos" 2>/dev/null)
  if $found; then printf '%s\n' "$out"; else printf 'null\n'; fi
}

full_commits() { # job -> its commits and integration ones as [{repo: basename, hash: full}], unresolvable ones as given
  local repo hash dir full out='[]'
  while IFS=$'\t' read -r repo hash; do
    if dir=$(repo_dir "$repo") && full=$(git -C "$dir" rev-parse -q --verify "$hash^{commit}" 2>/dev/null); then
      repo=$(basename "$dir") hash=$full
    fi
    out=$(jq -c --arg r "$repo" --arg h "$hash" '. + [{repo: $r, hash: $h}]' <<<"$out")
  done < <(jq -r '(.integration // []) + .commits | .[] | [.repo, .hash] | @tsv' <<<"$1")
  printf '%s\n' "$out"
}

copies_of() { # own full -> full's entries with the author, author time and subject of an own commit of their repository
  local repo dir hash mine theirs out='[]' fmt='%H%x1f%ae%x1f%at%x1f%s'
  while IFS= read -r repo; do
    dir=$(repo_dir "$repo") || continue
    mine=$(jq -r --arg r "$repo" '.[] | select(.repo == $r) | .hash' <<<"$1")
    theirs=$(jq -r --arg r "$repo" '.[] | select(.repo == $r) | .hash' <<<"$2")
    [ -n "$mine" ] && [ -n "$theirs" ] || continue
    while IFS= read -r hash; do
      out=$(jq -c --arg r "$repo" --arg h "$hash" '. + [{repo: $r, hash: $h}]' <<<"$out")
    done < <(awk -F '\037' 'FILENAME == ARGV[1] { mine[$2 FS $3 FS $4]; next } ($2 FS $3 FS $4) in mine { print $1 }' \
      <(git -C "$dir" log --no-walk --ignore-missing --format="$fmt" $mine) \
      <(git -C "$dir" log --no-walk --ignore-missing --format="$fmt" $theirs))
  done < <(jq -r '[.[].repo] | unique[]' <<<"$1")
  printf '%s\n' "$out"
}

job_set() { # id ref key=value...
  local id=$1 ref=${2:-} pair key value patch='{}' item repo hash dir commits_set=false pushed='' suites='' branch
  [ -n "$ref" ] && [ $# -ge 3 ] || usage
  shift 2
  for pair in "$@"; do
    [[ "$pair" == *=* ]] || usage
    key=${pair%%=*} value=${pair#*=}
    case $key in
      state) [[ "$STATES" == *" $value "* ]] || die "state $value is none of:$STATES"
        patch=$(jq -c --arg v "$value" '.state = $v' <<<"$patch") ;;
      reason | branch | review) patch=$(jq -c --arg k "$key" --arg v "$value" '.[$k] = (if $v == "" then null else $v end)' <<<"$patch") ;;
      commits) commits_set=true
        patch=$(jq -c --arg v "$value" '.commits = [$v | splits(",") | select(. != "")
          | capture("^(?<repo>.+):(?<hash>[0-9a-f]{7,40})$") // error("not <repo>:<hash>: \(.)")]' <<<"$patch" 2>/dev/null) ||
          die "commits takes <repo>:<hash>[,<repo>:<hash>...], not $value" ;;
      pushed) case $value in true | false) pushed=$value ;; *) die "pushed takes true or false, not $value" ;; esac
        patch=$(jq -c --argjson v "$value" '.pushed = $v' <<<"$patch") ;;
      suites) [ "$value" = passed ] || die "suites takes passed, not $value"
        suites=$value patch=$(jq -c '.suites = "passed"' <<<"$patch") ;;
      answer) [ -n "$value" ] || die "answer takes Egor's words"
        patch=$(jq -c --arg v "$value" --arg by "${CLAUDE_CODE_SESSION_ID:-${USER:-?}}" --arg at "$(stamp)" \
          '.answer = {words: $v, at: $at, by: $by, done: (.answer.done // [])}' <<<"$patch") ;;
      done) patch=$(jq -c --arg v "$value" '.answer.done = [$v | splits(",") | select(. != "")
          | if test("^(keep|commit:[^:]+:[0-9a-f]{7,40}|(file|gone):/.+)$") then . else error("not a check: \(.)") end]' <<<"$patch" 2>/dev/null) ||
          die "done takes commit:<repo>:<hash>, file:<abs path>, gone:<abs path> or keep, comma-separated, not $value" ;;
      *) die "no job key $key: state, reason, branch, review, commits, pushed, suites, answer or done" ;;
    esac
  done
  local file job checked='' refusal='' round code_run events='[]' at began own full
  file=$(night_file "$id")
  if jq -e 'has("answer")' <<<"$patch" >/dev/null; then
    jq -e '.answer.words != null' <<<"$patch" >/dev/null || die "done= comes with answer=<Egor's words>"
    job=$(job_of "$file" "$ref" "$patch")
    [ -n "$job" ] || die "night $id has no job $ref"
    [ "$(jq -r .state <<<"$job")" = blocked-on-egor ] || die "answer= records Egor's answer to a trade: job $ref is not blocked-on-egor"
  fi
  if jq -e 'has("state") or has("commits")' <<<"$patch" >/dev/null; then
    job=$(job_of "$file" "$ref" "$patch")
    [ -n "$job" ] || die "night $id has no job $ref"
    branch=$(jq -r 'select(.state == "merged") | .branch // empty' <<<"$job")
    if [ -n "$branch" ] && own=$(own_commits "$id" "$branch") && [ "$own" != null ]; then
      commits_set=true
      full=$(full_commits "$job")
      patch=$(jq -c --argjson o "$own" --argjson g "$full" --argjson c "$(copies_of "$own" "$full")" \
        '.commits = $o | .integration = ($g - $o - $c | unique_by([.repo, .hash]))' <<<"$patch")
    fi
  fi
  if [ "$pushed" = true ]; then
    job=$(job_of "$file" "$ref" "$patch")
    [ -n "$job" ] || die "night $id has no job $ref"
    checked=$(jq -c '.commits + (.integration // [])' <<<"$job")
    [ "$checked" != '[]' ] || die "pushed=true needs the job's commits first"
    at=$(stamp) began=$SECONDS
    while IFS=$'\t' read -r repo hash; do
      dir=$(repo_dir "$repo") || die "no repository $repo: not an absolute path nor a basename in $sweep_repos"
      refusal=$(push_refusal "$dir" "$hash" "$id")
      [ -z "$refusal" ] || break
    done < <(jq -r '.[] | [.repo, .hash] | @tsv' <<<"$checked")
    checked_event push
  fi
  if jq -e 'has("state") or has("review")' <<<"$patch" >/dev/null; then
    job=$(job_of "$file" "$ref" "$patch")
    [ -n "$job" ] || die "night $id has no job $ref"
    round=$(jq -r 'select(.state == "merged") | .review // empty' <<<"$job")
    if [ -n "$round" ]; then
      at=$(stamp) began=$SECONDS
      refusal=$(review_refusal "$ref" "$round")
      checked_event review
    fi
    code_run=$(jq -r 'select(.state == "merged") | [.ref, .adopted[]?.branch]
      | map(strings | capture("(?<r>code-code-[0-9]{8}T[0-9]{6}Z(-[0-9a-f]+)?)$").r) | first // empty' <<<"$job")
    if [ -n "$code_run" ]; then
      at=$(stamp) began=$SECONDS
      refusal=$(code_refusal "$id" "$code_run" "${suites:-$(jq -r '.suites // ""' <<<"$job")}")
      checked_event code
    fi
  fi
  lock
  job=$(job_of "$file" "$ref" "$patch")
  [ -n "$job" ] || die "night $id has no job $ref"
  if $commits_set && [ -z "$pushed" ] &&
    [ "$(jq -c --arg r "$ref" 'first(.jobs[] | select(.ref == $r)) | .commits' "$file")" != "$(jq -c '.commits' <<<"$job")" ]; then
    patch=$(jq -c '.pushed = false' <<<"$patch")
    job=$(jq -c '.pushed = false' <<<"$job")
  fi
  if jq -e '.state == "blocked-on-egor" and (has("answer") | not)' <<<"$patch" >/dev/null &&
    [ "$(jq -r --arg r "$ref" 'first(.jobs[] | select(.ref == $r)) | .state' "$file")" != blocked-on-egor ]; then
    patch=$(jq -c '.answer = null' <<<"$patch")
    job=$(jq -c '.answer = null' <<<"$job")
  fi
  case $(jq -r '.state' <<<"$job") in
    left) [ "$(jq -r '.reason // ""' <<<"$job")" != "" ] || die "state left needs reason=<why it stayed>" ;;
    blocked-on-egor) [ "$(jq -r '.reason // ""' <<<"$job")" != "" ] ||
      die "state blocked-on-egor needs reason=<the trade Egor decides: each way's cost and loss, the recommendation>"
      [ "$(jq -r '.kind' <<<"$job")" != handoff ] || jq -e '.reason | test("Cost:") and test("Loss:") and test("Recommendation:")' <<<"$job" >/dev/null ||
        die "a handoff job blocked on Egor needs its trade in reason= as Cost:, Loss: and Recommendation:" ;;
  esac
  [ "$pushed" != true ] || [ "$(jq -c '.commits + (.integration // [])' <<<"$job")" = "$checked" ] ||
    die "the job's commits changed while origin was checked: set pushed=true again"
  night_set "$id" "$JQ_EVENTS"' (first(.jobs[] | select(.ref == $r)) | .state) as $was
    | .jobs |= map(if .ref == $r then . + $p else . end)
    | events($ev + [
        (if $p.suites == "passed" then {phase: "suites", job: $r} else empty end),
        (if ($p | has("state")) and $was == "blocked-on-egor" and $p.state != $was then {phase: "owner-resume", job: $r} else empty end),
        (if $p.state == "merged" then {phase: "landing", job: $r}
         elif $p.state == "blocked-on-egor" then {phase: "owner-pause", job: $r}
         elif $p | has("state") then {phase: "state", job: $r, state: $p.state} else empty end),
        (if $p.pushed == true then {phase: "pushed", job: $r} else empty end),
        ($p | del(.state, .suites) | if .pushed == true then del(.pushed) else . end | keys | if length > 0 then {phase: "set", job: $r, keys: .} else empty end)]; $t)' \
    --arg r "$ref" --argjson p "$patch" --argjson ev "$events" --arg t "$(stamp)" ||
    die "cannot write night $id"
  printf 'night %s: job %s %s\n' "$id" "$ref" "$(jq -r '[.state, (if .pushed then "pushed" else empty end)] | join(" ")' <<<"$job")"
  ! jq -e 'has("answer")' <<<"$patch" >/dev/null || trade_settle "$id" "$ref" "$id" || true
}

carry_list() { # id -> kind<TAB>slug<TAB>repo<TAB>what<TAB>log, one per job carry adds
  python3 -B "$repo_root/share/handoffs.py" | jq -r --slurpfile n "$(night_file "$1")" '
    [$n[0].jobs[] | select(.kind == "owner-chat" and .state != "failed-launch") | .handoffs[]?] as $owned
    | select(.live == [] and (.path | IN($owned[]) | not)) | ["handoff", .slug, .repo, .rel, ""] | @tsv'
  all_nights | jq -r --arg id "$1" '[.[] | select(.id != $id and .suites != null)] | first // empty | .suites.repos[]?
    | .repo as $r | .log as $l | .failed[]? | ["suite", "\($r | split("/") | last)-\(sub("\\.[a-z]+$"; ""))", $r, ., $l] | @tsv'
}

carry_brief() { # id kind ref repo what log worktree branch -> the brief file
  local id=$1 kind=$2 ref=$3 repo=$4 what=$5 log=$6 wt=$7 branch=$8 file="$nights_dir/$1.$3.brief.md" other outside
  {
    printf 'ROUND: none\n'
    # Every sweep repository: a handoff names a file (`stop-dispatch.sh`) far more often than its repository.
    for other in $(grep -vxF -e "$repo" -e '' "$sweep_repos" 2>/dev/null; [ "$kind" = suite ] || grep -vxF '' "$helper_repos" 2>/dev/null); do
      grep -qxF "$other" "$sweep_repos" 2>/dev/null || grep -qF "$(basename "$other")" "$repo/$what" 2>/dev/null || continue
      worktree_siblings "$branch" "$other" | sed 's/^/ADD-DIR: /'
    done
    printf 'Working directory: %s\n\n# Night %s job %s\n\n' "$wt" "$kind" "$ref"
    if [ "$kind" = handoff ]; then
      printf 'Night %s. Settle the handoff `%s/%s` in the worktree `%s` on branch `%s`; its copy there is `%s`.\n\n' "$id" "$repo" "$what" "$wt" "$branch" "$wt/$what"
      printf '1. Check in the code whether its cause still stands, then settle it one of two ways: fix it with a test red on the old code, and set its `Status:` line to `Status: settled %s: <one line>`; or, when only Egor'"'"'s word can settle it (a strategic change of course, or a serious downside against the gain; an unambiguous speed-up, or a recommendation to keep things as they are, is settled, never traded), reduce it to a trade: `Status: trade for Egor` with `Cost:`, `Loss:` and `Recommendation:` lines, and report those three lines under BLOCKED-ON-EGOR. A handoff to another chat is no verdict: the night owns it.\n' "$id"
      outside=$(python3 -B "$repo_root/share/handoffs.py" --outside "$repo/$what" 2>/dev/null | sed 's/.*/`&`/' | paste -sd, - | sed 's/,/, /g')
      [ -z "$outside" ] ||
        printf '   Not the night'"'"'s, so never a worktree, branch or commit there: %s. When the fix lies there, step 1'"'"'s last sentence yields: give the handoff a `To: «<chat>»` line naming the chat that works in that repository (`chat-find --recent`), keep its Status open and report that chat; the next carry hands it over.\n' "$outside"
    else
      printf 'Night %s. The full run at the previous night'"'"'s Close failed `%s` in %s (log `%s`). Make it green in the worktree `%s` on branch `%s`: fix the code or the suite; a load-only failure is made load-robust; every assert keeps its coverage.\n' "$id" "$what" "$repo" "$log" "$wt" "$branch"
    fi
    printf '2. `%s/docs/doctor-fix.md` §1, §3, §4 and Night bind you: commit on the branch (one long line), never push, never touch a main checkout, never ask Egor; markdown is net zero against `refs/night/%s/base`.\n' "$repo_root" "$id"
    printf '3. Report: the outcome, the test, the commits as repo@hash.\n'
  } >"$file" || return 1
  printf '%s\n' "$file"
}

owner_busy() { # night-file -> why no further owner chat starts now; nothing when one may
  local max=${NIGHT_RUN_OWNER_CHATS:-3}
  [ "$(jq '[.jobs[] | select(.kind == "owner-chat" and .state == "pending")] | length' "$1")" -lt "$max" ] ||
    { printf '%s owner chats at work\n' "$max"; return 0; }
  slot_room || true
}

owner_prompt() { # id ref branch sweep batch-json worktrees -> the prompt file
  local id=$1 ref=$2 branch=$3 file="$nights_dir/$1.$2.prompt.md" outside
  {
    jq -r --arg s "$4" 'select(.doubt == true) | "Owner check first: this batch was matched to you by edits and mentions of its files, not by a To: line\(if (.scores | length) > 0 then " (" + (.scores | to_entries | sort_by(-.value) | .[0:3] | map("«\(.key)» \(.value)") | join(", ")) + ")" else "" end). If these handoffs are not yours, SendMessage the sweep chat \($s) naming the better owner, touch nothing and stop.\n"' <<<"$5"
    printf 'Night %s: the night hands you your open handoffs as one batch; you own them and hold their context.\n\n' "$id"
    jq -r '.handoffs[] | "- `\(.)`"' <<<"$5"
    printf '\n1. Settle each one: fix it with a test red on the old code and set its `Status:` line to `Status: settled %s: <one line>`; or, when only Egor'"'"'s word can settle it (a strategic change of course, or a serious downside against the gain; an unambiguous speed-up, or a recommendation to keep things as they are, is settled, never traded), reduce it to a trade: `Status: trade for Egor` with `Cost:`, `Loss:` and `Recommendation:` lines; or close it with the evidence that its cause no longer stands.\n' "$id"
    printf '2. Work on branch `%s` in its night worktrees: %s. Another repository gets `<repo>/.claude/worktrees/night-%s-%s` on the same branch from `refs/night/%s/base`. Run only the suites covering your change (`tests/affected <files>`), never `tests/run-all`. Commit on the branch (one long line); never push, never merge, never touch a main checkout, never ask Egor; markdown is net zero.\n' \
      "$branch" "$(sed 's/.*/`&`/' <<<"$6" | paste -sd, - | sed 's/,/, /g')" "$id" "$ref" "$id"
    outside=$(jq -r '.handoffs[]' <<<"$5" | xargs python3 -B "$repo_root/share/handoffs.py" --outside 2>/dev/null |
      sort -u | sed 's/.*/`&`/' | paste -sd, - | sed 's/,/, /g')
    [ -z "$outside" ] ||
      printf '   Not the night'"'"'s, so it lands none of your work there: %s. Fix those on their own branch and landing, as your day work.\n' "$outside"
    printf '3. When done, SendMessage the sweep chat %s (the night may have moved to another chat since: `%s "$(jq -r .session %s)"` names the one now): per handoff its outcome, the commits as repo@hash, each trade'"'"'s three lines.\n' \
      "$4" "$repo_root/bin/chat-name" "$(night_file "$id")"
  } >"$file" || return 1
  printf '%s\n' "$file"
}

carry_owner_chats() { # id -> <ref>\t<prompt>\topened <account> <session>|message <owner>, one per owner chat given its batch
  local id=$1 file batch owner session ref branch wts prompt why opened sweep repo
  local -a repos
  file=$(night_file "$id")
  sweep=$("$repo_root/bin/chat-name" "$(jq -r '.session // "-"' "$file")" 2>/dev/null) && sweep="«${sweep}»" ||
    sweep="running night $id"
  while IFS= read -r batch; do
    owner=$(jq -r .owner <<<"$batch") session=$(jq -r .session <<<"$batch")
    ref="owner-chat-$(jq -r .slug <<<"$batch")" branch="night/$id/owner-chat-$(jq -r .slug <<<"$batch")"
    ! jq -e --arg r "$ref" 'any(.jobs[]; .ref == $r)' "$file" >/dev/null || continue
    batch=$(jq -c --slurpfile n "$file" '.handoffs -= [$n[0].jobs[] | select(.kind == "handoff" and .state != "failed-launch") | .path // empty]' <<<"$batch")
    [ "$(jq '.handoffs | length' <<<"$batch")" -gt 0 ] || continue
    why=$(owner_busy "$file")
    if [ -n "$why" ]; then
      printf 'night-run: owner chat «%s» deferred (%s): its handoffs are night jobs\n' "$owner" "$why" >&2
      continue
    fi
    "$script_path" job "$id" add owner-chat "$ref" --branch "$branch" >/dev/null || continue
    lock
    night_set "$id" '.jobs |= map(if .ref == $r then . + {owner: $b.owner, session: $b.session,
        via: (if $b.live then "message" else "open" end), handoffs: $b.handoffs} else . end)' \
      --arg r "$ref" --argjson b "$batch" || die "cannot write night $id"
    unlock
    repos=()
    while IFS= read -r repo; do
      jq -e --arg r "$repo" 'IN(.repos[]; $r)' <<<"$batch" >/dev/null ||
        grep -qF "$(basename "$repo")" $(jq -r '.handoffs[]' <<<"$batch") 2>/dev/null && repos+=("$repo")
    done < <(grep -hvxF '' "$sweep_repos" "$helper_repos" 2>/dev/null)
    wts=$(worktree_siblings "$branch" ${repos[@]+"${repos[@]}"} 2>/dev/null)
    if [ -z "$wts" ]; then why='no night worktree'
    elif ! prompt=$(owner_prompt "$id" "$ref" "$branch" "$sweep" "$batch" "$wts"); then why='prompt not written'
    fi
    if [ -n "$why" ]; then
      "$script_path" job "$id" set "$ref" state=failed-launch reason="not carried: $why" >/dev/null
      continue
    fi
    if [ "$(jq -r .live <<<"$batch")" = true ]; then
      printf '%s\t%s\tmessage %s\n' "$ref" "$prompt" "$owner"
      continue
    fi
    if ! opened=$(CHAT_OPEN_OPENER="${NIGHT_RUN_OPENER:-open -a Terminal}" \
        CHAT_OPEN_WORKER_PICK="${NIGHT_RUN_WORKER_PICK:-$repo_root/bin/worker-pick}" \
        chat_open "$nights_dir/$id.$ref.command" "$(jq -r '.cwd' <<<"$batch")" "$(<"$prompt")" "$session" 2>&1); then
      "$script_path" job "$id" set "$ref" state=failed-launch reason="owner chat did not open: $opened" >/dev/null
      continue
    fi
    lock
    night_set "$id" '.jobs |= map(if .ref == $r then . + {account: $a} else . end)' --arg r "$ref" --arg a "${opened%% *}" ||
      die "cannot write night $id"
    unlock
    printf '%s\t%s\topened %s\n' "$ref" "$prompt" "$opened"
  done < <(python3 -B "$repo_root/share/handoffs.py" --batches)
}

trade_brief() { # id ref repo worktree branch -> the brief file carrying out Egor's answer to a trade
  local id=$1 ref=$2 file="$nights_dir/$1.$2.brief.md"
  {
    printf 'ROUND: none\nWorking directory: %s\n\n# Night trade job %s\n\n' "$4" "$ref"
    jq -r --arg id "$id" --arg wt "$4" --arg b "$5" 'first(.jobs[] | select(.ref == $ARGS.named.ref))
      | "Night \($id). Egor answered a trade of night \(.from.night) (job \(.from.ref)); carry out his answer in the worktree `\($wt)` on branch `\($b)`.\n",
        "The trade: \(.from.trade // "-")", "His answer: \(.answer.words)",
        (if (.answer.done // []) == [] then empty else "It is carried out once these hold: \(.answer.done | join(", "))" end),
        (if .from.path then "Its handoff: `\(.from.path)`; once done set its `Status:` line to `Status: settled \($id): <one line>`." else empty end), ""' \
      --arg ref "$ref" "$(night_file "$id")"
    printf '1. Do what his answer says, nothing past it; a test red on the old code where code changes.\n'
    printf '2. `%s/docs/doctor-fix.md` §1, §3, §4 and Night bind you: commit on the branch (one long line), never push, never touch a main checkout, never ask Egor; markdown is net zero against `refs/night/%s/base`.\n' "$repo_root" "$id"
    printf '3. Report: the outcome, the test, the commits as repo@hash.\n'
  } >"$file" || return 1
  printf '%s\n' "$file"
}

cmd_carry() {
  local id=${1:-} kind slug repo what log ref branch wt err brief path top root
  [ -n "$id" ] && [ $# -eq 1 ] || usage
  known_night "$id"
  carry_owner_chats "$id"
  while IFS=$'\t' read -r kind slug repo what log; do
    ref="$kind-$slug"
    if [ "$kind" = handoff ]; then
      ! jq -e --arg p "$repo/$what" --arg r "$ref" 'any(.jobs[]; .kind == "handoff" and (.path == $p or (.path == null and .ref == $r)))' \
        "$(night_file "$id")" >/dev/null || continue
      ! jq -e --arg r "$ref" 'any(.jobs[]; .ref == $r)' "$(night_file "$id")" >/dev/null || ref="$kind-$(basename "$repo")-$slug"
    fi
    branch="night/$id/$ref" wt="$repo/.claude/worktrees/night-$id-$ref"
    ! jq -e --arg r "$ref" 'any(.jobs[]; .ref == $r)' "$(night_file "$id")" >/dev/null || continue
    "$script_path" job "$id" add "$kind" "$ref" --branch "$branch" >/dev/null || continue
    if [ "$kind" = handoff ]; then
      lock
      night_set "$id" '.jobs |= map(if .ref == $r then . + {path: $p} else . end)' --arg r "$ref" --arg p "$repo/$what" ||
        die "cannot write night $id"
      unlock
    fi
    if ! err=$(worktree_new "$repo" "$branch" 2>&1 >/dev/null) ||
        ! brief=$(carry_brief "$id" "$kind" "$ref" "$repo" "$what" "$log" "$wt" "$branch"); then
      "$script_path" job "$id" set "$ref" state=failed-launch reason="not carried: ${err:-brief not written}" >/dev/null
      continue
    fi
    printf '%s\t%s\t%s\n' "$ref" "$brief" "$wt"
  done < <(carry_list "$id")
  while IFS=$'\t' read -r ref path; do
    [ ! -e "$nights_dir/$id.$ref.brief.md" ] || continue
    if [ -n "$path" ] && git_top "$(dirname "$path")"; then repo=$root; else repo=$(main_checkout); fi
    branch="night/$id/$ref" wt="$repo/.claude/worktrees/night-$id-$ref"
    if ! err=$(worktree_new "$repo" "$branch" 2>&1 >/dev/null) ||
        ! brief=$(trade_brief "$id" "$ref" "$repo" "$wt" "$branch"); then
      "$script_path" job "$id" set "$ref" state=failed-launch reason="not carried: ${err:-brief not written}" >/dev/null
      continue
    fi
    printf '%s\t%s\t%s\n' "$ref" "$brief" "$wt"
  done < <(jq -r '.jobs[] | select(.kind == "trade" and .state == "pending") | [.ref, (.from.path // "")] | @tsv' "$(night_file "$id")")
}

cmd_suites() {
  local id=${1:-} repo name log rc rows='[]' pid since
  local journal=${RUN_SUITES_JOURNAL:-${XDG_CACHE_HOME:-$HOME/.cache}/run-suites/runs.jsonl}
  [ -n "$id" ] && [ $# -le 2 ] || usage
  known_night "$id"
  if [ "${2:-}" != --wait ]; then
    [ -z "${2:-}" ] || usage
    perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' "$script_path" suites "$id" --wait \
      </dev/null >"$nights_dir/$id.suites.log" 2>&1 &
    printf 'night %s: full suites run in the background, pid %s\n' "$id" "$!"
    return 0
  fi
  lock
  night_set "$id" '.suites = {started_at: $t, finished_at: null, repos: []}' --arg t "$(stamp)" || die "cannot write night $id"
  unlock
  while IFS= read -r repo; do
    [ -n "$repo" ] && [ -x "$repo/tests/run-all" ] || continue
    name=$(basename "$repo") log="$nights_dir/$id.suites.$name.log"
    since=$(date +%s)
    env -u CLAUDE_CODE_SESSION_ID -u CLAUDE_LAUNCHER_SESSION bash "$repo/tests/run-all" >"$log" 2>&1 &
    pid=$!
    wait "$pid"
    rc=$?
    rows=$(jq -c --arg r "$repo" --arg l "$log" --argjson x "$rc" --slurpfile run <(jq -cR --argjson p "$pid" --argjson t "$since" \
      'fromjson? | select(.kind == "suites" and .pid == $p and .started_at >= $t)' "$journal" 2>/dev/null) \
      '(($run | last // {}).suites // {}) as $s | . + [{repo: $r, exit: $x, log: $l,
      passed: ([$s[] | select(.rc == 0)] | length), failed: ([$s | to_entries[] | select(.value.rc != 0) | .key]
        | if length == 0 and $x != 0 then ["run-all"] else . end)}]' <<<"$rows")
  done <"$sweep_repos"
  lock
  night_set "$id" '.suites.finished_at = $t | .suites.repos = $r' --arg t "$(stamp)" --argjson r "$rows" || die "cannot write night $id"
}

cmd_finish() {
  local id=${1:-} pruned at began file
  [ -n "$id" ] && [ $# -eq 1 ] || usage
  known_night "$id"
  lock
  jq -e '.finished_at == null' "$(night_file "$id")" >/dev/null || die "night $id is already finished"
  [ "$(night_status "$(night_file "$id")")" != running ] || orchestrator_caller "$(night_file "$id")" ||
    die "night $id is still running: $(jq -r '"its orchestrator chat \(.session // "(opening, pid \(.opener))") has run since \(.started_at)"' \
      "$(night_file "$id")") and only it finishes the night."
  night_set "$id" "$JQ_EVENTS"' .finished_at = $t | .doctors_after = $after | .doctor_states_after = $states
    | .doctor_problems_after = $problems
    | .jobs |= map(if .state == "pending" then .state = "left" | .reason = "no outcome recorded by the close" else . end)
    | events([{phase: "finish", pred: "jobs"}]; $t)' \
    --arg t "$(stamp)" --argjson after "$(doctor_counts)" --argjson states "$(doctor_states)" \
    --argjson problems "$(doctor_problems)" || die "cannot write night $id"
  unlock
  printf 'night %s finished\n' "$id"
  at=$(stamp) began=$SECONDS
  pruned=$(prune_landed)
  [ -z "$pruned" ] || printf '%s\n' "$pruned"
  lock
  night_set "$id" "$JQ_EVENTS"' .leftovers = [$p | split("\n")[] | capture("^leftover (?<repo>[^ ]+) (?<branch>[^:]+): (?<why>.*)$")]
    | .held = [$p | split("\n")[] | capture("^held (?<repo>[^ ]+) (?<branch>[^:]+): (?<why>.*)$")]
    | events([{phase: "prune", at: $at, pred: "last", secs: $s}]; $t)' \
    --arg p "$pruned" --arg at "$at" --argjson s "$((SECONDS - began))" --arg t "$(stamp)" || die "cannot write night $id"
  for file in "$holds_dir"/*.json; do
    if jq -e --arg t "$at" '.at <= $t' "$file" >/dev/null 2>&1; then rm -f "$file"; fi
  done
  unlock
}

done_jobs() { # -> branch<TAB>ref<TAB>state<TAB>night per nothing-to-do or settled job of every night
  cat "$nights_dir"/*.json 2>/dev/null | jq -r "$JQ_DONE_JOB"' .id as $n | .jobs[]? | select(done_job)
    | [job_branch($n), .ref, .state, $n] | @tsv' 2>/dev/null
}

branch_row() { # repo worktree-or-empty branch-or-empty main-checkout(0|1) locked(0|1) -> TSV row; reads HELD, DONE_JOBS
  local repo=$1 wt=$2 branch=$3 ref head behind ahead landed=false dirty=0 night='' why='' state=live hold cherry job inside
  ref=${branch:+refs/heads/$branch}
  head=$(git -C "${wt:-$repo}" rev-parse -q --verify "${ref:-HEAD}^{commit}") || return 0
  read -r behind ahead < <(git -C "$repo" rev-list --left-right --count "refs/heads/main...$head")
  [[ $branch == night/*/* ]] && night=${branch#night/} && night=${night%%/*}
  if git -C "$repo" merge-base --is-ancestor "$head" refs/heads/main ||
    git -C "$repo" merge-base --is-ancestor "$head" refs/remotes/origin/main 2>/dev/null; then landed=true
  elif [ -n "$night" ] && [ "$head" = "$(git -C "$repo" rev-parse -q --verify "refs/night/$night/base")" ]; then landed=true
  # cherry skips merges, so a merge's own resolution never counts as landed by patch equivalence.
  elif cherry=$(git -C "$repo" cherry refs/heads/main "$head" 2>/dev/null) && ! grep -q '^+' <<<"$cherry" &&
    [ -z "$(git -C "$repo" rev-list --merges -1 "refs/heads/main..$head")" ]; then landed=true; fi
  [ -z "$wt" ] || dirty=$(GIT_OPTIONAL_LOCKS=0 git -C "$wt" status --porcelain --untracked-files=all 2>/dev/null | wc -l | tr -d ' ')
  if [ "$4" = 1 ]; then why='main checkout'
  elif [ "$5" = 1 ]; then why='locked'
  elif [ -n "$night" ]; then
    [ ! -s "$(night_file "$night")" ] || [ "$(night_status "$(night_file "$night")" 2>/dev/null)" != running ] || why="night $night running"
  fi
  hold=$(awk -F '\t' -v r="$repo" -v b="$branch" '$1 == r && $2 == b { print $3; exit }' <<<"$HELD")
  if [ -z "$why" ] && [ -n "$branch" ] && [ -n "$hold" ]; then
    state=held why="Egor: $hold"
  elif [ -z "$why" ]; then
    state=landed
    $landed || { state=leftover why="$ahead unlanded commits"; }
    [ "$dirty" = 0 ] || { state=leftover why="${why:+$why, }$dirty uncommitted files"; }
    [ "$state" = landed ] || [ -n "$branch" ] || why="$why, detached HEAD"
    job=$(awk -F '\t' -v b="$branch" '$1 == b { print $2 " " $3; exit }' <<<"$DONE_JOBS")
    [ "$state" = landed ] || [ -z "$night" ] || [ -z "$job" ] || state=superseded why="by job $job, $why"
    # A night worker outlives a dead orchestrator and cannot ask for a hold: adopting under it commits its half-done edit.
    [ "$state" != leftover ] || [ -z "$night" ] || [ -z "$wt" ] || ! inside=$(cwd_held "$wt") || state=live why="night $night worker: $inside"
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$repo" "${branch:--}" "${wt:--}" "$landed" "$ahead" "$behind" "$dirty" "$state" "$why"
}

# Every non-main branch and worktree of the sweep repositories, every night's included, and the night/* ones
# of the helper repositories: repo branch|-
# worktree|- landed ahead behind dirty live|landed|leftover|superseded why. Landed = in main, or a night branch still
# at its night's base, since a nothing-to-do job never committed. Superseded = an unlanded night branch whose
# job closed without landing it (nothing-to-do, settled): never landed nor adopted, finish prunes it with its
# tip kept. `-`, not an empty field: a tab is IFS whitespace, so read would shift every field after an empty one.
branch_rows() { # [repo...], default the sweep repositories and the helpers' night branches; ROWS_BRANCH=b: b's rows only
  local repo wt branch main locked seen HELD DONE_JOBS only want=${ROWS_BRANCH:-}
  [ $# -gt 0 ] || [ -r "$sweep_repos" ] || return 0
  HELD=$(cat "$holds_dir"/*.json 2>/dev/null | jq -r '.words as $w | .branches[]? | [.repo, .branch, $w] | @tsv' 2>/dev/null)
  DONE_JOBS=$(done_jobs)
  while IFS=$'\t' read -r repo only; do
    [ -n "$repo" ] && [ -d "$repo" ] || continue
    git -C "$repo" rev-parse -q --verify refs/heads/main >/dev/null || continue
    seen=' main '
    while IFS=$'\t' read -r wt branch main locked; do
      [ "$branch" != - ] || branch=''
      [ -z "$only" ] || [[ $branch == night/* ]] || continue
      [ -z "$want" ] || [ "$branch" = "$want" ] || continue
      [ "$branch" = main ] || [ ! -d "$wt" ] || { seen="$seen$branch "; branch_row "$repo" "$wt" "$branch" "$main" "$locked"; }
    done < <(worktree_lines "$repo")
    while IFS= read -r branch; do
      [ -z "$only" ] || [[ $branch == night/* ]] || continue
      [ -z "$want" ] || [ "$branch" = "$want" ] || continue
      [[ "$seen" == *" $branch "* ]] || branch_row "$repo" '' "$branch" 0 0
    done < <(git -C "$repo" for-each-ref --format='%(refname:short)' refs/heads)
  done < <(if [ $# -gt 0 ]; then printf '%s\n' "$@"; else cat "$sweep_repos"; grep -vxF '' "$helper_repos" 2>/dev/null | sed $'s/$/\tnight/'; fi)
}

worktree_lines() { # repo -> worktree<TAB>branch|-<TAB>main-checkout(0|1)<TAB>locked(0|1) per worktree
  local line wt='' branch='' main=1 locked=0
  while IFS= read -r line; do
    case $line in
      "worktree "*) wt=${line#worktree } branch='' locked=0 ;;
      "branch refs/heads/"*) branch=${line#branch refs/heads/} ;;
      locked | "locked "*) locked=1 ;;
      '')
        [ -z "$wt" ] || printf '%s\t%s\t%s\t%s\n' "$wt" "${branch:--}" "$main" "$locked"
        wt='' main=0 ;;
    esac
  done < <(git -C "$1" worktree list --porcelain; echo)
}

cmd_speed_gate() { # id ref -> exit 3 while the job's night worktree is worked in, or once the Speed window closed before the fixer's first start
  local id=$1 ref=$2 file run verdict reason="speed window closed ($SPEED_WINDOW_H h)" repo wt holders
  while IFS= read -r repo; do
    wt="$repo/.claude/worktrees/night-$id-$ref"
    [ -d "$wt" ] && holders=$(cwd_holders "$wt") && [ -n "$holders" ] || continue
    printf 'night %s job %s: its worktree %s is still worked in by %s; it is handed out again once they exit\n' \
      "$id" "$ref" "$wt" "${holders//$'\n'/; }"
    exit 3
  done < <(grep -hvxF '' "$sweep_repos" "$helper_repos" 2>/dev/null)
  file=$(night_file "$id") run="${nights_dir%/*}/runs/$ref.json"
  [ -s "$file" ] && jq -e "$JQ_SPEED_RUN"' speed_run' "$run" >/dev/null 2>&1 || return 0
  lock
  verdict=$(jq -r --arg r "$ref" --argjson h "$SPEED_WINDOW_H" 'if any(.events[]?; .phase == "speed-start" and .job == $r) then "again"
    elif now < (.started_at | fromdateiso8601) + $h * 3600 then "open" else "closed" end' "$file") || die "cannot read night $id"
  case $verdict in
    again) return 0 ;;
    open) night_events "$id" "$(jq -cn --arg r "$ref" '[{phase: "speed-start", job: $r}]')" || die "cannot write night $id"
      return 0 ;;
  esac
  unlock
  "$repo_root/bin/doctor-fix" abandon "$ref" --reason "$reason" >/dev/null 2>&1
  ! jq -e --arg r "$ref" 'any(.jobs[]; .ref == $r)' "$file" >/dev/null ||
    (job_set "$id" "$ref" state=left "reason=$reason" >/dev/null) || die "cannot leave job $ref of night $id"
  printf '%s: night %s job %s left, its fixer not started\n' "$reason" "$id" "$ref"
  exit 3
}

chat_tops() { # session -> the checkouts that chat worked in: its review journal and the current toplevel
  cat "$HOME/.cache/claude/review-journal/$1.repos" 2>/dev/null; git rev-parse --show-toplevel 2>/dev/null
}

cmd_hold() {
  local sid=${CLAUDE_CODE_SESSION_ID:-} grant words tops repo wt branch main branches='[]' tmp until
  [ $# -eq 0 ] || usage
  [ -n "$sid" ] || die "hold runs inside the chat Egor said «сделай холд» in"
  . "${WORDS_LIB:-$HOME/.claude/hooks/lib/words.sh}" 2>/dev/null || die "cannot read the word store library"
  grant=$(words_grant_fresh "$sid" night-hold) || die "no fresh night-hold word of Egor's in this chat: «сделай холд» opens it"
  words=$(jq -r '.excerpt // empty' <<<"$grant")
  tops=$(chat_tops "$sid")
  [ -r "$sweep_repos" ] || die "no sweep repositories at $sweep_repos"
  while IFS= read -r repo; do
    [ -n "$repo" ] && [ -d "$repo" ] || continue
    while IFS=$'\t' read -r wt branch main _; do
      [ "$main" = 0 ] && [ "$branch" != - ] && grep -qxF -- "$wt" <<<"$tops" || continue
      branches=$(jq -c --arg r "$repo" --arg b "$branch" --arg w "$wt" '. + [{repo: $r, branch: $b, worktree: $w}]' <<<"$branches")
    done < <(worktree_lines "$repo")
  done <"$sweep_repos"
  [ "$branches" != '[]' ] || die "this chat has no worktree in the sweep repositories to hold"
  [ ! -s "$holds_dir/$sid.json" ] ||
    branches=$(jq -c --argjson b "$branches" '.branches + $b | unique_by([.repo, .branch])' "$holds_dir/$sid.json") ||
    die "cannot read $holds_dir/$sid.json"
  until=$(open_nights | head -1)
  mkdir -p "$holds_dir" && tmp=$(mktemp "$holds_dir/.hold.XXXXXX") || die "cannot write under $holds_dir"
  jq -n --arg s "$sid" --arg w "$words" --arg at "$(stamp)" --argjson b "$branches" \
    '{session: $s, words: $w, at: $at, branches: $b}' >"$tmp" && mv -f "$tmp" "$holds_dir/$sid.json" ||
    { rm -f "$tmp"; die "cannot write $holds_dir/$sid.json"; }
  jq -r --arg w "$words" --arg u "${until:+night $until}" '.[] | "held \(.repo | split("/") | last) \(.branch) until \(if $u == "" then "the next night" else $u end) finishes: \($w)"' <<<"$branches"
}

checkout_rows() {
  local repo om ahead behind files
  [ -r "$sweep_repos" ] || return 0
  while IFS= read -r repo; do
    [ -n "$repo" ] && [ -d "$repo" ] && om=$(git -C "$repo" rev-parse -q --verify refs/remotes/origin/main) || continue
    read -r ahead behind < <(git -C "$repo" rev-list --left-right --count "HEAD...$om")
    [ "${behind:-0}" != 0 ] || continue
    files=$(comm -12 <(git -C "$repo" diff --no-renames --name-only HEAD "$om" | sort) \
      <(GIT_OPTIONAL_LOCKS=0 git -C "$repo" status --porcelain --untracked-files=all --no-renames | cut -c4- | sort) | paste -sd ' ' -)
    printf 'checkout %s: %s%s\n' "$(basename "$repo")" "$([ "$ahead" = 0 ] && echo "behind $behind" || echo diverged)" "${files:+, WIP in the way: $files}"
  done <"$sweep_repos"
}

cmd_leftovers() {
  case ${1:-} in
    '') branch_rows | awk -F '\t' '{ n = split($1, p, "/")
      printf "%s %s · %s · %s · +%s/-%s main · %s dirty · %s%s\n", p[n], ($2 == "-" ? "(detached)" : $2),
        ($3 == "-" ? "no worktree" : $3), ($4 == "true" ? "landed" : "unlanded"), $5, $6, $7, $8, ($9 == "" ? "" : " (" $9 ")") }'
      checkout_rows ;;
    --json) branch_rows | jq -Rsc '[split("\n")[] | select(. != "") | split("\t")
      | {repo: .[0], branch: (if .[1] == "-" then null else .[1] end), worktree: (if .[2] == "-" then null else .[2] end),
         landed: (.[3] == "true"), ahead: (.[4] | tonumber), behind: (.[5] | tonumber), dirty: (.[6] | tonumber),
         live: (.[7] == "live"), state: .[7], why: (if .[8] == "" then null else .[8] end)}]' ;;
    *) usage ;;
  esac
}

debt_price() { # [--due] repo... -> path<TAB>files<TAB>lines<TAB>cut per priced checkout, last the total; nothing when unpriced
  local out rc=0 repo args=()
  [ "${1:-}" != --due ] || { args+=(--due); shift; }
  for repo in "$@"; do args+=(--repo "$repo"); done
  out=$(mktemp) || return 1
  review-bench review --debt "${args[@]}" --tier T2 --price >"$out" 2>&1 </dev/null || rc=$?
  if [ "$rc" = 0 ]; then
    awk -F ' · ' '
      match($0, /^  [^ ]+\/ = /) { rest = substr($0, RLENGTH + 1); i = index(rest, ": ")
        path[substr($0, 3, RLENGTH - 6)] = i ? substr(rest, 1, i - 1) : rest; next }
      sub(/^reviewing /, "") { single = substr($0, 1, index($0, ": ") - 1); next }
      NF >= 5 && $2 ~ / file\(s\)$/ { label = $1; sub(/^ +/, "", label)
        cut = $5 ~ /^whole/ ? "whole" : ($5 + 0 == 1 ? "1 chunk" : ($5 + 0) " chunks")
        row = sprintf("%d\t%d\t%s", $2, $3, cut)
        if (label == "total") { if (single != "") print single "\t" row; print "total\t" row }
        else if (label in path) print path[label] "\t" row }' "$out"
  elif grep -qE 'target is empty|is in (stable or critical )?review debt|has no unread content' "$out"; then
    printf 'total\t0\t0\twhole\n'
  else
    printf 'night-run: review-bench cannot price the debt: %s\n' "$(tail -n 1 "$out")" >&2
  fi
  rm -f "$out"
}

frame_rows() { # word -> lines `<label> · <segment> · …` on stdin as one report_frame block document
  local room
  room=$(python3 -B -c 'import sys; sys.path.insert(0, sys.argv[1]); import report_frame as f; print(f.WIDTH - f.LABEL_WIDTH)' \
    "$repo_root/share") || return 1
  jq -Rsc --arg word "$1" --argjson room "$room" '
    def pack: reduce .[] as $s ([]; if length > 0 and ((.[-1] + " · " + $s) | length) <= $room
      then .[-1] += " · " + $s else . + [$s] end);
    {word: $word, rows: [split("\n")[] | select(. != "")
      | (capture("^(?<i> *)(?<l>.*)$") | [.i + (.l | split(" · ")[0]), (.l | split(" · ")[1:] | pack)])]}'
}

table_block() { # time_budget.py table -> its block document, the cells right-aligned in compact columns
  jq -Rsc '[split("\n")[] | select(. != "") | [splits(" {3,}")]] as $t
    | [range(1; $t[0] | length) as $c | [$t[][$c] // "" | length] | max] as $w
    | {word: "night · \($t[0][-1])", rows: [$t[] | [.[0], ([.[1:] | to_entries[]
        | ($w[.key] - (.value | length)) as $pad | (if $pad > 0 then " " * $pad else "" end) + .value] | join("  "))]]}' <<<"$1"
}

post_block() { # id -> the block document on stdin posted to Egor's chat
  "${NIGHT_RUN_REPORT_BUS:-$repo_root/bin/report-bus}" post --kind notice --id "$1-$(date +%s)-$$" ||
    printf 'night-run: the %s block did not reach report-bus\n' "$1" >&2
}

price_of() { # price-rows path -> lines<TAB>files<TAB>cut, ? when the review could not price
  [ -n "$1" ] || { printf '?\t?\t?\n'; return; }
  awk -F '\t' -v p="$2" '$1 == p { print $3 "\t" $2 "\t" $4; found = 1; exit } END { if (!found) print "0\t0\twhole" }' <<<"$1"
}

survey_lines() { # price due-price repo... -> the survey's lines
  local price=$1 due=$2 root total=0 dirty lines files cut due_lines due_files branch wt landed ahead behind state why reason take
  shift 2
  for root in "$@"; do
    dirty=$(GIT_OPTIONAL_LOCKS=0 git -C "$root" status --porcelain --untracked-files=all 2>/dev/null | wc -l | tr -d ' ')
    total=$((total + dirty))
    IFS=$'\t' read -r lines files cut < <(price_of "$price" "$root")
    IFS=$'\t' read -r due_lines due_files _ < <(price_of "$due" "$root")
    printf '%s · debt %s lines/%s files · due %s lines/%s files · %s dirty · %s\n' "${root##*/}" "$lines" "$files" \
      "$due_lines" "$due_files" "$dirty" "$cut"
    while IFS=$'\t' read -r _ branch wt landed ahead behind dirty state why; do
      [ "$wt" != - ] && wt=$(cd -P "$wt" 2>/dev/null && pwd) && [ "$wt" != "$root" ] || continue
      total=$((total + dirty))
      case $state in
        held) reason="Egor's hold" ;;
        live) case $why in
            night*running) reason='night running' ;;
            *) reason=$why ;;
          esac ;;
        landed) reason=landed ;;
        superseded) reason='superseded by job state' ;;
        *) if [ "$landed" = true ]; then reason='uncommitted files'; else reason='unlanded commits'; fi ;;
      esac
      case $state in live | held) take=keep ;; superseded) [ "$dirty" = 0 ] && take=drop || take=keep ;; *) take=take ;; esac
      [ "$branch" != - ] || branch="${wt##*/} (detached)"
      printf '  %s · +%s/-%s main · %s dirty · debt %s · %s (%s)\n' "$branch" "$ahead" "$behind" "$dirty" \
        "$(price_of "$price" "$wt" | cut -f1)" "$take" "$reason"
    done < <(branch_rows "$root")
  done
  IFS=$'\t' read -r lines files cut < <(price_of "$price" total)
  IFS=$'\t' read -r due_lines due_files _ < <(price_of "$due" total)
  printf 'total · debt %s lines/%s files · due %s lines/%s files · %s dirty · %s\n' "$lines" "$files" \
    "$due_lines" "$due_files" "$total" "$cut"
}

cmd_survey() {
  local post=false repos=() dir top root price out
  while [ $# -gt 0 ]; do
    case $1 in
      --post) post=true ;;
      -*) usage ;;
      *) dir=$(repo_dir "$1") && git_top "$dir" || die "not a repository: $1"
         repos+=("$root") ;;
    esac
    shift
  done
  if [ ${#repos[@]} -eq 0 ] && [ -r "$sweep_repos" ]; then
    while IFS= read -r dir; do
      [ -n "$dir" ] && [ -d "$dir" ] && git_top "$dir" && repos+=("$root")
    done <"$sweep_repos"
  fi
  [ ${#repos[@]} -gt 0 ] || die "no repositories to survey"
  price=$(debt_price "${repos[@]}")
  out=$(survey_lines "$price" "$(debt_price --due "${repos[@]}")" "${repos[@]}")
  printf '%s\n' "$out"
  ! $post || printf '%s\n' "$out" | frame_rows survey | post_block night-survey
}

# A superseded branch is pruned only once its tip is kept: refs/night/<night>/pruned/<rest> holds it past gc and
# its job's pruned[] records it, so `git branch <name> <tip>` restores it.
keep_tip() { # repo branch -> the tip kept for restore, else fails saying why
  local night=${2#night/} tip keep
  night=${night%%/*} keep="refs/night/$night/pruned/${2#night/*/}"
  tip=$(git -C "$1" rev-parse -q --verify "refs/heads/$2^{commit}") && git -C "$1" update-ref "$keep" "$tip" ||
    { printf 'cannot keep its tip under %s\n' "$keep"; return 1; }
  # The superseding job may be another night's, added with --branch: its night, not the name's, gets the record.
  night=$(done_jobs | awk -F '\t' -v b="$2" '$1 == b { print $4; exit }')
  lock
  [ -n "$night" ] && night_set "$night" "$JQ_DONE_JOB"' if any(.jobs[]; done_job and job_branch($n) == $b) | not then error("no job superseded \($b)")
      else .jobs |= map(if done_job and job_branch($n) == $b then .pruned = ((.pruned // [])
      + [{repo: $r, branch: $b, tip: $tip, ref: $k, at: $t}]) else . end) end' \
    --arg n "$night" --arg b "$2" --arg r "$(basename "$1")" --arg tip "$tip" --arg k "$keep" --arg t "$(stamp)" ||
    { unlock; printf 'cannot record its tip %s in night %s\n' "$tip" "$night"; return 1; }
  unlock
  printf '%s\n' "$tip"
}

prune_landed() {
  local repo branch wt landed ahead behind dirty state why name held tip
  while IFS=$'\t' read -r repo branch wt landed ahead behind dirty state why; do
    [ "$branch" != - ] && name="$(basename "$repo") $branch" || name="$(basename "$repo") $wt"
    case $state in
      live | leftover | held) printf '%s %s: %s\n' "$state" "$name" "$why"; continue ;;
      superseded) [ "$dirty" = 0 ] || { printf 'superseded %s: %s, kept\n' "$name" "$why"; continue; } ;;
      landed) ;;
      *) continue ;;
    esac
    tip=''
    if [ "$wt" != - ] && held=$(landed_keep "$wt"); then printf 'live %s: %s\n' "$name" "$held"
    elif [ "$state" = superseded ] && ! tip=$(keep_tip "$repo" "$branch"); then
      printf 'superseded %s: %s, kept: %s\n' "$name" "$why" "$tip"
    else
      { [ "$wt" = - ] || git -C "$repo" worktree remove "$wt"; } &&
        { [ "$branch" = - ] || git -C "$repo" branch -q -D "$branch"; } && printf 'pruned %s%s\n' "$name" "${tip:+ (superseded, tip $tip)}"
    fi
  done < <(branch_rows)
}

JQ_TOTALS='def totals: [.jobs[] | .state] as $s
  | {merged: ($s | map(select(. == "merged")) | length), left: ($s | map(select(. == "left")) | length),
     failed: ($s | map(select(. == "failed-launch")) | length),
     blocked: ($s | map(select(. == "blocked-on-egor")) | length),
     nothing: ($s | map(select(. == "nothing-to-do")) | length),
     settled: ($s | map(select(. == "settled")) | length),
     pending: ($s | map(select(. == "pending")) | length),
     unpushed: ([.jobs[] | select(.state == "merged" and .pushed != true)] | length),
     unfinished: ($status == "unfinished"), running: ($status == "running")};
def hm: if . == null then "-" else fromdateiso8601 | strflocaltime("%H:%M") end;
def doctor_lines: . as $n | ["llm", "harness", "updater", "code", "system"][] as $d
  | "\($d) \($n.doctors_before[$d] // "-") → \(if $n.doctors_after then ($n.doctors_after[$d] // "-") else "?" end)"
    + ($n.doctor_states_after[$d]? // null | if . then " · proved \(.proved) · pending \(.pending) · new \(.new) · regressed \(.regressed)"
       else "" end);
def count(n; word): if n > 0 then "\(n) \(word)" else empty end;'

pick_night() { # [id] -> night file
  local id=${1:-}
  if [ -z "$id" ]; then
    id=$(all_nights | jq -r '.[0].id // empty')
    [ -n "$id" ] || die "no night under $nights_dir"
  fi
  known_night "$id"
  night_file "$id"
}

code_lines() { # night-file -> {"<ref>": [added, removed], or null when a commit cannot be read}
  local ref repo hash dir
  jq -r '.jobs[] | .ref as $r | .commits[] | [$r, .repo, .hash] | @tsv' "$1" |
    while IFS=$'\t' read -r ref repo hash; do
      if dir=$(repo_dir "$repo") && git -C "$dir" cat-file -e "$hash^{commit}" 2>/dev/null; then
        git -C "$dir" diff --numstat "$hash^" "$hash" -- . ':(glob,exclude)**/tests/**' ':(glob,exclude)**/test_*' |
          awk -v r="$ref" -F '\t' '{ if ($1 != "-") { a += $1; d += $2 } } END { printf "%s\t%d\t%d\n", r, a, d }'
      else
        printf '%s\t?\t?\n' "$ref"
      fi
    done | jq -Rsc '[split("\n")[] | select(. != "") | split("\t")] | group_by(.[0])
      | map({(.[0][0]): (if any(.[]; .[1] == "?") then null
          else [(map(.[1] | tonumber) | add), (map(.[2] | tonumber) | add)] end)}) | add // {}'
}

repo_debt() { # -> one line per sweep repository: its review debt now
  local debt="${NIGHT_RUN_REVIEW_DEBT:-$HOME/.local/bin/review-debt}" repo row
  [ -x "$debt" ] && [ -r "$sweep_repos" ] || return 0
  while IFS= read -r repo; do
    case "$repo" in ''|'#'*) continue ;; esac
    row=$("$debt" --repo "$repo" --split </dev/null 2>/dev/null) || row=
    if [[ "$row" =~ ^LINES=([0-9]+)\ FILES=([0-9]+)\ DUE_LINES=([0-9]+)\ DUE_FILES=([0-9]+)$ ]]; then
      printf 'debt now · %s · %s lines in %s files · due %s lines in %s files\n' "${repo##*/}" "${BASH_REMATCH[1]}" \
        "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"
    else
      printf 'debt now · %s · unknown\n' "${repo##*/}"
    fi
  done <"$sweep_repos"
}

cmd_report() {
  local file unverified speed run post=false id='' table
  while [ $# -gt 0 ]; do
    case $1 in
      --post) post=true ;;
      -*) usage ;;
      *) [ -z "$id" ] || usage; id=$1 ;;
    esac
    shift
  done
  file=$(pick_night "$id")
  unverified=$(jq -r '.jobs[].ref' "$file" | while IFS= read -r ref; do
    run="${nights_dir%/*}/runs/$ref.json"
    [ ! -f "$run" ] || jq -c --arg r "$ref" '{($r): [.decisions[]? | select(.component == "unverified") | .id]}' "$run"
  done | jq -sc 'add // {}')
  speed=$(jq -r '.jobs[].ref' "$file" | while IFS= read -r ref; do
    run="${nights_dir%/*}/runs/$ref.json"
    [ ! -f "$run" ] || jq -c --arg r "$ref" "$JQ_SPEED_RUN"' select(speed_run) | {($r): (.problems | length)}' "$run"
  done | jq -sc 'add // {}')
  table=$(python3 -B "$repo_root/share/time_budget.py" table "$repo_root/bin/worker-run" "$file") || die "no comparison table for $file"
  if $post; then
    table_block "$table" | post_block night-report
    printf 'table · posted to the chat as the night block; the final message does not retype it\n\n'
  else
    printf '%s\n\n' "$table"
  fi
  python3 -B "$repo_root/share/night_spend.py" "$repo_root/bin/worker-run" "$file" || die "no spend header for $file"
  python3 -B "$repo_root/share/night_churn.py" "$repo_root/bin/worker-run" "$file" 2>/dev/null || true
  jq -r --argjson u "$unverified" --argjson lines "$(code_lines "$file")" --arg status "$(night_status "$file")" \
    --argjson speed "$speed" --argjson h "$SPEED_WINDOW_H" "$JQ_TOTALS"' totals as $t
    | "night \(.id) · \(.started_at | hm)–\(.finished_at | hm)"
      + (if $t.running then " · running" elif $t.unfinished then " · UNFINISHED" else "" end),
      (if .note then "note · \(.note)" else empty end),
      doctor_lines,
      ([.events[]? | select(.phase == "speed-start") | .job] as $began
       | if $speed == {} then empty else "speed · levers \([$speed[]] | add) selected · \([$began | unique[] | $speed[.] // 0] | add // 0) started · "
         + "\([.jobs[] | select(.reason == "speed window closed (\($h) h)") | $speed[.ref] // 0] | add // 0) left by the \($h) h window" end),
      (.jobs[] | ([(if .state == "merged" then "landed" else .state end), .kind, .ref]
        + (if .branch and .state != "merged" then [.branch] else [] end)
        + (if .review then ["review \(.review)"] else [] end)
        + (if .kind == "owner-chat" then ["«\(.owner)» \(.via) · \(.handoffs | length) handoffs"] else [] end)
        + (if .handover then ["handed over by \(.handover.by)\(if .handover.owner_verified == false then " (never worked in its worktree)" else "" end) at \(.handover.at | hm): \(.handover.why)"] else [] end)
        + [.commits[] | "\(.repo | split("/") | last)@\(.hash[0:7])"]
        + [.integration[]? | "integration \(.repo | split("/") | last)@\(.hash[0:7])"]
        + (.ref as $r | if ($lines | has($r)) | not then []
            elif $lines[$r] == null then ["code ?"] else ["code +\($lines[$r][0])/-\($lines[$r][1])"] end)
        + (if .state == "merged" and (.pushed | not) then ["not pushed"] else [] end)
        + (if .reason then [.reason] else [] end)
        + (if .settled then ["settled by night \(.settled.night): \(.settled.evidence | join("; "))"] else [] end)
        + (if .carried then ["answered, carried to night \(.carried.night) as \(.carried.ref)"] else [] end)) | join(" · ")),
      (.leftovers[]? | "leftover · \(.repo) · \(.branch) · \(.why)"),
      (.held[]? | "held · \(.repo) · \(.branch) · \(.why)"),
      (.suites // null | if . == null then empty elif .finished_at == null then "suites · running since \(.started_at | hm)"
       else .repos[] | "suites · \(.repo | split("/") | last) · \(.passed) PASS · \(.failed | length) FAIL"
         + (if .failed == [] then "" else ": \(.failed | join(", "))" end) end),
      ($u | to_entries[] | select(.value | length > 0) | "unverified component · \(.key) · \(.value | join(", "))"),
      ("total · " + ([count($t.merged; "landed"), count($t.left; "left"), count($t.failed; "failed-launch"),
        count($t.blocked; "blocked-on-egor"), count($t.nothing; "nothing-to-do"), count($t.settled; "settled"), count($t.pending; "pending"),
        count($t.unpushed; "not pushed")]
        | if length == 0 then "no jobs" else join(" · ") end))' "$file" || return
  repo_debt
  python3 -B "$repo_root/share/time_budget.py" night "$repo_root/bin/worker-run" "$file" 2>/dev/null || true
}

cmd_latest() {
  local id
  [ "${1:-}" = --menu ] && [ $# -eq 1 ] || usage
  id=$(all_nights | jq -r '.[0].id // empty')
  [ -n "$id" ] || return 0
  jq -r --arg status "$(night_status "$(night_file "$id")")" --slurpfile areas "$repo_root/share/doctor-areas.json" \
    "$JQ_TOTALS$JQ_UNFINISHED"'
    def flat: tostring | gsub("[\t\r\n]+"; " ");
    def gist: split(":")[0] | split(",")[0] | split(";")[0] | split(" ") | map(select(. != ""))
      | if length > 6 then .[0:6] + ["…"] else . end | join(" ");
    def name: .ref as $r | if .kind == "debt" then (if $r | test("^debt(-[0-9]+)?$") then "cleanup" else "cleanup \($r)" end)
      elif .kind == "leftover" then "leftover \(.adopted[0].branch // $r)"
      elif .kind == "owner-chat" then "\(.owner // $r) handoffs"
      elif .kind == "vendor" then "\(.branch // "" | split("/") | if length > 2 then last else $r | sub("-[0-9]{8}T[0-9]{6}Z.*$"; "") end) update"
      else ($r | capture("^(?<d>llm|harness|updater|code|system)(-(?<a>.+?))?-[0-9]{8}T[0-9]{6}Z(-[0-9a-f]+)?$")
        | ($areas[0].renamed["\(.d)-\(.a)"] // .a) as $a
        | ({llm: "LLM", harness: "Harness", updater: "Updater", code: "Code", system: "System"}[.d] + " fixer"
          + (if $a and $a != $areas[0].own and $a != ($areas[0].whole[.d] // null) then ": " + ($a | gsub("-"; " ")) else "" end))) // $r end;
    def word: {merged: (if .pushed then "" else "not pushed" end), left: "unfinished",
      "failed-launch": "failed to launch", "blocked-on-egor": "needs you", "nothing-to-do": "nothing to do", settled: "settled",
      pending: (if $status == "running" then "in progress" else "unfinished" end)}[.state] // .state;
    def tone: if .state == "failed-launch" or .state == "blocked-on-egor" then 1
      elif .state == "nothing-to-do" or .state == "settled" or (.state == "merged" and .pushed) then 0 else 2 end;
    totals as $t
    | (if $t.running then "Night run since \(.started_at | hm)"
       else "Last night \(.started_at | fromdateiso8601 | strflocaltime("%d %b") | ltrimstr("0"))"
         + (if $t.unfinished then ", stopped early" else "" end) end) as $when
    | ($t.merged + $t.nothing + $t.settled) as $done
    | (if (.jobs | length) == 0 then [if .note then "did not start" else "no jobs" end]
       else ["\($done) of \(.jobs | length)"]
         + [count($t.unpushed; "not pushed"),
            count($t.left + (if $t.running then 0 else $t.pending end); "unfinished"),
            count(if $t.running then $t.pending else 0 end; "in progress"),
            count($t.failed; "failed to launch"), count($t.blocked; "need you")] end) as $parts
    | "\($when): \($parts | join(" · "))\t\(if $t.failed + $t.blocked > 0 or .note != null then 1
        elif $t.running or ([.jobs[] | tone] | index(2)) then 2 else 0 end)\t\(
        if $t.running then 1 else 0 end)\t\(.id)",
      (if .note then "orchestrator chat did not open\t1\t\(.note | flat)" else empty end),
      (.jobs[] | "\([name, word, (.reason // empty | flat | gist)] | map(select(. != null and . != "")) | join(" · "))\t\(
        tone)\t\(.reason // "" | flat)\t\(
        .ref | flat)\t\(.kind)\t\(if unfinished and ($t.running | not) then 1 else 0 end)")' \
    "$(night_file "$id")"
}

orchestrator_moved() { # id session -> true once the night has another orchestrator or is finished
  jq -e --arg s "$2" '.finished_at != null or .session != $s' "$(night_file "$1")" >/dev/null
}

cmd_wall() {
  local input sid id
  input=$(cat)
  [ "$(jq -r '.error // empty' <<<"$input" 2>/dev/null)" = rate_limit ] || return 0
  sid=$(jq -r '.session_id // empty' <<<"$input" 2>/dev/null)
  [ -n "$sid" ] || return 0
  id=$(all_nights | jq -r --arg s "$sid" 'first(.[] | select(.finished_at == null and .session == $s) | .id) // empty')
  [ -n "$id" ] || return 0
  [ -z "${NIGHT_RUN_WALL_SYNC:-}" ] || { cmd_failover "$id" "$sid"; return; }
  # The failover ends the chat whose hook started it, so it must leave that process tree first.
  perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' \
    bash "$repo_root/bin/night-run" failover "$id" "$sid" </dev/null >>"$nights_dir/$id.failover.log" 2>&1 &
}

cmd_failover() { # id walled-session
  local id=$1 sid=$2 account walls start
  local poll=${NIGHT_RUN_WALL_POLL:-300} limit=${NIGHT_RUN_WALL_LIMIT:-43200} max=${NIGHT_RUN_WALL_MAX:-6}
  known_night "$id"
  ! orchestrator_moved "$id" "$sid" || return 0
  start=$(date +%s)
  walls=$(jq '[.events[]? | select(.phase == "wall")] | length' "$(night_file "$id")")
  lock
  night_events "$id" "$(jq -cn --arg s "$sid" --arg a "$(jq -r '.account // ""' "$(night_file "$id")")" \
    '[{phase: "wall", session: $s, account: $a, pred: "last"}]')" || die "cannot write night $id"
  unlock
  if [ "$walls" -ge "$max" ]; then
    lock
    night_events "$id" "$(jq -cn --argjson n "$walls" '[{phase: "wall-gave-up", reason: "\($n) walls already this night", pred: "last"}]')"
    unlock
    die "night $id: $walls orchestrator walls already, not moving it again"
  fi
  until account=$("${NIGHT_RUN_WORKER_PICK:-$repo_root/bin/worker-pick}" --account claudeb --role chat --model opus 2>/dev/null) &&
    [ -n "$account" ]; do
    if [ $(($(date +%s) - start)) -ge "$limit" ]; then
      lock
      night_events "$id" "$(jq -cn --argjson w $(($(date +%s) - start)) '[{phase: "wall-gave-up", reason: "no Claude account had room", waited: $w, pred: "last"}]')"
      unlock
      die "night $id: no Claude account had room for $(($(date +%s) - start)) s"
    fi
    sleep "$poll"
    ! orchestrator_moved "$id" "$sid" || return 0
  done
  pids_end 60 $(pgrep -f -- "--(session-id|resume) $sid")
  lock
  night_events "$id" "$(jq -cn --argjson w $(($(date +%s) - start)) --arg a "$account" \
    '[{phase: "wall-moved", waited: $w, room: $a, pred: "last"}]')" || die "cannot write night $id"
  unlock
  cmd_start --resume "$id"
}

case "${1:-}" in
  start) shift; cmd_start "$@" ;;
  wall) shift; [ $# -eq 0 ] || usage; cmd_wall ;;
  failover) shift; [ $# -eq 2 ] || usage; cmd_failover "$@" ;;
  base) shift; [ $# -eq 1 ] || usage; cmd_base "$1" ;;
  job) shift; cmd_job "$@" ;;
  finish) shift; cmd_finish "$@" ;;
  report) shift; cmd_report "$@" ;;
  latest) shift; cmd_latest "$@" ;;
  leftovers) shift; [ $# -le 1 ] || usage; cmd_leftovers "$@" ;;
  survey) shift; cmd_survey "$@" ;;
  carry) shift; cmd_carry "$@" ;;
  suites) shift; cmd_suites "$@" ;;
  hold) shift; cmd_hold "$@" ;;
  speed-gate) shift; [ $# -eq 2 ] || usage; known_night "$1"; cmd_speed_gate "$@" ;;
  *) usage ;;
esac
exit; }

#!/usr/bin/env python3
"""llm-limitsd — single-writer sqlite control-plane ledger for the llm-legs limits system.

SHADOW MODE (step 2 of the migration): this daemon runs alongside the legacy bash/JSON
orchestration and touches none of it. It owns its own sqlite ledger and writes a read-only
projection to a SHADOW path (default ~/.llm-limits-shadow.json), never the real cache. It never
binds the claudebd data-plane port (45789) and never writes into the real ~/.claude-profiles
store.

SQLite is the authority. The projection is an atomic, deterministic read-only view of ledger
state — a pure function of the ledger, so identical ledger contents always yield byte-identical
projection output (its notion of "now" is the ledger's latest-evidence time, not wall clock).

Stdlib only: sqlite3 + http.server. Single process is the sole writer; every mutation is
serialized under one lock, so concurrent clients cannot lose an observation.
"""

import calendar
import json
import os
import sqlite3
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# --- reason-code taxonomy (mirrors bin/claudeb: affirmative auth failure vs capacity weather) ---
RC_OK = 0
RC_AUTH_REJECTED = 2      # invalid_grant / affirmative auth rejection -> may flip auth to expired
RC_WEATHER = 75           # capacity-shaped upstream noise -> NEVER an auth verdict
RC_TIMEOUT = 124          # a network op exceeded its deadline; a RECORDED step outcome, not a kill
RC_RESTART = 87           # a step left running across a daemon restart -> interrupted, never silent

STEP_TERMINAL = {"succeeded", "not_needed", "skipped", "failed", "interrupted"}
STEP_SUCCESS = {"succeeded", "not_needed"}
STEP_STATUSES = {"pending", "running"} | STEP_TERMINAL
RUN_TERMINAL = {"succeeded", "partial", "failed", "cancelled", "interrupted"}

STALE_THRESHOLDS = {"five_hour": 1800, "weekly": 21600, "fable": 21600}
PROJECTION_VENDORS = ("claude", "codex", "gemini")
# Reserved account for accountless vendors (gemini): the real cache stores gemini usage at
# vendor level with no accounts array, so its observations key on this sentinel and project
# back up to vendor-level buckets without a fabricated account entry.
ACCOUNTLESS = "-"
EXIT_DB_UNRECOVERABLE = 78  # corrupt/foreign db: paired with plist ThrottleInterval, no hot-loop

SCHEMA = """
CREATE TABLE IF NOT EXISTS runs (
  run_id     TEXT PRIMARY KEY,
  mode       TEXT NOT NULL,
  status     TEXT NOT NULL,
  targets    TEXT NOT NULL,
  created_at REAL NOT NULL,
  started_at REAL,
  ended_at   REAL
);
CREATE TABLE IF NOT EXISTS steps (
  step_id     INTEGER PRIMARY KEY AUTOINCREMENT,
  run_id      TEXT NOT NULL,
  vendor      TEXT NOT NULL,
  account     TEXT NOT NULL,
  phase       TEXT NOT NULL,
  status      TEXT NOT NULL,
  reason_code INTEGER,
  evidence_at REAL,
  before      TEXT,
  after       TEXT,
  created_at  REAL NOT NULL,
  started_at  REAL,
  updated_at  REAL NOT NULL,
  UNIQUE(run_id, vendor, account, phase)
);
CREATE TABLE IF NOT EXISTS observations (
  obs_id      INTEGER PRIMARY KEY AUTOINCREMENT,
  source      TEXT NOT NULL,
  vendor      TEXT NOT NULL,
  account     TEXT NOT NULL,
  scope       TEXT NOT NULL,
  observed_at REAL NOT NULL,
  received_at REAL NOT NULL,
  payload     TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_obs_va ON observations(vendor, account, observed_at);
"""


def now_ts():
    return time.time()


def epoch_iso(epoch):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


def normalize_reset(value):
    """Mirror llm-limits.sh normalize_reset: placeholder/1970-era resets collapse to null."""
    if value is None or value == "":
        return None
    if isinstance(value, (int, float)):
        return None if value < 31536000 else epoch_iso(value)
    if isinstance(value, str):
        e = iso_to_epoch(value)
        if e is not None and e < 31536000:
            return None
        return value
    return None


def _die_unrecoverable_db(db_path, detail):
    sys.stderr.write("llm-limitsd: db integrity check failed (%s): %s\n" % (db_path, detail))
    sys.stderr.flush()
    raise SystemExit(EXIT_DB_UNRECOVERABLE)


def iso_to_epoch(value):
    if not isinstance(value, str):
        return None
    v = value.strip()
    for fmt in ("%Y-%m-%dT%H:%M:%SZ", "%Y-%m-%dT%H:%M:%S"):
        try:
            return int(calendar.timegm(time.strptime(v, fmt)))
        except (ValueError, OverflowError):
            pass
    # offset form: 2026-07-18T07:49:59+03:00
    try:
        head = v[:19]
        base = int(calendar.timegm(time.strptime(head, "%Y-%m-%dT%H:%M:%S")))
        tz = v[19:]
        if tz and tz[0] in "+-":
            sign = 1 if tz[0] == "+" else -1
            hh = int(tz[1:3])
            mm = int(tz[4:6]) if len(tz) >= 6 else int(tz[3:5])
            return base - sign * (hh * 3600 + mm * 60)
    except (ValueError, OverflowError, IndexError):
        pass
    return None


class Ledger:
    def __init__(self, db_path, projection_path):
        self.db_path = db_path
        self.projection_path = projection_path
        self.lock = threading.RLock()
        self._open()

    def _open(self):
        existed = os.path.exists(self.db_path) and os.path.getsize(self.db_path) > 0
        os.makedirs(os.path.dirname(self.db_path) or ".", exist_ok=True)
        self.conn = sqlite3.connect(self.db_path, check_same_thread=False)
        self.conn.row_factory = sqlite3.Row
        if existed:
            # Honest failure on a corrupt/foreign file: never silently recreate the authority.
            try:
                row = self.conn.execute("PRAGMA integrity_check").fetchone()
            except sqlite3.DatabaseError as exc:
                _die_unrecoverable_db(self.db_path, exc)
            if row is None or row[0] != "ok":
                _die_unrecoverable_db(self.db_path, row[0] if row else "unknown")
        self.conn.execute("PRAGMA journal_mode=WAL")
        self.conn.execute("PRAGMA synchronous=NORMAL")
        self.conn.execute("PRAGMA foreign_keys=ON")
        self.conn.executescript(SCHEMA)
        self.conn.commit()

    # --- ledger clock: latest evidence time across the whole ledger (deterministic) ---
    def _ledger_clock(self):
        vals = []
        for q in ("SELECT MAX(received_at) FROM observations",
                  "SELECT MAX(updated_at) FROM steps",
                  "SELECT MAX(COALESCE(ended_at, started_at, created_at)) FROM runs"):
            r = self.conn.execute(q).fetchone()[0]
            if r is not None:
                vals.append(r)
        return max(vals) if vals else 0.0

    # --- mutations (all under self.lock) ---
    def create_run(self, mode, targets):
        run_id = "run-%d-%d" % (int(now_ts() * 1000), int.from_bytes(os.urandom(2), "big"))
        norm_targets = [{"vendor": t["vendor"], "account": t["account"], "phase": t["phase"]}
                        for t in targets]
        ts = now_ts()
        with self.lock:
            self.conn.execute(
                "INSERT INTO runs(run_id, mode, status, targets, created_at) VALUES(?,?,?,?,?)",
                (run_id, mode, "pending", json.dumps(norm_targets, sort_keys=True), ts))
            self.conn.commit()
            self._recompute_run(run_id)
            self._write_projection()
        return run_id

    def add_step(self, run_id, vendor, account, phase, status, reason_code=None,
                 evidence_at=None, before=None, after=None):
        if status not in STEP_STATUSES:
            raise ValueError("bad step status: %s" % status)
        with self.lock:
            run = self.conn.execute("SELECT * FROM runs WHERE run_id=?", (run_id,)).fetchone()
            if run is None:
                return None, 404, "unknown run"
            existing = self.conn.execute(
                "SELECT * FROM steps WHERE run_id=? AND vendor=? AND account=? AND phase=?",
                (run_id, vendor, account, phase)).fetchone()
            started = existing["started_at"] if existing and existing["started_at"] else None
            # Success is never declared out of thin air: a step must have gone through 'running'
            # first (which stamps started_at), so evidence_at can never be fabricated for work
            # that was never observed to start.
            if status == "succeeded" and started is None:
                return None, 400, "running-required"
            # start-window additionally needs a proven reconcile observation
            # (observed_at >= the step's started_at) confirming a fresh resets_at. HTTP 200 alone
            # is never success.
            if phase == "start-window" and status == "succeeded":
                if not self._has_reconcile(vendor, account, started):
                    return None, 409, "reconcile-required"
            ts = now_ts()
            started_at = None
            if status == "running":
                started_at = existing["started_at"] if existing and existing["started_at"] else ts
            elif existing:
                started_at = existing["started_at"]
            self.conn.execute(
                """INSERT INTO steps(run_id, vendor, account, phase, status, reason_code,
                       evidence_at, before, after, created_at, started_at, updated_at)
                   VALUES(?,?,?,?,?,?,?,?,?,?,?,?)
                   ON CONFLICT(run_id, vendor, account, phase) DO UPDATE SET
                       status=excluded.status, reason_code=excluded.reason_code,
                       evidence_at=excluded.evidence_at, after=excluded.after,
                       started_at=excluded.started_at, updated_at=excluded.updated_at""",
                (run_id, vendor, account, phase, status, reason_code,
                 evidence_at if evidence_at is not None else (ts if status in STEP_TERMINAL else None),
                 json.dumps(before, sort_keys=True) if before is not None else None,
                 json.dumps(after, sort_keys=True) if after is not None else None,
                 ts, started_at, ts))
            self.conn.commit()
            self._recompute_run(run_id)
            self._write_projection()
            return self.get_run(run_id), 200, None

    def add_observation(self, source, vendor, account, scope, observed_at, payload):
        _validate_observation(scope, payload)
        ts = now_ts()
        with self.lock:
            cur = self.conn.execute(
                """INSERT INTO observations(source, vendor, account, scope, observed_at,
                       received_at, payload) VALUES(?,?,?,?,?,?,?)""",
                (source, vendor, account, scope, float(observed_at), ts,
                 json.dumps(payload, sort_keys=True)))
            self.conn.commit()
            obs_id = cur.lastrowid
            self._write_projection()
        return obs_id

    def _has_reconcile(self, vendor, account, since):
        rows = self.conn.execute(
            """SELECT payload FROM observations WHERE vendor=? AND account=? AND scope='window'
               AND observed_at >= ? ORDER BY observed_at DESC""",
            (vendor, account, since)).fetchall()
        for r in rows:
            try:
                p = json.loads(r["payload"])
            except (ValueError, TypeError):
                continue
            if p.get("event") == "reconciled" and normalize_reset(p.get("resets_at")) is not None:
                return True
        return False

    def _recompute_run(self, run_id):
        run = self.conn.execute("SELECT * FROM runs WHERE run_id=?", (run_id,)).fetchone()
        if run is None or run["status"] in RUN_TERMINAL:
            return
        targets = json.loads(run["targets"])
        steps = {(s["vendor"], s["account"], s["phase"]): s["status"]
                 for s in self.conn.execute("SELECT * FROM steps WHERE run_id=?", (run_id,))}
        tstat = [steps.get((t["vendor"], t["account"], t["phase"]), "pending") for t in targets]
        ended_at = None
        if targets and all(s in STEP_TERMINAL for s in tstat):
            if all(s in STEP_SUCCESS for s in tstat):
                status = "succeeded"
            elif any(s == "failed" for s in tstat):
                status = "failed"
            elif any(s == "interrupted" for s in tstat):
                status = "interrupted"
            else:
                status = "partial"
            ended_at = now_ts()
        elif any(s != "pending" for s in tstat):
            status = "running"
        else:
            status = "pending"
        started_at = run["started_at"]
        if status != "pending" and started_at is None:
            started_at = now_ts()
        self.conn.execute("UPDATE runs SET status=?, started_at=?, ended_at=? WHERE run_id=?",
                          (status, started_at, ended_at, run_id))
        self.conn.commit()

    def recover_on_start(self):
        """A step left 'running' across a restart cannot be resumed by its (dead) owner: record
        it as interrupted — never a silent clean state — then let its run resolve."""
        with self.lock:
            orphaned = self.conn.execute("SELECT * FROM steps WHERE status='running'").fetchall()
            ts = now_ts()
            for s in orphaned:
                self.conn.execute(
                    "UPDATE steps SET status='interrupted', reason_code=?, evidence_at=?, updated_at=? WHERE step_id=?",
                    (RC_RESTART, ts, ts, s["step_id"]))
            self.conn.commit()
            run_ids = {r["run_id"] for r in
                       self.conn.execute("SELECT run_id FROM runs WHERE status IN ('pending','running')")}
            for rid in run_ids:
                self._recompute_run(rid)
            self._write_projection()

    # --- reads ---
    def get_run(self, run_id):
        run = self.conn.execute("SELECT * FROM runs WHERE run_id=?", (run_id,)).fetchone()
        if run is None:
            return None
        steps = self.conn.execute(
            "SELECT * FROM steps WHERE run_id=? ORDER BY step_id", (run_id,)).fetchall()
        return {
            "run_id": run["run_id"],
            "mode": run["mode"],
            "status": run["status"],
            "targets": json.loads(run["targets"]),
            "created_at": run["created_at"],
            "started_at": run["started_at"],
            "ended_at": run["ended_at"],
            "steps": [{
                "vendor": s["vendor"], "account": s["account"], "phase": s["phase"],
                "status": s["status"], "reason_code": s["reason_code"],
                "evidence_at": s["evidence_at"],
                "before": json.loads(s["before"]) if s["before"] else None,
                "after": json.loads(s["after"]) if s["after"] else None,
            } for s in steps],
        }

    # --- reducer: per-account auth + window state derived only from the observation log ---
    def reduce_state(self):
        rows = self.conn.execute(
            "SELECT * FROM observations ORDER BY observed_at ASC, obs_id ASC").fetchall()
        proj_now = self._ledger_clock()
        accounts = {}
        for r in rows:
            key = (r["vendor"], r["account"])
            acc = accounts.setdefault(key, {
                "vendor": r["vendor"], "account": r["account"],
                "auth": "ok", "auth_checked_at": None,
                "window_event": None, "window_event_at": None,
                "buckets": {}, "enabled": True, "is_current": False,
                "current_directive": False, "current_directive_at": None,
                "newest_at": 0.0,
            })
            acc["newest_at"] = max(acc["newest_at"], r["observed_at"])
            try:
                payload = json.loads(r["payload"])
            except (ValueError, TypeError):
                payload = {}
            if r["scope"] == "auth":
                # Ascending observed_at order means the newest affirmative verdict wins and a late
                # (older observed_at) verdict cannot regress a newer one. Non-affirmative evidence
                # (see _is_affirmative_auth) never moves the verdict.
                if _is_affirmative_auth(payload):
                    verdict = payload.get("verdict")
                    if verdict in ("ok", "expired", "needs_relogin", "healing"):
                        acc["auth"] = verdict
                        acc["auth_checked_at"] = r["observed_at"]
            elif r["scope"] == "window":
                event = payload.get("event")
                if event in ("start-initiated", "reconciled"):
                    acc["window_event"] = event
                    acc["window_event_at"] = r["observed_at"]
                window = payload.get("window")
                if window in STALE_THRESHOLDS and "used_pct" in payload:
                    acc["buckets"][window] = {
                        "used_pct": payload.get("used_pct"),
                        "resets_at_raw": payload.get("resets_at"),
                        "origin": payload.get("origin", "usage"),
                        "as_of": r["observed_at"],
                    }
            elif r["scope"] == "rotation":
                if "enabled" in payload:
                    acc["enabled"] = bool(payload["enabled"])
                if "is_current" in payload:
                    at = r["observed_at"]
                    if acc["current_directive_at"] is None or at >= acc["current_directive_at"]:
                        acc["current_directive_at"] = at
                        acc["current_directive"] = bool(payload["is_current"])
        # Current-ness is last-wins per vendor: exactly the account whose most recent is_current
        # directive is True and has the newest observed_at is current; all others are cleared.
        winners = {}
        for acc in accounts.values():
            if acc["current_directive"]:
                prev = winners.get(acc["vendor"])
                if prev is None or acc["current_directive_at"] > prev[1]:
                    winners[acc["vendor"]] = (acc["account"], acc["current_directive_at"])
        for acc in accounts.values():
            win = winners.get(acc["vendor"])
            acc["is_current"] = bool(win and win[0] == acc["account"])
        return proj_now, accounts

    def state_view(self):
        proj_now, accounts = self.reduce_state()
        out = []
        for acc in sorted(accounts.values(), key=lambda a: (a["vendor"], a["account"])):
            out.append({
                "vendor": acc["vendor"], "account": acc["account"],
                "auth": acc["auth"], "window": _window_state(acc, proj_now),
                "buckets": {w: {"used_pct": b["used_pct"],
                                "resets_at": normalize_reset(b["resets_at_raw"]),
                                "origin": b["origin"], "as_of": int(b["as_of"])}
                            for w, b in sorted(acc["buckets"].items())},
            })
        return {"as_of": epoch_iso(proj_now), "accounts": out}

    # --- projection: atomic, deterministic mirror of the real ~/.llm-limits.json schema ---
    def build_projection(self):
        proj_now, accounts = self.reduce_state()
        vendors = {}
        by_vendor = {}
        for acc in accounts.values():
            by_vendor.setdefault(acc["vendor"], []).append(acc)
        for vendor, accs in by_vendor.items():
            accs.sort(key=lambda a: a["account"])
            if len(accs) == 1 and accs[0]["account"] == ACCOUNTLESS:
                vendors[vendor] = self._project_accountless(accs[0], proj_now)
                continue
            acc_objs = [self._project_account(a, proj_now) for a in accs]
            current = next((a for a in acc_objs if a["is_current"]), acc_objs[0] if acc_objs else None)
            vobj = {
                "available": True,
                "source": "limitsd-shadow",
                "current_account": current["account"] if current else None,
                "accounts": acc_objs,
                "last_wall": None,
                "stale": bool(current and _account_stale(current)),
                "usable_now": any(_account_usable(a) for a in acc_objs),
            }
            if current:
                for field in ("five_hour", "weekly", "fable"):
                    if field in current:
                        vobj[field] = current[field]
                vobj["as_of"] = current["as_of"]
                vobj["stale_seconds"] = current["stale_seconds"]
                vobj["auth"] = current["auth"]
            if vendor == "claude":
                vobj["daemon"] = {"walls": [], "pins": [],
                                  "all_walled_until": {"general": None, "fable": None},
                                  "reachable": True}
            vendors[vendor] = vobj
        # Mirror the real cache, which always carries all three vendor keys — a vendor with no
        # observations is unavailable, not absent (matches llm-limits.sh's available:false shape).
        for vendor in PROJECTION_VENDORS:
            if vendor not in vendors:
                vendors[vendor] = {"available": False, "status": "no observations",
                                   "source": "limitsd-shadow", "last_wall": None}
        return {"schema": 1, "fetched_at": epoch_iso(proj_now), "vendors": vendors}

    def _project_account(self, acc, proj_now):
        obj = {
            "account": acc["account"],
            "is_current": acc["is_current"],
            "enabled": acc["enabled"],
            "as_of": epoch_iso(acc["newest_at"]),
            "stale_seconds": max(int(proj_now - acc["newest_at"]), 0),
            "auth": {"status": "expired" if acc["auth"] in ("expired", "needs_relogin") else "ok",
                     "checked_at": int(acc["auth_checked_at"]) if acc["auth_checked_at"] else None},
        }
        # needs_relogin is codex's login-needed signal: surfaced as the real cache's account-level
        # auth_needed flag, distinct from claude's auth.status=expired.
        if acc["auth"] == "needs_relogin":
            obj["auth_needed"] = True
        auth_expired = acc["auth"] in ("expired", "needs_relogin")
        for window, b in acc["buckets"].items():
            obj[window] = _project_bucket(b, window, proj_now, auth_expired)
        obj["rotation"] = _rotation(obj)
        return obj

    def _project_accountless(self, acc, proj_now):
        a = self._project_account(acc, proj_now)
        vobj = {"available": True, "source": "limitsd-shadow", "last_wall": None,
                "stale": bool(_account_stale(a)), "usable_now": _account_usable(a),
                "as_of": a["as_of"], "stale_seconds": a["stale_seconds"]}
        for field in ("five_hour", "weekly", "fable"):
            if field in a:
                vobj[field] = a[field]
        return vobj

    def _write_projection(self):
        data = self.build_projection()
        blob = json.dumps(data, sort_keys=True, separators=(",", ":")) + "\n"
        tmp = "%s.tmp.%d" % (self.projection_path, os.getpid())
        with open(tmp, "w") as fh:
            fh.write(blob)
        os.replace(tmp, self.projection_path)

    def healthz(self):
        with self.lock:
            try:
                self.conn.execute("SELECT 1").fetchone()
                ok = True
            except sqlite3.DatabaseError:
                ok = False
        return {"status": "ok" if ok else "degraded", "db": self.db_path,
                "projection": self.projection_path,
                "writable": os.access(os.path.dirname(self.db_path) or ".", os.W_OK)}


def _validate_observation(scope, payload):
    # A 2xx must mean "durably recorded and reducible", never "accepted then silently dropped":
    # reject unknown scopes and known scopes missing the keys the reducer needs.
    if not isinstance(payload, dict):
        raise ValueError("payload must be an object")
    if scope == "auth":
        if payload.get("verdict") not in ("ok", "expired", "needs_relogin", "healing"):
            raise ValueError("auth observation requires a valid verdict")
    elif scope == "window":
        event = payload.get("event")
        if event in ("start-initiated", "reconciled"):
            if event == "reconciled" and normalize_reset(payload.get("resets_at")) is None:
                raise ValueError("reconciled window observation requires a resets_at")
        elif payload.get("window") in STALE_THRESHOLDS and "used_pct" in payload:
            pass
        else:
            raise ValueError("window observation requires an event or window+used_pct")
    elif scope == "rotation":
        if "enabled" not in payload and "is_current" not in payload:
            raise ValueError("rotation observation requires enabled or is_current")
    else:
        raise ValueError("unknown scope: %s" % scope)


def _is_affirmative_auth(payload):
    # Default-DENY: a verdict moves ONLY on a KNOWN affirmative form. Capacity weather and any
    # unrecognized evidence tag (e.g. "warm-429") leave the auth verdict untouched, so upstream
    # noise can never masquerade as an auth rejection.
    ev = payload.get("evidence")
    rc = payload.get("reason_code")
    if ev == "weather" or rc == RC_WEATHER:
        return False
    return ev == "affirmative" or rc == RC_AUTH_REJECTED


def _window_state(acc, proj_now):
    if acc["window_event"] == "start-initiated":
        return "starting"
    five = acc["buckets"].get("five_hour")
    if five:
        e = iso_to_epoch(normalize_reset(five["resets_at_raw"]))
        if e is not None and e <= proj_now:
            return "expired"
    if acc["window_event"] == "reconciled":
        return "started"
    return "live"


def _project_bucket(b, window, proj_now, auth_expired):
    reset = normalize_reset(b["resets_at_raw"])
    as_of = int(b["as_of"])
    origin = b["origin"]
    stale = ((proj_now - as_of) > STALE_THRESHOLDS[window]) or origin == "cached" or auth_expired
    obj = {"used_pct": b["used_pct"], "resets_at": reset, "as_of": as_of,
           "stale": bool(stale), "origin": origin}
    e = iso_to_epoch(reset)
    if e is not None and e <= proj_now:
        obj["expired"] = True
        obj["effective_pct"] = 0
    else:
        obj["effective_pct"] = b["used_pct"]
    return obj


def _rotation(acc_obj):
    def blocked(window):
        b = acc_obj.get(window)
        if b is None:
            return None
        if b.get("effective_pct") is not None and b["effective_pct"] >= 100:
            return "limit-" + ("5h" if window == "five_hour" else window)
        return None
    if not acc_obj["enabled"]:
        return {"usable": {"general": False, "fable": False},
                "blocked": {"general": "disabled", "fable": "disabled"}}
    auth_bad = acc_obj["auth"]["status"] != "ok"
    gen = "auth" if auth_bad else (blocked("five_hour") or blocked("weekly"))
    fab = "auth" if auth_bad else (blocked("fable") or gen)
    return {"usable": {"general": gen is None, "fable": fab is None},
            "blocked": {"general": gen, "fable": fab}}


def _account_usable(acc_obj):
    if not acc_obj["enabled"] or acc_obj["auth"]["status"] != "ok":
        return False
    for window in ("five_hour", "weekly"):
        b = acc_obj.get(window)
        if b is not None and b.get("effective_pct") is not None and b["effective_pct"] >= 100:
            return False
    return True


def _account_stale(acc_obj):
    for window in ("five_hour", "weekly", "fable"):
        b = acc_obj.get(window)
        if b is not None and b.get("stale"):
            return True
    return False


MAX_BODY = 1 << 20


class BodyTooLarge(Exception):
    pass


class Server(ThreadingHTTPServer):
    # A burst of concurrent clients must not be refused at accept time (default backlog is 5).
    request_queue_size = 256
    daemon_threads = True


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *args):
        pass

    def _send(self, code, obj):
        blob = (json.dumps(obj) + "\n").encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(blob)))
        self.end_headers()
        self.wfile.write(blob)

    def _body(self):
        length = int(self.headers.get("Content-Length", 0) or 0)
        if length > MAX_BODY:
            raise BodyTooLarge()
        raw = self.rfile.read(length) if length else b""
        if not raw:
            return {}
        return json.loads(raw)

    def do_GET(self):
        led = self.server.ledger
        if self.path == "/healthz":
            return self._send(200, led.healthz())
        if self.path == "/state":
            with led.lock:
                return self._send(200, led.state_view())
        if self.path.startswith("/runs/"):
            run_id = self.path[len("/runs/"):]
            with led.lock:
                run = led.get_run(run_id)
            if run is None:
                return self._send(404, {"error": "unknown run"})
            return self._send(200, run)
        return self._send(404, {"error": "not found"})

    def do_POST(self):
        try:
            return self._handle_post()
        except BodyTooLarge:
            return self._send(413, {"error": "request body too large"})
        except Exception as exc:  # never drop the connection on an unexpected fault
            sys.stderr.write("llm-limitsd: unhandled POST error: %r\n" % exc)
            sys.stderr.flush()
            try:
                return self._send(500, {"error": "internal error"})
            except Exception:
                pass

    def _handle_post(self):
        led = self.server.ledger
        try:
            body = self._body()
        except ValueError:
            return self._send(400, {"error": "invalid json"})
        try:
            if self.path == "/runs":
                targets = body.get("targets") or []
                if not targets:
                    return self._send(400, {"error": "targets required"})
                run_id = led.create_run(body.get("mode", "refresh"), targets)
                with led.lock:
                    return self._send(201, led.get_run(run_id))
            if self.path.startswith("/runs/") and self.path.endswith("/steps"):
                run_id = self.path[len("/runs/"):-len("/steps")]
                run, code, err = led.add_step(
                    run_id, body["vendor"], body["account"], body["phase"], body["status"],
                    reason_code=body.get("reason_code"), evidence_at=body.get("evidence_at"),
                    before=body.get("before"), after=body.get("after"))
                if err:
                    return self._send(code, {"error": err})
                return self._send(200, run)
            if self.path == "/observations":
                obs_id = led.add_observation(
                    body.get("source", "unknown"), body["vendor"], body["account"],
                    body["scope"], body.get("observed_at", now_ts()), body.get("payload", {}))
                return self._send(201, {"obs_id": obs_id})
        except KeyError as exc:
            return self._send(400, {"error": "missing field: %s" % exc})
        except ValueError as exc:
            return self._send(400, {"error": str(exc)})
        return self._send(404, {"error": "not found"})


def main():
    port = int(os.environ.get("LLM_LIMITSD_PORT", "45791"))
    home = os.path.expanduser("~")
    db_path = os.environ.get(
        "LLM_LIMITSD_DB", os.path.join(home, ".claude-profiles", ".claudeb", "limitsd.sqlite"))
    projection = os.environ.get(
        "LLM_LIMITSD_PROJECTION", os.path.join(home, ".llm-limits-shadow.json"))
    ledger = Ledger(db_path, projection)
    ledger.recover_on_start()
    server = Server(("127.0.0.1", port), Handler)
    server.ledger = ledger
    sys.stderr.write("llm-limitsd: listening on 127.0.0.1:%d db=%s projection=%s\n"
                     % (server.server_address[1], db_path, projection))
    sys.stderr.flush()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()

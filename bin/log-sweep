#!/usr/bin/env python3
"""log-sweep: removes what each `sweep` store of share/log-stores.json is past its criterion: units untouched for
`days` (a classified unit of a split store: its group's `group_days`, classes read from every `session` store, swept
or not), beyond `keep_newest` or `max_mb` (oldest first), and truncates files to their last `tail_mb`. A unit some
process holds open (an open file or bound socket, a cwd, a path in its argv, or one inside a directory) is skipped; sockets, FIFOs and
devices are never units. A `command` store's argv runs once its last successful run (~/.cache/log-sweep/commands.json)
is `days` old, the bytes it freed counted like a removal. `--pressure GIB` takes cache stores only, ignoring `days`
(every unit; another criterion still keeps its units) and a command's last run: biggest unit first, each skipped once
its volume has GIB free, the open-file skip kept; run by `system-doctor pressure` while a volume is short of space.
`--dry-run` prints what it would remove or run with sizes. One summary line per run goes to
~/.cache/log-sweep/sweeps.jsonl, capped. Run daily by `system-doctor logstores`."""

import argparse
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time

ROOT_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(ROOT_DIR, "share"))
import limit_hit  # noqa: E402
import log_stores  # noqa: E402
from spend import read_json  # noqa: E402

RECORD_MAX_BYTES = 256 * 1024
RECORD_ITEMS = 20
COMMAND_TIMEOUT_S = 1200  # under system-doctor's LOGS["sweep_timeout_s"], which kills the whole sweep
PRESSURE_COMMAND_TIMEOUT_S = 300  # a pressure run frees space now; a cleaner waiting on another tool's lock is skipped
GIB = 1 << 30


def state_dir():
    return os.environ.get("LOG_SWEEP_DIR") or os.path.join(os.path.expanduser("~"), ".cache", "log-sweep")


def open_paths():
    """Every path a process of this user holds open, works in, binds a socket at or names in its argv, and every
    directory above one, as realpaths, from one lsof and one ps call."""
    command = os.environ.get("LOG_SWEEP_LSOF") or "/usr/sbin/lsof"
    try:
        out = subprocess.run([command, "-n", "-P", "-w", "-u", str(os.getuid()), "-F", "n"], capture_output=True,
                             text=True, timeout=120).stdout
    except (OSError, subprocess.SubprocessError) as error:
        limit_hit.expired("probe.ps", error, "the open-file list: no file is known held open this sweep",
                          'bin/log-sweep:"-w", "-u", str(os.getuid())')
        return None
    found = {line[1:] for line in out.splitlines() if line.startswith("n/")}
    try:
        args = subprocess.run([os.environ.get("LOG_SWEEP_PS") or "/bin/ps", "-x", "-ww", "-U", str(os.getuid()), "-o",
                               "args="], capture_output=True, text=True, timeout=60).stdout
    except (OSError, subprocess.SubprocessError):
        args = ""
    # A script a process runs from (node ~/.npm/_npx/<hash>/…, --user-data-dir=…) is held too: node and python keep no
    # file of a loaded module open, so lsof alone never sees an npx MCP server using its install.
    found.update(part for word in args.split() for part in word.split("=") if part.startswith("/"))
    held = set()
    for path in {os.path.realpath(p) for p in found}:
        while path not in held and path != "/":
            held.add(path)
            path = os.path.dirname(path)
    return held


def held(path, paths, also=()):
    return any(os.path.realpath(p) in paths for p in (path, *also))


def glob_base(pattern):
    parts = log_stores.expand(pattern).split("/")
    fixed = []
    for part in parts:
        if re.search(r"[*?\[{]", part):
            break
        fixed.append(part)
    return "/".join(fixed) or "/"


def prune_parents(path, bases):
    base = log_stores.root_of(path, bases)
    up = os.path.dirname(path)
    while base and up.startswith(base.rstrip("/") + "/"):
        try:
            os.rmdir(up)
        except OSError:
            return
        up = os.path.dirname(up)


def truncate(path, keep):
    with open(path, "r+b") as handle:
        handle.seek(-keep, os.SEEK_END)
        tail = handle.read()
        cut = tail.find(b"\n")
        tail = tail[cut + 1:] if 0 <= cut < len(tail) - 1 else tail
        handle.seek(0)
        handle.write(tail)
        handle.truncate()


def remove(path, also=()):
    """The unit, then each path that goes with it (a unit first: a Chromium IndexedDB leveldb before its blob
    directory, so a stop between them leaves stray blobs Chromium overwrites, never a database naming lost ones)."""
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path)
    else:
        os.remove(path)
    for extra in also:
        try:
            remove(extra)
        except FileNotFoundError:
            pass


def write(path, text):
    temporary = "%s.%d.tmp" % (path, os.getpid())
    with open(temporary, "w", encoding="utf-8") as handle:
        handle.write(text)
    os.replace(temporary, path)


def record(row):
    path = os.path.join(state_dir(), "sweeps.jsonl")
    try:
        with open(path, encoding="utf-8") as handle:
            lines = handle.read().splitlines()
    except OSError:
        lines = []
    lines.append(json.dumps(row, ensure_ascii=False, separators=(",", ":")))
    while len(lines) > 1 and sum(len(line) + 1 for line in lines) > RECORD_MAX_BYTES:
        lines.pop(0)
    write(path, "\n".join(lines) + "\n")


def command_runs():
    runs = read_json(os.path.join(state_dir(), "commands.json"), {})
    return runs if isinstance(runs, dict) else {}


def run_command(entry, now, dry_run, say, due=False, timeout=COMMAND_TIMEOUT_S):
    """[[unit, bytes freed]] of a `command` store whose last successful run is `days` old or never happened, or `due`
    ([] when not due; a dry run reports the units' size and runs nothing), None when the command fails."""
    runs = command_runs()
    last = runs.get(entry["name"])
    if not due and isinstance(last, (int, float)) and last > now - entry["days"] * log_stores.DAY_S:
        return []
    argv = entry["command"]
    before = log_stores.measure(entry)
    if dry_run:
        say("  %-8s %8.1f MB  %s" % ("run", sum(r["bytes"] for r in before) / log_stores.MB, " ".join(argv)))
        return [[r["path"], r["bytes"]] for r in before]
    try:
        out = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError) as error:
        say("log-sweep: %s: %s" % (" ".join(argv), error))
        return None
    if out.returncode:
        say("log-sweep: %s: exit %d: %s" % (" ".join(argv), out.returncode, out.stderr.strip()[-300:]))
        return None
    runs[entry["name"]] = round(now)
    write(os.path.join(state_dir(), "commands.json"), json.dumps(runs, sort_keys=True) + "\n")
    after = {r["path"]: r["bytes"] for r in log_stores.measure(entry)}
    return [[r["path"], max(0, r["bytes"] - after.get(r["path"], 0))] for r in before]


def sweep(registry, now, dry_run, only=None, say=print):
    stores, items, errors, skipped, denied = {}, [], 0, 0, 0
    paths, sessions = None, {}

    def tally(entry, done):
        if not done:
            return
        key, value = log_stores.criterion(entry)
        stores[entry["name"]] = [len(done), sum(freed for _path, freed in done)]
        items.extend(done)
        say("%s: %d unit%s, %.1f MB (%s %s%s)" % (entry["name"], len(done), "" if len(done) == 1 else "s",
                                                  stores[entry["name"]][1] / log_stores.MB, key, value, "".join(
                                                      ", %s %s" % kv for kv in (entry.get("group_days") or {}).items())))

    for entry in registry.get("stores") or ():
        chosen = not (only and entry["name"] not in only)
        if entry["cleaner"] == "command":
            done = run_command(entry, now, dry_run, say) if chosen else []
            errors += done is None
            tally(entry, done)
            continue
        swept = entry["cleaner"] == "sweep" and chosen
        if not swept and entry.get("split") != "session":
            continue
        rows = log_stores.measure(entry)
        if entry.get("split"):
            log_stores.split(entry, rows, sessions)
        if not swept:
            continue
        _key, value = log_stores.criterion(entry)
        bases = [glob_base(p) for p in entry["globs"]]
        done = []
        for row, action in log_stores.doomed(entry, rows, now):
            if row.get("denied"):
                denied += 1
                continue
            if action == "delete":
                if paths is None:
                    paths = open_paths()
                if paths is None or held(row["path"], paths, row.get("also") or ()):
                    skipped += 1
                    continue
            freed = row["bytes"] if action == "delete" else max(0, row["bytes"] - value * log_stores.MB)
            if dry_run:
                say("  %-8s %8.1f MB  %s" % (action, freed / log_stores.MB, row["path"]))
            else:
                try:
                    if action == "delete":
                        remove(row["path"], row.get("also") or ())
                        prune_parents(row["path"], bases)
                    else:
                        truncate(row["path"], int(value * log_stores.MB))
                except FileNotFoundError:
                    continue
                except OSError as error:
                    errors += 1
                    say("log-sweep: %s %s: %s" % (action, row["path"], error))
                    continue
            done.append([row["path"], freed])
        tally(entry, done)
    items.sort(key=lambda item: -item[1])
    return {"t": round(now), "dry_run": dry_run, "units": sum(s[0] for s in stores.values()),
            "bytes": sum(s[1] for s in stores.values()), "stores": stores, "skipped_open": skipped, "errors": errors,
            "denied": denied, "largest": items[:RECORD_ITEMS]}


def mount_of(path):
    path = os.path.realpath(path)
    while not os.path.ismount(path) and path != "/":
        path = os.path.dirname(path)
    return path


def volume_name(mount):
    """system-doctor's name for a volume: Data for the system's, a /Volumes mount's own name."""
    return mount[len("/Volumes/"):] if mount.startswith("/Volumes/") else "Data"


def free_bytes(path):
    """Free bytes of the volume holding path: LOG_SWEEP_FREE_GIB stands in for every volume (tests)."""
    fake = os.environ.get("LOG_SWEEP_FREE_GIB")
    if fake:
        return float(fake) * GIB
    found = os.statvfs(path)
    return found.f_bavail * found.f_frsize


def pressure(registry, now, target_gib, dry_run, say=print, only=()):
    """Frees cache stores' units, biggest first, while the volume holding each has under target_gib free: a `days`
    store gives every unit, another criterion only what it already removes, a command store runs whatever its last run.
    A dry run, and a faked free space, count what they would have freed toward the target; a real run reads the
    volume again after each removal."""
    candidates, items, skipped, errors, enough, denied = [], [], 0, 0, 0, 0
    for entry in log_stores.caches(registry):
        if only and entry["name"] not in only:
            continue
        rows = log_stores.measure(entry)
        denied += sum(1 for r in rows if r.get("denied"))
        rows = [r for r in rows if not r.get("denied")]
        if entry["cleaner"] == "command":
            if rows:
                candidates.append((sum(r["bytes"] for r in rows), entry, "run", rows[0]["path"], ()))
        elif entry["cleaner"] == "sweep":
            key, _value = log_stores.criterion(entry)
            gone = [(r, "delete") for r in rows] if key == "days" else log_stores.doomed(entry, rows, now)
            candidates += [(r["bytes"], entry, action, r["path"], r.get("also") or ()) for r, action in gone
                           if action == "delete"]
    candidates.sort(key=lambda c: (-c[0], c[3]))
    paths, freed, before = None, {}, {}
    stores = {}
    for size, entry, action, path, also in candidates:
        if not os.path.lexists(path):
            continue
        volume = mount_of(path)
        if volume not in before:
            before[volume] = free_bytes(volume)
        now_free = (before[volume] + freed.get(volume, 0)) if dry_run or os.environ.get("LOG_SWEEP_FREE_GIB") \
            else free_bytes(volume)
        if now_free >= target_gib * GIB:
            enough += 1
            continue
        if action == "run":
            done = run_command(entry, now, dry_run, say, due=True, timeout=PRESSURE_COMMAND_TIMEOUT_S)
            if done is None:
                errors += 1
                continue
            got = sum(b for _p, b in done)
        else:
            if paths is None:
                paths = open_paths()
            if paths is None or held(path, paths, also):
                skipped += 1
                continue
            got = size
            if dry_run:
                say("  %-8s %8.1f MB  %s" % ("delete", size / log_stores.MB, path))
            else:
                try:
                    remove(path, also)
                    prune_parents(path, [glob_base(p) for p in entry["globs"]])
                except FileNotFoundError:
                    continue
                except OSError as error:
                    errors += 1
                    say("log-sweep: delete %s: %s" % (path, error))
                    continue
        freed[volume] = freed.get(volume, 0) + got
        items.append([path, got])
        slot = stores.setdefault(entry["name"], [0, 0])
        slot[0] += 1
        slot[1] += got
    for name, (count, got) in stores.items():
        say("%s: %d unit%s, %.1f MB (pressure)" % (name, count, "" if count == 1 else "s", got / log_stores.MB))
    items.sort(key=lambda item: -item[1])
    after = {v: (before[v] + freed.get(v, 0)) if dry_run or os.environ.get("LOG_SWEEP_FREE_GIB") else free_bytes(v)
             for v in before}
    return {"t": round(now), "dry_run": dry_run, "pressure": target_gib, "units": sum(s[0] for s in stores.values()),
            "bytes": sum(s[1] for s in stores.values()), "stores": stores, "skipped_open": skipped, "errors": errors,
            "denied": denied, "enough": enough,
            "free_gib": {volume_name(v): [round(before[v] / GIB, 1), round(after[v] / GIB, 1)] for v in before},
            "largest": items[:RECORD_ITEMS]}


def main(argv=None):
    parser = argparse.ArgumentParser(prog="log-sweep", description=__doc__.split("\n")[0])
    parser.add_argument("--dry-run", action="store_true", help="print what would be removed, remove nothing")
    parser.add_argument("--store", action="append", help="only this store (repeatable)")
    parser.add_argument("--pressure", type=float, metavar="GIB",
                        help="cache stores only, every unit regardless of age, biggest first, until each volume has GIB free")
    parser.add_argument("--quiet", action="store_true", help="print nothing")
    parser.add_argument("--json", action="store_true", help="print the run's summary as JSON")
    args = parser.parse_args(argv)
    try:
        registry = log_stores.load()
    except (OSError, ValueError) as error:
        print("log-sweep: registry: %s" % error, file=sys.stderr)
        return 1
    say = (lambda *_: None) if args.quiet or args.json else print
    os.makedirs(state_dir(), exist_ok=True)
    with open(os.path.join(state_dir(), "sweep.lock"), "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            say("log-sweep: another sweep is running")
            if args.json:
                print(json.dumps({"busy": True}))
            return 0
        started = time.time()
        if args.pressure is not None:
            result = pressure(registry, started, args.pressure, args.dry_run, say, set(args.store or ()))
        else:
            result = sweep(registry, started, args.dry_run, set(args.store or ()), say)
        result["wall_s"] = round(time.time() - started, 1)
        if not args.dry_run:
            record(result)
    if args.json:
        print(json.dumps(result, ensure_ascii=False))
    else:
        say("%s %d units, %.1f MB in %.1f s%s%s" % ("would remove" if args.dry_run else "removed", result["units"],
                                                   result["bytes"] / log_stores.MB, result["wall_s"],
                                                   ", %d held open" % result["skipped_open"] if result["skipped_open"] else "",
                                                   ", %d errors" % result["errors"] if result["errors"] else ""))
    return 1 if result["errors"] else 0


if __name__ == "__main__":
    sys.exit(main())

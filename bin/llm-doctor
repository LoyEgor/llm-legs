# A pool that is empty because every account is walled is weather; one emptied by a switch or an
# exclusion list still staffed a cell nobody may run, which is ours. The pool message quotes the last
# account's error, so a crash inside it is the crash.
POOL_CONFIG_RE = re.compile(r"switched off for \w+|excluded by \w+")
POOL_CRASH_RE = re.compile(dict(FAILURE_REASONS)["crashed"].pattern + r"|Traceback", re.IGNORECASE)
# An account's login is the owner's to renew (`grokb add`, a browser sign-in); a refused credential
# export is our preparation failing to move to the next account (R12).
LOGIN_STATE_RE = re.compile(
    r"not logged in|not signed in|session has expired|credentials were rejected|not eligible for antigravity"
    r"|verify your account|accounts\.google\.com/signin", re.IGNORECASE)
EXPORT_REFUSAL_RE = re.compile(r"cell preparation refused|credential export", re.IGNORECASE)
# Copied from review-bench panel.py PROVIDER_TIMEOUT_RE: the vendor's clock, not our cap.
PROVIDER_TIMEOUT_RE = re.compile(
    r"gateway time-?out|" + HTTP_STATUS_PREFIX + r"504\b|\(code 504\)"
    r"|DEADLINE_EXCEEDED|upstream (?:request )?timeout", re.IGNORECASE)
TURN_BUDGET_RE = re.compile(r"stopped at the \d+-turn budget", re.IGNORECASE)
# A switch the owner closed from the menubar while the run was in flight: the cells were staffed
# while it was open and obeyed it, which is his own hand and no defect.
ROLE_SWITCH_RE = re.compile(r"\b(\w+) is switched off for (\w+)")
SWITCH_LINE_RE = re.compile(
    r"^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)\s+done\s+"
    r"(?:worker-model (\w+)=(on|off)|(\w+) (disable|enable) (\S+)) exit=0\b")
SWITCH_SLACK_S = 60
POOL_BINARIES = {"claudeb": "claudeb", "codex": "codexb", "gemini": "geminib", "grok": "grokb"}
# A watchdog kill that ended a cell while another cell of its panel still ran bought no wall time
# and lost the answer: our watchdog's defect, whatever the kill was called.
WATCHDOG_KILLS = ("stall", "watchdog")
KILLED_EARLY_SLACK_S = 60
# panel.cell_status's own reading of a model swap, which it tests before any vocabulary word.
MISMATCH_RE = re.compile(r"\bserved\b.+\binstead of\b", re.IGNORECASE | re.DOTALL)
CUT_RE = re.compile(r"panel interrupted before cell completed|^error: interrupted\b",
                    re.IGNORECASE | re.MULTILINE)
CEILING_RE = re.compile(r"print timeout after|timed out after|timeout waiting for response", re.IGNORECASE)
PRINT_TIMEOUT_RE = re.compile(r"print timeout after (?:(\d+)m)?(?:(\d+)s)?")
TIMED_OUT_RE = re.compile(r"timed out after (\d+)\s*(?:s\b|seconds)")
CHUNK_LINE_RE = re.compile(r"^chunk (\d+): exit (-?\d+): (.*?)(?=^chunk \d+: exit -?\d+: |\Z)",
                           re.MULTILINE | re.DOTALL)
JUDGE_SHORT_RE = re.compile(r"ruled on \d+ of \d+ claims", re.IGNORECASE)
PATH_RE = re.compile(r"(?<![\w.:/~])(~?/[^\s'\"`\\)(;|&<>/][^\s'\"`\\)(;|&<>]*)")
PROFILE_HOME_RE = re.compile(r"/\.(?:claude|gemini|codex|grok|opencode)-profiles/|/\.gemini/(?:antigravity/brain|tmp)/")
MAIN_STATE_RE = re.compile(r"/\.gemini/(?:antigravity/brain|tmp)/")
COPY_VERBS = ("cp", "rsync", "ln", "install", "ditto", "scp")
READ_VERBS = ("cat", "head", "tail", "grep", "rg", "less", "wc", "diff", "ls", "stat", "file")
COMMAND_SPLIT_RE = re.compile(r"&&|\|\||[;|\n]")
BENCH_ID_RE = re.compile(r"^(\d{8}T\d{6}Z)-[0-9a-f]+$")
WORKER_ID_RE = re.compile(r"^[a-z][a-z0-9]*-(\d{9,11})-\d+-[0-9a-z]+$")
USAGE_LIMIT_RE = re.compile(r"^OUTCOME: \w*_USAGE_LIMIT\b", re.MULTILINE)
OUTSIDE_WRITE_RE = re.compile(

def read_json(path):
    try:
        with open(path, encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


def read_jsonl(path):
    rows = []
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            for line in handle:
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                if isinstance(row, dict):
                    rows.append(row)
    except OSError:
        pass
    return rows


def read_tail(path, limit):
    try:
        with open(path, "rb") as handle:
            handle.seek(0, os.SEEK_END)
            handle.seek(max(0, handle.tell() - limit))
            return handle.read().decode("utf-8", "replace")
    except OSError:
        return ""


def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            return handle.read()
    except OSError:
        return None


def first_line(path):
    text = (read_text(path) or "").strip()
    return text.splitlines()[0].strip() if text else ""


def mtime_of(path):
    try:
        return os.stat(path).st_mtime
    except OSError:
        return None


def file_size(path):
    try:
        return os.stat(path).st_size
    except OSError:
        return None


def iso_epoch(value):
    if not isinstance(value, str) or len(value) < 19:
        return None
    try:
        return calendar.timegm(time.strptime(value[:19], "%Y-%m-%dT%H:%M:%S"))
    except ValueError:
        return None


def zoned_epoch(value):
    """An ISO time with its own offset; a bare one is read as UTC."""
    epoch = iso_epoch(value)
    if epoch is None:
        return None
    offset = re.search(r"([+-])(\d{2}):?(\d{2})$", value[19:])
    if offset:
        seconds = int(offset.group(2)) * 3600 + int(offset.group(3)) * 60
        epoch -= seconds if offset.group(1) == "+" else -seconds
    return epoch


def as_int(value):
    if isinstance(value, bool):
        return None
    if isinstance(value, int):
        return value
    try:
        return int(str(value).strip())
    except (TypeError, ValueError):
        return None


def project_of(path):
    if not isinstance(path, str) or not path:
        return ""
    if is_scratch_path(path):
        return "scratch"
    parts = path.rstrip("/").split("/")
    name = parts[-1]
    for index in range(1, len(parts) - 2):
        if parts[index] == ".claude" and parts[index + 1] == "worktrees" and not parts[index + 2].startswith("light-"):
            name = "%s/%s" % (parts[index - 1], parts[index + 2])
    return "" if ID_LIKE_RE.search(name) else name


def bench_project(meta):
    repo = meta.get("repo")
    if isinstance(repo, str) and "/worker-stats/merged/" in repo:
        names = []
        for entry in meta.get("repos") or []:
            if isinstance(entry, dict):
                name = project_of(entry.get("repo")) or project_of(entry.get("label"))
                if name and name not in names:
                    names.append(name)
        return "+".join(names)
    return project_of(repo)


_family_slugs = None


def family_slugs():
    """geminib's own family list, served family name → slug; empty without its cache."""
    global _family_slugs
    if _family_slugs is None:
        document = read_json(os.path.join(gemini.geminib_cache_dir(), "models.json")) or {}
        entries = document.get("families")
        _family_slugs = {}
        for entry in entries if isinstance(entries, list) else []:
            if not isinstance(entry, dict) or not isinstance(entry.get("slug"), str):
                continue
            for key in ("agy_prefix", "family"):
                name = gemini.family_of(entry.get(key))
                if name:
                    _family_slugs[name] = entry["slug"]
    return _family_slugs


def bench_model(cell):
    served = cell.get("served_model")
    if isinstance(served, str) and served:
        family = gemini.family_of(served)
        return family_slugs().get(family, family or served)
    model = str(cell.get("model") or "")
    for prefix in ("agy-", "oc-"):
        if model.startswith(prefix):
            return model[len(prefix):]
    return model


def seconds_text(seconds):
    return "" if seconds is None else "%ds" % int(round(seconds))


def timeout_detail(stderr, timeout_s):
    printed = PRINT_TIMEOUT_RE.search(stderr)
    if printed and (printed.group(1) or printed.group(2)):
        seconds = int(printed.group(1) or 0) * 60 + int(printed.group(2) or 0)
        return "print timeout %dm" % (seconds // 60) if seconds >= 60 else "print timeout %ds" % seconds
    timed_out = TIMED_OUT_RE.search(stderr)
    if timed_out:
        return "timeout %ss" % timed_out.group(1)
    if isinstance(timeout_s, (int, float)) and not isinstance(timeout_s, bool) and timeout_s > 0:
        return "timeout %ds" % timeout_s
    return "timeout"


def is_scratch_path(path):
    roots = ["/tmp", "/private/tmp", "/var/folders", "/private/var/folders",
             os.path.join(base_home(), ".cache")]
    if os.environ.get("TMPDIR"):
        roots.append(os.environ["TMPDIR"])
    if "/scratchpad/" in path + "/":
        return True
    return any(path == root.rstrip("/") or path.startswith(root.rstrip("/") + "/") for root in roots)


def outside_paths(text, exempt=PROFILE_HOME_RE):
    """Absolute or home-relative paths a leg named that are neither scratch space nor `exempt` state."""
    paths = []
    for path in PATH_RE.findall(text or ""):
        bare = path.rstrip(".,:")
        if bare.startswith("~/"):
            scratch = bare.startswith("~/.cache/") or "/scratchpad/" in bare + "/"
        else:
            scratch = is_scratch_path(bare)
        if not scratch and not exempt.search(path):
            paths.append(path)
    return paths


def own_state_re(account):
    """The vendor state an account may write: its own profile, never another account's."""
    if account in (None, "", "main"):
        return MAIN_STATE_RE
    return re.compile(r"/\.(?:claude|gemini|codex|grok|opencode)-profiles/%s(?:/|$)" % re.escape(str(account)))


def write_targets(text):
    """What an escape candidate writes: a bare path is its own target; a command writes its
    redirections, a copy's last argument, and every argument of a verb that is neither a copy nor a read."""
    text = text.strip()
    if not re.search(r"\s", text):
        return [text]
    targets = []
    for segment in COMMAND_SPLIT_RE.split(text):
        try:
            words = shlex.split(segment)
        except ValueError:
            words = segment.split()
        plain, pending = [], False
        for word in words:
            if pending:
                targets.append(word)
                pending = False
                continue
            redirect = re.match(r"^\d?>>?(.*)$", word)
            if redirect:
                if redirect.group(1):
                    targets.append(redirect.group(1))
                else:
                    pending = True
                continue
            plain.append(word)
        while plain and (re.match(r"^\w+=", plain[0]) or plain[0] in ("sudo", "env", "command")):
            plain.pop(0)
        if not plain:
            continue
        verb = os.path.basename(plain[0])
        arguments = [word for word in plain[1:] if not word.startswith("-")]
        if verb in COPY_VERBS:
            targets.extend(arguments[-1:])
        elif verb not in READ_VERBS:
            targets.extend(arguments)
    return targets


def age_text(seconds):
    if seconds < 3600:
        return "%dm" % (seconds // 60)
    if seconds < 86400:
        return "%dh" % (seconds // 3600)
    return "%dd" % (seconds // 86400)


def word_of_retry(retry_of):
    text = re.sub(r"^weather:\s*", "", str(retry_of or "")).strip()
    if text in FAILURE_ORIGIN:
        return text
    reason = failure_reason(text)
    return reason if reason in FAILURE_ORIGIN else ""


def classify_failure_text(text, exit_code, timeout_s=None):
    """(class, reason, detail, origin) of a leg that failed, read off its own words."""
    if MISMATCH_RE.search(text):
        return "failed", "mismatch", "mismatch", "theirs"
    reason = failure_reason(text)
    if reason == "killed memory":
        return "failed", reason, reason, "ours"
    if reason == "pool empty" and POOL_CRASH_RE.search(text):
        return "failed", "crashed", "pool empty: crashed", "ours"
    if reason == "pool empty" and not POOL_CONFIG_RE.search(text):
        return "walled", reason, reason, ""
    if reason in WALL_REASONS:
        return "walled", reason, reason, ""
    if reason == "auth" and LOGIN_STATE_RE.search(text) and not EXPORT_REFUSAL_RE.search(text):
        return "walled", "login", "needs login", ""
    if CUT_RE.search(text):
        return "cap", "cut", "cut by the panel", ""
    if reason in ("timeout", "unclassified") and PROVIDER_TIMEOUT_RE.search(text):
        return "failed", "timeout", "provider timeout", "theirs"
    if CEILING_RE.search(text):
        return "cap", "timeout", timeout_detail(text, timeout_s), ""
    if reason == "turn budget":
        if failure_reason(TURN_BUDGET_RE.sub("", text)) != "bad output":
            return "cap", "turns", "turn budget", ""
        reason = "bad output"
    detail = reason
    if reason in ("unclassified", "no output") and exit_code not in (None, 0, 1):
        detail = "%s · exit %s" % (reason, exit_code)
    return "failed", reason, detail, FAILURE_ORIGIN.get(reason, "")


def classify_bench(cell, escaped, retry_word="", run_done=False):
    killed = cell.get("killed")
    exit_code = cell.get("exit_code")
    stderr = cell.get("stderr") or ""
    duration = cell.get("duration_ms")
    duration_s = duration / 1000.0 if isinstance(duration, (int, float)) and duration > 0 else None
    abandoned = run_done and exit_code is None and not cell.get("errored") and not killed \
        and not cell.get("not_run")
    failed = bool(cell.get("errored")) or exit_code not in (0, None) or bool(killed) or abandoned
    if escaped:
        return "escaped", "escaped", "outside write", ""
    if not failed:
        own = CHUNK_LINE_RE.sub("", stderr)
        if cell.get("findings") == 0 and own.strip() and failure_reason(own) in EMPTY_ZERO_FINDING_REASONS:
            return classify_failure_text(own, exit_code)
        return None, "", "", ""
    if abandoned:
        klass, reason, detail, origin = classify_failure_text(stderr, None)
        if reason in ("no output", "unclassified"):
            detail = "no exit recorded"
        return klass, reason, detail, origin
    stalled_s = cell.get("stalled_s")
    stall = killed == "stall" or (isinstance(stalled_s, (int, float)) and stalled_s > 0)
    if MISMATCH_RE.search(stderr) and not stall and killed != "panel":
        return "failed", "mismatch", "mismatch", "theirs"
    reason = failure_reason(stderr)
    if killed == "memory" or reason == "killed memory":
        return "failed", "killed memory", "killed memory", "ours"
    if reason == "pool empty" or reason in WALL_REASONS:
        return classify_failure_text(stderr, exit_code)
    if stall:
        seconds = stalled_s if isinstance(stalled_s, (int, float)) and stalled_s > 0 else duration_s
        return "stalled", "stalled", ("stall " + seconds_text(seconds)).strip(), ""
    if killed == "panel" or CUT_RE.search(stderr):
        return "cap", "cut", ("cut by the panel " + seconds_text(duration_s)).strip(), ""
    if isinstance(exit_code, int) and exit_code < 0:
        return "cap", "cut", "signal %d" % -exit_code, ""
    if exit_code in (130, 143) and not stderr.strip():
        return "cap", "cut", "signal exit %d" % exit_code, ""
    if killed == "watchdog" or exit_code == 124:
        return "cap", "timeout", ("%s %s" % (killed or "exit 124", seconds_text(duration_s))).strip(), ""
    klass, reason, detail, origin = classify_failure_text(stderr, exit_code, cell.get("timeout_s"))
    if klass == "failed" and reason == "no output" and retry_word:
        return "failed", retry_word, retry_word, FAILURE_ORIGIN.get(retry_word, "")
    return klass, reason, detail, origin


def changed_roots(meta):
    """Roots the run's integrity record (or a legacy per-cell check) saw change."""
    roots = []
    record = meta.get("integrity")
    for row in (record.get("roots") or []) if isinstance(record, dict) else []:
        if isinstance(row, dict) and row.get("status") == "changed" and row.get("root"):
            roots.append(str(row["root"]))
    for cell in meta.get("rater_runs") or []:
        checks = cell.get("integrity_checks") if isinstance(cell, dict) else None
        for check in checks if isinstance(checks, list) else []:
            for row in (check.get("roots") or []) if isinstance(check, dict) else []:
                if isinstance(row, dict) and row.get("changed") and row.get("root"):
                    roots.append(str(row["root"]))
    return [root.rstrip("/") for root in roots]


def escape_evidence(meta):
    """rater spec → accounts whose escape candidates write a path outside scratch and outside that
    account's own vendor state, under a root the run's integrity record saw change. write_evidence
    is lexical — a denied or quoted call reads the same — so the integrity record is the proof."""
    roots = changed_roots(meta)
    hits = {}
    for key in ("write_evidence", "clone_escapes"):
        for hit in meta.get(key) or []:
            if not isinstance(hit, (list, tuple)) or not hit:
                continue
            account = hit[1] if len(hit) > 1 else None
            text = " ".join(str(part) for part in hit[2:]) if len(hit) > 2 else ""
            for target in outside_paths("\n".join(write_targets(text)), own_state_re(account)):
                target = target.rstrip(".,:")
                target = base_home() + target[1:] if target.startswith("~/") else target
                if any(target == root or target.startswith(root + "/") for root in roots):
                    hits.setdefault(hit[0], set()).add(account)
                    break
    return hits


def leg(block, surface, model, at, klass, reason, detail, origin, **extra):
    row = {"block": block, "surface": surface, "model": model or "", "at": at, "class": klass,
           "reason": reason, "detail": detail or "", "origin": origin, "attempt": "final",
           "duration": None, "project": "", "tier": "", "ref": "", "event": "", "start": None, "account": "",
           "text": "", "session": ""}
    row.update(extra)
    if not row["event"]:
        row["event"] = row["ref"]
    return row


def event_stamp(ts):
    return "%d" % ts if float(ts).is_integer() else "%.3f" % ts


def bench_legs(cutoff, now):
    root = os.path.join(stats_dir(), "benches")
    try:
        names = os.listdir(root)
    except OSError:
        return [], None
    legs, earliest = [], None
    for name in names:
        match = BENCH_ID_RE.match(name)
        run_dir = os.path.join(root, name)
        started = calendar.timegm(time.strptime(match.group(1), "%Y%m%dT%H%M%SZ")) if match else mtime_of(run_dir)
        if started is None:
            continue
        if match:
            earliest = started if earliest is None else min(earliest, started)
        if started < cutoff - 86400:
            continue
        meta = read_json(os.path.join(run_dir, "meta.json"))
        if not isinstance(meta, dict):
            continue
        session = str(meta.get("session") or "")
        for row in run_legs(meta, name, started, cutoff, now):
            row["session"] = session
            legs.append(row)
    return legs, earliest


def run_legs(meta, name, started, cutoff, now):
    evidence = escape_evidence(meta)
    project = bench_project(meta)
    scope_lines = as_int((meta.get("scope_price") or {}).get("lines")) if isinstance(meta.get("scope_price"), dict) else None
    tier = str(meta.get("tier") or "")
    rows = [row for row in meta.get("rater_runs") or [] if isinstance(row, dict)]
    if meta.get("cancelled"):
        rows = [row for row in rows if row.get("exit_code") is not None or row.get("errored") or row.get("killed")]
    finished = iso_epoch(meta.get("finished")) or iso_epoch(meta.get("finished_at")) \
        or iso_epoch(meta.get("closed_at")) or iso_epoch(meta.get("sealed_at"))
    run_done = finished is not None and not meta.get("cancelled")
    finished = finished or started
    last = {}
    for index, row in enumerate(rows):
        last[row.get("rater")] = index
    ends = {index: cell_end(cell, started) for index, cell in enumerate(rows)}
    escapes = {}
    for index, cell in enumerate(rows):
        if cell.get("account") in evidence.get(cell.get("rater"), ()):
            escapes[cell.get("rater")] = index
    for rater, index in last.items():
        if rater not in escapes and evidence.get(rater):
            escapes[rater] = index
    legs = []
    for index, cell in enumerate(rows):
        final = last.get(cell.get("rater")) == index
        duration = cell.get("duration_ms")
        duration_s = duration / 1000.0 if isinstance(duration, (int, float)) and duration > 0 else None
        ended = ends[index]
        if ended < cutoff or ended > now + 3600:
            continue
        escaped = escapes.get(cell.get("rater")) == index
        retry_word = ""
        if not final:
            retry_word = word_of_retry(rows[last[cell.get("rater")]].get("retry_of"))
        klass, reason, detail, origin = owner_switch(*classify_bench(cell, escaped, retry_word, run_done),
                                                     cell.get("stderr") or "", started, ended)
        if final and cell.get("killed") in WATCHDOG_KILLS and klass in ("stalled", "cap"):
            others = [ends[other] for other, row in enumerate(rows)
                      if last.get(row.get("rater")) == other and row.get("rater") != cell.get("rater")]
            waited = max(others, default=ended) - ended
            if waited > KILLED_EARLY_SLACK_S:
                klass, reason, origin = "failed", "killed early", "ours"
                detail = "%s, panel ran %s more" % (detail, seconds_text(waited))
        passes = cell.get("passes")
        chunked = isinstance(passes, int) and passes > 1
        per_pass = duration_s / passes if duration_s and chunked else duration_s
        max_pass = cell.get("max_pass_ms")
        max_pass_s = max_pass / 1000.0 if chunked and isinstance(max_pass, (int, float)) and max_pass > 0 else None
        if max_pass_s:
            per_pass = max_pass_s
        pass_lines = scope_lines / passes if scope_lines and chunked else scope_lines
        model = bench_model(cell)
        cohort = "·".join(part for part in (model, str(cell.get("effort") or ""), "chunks" if chunked else "") if part)
        begun = iso_epoch(cell.get("started_at"))
        begun = begun if begun is not None else (ended - duration_s if duration_s else started)
        common = {"project": project, "tier": tier, "ref": name, "account": cell.get("account") or "",
                  "event": "bench:%s/%s#%d" % (name, cell.get("rater") or "?", index), "start": begun,
                  "text": (cell.get("stderr") or "")[-TEXT_MAX:]}
        legs.append(leg("reviewers", "review", model, ended, klass, reason, detail, origin,
                        attempt="final" if final else "superseded", cohort=cohort,
                        duration=max_pass_s if cell.get("killed_chunks") else per_pass, size=pass_lines, **common))
        if final and klass != "escaped":
            # One cause across many chunks of one cell is one leg: a refusal that met eight queued
            # chunks is one event, not eight bugs.
            readings = {}
            for chunk in CHUNK_LINE_RE.finditer(cell.get("stderr") or ""):
                text = chunk.group(3).strip()
                c_exit = as_int(chunk.group(2))
                if isinstance(c_exit, int) and c_exit < 0:
                    reading = ("cap", "cut", "signal %d" % -c_exit, "")
                elif c_exit == 124:
                    reading = ("cap", "timeout", "exit 124", "")
                else:
                    reading = owner_switch(*classify_failure_text(text, c_exit, cell.get("timeout_s")),
                                           text, started, ended)
                if (reading[0], reading[1], reading[3]) == (klass, reason, origin) or (
                        reading[0] == "cap" and cell.get("killed")):
                    continue
                readings.setdefault(reading, [text, []])[1].append(int(chunk.group(1)))
            for (c_class, c_reason, c_detail, c_origin), (text, numbers) in readings.items():
                legs.append(leg("reviewers", "review", model, ended, c_class, c_reason,
                                "chunk%s %s: %s" % ("s" if len(numbers) > 1 else "", chunk_span(numbers),
                                                    c_detail),
                                c_origin, attempt="chunk", **dict(common, text=text)))
    judge = meta.get("judge")
    if isinstance(judge, dict) and judge.get("state") in ("ran", "failed") and cutoff <= finished <= now + 3600:
        legs.append(judge_leg(judge, finished, project, tier, name))
        if legs[-1]["start"] is None:
            legs[-1]["start"] = started
    failure = str(meta.get("failure") or "")
    if failure and not failure.startswith("cell failures:") and cutoff <= finished <= now + 3600:
        panel = {"project": project, "tier": tier, "ref": name, "event": "bench:%s/panel" % name, "start": started,
                 "text": failure[-TEXT_MAX:]}
        if re.search(r"SystemExit: *(?:143|130|2)\b|SIGTERM|KeyboardInterrupt", failure):
            legs.append(leg("reviewers", "panel", "panel", finished, "cap", "cut", "panel killed", "", **panel))
        else:
            legs.append(leg("reviewers", "panel", "panel", finished, "failed", "crashed",
                            failure.splitlines()[0][:DETAIL_MAX], "ours", **panel))
    return legs


def judge_leg(judge, at, project, tier, ref):
    duration = judge.get("duration_ms")
    duration_s = duration / 1000.0 if isinstance(duration, (int, float)) and duration > 0 else None
    common = {"project": project, "tier": tier, "ref": ref, "event": "bench:%s/judge" % ref,
              "start": at - duration_s if duration_s else None, "duration": duration_s,
              "size": as_int(judge.get("claims")), "text": str(judge.get("reason") or "")[-TEXT_MAX:]}
    model = str(judge.get("model") or "judge")
    batches = as_int(judge.get("batches")) or 1
    common["cohort"] = "%s·%s·%s" % (model, judge.get("effort") or "", "%d batches" % batches if batches < 4 else "4+ batches")
    if judge.get("state") != "failed":
        return leg("reviewers", "judge", model, at, None, "", "", "", **common)
    reason_text = str(judge.get("reason") or "")
    if judge.get("exit_code") == 124 or reason_text == "timeout":
        return leg("reviewers", "judge", model, at, "cap", "timeout",
                   ("timeout " + seconds_text(duration_s)).strip(), "", **common)
    if JUDGE_SHORT_RE.search(reason_text):
        return leg("reviewers", "judge", model, at, "failed", "bad output", "bad output", "ours", **common)
    if re.search(r"refused a read-only credential export", reason_text):
        return leg("reviewers", "judge", model, at, "failed", "auth", "auth", "ours", **common)
    klass, reason, detail, origin = classify_failure_text(reason_text, judge.get("exit_code"))
    return leg("reviewers", "judge", model, at, klass, reason, detail, origin, **common)


def kill_detail(line):
    words = line.split()
    if not words:
        return ""
    if len(words) > 1:
        number = words[1].rstrip("s")
        if number.isdigit():
            return "%s %ss" % (words[0], number)
    return words[0]


def worker_block(meta):
    light = str(meta.get("light") or "")
    return "light" if light or meta.get("role") == "research" else "workers"


def worker_escape(run_dir):
    lines = [line.strip() for line in (read_text(os.path.join(run_dir, "workdir-escape")) or "").splitlines()]
    return [line for line in lines if line and not is_scratch_path(line) and not PROFILE_HOME_RE.search(line)]


def light_verdict(run_dir):
    verdict = {}
    for line in (read_text(os.path.join(run_dir, "light-verdict")) or "").splitlines():
        key, _, value = line.partition(":")
        verdict[key.strip()] = value.strip()
    return verdict


def classify_worker(run_dir, meta, killed, exit_code):
    """(class, reason, detail, origin) of one worker-run leg, off the verdicts worker-run left beside it."""
    kill_word = killed.split()[0] if killed else ""
    outcome = first_line(os.path.join(run_dir, "outcome"))
    result = read_text(os.path.join(run_dir, "result")) or ""
    err = read_tail(os.path.join(run_dir, "err"), WORKER_TAIL_BYTES)
    granted = [str(path).rstrip("/") + "/" for path in meta.get("add_dirs") or [] if path]
    escapes = [path for path in worker_escape(run_dir)
               if not any((path.rstrip("/") + "/").startswith(root) for root in granted)]
    if escapes:
        return "escaped", "escaped", "worked in %s" % project_of(escapes[0]), ""
    note = read_text(os.path.join(run_dir, "files-note")) or ""
    outside = [path for path in outside_paths("\n".join(OUTSIDE_WRITE_RE.findall(note)))
               if not any(path.startswith(root) for root in granted)]
    if outside:
        return "escaped", "escaped", "wrote %s" % project_of(outside[0]), ""
    verdict = light_verdict(run_dir)
    if (verdict.get("SCOPE") or "").split()[:1] == ["escaped"]:
        return "escaped", "escaped", "light scope escaped", ""
    research = first_line(os.path.join(run_dir, "research-outcome"))
    if research == "READ_ONLY_VIOLATION":
        if DIGEST_RE.search(err):
            return "failed", "crashed", "tree digest not taken", "ours"
        return "escaped", "escaped", "read-only violation", ""
    if outcome.startswith("GROK_CANCELLED"):
        return "failed", "cancelled", "cancelled before the first turn", "theirs"
    if exit_code == 0 and (read_json(os.path.join(run_dir, "state.json")) or {}).get("phase") == "failed":
        if re.search(r"cancel", err, re.IGNORECASE) or re.search(
                r'"stopReason"\s*:\s*"cancelled"', read_tail(os.path.join(run_dir, "out"), WORKER_TAIL_BYTES)):
            return "failed", "cancelled", "cancelled before the first turn", "theirs"
        klass, reason, detail, origin = classify_failure_text(err, None)
        return klass, reason, "%s · failed under exit 0" % detail if klass == "failed" else detail, origin
    if exit_code == 0:
        if verdict.get("VERIFIED") == "fail":
            return "failed", "verify failed", "light verify failed", "ours"
        if verdict.get("LANDED") == "conflict":
            return "failed", "land conflict", "light landing conflict", "ours"
        return None, "", "", ""
    if os.path.exists(os.path.join(run_dir, "memguard")) and os.path.getsize(os.path.join(run_dir, "memguard")):
        return "failed", "killed memory", "killed memory", "ours"
    attempt = first_line(os.path.join(run_dir, "attempt"))
    if kill_word == "wall" or outcome.endswith("_USAGE_LIMIT") or research.endswith("_USAGE_LIMIT") \
            or USAGE_LIMIT_RE.search(result) or os.path.exists(os.path.join(run_dir, "wall-reset.%s" % attempt)):
        return "walled", "walled", "usage limit", ""
    if kill_word in ("silent", "idle"):
        return "stalled", "stalled", kill_detail(killed), ""
    if kill_word in ("deadline", "term", "signal"):
        return "cap", "timeout" if kill_word == "deadline" else "cut", kill_detail(killed), ""
    if exit_code in (137, 143):
        return "cap", "cut", "exit %d" % exit_code, ""
    if exit_code in (126, 127):
        return "failed", "crashed", "exit %d" % exit_code, "ours"
    if exit_code == 4 and not err.strip():
        return "failed", "crashed", "abandoned before launch", "ours"
    if outcome == "GROK_MAX_TURNS":
        return "cap", "turns", "max turns", ""
    klass, reason, detail, origin = classify_failure_text(err, exit_code)
    if klass == "failed" and not origin and exit_code is not None:
        detail = "%s · exit %d" % (reason, exit_code) if "exit" not in detail else detail
    return klass, reason, detail, origin


def worker_legs(cutoff, now):
    root = runs_dir()
    try:
        names = os.listdir(root)
    except OSError:
        return [], None
    legs, earliest = [], None
    for name in names:
        match = WORKER_ID_RE.match(name)
        run_dir = os.path.join(root, name)
        started = int(match.group(1)) if match else mtime_of(run_dir)
        if started is None or not os.path.isdir(run_dir):
            continue
        # browse/ and other long-lived directories are never pruned; only run ids date the store.
        if match:
            earliest = started if earliest is None else min(earliest, started)
        if started < cutoff - 86400 and max(mtime_of(os.path.join(run_dir, "exit_code")) or 0,
                                            mtime_of(os.path.join(run_dir, "killed")) or 0) < cutoff:
            continue
        tag = read_text(os.path.join(run_dir, "tag"))
        if not tag:
            continue
        fields = [field.strip() for field in tag.strip().split("·")]
        if len(fields) < 2 or not fields[1]:
            continue
        meta = read_json(os.path.join(run_dir, "meta.json")) or {}
        exit_path = os.path.join(run_dir, "exit_code")
        killed_path = os.path.join(run_dir, "killed")
        killed = first_line(killed_path)
        exit_text = read_text(exit_path)
        block = worker_block(meta)
        common = {"project": project_of(meta.get("workdir")), "ref": name, "event": "run:%s" % name,
                  "start": started, "account": fields[0],
                  "text": read_tail(os.path.join(run_dir, "err"), TEXT_MAX),
                  "session": (read_text(os.path.join(run_dir, "launcher")) or "").strip()}
        if exit_text is None and not killed:
            if now - started < NO_EXIT_S:
                if now - started >= NEAR_SHARE * NO_EXIT_S and supervisor_gone(run_dir, meta.get("pid") or ""):
                    near_miss("NO_EXIT_S", now - started, "s", now, "run:%s" % name)
                continue
            if not supervisor_gone(run_dir, meta.get("pid") or ""):
                continue
            ended = mtime_of(os.path.join(run_dir, "out")) or started
            boot = min((at for at in reboots(now)
                        if started < at and at - REBOOT_QUIET_S <= ended <= at + REBOOT_SLACK_S), default=None)
            if boot is not None and cutoff <= ended <= now + 3600:
                legs.append(leg(block, "worker", fields[1], ended, "rebooted", "reboot",
                                "no exit: the Mac rebooted at %s" % time.strftime("%H:%M", time.localtime(boot)),
                                "", **common))
            elif cutoff <= ended <= now + 3600:
                legs.append(leg(block, "worker", fields[1], ended, "failed", "crashed",
                                "no exit: supervisor gone", "ours", **common))
            continue
        exit_code = as_int(exit_text) if exit_text is not None else None
        ended = mtime_of(exit_path) or mtime_of(killed_path) or started
        if ended < cutoff or ended > now + 3600:
            continue
        klass, reason, detail, origin = classify_worker(run_dir, meta, killed, exit_code)
        attempt_start = as_int(meta.get("started_at"))
        begun = attempt_start if attempt_start and started <= attempt_start < ended else started
        vendor_end = mtime_of(os.path.join(run_dir, "out"))
        finished = vendor_end if vendor_end and begun < vendor_end <= ended else ended
        effort = fields[2] if len(fields) > 2 and fields[2] else str(meta.get("effort") or "")
        kind = str(meta.get("light") or ("research" if meta.get("role") == "research" else ""))
        cohort = "·".join(part for part in (fields[1], effort, kind, "resume" if meta.get("resume") else "") if part)
        legs.append(leg(block, "worker", fields[1], ended, klass, reason, detail, origin, cohort=cohort,
                        duration=finished - begun if finished > begun else None,
                        size=file_size(os.path.join(run_dir, "brief")), **dict(common, start=begun)))
        for account in meta.get("walled_accounts") or []:
            legs.append(leg(block, "worker", fields[1], started, "walled", "walled", "usage limit", "",
                            attempt="superseded", **dict(common, account=str(account),
                                                         event="run:%s/walled:%s" % (name, account))))
    if earliest is not None:
        earliest = max(earliest, now - WORKER_KEEP_D * 86400)
    return legs, earliest


def reboots(now):
    """Boot times, newest first, off `last reboot` (LLM_DOCTOR_REBOOTS: epochs, for fixtures)."""
    if _REBOOTS:
        return _REBOOTS[0]
    fixture = os.environ.get("LLM_DOCTOR_REBOOTS")
    found = []
    if fixture is not None:
        found = [int(value) for value in fixture.split(",") if value.strip().isdigit()]
    else:
        try:
            out = subprocess.run(["last", "reboot"], capture_output=True, text=True, timeout=5).stdout
        except (OSError, subprocess.SubprocessError):
            out = ""
        year = time.localtime(now).tm_year
        for line in out.splitlines():
            parts = line.split()
            if len(parts) < 4 or parts[0] != "reboot":
                continue
            # The locale orders `last`'s date: "28 Sep 16:39" or "Sep 28 16:39"; it prints no year.
            stamp = " ".join(parts[-3:])
            for layout in ("%d %b %H:%M", "%b %d %H:%M"):
                try:
                    at = time.mktime(time.strptime("%d %s" % (year, stamp), "%Y " + layout))
                    if at > now + 86400:
                        at = time.mktime(time.strptime("%d %s" % (year - 1, stamp), "%Y " + layout))
                except ValueError:
                    continue
                found.append(int(at))
                break
    _REBOOTS.append(sorted(found, reverse=True))
    return _REBOOTS[0]


def supervisor_gone(run_dir, pid):
    script = '. "$1" || exit 2; supervisor_running "$2" "$3"'
    try:
        return subprocess.run(["bash", "-c", script, "bash", os.path.join(ROOT_DIR, "share", "run-liveness.sh"),
                               run_dir, str(pid)], capture_output=True, timeout=10).returncode == 1
    except (OSError, subprocess.SubprocessError):
        return False


def prelaunch_legs(cutoff, now):
    """Refusals worker-run gave before any run directory existed, from its own prelaunch log."""
    legs, earliest = [], None
    for row in read_jsonl(os.path.join(runs_dir(), "prelaunch.jsonl")):
        at = row.get("ts")
        outcome = str(row.get("outcome") or "")
        if not isinstance(at, (int, float)) or not outcome:
            continue
        earliest = at if earliest is None else min(earliest, at)
        if at < cutoff or at > now + 3600 or outcome.split()[0] in PRELAUNCH_SKIP:
            continue
        block = "light" if row.get("light") or row.get("role") == "research" else "workers"
        model = str(row.get("model") or row.get("vendor") or "")
        account = str(row.get("account") or "")
        common = {"account": account, "ref": "prelaunch:%s/%s" % (event_stamp(at), account or "-"), "start": at,
                  "text": outcome}
        if outcome.endswith("_USAGE_LIMIT"):
            legs.append(leg(block, "worker", model, at, "walled", "walled", "pool walled at launch", "", **common))
        elif outcome.endswith("_UNAVAILABLE") and refused_by_switch(str(row.get("vendor") or ""),
                                                                     common["account"], at):
            legs.append(leg(block, "worker", model, at, "off", "off", "switched off", "", **common))
        elif outcome.endswith("_UNAVAILABLE"):
            legs.append(leg(block, "worker", model, at, "failed", "pool empty", "unavailable at launch",
                            "ours", **common))
        elif outcome in ("MODEL_REFUSED", "EFFORT_REFUSED"):
            legs.append(leg(block, "worker", model, at, "off", "refused", outcome.lower().replace("_", " "),
                            "", **common))
    return legs, earliest


def classify_image(rc, err):
    if rc == 0:
        return None, "", "", ""
    if rc == 3:
        return "walled", "walled", "usage limit", ""
    if rc == 2:
        return "failed", "bad command", "bad arguments", "ours"
    if rc in (130, 137, 143):
        return "cap", "cut", "signal exit %d" % rc, ""
    if rc == 4:
        if re.search(r"refusing|unreadable|unknown|cannot be read", err, re.IGNORECASE):
            return "failed", "crashed", "setup refused", "ours"
        if re.search(r"refused by the worker pool|out of the worker pool", err, re.IGNORECASE):
            return "failed", "pool empty", "pool refused", "ours"
        return "skip", "", "", ""
    word = failure_reason(err)
    if FAILURE_ORIGIN.get(word) == "theirs" or word in WALL_REASONS:
        return classify_failure_text(err, rc)
    for reason, pattern in IMAGE_REASONS:
        if pattern.search(err):
            if reason == "cap":
                return "cap", "timeout", "deadline", ""
            if reason == "not entitled":
                return "walled", reason, reason, ""
            return "failed", reason, reason, IMAGE_ORIGIN.get(reason, "")
    klass, reason, detail, origin = classify_failure_text(err, rc)
    if klass == "cap" and reason == "timeout" and not re.search(r"print timeout after|deadline", err):
        return "failed", "timeout", "timeout", "ours"
    return klass, reason, detail, origin


def classify_browser(code, reason):
    """A BROWSER_ line's verdict: its exit code first, then the provider's own weather, then the step."""
    if code == 3:
        return "walled", "walled", "usage limit", ""
    if code == 2:
        return "failed", "bad command", "bad arguments", "ours"
    word = failure_reason(reason)
    if code and (FAILURE_ORIGIN.get(word) == "theirs" or word in WALL_REASONS):
        return classify_failure_text(reason, code)
    detail = reason[:200]
    if code == 4:
        return "failed", BROWSER_OWNER_STEP, detail, "ours"
    for word, pattern in BROWSER_REASONS:
        if pattern.search(reason):
            return "failed", word, detail, "ours"
    return "failed", BROWSER_OTHER, detail, "ours"


def browser_text(route, account, shot, reason):
    home = base_home()
    shot = "~" + shot[len(home):] if home and shot.startswith(home + "/") else shot
    return "browser route=%s account=%s shot=%s reason=%s" % (route, account, shot, reason)


def image_legs(cutoff, now):
    legs, earliest = [], None
    for row in read_jsonl(image_log()):
        at = row.get("ts")
        rc = as_int(row.get("rc"))
        if not isinstance(at, (int, float)) or rc is None:
            continue
        earliest = at if earliest is None else min(earliest, at)
        if at < cutoff or at > now + 3600:
            continue
        err = str(row.get("err") or "")
        model = str(row.get("tool") or "")
        lines = BROWSER_LINE_RE.findall(err)
        final = lines[-1] if rc != 0 and lines and lines[-1][0] == "FAILURE" else None
        for index, (_, route, line_account, code, shot, said) in enumerate(lines[:-1] if final else lines):
            klass, reason, detail, origin = classify_browser(int(code), said)
            legs.append(leg("image", str(row.get("kind") or "image"), model, at, klass, reason, detail, origin,
                            attempt="superseded", account=line_account, browser=True,
                            ref="image:%s/%s/%s#%d" % (event_stamp(at), model or "-", line_account, index + 1),
                            start=at, text=browser_text(route, line_account, shot, said)))
        if final:
            _, route, line_account, code, shot, said = final
            klass, reason, detail, origin = classify_browser(int(code), said)
            err = browser_text(route, line_account, shot, said)
            if not row.get("account") and line_account != "-":
                row = dict(row, account=line_account)
        else:
            klass, reason, detail, origin = classify_image(rc, err)
        if klass == "skip":
            continue
        if reason == "pool empty" and refused_by_switch(model.split("-")[0], str(row.get("account") or ""), at):
            klass, reason, detail, origin = "off", "off", "switched off", ""
        served = str(row.get("served") or "")
        seconds = row.get("seconds") if isinstance(row.get("seconds"), (int, float)) and row["seconds"] > 0 else None
        account = str(row.get("account") or "")
        legs.append(leg("image", str(row.get("kind") or "image"), model, at, klass, reason, detail, origin,
                        cohort=model + "·" + served if served else model, duration=seconds,
                        size=as_int(row.get("size")), account=account,
                        ref="image:%s/%s/%s" % (event_stamp(at), model or "-", account or "-"),
                        start=at - seconds if seconds else at, text=err[-TEXT_MAX:], browser=bool(final)))
    return legs, earliest


def comparable_size(size, other):
    if not (isinstance(size, (int, float)) and size > 0):
        return not (isinstance(other, (int, float)) and other > 0)
    return isinstance(other, (int, float)) and other > 0 and max(size, other) <= SLOW_SIZE_RATIO * min(size, other)


def local_slow_windows():
    """[(start, end)] the Harness doctor judged this Mac itself slow in: a leg slow inside one is no
    model's weather. Its `local_slow` key, epochs; absent, nothing is local."""
    path = os.environ.get("HARNESS_DOCTOR_LATEST") or os.path.join(base_home(), ".cache", "harness-doctor",
                                                                   "latest.json")
    windows = (read_json(path) or {}).get("local_slow")
    return [(pair[0], pair[1]) for pair in windows or [] if isinstance(pair, list) and len(pair) == 2
            and all(isinstance(value, (int, float)) for value in pair)]


def mark_slow(legs):
    """Each completed leg against the median of the SLOW_BASE_N completions of its cohort, within
    SLOW_SIZE_RATIO of its input size, that ended before it within SLOW_BASE_D. Slow legs
    stay in the sample: a model whose new speed persists becomes its own baseline after about half
    that many legs, and a verdict, resting only on what came before, never flips when later legs
    arrive."""
    history, local = {}, local_slow_windows()
    for leg_row in sorted(legs, key=lambda row: row["at"]):
        duration = leg_row["duration"]
        if leg_row["class"] is not None or leg_row["attempt"] != "final" or not duration or duration <= 0:
            continue
        key = (leg_row["block"], leg_row["surface"], leg_row.get("cohort") or leg_row["model"])
        size = leg_row.get("size")
        recent = [item for item in history.get(key, []) if item[0] >= leg_row["at"] - SLOW_BASE_D * 86400]
        history[key] = recent + [(leg_row["at"], duration, size)]
        earlier = [item for item in recent if comparable_size(size, item[2])][-SLOW_BASE_N:]
        if len(earlier) < SLOW_MIN_LEGS:
            leg_row["baseline"] = None
            continue
        median = statistics.median(item[1] for item in earlier)
        leg_row["baseline"] = median
        if duration > SLOW_FACTOR * median and duration - median >= SLOW_FLOOR_S:
            leg_row["class"], leg_row["reason"] = "slow", "slow"
            unit = 60 if median >= 60 else 1
            leg_row["detail"] = "%d%s vs %d%s median" % (
                round(duration / unit), "m" if unit == 60 else "s", round(median / unit),
                "m" if unit == 60 else "s")
            if any(start < leg_row["at"] and leg_row["at"] - duration < end for start, end in local):
                leg_row["reason"] = "local slow"
                leg_row["detail"] += " · this Mac was slow (Harness)"


def verdict_of(leg_row):
    """bug | weather | clean, before the ledger speaks."""
    if leg_row["class"] is None:
        return "clean"
    if leg_row["class"] == "escaped":
        return "bug"
    if leg_row["attempt"] == "superseded":
        return "weather"
    if leg_row["class"] == "failed" and leg_row["origin"] != "theirs":
        return "bug"
    return "weather"


BUG_STATES = ("new", "open", "regressed")
# The words a bug leg can carry (word_of): a ledger row naming any other word never matches a leg.
LEDGER_WORDS = frozenset({word for word, origin in FAILURE_ORIGIN.items() if origin == "ours"}
                         | {word for word, origin in IMAGE_ORIGIN.items() if origin == "ours"}
                         | {"escaped", "unclassified", "no output", "killed early", "verify failed", "land conflict"})
WORD_MATCH_KEYS = {"word", "model", "detail", "until"}
FIX_KEYS = {"at", "by", "files", "in", "regressed_at"}
BLIND_KEYS = ("id", "what", "reason", "since", "would_catch_if")


def word_of(leg_row):
    return leg_row["reason"] if leg_row["class"] == "failed" else leg_row["class"]


def problem_key(leg_row):
    if leg_row["attempt"] == "superseded" and leg_row["class"] != "escaped":
        return ("retried", "", "")
    if leg_row["class"] == "failed":
        return ("failed", leg_row["reason"], leg_row["origin"])
    return (leg_row["class"], "", "")


def key_label(key):
    klass, reason, origin = key
    if klass == "failed":
        return "failed · %s%s" % (reason, " · theirs" if origin == "theirs" else "")
    return klass


def leg_rule(leg_row):
    return "leg-escape" if leg_row["class"] == "escaped" else "leg-failure"


def leg_id(leg_row, row):
    """A bug leg's problem id: its ledger row, else its rule, block and word, never text of the leg."""
    if row is not None:
        return row["id"]
    return "%s:%s/%s" % (leg_rule(leg_row), leg_row["block"], word_of(leg_row))


def narrow_regex(pattern):
    """A matcher that matches empty text, or names no three-character literal, matches (nearly) every leg."""
    if not isinstance(pattern, str) or not re.search(r"[A-Za-z0-9]{3}", pattern):
        return False
    try:
        return re.compile(pattern, re.IGNORECASE).search("") is None
    except re.error:
        return False


def fix_faults(fix):
    if not isinstance(fix, dict) or not set(fix) <= FIX_KEYS:
        return ["a fix is {at, by, files, in, regressed_at}"]
    faults = []
    if zoned_epoch(fix.get("at")) is None:
        faults.append("fix at is no ISO time with offset")
    if not isinstance(fix.get("by"), str) or not fix["by"].strip():
        faults.append("fix by names no chat")
    files = fix.get("files")
    if not isinstance(files, list) or not all(isinstance(path, str) and "/" in path.strip("/") for path in files):
        faults.append("fix files are repo/path strings")
    if fix.get("in") is not None and not FIX_IN_RE.match(str(fix["in"])):
        faults.append("fix in %r is not repo@hash" % fix["in"])
    if fix.get("regressed_at") is not None and zoned_epoch(fix["regressed_at"]) is None:
        faults.append("fix regressed_at is no ISO time")
    return faults


def row_faults(row, ids):
    """Why one ledger row may not judge: a row the judge cannot trust never matches a leg."""
    if not isinstance(row, dict):
        return ["not an object"]
    faults = []
    if not isinstance(row.get("id"), str) or not row["id"].strip():
        faults.append("no id")
    if row.get("block") not in BLOCKS + ("any",):
        faults.append("block %r" % row.get("block"))
    status = row.get("status")
    if status not in LEDGER_STATUSES:
        faults.append("status %r" % status)
    if "fixed_in" in row or "fixed_at" in row:
        faults.append("fixed_in/fixed_at are fixes[]")
    if not isinstance(row.get("title"), str) or not row["title"].strip():
        faults.append("no title")
    if not isinstance(row.get("reviewed_by"), str) or not row["reviewed_by"].strip():
        faults.append("reviewed_by names no chat")
    match = row.get("match")
    if not isinstance(match, dict):
        faults.append("no match")
    elif "machinery" in match:
        if set(match) != {"machinery"} or row.get("block") != "reviewers" \
                or not isinstance(match["machinery"], str) or not match["machinery"]:
            faults.append("a machinery row is {machinery} alone on reviewers")
        if status in DISMISSALS:
            faults.append("a machinery row matches a whole class: open or fixed, never %s" % status)
    elif "health" in match:
        if set(match) != {"health", "key"} or match.get("health") not in HEALTH_RULES:
            faults.append("a health row is {health, key}")
        elif not narrow_regex(match.get("key")):
            faults.append("health key %r matches every item" % match.get("key"))
    else:
        if not set(match) <= WORD_MATCH_KEYS or not isinstance(match.get("word"), str) \
                or match["word"] not in LEDGER_WORDS:
            faults.append("match %r names no bug word" % match)
        if not (match.get("model") or match.get("detail")):
            faults.append("a catch-all: word %r with no model or detail" % match.get("word"))
        for key in ("model", "detail"):
            if match.get(key) and not narrow_regex(match[key]):
                faults.append("%s %r matches every leg" % (key, match[key]))
        if "until" in match and zoned_epoch(match["until"]) is None:
            faults.append("until is no ISO time with offset")
    fixes = row.get("fixes")
    if not isinstance(fixes, list):
        faults.append("no fixes list")
        fixes = []
    for fix in fixes:
        faults.extend(fix_faults(fix))
    if status in FIXED_STATUSES and not fixes:
        faults.append("%s with no fix" % status)
    elif status == "fixed" and isinstance(fixes[-1], dict) and not fixes[-1].get("in"):
        faults.append("fixed while its last fix has no commit (fixed-pending)")
    elif status == "fixed-pending" and isinstance(fixes[-1], dict) and (fixes[-1].get("in") or not fixes[-1].get("files")):
        faults.append("fixed-pending needs its last fix's files and no commit yet")
    same = row.get("same_cause")
    if not isinstance(same, list) or not all(isinstance(other, str) and other in ids and other != row.get("id")
                                             for other in same):
        faults.append("same_cause names an id the ledger lacks")
    if row.get("handoff") is not None and not isinstance(row["handoff"], str):
        faults.append("handoff is a path or null")
    return faults


def ledger_faults(document):
    """Every reason the ledger may not judge, one `(where, why)` each. The doctor drops a faulty row from
    judging and reports its faults as one problem; the tests hold the committed ledger to none."""
    if not isinstance(document, dict):
        return [("ledger", "not a JSON object")]
    faults = []
    if not isinstance(document.get("owner"), str) or not document["owner"].strip():
        faults.append(("owner", "names no chat"))
    owners = document.get("owners")
    if not isinstance(owners, dict) or set(owners) != set(BLOCKS) \
            or not all(isinstance(name, str) and name.strip() for name in owners.values()):
        faults.append(("owners", "every block names a chat"))
    rows = document.get("rows") if isinstance(document.get("rows"), list) else []
    ids = [row.get("id") for row in rows if isinstance(row, dict)]
    for index, row in enumerate(rows):
        where = row["id"] if isinstance(row, dict) and isinstance(row.get("id"), str) and row["id"].strip() \
            else "rows[%d]" % index
        if ids.count(where) > 1:
            faults.append((where, "id used twice"))
        faults.extend((where, fault) for fault in row_faults(row, ids))
    spots = document.get("blind_spots")
    if not isinstance(spots, list):
        faults.append(("blind_spots", "not a list"))
        spots = []
    for spot in spots:
        if not blind_spot_ok(spot):
            faults.append(("blind_spots", "each is {%s}" % ", ".join(BLIND_KEYS)))
    return faults


def blind_spot_ok(spot):
    return isinstance(spot, dict) and all(isinstance(spot.get(key), str) and spot[key].strip() for key in BLIND_KEYS)


def last_fix_at(row):
    fixes = row.get("fixes") or []
    if not fixes or not isinstance(fixes[-1], dict):
        return None
    at, landed = zoned_epoch(fixes[-1].get("at")), fix_landed(fixes[-1].get("in"), repos_dir())
    return at if at is None or landed is None else max(at, landed)


def load_ledger():
    document = read_json(ledger_path())
    faults = ledger_faults(document) if document is not None else [("ledger", "missing or not JSON")]
    document = document if isinstance(document, dict) else {}
    source = [row for row in document.get("rows") or [] if isinstance(row, dict)] \
        if isinstance(document.get("rows"), list) else []
    ids = [row.get("id") for row in source]
    rows, machinery_rows, health_rows = [], {}, []
    for row in source:
        if row_faults(row, ids) or ids.count(row.get("id")) > 1:
            continue
        compiled = dict(row, _fixed_at=last_fix_at(row))
        match = row["match"]
        if "machinery" in match:
            machinery_rows.setdefault(match["machinery"], compiled)
            continue
        if "health" in match:
            compiled["_key"] = re.compile(match["key"], re.IGNORECASE)
            health_rows.append(compiled)
            continue
        compiled["_model"] = re.compile(match["model"]) if match.get("model") else None
        compiled["_detail"] = re.compile(match["detail"], re.IGNORECASE) if match.get("detail") else None
        compiled["_until"] = zoned_epoch(match["until"]) if match.get("until") else None
        compiled["_specific"] = int(bool(compiled["_model"])) + int(bool(compiled["_detail"])) \
            + int(row.get("block") != "any") + int(compiled["_until"] is not None)
        rows.append(compiled)
    order = {id(row): index for index, row in enumerate(rows)}
    rows.sort(key=lambda row: (-row["_specific"], order[id(row)]))
    owners = document.get("owners") if isinstance(document.get("owners"), dict) else {}
    spots = [spot for spot in document.get("blind_spots") or [] if blind_spot_ok(spot)] \
        if isinstance(document.get("blind_spots"), list) else []
    return {"owner": document.get("owner") or "", "owners": owners, "rows": rows, "machinery": machinery_rows,
            "health": health_rows, "blind_spots": spots, "faults": faults,
            "ids": {value for value in ids if isinstance(value, str)},
            "by_id": {row["id"]: row for row in rows + list(machinery_rows.values()) + health_rows}}


def ledger_match(ledger, leg_row):
    word = word_of(leg_row)
    for row in ledger["rows"]:
        if row["match"]["word"] != word or row.get("block") not in ("any", leg_row["block"]):
            continue
        if row["_model"] and not row["_model"].search(leg_row["model"]):
            continue
        if row["_until"] is not None and leg_row["at"] > row["_until"]:
            continue
        if row["_detail"] and not (row["_detail"].search(leg_row["text"]) or row["_detail"].search(leg_row["detail"])):
            continue
        return row
    return None


def leg_start(leg_row):
    start = leg_row.get("start")
    return start if isinstance(start, (int, float)) else leg_row["at"]


def judge_leg_state(ledger, leg_row):
    """new | open | regressed | fixed | weather — the leg's standing once the ledger has spoken. Only a leg
    that STARTED after the last fix ran on code that holds it, so only such a leg regresses the fix."""
    verdict = verdict_of(leg_row)
    if verdict != "bug":
        return verdict, None
    row = ledger_match(ledger, leg_row)
    if row is None:
        return "new", None
    status = row.get("status")
    if status in DISMISSALS:
        return "weather", row
    if status in FIXED_STATUSES:
        fixed_at = row["_fixed_at"]
        return ("regressed" if fixed_at is None or leg_start(leg_row) > fixed_at else "fixed"), row
    return "open", row


def mark_problems(ledger, legs):
    """Each leg's state, ledger row and problem id (`pid`); a superseded attempt that failed on our side
    keeps the id it would carry as a final one in `hidden`, so a cause a retry hides still adds up."""
    for leg_row in legs:
        leg_row["state"], leg_row["ledger"] = judge_leg_state(ledger, leg_row)
        if leg_row["state"] in BUG_STATES + ("fixed",):
            leg_row["pid"] = leg_id(leg_row, leg_row["ledger"])
        else:
            leg_row["pid"] = leg_row["ledger"]["id"] if leg_row["ledger"] is not None else ""
        if leg_row["attempt"] == "superseded" and leg_row["class"] == "failed" and leg_row["origin"] != "theirs":
            state, row = judge_leg_state(ledger, dict(leg_row, attempt="final"))
            if state in BUG_STATES:
                leg_row["hidden"] = leg_id(leg_row, row)


def local_day(epoch):
    return time.strftime("%Y-%m-%d", time.localtime(epoch))


def trend_days(now):
    today = datetime.date.fromtimestamp(now)
    return [(today - datetime.timedelta(days=offset)).isoformat() for offset in range(TREND_DAYS - 1, -1, -1)]


def day_start(day):
    return time.mktime(time.strptime(day, "%Y-%m-%d"))


def rollup_key(leg_row):
    klass, reason, origin = problem_key(leg_row)
    return "|".join((leg_row["block"], leg_row["model"], klass, reason, origin, leg_row.get("pid") or ""))


def relabel_frozen(counts, ledger, at):
    """A frozen day keeps the id its bug legs had then: none, an unledgered id, or a ledger row since
    deleted. Such counts move to the row that claims them without detail text, else to the unledgered id
    the split gives them, so a problem's sparkline holds its own history and no other's."""
    relabeled = {}
    for key, value in counts.items():
        fields = key.split("|")
        bug = len(fields) == 6 and (fields[2] == "escaped" or (fields[2] == "failed" and fields[4] != "theirs"))
        if bug and fields[5] not in ledger["ids"]:
            synthetic = {"block": fields[0], "model": fields[1], "class": fields[2],
                         "reason": fields[3] if fields[2] == "failed" else fields[2], "text": "", "detail": "", "at": at}
            row = ledger_match(ledger, synthetic)
            fields[5] = leg_id(synthetic, row if row is not None and row["_detail"] is None else None)
        relabeled["|".join(fields)] = relabeled.get("|".join(fields), 0) + value
    return relabeled


def rollup(legs, coverage, now, write, ledger):
    """Per local day of the trend: counts per (block, model, key) — recomputed from the stores while
    they still hold the whole day, read back from the frozen file once they do not."""
    directory = os.path.join(doctor_dir(), "daily")
    days = trend_days(now)
    fresh = {day: {"counts": {}, "legs": {}} for day in days}
    for leg_row in legs:
        day = local_day(leg_row["at"])
        if day not in fresh:
            continue
        if leg_row["attempt"] == "final":
            key = leg_row["block"] + "|" + leg_row["model"]
            fresh[day]["legs"][key] = fresh[day]["legs"].get(key, 0) + 1
        if leg_row["class"] is not None:
            key = rollup_key(leg_row)
            fresh[day]["counts"][key] = fresh[day]["counts"].get(key, 0) + 1
    result = {}
    for day in days:
        path = os.path.join(directory, day + ".json")
        stored = read_json(path) if os.path.exists(path) else None
        merged = {"day": day, "counts": {}, "legs": {}, "covered": []}
        for block in BLOCKS:
            since = coverage.get(block)
            whole = since is not None and since <= day_start(day)
            source = fresh[day] if whole or not isinstance(stored, dict) \
                else dict(stored, counts=relabel_frozen(stored.get("counts") or {}, ledger, day_start(day)))
            for part in ("counts", "legs"):
                for key, value in (source.get(part) or {}).items():
                    if key.split("|", 1)[0] == block:
                        merged[part][key] = value
            if whole or (isinstance(stored, dict) and block in (stored.get("covered") or [])):
                merged["covered"].append(block)
        result[day] = merged
        if write and day != days[-1] and merged["covered"]:
            temporary = "%s.tmp.%d" % (path, os.getpid())
            try:
                os.makedirs(directory, exist_ok=True)
                with open(temporary, "w", encoding="utf-8") as handle:
                    json.dump(merged, handle, ensure_ascii=False, sort_keys=True)
                    handle.write("\n")
                os.replace(temporary, path)
            except OSError as error:
                print("llm-doctor: daily rollup not written: %s" % error, file=sys.stderr)
                if os.path.exists(temporary):
                    os.remove(temporary)
                write = False
    return result


def spark(values):
    top = max(values) if values else 0
    if top <= 0:
        return ""
    return "".join(" " if value == 0 else SPARK[min(len(SPARK) - 1, (value * len(SPARK) - 1) // top)]
                   for value in values)


def trend_mark(count, legs, base_count, base_legs):
    """↑/↓ on a ≥2× move of the window's rate per leg against the rollup's days before the window."""
    if not legs or not base_legs:
        return ""
    rate, base = count / legs, base_count / base_legs
    if count >= TREND_MIN and rate >= 2 * base:
        return "up"
    if base_count >= TREND_MIN and rate * 2 <= base:
        return "down"
    return ""


def top_counts(counter, limit):
    return [name for name, _ in sorted(counter.items(), key=lambda pair: (-pair[1], pair[0]))[:limit]]


def iso_time(epoch):
    if not isinstance(epoch, (int, float)):
        return None
    return datetime.datetime.fromtimestamp(epoch).astimezone().isoformat(timespec="seconds")


def excerpt_of(leg_row):
    """At most EXCERPT_MAX characters of the raw text the matcher read, around what it matched."""
    text = (leg_row.get("text") or "").strip()
    if leg_row.get("browser"):
        return text[:EXCERPT_MAX]
    if leg_row["class"] == "failed":
        for word, pattern in FAILURE_REASONS + IMAGE_REASONS:
            found = pattern.search(text) if word == leg_row["reason"] else None
            if found:
                begin = max(0, min(found.start() - EXCERPT_MAX // 3, len(text) - EXCERPT_MAX))
                return text[begin:begin + EXCERPT_MAX]
    return (text[-EXCERPT_MAX:] if leg_row["class"] == "failed" else "") or leg_row["detail"][:EXCERPT_MAX]


def evidence_of(rows):
    """Up to EVIDENCE_MAX events, newest first, one per event ref."""
    seen, found = set(), []
    for leg_row in sorted(rows, key=lambda item: -item["at"]):
        if leg_row["event"] in seen:
            continue
        seen.add(leg_row["event"])
        found.append({"at": iso_time(leg_row["at"]), "ref": leg_row["event"], "account": leg_row.get("account") or "",
                      "excerpt": excerpt_of(leg_row)})
        if len(found) == EVIDENCE_MAX:
            break
    return found


def incident_of(leg_row, now):
    age = max(0, int(now - leg_row["at"]))
    return {"age_s": age, "age": age_text(age), "at": int(leg_row["at"]), "model": leg_row["model"],
            "surface": leg_row["surface"], "project": leg_row["project"], "tier": leg_row["tier"],
            "attempt": leg_row["attempt"], "detail": leg_row["detail"][:DETAIL_MAX], "ref": leg_row["ref"],
            "event": leg_row["event"], "account": leg_row.get("account") or "", "session": leg_row["session"],
            "chat": ""}


def ledger_view(row):
    if row is None:
        return None
    return {key: row.get(key) for key in
            ("id", "title", "status", "fixes", "same_cause", "last_reviewed", "reviewed_by", "note", "handoff")}


def days_since(date_text, now):
    epoch = zoned_epoch(date_text + "T00:00:00") if isinstance(date_text, str) and len(date_text) == 10 \
        else zoned_epoch(date_text)
    return None if epoch is None else max(0, int((now - epoch) // 86400))


def proof(row, legs):
    """(events, matched) since the row's last fix: the final legs its matcher could have met that started
    after the fix, and how many of them it met."""
    fixed_at = row["_fixed_at"]
    events = matched = 0
    for leg_row in legs:
        if fixed_at is None or leg_row["attempt"] != "final" or leg_start(leg_row) <= fixed_at:
            continue
        if row.get("block") not in ("any", leg_row["block"]):
            continue
        if row.get("_model") and not row["_model"].search(leg_row["model"]):
            continue
        events += 1
        matched += int(leg_row.get("pid") == row["id"] and leg_row["state"] == "regressed")
    return events, matched


def proof_text(row, legs, now):
    events, matched = proof(row, legs)
    since = days_since((row.get("fixes") or [{}])[-1].get("at"), now)
    return "%s %s· %d since · %d matched%s" % (
        "fix pending commit" if row.get("status") == "fixed-pending" else "fixed",
        "%dd " % since if since is not None else "", events, matched, " · unproven" if events < PROOF_MIN else "")


def seen_span(legs):
    """pid → (first start, last end) over every loaded leg of a bug problem."""
    span = {}
    for leg_row in legs:
        if leg_row.get("pid") and leg_row["state"] in BUG_STATES + ("fixed",):
            first, last = span.get(leg_row["pid"], (leg_start(leg_row), leg_row["at"]))
            span[leg_row["pid"]] = (min(first, leg_start(leg_row)), max(last, leg_row["at"]))
    return span


def recovered_of(window):
    """hidden id → [lost attempts] of the superseded legs that failed on our side before a retry won."""
    hidden = {}
    for leg_row in window:
        if leg_row.get("hidden"):
            hidden.setdefault(leg_row["hidden"], []).append(leg_row)
    return hidden


def build_block(block, legs, ledger, daily, window_cutoff, now, coverage):
    window = [leg_row for leg_row in legs if leg_row["block"] == block and leg_row["at"] >= window_cutoff]
    window_legs = sum(1 for leg_row in window if leg_row["attempt"] == "final")
    prefix = "%s|" % block
    days = sorted(daily)
    base_days = [day for day in days if day_start(day) + 86400 <= window_cutoff and block in daily[day]["covered"]]
    base_legs = sum(value for day in base_days for key, value in daily[day]["legs"].items() if key.startswith(prefix))
    span, hidden = seen_span(legs), recovered_of(window)
    groups = {}
    for leg_row in window:
        state, row = leg_row["state"], leg_row["ledger"]
        if state == "clean":
            continue
        key = problem_key(leg_row)
        group_id = ("bug", leg_row["pid"]) if state in BUG_STATES + ("fixed",) else ("weather", key, leg_row["pid"])
        group = groups.setdefault(group_id, {"key": key, "ledger": row, "legs": [], "states": {}})
        group["legs"].append(leg_row)
        group["states"][state] = group["states"].get(state, 0) + 1
    problems = []
    for group_id, group in groups.items():
        pid = group_id[1] if group_id[0] == "bug" else ""
        key = group["key"]
        dismissed = group_id[0] == "weather" and bool(group_id[2])
        states = group["states"]
        bug_count = states.get("new", 0) + states.get("open", 0) + states.get("regressed", 0)
        fixed_count = states.get("fixed", 0)
        weather_count = states.get("weather", 0)
        row = group["ledger"]
        kind = "bug" if bug_count else ("fixed" if fixed_count else "weather")
        if states.get("regressed"):
            status = "regressed"
            status_text = "regressed ×%d" % states["regressed"]
        elif states.get("new"):
            status, status_text = "new", "new"
        elif states.get("open"):
            status, status_text = "open", "open"
        elif fixed_count:
            status, status_text = "fixed", proof_text(row, legs, now)
        else:
            status = "not-a-bug" if dismissed else "weather"
            status_text = "not a bug" if dismissed else ""
        if kind == "bug" and fixed_count:
            status_text += " · %d before fix" % fixed_count
        model_counter = {}
        for leg_row in group["legs"]:
            model_counter[leg_row["model"]] = model_counter.get(leg_row["model"], 0) + 1
        series = []
        for day in days:
            total = 0
            for rolled, value in daily[day]["counts"].items():
                fields = rolled.split("|")
                if not rolled.startswith(prefix) or len(fields) != 6:
                    continue
                if (fields[5] == pid) if pid else (tuple(fields[2:5]) == key and fields[5] == group_id[2]):
                    total += value
            series.append(total)
        count = bug_count or fixed_count or weather_count
        base_count = sum(value for day, value in zip(days, series) if day in base_days)
        last = max(leg_row["at"] for leg_row in group["legs"])
        looked = days_since(row.get("last_reviewed"), now) if row is not None else None
        lost = hidden.get(pid, []) if pid else []
        problems.append({
            "id": pid or None, "rule": leg_rule(group["legs"][0]) if pid else None,
            "kind": kind, "label": key_label(key) + (" · not a bug" if dismissed else ""),
            "class": key[0], "reason": key[1], "origin": key[2],
            "models": top_counts(model_counter, TOP_MAX), "count": count,
            "trend": trend_mark(count, window_legs, base_count, base_legs) if kind != "fixed" else "",
            "daily": series, "spark": spark(series),
            "first_seen": iso_time(span[pid][0]) if pid in span else None,
            "last_seen_s": max(0, int(now - last)), "last_seen": age_text(max(0, int(now - last))),
            "status": status, "status_text": status_text,
            "looked": "" if looked is None else "looked at %dd ago" % looked,
            "ledger": ledger_view(row),
            "recovered": len(lost), "lost_s": int(sum(item["duration"] or 0 for item in lost)),
            "incidents": [incident_of(leg_row, now) for leg_row in
                          sorted(group["legs"], key=lambda item: -item["at"])[:MAX_INCIDENTS]],
            "incidents_total": len(group["legs"]),
        })
    rank = {"regressed": 0, "new": 1, "open": 2, "fixed": 3, "not-a-bug": 4, "weather": 5}
    problems.sort(key=lambda item: (rank[item["status"]], -item["count"], item["label"]))
    bug_ids = {leg_row["pid"] for leg_row in window if leg_row["state"] in BUG_STATES}
    weather = sum(1 for leg_row in window if leg_row["state"] == "weather")
    top = {}
    top_pool = [leg_row for leg_row in window if leg_row["state"] in BUG_STATES] \
        or [leg_row for leg_row in window if leg_row["state"] == "weather" and leg_row["attempt"] != "superseded"]
    for leg_row in top_pool:
        name = "%s %s" % (leg_row["model"], leg_row["reason"] if leg_row["class"] == "failed" else leg_row["class"])
        top[name] = top.get(name, 0) + 1
    models = {}
    for leg_row in window:
        entry = models.setdefault(leg_row["model"], {"model": leg_row["model"], "legs": 0, "causes": set(),
                                                     "weather": 0, "columns": {}})
        if leg_row["attempt"] == "final":
            entry["legs"] += 1
        if leg_row["state"] in BUG_STATES:
            entry["causes"].add(leg_row["pid"])
        elif leg_row["state"] == "weather":
            entry["weather"] += 1
        column = None
        if leg_row["attempt"] == "superseded" and leg_row["class"] != "escaped":
            column = "retried"
        elif leg_row["class"] == "failed":
            column = "theirs" if leg_row["origin"] == "theirs" else "failed"
        elif leg_row["class"] is not None:
            column = leg_row["class"]
        if column:
            entry["columns"][column] = entry["columns"].get(column, 0) + 1
    for entry in models.values():
        entry["bugs"] = len(entry.pop("causes"))
    model_rows = sorted((entry for entry in models.values() if entry["model"]),
                        key=lambda item: (-item["bugs"], -item["weather"], -item["legs"], item["model"]))
    ratios = [leg_row["duration"] / leg_row["baseline"] for leg_row in window
              if leg_row.get("baseline") and leg_row["duration"]]
    return {
        "block": block, "owner": ledger["owners"].get(block) or "",
        "legs": window_legs,
        "bugs": len(bug_ids), "weather": weather,
        "new": len({leg_row["pid"] for leg_row in window if leg_row["state"] == "new"}),
        "regressed": len({leg_row["pid"] for leg_row in window if leg_row["state"] == "regressed"}),
        "top": " · ".join("%s ×%d" % (name, top[name]) for name in top_counts(top, TOP_MAX)),
        "top_kind": "bug" if bug_ids else ("weather" if top else ""),
        "coverage_from": int(coverage[block]) if coverage.get(block) else None,
        "speed": {"judged": sum(1 for leg_row in window if leg_row.get("baseline") is not None),
                  "unjudged": sum(1 for leg_row in window if "baseline" in leg_row and leg_row["baseline"] is None),
                  "ratio_p50": round(gemini.percentile(ratios, 0.5), 2) if ratios else None,
                  "ratio_p95": round(gemini.percentile(ratios, 0.95), 2) if ratios else None},
        "problems": problems,
        "models": [{"model": entry["model"], "legs": entry["legs"], "bugs": entry["bugs"],
                    "weather": entry["weather"],
                    "columns": {name: entry["columns"][name] for name in COLUMNS if entry["columns"].get(name)}}
                   for entry in model_rows],
    }


def problem(pid, rule, state, fact, value, limit, unit, window_h, exposure, count, span, evidence, ledger_id, **extra):
    entry = {"id": pid, "rule": rule, "state": state, "fact": fact, "value": value, "limit": limit, "unit": unit,
             "window_h": window_h, "exposure": exposure, "count": count,
             "first_seen": iso_time(span[0]) if span else None, "last_seen": iso_time(span[1]) if span else None,
             "evidence": evidence, "ledger": ledger_id}
    entry.update(extra)
    return entry


def block_group(blocks):
    return min(blocks, key=lambda block: BLOCKS.index(block) if block in BLOCKS else len(BLOCKS))


def leg_problems(ledger, legs, window_cutoff, window_h, now):
    """The contract's problems for legs: one per bug id in the window, a cause retries keep hiding as
    `watch`, and every fixed row still short of its proof."""
    window = [leg_row for leg_row in legs if leg_row["at"] >= window_cutoff]
    span, hidden, by_pid = seen_span(legs), recovered_of(window), {}
    for leg_row in window:
        if leg_row["state"] in BUG_STATES:
            by_pid.setdefault(leg_row["pid"], []).append(leg_row)
    problems = []
    for pid, rows in sorted(by_pid.items()):
        states = {leg_row["state"] for leg_row in rows}
        state = "regressed" if "regressed" in states else ("new" if "new" in states else "open")
        row = rows[0]["ledger"]
        blocks = sorted({leg_row["block"] for leg_row in rows})
        exposure = sum(1 for leg_row in window if leg_row["attempt"] == "final" and leg_row["block"] in blocks
                       and not (row and row.get("_model") and not row["_model"].search(leg_row["model"])))
        lost = hidden.get(pid, [])
        fact = "%s: %s ×%d in %s%s" % ("+".join(blocks), key_label(problem_key(rows[0])), len(rows),
                                       window_text(window_h), " · " + row["title"] if row else "")
        problems.append(problem(pid, leg_rule(rows[0]), state, fact, len(rows), 0, "legs", window_h, exposure,
                                len(rows), span.get(pid), evidence_of(rows), row["id"] if row else None,
                                group=block_group(blocks), recovered=len(lost),
                                lost_s=int(sum(item["duration"] or 0 for item in lost))))
    for pid, rows in sorted(hidden.items()):
        if pid in by_pid or len(rows) < RECOVERED_MIN:
            continue
        blocks = sorted({leg_row["block"] for leg_row in rows})
        fact = "%s: %s ×%d in %s, each hidden by a retry that won" % (
            "+".join(blocks), key_label(("failed", rows[0]["reason"], rows[0]["origin"])), len(rows),
            window_text(window_h))
        problems.append(problem(pid, leg_rule(rows[0]), "watch", fact, len(rows), RECOVERED_MIN, "attempts", window_h,
                                len(rows), len(rows), (min(leg_start(item) for item in rows),
                                                       max(item["at"] for item in rows)),
                                evidence_of(rows), pid if pid in ledger["by_id"] else None, group=block_group(blocks),
                                recovered=len(rows), lost_s=int(sum(item["duration"] or 0 for item in rows))))
    listed = {item["id"] for item in problems}
    for row in ledger["rows"]:
        if row.get("status") not in FIXED_STATUSES or row["id"] in listed:
            continue
        events, matched = proof(row, legs)
        if row["status"] == "fixed" and events >= PROOF_MIN and not matched:
            continue
        state = "fixed-pending" if row["status"] == "fixed-pending" else "watch"
        problems.append(problem(row["id"], "fix-proof", state, "%s · %s" % (row["title"], proof_text(row, legs, now)),
                                events, PROOF_MIN, "events since the fix", window_h, events, 0, span.get(row["id"]),
                                [], row["id"], group=row.get("block") if row.get("block") in BLOCKS else "ledger"))
    return problems


def pending_fix_problems(ledger, problems, window_h, now):
    """A machinery or debt row whose fix awaits its commit stays listed once its anomalies are gone."""
    listed = {item["id"] for item in problems}
    found = []
    for row in list(ledger["machinery"].values()) + ledger["health"]:
        if row.get("status") != "fixed-pending" or row["id"] in listed:
            continue
        group = row["match"]["health"] if "health" in row["match"] else "machinery"
        since = days_since(row["fixes"][-1].get("at"), now)
        found.append(problem(row["id"], "fix-proof", "fixed-pending", "%s · fix pending commit%s" % (
            row["title"], " %dd" % since if since is not None else ""), 0, 0, "events since the fix", window_h, 0, 0,
            None, [], row["id"], group=group))
    return found


def fault_problems(faults, window_h, now):
    grouped = {}
    for where, why in faults:
        grouped.setdefault(where, []).append(why)
    problems = []
    for where, whys in grouped.items():
        fault = "%s: %s" % (where, " · ".join(whys))
        problems.append(problem("ledger:%s" % where, "ledger", "new", "ledger %s" % fault, len(whys), 0, "faults",
                                window_h, 0, len(whys), (now, now), [{"at": iso_time(now), "ref": "ledger:%s" % where,
                                                                      "account": "", "excerpt": fault[:EXCERPT_MAX]}],
                                None, group="ledger"))
    return problems


def remnant_problems(window_h, now):
    """One problem per account the menubar roster no longer lists that a per-account store still holds
    (shared-invariants row di): `<vendor>b remove` purges them, so one left over is a cause of its own."""
    import account_roster
    import account_stores
    ref = "share/account_stores.py"
    try:
        found = account_stores.remnants()
    except account_roster.Unreadable as exc:
        return [problem("remnant:roster", "account-remnant", "new", "account roster unreadable: %s" % exc, 1, 0,
                        "rosters", window_h, 0, 1, (now, now), [], None, group="accounts")]
    problems = []
    for vendor in sorted(found):
        for name, labels in sorted(found[vendor].items()):
            fact = "%s %s is off the roster the menubar lists, still held by: %s · purge: python3 %s purge %s %s" % (
                vendor, name, ", ".join(labels), ref, vendor, name)
            problems.append(problem("remnant:%s:%s" % (vendor, name), "account-remnant", "new", fact, len(labels), 0,
                                    "stores", window_h, 0, len(labels), (now, now),
                                    [{"at": iso_time(now), "ref": "remnant:%s:%s" % (vendor, name), "account": name,
                                      "excerpt": fact[:EXCERPT_MAX]}], None, group="accounts"))
    return problems


def machinery_state(row, details, as_of):
    if row is None:
        return "new"
    status = row.get("status")
    if status in DISMISSALS:
        return "not-a-bug"
    if status not in FIXED_STATUSES:
        return "open"
    fixed_at = row["_fixed_at"]
    for detail in details:
        age = detail.get("age_s") if isinstance(detail, dict) else None
        if fixed_at is None or not isinstance(age, (int, float)) or as_of - age > fixed_at:
            return "regressed"
    return "fixed"


def machinery(ledger, now, window_cutoff):
    """review-bench doctor's snapshot classes, each held against the ledger like a leg's problem. A class
    is that detector's own rule: its ledger row matches the whole class."""
    snapshot = read_json(os.path.join(stats_dir(), "doctor-snapshot.json"))
    if not isinstance(snapshot, dict) or not isinstance(snapshot.get("anomalies"), dict):
        return None
    as_of = snapshot["as_of"] if isinstance(snapshot.get("as_of"), (int, float)) else now
    details = snapshot.get("rows") if isinstance(snapshot.get("rows"), dict) else {}
    classes = []
    for name in sorted(snapshot["anomalies"]):
        count = snapshot["anomalies"][name]
        if not isinstance(count, int) or count <= 0:
            continue
        row = ledger["machinery"].get(name)
        rows = [detail for detail in details.get(name) or [] if isinstance(detail, dict)] \
            if isinstance(details.get(name), list) else []
        classes.append({"class": name, "count": count, "status": machinery_state(row, rows, as_of),
                        "ledger": ledger_view(row), "rows": rows})
    stale = as_of < window_cutoff
    return {"as_of": snapshot.get("as_of"), "total": snapshot.get("total"), "anomalies": snapshot["anomalies"],
            "classes": classes, "stale": stale,
            "issues": 0 if stale else sum(item["count"] for item in classes if item["status"] in COUNTED)}


def machinery_problems(found, window_h):
    if not found or found["stale"]:
        return []
    as_of = found["as_of"] if isinstance(found["as_of"], (int, float)) else None
    problems = []
    for item in found["classes"]:
        if item["status"] not in COUNTED:
            continue
        ages = [row["age_s"] for row in item["rows"] if isinstance(row.get("age_s"), (int, float))]
        span = (as_of - max(ages), as_of - min(ages)) if ages and as_of is not None else None
        evidence = [{"at": iso_time(as_of - row["age_s"]) if as_of is not None and isinstance(row.get("age_s"), (int, float))
                     else iso_time(as_of), "ref": "snapshot:%s/%s" % (item["class"], row.get("id") or "?"), "account": "",
                     "excerpt": " · ".join(str(row.get(key) or "") for key in ("where", "label"))[:EXCERPT_MAX]}
                    for row in item["rows"][:EVIDENCE_MAX]]
        ledger_id = item["ledger"]["id"] if item["ledger"] else None
        fact = "review machinery %s: %d in the snapshot%s" % (
            item["class"], item["count"], " · " + item["ledger"]["title"] if item["ledger"] else "")
        problems.append(problem(ledger_id or "machinery:%s" % item["class"], "machinery", item["status"], fact,
                                item["count"], 0, "anomalies", window_h, 0, item["count"], span, evidence, ledger_id,
                                group="machinery"))
    for item in found["classes"]:
        item.pop("rows", None)
    return problems


_CHAT_SOURCES = []


def name_chats(rows):
    """Set each row's `chat` from its `session`, reading the session and run records once per process.

    A name recorded with the row (`chat`) is the fallback for a session no record names any more."""
    pending = [row for row in rows if row.get("session")]
    if not pending:
        return
    if not _CHAT_SOURCES:
        from chat_names import chat_name, chat_title, store_names, worker_run_launchers
        _CHAT_SOURCES.extend((chat_name, chat_title, worker_run_launchers(), store_names()))
    chat_name, chat_title, launchers, store = _CHAT_SOURCES
    for row in pending:
        row["chat"] = chat_name(row["session"], launchers=launchers, store=store) or row.get("chat") \
            or chat_title(row["session"], launchers=launchers, store=store) or "unnamed chat"


_NEAR = {}
def limits():
    return {name: globals()[name] for name in LIMIT_NAMES}


def near_miss(limit_name, value, unit, at, ref):
    """Keep the largest value a threshold rule measured under its limit, so a cost below the line stays visible."""
    entry = _NEAR.setdefault(limit_name, {"limit_name": limit_name, "value": None, "limit": globals()[limit_name],
                                          "unit": unit, "count": 0, "at": None, "ref": ""})
    entry["count"] += 1
    if entry["value"] is None or value > entry["value"]:
        entry.update(value=int(value), at=iso_time(at), ref=ref)


def health_row(name, items, notes=(), exposure=0):
    name_chats(list(items.values()))
    merged, rules = {}, {}
    for item in items.values():
        rule = rules.setdefault((item["rule"], item["key"]), {"rule": item["rule"], "key": item["key"], "count": 0,
                                                              "first": None, "last": 0, "start": 0, "value": None,
                                                              "events": []})
        rule["count"] += item["count"]
        rule["first"] = min(rule["first"] or item["first"], item["first"])
        rule["last"] = max(rule["last"], item["last"])
        rule["start"] = max(rule["start"], item["start"])
        if item["value"] is not None:
            rule["value"] = max(rule["value"] or item["value"], item["value"])
        rule["events"].extend(item["events"])
        into = merged.setdefault((item["label"], item["chat"]), dict(
            {key: value for key, value in item.items() if key not in ("events", "first", "start", "value")},
            count=0, last=0, lines=0, repeats=0))
        for key in ("count", "lines", "repeats"):
            into[key] += item[key]
        into["last"] = max(into["last"], item["last"])
    items = sorted(merged.values(), key=lambda entry: -entry["last"])
    for rule in rules.values():
        rule["events"] = sorted(rule["events"], key=lambda event: -event[0])[:EVIDENCE_MAX]
    count = sum(item["count"] for item in items)
    return {"name": name, "status": "problem" if count else "ok", "count": count, "items": items,
            "notes": list(notes), "exposure": exposure,
            "rules": sorted(rules.values(), key=lambda rule: (rule["rule"], rule["key"]))}


def add_item(items, label, at, lines=0, session="", chat="", repeats=1, rule="", key="", value=None, ref="",
             excerpt="", start=None):
    session = str(session or "")
    chat = re.sub(r" \([0-9a-f]{8}\)$", "", str(chat or ""))
    item = items.setdefault((label, session or chat), {"label": label, "session": session, "chat": "", "rule": rule,
                                                       "key": key, "count": 0, "first": at, "last": 0, "start": 0, "lines": 0,
                                                       "repeats": 0, "value": None, "events": []})
    if chat and chat != session and not item["chat"]:
        item["chat"] = chat
    item["count"] += 1
    item["first"] = min(item["first"], at)
    item["last"] = max(item["last"], at)
    item["start"] = max(item["start"], at if start is None else start)
    item["lines"] += lines
    item["repeats"] += repeats
    if isinstance(value, (int, float)):
        item["value"] = max(item["value"] or value, value)
    item["events"].append((at, ref, str(excerpt or "")[:EXCERPT_MAX]))


def health_problems(row, ledger, window_h):
    """The contract's problems for one health row: one per rule and identity key."""
    problems = []
    for rule in row["rules"]:
        computed = "%s:%s" % (rule["rule"], rule["key"]) if rule["key"] else rule["rule"]
        match = next((entry for entry in ledger["health"] if entry["match"]["health"] == row["name"]
                      and entry["_key"].search(computed)), None)
        status = match.get("status") if match else None
        if status in DISMISSALS:
            continue
        if status in FIXED_STATUSES:
            if match["_fixed_at"] is not None and rule["start"] <= match["_fixed_at"]:
                continue
            state = "regressed"
        else:
            state = "open" if match else "new"
        label = next((item["label"] for item in row["items"] if item["rule"] == rule["rule"]
                      and item["key"] == rule["key"]), computed)
        evidence = [{"at": iso_time(at), "ref": ref, "account": "", "excerpt": excerpt} for at, ref, excerpt in rule["events"]]
        problems.append(problem(match["id"] if match else computed, rule["rule"], state,
                                "%s: %s ×%d in %s" % (row["name"], label, rule["count"], window_text(window_h)),
                                rule["count"], 0, "events", window_h, row["exposure"], rule["count"],
                                (rule["first"], rule["last"]), evidence, match["id"] if match else None,
                                group=row["name"]))
    return problems


def open_gaps(window_h):
    """review-anchors' open gap groups, or a note saying why they could not be read."""
    days = max(DEBT_GAP_DAYS, -(-int(window_h) // 24))
    search = os.pathsep.join((os.environ.get("PATH", ""), os.path.join(base_home(), ".local", "bin")))
    binary = shutil.which("review-anchors", path=search)
    if not binary:
        return [], "gaps not read: review-anchors not found"
    try:
        done = subprocess.run([binary, "gaps", "--days", str(days), "--json"], capture_output=True, text=True,
                              timeout=30)
    except (OSError, subprocess.SubprocessError) as exc:
        return [], "gaps not read: review-anchors %s" % type(exc).__name__
    if done.returncode:
        return [], "gaps not read: review-anchors exited %d" % done.returncode
    rows = []
    for line in done.stdout.splitlines():
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if isinstance(row, dict) and isinstance(row.get("last"), (int, float)):
            rows.append(row)
    skipped = sum(1 for line in done.stderr.splitlines() if "skipped" in line)
    return rows, "review-anchors skipped %d unreadable gap stores" % skipped if skipped else ""


def run_gap_start(detail):
    """The run's start for a gap the launch-time code made (its snapshot lacks the before listing), else None.
    The fold re-executes worker-run from disk, so a gap it made ran on the code current at the fold."""
    head, _, rest = detail.partition(" ")
    run = WORKER_ID_RE.match(head)
    run_dir = os.path.join(runs_dir(), head)
    if not run or not os.path.isdir(run_dir):
        return None
    path = rest.split(": ", 1)[0]
    families = os.path.join(run_dir, "families")
    subs = [os.path.join(families, name) for name in sorted(os.listdir(families))] if os.path.isdir(families) else []
    snap = next((sub for sub in subs if (read_text(os.path.join(sub, "top")) or "").strip() == path), run_dir)
    return None if os.path.exists(os.path.join(snap, "dirty-before-shas")) else int(run.group(1))


def debt_health(cutoff, now, window_h):
    """Debt that recording failed to capture and nobody has reviewed since (open gaps), or that a store
    dropped unreviewed (losses)."""
    items, notes = {}, []
    gaps, note = open_gaps(window_h)
    seen = len(gaps)
    causes = {}
    for row in gaps:
        detail = str(row.get("detail") or "")
        # The recorder puts the event's specifics after "<repo>: " (the first capped path, the tool call id):
        # every gap of one kind in one repository is one cause.
        repo = detail.split(": ", 1)[0] if detail.startswith("/") and ": " in detail else ""
        kind = str(row.get("kind") or "gap")
        label = "not recorded: %s" % kind
        # worker-run's run gaps read "<run id> <path>: <why>": the why's head, before any stderr, is the cause.
        why = detail.split(": ", 2)[1] if not repo and ": " in detail else ""
        if repo:
            label += " in %s" % os.path.basename(repo.rstrip("/"))
        elif why:
            label += ": %s" % why
        cause = causes.setdefault((row.get("session"), label, repo or detail), [label, 0, 0, kind, repo, why, detail])
        cause[1] = max(cause[1], row["last"])
        cause[2] += as_int(row.get("count")) or 1
    for (session, _, _), (label, last, repeats, kind, repo, why, detail) in causes.items():
        key = "%s/%s" % (kind, os.path.basename(repo.rstrip("/"))) if repo else "%s:%s" % (kind, why) if why else kind
        add_item(items, label, last, session=session, repeats=repeats, rule="debt-gap", key=key,
                 ref="gaps:%s/%s/%s" % (session or "-", kind, event_stamp(last)), excerpt=detail,
                 start=run_gap_start(detail))
    if note:
        notes.append(note)
    drops = {}
    for row in read_jsonl(os.path.join(debt_dir(), "losses.jsonl")):
        at = row.get("at")
        if isinstance(at, (int, float)) and cutoff <= at <= now + 3600:
            seen += 1
            session = str(row.get("session") or "")
            chat = "" if session else os.path.basename(str(row.get("repo") or "").rstrip("/"))
            # One row per dropped path; "run <id>: <why>" names the one drop they all came from.
            drop = drops.setdefault((session, chat, row.get("kind") or "?",
                                     str(row.get("detail") or "").split(": ", 1)[0]), [0, 0, ""])
            drop[0] = max(drop[0], at)
            drop[1] += as_int(row.get("lines")) or 0
            drop[2] = drop[2] or str(row.get("detail") or "")
    for (session, chat, kind, _), (at, lines, detail) in drops.items():
        add_item(items, "lost unreviewed: %s" % kind, at, lines, session=session, chat=chat, rule="debt-loss",
                 key=kind, ref="losses:%s/%s" % (event_stamp(at), kind), excerpt=detail)
    return health_row("debt", items, notes, seen)


def git_out(root, *args):
    try:
        done = subprocess.run(["git", "-C", root] + list(args), capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return done.stdout if done.returncode == 0 else None


def missing_commit(value):
    """Why a fix's `repo@hash` names no commit, or None (also when git is not here to answer)."""
    repo, commit = FIX_IN_RE.match(value).groups()
    root = os.path.join(repos_dir(), repo)
    if not os.path.isdir(root):
        return None
    try:
        done = subprocess.run(["git", "-C", root, "rev-parse", "--verify", "--quiet", commit + "^{commit}"],
                              capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return "%s is no commit of %s" % (commit, repo) if done.returncode == 1 else None


def drop_row(ledger, row):
    ledger["by_id"].pop(row["id"], None)
    ledger["rows"] = [other for other in ledger["rows"] if other is not row]
    ledger["health"] = [other for other in ledger["health"] if other is not row]
    ledger["machinery"] = {name: other for name, other in ledger["machinery"].items() if other is not row}


def settle_fixes(ledger):
    """Turn a fixed-pending row fixed once the sweep has committed its fix, and check every recorded commit:
    a row naming no commit judges nothing. Returns {row id: repo@hash} for the rows it settled and the
    `(row id, why)` faults it found."""
    settled, faults = {}, []
    for row in list(ledger["by_id"].values()):
        fixes = row.get("fixes") or []
        missing = [fault for fault in (missing_commit(fix["in"]) for fix in fixes if fix.get("in")) if fault]
        if missing:
            faults.extend((row["id"], fault) for fault in missing)
            drop_row(ledger, row)
        elif row.get("status") == "fixed-pending" and fixes and not fixes[-1].get("in"):
            found = fix_commit(fixes[-1], repos_dir())
            if found:
                settled[row["id"]] = found
                row["fixes"] = fixes[:-1] + [dict(fixes[-1], **{"in": found})]
                row["status"] = "fixed"
                row["_fixed_at"] = last_fix_at(row)
    return settled, faults


def write_settled(settled, source):
    """Record the commits settle_fixes found in the ledger file, unless someone changed it since it was read."""
    path = ledger_path()
    if not settled or read_text(path) != source:
        return
    document = json.loads(source)
    for row in document["rows"]:
        if isinstance(row, dict) and isinstance(row.get("id"), str) and row["id"] in settled:
            row["fixes"][-1]["in"] = settled[row["id"]]
            row["status"] = "fixed"
    temporary = "%s.tmp.%d" % (path, os.getpid())
    try:
        with open(temporary, "w", encoding="utf-8") as handle:
            json.dump(document, handle, ensure_ascii=False, indent=1)
            handle.write("\n")
        os.replace(temporary, path)
    except OSError as error:
        print("llm-doctor: ledger not settled: %s" % error, file=sys.stderr)
        if os.path.exists(temporary):
            os.remove(temporary)


def judge_digest(ledger):
    """What decides a verdict: this code, its limits and the ledger's dismissal rows. Tracking a fix
    (open, fixed-pending, fixed, fixes, notes) leaves it unchanged."""
    digest = hashlib.sha256()
    with open(os.path.realpath(__file__), "rb") as handle:
        digest.update(handle.read())
    dismissals = sorted((row["id"], row.get("block"), row["match"], row["status"]) for row in ledger["by_id"].values()
                        if row.get("status") in DISMISSALS)
    digest.update(json.dumps([dismissals, limits()], sort_keys=True, ensure_ascii=False).encode("utf-8"))
    return digest.hexdigest()


def input_state(path, kind="file", fresh_after=None):
    if kind == "dir":
        if not os.path.isdir(path):
            return "missing"
        try:
            return "ok" if os.listdir(path) else "empty"
        except OSError:
            return "missing"
    size = file_size(path)
    if size is None:
        return "missing"
    if size == 0:
        return "empty"
    if fresh_after is not None and (mtime_of(path) or 0) < fresh_after:
        return "stale"
    return "ok"


def inputs_of(found, window_cutoff):
    """Every store the doctor reads; a required one that is not `ok` leaves a rule unable to see."""
    snapshot = os.path.join(stats_dir(), "doctor-snapshot.json")
    snapshot_state = input_state(snapshot)
    if snapshot_state == "ok" and (found is None or found["stale"]):
        snapshot_state = "stale" if found is not None else "unjoinable"
    rows = [("bench store", os.path.join(stats_dir(), "benches"), True, input_state(os.path.join(stats_dir(), "benches"), "dir")),
            ("worker runs", runs_dir(), True, input_state(runs_dir(), "dir")),
            ("machinery snapshot", snapshot, True, snapshot_state),
            ("prelaunch log", os.path.join(runs_dir(), "prelaunch.jsonl"), False,
             input_state(os.path.join(runs_dir(), "prelaunch.jsonl"))),
            ("image legs", image_log(), False, input_state(image_log())),
            ("debt store", debt_dir(), False, input_state(debt_dir(), "dir"))]
    return [{"name": name, "path": path, "required": required, "state": state} for name, path, required, state in rows]


def collect(window_h, now, write_daily=False):
    began = time.monotonic()
    _NEAR.clear()
    ledger = load_ledger()
    source = read_text(ledger_path()) or ""
    settled, commit_faults = settle_fixes(ledger)
    window_cutoff = now - window_h * 3600
    start = min(window_cutoff, now - TREND_DAYS * 86400)
    legs, coverage = [], {}
    for block, reader in (("reviewers", bench_legs), ("workers", worker_legs), ("prelaunch", prelaunch_legs),
                          ("image", image_legs)):
        found, earliest = reader(start - SLOW_BASE_D * 86400, now)
        legs.extend(found)
        if block == "workers":
            coverage["workers"] = coverage["light"] = earliest
        elif block != "prelaunch":
            coverage[block] = earliest
    mark_slow(legs)
    legs = [leg_row for leg_row in legs if leg_row["at"] >= start]
    mark_problems(ledger, legs)
    daily = rollup(legs, coverage, now, write_daily, ledger)
    blocks = [build_block(block, legs, ledger, daily, window_cutoff, now, coverage)
              for block in BLOCKS]
    name_chats([incident for block in blocks for problem in block["problems"] for incident in problem["incidents"]])
    found = machinery(ledger, now, window_cutoff)
    blocks[0]["machinery"] = found
    health = [debt_health(window_cutoff, now, window_h)]
    problems = leg_problems(ledger, legs, window_cutoff, window_h, now) + machinery_problems(found, window_h)
    for row in health:
        problems.extend(health_problems(row, ledger, window_h))
    problems.extend(pending_fix_problems(ledger, problems, window_h, now))
    problems.extend(fault_problems(ledger["faults"] + commit_faults, window_h, now))
    problems.extend(remnant_problems(window_h, now))
    if write_daily:
        write_settled(settled, source)
    inputs = inputs_of(found, window_cutoff)
    count = sum(1 for item in problems if item["state"] in COUNTED)
    groups = dict.fromkeys(BLOCKS + ("machinery",) + tuple(row["name"] for row in health) + ("ledger", "accounts"), 0)
    for item in problems:
        if item["state"] in COUNTED:
            groups[item["group"]] = groups.get(item["group"], 0) + 1
    blind = [item["name"] for item in inputs if item["required"] and item["state"] != "ok"]
    summary = " · ".join("%s %d" % (block["block"], block["bugs"]) for block in blocks if block["bugs"])
    spots = ledger["blind_spots"]
    return {"contract": CONTRACT, "doctor": "llm", "as_of": iso_time(now), "as_of_s": int(now),
            "judge": judge_digest(ledger), "status": "blind" if blind else ("problems" if count else "ok"),
            "problem_count": count, "groups": groups, "problems": problems, "blind_spots": spots,
            "self": {"collector_s": round(time.monotonic() - began, 2), "error": None},
            "owner": ledger["owner"], "limits": limits(), "near": [_NEAR[name] for name in sorted(_NEAR)],
            "inputs": inputs, "blind": blind,
            "window_h": window_h, "trend_days": TREND_DAYS,
            "bugs": sum(block["bugs"] for block in blocks), "summary": summary,
            "not_measurable": [spot.get("what") or "" for spot in spots], "blocks": blocks, "health": health}


def error_report(window_h, now, error):
    """The document a failed collector leaves: the menu shows the error, never an older document's colour."""
    ledger = {"by_id": {}, "blind_spots": []}
    try:
        ledger = load_ledger()
        judge = judge_digest(ledger)
    except Exception:  # noqa: BLE001 - the error document must be written whatever broke
        judge = None
    return {"contract": CONTRACT, "doctor": "llm", "as_of": iso_time(now), "as_of_s": int(now), "judge": judge,
            "status": "error", "problem_count": 0, "groups": {}, "problems": [], "blind_spots": ledger["blind_spots"],
            "self": {"collector_s": None, "error": ("%s: %s" % (type(error).__name__, error)).splitlines()[0][:300]},
            "window_h": window_h, "trend_days": TREND_DAYS, "bugs": 0, "summary": "", "not_measurable": [],
            "blocks": [], "health": []}


def write_cache(report):
    directory = doctor_dir()
    os.makedirs(directory, exist_ok=True)
    target = os.path.join(directory, "latest.json")
    temporary = "%s.tmp.%d" % (target, os.getpid())
    with open(temporary, "w", encoding="utf-8") as handle:
        json.dump(report, handle, ensure_ascii=False, indent=1)
        handle.write("\n")
    os.replace(temporary, target)
    return target


def render(report, only=None):
    if report["status"] == "error":
        return "LLM doctor · error · %s\n" % report["self"]["error"]
    lines = ["LLM doctor · %s · %d problem%s · %d bug%s%s" % (
        window_text(report["window_h"]), report["problem_count"], "" if report["problem_count"] == 1 else "s",
        report["bugs"], "" if report["bugs"] == 1 else "s",
        " · blind: %s" % ", ".join(report["blind"]) if report["blind"] else "")]
    if not only:
        for item in report["problems"]:
            lines.append("  %-13s %s  %s" % (item["state"], item["id"], item["fact"]))
    for block in report["blocks"]:
        if only and block["block"] != only:
            continue
        lines.append("")
        lines.append("%s: %d bug%s · %d weather · owner: %s" % (
            block["block"].capitalize(), block["bugs"], "" if block["bugs"] == 1 else "s", block["weather"],
            block["owner"] or "unset"))
        if block.get("machinery"):
            busy = ["%s %d %s%s" % (item["class"], item["count"], item["status"],
                                    (" " + item["ledger"]["id"]) if item["ledger"] else "")
                    for item in block["machinery"]["classes"]]
            lines.append("  review machinery: %s" % (" · ".join(busy) if busy else "ok"))
        if not block["problems"]:
            lines.append("  no legs failed in the window")
        for problem in block["problems"]:
            ledger = problem["ledger"] or {}
            head = "  %-7s %s  [%s]  %d  %s  %s  %s%s%s" % (
                problem["kind"].upper() if problem["kind"] != "weather" else "weather",
                problem["label"], ", ".join(problem["models"]), problem["count"],
                problem["spark"] or "-", problem["last_seen"], problem["status_text"] or "-",
                ("  " + ledger["id"]) if ledger.get("id") else "",
                ("  " + problem["looked"]) if problem["looked"] else "")
            lines.append(head)
            if problem["kind"] != "weather":
                if ledger.get("title"):
                    lines.append("          %s" % ledger["title"])
                for incident in problem["incidents"][:5]:
                    lines.append("          %4s  %-10s %-18s %-3s %s" % (
                        incident["age"], incident["model"], incident["project"][:18], incident["tier"],
                        incident["detail"]))
        if block["top"]:
            lines.append("  top: %s" % block["top"])
    for row in report.get("health") or []:
        if only:
            break
        lines.append("")
        lines.append("%s: %s" % (row["name"].capitalize(), "%d problem%s" % (row["count"], "" if row["count"] == 1 else "s")
                                  if row["count"] else "ok"))
        for item in row["items"]:
            lines.append("  %-4d %4s  %s%s%s%s" % (item["count"], age_text(max(0, report["as_of_s"] - item["last"])),
                                                   item["chat"] + " · " if item.get("chat") else "", item["label"],
                                                   " · %d lines" % item["lines"] if item["lines"] else "",
                                                   " · seen %d×" % item["repeats"]
                                                   if item.get("repeats", 0) > item["count"] else ""))
        for note in row["notes"]:
            lines.append("  %s" % note)
    lines.append("")
    lines.append("blind spots: %s" % ", ".join(spot["what"] for spot in report["blind_spots"]))
    return "\n".join(lines) + "\n"


def window_text(hours):
    return "%d d" % (hours // 24) if hours % 24 == 0 and hours >= 72 else "%d h" % hours


def main(argv):
    parser = argparse.ArgumentParser(prog="llm-doctor", description=__doc__.splitlines()[0])
    parser.add_argument("--window", type=int, default=DEFAULT_WINDOW_H, metavar="H")
    parser.add_argument("--block", choices=BLOCKS)
    parser.add_argument("--json", action="store_true", help="print the document instead of the view; writes nothing")
    parser.add_argument("--dry-run", action="store_true", help="write neither latest.json nor the daily rollup")
    parser.add_argument("--quiet", action="store_true", help="print nothing")
    args = parser.parse_args(argv)
    if args.window <= 0:
        parser.error("--window must be a positive number of hours")
    now_override = os.environ.get("LLM_DOCTOR_NOW")
    now = float(now_override) if now_override else time.time()
    write = not (args.dry_run or args.json)
    try:
        report = collect(args.window, now, write_daily=write)
    except Exception as error:  # noqa: BLE001 - a collector failure is written as the document's own error
        report = error_report(args.window, now, error)
        print("llm-doctor: collector failed: %s" % report["self"]["error"], file=sys.stderr)
    if write:
        try:
            write_cache(report)
        except OSError as error:
            print("llm-doctor: cache not written: %s" % error, file=sys.stderr)
            return 1
    if args.quiet:
        return 1 if report["status"] == "error" else 0
    if args.json:
        shown = report if not args.block else dict(report, blocks=[
            block for block in report["blocks"] if block["block"] == args.block])
        sys.stdout.write(json.dumps(shown, ensure_ascii=False) + "\n")
        return 0
    sys.stdout.write(render(report, args.block))
    return 1 if report["status"] == "error" else 0


if __name__ == "__main__":
    started = time.time()
    code = main(sys.argv[1:])
    collector_runs.record("llm", started)
    sys.exit(code)

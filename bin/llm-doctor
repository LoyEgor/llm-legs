ROOT_DIR = os.path.dirname(BIN_DIR)


def load_gemini_weather():
    loader = importlib.machinery.SourceFileLoader(
        "gemini_weather", os.path.join(BIN_DIR, "gemini-weather"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


gemini = load_gemini_weather()

DEFAULT_WINDOW_H = 24
TREND_DAYS = 14
SLOW_BASE_D = 7
# worker-run prunes run directories by mtime (`find -mtime +7`), so an older run id can outlive
# its younger siblings and date the store further back than it is whole.
WORKER_KEEP_D = 7

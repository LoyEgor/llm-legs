def action_log():
    return os.environ.get("LLM_LIMITS_ACTION_LOG") or os.path.join(
        base_home(), ".hammerspoon", "llm_limits_actions.log")


_SWITCHES = []


def switch_flips():
    """`{"<vendor>_<role>" | "pool:<binary>:<account>": [(epoch, closed), ...]}`: every role switch and
    pool membership the owner flipped from the menubar."""
    if not _SWITCHES:
        flips = {}
        for line in (read_text(action_log()) or "").splitlines():
            match = SWITCH_LINE_RE.match(line)
            if not match:
                continue
            at = time.mktime(time.strptime(match.group(1), "%Y-%m-%d %H:%M:%S"))
            if match.group(2):
                key, closed = match.group(2), match.group(3) == "off"
            else:
                key, closed = "pool:%s:%s" % (match.group(4), match.group(6)), match.group(5) == "disable"
            flips.setdefault(key, []).append((at, closed))
        _SWITCHES.append(flips)
    return _SWITCHES[0]


def switched_mid_run(text, begun, ended):
    match = ROLE_SWITCH_RE.search(text or "")
    if not match:
        return False
    return any(closed and begun - SWITCH_SLACK_S <= at <= ended + SWITCH_SLACK_S
               for at, closed in switch_flips().get("%s_%s" % match.groups(), ()))


def closed_at(key, moment):
    closed = False
    for at, state in sorted(switch_flips().get(key, ())):
        if at > moment + SWITCH_SLACK_S:
            break
        closed = state
    return closed


def refused_by_switch(vendor, account, moment):
    """Whether a worker or image refusal met a role switch or a pool membership the owner had closed."""
    pool = POOL_BINARIES.get(vendor, vendor + "b")
    names = ("--all", account) if account else ("--all",)
    return closed_at("%s_workers" % vendor, moment) or any(
        closed_at("pool:%s:%s" % (pool, name), moment) for name in names)


def owner_switch(klass, reason, detail, origin, text, begun, ended):
    """The leg's reading once a pool refusal is traced to a switch closed mid-run."""
    if klass == "failed" and reason == "pool empty" and switched_mid_run(text, begun, ended):
        return "off", "off", "switched off mid-run", ""
    return klass, reason, detail, origin


def chunk_span(numbers):
    """`9–16` or `2, 5` for the chunk numbers one reading covers."""
    numbers = sorted(set(numbers))
    if len(numbers) > 2 and numbers[-1] - numbers[0] == len(numbers) - 1:
        return "%d–%d" % (numbers[0], numbers[-1])
    return ", ".join(str(number) for number in numbers)


def cell_end(cell, started):
    ended = iso_epoch(cell.get("finished_at"))
    if ended is not None:
        return ended
    duration = cell.get("duration_ms")
    duration_s = duration / 1000.0 if isinstance(duration, (int, float)) and duration > 0 else 0
    begun = iso_epoch(cell.get("started_at"))
    return (begun if begun is not None else started) + duration_s


def failure_reason(stderr):
    text = stderr or ""
    for reason, pattern in FAILURE_REASONS:
        if pattern.search(text):
            return reason
    return "unclassified" if text.strip() else "no output"



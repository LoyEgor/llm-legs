#!/usr/bin/env bash
set -euo pipefail

profiles_dir="${GROKB_PROFILES_DIR:-$HOME/.grok-profiles}"

# The heartbeat runs under launchd, whose PATH has no nvm, and `grok` is an npm global under
# ~/.nvm — so a bare name there is "command not found", and the token touch it asks for never runs.
resolve_grok_bin() {
  local candidate
  if [ -n "${GROKB_GROK_BIN:-}" ]; then printf '%s\n' "$GROKB_GROK_BIN"; return 0; fi
  if candidate=$(command -v grok 2>/dev/null); then printf '%s\n' "$candidate"; return 0; fi
  while IFS= read -r candidate; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then printf '%s\n' "$candidate"; return 0; fi
  done < <(shopt -s nullglob; printf '%s\n' "$HOME"/.nvm/versions/node/*/bin/grok | sort -Vr
           printf '%s\n' "$HOME/.local/bin/grok" /opt/homebrew/bin/grok)
  printf 'grokb: grok CLI not found on PATH or under ~/.nvm (npm i -g @xai-official/grok, or set GROKB_GROK_BIN)\n' >&2
  return 127
}

resolve_root() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}

grokb_root=$(resolve_root)
. "$grokb_root/share/worker-pool.sh"
. "$grokb_root/share/worker-model.sh"
. "$grokb_root/share/account-announce.sh"
pool_dir=$(worker_pool_dir grok)

is_disabled() { worker_pool_is_disabled "$pool_dir" "$1"; }
set_disabled() { worker_pool_set_disabled "$pool_dir" "$1" "$2"; }
pool_suffix() { if is_disabled "$1"; then printf ' (out of pool)'; fi; }

quota_helper="${GROKB_QUOTA_CMD:-$grokb_root/grok-quota.py}"
grok_cache="${LLM_LIMITS_GROK_CACHE:-$HOME/.llm-limits-grok.json}"

quota_snapshot() {
  local output
  if [ ! -x "$quota_helper" ]; then
    printf '{"accounts":[]}\n'
    return
  fi
  output=$("$quota_helper" --profiles-dir "$profiles_dir" \
    --timeout "${GROKB_QUOTA_TIMEOUT:-5}" 2>/dev/null) || true
  if jq -e '.accounts | type == "array"' >/dev/null 2>&1 <<<"$output"; then
    printf '%s\n' "$output"
  else
    printf '{"accounts":[]}\n'
  fi
}

format_reset_time() {
  local timestamp="$1" epoch now delta weekday
  local -a weekdays=(Sun Mon Tue Wed Thu Fri Sat)
  epoch=$(jq -nr --arg value "$timestamp" '$value | fromdateiso8601? // 0')
  if ! [ "$epoch" -gt 0 ] 2>/dev/null; then printf 'unknown'; return; fi
  now=$(date +%s)
  delta=$((epoch - now))
  if [ "$delta" -lt 86400 ]; then
    date -r "$epoch" '+%H:%M' 2>/dev/null || date -d "@$epoch" '+%H:%M' 2>/dev/null || printf 'unknown'
  elif [ "$delta" -lt 604800 ]; then
    weekday=$(date -r "$epoch" '+%w' 2>/dev/null || date -d "@$epoch" '+%w' 2>/dev/null) || { printf 'unknown'; return; }
    printf '%s ' "${weekdays[$weekday]}"
    date -r "$epoch" '+%H:%M' 2>/dev/null || date -d "@$epoch" '+%H:%M' 2>/dev/null || printf 'unknown'
  else
    date -r "$epoch" '+%m-%d %H:%M' 2>/dev/null || date -d "@$epoch" '+%m-%d %H:%M' 2>/dev/null || printf 'unknown'
  fi
}

account_names() {
  local path
  printf 'main\n'
  if [ -d "$profiles_dir" ]; then
    for path in "$profiles_dir"/*; do
      [ -d "$path" ] && basename "$path"
    done | LC_ALL=C sort
  fi
}

account_home() {
  if [ "$1" = main ]; then
    printf '%s/.grok\n' "$HOME"
  else
    printf '%s/%s\n' "$profiles_dir" "$1"
  fi
}

account_exists() { [ "$1" = main ] || [ -d "$profiles_dir/$1" ]; }

reserved_name() {
  case "$1" in
    .*|*/*|help|add|remove|list|status|pick|profile|p|run|login|enable|disable|use|fast-mode|export-token|models) return 0 ;;
    *) return 1 ;;
  esac
}

# Same two shapes grok-quota.py's auth_entry accepts: a top-level key field, or the first
# nested object that has one. A single-entry wrapper is the common case, not the only one.
auth_fields() {
  local auth
  auth="$(account_home "$1")/auth.json"
  [ -r "$auth" ] || { printf '%s\t%s\t%s\n' - - no; return; }
  jq -r '
    def entry:
      if type != "object" then empty
      elif (.key | type) == "string" then .
      else first(.[]? | select(type == "object" and (.key | type) == "string"))
      end;
    (entry // null) as $e |
    if $e == null then "-\t-\tno"
    else
      [($e.email // "-" | tostring), ($e.expires_at // "-" | tostring),
       (if (($e.refresh_token // "") | type) == "string" and ($e.refresh_token // "") != ""
        then "yes" else "no" end)] | @tsv
    end
  ' "$auth" 2>/dev/null || printf '%s\t%s\t%s\n' - - no
}

# Alive = a non-empty key or refresh_token at the top level or in any nested object.
# A parse failure is treated as alive (fail closed) so a flaky read never turns
# removal into an unguarded delete — same shape as codex_credentials_alive.
credentials_alive() {
  local auth
  auth="$(account_home "$1")/auth.json"
  [ -f "$auth" ] || return 1
  jq -e '
    def creds:
      type == "object" and (((.key // "") != "") or ((.refresh_token // "") != ""));
    type == "object" and (creds or any(.[]?; creds))
  ' "$auth" >/dev/null 2>&1 && return 0
  jq -e 'true' "$auth" >/dev/null 2>&1 || return 0
  return 1
}

add_account() {
  local name="${1:-}" directory rc=0
  if [ -z "$name" ] || ! [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || [ "$name" = main ] || reserved_name "$name"; then
    printf 'usage: grokb add <name> (must start with a lowercase letter or number; use only lowercase letters, numbers, and hyphens; not reserved words or "main")\n' >&2
    exit 2
  fi
  directory="$profiles_dir/$name"
  if [ -e "$directory" ] || [ -L "$directory" ]; then
    printf 'grokb: account already exists: %s\n' "$name" >&2
    exit 2
  fi
  mkdir -p "$directory"
  grok_bin=$(resolve_grok_bin) || exit 127
  printf 'GROK_HOME=%q %q login --device-auth\n' "$directory" "$grok_bin"
  env -u GROK_WORKER GROK_HOME="$directory" "$grok_bin" login --device-auth || rc=$?
  announce_account_added "$grokb_root" grok "$name"
  return "$rc"
}

remove_account() {
  local name='' force=false arg directory tmp
  for arg in "$@"; do
    case "$arg" in
      --force) force=true ;;
      -*) printf 'usage: grokb remove <name> [--force]\n' >&2; exit 2 ;;
      *)
        if [ -n "$name" ]; then printf 'usage: grokb remove <name> [--force]\n' >&2; exit 2; fi
        name="$arg"
        ;;
    esac
  done
  if [ -z "$name" ] || [ "$name" = main ] || ! [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    printf 'usage: grokb remove <name> [--force] (not "main"; lowercase letters, numbers, hyphens)\n' >&2
    exit 2
  fi
  directory="$profiles_dir/$name"
  if [ ! -e "$directory" ] && [ ! -L "$directory" ]; then
    printf 'grokb: unknown account: %s\n' "$name" >&2
    exit 2
  fi
  if [ "$force" != true ] && credentials_alive "$name"; then
    printf 'grokb: refusing to remove %s: it is still logged in; remove its credentials first or pass --force\n' "$name" >&2
    exit 1
  fi
  rm -rf "$directory"
  # A pool entry outliving its account keeps the last-member guard counting a ghost, and the
  # name silently re-excludes a future account created under it.
  if is_disabled "$name"; then set_disabled "$name" off; fi
  if [ -r "$grok_cache" ]; then
    tmp="$grok_cache.tmp.$$"
    if jq -c --arg name "$name" '
        if type == "object" and (.accounts | type) == "array"
        then .accounts |= map(select(.account != $name)) else . end' "$grok_cache" >"$tmp" 2>/dev/null; then
      mv "$tmp" "$grok_cache"
    else
      rm -f "$tmp"
    fi
  fi
  announce_account_removed "$grokb_root"
  printf 'grokb: removed %s\n' "$name"
}

# The login text every grokb surface prints, the way codexb prints the CLI's own login line; the
# missing refresh token is named because it is the one auth fact a human has to act on later.
login_text() { # email refresh
  if [ "$2" = yes ]; then printf 'Logged in as %s' "$1"; else printf 'Logged in as %s (no refresh token)' "$1"; fi
}

list_accounts() {
  local name fields email expires refresh
  while IFS= read -r name; do
    fields=$(auth_fields "$name")
    IFS=$'\t' read -r email expires refresh <<<"$fields"
    if [ "$email" = - ]; then
      printf '%s: login needed%s\n' "$name" "$(pool_suffix "$name")"
    else
      printf '%s: %s%s\n' "$name" "$(login_text "$email" "$refresh")" "$(pool_suffix "$name")"
    fi
  done < <(account_names)
}

show_status() {
  local quotas name fields email expires refresh entry wused wreset
  quotas=$(quota_snapshot)
  while IFS= read -r name; do
    entry=$(jq -c --arg account "$name" '[.accounts[] | select(.account == $account)][0] // {}' <<<"$quotas")
    fields=$(auth_fields "$name")
    IFS=$'\t' read -r email expires refresh <<<"$fields"
    if [ "$email" = - ] || jq -e '.auth == "needs_login"' <<<"$entry" >/dev/null 2>&1; then
      printf '%s: login needed%s | WEEKLY - reset unknown\n' "$name" "$(pool_suffix "$name")"
      continue
    fi
    wused=$(jq -r 'if (.used_pct | type) == "number" then (.used_pct | round | tostring) + "%" else "-" end' <<<"$entry")
    wreset=$(format_reset_time "$(jq -r '.resets_at // ""' <<<"$entry")")
    printf '%s: %s%s | WEEKLY %s reset %s\n' \
      "$name" "$(login_text "$email" "$refresh")" "$(pool_suffix "$name")" "$wused" "$wreset"
  done < <(account_names)
}

# --- The model list: the one list every consumer reads (shared-invariants row `cu`) ---
models_ttl_s=86400

models_cache_dir() { printf '%s' "${GROKB_CACHE_DIR:-$HOME/.cache/grokb}"; }

# The last-known list, answering only with no cache and no signed-in profile; row `cu` holds it equal
# to tests/fixtures/grokb-models.json.
models_builtin() {
  printf '%s\t%s\t%s\t%s\n' \
    grok-4.7 yes grok-4.7 xhigh,high,medium,low \
    grok-4.7-build-fast no grok-4.7-build-fast xhigh,high,medium,low \
    grok-4.6 no grok-4.6 xhigh,high,medium,low \
    grok-4.5 no grok-4.5 high,medium,low
}

models_parse() { # `grok models` output -> slug<TAB>default<TAB>label, in the CLI's own order
  awk '
    /^[[:space:]]*Default model:/ { stated = $NF }
    /^[[:space:]]*Available models:/ { listing = 1; next }
    listing && $0 ~ /^[[:space:]]*$/ { next }
    listing {
      if (($1 != "*" && $1 != "-") || $2 !~ /^[A-Za-z0-9][A-Za-z0-9._-]*$/) { listing = 0; next }
      slugs[++n] = $2
      if (index($0, "(default)")) { marked[$2] = 1; any = 1 }
    }
    END {
      for (i = 1; i <= n; i++) {
        slug = slugs[i]
        printf "%s\t%s\t%s\n", slug,
          ((slug in marked) || (!any && slug == stated)) ? "yes" : "no", slug
      }
    }'
}

# `grok models` prints no efforts; the catalog the same call refreshes in that profile's home does,
# and the CLI refuses a level a model's menu lacks (grok-4.5 has no xhigh). `-` = not known.
models_add_efforts() { # catalog-file < rows -> rows with an efforts column
  local catalog=$1 efforts='{}'
  [ -r "$catalog" ] && efforts=$(jq -c '.models // {} | map_values([.info.reasoning_efforts[]?.id
      | select(type == "string" and length > 0)] | join(","))' "$catalog" 2>/dev/null) || efforts='{}'
  jq -Rr --argjson efforts "$efforts" 'select(length > 0) | split("\t")
    | .[:3] + [($efforts[.[0]] // "") | if . == "" then "-" else . end] | join("\t")'
}

models_write() { # fetched-at attempted-at rows
  local cache tmp
  cache="$(models_cache_dir)/models.json"
  mkdir -p "$(models_cache_dir)" 2>/dev/null || return 0
  tmp="$cache.tmp.$$"
  if printf '%s' "$3" | jq -Rn --argjson fetched "$1" --argjson attempted "$2" '
       [inputs | select(length > 0) | split("\t")
        | {slug: .[0], default: (.[1] == "yes"), label: .[2],
           efforts: ((.[3] // "-") | split(",") | map(select(length > 0 and . != "-")))}] as $models
       | {fetched_at: $fetched, attempted_at: $attempted,
          default: (first($models[] | select(.default) | .slug) // ""),
          models: $models}' >"$tmp" 2>/dev/null; then
    mv -f "$tmp" "$cache" 2>/dev/null || rm -f "$tmp"
  else
    rm -f "$tmp"
  fi
}

models_fresh() { [ "$(($1 - $2))" -ge 0 ] && [ "$(($1 - $2))" -lt "$models_ttl_s" ]; } # now stamp

# The list is account-independent, so any signed-in profile answers for all of them; a profile that
# is not signed in prints an older default, which is why one that is signed in has to be found.
models_fetch() {
  local account output
  # Every signed-in profile in turn: one whose token the CLI rejects answers nothing, and stopping
  # at it would cache that failure for the whole TTL on a machine that has a working account.
  while IFS= read -r account; do
    [ -n "$account" ] || continue
    output=$(grok_env_run touch "$account" false models 2>/dev/null) || continue
    output=$(models_parse <<<"$output") || continue
    [ -n "$output" ] || continue
    output=$(models_add_efforts "$(account_home "$account")/models_cache.json" <<<"$output")
    printf '%s\n' "$output"
    return 0
  done < <(list_accounts | sed -n 's/^\([a-z0-9][a-z0-9-]*\): Logged in as .*/\1/p')
  return 1
}

# A failed refresh stamps attempted_at, so a broken grok is asked once per TTL and not by every hook.
models_rows() { # refresh(true|false) [no-fetch(true|false)]
  local cache now fetched=0 attempted=0 rows='' cached='' output no_fetch="${2:-false}"
  [ "${GROKB_MODELS_NO_FETCH:-}" != 1 ] || no_fetch=true
  cache="$(models_cache_dir)/models.json"
  now=$(date +%s)
  if [ -r "$cache" ] && cached=$(jq -r '
       [((.fetched_at // 0) | floor), ((.attempted_at // 0) | floor)] as $stamps
       | ($stamps | map(tostring) | join("\t")),
         (.models[]? | [.slug, (if .default then "yes" else "no" end), .label,
            ((.efforts // []) | if length == 0 then "-" else join(",") end)]
          | select(all(type == "string" and length > 0)) | @tsv)' "$cache" 2>/dev/null); then
    IFS=$'\t' read -r fetched attempted <<<"${cached%%$'\n'*}"
    [ "${cached#*$'\n'}" = "$cached" ] || rows=${cached#*$'\n'}
  fi
  [[ "$fetched" =~ ^[0-9]+$ ]] || fetched=0
  [[ "$attempted" =~ ^[0-9]+$ ]] || attempted=0
  if [ "$no_fetch" = false ] &&
     { [ "$1" = true ] || { ! models_fresh "$now" "$fetched" && ! models_fresh "$now" "$attempted"; }; }; then
    if output=$(models_fetch); then
      models_write "$now" "$now" "$output"
      printf '%s\n' "$output"
      return 0
    fi
    models_write "$fetched" "$now" "$rows"
  fi
  if [ -z "$rows" ]; then
    printf 'grokb: grok models failed; no cache; using the built-in list\n' >&2
    models_builtin
    return 0
  fi
  models_fresh "$now" "$fetched" ||
    printf 'grokb: grok models failed; using the models cached at %s\n' \
      "$(date -u -r "$fetched" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf '%s' "$fetched")" >&2
  printf '%s\n' "$rows"
}

show_models() {
  local json=false refresh=false cached=false rows
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) json=true ;;
      --refresh) refresh=true ;;
      --cached) cached=true ;;
      *) printf 'usage: grokb models [--json] [--refresh|--cached]\n' >&2; exit 2 ;;
    esac
    shift
  done
  [ "$refresh" = false ] || [ "$cached" = false ] ||
    { printf 'grokb: --refresh and --cached are opposites\n' >&2; exit 2; }
  rows=$(models_rows "$refresh" "$cached")
  if [ "$json" = true ]; then
    printf '%s\n' "$rows" | jq -Rn '[inputs | select(length > 0) | split("\t")
      | {slug: .[0], default: (.[1] == "yes"), label: .[2],
         efforts: ((.[3] // "-") | split(",") | map(select(length > 0 and . != "-")))}]'
  else
    printf '%s\n' "$rows"
  fi
}

pin_account() {
  case "${1:-}" in
    --unpin) worker_model_pin_account grok_profile grokb account_names is_disabled --unpin "${2:-}" ;;
    *) worker_model_pin_account grok_profile grokb account_names is_disabled "${1:-}" ;;
  esac
}

set_all_pool() { worker_pool_set_all "$pool_dir" grokb account_names "$1"; }

enable_account() {
  local name="${1:-}"
  if [ -z "$name" ]; then printf 'usage: grokb enable <name>|--all\n' >&2; exit 2; fi
  if [ "$name" = --all ]; then set_all_pool off; return; fi
  if ! account_exists "$name"; then printf 'grokb: unknown account: %s\n' "$name" >&2; exit 2; fi
  if ! is_disabled "$name"; then printf 'grokb: %s is already enabled\n' "$name"; return; fi
  set_disabled "$name" off
  printf 'grokb: enabled %s\n' "$name"
}

disable_account() {
  local name="${1:-}"
  if [ -z "$name" ]; then printf 'usage: grokb disable <name>|--all\n' >&2; exit 2; fi
  if [ "$name" = --all ]; then set_all_pool on; return; fi
  if ! account_exists "$name"; then printf 'grokb: unknown account: %s\n' "$name" >&2; exit 2; fi
  if is_disabled "$name"; then printf 'grokb: %s is already disabled\n' "$name"; return; fi
  set_disabled "$name" on
  printf 'grokb: disabled %s\n' "$name"
}

# `-p`/`--prompt*`/`agent` are grok's headless forms, the way `-p`/`--print` are claudeb's.
args_are_headless() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      -p|--prompt|--prompt=*|--prompt-file|--prompt-file=*|--prompt-json|--prompt-json=*|agent)
        return 0 ;;
    esac
  done
  return 1
}

# Every grok launch in an account's profile. macOS env reads a `-u` after a NAME=value as the
# utility, so the unsets have to stay first; `mode` is exec for a run that owns the terminal, touch
# for the export path's refresh — bounded and stdin-less, because a CLI that prompts or wedges there
# holds the cell launch that asked for a token.
grok_env_run() { # mode name headless args...
  local mode="$1" name="$2" headless="$3" grok_bin
  shift 3
  grok_bin=$(resolve_grok_bin) || return 127
  local -a unsets=() assigns=(GROK_CLAUDE_MCPS_ENABLED=0 GROK_CLAUDE_SKILLS_ENABLED=0
                              GROK_DISABLE_AUTOUPDATER=1)
  # A headless run is a worker; worker-git-guard keys its branch discipline on GROK_WORKER=1 the
  # way it keys claudeb's on CLAUDEB_WORKER=1. Interactive login/profile must not carry it.
  if [ "$headless" = true ]; then assigns+=(GROK_WORKER=1); else unsets+=(-u GROK_WORKER); fi
  if [ "$name" = main ]; then unsets+=(-u GROK_HOME); else assigns+=(GROK_HOME="$profiles_dir/$name"); fi
  local -a command=(env ${unsets[@]+"${unsets[@]}"} "${assigns[@]}" "$grok_bin" "$@")
  if [ "$mode" = exec ]; then exec "${command[@]}"; fi
  run_bounded "$grok_touch_timeout" "${command[@]}"
}

# llm-limits.sh bounds the heartbeat's touch the same way and on the same knob; `timeout` is not on
# a stock macOS, so the watchdog fallback is the one that usually runs.
grok_touch_timeout=${LLM_LIMITS_GROK_TOUCH_TIMEOUT:-30}
case "$grok_touch_timeout" in ''|*[!0-9]*|0) grok_touch_timeout=30 ;; esac
run_bounded() { # seconds command...
  local seconds=$1 timeout_cmd pid watchdog rc=0
  shift
  timeout_cmd=$(command -v timeout 2>/dev/null || command -v gtimeout 2>/dev/null || true)
  if [ -n "$timeout_cmd" ]; then "$timeout_cmd" "$seconds" "$@" </dev/null; return $?; fi
  "$@" </dev/null &
  pid=$!
  (sleep "$seconds"; kill "$pid" 2>/dev/null || true) &
  watchdog=$!
  wait "$pid" 2>/dev/null; rc=$?
  kill "$watchdog" 2>/dev/null || true
  wait "$watchdog" 2>/dev/null || true
  return "$rc"
}

run_account() {
  local allow_create="$1" name="${2:-}" directory created=false
  if [ "$allow_create" = true ] && { [ "$name" = -h ] || [ "$name" = --help ]; }; then
    show_help
    return
  fi
  if [ -z "$name" ]; then printf 'usage: grokb profile <name> [grok args...]\n' >&2; exit 2; fi
  if ! [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    printf "grokb: invalid profile name '%s' (must start with a lowercase letter or number; use only lowercase letters, numbers, and hyphens)\n" "$name" >&2
    exit 2
  fi
  shift 2
  # An interactive session is Egor, and a login run must reach an account he took out of the pool.
  local headless=false
  if args_are_headless "$@"; then
    headless=true
    worker_pool_refuse_headless grok "$name" "$(worker_model_pinned_account grok_profile)" || exit 2
  fi
  if [ "$name" = main ]; then
    grok_env_run exec main "$headless" "$@" || exit "$?"
  fi
  directory="$profiles_dir/$name"
  if [ ! -d "$directory" ]; then
    if [ "$allow_create" != true ]; then printf 'grokb: unknown account: %s\n' "$name" >&2; exit 2; fi
    if reserved_name "$name"; then printf "grokb: invalid profile name '%s'\n" "$name" >&2; exit 2; fi
    mkdir -p "$directory"
    created=true
    printf "grokb: new profile '%s' created at %s — Grok will report if login is required.\n" \
      "$name" "$directory" >&2
  fi
  [ "$created" != true ] || announce_account_added "$grokb_root" grok "$name"
  grok_env_run exec "$name" "$headless" "$@" || exit "$?"
}

show_help() {
  printf '%s\n' \
    'grokb profile <name> [grok args...]  Run Grok headlessly in an isolated profile; creates it if missing. Aliases: p, run.' \
    'grokb profile <name> login --device-auth  Device-code login for that account (menu Grok login uses this).' \
    'grokb <name> exec [grok args...]     Run Grok headlessly in an existing isolated profile.' \
    'grokb add <name>                     Create a profile and run grok login --device-auth.' \
    'grokb remove <name> [--force]        Forget a profile and prune its cached quota; --force overrides the logged-in guard.' \
    'grokb enable <name>|--all            Return an account (or every account) to worker selection.' \
    'grokb disable <name>|--all           Exclude an account (or every account) from the worker pool.' \
    'grokb use <name>|--unpin [<name>]|--clear  Add/remove a workers pin; no name prints the list.' \
    'grokb fast-mode <name> [on|off|status]  Set Fast Mode for worker-run launches on that account; existing sessions are unchanged.' \
    'grokb models [--json] [--refresh|--cached]  The model list every consumer reads, newest first; --cached never asks the CLI.' \
    'grokb list                           List profiles with login state.' \
    'grokb status                         Per-account login state and quota.' \
    'grokb export-token <name> --to <path> [--min-seconds N]  Write a renewal-free copy of the saved session for a confined run; rotates one with less than N seconds left first.'
}

# Both accept the two entry shapes grok-quota.py's auth_entry does, and the expiry is read as both
# shapes llm-limits.sh's grok_token_expired accepts: a profile whose expires_at is a numeric epoch
# is a live session, not an unreadable one to spend a rotation on.
auth_entry_expiry() { # name -> stated<TAB>epoch (epoch 0 = unreadable)
  jq -r '
    def entry:
      if type != "object" then empty
      elif (.key | type) == "string" then .
      else first(.[]? | select(type == "object" and (.key | type) == "string"))
      end;
    ((entry // null) | .expires_at? // null) as $exp |
    (if ($exp | type) == "number" then $exp
     elif ($exp | type) == "string" then
       ($exp | sub("\\.[0-9]+"; "") | try fromdateiso8601 catch null)
     else null end) as $epoch |
    [($exp // "" | tostring), (($epoch // 0) | floor)] | @tsv' \
    "$(account_home "$1")/auth.json" 2>/dev/null
}

# Any key whose name mentions renewal goes, not just the one shape seen today: an unrecognised
# renewal field reaching a throwaway runtime is exactly the rotation this export exists to prevent.
auth_entry_without_renewal() { # name
  jq -c '
    def strip: with_entries(select(.key | test("refresh"; "i") | not));
    if type != "object" then empty
    elif (.key | type) == "string" then strip
    else with_entries(if (.value | type) == "object" and (.value.key | type) == "string"
                      then .value |= strip else . end)
    end
    | select(any(.. | objects; (.key | type) == "string"))' "$(account_home "$1")/auth.json" 2>/dev/null
}

# The CLI owns auth.json: any authenticated subcommand rotates a session near its expiry and writes
# the new pair back through its own auth.json.lock, so this is the one refresh grok has here and
# llm-limits.sh's heartbeat touch is the same call (shared-invariants row ak). "Near" is
# GROK_AUTH_EARLY_INVALIDATION_SECS, 300 by default: a plain touch leaves a 6-hour token with 17
# minutes left untouched, which refused every grok cell in the last half hour of each token (run
# c52158a), so the touch is told the run's own need. Its words and its exit status state nothing —
# only the expiry the rotation leaves behind is a verdict, bar the two answers that mean no
# rotation was even attempted: no binary to run, and a bound that expired.
refresh_failure=''
refresh_access_token() { # name min-seconds -> 1 and refresh_failure when nothing could rotate
  local log='' rc=0 reason=''
  refresh_failure=''
  printf 'grokb: %s: access token too short for the run, touching the CLI to rotate it\n' "$1" >&2
  log=$(mktemp "${TMPDIR:-/tmp}/grokb-touch.XXXXXX") || log=''
  if [ -n "$log" ]; then
    GROK_AUTH_EARLY_INVALIDATION_SECS="$2" grok_env_run touch "$1" false models >"$log" 2>&1 || rc=$?
    reason=$(grep -v '^[[:space:]]*$' "$log" | tail -n1)
    reason=${reason#grokb: }
    rm -f "$log"
  else
    GROK_AUTH_EARLY_INVALIDATION_SECS="$2" grok_env_run touch "$1" false models >/dev/null 2>&1 \
      || rc=$?
  fi
  case "$rc" in
    127) refresh_failure=${reason:-grok CLI not found} ;;
    124|137|143) refresh_failure="the token touch timed out after ${grok_touch_timeout}s" ;;
    *) return 0 ;;
  esac
  return 1
}

# grok's own auth.json keeps a refresh_token beside the access key, and a confined runtime holding
# one can rotate the login this machine signs in with. What leaves is the same document with every
# renewal credential deleted: 1.0.13 reads a session from $GROK_HOME/auth.json and nowhere else, so a
# run that outlives its access token gets a 401 it cannot heal rather than a fresh pair of tokens.
# --min-seconds is the caller saying how long the run needs, because nothing on the far side renews:
# a session with less than that left is rotated in the live profile first, and only a rotation that
# still does not reach N refuses.
export_token() {
  local name="${1:-}" target='' min_seconds=0 expiry_row='' expires_at='' stamp='' epoch=0
  local now remaining document refreshed=false
  if [ "$#" -gt 0 ]; then shift; fi
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --to) target="${2:-}"; shift 2 || return 2 ;;
      --min-seconds) min_seconds="${2:-}"; shift 2 || return 2 ;;
      *) break ;;
    esac
  done
  if [ "$#" -gt 0 ] || [ -z "$name" ] || [ -z "$target" ] || ! [[ "$min_seconds" =~ ^[0-9]+$ ]] \
     || ! [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    printf 'usage: grokb export-token <name> --to <path> [--min-seconds N]\n' >&2
    return 2
  fi
  if ! account_exists "$name"; then
    printf 'grokb: unknown account: %s\n' "$name" >&2
    return 2
  fi
  if [ -e "$target" ]; then
    printf 'grokb: %s already exists\n' "$target" >&2
    return 2
  fi
  while :; do
    expiry_row=$(auth_entry_expiry "$name") || expiry_row=''
    expires_at=''
    document=$(auth_entry_without_renewal "$name") || document=''
    if [ -z "$document" ]; then
      printf 'grokb: %s is not signed in; refusing a login or a live-profile fallback\n' "$name" >&2
      return 3
    fi
    IFS=$'\t' read -r expires_at epoch <<<"$expiry_row" || true
    [[ "$epoch" =~ ^[0-9]+$ ]] || epoch=0
    # jq's ISO parser wants the zone marker grok writes; `date` still reads a stamp without one.
    if [ "$epoch" -eq 0 ] && [ -n "$expires_at" ]; then
      stamp="${expires_at%Z}"
      stamp="${stamp%%.*}"
      epoch=$(TZ=UTC date -j -f '%Y-%m-%dT%H:%M:%S' "$stamp" +%s 2>/dev/null) || epoch=0
    fi
    now=$(date +%s)
    remaining=$((epoch - now))
    # No readable expiry is the same answer as too little of it: the cell would use the token until
    # a 401 it has no way to recover from.
    if [ "$epoch" -gt 0 ] && [ "$remaining" -ge "$min_seconds" ]; then break; fi
    document=''
    if [ "$refreshed" = true ]; then
      printf "grokb: %s's access token does not outlast the run (%s seconds left after a refresh, %s needed)\n" \
        "$name" "$remaining" "$min_seconds" >&2
      return 4
    fi
    refreshed=true
    if ! refresh_access_token "$name" "$min_seconds"; then
      printf "grokb: %s's access token could not be rotated: %s\n" "$name" "$refresh_failure" >&2
      return 4
    fi
  done
  if ! (set -C; umask 077; printf '%s\n' "$document" >"$target"); then
    document=''
    printf 'grokb: %s could not be written\n' "$target" >&2
    return 2
  fi
  document=''
  chmod 600 "$target"
  printf 'source=auth.json expires_at=%s\n' "$expires_at"
}

if [ "${2:-}" = exec ] && [[ "${1:-}" =~ ^[a-z0-9][a-z0-9-]*$ ]] && account_exists "${1:-}"; then
  name="$1"
  shift 2
  run_account false "$name" "$@"
fi

case "${1:-}" in
  add)
    shift
    [ "$#" -eq 1 ] || { printf 'usage: grokb add <name>\n' >&2; exit 2; }
    add_account "$1"
    ;;
  remove)
    shift
    [ "$#" -ge 1 ] || { printf 'usage: grokb remove <name> [--force]\n' >&2; exit 2; }
    remove_account "$@"
    ;;
  enable)
    shift
    enable_account "${1:-}"
    ;;
  disable)
    shift
    disable_account "${1:-}"
    ;;
  use)
    shift
    pin_account "$@"
    ;;
  fast-mode)
    shift
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || { printf 'usage: grokb fast-mode <name> [on|off|status]\n' >&2; exit 2; }
    account_exists "$1" || { printf 'grokb: unknown account: %s\n' "$1" >&2; exit 2; }
    python3 "$grokb_root/share/codex_fast_mode.py" "$profiles_dir" "$1" "${2:-status}" grokb
    exit
    ;;
  models)
    shift
    show_models "$@"
    ;;
  list)
    [ "$#" -eq 1 ] || { printf 'usage: grokb list\n' >&2; exit 2; }
    list_accounts
    ;;
  status)
    [ "$#" -eq 1 ] || { printf 'usage: grokb status\n' >&2; exit 2; }
    show_status
    ;;
  export-token)
    shift
    export_token_rc=0
    export_token "$@" || export_token_rc=$?
    exit "$export_token_rc"
    ;;
  profile|p|run)
    shift
    run_account true "$@"
    ;;
  help|-h|--help|'')
    show_help
    ;;
  *)
    name="$1"
    if [ "${2:-}" != exec ]; then printf 'usage: grokb <name> exec [grok args...]\n' >&2; exit 2; fi
    shift 2
    run_account false "$name" "$@"
    ;;
esac

FORBIDDEN_COMPONENTS = ("chat/model",)


def validate_levers(levers):
    """Egor's rule (2026-10-03): speed of the current setup at the same intelligence. A lever that touches the
    model, effort, thinking or vendor of a role is no lever; a lever's quality class is declared, never implied."""
    for lever in levers:
        text = " ".join(str(lever.get(k) or "") for k in ("component", "lever"))
        hit = FORBIDDEN_LEVER.search(text)
        if hit or lever.get("component") in FORBIDDEN_COMPONENTS:
            raise ValueError("forbidden lever class (model, effort, thinking or vendor): %r names %r"
                             % (lever.get("lever"), hit.group(0) if hit else lever.get("component")))
        if lever.get("quality") not in QUALITY:
            raise ValueError("lever %r has no quality: equivalent|risk" % lever.get("lever"))
    return levers


def slice_levers(partition):
    """A partition slice no LEVERS row names still ranks by its minutes, on a generic output-equivalent lever; the
    model slice stays forbidden; the residual and the task-sized worker runs are blind spots."""
    named = {l["component"] for l in LEVERS} | set(FORBIDDEN_COMPONENTS) | set(NO_SLICE_LEVER)
    return [dict(SLICE_LEVER, component=component,
                 lever="cut the %s wait toward its floor, outputs unchanged" % component.split("/", 1)[1])
            for component in sorted("%s/%s" % (area, leaf) for area, leaves in partition.items() for leaf in leaves)
            if component not in named and not FORBIDDEN_LEVER.search(component)]


def lever_evidence(lever):
    evidence = lever.get("quality_evidence")
    return isinstance(evidence, dict) and all(str(evidence.get(k) or "").strip() for k in EVIDENCE_KEYS)


def shown_levers(levers):
    """An equivalent lever ranks for the night; a risk lever is only a needs-Egor proposal, and only with evidence."""
    return [l if l["quality"] == "equivalent" else dict(l, needs_egor=True) for l in levers
            if l["quality"] == "equivalent" or lever_evidence(l)]



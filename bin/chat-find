#!/usr/bin/env python3
"""Find past Claude Code chats by what was SAID in them.

Reports the last real message of each chat, never file mtime: resuming a chat
rewrites its transcript, so the freshest-looking file is often one that was
opened, glanced at and closed. Prints the matched line verbatim — a quote of his
own words identifies a chat, a summary of it does not.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from functools import lru_cache

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "share"))
from chat_names import (  # noqa: E402
    HEADLESS_VIA, NAME_LINE_MAX, NAME_PATTERNS, chat_name, names_by_path, note_name,
    searcher, split_hit, store_names, worker_run_launchers,
)

HIS_CORPUS = os.path.expanduser("~/.claude/projects")
ROOT = os.environ.get("CHAT_FIND_ROOT") or HIS_CORPUS
STATE = os.path.expanduser("~/.claude-profiles/.claudeb/.claudeb-state")
HEAD_LINES = 400
SNIPPET_PAD = 70
# Speech can be a long paste, so the cap is generous; what must never be parsed
# is tool output, and that is ruled out on the raw bytes instead of by size.
MAX_LINE = 4 * 1024 * 1024
MAX_HITS_PER_FILE = 200
CACHE = os.environ.get("CHAT_FIND_CACHE") or os.path.expanduser(
    "~/.claude-profiles/.claudeb/chat-recent-cache.json")
CACHE_VERSION = 4
# A transcript can end with megabytes of tool output after the last word spoken,
# so the backward scan grows until it finds speech instead of trusting one window.
TAIL_WINDOWS = (512 * 1024, 4 * 1024 * 1024, 32 * 1024 * 1024)
# String-content user entries that are machinery, not something he typed.
MACHINERY = ("<command-name>", "<local-command", "<system-reminder>", "Caveat:",
             "<bash-stdout>", "<bash-stderr>")
# Openers that describe the session rather than open a conversation. Compact
# summaries stay searchable (they are a faithful digest of a chat that has one),
# they just never stand in for what he said.
NOT_A_TITLE = MACHINERY + ("You are ", "This session is being continued")
PROFILE_OK = re.compile(r"^[A-Za-z0-9._-]+$")
# A `! command` he typed is stored wrapped in its own tags; quoted back with them
# it reads as markup rather than as the line he typed.
BANG = re.compile(r"<bash-input>(.*?)</bash-input>", re.S)


def die(message):
    print("chat-find: " + message, file=sys.stderr)
    raise SystemExit(1)


def account():
    """The claudeb profile to resume under, or None for the plain launcher.

    "main" is not a claudeb profile and a name with shell metacharacters has no
    business in a line he is meant to paste — both fall back to bare `claude`.
    """
    name = os.environ.get("CLAUDE_LIMITS_ACCOUNT")
    if not name:
        try:
            with open(STATE, encoding="utf-8") as handle:
                name = handle.readline().strip()
        except OSError:
            name = ""
    if name and name != "main" and PROFILE_OK.match(name):
        return name
    return None


def visible_text(entry, include_all):
    """The conversation text of one transcript line, or None if it is not speech.

    Tool results and file reads carry the words of whatever was being worked on,
    not of the conversation, and matching them is how a search for "sidecar"
    turns into every chat that ever opened a file mentioning it.
    """
    # A sidechain is a subagent talking to itself inside a session — never a
    # conversation he could remember having.
    if entry.get("isSidechain"):
        return None
    # A "<synthetic>" assistant message is the client talking to itself — "Login
    # expired", an API error — and ranking a chat by one dates it to the moment
    # it failed to open rather than to anything said in it.
    if (entry.get("message") or {}).get("model") == "<synthetic>":
        return None
    kind = entry.get("type")
    content = (entry.get("message") or {}).get("content")
    if kind == "user" and isinstance(content, str):
        if entry.get("isMeta"):
            return None
        if not include_all and content.lstrip().startswith(MACHINERY):
            return None
        return content
    if kind in ("user", "assistant") and isinstance(content, list):
        # A prompt with a screenshot attached arrives as blocks, and so does every
        # assistant reply; tool_result blocks carry no "text" and drop out here.
        parts = [b.get("text", "") for b in content
                 if isinstance(b, dict) and b.get("type") == "text" and isinstance(b.get("text"), str)]
        if parts:
            return "\n".join(parts)
    if include_all and isinstance(content, str):
        return content
    if include_all and isinstance(content, list):
        return "\n".join(
            b.get("text") or b.get("content") or ""
            for b in content
            if isinstance(b, dict) and isinstance(b.get("text") or b.get("content"), str)
        )
    return None


def stamp(entry):
    value = entry.get("timestamp")
    if not isinstance(value, str):
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone()
    except ValueError:
        return None


def maybe_speech(raw, include_all):
    """Cheap byte test: is this line worth JSON-parsing at all?

    Tool results are the multi-megabyte majority of every transcript, and
    parsing them is the difference between half a second and a minute. The
    role markers are matched without assuming a space after the colon, so a
    transcript written by any JSON encoder still scans.
    """
    if len(raw) > MAX_LINE:
        return False
    if include_all:
        return True
    if b'"tool_result"' in raw:
        return False
    return b'"user"' in raw or b'"assistant"' in raw


def scan_matches(terms, include_all, root):
    """One streaming pass over the corpus, reduced to per-file match state.

    The output is consumed line by line: a common term can match gigabytes, and
    buffering all of it before filtering would trade a fast search for an OOM.
    """
    argv, binary = searcher()
    if not binary:
        die("neither rg nor grep is available to search with")
    command = argv + ["-a", "-i", "-H", "-F"]
    for term in list(terms) + list(NAME_PATTERNS):
        command += ["-e", term]
    command.append(root)

    lowered = [t.lower() for t in terms]
    found = {}
    names = {}
    proc = subprocess.Popen(command, executable=binary, stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL)
    for raw in proc.stdout:
        raw = raw.rstrip(b"\n")
        # Only a genuine name event is consumed here; a message that merely quotes
        # the marker is still speech to be matched.
        if len(raw) < NAME_LINE_MAX and (b'"custom-title"' in raw or b'"ai-title"' in raw) \
                and note_name(names, raw):
            continue
        if not maybe_speech(raw, include_all):
            continue
        path, payload = split_hit(raw)
        if payload is None:
            continue
        state = found.get(path)
        if state is not None and state["hits"] >= MAX_HITS_PER_FILE:
            state["capped"] = True
            continue
        try:
            entry = json.loads(payload.decode("utf-8", "replace"))
        except ValueError:
            continue
        text = visible_text(entry, include_all)
        if not text:
            continue
        low = text.lower()
        hit = [t for t in lowered if t in low]
        if not hit:
            continue
        if state is None:
            state = found.setdefault(path, {"hits": 0, "terms": set(), "snippet": None,
                                            "spoke": None, "capped": False, "rank": -1,
                                            "via": None})
        state["via"] = state["via"] or entry.get("entrypoint")
        state["hits"] += 1
        state["terms"].update(hit)
        when = stamp(entry)
        if when and (state["spoke"] is None or when > state["spoke"]):
            state["spoke"] = when
        # His own wording is what he recognises: a line he typed outranks an
        # assistant reply, which outranks a compact summary — a summary quotes the
        # conversation back in the model's words, which is the paraphrase this
        # tool exists to replace.
        rank = 2 if entry.get("type") == "user" else 1
        if text.lstrip().startswith(NOT_A_TITLE):
            rank = 0
        if state["snippet"] is None or rank >= state["rank"]:
            state["snippet"] = snippet(text, hit[0])
            state["rank"] = rank
    proc.stdout.close()
    if proc.wait() not in (0, 1):
        die("search failed (%s exited %d)" % (argv[0], proc.returncode))
    # Naming classifies a transcript the way main() does — the tail's entrypoint first, the
    # matched line's only where the tail has none. Off the matched line alone, a run whose
    # errand talked about anything but itself would be named by the title of that errand.
    for path, state in found.items():
        state["via"] = (last_facts(path) or {}).get("via") or state["via"]
    display = resolved_names(names, found)
    for path, text in display.items():
        low = text.lower()
        hit = [t for t in lowered if t in low]
        if not hit:
            continue
        state = found.get(path)
        if state is None:
            # A name he typed himself may stand alone as a candidate; a name resolved
            # from anywhere else — a model guess, a worker run's launching chat — only
            # ever decorates a chat found by its words.
            if (names.get(path) or {}).get("custom") != text:
                continue
            # No hit, no snippet: nothing was said here, so nothing may be quoted
            # as if it had been.
            state = found.setdefault(path, {"hits": 0, "terms": set(), "snippet": None,
                                            "spoke": None, "capped": False, "rank": -1,
                                            "via": None})
        state["terms"].update(hit)
    return found, display


def resolved_names(names, found):
    """path -> the name that transcript may be shown under, everything nameless left out.

    Every name this tool prints or matches comes through here, so a worker run answers with
    the chat that launched it and never with a name of its own — one he has never seen.
    """
    launchers, store = worker_run_launchers(), store_names()
    display = {}
    for path in set(names) | set(found):
        title = names.get(path) or {}
        name = chat_name(
            os.path.basename(path)[: -len(".jsonl")],
            title.get("custom") or title.get("ai"),
            headless=(found.get(path) or {}).get("via") == HEADLESS_VIA,
            launchers=launchers, store=store,
        )
        if name:
            display[path] = name
    return display


def snippet(text, term):
    flat = " ".join(text.split())
    at = flat.lower().find(term)
    if at < 0:
        return flat[: SNIPPET_PAD * 2] + ("…" if len(flat) > SNIPPET_PAD * 2 else "")
    start = max(0, at - SNIPPET_PAD)
    end = min(len(flat), at + len(term) + SNIPPET_PAD)
    return ("…" if start else "") + flat[start:end] + ("…" if end < len(flat) else "")


def head_facts(path):
    cwd, title = None, None
    try:
        with open(path, "rb") as handle:
            for _ in range(HEAD_LINES):
                raw = handle.readline()
                if not raw:
                    break
                if len(raw) > MAX_LINE:
                    continue
                try:
                    entry = json.loads(raw.decode("utf-8", "replace"))
                except ValueError:
                    continue
                cwd = cwd or entry.get("cwd")
                if title is None and entry.get("type") == "user":
                    text = visible_text(entry, False)
                    if text and not text.lstrip().startswith(NOT_A_TITLE):
                        title = " ".join(text.split())[:110]
                if cwd and title:
                    break
    except OSError:
        pass
    return cwd, title


def tail_speech(path, size, window):
    """The last real message of a chat and the facts riding on the same records.

    cwd, branch, model and context size all live on ordinary message lines, so
    one backward pass identifies a chat completely — listing thousands of them
    never has to read a single transcript's head.
    """
    try:
        with open(path, "rb") as handle:
            handle.seek(max(0, size - window))
            chunk = handle.read(window)
    except OSError:
        return None
    lines = chunk.split(b"\n")
    if window < size:
        lines = lines[1:]
    said, spec = None, None
    for raw in reversed(lines):
        if not raw.startswith(b"{") or not maybe_speech(raw, False):
            continue
        try:
            entry = json.loads(raw.decode("utf-8", "replace"))
        except ValueError:
            continue
        # A subagent's reply carries its own model and its own small context; taking
        # either would label a chat by the last worker it spawned rather than by the
        # conversation he was having.
        if spec is None and entry.get("type") == "assistant" and not entry.get("isSidechain"):
            message = entry.get("message") or {}
            usage = message.get("usage")
            if isinstance(usage, dict) and message.get("model") != "<synthetic>":
                spec = {"model": message.get("model"), "ctx": context_tokens(usage)}
        if said is None:
            text = visible_text(entry, False)
            when = stamp(entry) if text else None
            if when:
                said = {"when": when, "role": entry.get("type"),
                        "text": " ".join(BANG.sub(r"! \1", text).split())[:400],
                        "cwd": entry.get("cwd"), "branch": entry.get("gitBranch"),
                        "via": entry.get("entrypoint")}
        if said and spec:
            break
    if said is None:
        return None
    said.update(spec or {"model": None, "ctx": None})
    return said


def context_tokens(usage):
    """What the last request actually carried — the number that says how heavy
    a chat has become. Cache reads are the bulk of it and are still context."""
    total = 0
    for key in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"):
        value = usage.get(key)
        if isinstance(value, int):
            total += value
    return total or None


@lru_cache(maxsize=None)
def last_facts(path):
    """Everything known about a chat's end, read backward from it."""
    try:
        size = os.path.getsize(path)
    except OSError:
        return None
    for window in TAIL_WINDOWS:
        facts = tail_speech(path, size, window)
        # Widening once more when the model is missing was measured and dropped:
        # it resolved none of the blank labels (those chats hold no model reply
        # at all) and cost 60% of the cold scan.
        if facts or window >= size:
            return facts
    return None


def load_cache(path):
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict) or data.get("version") != CACHE_VERSION:
        return {}
    rows = data.get("rows")
    return rows if isinstance(rows, dict) else {}


def save_cache(path, rows):
    """Best effort: a listing that cannot write its cache is slow, never wrong."""
    tmp = "%s.tmp.%d" % (path, os.getpid())
    try:
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump({"version": CACHE_VERSION, "rows": rows}, handle)
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def measured(path, key):
    facts = last_facts(path)
    if not facts:
        # Transcripts that never held a message (a /clear stub) are cached as
        # such: they are a third of the corpus, and re-reading them every
        # listing costs more than every real chat put together.
        return {"key": key, "at": None}
    return {"key": key, "at": facts["when"].timestamp(), "role": facts["role"],
            "text": facts["text"], "cwd": facts["cwd"], "branch": facts["branch"],
            "model": facts["model"], "ctx": facts["ctx"], "via": facts["via"]}


def scan_recent(root, days, cache_path, agents=False):
    """Every chat whose last real message falls in the window, newest first.

    File mtime is an upper bound on that message — a transcript is only written
    after something is said in it — so the window drops most files without
    opening them, and an unchanged (size, mtime) pair means the cached answer
    still holds. Those two facts are what keep a 6000-transcript corpus fast.
    """
    cache = load_cache(cache_path) if cache_path else {}
    horizon = time.time() - days * 86400 if days is not None else None
    # Measurements outside this window are kept: the picker opens on a week and
    # widens as he scrolls, and a cache holding only the last window would make
    # every widening re-read the corpus it just discarded.
    seen, rows, fresh = dict(cache), [], set()
    for base, _, names in os.walk(root):
        for name in names:
            if not name.endswith(".jsonl"):
                continue
            path = os.path.join(base, name)
            try:
                info = os.stat(path)
            except OSError:
                continue
            if horizon and info.st_mtime < horizon:
                continue
            key = "%d:%r" % (info.st_size, info.st_mtime)
            row = cache.get(path)
            if not isinstance(row, dict) or row.get("key") != key:
                row = measured(path, key)
            seen[path] = row
            fresh.add(path)
            when = row.get("at")
            if not when or (horizon and when < horizon):
                continue
            if not agents and row.get("via") == HEADLESS_VIA:
                continue
            listed = {field: value for field, value in row.items() if field != "key"}
            rows.append(dict(listed, path=path, session=name[: -len(".jsonl")]))
    if cache_path:
        # Chats get purged (the trash sweep) and whole projects get deleted; a
        # stat each is cheap next to the transcript reads this cache exists to
        # avoid, and without it the file only ever grows.
        save_cache(cache_path, {path: row for path, row in seen.items()
                                if path in fresh or os.path.exists(path)})
    rows.sort(key=lambda row: row["at"], reverse=True)
    return rows


def short_model(name):
    # The release date in a model id ("claude-haiku-4-5-20251001") is width the
    # column pays for one model and nobody reads.
    return re.sub(r"-20\d{6}$", "", (name or "").replace("claude-", "")) or "-"


def report_recent(args):
    # A corpus that is not his own (a test fixture, or anything CHAT_FIND_ROOT
    # points at) gets no cache unless one is named: the shared cache is keyed by
    # path alone and must not mix corpora.
    cache_path = args.cache or (CACHE if args.root == HIS_CORPUS else None)
    rows = scan_recent(args.root, args.days, cache_path, args.agents)
    if args.limit:
        rows = rows[: args.limit]
    names = names_by_path(args.root, [row["path"] for row in rows])
    launchers, store = worker_run_launchers(), store_names()
    for row in rows:
        title = names.get(row["path"]) or {}
        row["name"] = chat_name(row["session"], title.get("custom") or title.get("ai"),
                                headless=row.get("via") == HEADLESS_VIA, launchers=launchers,
                                store=store)
    if args.json:
        json.dump(rows, sys.stdout, ensure_ascii=False)
        sys.stdout.write("\n")
        return
    now = datetime.now(timezone.utc).astimezone()
    for row in rows:
        when = datetime.fromtimestamp(row["at"]).astimezone()
        print("%s (%s)  %s%s  %s %s  %s" % (
            when.strftime("%Y-%m-%d %H:%M"), ago(when, now),
            os.path.basename(row.get("cwd") or "?"),
            (" ⎇ " + row["branch"]) if row.get("branch") else "",
            short_model(row.get("model")),
            ("%dk" % (row["ctx"] // 1000)) if row.get("ctx") else "-",
            row.get("text") or row.get("name") or ""))
        print("  " + row["session"] + ("  " + row["name"] if row.get("name") else ""))


def hidden_note(headless):
    return (" · %d headless run%s hidden (--agents)"
            % (headless, "" if headless == 1 else "s")) if headless else ""


def ago(when, now):
    minutes = (now - when).total_seconds() / 60
    if minutes < 90:
        return "%dm ago" % max(0, int(minutes))
    if minutes < 60 * 36:
        return "%.0fh ago" % (minutes / 60)
    return "%.0fd ago" % (minutes / 1440)


def main():
    parser = argparse.ArgumentParser(
        prog="chat-find",
        description="Find past chats by what was said in them; every hit carries the date of its last real message.",
    )
    parser.add_argument("terms", nargs="*", help="words he would have typed, or a name he gave a chat; "
                                                 "newest last message first, more terms matched breaking ties")
    parser.add_argument("--recent", action="store_true",
                        help="list every chat instead of searching, newest real message first")
    parser.add_argument("--json", action="store_true", help="machine-readable output (--recent only)")
    parser.add_argument("--agents", action="store_true",
                        help="also match and list headless runs — workers, benches, subagents")
    parser.add_argument("--days", type=float, help="only chats whose last message is within N days")
    parser.add_argument("--limit", type=int, default=None,
                        help="candidates to print (default 8 when searching, all with --recent)")
    parser.add_argument("--all", action="store_true", help="also match tool output and file contents")
    parser.add_argument("--account", default=None, help="claudeb profile for the resume line")
    parser.add_argument("--root", default=ROOT, help=argparse.SUPPRESS)
    parser.add_argument("--cache", default=None, help=argparse.SUPPRESS)
    args = parser.parse_args()

    if not os.path.isdir(args.root):
        die("no transcript corpus at " + args.root)
    # "All of them" is what leaving --limit out means, so a 0 asking for the empty
    # listing would read as the opposite of what it does.
    if args.limit is not None and args.limit < 1:
        die("--limit takes a positive count; omit it for all of them")

    if args.recent:
        if args.terms:
            die("--recent lists every chat; it takes no search terms")
        report_recent(args)
        return
    if not args.terms:
        die("nothing to search for (pass words, or --recent to list every chat)")
    if args.limit is None:
        args.limit = 8

    started = time.time()
    found, names = scan_matches(args.terms, args.all, args.root)
    now = datetime.now(timezone.utc).astimezone()

    rows, headless = [], 0
    for path, state in found.items():
        facts = last_facts(path)
        when = (facts["when"] if facts else None) or state["spoke"]
        if when is None:
            continue
        # Out of the window first: a hidden-run note counted before it would promise
        # that --agents reveals a run the same --days still drops.
        if args.days is not None and (now - when).total_seconds() > args.days * 86400:
            continue
        # The matched line's own entrypoint stands in where the tail scan found no
        # speech to read one from — a transcript ending in megabytes of tool output
        # would otherwise lose the classification and list the errand as a chat.
        via = (facts or {}).get("via") or state["via"]
        if not args.agents and via == HEADLESS_VIA:
            headless += 1
            continue
        rows.append((when, path, state))
    # Newest last-real-message first (never file mtime), relevance to break ties:
    # the date is what he recognises a chat by, so the list reads as a timeline.
    rows.sort(key=lambda r: (r[0], len(r[2]["terms"]), r[2]["hits"]), reverse=True)

    if not rows:
        scope = "" if args.all else " (visible conversation only; --all widens to tool output)"
        print("no chat matched %s%s%s" % (", ".join(args.terms), scope, hidden_note(headless)))
        return

    profile = args.account or account()
    shown = rows[: args.limit]
    for when, path, state in shown:
        cwd, title = head_facts(path)
        session = os.path.basename(path)[: -len(".jsonl")]
        launcher = ("claudeb profile %s --resume %s" % (profile, session)) if profile \
            else ("claude --resume %s" % session)
        tally = "name match" if not state["hits"] else "%d%s hit%s" % (
            state["hits"], "+" if state["capped"] else "", "" if state["hits"] == 1 else "s")
        print("LAST %s (%s) · %s · %s" % (
            when.strftime("%Y-%m-%d %H:%M"), ago(when, now), tally,
            ",".join(sorted(state["terms"]))))
        if names.get(path):
            print("  name:        " + names[path])
        if title:
            print("  opened with: " + title)
        if state["snippet"]:
            print("  said:        " + state["snippet"])
        print("  resume:      cd %s && %s" % ("'" + (cwd or ".").replace("'", "'\\''") + "'", launcher))
        print()

    print("%d chat(s) matched, %d shown, %.1fs%s — LAST is the last real message; file mtime is not it "
          "(opening a chat bumps mtime with nothing said)"
          % (len(rows), len(shown), time.time() - started, hidden_note(headless)))


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        # `chat-find --recent | head` is the normal way to read a long listing.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        raise SystemExit(0)

#!/usr/bin/env bash
set -u

resolve_script() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")" && printf '%s/%s\n' "$PWD" "$(basename "$source")"
}

ladder_loosen() {
  case "$1" in
    15) printf '22\n' ;;
    22) printf '30\n' ;;
    30) printf '45\n' ;;
    45|60) printf '60\n' ;;
    *) printf '30\n' ;;
  esac
}

ladder_tighten() {
  case "$1" in
    60) printf '45\n' ;;
    45) printf '30\n' ;;
    30) printf '22\n' ;;
    22|15) printf '15\n' ;;
    *) printf '30\n' ;;
  esac
}

cadence_due() {
  [ $(( $3 - $2 )) -ge $(( $1 * 60 )) ]
}

clean_window_elapsed() {
  [ "$1" -gt 0 ] && [ $(( $2 - $1 )) -ge 259200 ]
}

# The gateway states a reset to the day, so the horizon it gives is approximate: the cadence
# tightens inside this much of it and keeps probing past it, because only a served request — never
# the clock — ends a wall.
OPENCODE_TIGHTEN_WITHIN_S=3600

# Claim, break, and release semantics live in share/store-lock.sh (sourced below); only the
# single-attempt acquire is this daemon's own — a tick that finds the lock held simply skips.
refresh_lock_acquire() {
  local lock=$1 current captured
  local stale=${LLM_LIMITS_REFRESH_LOCK_STALE_SECONDS:-1800}
  local ceiling=${LLM_LIMITS_REFRESH_LOCK_CEILING_SECONDS:-3600}
  [[ "$stale" =~ ^[1-9][0-9]*$ ]] || stale=1800
  [[ "$ceiling" =~ ^[1-9][0-9]*$ ]] || ceiling=3600
  if mkdir "$lock" 2>/dev/null; then
    store_lock_claim "$lock" || return 1
    active_lock=$lock
    return 0
  fi
  current=$(date +%s) || return 1
  store_lock_breakable "$lock" "$stale" "$ceiling" "$current" || return 1
  # Claim by rename so a racing tick that already recreated the lock keeps it.
  captured="${lock}.break.$$"
  mv "$lock" "$captured" 2>/dev/null || return 1
  if ! store_lock_breakable "$captured" "$stale" "$ceiling" "$current"; then
    # We captured a lock a racer had just recreated: hand its live newborn back.
    # mv into an existing directory would nest, so restore only onto a free path.
    [ -e "$lock" ] || mv "$captured" "$lock" 2>/dev/null
    rm -rf "$captured" 2>/dev/null
    return 1
  fi
  rm -rf "$captured"
  mkdir "$lock" 2>/dev/null || return 1
  store_lock_claim "$lock" || return 1
  active_lock=$lock
  return 0
}

refresh_lock_release() {
  [ -n "${active_lock:-}" ] || return 0
  store_lock_release "$active_lock"
  active_lock=''
}

script_path=$(resolve_script)
repo_root=$(cd "$(dirname "$script_path")/.." && pwd)
. "$repo_root/share/store-lock.sh"
collector=${LLM_LIMITS_REFRESH_COLLECTOR:-${LLM_REFRESH_COLLECTOR:-$repo_root/llm-limits.sh}}
opencode_go=${LLM_LIMITS_REFRESH_OPENCODE_GO:-$repo_root/bin/opencode-go}
if [ -n "${LLM_LIMITS_REFRESH_CLAUDEB:-}" ]; then
  # An explicit override is taken verbatim: silently escaping to PATH would run the real
  # claudeb against real accounts in a test that meant to point at its stub.
  claudeb_bin=$LLM_LIMITS_REFRESH_CLAUDEB
else
  claudeb_bin=$repo_root/bin/claudeb
  [ -x "$claudeb_bin" ] || claudeb_bin=$(command -v claudeb 2>/dev/null || printf '%s' "$claudeb_bin")
fi
revive_timeout=${LLM_LIMITS_REFRESH_REVIVE_TIMEOUT:-240}
case "$revive_timeout" in ''|*[!0-9]*|0) revive_timeout=240 ;; esac
store=${LLM_LIMITS_CACHE:-$HOME/.llm-limits.json}
state_file=${LLM_LIMITS_REFRESH_STATE:-${LLM_REFRESH_STATE:-$HOME/.llm-limits-refresh.state}}
journal_file=${LLM_LIMITS_REFRESH_JOURNAL:-${LLM_REFRESH_JOURNAL:-$HOME/.llm-limits-refresh.jsonl}}
now=${LLM_LIMITS_REFRESH_NOW:-${LLM_REFRESH_NOW:-$(date +%s)}}
agent_plist="$HOME/Library/LaunchAgents/com.llm-refresh.plist"
wrapper="$HOME/.local/libexec/llm-refresh-heartbeat"
label=com.llm-refresh
active_lock=''
tick_tmp=''

normalized_state() {
  local input=${1:-'{}'}
  jq -cn --argjson now "$now" --argjson state "$input" '
    def rung: if . == 15 or . == 22 or . == 30 or . == 45 or . == 60 then . else 30 end;
    def epoch: if type == "number" and . >= 0 then floor else 0 end;
    ["claude","codex","gemini","opencode"] | map(. as $vendor |
      (($state.vendors[$vendor] // $state[$vendor] // {}) as $old |
       {key:$vendor, value:{
         interval_min:($old.interval_min | rung),
         last_attempt_epoch:($old.last_attempt_epoch | epoch),
         clean_since_epoch:(if ($old.clean_since_epoch | epoch) == 0
                            then $now else ($old.clean_since_epoch | epoch) end),
         attempts:(if ($old.attempts | type) == "object"
                   then ($old.attempts | with_entries(.value |= epoch)) else {} end)
       }})) | from_entries'
}

# Third column: an account no refresh can help (removed, disabled, or needing a login).
account_rows() {
  local vendor=$1
  [ -r "$store" ] || return 0
  jq -r --arg vendor "$vendor" '
    def blocked:
      .removed == true or .enabled == false or .auth_needed == true or
      ((.auth.status? // "") | . == "expired" or . == "failed");
    def row($name):
      [$name,
       ([.five_hour?.as_of, .weekly?.as_of, .fable?.as_of, .as_of_epoch]
        | map(select(type == "number")) | min // 0),
       (if blocked then 1 else 0 end)] | @tsv;
    .vendors[$vendor] // {} |
    if (.accounts | type) == "array" and (.accounts | length) > 0 then
      .accounts[] | row(.account)
    else
      row(if (.current_account | type) == "string" then .current_account else "main" end)
    end
  ' "$store" 2>/dev/null
}

stale_rows_json() {
  local vendor=$1 interval=$2 want=$3 account as_of blocked age rows='[]'
  while IFS=$'\t' read -r account as_of blocked; do
    [ -n "$account" ] || continue
    case "$blocked" in 1) blocked=1 ;; *) blocked=0 ;; esac
    [ "$blocked" = "$want" ] || continue
    case "$as_of" in ''|*[!0-9]*) as_of=0 ;; esac
    age=$((now - as_of))
    [ "$age" -ge 0 ] || age=0
    if [ "$as_of" -eq 0 ] || [ "$age" -ge $((interval * 60)) ]; then
      rows=$(jq -c --arg account "$account" '. + [$account]' <<<"$rows")
    fi
  done < <(account_rows "$vendor")
  printf '%s\n' "$rows"
}

stale_accounts_json() {
  stale_rows_json "$1" "$2" 0
}

account_names_json() {
  account_rows "$1" | cut -f1 | jq -R -s -c 'split("\n") | map(select(length > 0))'
}

# Least recently attempted of the given accounts, never-attempted first, oldest as_of breaking
# ties. A failing revive leaves as_of untouched, so picking by staleness alone would re-select
# the same account every tick and starve the rest.
next_revive_account() {
  local vendor=$1 wanted=$2 attempts=$3 account as_of blocked attempted
  local best='' best_attempt=-1 best_as_of=-1
  while IFS=$'\t' read -r account as_of blocked; do
    [ -n "$account" ] || continue
    # claudeb reserves both names, so revive would refuse them on every tick forever.
    case "$account" in main|-) continue ;; esac
    jq -e --arg account "$account" 'index($account) != null' <<<"$wanted" >/dev/null || continue
    case "$as_of" in ''|*[!0-9]*) as_of=0 ;; esac
    attempted=$(jq -r --arg account "$account" '.[$account] // 0' <<<"$attempts")
    case "$attempted" in ''|*[!0-9]*) attempted=0 ;; esac
    if [ "$best_attempt" -lt 0 ] || [ "$attempted" -lt "$best_attempt" ] ||
       { [ "$attempted" -eq "$best_attempt" ] && [ "$as_of" -lt "$best_as_of" ]; }; then
      best=$account
      best_attempt=$attempted
      best_as_of=$as_of
    fi
  done < <(account_rows "$vendor")
  printf '%s\n' "$best"
}

timeout_command() {
  if command -v gtimeout >/dev/null 2>&1; then command gtimeout "$@"
  elif command -v timeout >/dev/null 2>&1; then command timeout "$@"
  else perl -e 'alarm shift; exec @ARGV' "$@"
  fi
}

blocked_accounts_json() {
  stale_rows_json "$1" "$2" 1
}

# OpenCode is the inverted vendor. The other three refresh by reading a free usage endpoint; the Go
# plan publishes none, so its only probe is a real completion — free while the account is walled,
# since a 429 costs no quota and re-states the limit, and pure spend once it is not. So: dormant
# with no wall on record (every real call anyone makes records its own outcome, which is what keeps
# that state true for free), and polled only while a wall stands.
opencode_walls_json() {
  store_readable || return 1
  jq -c '[.vendors.opencode.accounts[]? | select(.walled == true) |
          {account, reset_at:([.windows[]? | select(.resets_at != null) |
                               (.resets_at | fromdateiso8601)] | min)}]' "$store" 2>/dev/null
}

opencode_probe() {
  local profile=$1
  [ "$profile" != '-' ] || profile=''
  OPENCODE_GO_PROFILE="$profile" "$opencode_go" wall-check 2>&1
}

opencode_next_interval() {
  local interval=$1 walls=$2 nearest
  nearest=$(jq -r --argjson now "$now" '
    [.[] | if (.reset_at | type) == "number" then (.reset_at - $now | floor) else 0 end] |
    min // empty' <<<"$walls")
  if [ -z "$nearest" ]; then
    ladder_loosen "$interval"
  elif [ "$nearest" -le "$OPENCODE_TIGHTEN_WITHIN_S" ]; then
    ladder_tighten "$interval"
  else
    ladder_loosen "$interval"
  fi
}

# Prints this vendor's journal fields plus the cadence it earned, as one JSON object.
opencode_tick() {
  local interval=$1 walls after tried='[]' notes='[]' profile probe rc
  local cleared=0 standing=0 dormant=0 detail
  if ! walls=$(opencode_walls_json) || [ -z "$walls" ]; then
    jq -cn --argjson interval "$interval" \
      '{step:0,tried:[],outcome:"error",interval:$interval,
        detail:"the collector states no OpenCode rows; the plan state is unknown"}'
    return 0
  fi
  if [ "$(jq 'length' <<<"$walls")" -eq 0 ]; then
    jq -cn --argjson interval "$(ladder_loosen "$interval")" \
      '{step:0,tried:[],outcome:"dormant",interval:$interval,
        detail:"no wall on record; a probe would spend the plan to be told what it already says"}'
    return 0
  fi
  while IFS= read -r profile; do
    [ -n "$profile" ] || continue
    tried=$(jq -c --arg account "$profile" '. + [$account]' <<<"$tried")
    rc=0
    probe=$(opencode_probe "$profile") || rc=$?
    # Three answers, and only one of them retires a wall: a probe that SENT nothing (the wall was
    # gone before the request left) proves nothing about the plan, and counting it as a reopening
    # would report a leg as recovered on the strength of a request nobody made.
    if [ "$rc" -ne 0 ]; then
      probe=${probe:-"inconclusive — the probe exited $rc without answering"}
    else
      case "${probe%% *}" in
        walled) standing=$((standing + 1)) ;;
        served) cleared=$((cleared + 1)) ;;
        *) dormant=$((dormant + 1)) ;;
      esac
    fi
    notes=$(jq -c --arg note "$profile: ${probe%%$'\n'*}" '. + [$note]' <<<"$notes")
  done < <(jq -r '.[].account' <<<"$walls")
  detail=$(jq -r 'join("; ")' <<<"$notes")
  # What the probe changed is a raw record; only a collect turns it into the rows every surface
  # reads, so a wall this tick retired would otherwise keep standing on screen until the next one.
  if [ "$((cleared + standing))" -gt 0 ]; then
    "$collector" >/dev/null 2>&1 || true
  fi
  after=$(opencode_walls_json) || after=$walls
  [ -n "$after" ] || after=$walls
  jq -cn --argjson tried "$tried" --arg detail "$detail" \
    --argjson interval "$(opencode_next_interval "$interval" "$after")" \
    --arg outcome "$(if [ "$standing" -gt 0 ]; then printf walled
                     elif [ "$cleared" -gt 0 ]; then printf reopened
                     elif [ "$dormant" -gt 0 ]; then printf dormant
                     else printf error; fi)" \
    '{step:1,tried:$tried,outcome:$outcome,interval:$interval,detail:$detail}'
}

store_readable() {
  [ -r "$store" ] || return 1
  jq -e '.vendors' "$store" >/dev/null 2>&1
}

recorded_errors() {
  local vendor=$1 account=$2 since=$3
  [ -r "$store" ] || return 0
  jq -r --arg vendor "$vendor" --arg account "$account" --argjson since "$since" '
    .vendors[$vendor] // {} |
    [(.refresh_error // empty),
     (.accounts[]? | select(.account == $account) | .refresh_error // empty)][] |
    select((.cause | type) == "string") |
    select((.at | type) != "number" or .at >= $since) | .cause
  ' "$store" 2>/dev/null
}

is_pushback_detail() {
  grep -Eiq '(^|[^0-9])429([^0-9]|$)|rate[- ]?limit|too many requests|resource[_ -]?exhausted|quota[^[:cntrl:]]*exceed'
}

journal_has_pushback_since() {
  local vendor=$1 since=$2
  [ -r "$journal_file" ] || return 1
  jq -eR --arg vendor "$vendor" --argjson since "$since" '
    fromjson? | select(.vendor == $vendor and .outcome == "pushback" and
      ((.ts | type) == "number") and .ts > $since)' "$journal_file" >/dev/null 2>&1
}

journal_attempt() {
  local vendor=$1 step=$2 accounts=$3 outcome=$4 detail=$5 interval=$6
  mkdir -p "$(dirname "$journal_file")"
  jq -cn --argjson ts "$now" --arg vendor "$vendor" --argjson step "$step" \
    --argjson accounts "$accounts" --arg outcome "$outcome" --arg detail "$detail" \
    --argjson interval "$interval" \
    '{ts:$ts,vendor:$vendor,step:$step,accounts_tried:$accounts,outcome:$outcome,
      detail:$detail,interval_min:$interval}' >>"$journal_file"
}

# Read and normalize the on-disk tick state. Also used mid-tick: a revive hands the lock back,
# so whatever another tick wrote while we were out is the state we must continue from.
state_read() {
  local raw='{}'
  if [ -r "$state_file" ]; then
    raw=$(jq -c 'select(type == "object")' "$state_file" 2>/dev/null || true)
    [ -n "$raw" ] || raw='{}'
  fi
  normalized_state "$raw"
}

state_persist() {
  local payload=$1 tmp
  tmp=$(mktemp "${state_file}.tmp.XXXXXX") || return 1
  tick_tmp=$tmp
  if ! printf '%s\n' "$payload" >"$tmp" || ! jq -e '
    .claude and .codex and .gemini and .opencode and
    all(.[]; type == "object")' "$tmp" >/dev/null; then
    rm -f "$tmp"
    tick_tmp=''
    return 1
  fi
  mv -f "$tmp" "$state_file"
  tick_tmp=''
}

# claudeb reserves both names, and account_rows invents a `main` row for a store with no
# accounts array: revive can never take them, so for Claude they are unrefreshable rather
# than work the tick keeps failing to do. Other vendors own a real `main` account.
reserved_accounts() {
  jq -c '[.[] | select(. == "main" or . == "-")]' <<<"$1"
}

drop_reserved() {
  jq -c '[.[] | select(. != "main" and . != "-")]' <<<"$1"
}

run_tick() {
  local state due='[]' vendor interval last clean passive_rc=0
  local stale tried outcome detail step target_rc errors post_stale refreshed_count claude_note
  local pushback next_interval new_clean lock_dir state_tmp refresh_log rc account blocked
  local opencode_result lock_lost=0 reserved='[]'

  command -v jq >/dev/null 2>&1 || { echo 'llm-refresh: jq is required' >&2; return 3; }
  [ -x "$collector" ] || { echo "llm-refresh: collector is not executable: $collector" >&2; return 3; }
  case "$now" in ''|*[!0-9]*) echo 'llm-refresh: LLM_REFRESH_NOW must be an epoch' >&2; return 2 ;; esac

  mkdir -p "$(dirname "$state_file")"
  lock_dir="${state_file}.lock"
  refresh_lock_acquire "$lock_dir" || return 0

  state=$(state_read)

  for vendor in claude codex gemini opencode; do
    interval=$(jq -r --arg vendor "$vendor" '.[$vendor].interval_min' <<<"$state")
    last=$(jq -r --arg vendor "$vendor" '.[$vendor].last_attempt_epoch' <<<"$state")
    if cadence_due "$interval" "$last" "$now"; then
      due=$(jq -c --arg vendor "$vendor" '. + [$vendor]' <<<"$due")
    fi
  done

  if [ "$(jq 'length' <<<"$due")" -gt 0 ]; then
    "$collector" >/dev/null 2>&1 || passive_rc=$?
  fi

  while IFS= read -r vendor; do
    interval=$(jq -r --arg vendor "$vendor" '.[$vendor].interval_min' <<<"$state")
    clean=$(jq -r --arg vendor "$vendor" '.[$vendor].clean_since_epoch' <<<"$state")
    if [ "$vendor" = opencode ]; then
      # No clean window here: this vendor's cadence is read off the stated reset, not off a quiet
      # stretch, so the field the other three walk is left where it stands.
      # The probe is a real completion against a gateway that can be slow or wedged, and every other
      # vendor's next tick queues behind this lock; nothing the probe touches is shared, so the lock
      # is handed back for its duration. Losing the re-acquire costs this tick its state write —
      # the journal line is an append and lands either way — and the next heartbeat repeats it.
      refresh_lock_release
      opencode_result=$(opencode_tick "$interval") || return 5
      refresh_lock_acquire "$lock_dir" || lock_lost=1
      next_interval=$(jq -r '.interval' <<<"$opencode_result")
      state=$(jq -c --arg vendor "$vendor" --argjson interval "$next_interval" \
        --argjson now "$now" \
        '.[$vendor].interval_min=$interval | .[$vendor].last_attempt_epoch=$now' <<<"$state")
      journal_attempt "$vendor" "$(jq -r '.step' <<<"$opencode_result")" \
        "$(jq -c '.tried' <<<"$opencode_result")" "$(jq -r '.outcome' <<<"$opencode_result")" \
        "$(jq -r '.detail' <<<"$opencode_result")" "$next_interval" || return 5
      [ "$lock_lost" -eq 0 ] || return 0
      continue
    fi
    stale=$(stale_accounts_json "$vendor" "$interval")
    blocked=$(blocked_accounts_json "$vendor" "$interval")
    reserved='[]'
    if [ "$vendor" = claude ]; then
      reserved=$(reserved_accounts "$stale")
      stale=$(drop_reserved "$stale")
    fi
    tried='[]'
    outcome=fresh-passive
    detail='passive collect made all accounts fresh'
    step=0
    pushback=0
    target_rc=0
    claude_note=''

    if [ "$(jq 'length' <<<"$stale")" -gt 0 ]; then
      if [ "$vendor" = claude ]; then
        # Claude rotates only through a real interactive session (docs/EXIT-PLAN.md
        # § Token-freeze experiment), so a heartbeat tick opens exactly one — the
        # account that waited longest for its turn — and the rest wait for the next tick.
        account=$(next_revive_account "$vendor" "$stale" \
          "$(jq -c --arg vendor "$vendor" '.[$vendor].attempts' <<<"$state")")
        if [ ! -x "$claudeb_bin" ]; then
          claude_note="no claudeb to revive with: $claudeb_bin"
        elif [ -z "$account" ]; then
          claude_note='no stale Claude account could be selected'
        else
          step=1
          tried=$(jq -c --arg account "$account" '. + [$account]' <<<"$tried")
          # Every attempt stamps, success or not — that is what rotates the selection.
          state=$(jq -c --arg vendor "$vendor" --arg account "$account" --argjson now "$now" \
            --argjson known "$(account_names_json "$vendor")" \
            '.[$vendor].attempts = ((.[$vendor].attempts | with_entries(select(.key | IN($known[]))))
                                    + {($account): $now})' <<<"$state")
          refresh_log=$(mktemp "${TMPDIR:-/tmp}/llm-refresh.XXXXXX") || return 5
          tick_tmp=$refresh_log
          rc=0
          # An interactive session runs for minutes; holding the tick lock across it would park
          # every other vendor's refresh behind it, so it is handed back like the opencode probe.
          # The stamp must reach the FILE before the lock goes: a tick that starts while this
          # session runs picks its account from what is on disk, and would otherwise open a
          # second interactive session on the same account.
          state_persist "$state" || return 5
          refresh_lock_release
          ( export LLM_LIMITS_ANNOUNCE_SUPPRESS=1
            timeout_command "$revive_timeout" "$claudeb_bin" revive "$account" ) \
            >/dev/null 2>"$refresh_log" || rc=$?
          if refresh_lock_acquire "$lock_dir"; then
            # Whatever ran while we were out owns the file now; our own stamp is already in it.
            state=$(state_read)
          else
            lock_lost=1
          fi
          # revive writes the claudeb snapshot; only a collect folds it into the merged
          # store the post-state below is read from — and it replaces revive's own announce.
          "$collector" >/dev/null 2>&1 || true
          errors=$(recorded_errors "$vendor" "$account" "$now")
          blocked=$(blocked_accounts_json "$vendor" "$interval")
          if [ "$rc" -eq 4 ]; then
            claude_note="$account needs a human login; no automated path can refresh it"
          elif [ "$rc" -ne 0 ] && { cat "$refresh_log"; printf '%s\n' "$errors"; } | is_pushback_detail; then
            pushback=1
          fi
          [ "$rc" -eq 0 ] || target_rc=$rc
          rm -f "$refresh_log"
          tick_tmp=''
        fi
      else
        while IFS= read -r account; do
          step=1
          tried=$(jq -c --arg account "$account" '. + [$account]' <<<"$tried")
          refresh_log=$(mktemp "${TMPDIR:-/tmp}/llm-refresh.XXXXXX") || return 5
          tick_tmp=$refresh_log
          rc=0
          "$collector" --refresh-account "$vendor/$account" >/dev/null 2>"$refresh_log" || rc=$?
          errors=$(recorded_errors "$vendor" "$account" "$now")
          if { cat "$refresh_log"; printf '%s\n' "$errors"; } | is_pushback_detail; then
            pushback=1
          fi
          if [ "$rc" -ne 0 ]; then target_rc=$rc; fi
          rm -f "$refresh_log"
          tick_tmp=''
        done < <(jq -r '.[]' <<<"$stale")
      fi

      post_stale=$(stale_accounts_json "$vendor" "$interval")
      [ "$vendor" != claude ] || post_stale=$(drop_reserved "$post_stale")
      refreshed_count=$(jq -n --argjson before "$stale" --argjson after "$post_stale" \
        '$before - $after | length')
      if [ -n "$claude_note" ]; then
        # A login-needed account leaves the stale list by becoming unrefreshable, which the
        # count below would otherwise read as a refresh.
        outcome=error
        detail="$claude_note"
      elif [ "$pushback" -eq 1 ]; then
        outcome=pushback
        detail='refresh path reported a 429 or rate-limit signal'
      elif [ "$(jq 'length' <<<"$post_stale")" -eq 0 ]; then
        outcome=refreshed
        detail='all stale accounts refreshed'
      elif [ "$refreshed_count" -gt 0 ]; then
        outcome=partial
        detail="$refreshed_count account(s) refreshed; still stale: $(jq -r 'join(",")' <<<"$post_stale")"
      else
        outcome=error
        if [ "$target_rc" -ne 0 ]; then
          detail="refresh path exited $target_rc; accounts remain stale"
        else
          detail='refresh path completed but accounts remain stale'
        fi
      fi
      if [ "$vendor" = claude ] && [ -z "$claude_note" ] && [ "$(jq 'length' <<<"$post_stale")" -gt 0 ]; then
        detail="$detail; one session per tick, the rest wait for the next tick"
      fi
    elif [ "$passive_rc" -ne 0 ]; then
      if store_readable; then
        detail="accounts are fresh despite passive collector exit $passive_rc"
      else
        # No rows because the store is unreadable is "no data", never "all fresh".
        outcome=error
        detail="passive collector exited $passive_rc and the store is missing or unparseable: $store"
      fi
    fi

    blocked=$(jq -c --argjson reserved "$reserved" '. + $reserved | unique' <<<"$blocked")
    if [ "$(jq 'length' <<<"$blocked")" -gt 0 ]; then
      detail="${detail:+$detail; }unrefreshable: $(jq -r 'join(",")' <<<"$blocked")"
    fi

    next_interval=$interval
    new_clean=$clean
    if [ "$outcome" = pushback ]; then
      next_interval=$(ladder_loosen "$interval")
      new_clean=$now
    elif [ "$passive_rc" -eq 0 ] && clean_window_elapsed "$clean" "$now" &&
         ! journal_has_pushback_since "$vendor" "$clean"; then
      next_interval=$(ladder_tighten "$interval")
      new_clean=$now
    fi

    state=$(jq -c --arg vendor "$vendor" --argjson interval "$next_interval" \
      --argjson now "$now" --argjson clean "$new_clean" \
      '.[$vendor].interval_min=$interval |
       .[$vendor].last_attempt_epoch=$now |
       .[$vendor].clean_since_epoch=$clean' <<<"$state")
    journal_attempt "$vendor" "$step" "$tried" "$outcome" "$detail" "$next_interval" || return 5
    # Without the lock the next vendor's refresh would race whoever owns it now.
    [ "$lock_lost" -eq 0 ] || return 0
  done < <(jq -r '.[]' <<<"$due")

  [ "$lock_lost" -eq 0 ] || return 0
  state_persist "$state" || return 5
  if [ -r "$journal_file" ] && [ "$(wc -l <"$journal_file")" -gt 4000 ]; then
    state_tmp=$(mktemp "${journal_file}.tmp.XXXXXX") || return 5
    tick_tmp=$state_tmp
    if ! { tail -n 2000 "$journal_file" >"$state_tmp" && mv -f "$state_tmp" "$journal_file"; }; then
      rm -f "$state_tmp"
    fi
    tick_tmp=''
  fi
  refresh_lock_release
}

install_agent() {
  local wrapper_tmp
  mkdir -p "$(dirname "$wrapper")" "$(dirname "$agent_plist")"
  wrapper_tmp=$(mktemp "${wrapper}.tmp.XXXXXX") || return 1
  printf '#!/usr/bin/env bash\nexec %q "$@"\n' "$script_path" >"$wrapper_tmp"
  chmod 755 "$wrapper_tmp"
  mv -f "$wrapper_tmp" "$wrapper"
  cp "$repo_root/launchd/com.llm-refresh.plist" "$agent_plist"
  launchctl bootout "gui/$UID" "$agent_plist" >/dev/null 2>&1 || true
  if ! launchctl bootstrap "gui/$UID" "$agent_plist"; then
    launchctl load -w "$agent_plist"
  fi
  printf 'Installed %s with a 300-second heartbeat.\n' "$label"
}

uninstall_agent() {
  launchctl bootout "gui/$UID" "$agent_plist" >/dev/null 2>&1 || \
    launchctl unload -w "$agent_plist" >/dev/null 2>&1 || true
  rm -f "$agent_plist"
  if [ -f "$wrapper" ] && grep -qF "exec $script_path" "$wrapper"; then
    rm -f "$wrapper"
  fi
  printf 'Uninstalled %s.\n' "$label"
}

usage() {
  printf 'usage: llm-refresh [run|install-agent|uninstall-agent]\n' >&2
  exit 2
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  case "${1:-run}" in
    run)
      [ "$#" -le 1 ] || usage
      trap 'exit 129' HUP INT TERM
      trap '[ -z "$tick_tmp" ] || rm -f "$tick_tmp"; refresh_lock_release' EXIT
      run_tick
      ;;
    install-agent) [ "$#" -eq 1 ] || usage; install_agent ;;
    uninstall-agent) [ "$#" -eq 1 ] || usage; uninstall_agent ;;
    *) usage ;;
  esac
fi

def local_day(t):
    return time.strftime("%Y-%m-%d", time.localtime(t))


def day_start(day):
    return time.mktime(time.strptime(day, "%Y-%m-%d"))


def day_end(day):
    return day_start(local_day(day_start(day) + 30 * 3600))


def short_path(path):
    path = str(path)
    for prefix, repl in ((os.path.join(base_home(), ""), "~/"), (os.path.join(os.path.realpath(base_home()), ""), "~/"),
                         ("/Volumes/Work/Projects/", "")):
        if path.startswith(prefix):
            return repl + path[len(prefix):]
    return path


def read_json(path, default):
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return default


def write_json(path, value):
    tmp = "%s.tmp.%d" % (path, os.getpid())
    with open(tmp, "w") as handle:
        handle.write(json.dumps(value, separators=(",", ":")))
    os.replace(tmp, path)


def iso_epoch(text):
    if not isinstance(text, str) or len(text) < 19:
        return None
    try:
        if text[4] + text[7] + text[10] + text[13] + text[16] != "--T::":
            raise ValueError(text)
        base = calendar.timegm((int(text[:4]), int(text[5:7]), int(text[8:10]), int(text[11:13]),
                                int(text[14:16]), int(text[17:19]), 0, 0, 0))
    except ValueError:
        return None
    digits = re.match(r"\.(\d+)", text[19:])
    return base + (float("0." + digits.group(1)) if digits else 0.0)


_toplevels = {}


def repo_top(cwd):
    if not cwd:
        return ""
    cwd = cwd.split("/.claude/worktrees/")[0].rstrip("/") or "/"
    if cwd in _toplevels:
        return _toplevels[cwd]
    probe, top = cwd, ""
    while probe and probe != "/":
        if os.path.exists(os.path.join(probe, ".git")):
            top = probe
            break
        probe = os.path.dirname(probe)
    _toplevels[cwd] = top or cwd
    return _toplevels[cwd]


def project_of(top):
    if not top or top == "/":
        return "/"
    if top.rstrip("/") == base_home().rstrip("/"):
        return "~"
    if top.startswith(("/private/tmp/", "/tmp/", "/private/var/")):
        return "tmp"
    return os.path.basename(top.rstrip("/"))


def trivial_bash(command):
    command = QUIET_REDIRECT.sub(" ", (command or "").strip())
    if not command or len(command) > 300 or TRIVIAL_BREAK.search(command):
        return False
    for segment in command.split("|"):
        words = segment.split()
        if not words or words[0] not in TRIVIAL_WORDS:
            return False
        if words[0] == "grep" and TRIVIAL_RECURSIVE.search(segment):
            return False
        if words[0] == "sed" and re.search(r"(^|\s)-i", segment):
            return False
    return True


def fmt_s(value):
    if value is None:
        return "–"
    if value < 10:
        return "%.1f s" % value
    if value < 600:
        return "%.0f s" % value
    return fmt_dur(value)


def fmt_dur(secs):
    secs = int(round(secs or 0))
    if secs < 60:
        return "%ds" % secs
    if secs < 3600:
        return "%dm %02ds" % (secs // 60, secs % 60)
    return "%dh %02dm" % (secs // 3600, secs % 3600 // 60)


def fmt_pct(share):
    if share is None:
        return "–"
    if 0 < share < 0.01:
        return "%.1f %%" % (share * 100)
    return "%.0f %%" % (share * 100)


def fmt_count(n):
    return "{:,}".format(int(n)).replace(",", " ")


def fmt_bytes(n):
    if n is None:
        return "–"
    for unit, size in (("GB", 1 << 30), ("MB", 1 << 20), ("KB", 1 << 10)):
        if n >= size:
            return "%.1f %s" % (n / size, unit)
    return "%d B" % n


def median(values):
    return statistics.median(values) if values else None


def percentile(values, q):
    if not values:
        return None
    ordered = sorted(values)
    return ordered[min(len(ordered) - 1, int(q * (len(ordered) - 1) + 0.5))]


# ---------------------------------------------------------------- transcripts


def transcript_files():
    root = projects_dir()
    return glob.glob(os.path.join(root, "*", "*.jsonl")) + glob.glob(
        os.path.join(root, "*", "*", "subagents", "*.jsonl"))


def head_hash(path):
    try:
        with open(path, "rb") as handle:
            return hashlib.sha1(handle.read(512)).hexdigest()[:12]
    except OSError:
        return ""


def scan_transcripts(state, now, events, versions):
    files = state.setdefault("files", {})
    first = not files
    horizon = now - BACKFILL_DAYS * 86400
    seen = set()
    boots = c1_boots(state)
    for path in transcript_files():
        seen.add(path)
        try:
            st = os.stat(path)
        except OSError:
            continue
        rec = files.get(path)
        if rec and rec["size"] == st.st_size and rec["mtime"] == st.st_mtime_ns:
            continue
        if not rec and st.st_mtime < (horizon if first else now - 2 * 86400):
            files[path] = {"size": st.st_size, "mtime": st.st_mtime_ns, "head": head_hash(path),
                           "off": st.st_size}
            continue
        head = head_hash(path)
        if not rec or rec.get("head") != head or st.st_size < rec.get("off", 0):
            rec = {"off": 0}
        rec.update(size=st.st_size, mtime=st.st_mtime_ns, head=head)
        files[path] = rec
        read_transcript(path, rec, events, versions, boots)
    for path in list(files):
        if path not in seen:
            del files[path]
        elif files[path].get("c1", {}).get("wait"):
            c1_expire(files[path]["c1"], events, now)


def read_transcript(path, rec, events, versions, boots=(), limit=-1):
    try:
        with open(path, "rb") as handle:
            handle.seek(rec["off"])
            data = handle.read(limit)
    except OSError:
        return
    end = data.rfind(b"\n") + 1
    if end == 0:
        return
    pos = rec["off"]
    rec["off"] += end
    pend = rec.setdefault("pend", {})
    last_t = 0.0
    subagent = os.sep + "subagents" + os.sep in path
    session = os.path.basename(os.path.dirname(os.path.dirname(path)) if subagent else path[:-6])[:8]
    for line in data[:end].split(b"\n"):
        at = pos
        pos += len(line) + 1
        owner = not subagent and rec.get("entry", OWNER_ENTRIES[0]) in OWNER_ENTRIES
        if not line or not (b'"tool_use' in line or b'"tool_result"' in line or b'"hook_' in line
                            or b'"permissionMode"' in line or owner and any(b in line for b in C1_BYTES)):
            continue
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if not isinstance(entry, dict):
            continue
        if entry.get("permissionMode"):
            rec["mode"] = entry["permissionMode"]
        if entry.get("entrypoint"):
            rec["entry"] = entry["entrypoint"]
        if entry.get("cwd"):
            rec["top"] = repo_top(entry["cwd"])
        t = iso_epoch(entry.get("timestamp"))
        if t is None:
            continue
        last_t = max(last_t, t)
        version = entry.get("version")
        if isinstance(version, str) and version and (version not in versions or t < versions[version]):
            versions[version] = t
        if not subagent and rec.get("entry") in OWNER_ENTRIES:
            c1_entry(rec.setdefault("c1", c1_new()), events, entry, t, session, boots)
            c1_add(rec.setdefault("act", []), t, t + IDLE_GAP_S)
        project = project_of(rec.get("top", ""))
        attachment = entry.get("attachment")
        if isinstance(attachment, dict):
            hook_event(attachment, t, project, events)
            continue
        message = entry.get("message")
        content = message.get("content") if isinstance(message, dict) else None
        if not isinstance(content, list):
            continue
        for block in content:
            if not isinstance(block, dict):
                continue
            if block.get("type") == "tool_use" and block.get("id"):
                name = str(block.get("name") or "")
                command = (block.get("input") or {}).get("command") if name == "Bash" else None
                pend[block["id"]] = [t, name, 1 if trivial_bash(command) else 0, None if subagent else at // 1024]
                media = MEDIA_TOOL.search(str(command or ""))
                if media:
                    pend[block["id"]].append(media.group(1))
            elif block.get("type") == "tool_result" and block.get("tool_use_id") in pend:
                start, name, trivial, kb, phase = (pend.pop(block["tool_use_id"]) + [None, None])[:5]
                who = session_kind(rec)
                if "act" in rec:
                    c1_add(rec["act"], start, t)
                if phase:
                    events.append(["g", round(start, 3), session, round(t, 3), block["tool_use_id"][-10:], phase])
                events.append(["c", round(start, 3), project, name, trivial, round(max(0.0, t - start), 3),
                               who, block["tool_use_id"][-10:], session, kb])
    for key in [k for k, v in pend.items() if v[0] < last_t - PENDING_TTL_S]:
        del pend[key]
    if "c1" in rec:
        c1_prune(rec["c1"], last_t)
    if "act" in rec:
        rec["act"] = [seg for seg in rec["act"] if seg[1] >= last_t - ACTIVE_KEEP_S]


def session_kind(rec):
    if rec.get("entry") == "sdk-cli":
        return "w"
    return "c" if rec.get("mode") == "bypassPermissions" else "h"


def hook_event(attachment, t, project, events):
    kind = attachment.get("type")
    if kind not in ("hook_cancelled", "hook_success"):
        return
    event = str(attachment.get("hookEvent") or "")
    name = str(attachment.get("hookName") or "")
    tool = name.split(":", 1)[1] if ":" in name and event in ("PreToolUse", "PostToolUse") else ""
    tid = str(attachment.get("toolUseID") or "")[-10:]
    command = str(attachment.get("command") or "")
    try:
        ms = int(float(attachment.get("durationMs") or 0))
    except (TypeError, ValueError):
        ms = 0
    if kind == "hook_cancelled":
        try:
            timeout = int(float(attachment.get("timeoutMs") or 0))
        except (TypeError, ValueError):
            timeout = 0
        events.append(["x", round(t, 3), project, event, command, ms, timeout, tool, tid])
    elif ms > 0:
        events.append(["h", round(t, 3), project, event, command, ms, tool, tid])


# ---------------------------------------------------------------- owner turns and delegations (C1)


def c1_boots(state):
    """The dark slices of a turn as sorted `[start, end]`: a boot is `[b, b]` and darkens the whole line gap
    around it, a sleep its own span. HARNESS_DOCTOR_BOOTS (comma list, may be empty) and HARNESS_DOCTOR_SLEEPS
    (`start-end` comma list) replace kern.boottime and kern.sleeptime/kern.waketime, which hold only the last
    sleep, so a run every few minutes keeps the history."""
    fixed = os.environ.get("HARNESS_DOCTOR_BOOTS")
    if fixed is not None:
        sleeps = [[float(x) for x in pair.split("-")] for pair in os.environ.get("HARNESS_DOCTOR_SLEEPS", "").split(",")
                  if pair.strip()]
        return sorted([[float(b), float(b)] for b in fixed.split(",") if b.strip()] + sleeps)
    boots, sleeps = state.setdefault("boots", []), state.setdefault("sleeps", [])
    found = [re.search(r"sec = (\d+)", text) for text in sysctl("kern.boottime", "kern.sleeptime", "kern.waketime")]
    boot, slept, woke = (float(f.group(1)) if f else 0.0 for f in found)
    if boot and boot not in boots:
        boots.append(boot)
        del boots[:-C1_BOOTS_KEPT]
    if 0 < slept < woke and [slept, woke] not in sleeps:
        sleeps.append([slept, woke])
        del sleeps[:-C1_BOOTS_KEPT]
    return sorted([[b, b] for b in boots] + sleeps)


def c1_new():
    return {"own": None, "turn": None, "end": 0.0, "prev": 0.0, "typed": [], "q": [], "wait": [], "bg": {},
            "task": {}, "dn": {}}


def c1_text(content):
    if isinstance(content, str):
        return content
    for block in content if isinstance(content, list) else ():
        if isinstance(block, dict) and block.get("type") == "text":
            return str(block.get("text") or "")
    return ""


def c1_meta(value):
    if isinstance(value, dict):
        return value
    try:
        found = ast.literal_eval(value) if isinstance(value, str) else None
    except (ValueError, SyntaxError):
        found = None
    return found if isinstance(found, dict) else {}


def c1_emit(c, out, row, reaction):
    delay = None if reaction is None else max(0.0, reaction - row[3])
    row[5] = [int(delay is not None and delay <= r) for r in C1_R_S]
    if c["own"] is not False:
        out.append(row)


def c1_settle(c, out, at):
    for row in c["wait"]:
        c1_emit(c, out, row, at)
    c["wait"] = []


def c1_expire(c, out, now):
    late = [row for row in c["wait"] if now - row[3] > C1_R_S[-1]]
    for row in late:
        c1_emit(c, out, row, None)
    c["wait"] = [row for row in c["wait"] if row not in late]


def c1_typed(c, out, t):
    (c["turn"]["ty"] if c["turn"] else c["typed"]).append(round(t, 3))
    c1_settle(c, out, t)


def c1_open(c, out, t, origin, session):
    c["turn"] = {"s": max(t, c["end"]), "o": origin, "ty": c["typed"], "iv": {k: [] for k in C1_LAYERS},
                 "open": {}, "rq": {}, "dl": [], "calls": []}
    c["typed"] = []


def c1_add(segs, a, b):
    if b <= a:
        return
    if segs and a <= segs[-1][1] and b >= segs[-1][0]:
        segs[-1] = [min(segs[-1][0], a), max(segs[-1][1], b)]
    else:
        segs.append([a, b])


def c1_merge(segs, start, end):
    clipped = ((max(a, start), min(b, end)) for a, b in segs)
    return merge_windows((a, b) for a, b in clipped if a < b)


def c1_inside(segs, x):
    i = bisect.bisect_right(segs, [x, float("inf")]) - 1
    return i >= 0 and segs[i][0] <= x < segs[i][1]


def c1_close(c, out, end, session):
    turn, c["turn"] = c["turn"], None
    start = turn["s"]
    end = max(end, start)
    c["end"] = end
    layers = [(k, c1_merge(turn["iv"][k], start, end)) for k in C1_LAYERS]
    points = sorted({start, end} | {x for _, segs in layers for seg in segs for x in seg})
    part = {}
    for a, b in zip(points, points[1:]):
        key = next((k for k, segs in layers if c1_inside(segs, (a + b) / 2)), "resid")
        part[key] = part.get(key, 0.0) + b - a
    use = {}
    for key, n_out, think, cw, cr in turn["rq"].values():
        sums = use.setdefault(key, [0, 0, 0, 0, 0])
        for i, v in enumerate((1, n_out, think, cw, cr)):
            sums[i] += v
    holes = c1_merge(turn["iv"]["dark"] + turn["iv"]["ask"], start, end)
    c["wait"].append(["t", round(start, 3), session, round(end, 3), turn["o"], None, 0, turn["ty"],
                      [[round(a, 3), round(b, 3)] for a, b in holes],
                      {k: round(v, 1) for k, v in part.items() if v >= 0.05}, use, turn.get("calls", [])])
    for launch, what, notified, tid, opened in turn["dl"]:
        c["wait"].append(["d", round(launch, 3), session, round(end, 3), what, None, 0, round(notified, 3),
                          tid[-10:], opened])


def c1_note(c, ids, t):
    found = []
    for ident in ids:
        tid = ident if ident in c["bg"] or ident in c["dn"] else c["task"].get(ident)
        if tid in c["bg"]:
            launch, what = c["bg"].pop(tid)[:2]
            c["dn"][tid] = [launch, what, t]
        if tid in c["dn"] and tid not in found:
            found.append(tid)
    return found


def c1_take(c, tids, opened):
    if c["turn"]:
        c["turn"]["dl"] += [c["dn"].pop(tid) + [tid, opened] for tid in tids if tid in c["dn"]]


def c1_entry(c, out, entry, t, session, boots):
    kind = entry.get("type")
    c1_expire(c, out, t)
    turn = c["turn"]
    if turn and boots and c["prev"]:
        i = max(bisect.bisect_right(boots, [c["prev"], float("inf")]) - 1, 0)
        while i < len(boots) and boots[i][0] < t:
            start, end = boots[i]
            if start == end and start > c["prev"]:
                c1_add(turn["iv"]["dark"], c["prev"], t)
            elif end > c["prev"] and start < end:
                c1_add(turn["iv"]["dark"], max(start, c["prev"]), min(end, t))
            i += 1
    if kind == "queue-operation":
        text = str(entry.get("content") or "")
        if entry.get("operation") == "enqueue":
            if text.startswith("<task-notification"):
                c1_note(c, [v for _, v in C1_NOTE_IDS.findall(text)], t)
            elif not text.startswith("<cross-session-message"):
                c["q"] = (c["q"] + [t])[-C1_QUEUE_KEPT:]
                c1_typed(c, out, t)
        return
    if kind == "system" and entry.get("subtype") == "away_summary":
        for row in c["wait"]:
            row[6] = 1
        return
    message = entry.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    if kind == "attachment":
        attachment = entry.get("attachment") or {}
        if attachment.get("type") != "queued_command":
            return
        c["prev"] = t
        origin = c1_meta(attachment.get("origin")).get("kind")
        if origin == "human":
            if c["q"]:
                c["q"].pop(0)
                c1_settle(c, out, t)
            else:
                c1_typed(c, out, iso_epoch(attachment.get("timestamp")) or t)
        elif origin == "task-notification":
            c1_take(c, c1_note(c, [v for _, v in C1_NOTE_IDS.findall(str(attachment.get("prompt") or ""))], t), 0)
        return
    prev, c["prev"] = c["prev"], t
    if kind == "assistant":
        if not turn:
            return
        c1_add(turn["iv"]["gen"], prev or t, t)
        usage = message.get("usage") or {}
        if entry.get("requestId"):
            turn["rq"][entry["requestId"]] = [
                "%s/%s" % (message.get("model") or "?", entry.get("effort") or "?"),
                int(usage.get("output_tokens") or 0),
                int((usage.get("output_tokens_details") or {}).get("thinking_tokens") or 0),
                int(usage.get("cache_creation_input_tokens") or 0), int(usage.get("cache_read_input_tokens") or 0)]
        for block in content if isinstance(content, list) else ():
            if isinstance(block, dict) and block.get("type") == "tool_use" and block.get("id"):
                name, args = str(block.get("name") or ""), block.get("input") or {}
                command = str(args.get("command") or "") if name == "Bash" else ""
                layer = "ask" if name in C1_ASK else "test" if C1_SUITE.search(command) else "media" if (
                    MEDIA_TOOL.search(command)) else "tool"
                what = name + (":" + str(args["subagent_type"]) if args.get("subagent_type") else ":media" if layer == "media" else "")
                turn["open"][block["id"]] = [t, layer, what]
        return
    if kind == "system":
        sub = entry.get("subtype")
        if sub == "turn_duration" and turn:
            c1_close(c, out, t, session)
        elif sub == "stop_hook_summary" and turn:
            ms = max([float(h.get("durationMs") or 0) for h in entry.get("hookInfos") or () if isinstance(h, dict)]
                     or [0.0])
            c1_add(turn["iv"]["stop"], t - ms / 1000.0, t)
        elif sub == "compact_boundary" and turn:
            ms = float(c1_meta(entry.get("compactMetadata")).get("durationMs") or 0)
            c1_add(turn["iv"]["compact"], t - ms / 1000.0, t)
        return
    if kind != "user":
        return
    results = [b for b in content if isinstance(b, dict) and b.get("type") == "tool_result"] \
        if isinstance(content, list) else []
    if results:
        for block in results:
            tid = block.get("tool_use_id")
            started = turn and turn["open"].pop(tid, None)
            if not started:
                continue
            c1_add(turn["iv"][started[1]], started[0], t)
            if started[1] != "ask":
                turn.setdefault("calls", []).append([tid[-10:], started[1]])
            if started[1] == "ask":
                c1_typed(c, out, t)
            result = entry.get("toolUseResult")
            if isinstance(result, dict) and (result.get("backgroundTaskId") or result.get("isAsync")):
                c["bg"][tid] = [started[0], started[2]]
                task = result.get("backgroundTaskId") or result.get("agentId")
                if task:
                    c["task"][str(task)] = tid
        return
    text = c1_text(content)
    origin = (entry.get("origin") or {}).get("kind") if isinstance(entry.get("origin"), dict) else None
    source = entry.get("promptSource")
    if text.startswith("[Request interrupted"):
        if turn:
            c1_typed(c, out, t)
            c1_close(c, out, t, session)
            c1_settle(c, out, t)
        return
    prompt = origin == "human" or source in ("typed", "queued")
    if not prompt and origin not in ("task-notification", "peer"):
        return
    if turn:
        c1_close(c, out, prev or t, session)
    if prompt:
        if c["own"] is None:
            c["own"] = not text.lstrip().startswith(C1_MACHINE)
        if source == "queued" and c["q"]:
            c["q"].pop(0)
            c1_settle(c, out, t)
        else:
            c1_typed(c, out, t)
        c1_open(c, out, t, "h", session)
    else:
        tids = c1_note(c, [v for _, v in C1_NOTE_IDS.findall(text)], t)
        c1_open(c, out, t, "n" if origin == "task-notification" else "p", session)
        c1_take(c, tids, 1)


def owner_spans(rows, r_index):
    """`(spans, extra)` as `(start, end, row)` at C1_R_S[r_index] (an index, or a function of the row giving
    one), docs/speed-doctor-design.md §1: spans the
    attended turns, each clipped after his last prompt in another chat and holed; extra the attended
    delegations, each from max(launch, his last prompt anywhere) to its notification, counted only when the
    notification opened its follow-up turn."""
    typed = sorted((x, row[2]) for row in rows if row[0] == "t" for x in row[7])
    times = [x for x, _ in typed]
    spans, extra = [], []
    for row in rows:
        if row[0] not in ("t", "d") or not row[5][r_index(row) if callable(r_index) else r_index] or row[6]:
            continue
        if row[0] == "d":
            if not row[9]:
                continue
            i = bisect.bisect_left(times, row[7]) - 1
            extra.append((max(row[1], times[i]) if i >= 0 else row[1], row[7], row))
            continue
        cursor, i = row[1], bisect.bisect_left(times, row[3]) - 1
        while i >= 0 and times[i] > row[1]:
            if typed[i][1] != row[2]:
                cursor = times[i]
                break
            i -= 1
        for a, b in row[8] + [[row[3], row[3]]]:
            if b > cursor:
                if min(a, row[3]) > cursor:
                    spans.append((cursor, min(a, row[3]), row))
                cursor = b
    return spans, extra


def owner_minutes(rows, r_index, lo, hi):
    """(A, B) in minutes inside (lo, hi): A the union of owner_spans' turns, B what its delegations add."""
    spans, extra = owner_spans(rows, r_index)
    inside = lambda items: [(max(a, lo), min(b, hi)) for a, b, _ in items if min(b, hi) > max(a, lo)]
    a_s = union_secs(inside(spans))
    return a_s / 60.0, (union_secs(inside(spans + extra)) - a_s) / 60.0


def c1_prune(c, now):
    c["bg"] = {k: v for k, v in c["bg"].items() if now - v[0] <= C1_BG_KEEP_S}
    c["dn"] = {k: v for k, v in c["dn"].items() if now - v[2] <= C1_BG_KEEP_S}
    c["task"] = {k: v for k, v in c["task"].items() if v in c["bg"] or v in c["dn"]}


# ---------------------------------------------------------------- event store


def events_path(day):
    return os.path.join(state_dir(), "events", day + ".jsonl")


def append_events(events):
    by_day = {}
    for event in events:
        by_day.setdefault(local_day(event[1]), []).append(event)
    os.makedirs(os.path.join(state_dir(), "events"), exist_ok=True)
    for day, rows in by_day.items():
        with open(events_path(day), "a") as handle:
            handle.write("".join(json.dumps(row, separators=(",", ":")) + "\n" for row in rows))


def load_events(days):
    out = []
    for day in days:
        try:
            with open(events_path(day)) as handle:
                for line in handle:
                    try:
                        out.append(json.loads(line))
                    except ValueError:
                        continue
        except OSError:
            continue
    return out


def day_list(now, count):
    days, t = [], now
    while len(days) < count:
        day = local_day(t)
        if day not in days:
            days.append(day)
        t -= 3600
    return days


def sample_value(sample, key):
    if key != "unseen":
        return sample.get(key)
    if sample.get("busy") is None or sample.get("visible") is None:
        return None
    return max(0.0, sample["busy"] * (sample.get("ncpu") or os.cpu_count() or 1) - sample["visible"])


def wait_hists(rows):
    cuts = [r for r in rows if r[0] == "x"]
    printed = [r for r in rows if r[0] == "h"]
    waits = {}
    for call in rows:
        key = wait_group(call) if call[0] == "c" else None
        if key:
            hist_put(waits.setdefault(key, hist_new()), call[5] * 1000.0)
    for event, _, _ in EVENT_ROWS:
        for _, secs, _ in event_waits(printed, cuts, event):
            hist_put(waits.setdefault("event:" + event, hist_new()), secs * 1000.0)
    return waits


def overlap_secs(windows, start, end):
    return sum(max(0, min(e, end) - max(s, start)) for s, e in windows)


def summarize_day(day, rows, samples, hooks, windows, floors=None):
    start, end = day_start(day), day_end(day)
    out = {"v": SUMMARY_V, "waits": wait_hists(rows), "slow_s": int(overlap_secs(windows, start, end))}
    if hooks:
        out["hooks"] = hooks
    if floors:
        out["floors"] = floors
    load = {}
    for key in LOAD_KEYS:
        value = mean([sample_value(x, key) for x in samples if start <= x.get("t", 0) < end])
        if value is not None:
            load[key] = round(value, 3)
    if load:
        out["load"] = load
    return out


def day_summaries(state, now, write, samples, windows, today_rows):
    """A day is summarized once, when it ends; bumping SUMMARY_V rebuilds pruned days from the transcripts."""
    folder = os.path.join(state_dir(), "days")
    today = local_day(now)
    oldest = local_day(now - DAY_SUMMARY_DAYS * 86400)
    journal_days = state.setdefault("journal", {}).setdefault("days", {})
    floor_days = state["journal"].setdefault("floor_days", {})
    out = {}
    for path in glob.glob(os.path.join(folder, "*.json")):
        day = os.path.basename(path)[:-5]
        if oldest <= day < today:
            summary = read_json(path, {})
            if summary.get("v") == SUMMARY_V:
                out[day] = summary
    logged = {os.path.basename(p)[:-6] for p in glob.glob(os.path.join(state_dir(), "events", "*.jsonl"))}
    missing = {d for d in logged | set(journal_days) | set(floor_days) if oldest <= d < today and d not in out}
    rebuilt, rebuilt_windows = {}, []
    if write and state.get("rebuilt") != SUMMARY_V:
        found, horizon = [], local_day(now - BACKFILL_DAYS * 86400)
        scan_transcripts({}, now, found, {})
        for event in found:
            day = local_day(event[1])
            if horizon <= day < today and day not in logged and day not in out:
                rebuilt.setdefault(day, []).append(event)
        if rebuilt:
            rows = [e for day_rows in rebuilt.values() for e in day_rows]
            rebuilt_windows = slow_windows([e for e in rows if e[0] == "c"], [e for e in rows if e[0] == "x"],
                                           day_start(min(rebuilt)), day_end(max(rebuilt)))
        missing |= set(rebuilt)
        state["rebuilt"] = SUMMARY_V
    for day in sorted(d for d in floor_days if oldest <= d < today and d in out and d not in missing):
        floors = out[day].setdefault("floors", {})
        for key, entry in floor_days[day].items():
            hist_join(floors.setdefault(key, hist_new()), entry)
        if write:
            write_json(os.path.join(folder, day + ".json"), out[day])
    for day in sorted(missing):
        summary = (summarize_day(day, rebuilt[day], samples, journal_days.get(day), rebuilt_windows,
                                 floor_days.get(day))
                   if day in rebuilt else
                   summarize_day(day, load_events([day]), samples, journal_days.get(day), windows, floor_days.get(day)))
        out[day] = summary
        if write:
            os.makedirs(folder, exist_ok=True)
            write_json(os.path.join(folder, day + ".json"), summary)
    if write:
        for days in (journal_days, floor_days):
            for day in [d for d in days if d < today]:
                del days[day]
    out[today] = summarize_day(today, today_rows, samples, journal_days.get(today), windows, floor_days.get(today))
    return out


def prune(now):
    old = []
    for sub, keep in (("events", EVENT_DAYS), ("days", DAY_SUMMARY_DAYS), ("statusline", JOURNAL_FILE_DAYS),
                      ("menu", JOURNAL_FILE_DAYS), ("speed-days", SPEED_DAYS)):
        cutoff = local_day(now - keep * 86400)
        old += [p for p in glob.glob(os.path.join(state_dir(), sub, "*")) if os.path.basename(p)[:10] < cutoff]
    old += [p for p in glob.glob(os.path.join(wait_dir(), "*.jsonl"))
            if os.path.basename(p)[:10] < local_day(now - WAIT_DAYS * 86400)]
    old += [p for p in glob.glob(os.path.join(state_dir(), "hooks", "*.tsv"))
            + glob.glob(os.path.join(state_dir(), "hooks", "folded", "*.tsv"))
            if os.path.basename(p)[:-4].isdigit() and int(os.path.basename(p)[:-4]) < now // 86400 - JOURNAL_FILE_DAYS]
    for path in old:
        try:
            os.remove(path)
        except OSError:
            pass


# ---------------------------------------------------------------- settings and change log


def settings_hooks():
    settings = read_json(settings_path(), {})
    out = []
    for event, groups in (settings.get("hooks") or {}).items():
        for group in groups or []:
            matcher = str(group.get("matcher") or "")
            for hook in group.get("hooks") or []:
                if hook.get("type", "command") != "command":
                    continue
                out.append({"event": event, "matcher": matcher, "command": str(hook.get("command") or ""),
                            "timeout": hook.get("timeout"), "async": bool(hook.get("async"))})
    return out


def settings_mtime():
    try:
        return os.stat(settings_path()).st_mtime
    except OSError:
        return 0.0


def hook_script(command):
    word = (command or "").split()[0] if (command or "").split() else ""
    if word.startswith("~/"):
        word = os.path.join(base_home(), word[2:])
    return word if word.startswith("/") and os.path.isfile(word) else ""


def hook_label(command):
    script = hook_script(command)
    if script:
        rest = command.split(None, 1)
        name = os.path.basename(script)
        name = name[:-3] if name.endswith(".sh") else name
        return name + (" " + rest[1] if len(rest) > 1 else "")
    return "inline: " + (command or "")[:30]


def hook_key(command):
    words = (command or "").split()
    if not hook_script(command):
        return command or ""
    return os.path.basename(words[0]) + (" " + words[1] if len(words) > 1 else "")


def hook_text(command, cache={}):
    script = hook_script(command)
    if script not in cache:
        try:
            with open(script, errors="replace") as handle:
                cache[script] = handle.read(200000)
        except OSError:
            cache[script] = ""
    return cache[script]


def niced(command):
    return bool(re.search(r"(?m)^[^#\n]*\b(renice|nice\s+-n)\b", hook_text(command)))


def hook_journaled(command):
    return bool(hook_script(command)) and HOOK_TIME_LIB in hook_text(command)


def matches(matcher, tool):
    if matcher in ("", "*"):
        return True
    try:
        return re.fullmatch(matcher, tool) is not None
    except re.error:
        return matcher == tool


def watch_changes(state, now, versions, hooks):
    changes = []
    known = state.get("watched")
    seeding = known is None
    known = known or {}
    current = {}
    paths = []
    for root in watch_roots():
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if not d.startswith(".") and d not in ("node_modules", "__pycache__")
                           and dirpath.count(os.sep) - root.count(os.sep) < 3]
            paths.extend(os.path.realpath(os.path.join(dirpath, name)) for name in filenames
                         if not name.startswith(".") and not name.endswith((".pyc", ".tmp")))
    for hook in hooks:
        script = hook_script(hook["command"])
        if script:
            paths.append(os.path.realpath(script))
    for path in set(paths):
        try:
            st = os.stat(path)
        except OSError:
            continue
        if st.st_size > 4 << 20:
            continue
        old = known.get(path)
        if old and old[0] == st.st_size and old[1] == st.st_mtime_ns:
            current[path] = old
            continue
        try:
            with open(path, "rb") as handle:
                digest = hashlib.sha1(handle.read()).hexdigest()[:12]
        except OSError:
            continue
        current[path] = [st.st_size, st.st_mtime_ns, digest]
        if (not old or old[2] != digest) and (not seeding or st.st_mtime >= now - 7 * 86400):
            changes.append({"at": round(st.st_mtime, 1), "kind": "edited" if old else "new",
                            "what": short_path(path)})
    if not seeding:
        for path in set(known) - set(current):
            if not os.path.exists(os.path.dirname(path)):
                current[path] = known[path]
                continue
            changes.append({"at": round(now, 1), "kind": "removed", "what": short_path(path)})
    state["watched"] = current

    snapshot = {"%s|%s|%s" % (h["event"], h["matcher"], h["command"]): h["timeout"] for h in hooks}
    old_hooks = state.get("hooks")
    if old_hooks is not None:
        for key in sorted(set(snapshot) | set(old_hooks)):
            event, _, command = key.split("|", 2)
            name = "%s %s" % (event, hook_label(command))
            if key not in old_hooks:
                changes.append({"at": now, "kind": "hook added", "what": name})
            elif key not in snapshot:
                changes.append({"at": now, "kind": "hook removed", "what": name})
            elif snapshot[key] != old_hooks[key]:
                changes.append({"at": now, "kind": "hook timeout",
                                "what": "%s %s → %s s" % (name, old_hooks[key] or "none", snapshot[key] or "none")})
    state["hooks"] = snapshot

    flat = {}

    def walk(prefix, value):
        if isinstance(value, dict) and value:
            for name, inner in value.items():
                walk(prefix + "." + name if prefix else name, inner)
        else:
            text = json.dumps(value, sort_keys=True, ensure_ascii=False)
            digest = "#" + hashlib.sha1(text.encode()).hexdigest()[:12]
            flat[prefix] = (digest if SECRET_SETTING.search(prefix) else text if len(text) <= 120
                            else text[:100] + "… " + digest)

    for name, value in read_json(settings_path(), {}).items():
        if name != "hooks":
            walk(name, value)
    old_settings = state.get("settings")
    if old_settings is not None:
        at = round(min(settings_mtime() or now, now), 1)
        for key in sorted(set(flat) | set(old_settings)):
            if flat.get(key) != old_settings.get(key):
                changes.append({"at": at, "kind": "setting", "what": "%s %s" % (
                    key, "changed" if SECRET_SETTING.search(key) else "%s → %s" % (
                        old_settings.get(key, "unset"), flat.get(key, "unset")))})
    state["settings"] = flat

    known_versions = state.get("versions")
    oldest = min(versions.values()) if versions and known_versions is None else None
    for version, first in versions.items():
        if version not in (known_versions or {}) and first != oldest:
            changes.append({"at": round(first, 1), "kind": "Claude Code", "what": version})
    merged = dict(known_versions or {})
    for version, first in versions.items():
        merged[version] = min(first, merged.get(version, first))
    state["versions"] = merged
    return changes


# ---------------------------------------------------------------- machine sample


class _HostCpu:
    def __init__(self):
        self.lib = ctypes.CDLL("/usr/lib/libSystem.dylib")
        self.lib.mach_host_self.restype = ctypes.c_uint

    def ticks(self):
        values = (ctypes.c_uint * 4)()
        count = ctypes.c_uint(4)
        if self.lib.host_statistics(self.lib.mach_host_self(), 3, ctypes.byref(values), ctypes.byref(count)):
            return None
        return list(values)


def host_ticks():
    try:
        return _HostCpu().ticks()
    except (OSError, AttributeError):
        return None


def spawn_pid():
    process = subprocess.Popen(["/usr/bin/true"])
    process.wait()
    return process.pid


def sysctl(*names):
    try:
        out = subprocess.run(["/usr/sbin/sysctl", "-n"] + list(names), capture_output=True, text=True,
                             timeout=5).stdout.splitlines()
    except (OSError, subprocess.SubprocessError):
        return [""] * len(names)
    return (out + [""] * len(names))[:len(names)]


def visible_cores(now):
    chats = read_json(os.path.join(memlogd_dir(), "chats.json"), {})
    if not isinstance(chats, dict) or now - (chats.get("as_of") or 0) > 120:
        return None, None
    found = re.search(r"([\d.]+)/([\d.]+) cores", str(chats.get("title") or ""))
    visible = float(found.group(1)) + float(found.group(2)) if found else None
    return visible, bool(chats.get("alarm"))


def running_tests(now):
    count = 0
    for path in glob.glob(os.path.join(statusline_cache(), "work-*")):
        try:
            if now - os.path.getmtime(path) > 30:
                continue
            with open(path, errors="replace") as handle:
                count += sum(1 for line in handle if line.startswith("main\ttests\t"))
        except OSError:
            continue
    return count


def held_slots():
    """Suite and night-fixer slots a live process holds: the machine's requested parallel work."""
    count = 0
    for root in (os.environ.get("RUN_SUITES_SLOTS_DIR") or os.path.join(
                     os.environ.get("XDG_CACHE_HOME") or os.path.join(base_home(), ".cache"), "run-suites", "slots"),
                 os.environ.get("NIGHT_FIXER_SLOTS_DIR") or os.path.join(env_dir("DOCTORS_DIR", ".cache", "doctors"),
                                                                         "fixer-slots")):
        for path in glob.glob(os.path.join(root, "*", "pid")):
            try:
                with open(path) as handle:
                    pid = int(handle.read().split()[0])
            except (OSError, ValueError, IndexError):
                continue
            count += pid > 1 and pid_alive(pid)
    return count


def collector_verdict(elapsed, backfill, held):
    over = elapsed > LIMITS["collector_s"]
    out = verdict("collector", "run", elapsed, LIMITS["collector_s"], "s", 0, 1,
                  "watch" if over and held else "red" if over and not backfill else None,
                  fact="the collector took %.1f s, limit %d s%s" % (
                      elapsed, LIMITS["collector_s"], " while %d suite or night-fixer slots ran" % held if held else ""),
                  bad=int(over))
    out["group"] = "Collector"
    return out


def take_sample(state, now, phase=lambda name: None, burst=None):
    fake = os.environ.get("HARNESS_DOCTOR_FAKE_SAMPLE")
    if fake is not None:
        sample = json.loads(fake) if fake else None
        if sample is not None:
            sample.setdefault("t", now)
        return sample
    ncpu = os.cpu_count() or 1
    ticks = host_ticks()
    start_pid, started = spawn_pid(), time.monotonic()
    phase("sample")
    if burst is None:
        time.sleep(2)
    else:
        for at in (0.0, 1.0, 2.0):
            time.sleep(max(0.0, started + at - time.monotonic()))
            burst.append((time.time(), ps_snapshot()))
    phase("sleep")
    forks = ((spawn_pid() - start_pid - len(burst or ())) % 99999) / (time.monotonic() - started)
    sample = {"t": now, "forks": round(forks), "ncpu": ncpu, "tests": running_tests(now), "held": held_slots()}
    previous = state.get("ticks")
    if ticks and previous and 0 < now - previous[0] <= SAMPLE_GAP_S:
        delta = [(b - a) % (1 << 32) for a, b in zip(previous[1], ticks)]
        total = sum(delta)
        if 0 < total < (now - previous[0]) * ncpu * 1000:
            sample["busy"] = round((delta[0] + delta[1] + delta[3]) / total, 3)
            sample["kernel"] = round(delta[1] / total, 3)
    if ticks:
        state["ticks"] = [now, ticks]
    swap, level = sysctl("vm.swapusage", "kern.memorystatus_level")
    used = re.search(r"used = ([\d.]+)M", swap)
    total = re.search(r"total = ([\d.]+)M", swap)
    if used and total:
        sample["swap_mb"], sample["swap_total_mb"] = float(used.group(1)), float(total.group(1))
    if level.strip().isdigit():
        sample["mem_free"] = int(level)
    sample["visible"], sample["guard"] = visible_cores(now)
    return sample


def load_samples(now):
    rows = []
    try:
        with open(os.path.join(state_dir(), "samples.jsonl")) as handle:
            for line in handle:
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                if isinstance(row, dict) and now - row.get("t", 0) <= EVENT_DAYS * 86400:
                    rows.append(row)
    except OSError:
        pass
    return rows


# ---------------------------------------------------------------- hook and statusline journals


def hist_new():
    return [0, 0, None, None, 0, 0, []]


def hist_put(entry, ms, failed=False):
    if ms is None:
        entry[5] += 1
        return
    ms = max(0, int(round(ms)))
    entry[0] += 1
    entry[1] += ms
    entry[2] = ms if entry[2] is None else min(entry[2], ms)
    entry[3] = ms if entry[3] is None else max(entry[3], ms)
    entry[4] += 1 if failed else 0
    index = bisect.bisect_right(HIST_EDGES_MS, ms)
    counts = entry[6]
    counts.extend([0] * (index + 1 - len(counts)))
    counts[index] += 1


def hist_join(merged, entry):
    for index in (0, 1, 4, 5):
        merged[index] += entry[index]
    if entry[2] is not None:
        merged[2] = entry[2] if merged[2] is None else min(merged[2], entry[2])
        merged[3] = entry[3] if merged[3] is None else max(merged[3], entry[3])
    merged[6].extend([0] * (len(entry[6]) - len(merged[6])))
    for index, count in enumerate(entry[6]):
        merged[6][index] += count
    return merged


def hist_add(slots, t, key, ms, failed=False):
    slot = slots.setdefault(str(int(t // SLOT_S * SLOT_S)), {})
    hist_put(slot.setdefault(key, hist_new()), ms, failed)


def hist_merge(slots, since):
    out = {}
    for slot, entries in slots.items():
        if int(slot) + SLOT_S <= since:
            continue
        for key, entry in entries.items():
            hist_join(out.setdefault(key, hist_new()), entry)
    return {key: entry for key, entry in out.items() if entry[0] or entry[5]}


def hist_percentile(entry, q):
    if not entry or not entry[0]:
        return None
    target, seen = q * entry[0], 0
    for index, count in enumerate(entry[6]):
        if count and seen + count >= target:
            low = HIST_EDGES_MS[index - 1] if index else 0
            high = HIST_EDGES_MS[index] if index < len(HIST_EDGES_MS) else entry[3]
            value = low + (high - low) * (target - seen) / count
            return min(max(value, entry[2]), entry[3]) / 1000.0
        seen += count
    return entry[3] / 1000.0


def fold_tsv(journal, sub, parse, folder=None, pattern="*.tsv", sep="\t"):
    offsets = journal.setdefault("offsets", {})
    folder = folder or os.path.join(state_dir(), sub)
    names = set()
    for path in sorted(glob.glob(os.path.join(folder, pattern))):
        name = sub + "/" + os.path.basename(path)
        names.add(name)
        start = offsets.get(name, 0)
        try:
            if os.path.getsize(path) < start:
                start = 0
            with open(path, "rb") as handle:
                handle.seek(start)
                data = handle.read()
        except OSError:
            continue
        end = data.rfind(b"\n") + 1
        offsets[name] = start + end
        for text in data[:end].decode("utf-8", "replace").splitlines():
            try:
                parse(text.split(sep) if sep else text)
            except (ValueError, IndexError, TypeError, AttributeError, KeyError):
                pass
    for name in [n for n in offsets if n.startswith(sub + "/") and n not in names]:
        del offsets[name]


def fold_spool(add, now, write):
    runs, done_paths = [], []
    for path in glob.glob(os.path.join(state_dir(), "hooks", "spool", "*")):
        try:
            info = os.stat(path)
            with open(path, errors="replace") as handle:
                key, _, rest = handle.read().partition("\t")
            fields = [key] + rest.rstrip("\n").rsplit("\n", 1)[-1].split("\t")
        except OSError:
            continue
        birth = getattr(info, "st_birthtime", info.st_mtime)
        done = len(fields) >= 2 and fields[1] != ""
        if not done and now - birth < SPOOL_STALE_S:
            continue
        if done:
            add(info.st_mtime, fields[0], (info.st_mtime - birth) * 1000.0, fields[1] != "0")
            runs.append((int(birth * 1e6), int(info.st_mtime * 1e6), fields[0], fields[1],
                         fields[2] if len(fields) > 2 else "", fields[3] if len(fields) > 3 else ""))
        else:
            add(birth, fields[0] or "?", None)
        done_paths.append(path)
    if write and runs:
        folder = os.path.join(state_dir(), "hooks", "folded")
        os.makedirs(folder, exist_ok=True)
        by_day = {}
        for run in runs:
            by_day.setdefault(run[1] // 86400000000, []).append(run)
        for day, items in by_day.items():
            with open(os.path.join(folder, "%d.tsv" % day), "a") as handle:
                handle.write("".join("%d\t%d\t%s\t%s\t%s\t%s\n" % run for run in sorted(items)))
    if write:
        for path in done_paths:
            try:
                os.remove(path)
            except OSError:
                pass
    return runs


def spool_backlog(now):
    ages = []
    for path in glob.glob(os.path.join(state_dir(), "hooks", "spool", "*")):
        try:
            info = os.stat(path)
        except OSError:
            continue
        ages.append(now - getattr(info, "st_birthtime", info.st_mtime))
    return len(ages), max(ages, default=0.0)


def read_journals(state, now, write):
    journal = state.setdefault("journal", {})
    slots = journal.setdefault("slots", {})
    if "days" not in journal:
        journal["days"] = {}
        for slot, entries in slots.items():
            day = journal["days"].setdefault(local_day(int(slot)), {})
            for key, entry in entries.items():
                hist_join(day.setdefault(key, hist_new()), entry)
    days = journal["days"]

    def add(t, key, ms, failed=False):
        hist_add(slots, t, key, ms, failed)
        hist_put(days.setdefault(local_day(t), {}).setdefault(key, hist_new()), ms, failed)

    renders = []

    def hook_row(fields):
        start, end = int(fields[0]), int(fields[1])
        add(end / 1e6, fields[2], (end - start) / 1000.0, fields[3] != "0")
        hook_cpu(state, end / 1e6, fields[2], fields[5] if len(fields) > 5 else "")

    def statusline_row(fields):
        start, end = int(fields[0]), int(fields[1])
        add(end / 1e6, STATUSLINE_KEY, (end - start) / 1000.0)
        renders.append((end / 1e6, fields[2] if len(fields) > 2 else "", fields[3] if len(fields) > 3 else "-"))

    fold_tsv(journal, "hooks", hook_row)
    def menu_row(fields):
        start, end = int(fields[0]), int(fields[1])
        add(end / 1e6, MENU_KEY + fields[2], (end - start) / 1000.0)

    fold_tsv(journal, "statusline", statusline_row)
    fold_tsv(journal, "menu", menu_row)
    fresh = fold_spool(add, now, write)
    for run in fresh:
        hook_cpu(state, run[1] / 1e6, run[2], run[5])
    statusline_fold(state, renders, now)
    for slot in [k for k in slots if int(k) < now - JOURNAL_KEEP_S]:
        del slots[slot]
    return hist_merge(slots, now - 86400), hist_merge(slots, now - 3600), fresh


def run_row(fields):
    start, end = int(fields[0]) / 1e6, int(fields[1]) / 1e6
    cpu = fields[5] if len(fields) > 5 else ""
    return (end, sys.intern(fields[2]), (end - start) * 1000.0, fields[3] != "0", start,
            sys.intern(fields[4]) if len(fields) > 4 else "", int(cpu) / 1000.0 if cpu.isdigit() else None)


def cached_runs(path, cache, write):
    """One journal file's rows: the cache's pickled chunks `(RUNS_V, ino, head, from, to, first, rows)` up to its
    last offset, plus the bytes after it; a changed inode or head, or a shorter file, reads it again from 0."""
    try:
        info = os.stat(path)
        with open(path, "rb") as handle:
            head = handle.read(64)
            off, first, rows, reset = 0, None, [], False
            try:
                with open(cache, "rb") as stored:
                    while True:
                        try:
                            version, ino, was, start, stop, low, part = pickle.load(stored)
                        except EOFError:
                            break
                        if version != RUNS_V or ino != info.st_ino or not head.startswith(was):
                            raise ValueError(cache)
                        if start == off:
                            off = stop
                            rows.extend(part)
                            first = low if first is None or (low is not None and low < first) else first
            except FileNotFoundError:
                pass
            except Exception:
                off, first, rows, reset = 0, None, [], True
            if info.st_size < off:
                off, first, rows, reset = 0, None, [], True
            handle.seek(off)
            data = handle.read()
    except OSError:
        return [], None
    end = data.rfind(b"\n") + 1
    new = []
    for text in data[:end].decode("utf-8", "replace").splitlines():
        try:
            new.append(run_row(text.split("\t")))
        except (ValueError, IndexError):
            pass
    low = min((r[4] for r in new), default=None)
    if write and (end or reset):
        os.makedirs(os.path.dirname(cache), exist_ok=True)
        with open(cache, "wb" if reset or not off else "ab") as stored:
            pickle.dump((RUNS_V, info.st_ino, head, off, off + end, low, new), stored,
                        protocol=pickle.HIGHEST_PROTOCOL)
    first = low if first is None or (low is not None and low < first) else first
    return rows + new, first


def journal_runs(since, extra=(), write=False):
    """`(end, key, ms, failed, start, ppid, cpu_ms)` of every journal line ending after `since`, and the earliest start;
    hook-runs/ caches each file's parsed lines, so a pass parses only new bytes. `extra` are spool runs a
    non-persisting run folded but did not write to hooks/folded."""
    runs, first, names = [], None, set()
    folder = os.path.join(state_dir(), "hook-runs")
    for sub in ("hooks", "hooks/folded"):
        for path in sorted(glob.glob(os.path.join(state_dir(), sub, "*.tsv"))):
            name = sub.replace("/", "-") + "-" + os.path.basename(path)[:-4] + ".pickle"
            names.add(name)
            rows, low = cached_runs(path, os.path.join(folder, name), write)
            runs += [r for r in rows if r[0] > since]
            first = low if first is None or (low is not None and low < first) else first
    for run in extra:
        row = run_row([str(field) for field in run])
        first = row[4] if first is None else min(first, row[4])
        if row[0] > since:
            runs.append(row)
    if write:
        for path in glob.glob(os.path.join(folder, "*.pickle")):
            if os.path.basename(path) not in names:
                try:
                    os.remove(path)
                except OSError:
                    pass
    return runs, first


# ---------------------------------------------------------------- speed journals (C2 CPU, C5 queues, C6, C7, C11)


def speed_state(state):
    return state.setdefault("speed", {})


def speed_day(state, t):
    """The day's accumulator, written to speed-days/<day>.json; a day dropped from the state reopens its file."""
    day = local_day(t)
    days = speed_state(state).setdefault("days", {})
    if day not in days:
        days[day] = read_json(os.path.join(state_dir(), "speed-days", day + ".json"), {})
    return days[day]


def speed_flush(state, now, write):
    days = speed_state(state).get("days", {})
    for day in sorted(days):
        if write:
            os.makedirs(os.path.join(state_dir(), "speed-days"), exist_ok=True)
            write_json(os.path.join(state_dir(), "speed-days", day + ".json"), days[day])
        if day < local_day(now - 86400):
            del days[day]


def load_band(ratio):
    if ratio is None:
        return "?"
    return "<1" if ratio < 1 else "1-2" if ratio < 2 else "2-4" if ratio < 4 else ">4"


def size_band(kb):
    if kb is None:
        return "?"
    return "<1" if kb < SIZE_SMALL_KB else ">10" if kb >= SIZE_BIG_KB else "1-10"


def band_at(ticks, t):
    i = bisect.bisect_left(ticks, [t])
    near = [ticks[j] for j in (i - 1, i) if 0 <= j < len(ticks) and abs(ticks[j][0] - t) <= TICK_JOIN_S]
    return load_band(min(near, key=lambda k: abs(k[0] - t))[1]) if near else "?"


def hook_cpu(state, t, key, cpu_us):
    """Per-key CPU; stop.d/<name> parts are kept apart from the total, the dispatcher's own row already holds them."""
    if not str(cpu_us).isdigit():
        return
    acc = speed_day(state, t)
    items = [acc.setdefault("hook_cpu_us", {}).setdefault(key, [0, 0])]
    if not key.startswith(STOP_PART):
        items.append(acc.setdefault("hook_cpu_us_total", [0, 0]))
    for item in items:
        item[0] += 1
        item[1] += int(cpu_us)


def speed_floor(state, floor, ticks):
    band = "%s|%s|%s" % (floor["cls"], band_at(ticks, floor["t"]), size_band(floor.get("kb")))
    acc = speed_day(state, floor["t"])
    hist_put(acc.setdefault("floors", {}).setdefault(band, hist_new()), floor["ms"])
    for hook, (own, without) in batch_parts(floor.get("batches") or ()).items():
        own_h, without_h, floor_h = acc.setdefault("floor_hooks", {}).setdefault(
            band + "|" + hook, [hist_new(), hist_new(), hist_new()])
        hist_put(own_h, own)
        hist_put(without_h, without)
        hist_put(floor_h, floor["ms"])


def fold_machine(state, journal, now):
    """memlogd's machine lines: load ratio ticks for banding, and per day the seconds in each load band, the
    contention probe per band, swap and thermal."""
    ticks = speed_state(state).setdefault("ticks", [])
    boots = state.setdefault("boots", [])

    def parse(words):
        t, facts = float(words[0]), dict(w.split("=", 1) for w in words[1:] if "=" in w)
        load, ncpu = float(facts.get("load1", -1)), float(facts.get("ncpu", -1))
        ratio = round(load / ncpu, 3) if load >= 0 and ncpu > 0 else None
        acc = speed_day(state, t).setdefault("machine", {"band_s": {}, "probe_ms": {}, "swap_mb_max": 0,
                                                         "swapin_max": 0, "thermal_ticks": 0})
        last = ticks[-1][0] if ticks else None
        band = load_band(ratio)
        acc["band_s"][band] = round(acc["band_s"].get(band, 0) + (min(t - last, TICK_JOIN_S) if last and t > last
                                                                     else MACHINE_TICK_S), 1)
        if ratio is not None:
            ticks.append([t, ratio])
        if int(facts.get("probe_ms", -1)) >= 0:
            hist_put(acc["probe_ms"].setdefault(band, hist_new()), int(facts["probe_ms"]))
        acc["swap_mb_max"] = max(acc["swap_mb_max"], float(facts.get("swap_mb", -1)))
        acc["swapin_max"] = max(acc["swapin_max"], float(facts.get("swapin_pages_s", -1)))
        acc["thermal_ticks"] += int(facts.get("thermal", -1)) > 0
        boot = float(facts.get("boot", -1))
        if boot > 0 and boot not in boots:
            boots.append(boot)
            del boots[:-C1_BOOTS_KEPT]

    fold_tsv(journal, "machine", parse, os.path.join(memlogd_dir(), "machine"), "????-??-??.log", " ")
    ticks.sort()
    del ticks[:bisect.bisect_left(ticks, [now - TICKS_KEEP_S])]
    return ticks


def statusline_fold(state, renders, now):
    """Renders per day: count, CPU (bash 5.3 rows only), session-hours, and the idle ones: no transcript line
    within IDLE_GAP_S before the render, no tool call or background task open in the chat."""
    files = state.get("files", {})
    busy, opened = {}, {}
    for path, rec in files.items():
        if os.sep + "subagents" + os.sep in path or not (rec.get("act") or rec.get("pend") or rec.get("c1")):
            continue
        session = os.path.basename(path)[:8]
        c = rec.get("c1") or {}
        busy.setdefault(session, []).extend(rec.get("act") or [])
        busy[session].extend([v[0], v[2]] for v in (c.get("dn") or {}).values())
        starts = [v[0] for v in (rec.get("pend") or {}).values()] + [v[0] for v in (c.get("bg") or {}).values()]
        if starts:
            opened[session] = min(starts + [opened.get(session, now)])
    busy = {k: c1_merge(v, 0, float("inf")) for k, v in busy.items()}
    hours = {}
    for t, session, cpu in renders:
        acc = speed_day(state, t).setdefault("statusline", {"renders": 0, "idle": 0, "cpu_ms": 0, "cpu_n": 0,
                                                             "idle_cpu_ms": 0, "session_hours": []})
        session = session[:8]
        idle = not (c1_inside(busy.get(session, []), t) or opened.get(session, float("inf")) <= t)
        acc["renders"] += 1
        acc["idle"] += idle
        if cpu.isdigit():
            acc["cpu_ms"] += int(cpu)
            acc["cpu_n"] += 1
            acc["idle_cpu_ms"] += int(cpu) if idle else 0
        seen = hours.setdefault(id(acc), set(acc["session_hours"]))
        hour = "%s:%d" % (session, t // 3600)
        if hour not in seen:
            seen.add(hour)
            acc["session_hours"].append(hour)


def fold_starts(state, journal, floors, now):
    """claudeb's start stamps joined to the SessionStart batch of the process it exec'd: `s` rows
    [s, entry, profile, kind, exec - entry s, SessionStart end - entry s or None, pid]."""
    pending = speed_state(state).setdefault("starts", [])

    def parse(fields):
        pending.append([float(fields[0].replace(",", ".")), float(fields[1].replace(",", ".")), fields[2],
                        fields[3], fields[4]])

    path = os.environ.get("CLAUDEB_STARTS_LOG") or os.path.join(base_home(), ".cache", "claudeb", "starts.tsv")
    fold_tsv(journal, "claudeb", parse, os.path.dirname(path), os.path.basename(path))
    ready = {}
    for floor in floors:
        if floor["cls"] == "event:SessionStart" and floor.get("ppid"):
            ready.setdefault(str(floor["ppid"]), []).append(floor["t"] + floor["ms"] / 1000.0)
    rows, left = [], []
    for entry, launched, pid, profile, kind in pending:
        found = [x for x in ready.get(pid, ()) if launched <= x <= launched + START_WAIT_S]
        if found or now - launched > START_WAIT_S:
            rows.append(["s", round(entry, 3), profile, kind, round(launched - entry, 3),
                         round(min(found) - entry, 3) if found else None, pid])
        else:
            left.append([entry, launched, pid, profile, kind])
    pending[:] = left
    return rows


def fold_mcp(state, now):
    """MCP connect results from Claude Code's mcp-logs: `m` rows [m, t, session, server, ms, ok]. Listed are the
    log directories changed since the last pass and those holding a file already seen: an append leaves the
    directory's mtime alone. A file is read from its last offset."""
    root = os.environ.get("CLAUDE_CLI_CACHE_DIR") or os.path.join(base_home(), "Library", "Caches", "claude-cli-nodejs")
    mcp = speed_state(state).setdefault("mcp", {"at": now - MCP_BACKFILL_S, "off": {}})
    since, offsets, rows = mcp["at"] - MCP_SLACK_S, mcp["off"], []
    seen = {os.path.dirname(p) for p in offsets}
    try:
        tops = list(os.scandir(root))
    except OSError:
        tops = []
    for top in tops:
        try:
            subs = [e for e in os.scandir(top.path) if e.name.startswith("mcp-logs-")
                    and (e.path in seen or e.stat().st_mtime >= since)]
        except OSError:
            continue
        for sub in subs:
            try:
                logs = [(e.path, e.stat()) for e in os.scandir(sub.path)]
            except OSError:
                continue
            for path, info in logs:
                start = offsets.get(path, [0])[0]
                if info.st_mtime < since and path not in offsets:
                    continue
                if info.st_size <= start:
                    offsets.setdefault(path, [start, info.st_mtime])
                    continue
                try:
                    with open(path, "rb") as handle:
                        handle.seek(start)
                        data = handle.read()
                except OSError:
                    continue
                end = data.rfind(b"\n") + 1
                offsets[path] = [start + end, info.st_mtime]
                for text in data[:end].split(b"\n"):
                    found = MCP_RESULT.search(text.decode("utf-8", "replace")) if b"ms" in text else None
                    if not found:
                        continue
                    try:
                        entry = json.loads(text)
                    except ValueError:
                        continue
                    t = iso_epoch(entry.get("timestamp"))
                    if t is not None:
                        rows.append(["m", round(t, 3), str(entry.get("sessionId") or "")[:8], sub.name[9:],
                                     int(found.group(2)), int(found.group(1) == "Successfully connected")])
    mcp["at"] = now
    for path in [p for p, v in offsets.items() if v[1] < now - MCP_BACKFILL_S]:
        del offsets[path]
    return rows


def suites_journal():
    return os.environ.get("RUN_SUITES_JOURNAL") or os.path.join(os.path.dirname(
        os.environ.get("RUN_SUITES_TIMES") or os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(
            base_home(), ".cache"), "run-suites", "times.tsv")), "runs.jsonl")


def load_suite_runs(now):
    return [r for r in read_jsonl(suites_journal(), now - LIMITS["test_slow_fresh_s"] - 86400, "ended_at") or ()
            if isinstance(r.get("started_at"), (int, float))
            and isinstance(r.get("ended_at"), (int, float))]


def fold_suites(state, journal, now):
    """C5 suite runs a chat waited on for a slot: per session `[queued_at, started_at]`, the queue layer of its
    turns."""
    queues = speed_state(state).setdefault("queues", {})

    def parse(text):
        run = json.loads(text)
        session, queued, started = run.get("session"), run.get("queued_at"), run.get("started_at")
        if session and queued and started and started - queued >= QUEUE_MIN_S:
            queues.setdefault(session[:8], []).append([queued, started])

    path = suites_journal()
    fold_tsv(journal, "suites", parse, os.path.dirname(path), os.path.basename(path), None)
    for session in list(queues):
        queues[session] = [q for q in queues[session] if q[1] >= now - C1_BG_KEEP_S]
        if not queues[session]:
            del queues[session]
    return queues


def turn_layers(rows, by_call, queues):
    """Moves a new turn row's hook-batch and suite-queue seconds out of its tool layers, in the partition's
    precedence (hook batch > queue > suite > media > other tool)."""
    for row in rows:
        if row[0] != "t" or len(row) < 12:
            continue
        part = row[9]
        hook = {}
        for tid, layer in row[11]:
            hook[layer] = hook.get(layer, 0.0) + by_call.get(tid, 0.0) / 1000.0
        queued = sum(max(0.0, min(b, row[3]) - max(a, row[1])) for a, b in queues.get(row[2], ()))

        def move(name, layer, secs):
            take = min(part.get(layer, 0.0), secs)
            if take < 0.05:
                return 0.0
            part[layer] = round(part[layer] - take, 1)
            part[name] = round(part.get(name, 0.0) + take, 1)
            return take

        for layer, secs in sorted(hook.items()):
            move("hook", layer, secs)
        for layer in ("test", "media", "tool"):
            queued -= move("queue", layer, queued)
        for layer in [k for k, v in part.items() if v < 0.05]:
            del part[layer]


def wrapper_targets(path):
    """Absolute paths a ~/.local/libexec wrapper's exec lines run, literal or through a variable assigned one."""
    try:
        with open(path, errors="replace") as handle:
            text = handle.read(20000)
    except OSError:
        return set()
    assigned = dict(re.findall(r"(?m)^\s*(\w+)=[\"']?(/[^\s\"';]+)", text))
    found = set()
    for line in re.findall(r"(?m)^\s*exec\s+(.*)$", text):
        for word in re.findall(r"\$\{?\w+\}?|/[^\s\"';]+", line):
            target = assigned.get(word.strip("${}")) if word.startswith("$") else word
            if target and not INTERPRETER.search(target):
                found.add(target)
    return found


def libexec_dir():
    return env_dir("HARNESS_LIBEXEC_DIR", ".local", "libexec")


def launchd_labels():
    """[(label, paths)] of the LaunchAgents: the program, plus a ~/.local/libexec wrapper's exec targets."""
    home = base_home()
    libexec = libexec_dir()
    out = []
    for path in sorted(glob.glob(os.path.join(home, "Library", "LaunchAgents", "*.plist"))):
        try:
            with open(path, "rb") as handle:
                plist = plistlib.load(handle)
        except Exception:
            continue
        args = plist.get("ProgramArguments") or [plist.get("Program")]
        program = os.path.expanduser(str(args[0] or "")) if args else ""
        if not program.startswith("/"):
            continue
        if INTERPRETER.search(program):
            script = next((os.path.expanduser(str(a)) for a in args[1:] if str(a).startswith(("/", "~/"))
                           and not INTERPRETER.search(str(a))), None)
            if not script:
                continue
            program = script
        paths = {program} | (wrapper_targets(program) if os.path.dirname(program) == libexec else set())
        out.append((str(plist.get("Label") or os.path.basename(path)[:-6]), sorted(paths)))
    return out


def ps_snapshot():
    """{pid: (ppid, cpu s, start, command)}."""
    try:
        text = subprocess.run(["/bin/ps", "-A", "-o", "pid=,ppid=,time=,lstart=,command="], capture_output=True,
                              text=True, timeout=5, env=dict(os.environ, LC_ALL="C")).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    procs = {}
    for line in text.splitlines():
        found = PS_ROW.match(line)
        if found:
            try:
                procs[found.group(1)] = (found.group(2), etime_s(found.group(3)), found.group(4), found.group(5))
            except ValueError:
                continue
    return procs


def label_resolver(labels):
    memo = {}

    def resolve(procs, pid):
        chain, label = [], None
        while label is None:
            if pid in memo:
                label = memo[pid]
            elif pid not in procs or pid in ("0", "1") or len(chain) > 64:
                label = UNATTRIBUTED
            else:
                chain.append(pid)
                ppid, _, _, command = procs[pid]
                label = next((name for name, paths in labels if any(p in command for p in paths)), None)
                pid = ppid
        for item in chain:
            memo[item] = label
        return label

    return resolve


def speed_census(state, snaps, now, labels):
    """`snaps` [(t, ps snapshot)] taken across the sampler's sleep: processes born between two snapshots count
    as forks of their ancestor chain's launchd label; long-lived ones add their CPU since the last run's
    snapshot, keyed (pid, start), to their label. Unresolved is `unattributed`."""
    if len(snaps) < 2:
        return
    resolve = label_resolver(labels)
    acc = speed_day(state, now)
    census = acc.setdefault("census", {})
    for (_, before), (_, after) in zip(snaps, snaps[1:]):
        for pid in after.keys() - before.keys():
            origin = resolve(after, pid)
            census[origin] = census.get(origin, 0) + 1
    acc["census_s"] = round(acc.get("census_s", 0) + snaps[-1][0] - snaps[0][0], 3)
    speed = speed_state(state)
    previous, previous_t, current = speed.get("ps", {}), speed.get("ps_t"), {}
    cpu = acc.setdefault("label_cpu_s", {})
    for pid, (_, secs, start, _) in snaps[-1][1].items():
        key = pid + "|" + start
        current[key] = secs
        if key in previous:
            used = secs - previous[key]
        else:
            try:
                used = secs if previous_t and time.mktime(time.strptime(start, "%a %b %d %H:%M:%S %Y")) >= previous_t \
                    else 0.0
            except ValueError:
                used = 0.0
        if used > 0:
            label = resolve(snaps[-1][1], pid)
            cpu[label] = round(cpu.get(label, 0.0) + used, 2)
    speed["ps"], speed["ps_t"] = current, now


# ---------------------------------------------------------------- hook batches


def hook_slots(hooks, tools):
    """Every (event, tool) a synchronous hook key can run for; the tool is "" off the tool events."""
    slots = {}
    for hook in hooks:
        if hook["async"] or hook["event"] not in SYNC_EVENTS:
            continue
        mine = slots.setdefault(hook_key(hook["command"]), set())
        if hook["event"] in TOOL_EVENTS:
            mine.update((hook["event"], tool) for tool in tools if matches(hook["matcher"], tool))
        else:
            mine.add((hook["event"], ""))
    return {key: value for key, value in slots.items() if value}


def hook_batches(runs, slots, now):
    """Hooks of one event run together: runs of one Claude process (ppid) that start within BATCH_SPAN_S
    of the batch's first run, no key twice, and share at least one (event, tool) they could all run for."""
    by_ppid = {}
    for run in runs:
        if run[1] in slots and run[0] <= now and not run[1].startswith(STOP_PART):
            by_ppid.setdefault(run[5], []).append(run)
    batches = []
    for ppid, items in by_ppid.items():
        items.sort(key=lambda r: r[4])
        live = []
        for run in items:
            live = [b for b in live if run[4] - b["t0"] <= BATCH_SPAN_S]
            for batch in live:
                both = batch["slots"] & slots[run[1]]
                if run[1] not in batch["runs"] and both:
                    batch["runs"][run[1]] = run
                    batch["slots"] = both
                    break
            else:
                batch = {"t0": run[4], "ppid": ppid, "runs": {run[1]: run}, "slots": set(slots[run[1]])}
                live.append(batch)
                batches.append(batch)
    for batch in batches:
        last = max(batch["runs"].values(), key=lambda r: r[0])
        batch.update(end=last[0], by=last[1], ms=(last[0] - batch["t0"]) * 1000.0)
    return batches


def join_calls(batches, calls):
    """Pins a batch to its tool call: a PreToolUse batch starts just after the call's tool_use, a
    PostToolUse one ends just before its tool_result. A ppid's session comes from its unambiguous
    Pre joins and then rules out other chats' calls."""
    by_start = sorted(calls, key=lambda c: c[1])
    starts = [c[1] for c in by_start]
    by_end = sorted(calls, key=lambda c: c[1] + c[5])
    ends = [c[1] + c[5] for c in by_end]

    def pre_candidates(batch):
        low = bisect.bisect_left(starts, batch["t0"] - PRE_JOIN_S[1])
        high = bisect.bisect_right(starts, batch["t0"] - PRE_JOIN_S[0])
        return [c for c in by_start[low:high] if ("PreToolUse", c[3]) in batch["slots"]]

    votes = {}
    for batch in batches:
        found = pre_candidates(batch)
        if len(found) == 1 and len(found[0]) > 8:
            tally = votes.setdefault(batch["ppid"], {})
            tally[found[0][8]] = tally.get(found[0][8], 0) + 1
    owner = {}
    for ppid, tally in votes.items():
        best = max(sorted(tally), key=tally.get)
        if tally[best] >= 2 and tally[best] >= 0.6 * sum(tally.values()):
            owner[ppid] = best

    def fits(batch, call):
        mine = owner.get(batch["ppid"])
        return not mine or len(call) <= 8 or call[8] == mine

    ordered = sorted(batches, key=lambda b: b["t0"])
    taken = set()
    for batch in ordered:
        found = [c for c in pre_candidates(batch) if fits(batch, c) and ("pre", c[7]) not in taken]
        if found:
            call = min(found, key=lambda c: abs(batch["t0"] - c[1]))
            batch.update(call=call, event="PreToolUse")
            taken.add(("pre", call[7]))
    for batch in ordered:
        if "call" in batch or not any(s[0] == "PostToolUse" for s in batch["slots"]):
            continue
        low = bisect.bisect_left(ends, batch["end"] + POST_JOIN_S[0])
        high = bisect.bisect_right(ends, batch["end"] + POST_JOIN_S[1])
        found = [c for c in by_end[low:high] if c[1] <= batch["t0"] and ("PostToolUse", c[3]) in batch["slots"]
                 and fits(batch, c) and ("post", c[7]) not in taken]
        if found:
            call = min(found, key=lambda c: c[1] + c[5] - batch["end"])
            batch.update(call=call, event="PostToolUse")
            taken.add(("post", call[7]))
    return owner


def batch_parts(batches):
    """{hook: [its ms, the floor's ms without it]} over a floor's batches: a batch without the hook ends at its
    other runs' last end, from their first start."""
    keys = {key for batch in batches for key in batch["runs"]}
    parts = {}
    for key in keys:
        own = cf = 0.0
        for batch in batches:
            others = [r for k, r in batch["runs"].items() if k != key]
            if key in batch["runs"]:
                own += batch["runs"][key][2]
                cf += (max(r[0] for r in others) - min(r[4] for r in others)) * 1000.0 if others else 0.0
            else:
                cf += batch["ms"]
        parts[key] = [round(own, 1), round(cf, 1)]
    return parts


def floor_class(call):
    if call[3] == "Bash":
        return "bash:trivial" if call[4] else "bash:other"
    if call[3] in EDIT_TOOLS:
        return "edit"
    return "read" if call[3] == "Read" else "tool"


def hook_view(hooks, runs, calls, now, repos=None, since=None):
    tools = {c[3] for c in calls} | {"Bash", "Read", OTHER_TOOL} | EDIT_TOOLS
    slots = hook_slots(hooks, tools)
    seen = {r[1] for r in runs}
    expected = {}
    for key, mine in slots.items():
        if key in seen:
            for slot in mine:
                expected.setdefault(slot, set()).add(key)
    batches = hook_batches(runs, slots, now)
    owner = join_calls(batches, calls)
    sizes = {}
    for call in calls:
        if len(call) > 9 and call[9] is not None:
            sizes.setdefault(call[8], []).append((call[1], call[9]))
    for items in sizes.values():
        items.sort()

    def size_at(session, t):
        items = sizes.get(session) or []
        index = bisect.bisect_right(items, (t, float("inf"))) - 1
        return items[index][1] if index >= 0 else None

    repos = repos or {}

    def repos_at(session, t):
        items = repos.get(session)
        if not items:
            return None
        index = bisect.bisect_right(items, (t, float("inf"))) - 1
        return items[max(index, 0)][1]

    per_call, floors, split = {}, [], {}
    tool_batches = joined = 0
    for batch in batches:
        call = batch.get("call")
        if call is not None:
            per_call.setdefault(call[7], [call, None, None])[1 if batch["event"] == "PreToolUse" else 2] = batch
            kb = call[9] if len(call) > 9 else None
            session = call[8] if len(call) > 8 else None
        else:
            event = min(batch["slots"], key=lambda s: (len(expected.get(s, ())), s))[0]
            session = owner.get(batch["ppid"])
            kb = size_at(session, batch["t0"]) if session else None
            if event not in TOOL_EVENTS:
                batch["event"] = event
                floors.append({"t": batch["t0"], "cls": "event:" + event, "ms": batch["ms"], "by": batch["by"],
                               "kb": kb, "batches": [batch], "ppid": batch["ppid"]})
        if since is not None and batch["t0"] <= since:
            continue
        if call is not None or batch.get("event") is None:
            tool_batches += 1
            joined += call is not None
        count = repos_at(session, batch["t0"]) if session else None
        for run in batch["runs"].values():
            entry = split.setdefault(run[1], {part: [] for part in (
                "trivial", "other", "trivial1", "other1", "small", "mid", "big", "few", "some", "many")})
            if call is not None and call[3] == "Bash":
                entry["trivial" if call[4] else "other"].append(run[2])
                if run[0] >= now - 3600:
                    entry["trivial1" if call[4] else "other1"].append(run[2])
            if kb is not None:
                entry["small" if kb < SIZE_SMALL_KB else "big" if kb >= SIZE_BIG_KB else "mid"].append(run[2])
            if count is not None:
                entry["few" if count <= REPOS_FEW else "many" if count >= REPOS_MANY else "some"].append(run[2])
    for call, pre, post in per_call.values():
        if ((expected.get(("PreToolUse", call[3])) and not pre)
                or (expected.get(("PostToolUse", call[3])) and not post)):
            continue
        floors.append({"t": call[1], "cls": floor_class(call), "ms": sum(b["ms"] for b in (pre, post) if b),
                       "pre": pre and pre["ms"], "post": post and post["ms"],
                       "pre_by": pre and pre["by"], "post_by": post and post["by"], "id": call[7],
                       "kb": call[9] if len(call) > 9 else None, "batches": [b for b in (pre, post) if b]})
    by_call = {tid: sum(b["ms"] for b in (pre, post) if b) for tid, (_, pre, post) in per_call.items()}
    return {"floors": floors, "split": split, "joined": joined, "tool_batches": tool_batches, "by_call": by_call}


def session_repos(journal, calls, now):
    sessions = {c[8] for c in calls if len(c) > 8 and c[8]}
    folder = review_journal_dir()
    try:
        files = {name[:8]: name for name in os.listdir(folder) if name.endswith(".repos")}
    except OSError:
        files = {}
    history = journal.setdefault("repos", {})
    for session in [k for k in history if k not in sessions]:
        del history[session]
    for session in sessions & set(files):
        try:
            with open(os.path.join(folder, files[session]), "rb") as handle:
                count = handle.read().count(b"\n")
        except OSError:
            continue
        items = history.setdefault(session, [])
        if not items or items[-1][1] != count:
            items.append([now, count])
    return {k: [tuple(i) for i in v] for k, v in history.items()}


# ---------------------------------------------------------------- growth


def count_entries(path):
    try:
        return sum(1 for _ in os.scandir(path))
    except OSError:
        return None


def du_bytes(path):
    try:
        out = subprocess.run(["/usr/bin/du", "-sk", path], capture_output=True, text=True, timeout=60).stdout
        return int(out.split()[0]) * 1024
    except (OSError, subprocess.SubprocessError, ValueError, IndexError):
        return None


def loose_objects(top):
    try:
        out = subprocess.run(["git", "-C", top, "count-objects", "-v"], capture_output=True, text=True,
                             timeout=30).stdout
    except (OSError, subprocess.SubprocessError):
        return None, None
    values = dict(line.split(": ", 1) for line in out.splitlines() if ": " in line)
    try:
        return int(values["count"]), int(values["size"]) * 1024
    except (KeyError, ValueError):
        return None, None


def count_matching(path, pattern):
    count = size = 0
    try:
        for entry in os.scandir(path):
            if pattern.search(entry.name):
                count += 1
                size += entry.stat(follow_symlinks=False).st_size
    except OSError:
        return None
    return [count, size]


def review_journal_dir():
    return os.path.join(base_home(), ".cache", "claude", "review-journal")


def growth_sample(now, tops):
    stores = {}
    review_journal = review_journal_dir()
    for name, path in (("instruction-watch reverts", os.path.join(watch_state(), "reverts")),
                       ("instruction-watch read-only notes", os.path.join(watch_state(), "readonly")),
                       ("instruction-watch inflight", os.path.join(watch_state(), "inflight")),
                       ("instruction-watch closed", os.path.join(watch_state(), "closed")),
                       ("review journal", review_journal),
                       ("context-nudge state", os.environ.get("CONTEXT_NUDGE_STATE_DIR")
                        or os.path.join(base_home(), ".cache", "claude-context-nudge")),
                       ("statusline cache files", statusline_cache()),
                       ("review benches", os.path.join(worker_stats_dir(), "benches")),
                       ("harness doctor state", state_dir())):
        if os.path.isdir(path):
            stores[name] = [count_entries(path), du_bytes(path)]
    for name, path, pattern in (("instruction-watch temp leftovers", watch_state(), re.compile(r"\.tsv\.\d+$")),
                                ("review journal .hashes, .ref, .heads", review_journal,
                                 re.compile(r"\.(hashes|ref|heads)$")),
                                ("review journal .repos", review_journal, re.compile(r"\.repos$"))):
        found = count_matching(path, pattern) if os.path.isdir(path) else None
        if found:
            stores[name] = found
    if os.path.isdir(projects_dir()):
        stores["transcripts"] = [len(transcript_files()), du_bytes(projects_dir())]
    for top in sorted(tops):
        if not os.path.isdir(os.path.join(top, ".git")):
            continue
        count, size = loose_objects(top)
        if count is not None:
            stores["loose git objects · " + os.path.basename(top)] = [count, size]
    return {"day": local_day(now), "t": now, "stores": stores}


def load_growth():
    rows = []
    try:
        with open(os.path.join(state_dir(), "growth.jsonl")) as handle:
            for line in handle:
                try:
                    rows.append(json.loads(line))
                except ValueError:
                    continue
    except OSError:
        pass
    return rows


# ---------------------------------------------------------------- tests journal


def load_tests(now):
    rows = []
    try:
        with open(os.path.join(statusline_cache(), "test-history.jsonl")) as handle:
            for line in handle:
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                if (isinstance(row, dict) and isinstance(row.get("end"), (int, float))
                        and isinstance(row.get("secs"), (int, float)) and now - row["end"] <= 28 * 86400):
                    rows.append(row)
    except OSError:
        pass
    starts = {}
    for mark in read_jsonl(os.path.join(statusline_cache(), "test-scope.jsonl")) or ():
        if isinstance(mark.get("start"), (int, float)) and mark.get("label"):
            starts.setdefault((mark["label"], mark.get("repo_root")), []).append(
                (mark["start"], mark.get("scope") or "partial"))
    for row in rows:
        marks = starts.get((row.get("label"), row.get("repo_root")))
        if marks:
            began = row["end"] - row["secs"]
            joined = sorted((abs(began - start), scope) for start, scope in marks if abs(began - start) <= SCOPE_JOIN_S)
            row["scope"] = joined[0][1] if joined else "full"
            row["partial"] = row["scope"] != "full"
            row["scoped"] = began >= min(start for start, _ in marks) - SCOPE_JOIN_S
    return rows


def union_secs(intervals):
    total, last_end = 0.0, None
    for start, end in sorted(intervals):
        if last_end is None or start > last_end:
            total += end - start
            last_end = end
        elif end > last_end:
            total += end - last_end
            last_end = end
    return total


def peak_overlap(intervals):
    points = sorted([(s, 1) for s, _ in intervals] + [(e, -1) for _, e in intervals], key=lambda p: (p[0], p[1]))
    peak = level = 0
    for _, step in points:
        level += step
        peak = max(peak, level)
    return peak


def running_now(now):
    out = []
    for path in glob.glob(os.path.join(statusline_cache(), "work-*")):
        try:
            if now - os.path.getmtime(path) > 30:
                continue
            with open(path, errors="replace") as handle:
                for line in handle:
                    parts = line.rstrip("\n").split("\t")
                    if len(parts) >= 5 and parts[0] == "main" and parts[1] == "tests" and parts[2].isdigit():
                        out.append({"repo": parts[3], "label": parts[4], "secs": max(0, now - int(parts[2]))})
        except OSError:
            continue
    return sorted(out, key=lambda r: -r["secs"])


# ---------------------------------------------------------------- document


def row(cells, red=(), dim=False, menu=None, key=None, say=None, green=(), judge=None, head=None):
    out = {"cells": [str(c) for c in cells], "red": sorted(set(red)), "dim": bool(dim)}
    if head:
        out["head"] = head
    if green:
        out["green"] = sorted(set(green))
    if menu:
        out["menu"] = menu
    if key:
        out["key"] = key
    if say:
        out["say"] = say
    if judge:
        out["judge"] = [j for j in (judge if isinstance(judge, list) else [judge]) if j]
    return out


def verdict(rule, ident, value, limit, unit, window_h, exposure, level, fact=None, values=(), evidence=(), bad=None):
    values = sorted(v for v in values if v is not None)
    near = ({"p50": round(percentile(values, 0.5), 3), "p95": round(percentile(values, 0.95), 3)}
            if values else None)
    if bad is None and values and limit is not None:
        bad = sum(1 for v in values if v > limit)
    elif bad is None and unit in COUNT_UNITS and value is not None:
        bad = int(value)
    return {"rule": rule, "ident": str(ident), "value": None if value is None else round(float(value), 3),
            "limit": limit, "unit": unit, "window_h": window_h, "exposure": int(exposure or 0),
            "level": level, "fact": fact, "near": near, "evidence": list(evidence)[:3], "bad": bad}


def evidence(at, ref, excerpt="", account=""):
    return {"at": iso_time(at), "ref": str(ref), "account": account, "excerpt": str(excerpt)[:300]}


def iso_time(at):
    return None if at is None else datetime.datetime.fromtimestamp(at).astimezone().isoformat(timespec="seconds")


def line(text, dim=True, red=False, menu=None):
    out = {"cells": [text], "free": True, "red": [0] if red else [], "dim": dim and not red}
    if menu:
        out["menu"] = menu
    return out


def num(value, scale=1.0):
    if value is None:
        return "–"
    value = value / scale
    return "%.1f" % value if value < 10 else fmt_count(round(value))


def fmt_long(secs):
    secs = int(round(secs or 0))
    if secs < 60:
        return "%d s" % secs
    if secs < 3600:
        return "%d min" % round(secs / 60.0)
    return "%d h %02d min" % (secs // 3600, secs % 3600 // 60)


def section(name, rows, columns, right, lead=(), nav=(), ok="", blind=""):
    problems = [r for r in rows if r.get("red")]
    watches = [r for r in rows if not r.get("red") and not r.get("dim") and r.get("say")]
    state = "problem" if problems else "watch" if watches else "blind" if blind else "ok"
    first = (problems or watches or [None])[0]
    fact = (first.get("head") or first.get("say") if first else None) or (blind if state == "blind" else ok)
    return {"name": name, "state": state, "fact": fact, "lead": list(lead), "columns": columns, "right": right,
            "rows": rows, "nav": list(nav), "ok": ok, "blind": blind}


WAIT_COLUMNS = ["", "calls 1 h", "wait s 1 h", "wait s 7 d", "cuts 1 h"]
WAIT_RIGHT = [False, True, True, True, True]


def event_waits(printed, cuts, event):
    occurrences = {}
    for sample in printed:
        if sample[3] == event:
            occurrences.setdefault(sample[7] or sample[1], []).append((sample[1], sample[5] / 1000.0, False))
    for cut in cuts:
        if cut[3] == event:
            occurrences.setdefault(cut[8] or cut[1], []).append((cut[1], (cut[5] or cut[6]) / 1000.0, True))
    return [(min(x[0] for x in v), max(x[1] for x in v), any(x[2] for x in v)) for v in occurrences.values()]


def waits_section(calls, cuts, samples_h, week, now):
    hour = now - 3600
    cut_tids = {c[8] for c in cuts if c[3] in ("PreToolUse", "PostToolUse") and c[8]}
    groups = {}
    for call in calls:
        key = wait_group(call)
        if key:
            groups.setdefault(key, []).append(call)
    fine = fmt_s(LIMITS["call_note_s"])

    def usual(key):
        return num(hist_percentile(week["waits"].get(key), 0.5))

    def make(label, items, key, subject):
        recent = [c for c in items if c[1] >= hour]
        n1 = len(recent)
        m1 = median([c[5] for c in recent])
        cut1 = sum(1 for c in recent if c[7] in cut_tids)
        red = [{3: 2, 6: 4}[i] for i in waits_red(n1, m1, cut1)]
        few = n1 < LIMITS["call_min_calls"]
        slow = m1 is not None and m1 > LIMITS["call_s" if few else "call_note_s"]
        watch = not red and (slow or cut1 > 0)
        if 4 in red and 2 not in red or (watch and not slow):
            say = "hooks cut %d of %d calls in the last hour (%s)" % (cut1, n1, label)
        elif red or watch:
            say = "%s waits %s, fine under %s" % (subject, fmt_s(m1), fine)
            if few:
                say += ", only %d call%s" % (n1, "" if n1 == 1 else "s")
        else:
            say = None
        slowest = sorted(recent, key=lambda c: -c[5])[:3]
        proof = [evidence(c[1], "tool_use " + c[7], "%s %.1f s" % (c[3], c[5]), c[8] if len(c) > 8 else "")
                 for c in slowest]
        cut_proof = [evidence(c[1], "tool_use " + c[7], "%s cut by a hook" % c[3]) for c in recent if c[7] in cut_tids]
        judges = [verdict("wait", key, m1, LIMITS["call_s"], "s", 1, n1,
                          "red" if 2 in red else "watch" if slow else None, say if slow or 2 in red else None,
                          [c[5] for c in recent], proof),
                  verdict("wait_cut", key, cut1, LIMITS["cut_min"], "cuts", 1, n1,
                          "red" if 4 in red else "watch" if cut1 else None,
                          "hooks cut %d of %d calls in the last hour (%s)" % (cut1, n1, label), (), cut_proof)]
        return row([label, fmt_count(n1), num(m1), usual(key), fmt_count(cut1)],
                   red, dim=not red and not watch, key="wait:" + key, say=say, judge=judges)

    projects = sorted({k[5:] for k in groups if k.startswith("bash:")}, key=lambda p: -len(groups["bash:" + p]))
    project_rows = [make("Bash · " + clip(p, 22), groups["bash:" + p], "bash:" + p, "a Bash call in " + clip(p, 22))
                    for p in projects]
    rows = project_rows[:5] + [r for r in project_rows[5:] if not r["dim"]]
    nav = []
    if len(project_rows) > len(rows):
        nav.append(line("all %d projects" % len(project_rows),
                        menu=section("", project_rows, WAIT_COLUMNS, WAIT_RIGHT)))
    if "edit" in groups:
        rows.append(make("Edit, Write", groups["edit"], "edit", "an Edit"))
    if "read" in groups:
        rows.append(make("Read", groups["read"], "read", "a Read"))

    for event, label, _ in EVENT_ROWS:
        recent = [w for w in event_waits(samples_h, cuts, event) if w[0] >= hour]
        if not recent:
            continue
        m1 = median([w[1] for w in recent])
        cut1 = sum(1 for w in recent if w[2])
        red = []
        if m1 is not None and len(recent) >= 3 and m1 > LIMITS["event_s"]:
            red.append(2)
        if cut1 >= LIMITS["cut_min"]:
            red.append(4)
        cut_say = "hooks cut %d %ss in the last hour" % (cut1, label)
        say = ("a %s waits %s" % (label, fmt_s(m1)) if 2 in red else cut_say) if red or cut1 else None
        proof = [evidence(w[0], "%s at %d" % (event, w[0]), "%.1f s%s" % (w[1], ", cut" if w[2] else ""))
                 for w in sorted(recent, key=lambda w: -w[1])[:3]]
        rows.append(row([label, fmt_count(len(recent)), num(m1), usual("event:" + event), fmt_count(cut1)], red,
                        dim=not red and not cut1, key="wait:event:" + event, say=say,
                        judge=[verdict("wait", "event:" + event, m1, LIMITS["event_s"], "s", 1, len(recent),
                                       "red" if 2 in red else None, say, [w[1] for w in recent], proof),
                               verdict("wait_cut", "event:" + event, cut1, LIMITS["cut_min"], "cuts", 1, len(recent),
                                       "red" if 4 in red else "watch" if cut1 else None, cut_say,
                                       (), [evidence(w[0], "%s at %d" % (event, w[0]), "cut after %.1f s" % w[1])
                                            for w in recent if w[2]])]))
    overall = [c for k, items in groups.items() if k.startswith("bash:") for c in items if c[1] >= hour]
    m_all = median([c[5] for c in overall])
    return section("Waits", rows, WAIT_COLUMNS, WAIT_RIGHT, nav=nav,
                   ok="a Bash call waits %s, fine under %s" % (fmt_s(m_all), fine) if m_all is not None
                   else "no tool call in the last hour")


def waits_red(n1, m1, cut1):
    red = []
    if m1 is not None and n1 >= LIMITS["call_min_calls"] and m1 > LIMITS["call_s"]:
        red.append(3)
    if n1 and cut1 >= LIMITS["cut_min"] and cut1 / n1 > LIMITS["cut_share"]:
        red.append(6)
    return red


def wait_group(call):
    if call[6] == "h":
        return None
    if call[3] == "Bash" and call[4]:
        return "bash:" + call[2]
    if call[3] in EDIT_TOOLS:
        return "edit"
    return "read" if call[3] == "Read" else None


def merge_windows(windows):
    merged = []
    for start, end in sorted(windows):
        if merged and start <= merged[-1][1]:
            merged[-1][1] = max(merged[-1][1], end)
        else:
            merged.append([start, end])
    return merged


def slow_windows(calls, cuts, since, now):
    """The periods a Waits call row was red, replayed on a 5-minute grid; LLM doctor's mark_slow reads
    them as `local_slow` to tell this Mac's slowness from the model's."""
    cut_tids = {c[8] for c in cuts if c[3] in ("PreToolUse", "PostToolUse") and c[8]}
    groups = {}
    for call in calls:
        key = wait_group(call)
        if key:
            groups.setdefault(key, []).append(call)
    windows = []
    first = (int(since) // SLOW_STEP_S + 1) * SLOW_STEP_S
    for items in groups.values():
        items.sort(key=lambda c: c[1])
        times = [c[1] for c in items]
        for t in range(first, int(now) + 1, SLOW_STEP_S):
            recent = items[bisect.bisect_left(times, t - 3600):bisect.bisect_right(times, t)]
            if not recent:
                continue
            cut1 = sum(1 for c in recent if c[7] in cut_tids)
            if not waits_red(len(recent), median([c[5] for c in recent]), cut1):
                continue
            slow = [c for c in recent if c[5] > LIMITS["call_s"] or c[7] in cut_tids]
            if slow:
                windows.append([int(slow[0][1]), int(max(c[1] + c[5] for c in slow)) + 1])
    return merge_windows(windows)


def days_between(start, end):
    days, t = [], end
    while t >= start - 86400:
        day = local_day(t)
        if day >= local_day(start) and day not in days:
            days.append(day)
        t -= 3600
    return days


def local_slow(state, now, new_events, write):
    slow = state.get("slow") or {}
    since = max(now - EVENT_DAYS * 86400, (slow.get("upto") or 0) - 3600)
    events = load_events(days_between(since - 3600, now)) + ([] if write else new_events)
    calls = [e for e in events if e[0] == "c" and e[1] >= since - 3600]
    cuts = [e for e in events if e[0] == "x" and e[1] >= since - 3600]
    windows = merge_windows([w for w in slow.get("windows") or [] if w[1] >= now - EVENT_DAYS * 86400]
                            + slow_windows(calls, cuts, since, now))
    state["slow"] = {"upto": int(now) // SLOW_STEP_S * SLOW_STEP_S, "windows": windows}
    return windows


def slow_section(windows, now):
    day = now - 86400
    total = sum(min(e, now) - max(s, day) for s, e in windows if e > day)
    rows = [row([time.strftime("%m-%d %H:%M", time.localtime(s)), time.strftime("%H:%M", time.localtime(e)),
                 num(e - s, 60.0)]) for s, e in sorted(windows, key=lambda w: -w[0])[:12]]
    last = max(e for _, e in windows) if windows else None
    out = section("Slow periods", rows, ["from", "to", "lasted min"], [False, False, True],
                  ok="no slow period in the last 24 h" + (
                      ", the last one ended %s" % time.strftime("%m-%d", time.localtime(last)) if last else ""))
    if total:
        out["state"] = "watch"
        out["fact"] = "tool calls were slow %s of the last 24 h, last until %s" % (
            fmt_long(total), time.strftime("%H:%M", time.localtime(last)))
    return out


HOOK_COLUMNS = ["hook", "when", "median ms 24 h", "min 24 h", "cuts 24 h"]
HOOK_RIGHT = [False, False, True, True, True]
HOOK_WHEN = {"SessionStart": "chat start", "UserPromptSubmit": "each message", "Stop": "turn end",
             "SubagentStop": "subagent end", "PreCompact": "compaction", "SessionEnd": "chat end",
             "Notification": "notification"}
HOOK_WAITERS = {"SessionStart": "chat starts", "UserPromptSubmit": "messages", "Stop": "turn ends",
                "SubagentStop": "subagent ends"}


def hook_when(hook):
    event, matcher = hook["event"], hook["matcher"] if hook["matcher"] not in ("", "*") else "any tool"
    if event == "PreToolUse":
        return clip("before " + matcher, 20)
    if event == "PostToolUse":
        return clip("after " + matcher, 20)
    return HOOK_WHEN.get(event, event)


def attribute_post_cuts(cuts, calls, hooks, hooks_since):
    durations = {c[7]: (c[3], c[5]) for c in calls}
    out = []
    for cut in cuts:
        if cut[3] != "PostToolUse" or cut[4]:
            out.append((cut, cut[4]))
            continue
        tool, seconds = durations.get(cut[8], (cut[7], None))
        if seconds is None or cut[1] < hooks_since:
            out.append((cut, ""))
            continue
        candidates = []
        for hook in hooks:
            if hook["event"] != "PostToolUse" or hook["async"] or not matches(hook["matcher"], tool):
                continue
            limit = float(hook["timeout"] or DEFAULT_HOOK_TIMEOUT_S)
            if seconds - max(3.0, 0.2 * seconds) <= limit <= seconds + 1.0:
                candidates.append((limit, hook["command"]))
        if candidates:
            top = max(c[0] for c in candidates)
            names = sorted({c[1] for c in candidates if c[0] == top})
            out.append((cut, names[0] if len(names) == 1 else " | ".join(names)))
        else:
            out.append((cut, ""))
    return out


def hooks_section(hooks, calls, cuts, samples_h, hooks_since, timed24, timed1, now, split=None, fast=None,
                  unjournaled=None):
    hour = now - 3600
    attributed = attribute_post_cuts(cuts, calls, hooks, hooks_since)
    groups = {}
    for hook in hooks:
        groups.setdefault(hook_key(hook["command"]), []).append(hook)
    split = split or {}
    tool_counts = {}
    for call in calls:
        tool_counts[call[3]] = tool_counts.get(call[3], 0) + 1
    full, risky, costly, trivial_rows, size_rows, repo_rows, loose = [], [], [], [], [], [], []
    for key, members in groups.items():
        first = members[0]
        pairs = {(h["event"], h["command"]) for h in members}
        if key in timed24:
            count, count1 = timed24[key][0], timed1[key][0] if key in timed1 else 0
            p50, p50_1 = hist_percentile(timed24[key], 0.5), hist_percentile(timed1.get(key), 0.5)
            total = timed24[key][1] / 1000.0
        else:
            mine_h = [s for s in samples_h if (s[3], s[4]) in pairs]
            times = [s[5] / 1000.0 for s in mine_h]
            times1 = [s[5] / 1000.0 for s in mine_h if s[1] >= hour]
            count, count1 = len(times), len(times1)
            p50, p50_1 = percentile(times, 0.5), percentile(times1, 0.5)
            total = None
        mine = [cut for cut, name in attributed if (cut[3], name) in pairs]
        cut1 = sum(1 for cut in mine if cut[1] >= hour)
        ambiguous = sum(1 for cut, name in attributed if " | " in name
                        and any((cut[3], command) in pairs for command in name.split(" | ")))
        tool_hooks = [h for h in members if h["event"] in ("PreToolUse", "PostToolUse")]
        calls1 = None
        if tool_hooks:
            calls1 = sum(1 for c in calls if c[1] >= hour and any(matches(h["matcher"], c[3]) for h in tool_hooks))
        limit = first["timeout"]
        synchronous = any(h["event"] in SYNC_EVENTS and not h["async"] for h in members)
        name = hook_label(first["command"])
        red = []
        if cut1 >= LIMITS["cut_min"] and (not calls1 or cut1 / calls1 > LIMITS["cut_share"]):
            red.append(4)
        if (synchronous and p50_1 is not None and count1 >= LIMITS["hook_min_samples"]
                and p50_1 > LIMITS["hook_p50_s"]):
            red.append(2)
        outside = (unjournaled is not None and key not in timed24
                   and not all(hook_journaled(h["command"]) for h in members)
                   and hook_ident(first["command"]) not in unjournaled)
        if outside:
            loose.append((name, first["event"], hook_ident(first["command"]), count))
        watch = (not red and synchronous and p50 is not None and count >= 3 and p50 > LIMITS["hook_p50_s"])
        for hook in members:
            if hook["event"] in SYNC_EVENTS and not hook["async"] and (not hook["timeout"] or niced(hook["command"])):
                risky.append(hook)
        waiter = HOOK_WAITERS.get(first["event"]) or "%s calls" % (
            first["matcher"] if re.fullmatch(r"\w+", first["matcher"]) else "tool")
        recent_ms, recent_span = ((None, "") if total is None
                                  else (p50_1 * 1000, "in the last hour") if count1 >= LIMITS["hook_min_samples"]
                                  else (p50 * 1000, "in 24 h") if count >= LIMITS["hook_min_samples"] else (None, ""))
        mine_split = split.get(key) or {}
        enough = lambda part: len(mine_split.get(part) or ()) >= LIMITS["split_min_runs"]
        span = "1" if mine_split.get("trivial1") or mine_split.get("other1") else ""
        trivial_ms, other_ms = median(mine_split.get("trivial" + span)), median(mine_split.get("other" + span))
        full_work = (enough("trivial" + span) and enough("other" + span) and trivial_ms > LIMITS["full_work_min_ms"]
                     and trivial_ms >= LIMITS["full_work_ratio"] * other_ms)

        def grows_between(low, high):
            low_ms, high_ms = median(mine_split.get(low)), median(mine_split.get(high))
            return (enough(low) and enough(high) and high_ms >= LIMITS["history_ratio"] * low_ms
                    and high_ms - low_ms > LIMITS["history_min_ms"]), low_ms, high_ms

        grows, small_ms, big_ms = grows_between("small", "big")
        grows_repos, few_ms, many_ms = grows_between("few", "many")
        tool_calls = sum(n for tool, n in tool_counts.items() if any(matches(h["matcher"], tool) for h in tool_hooks))
        if every_call(members) and total is not None and p50 is not None:
            costly.append((p50 * tool_calls, name, tool_calls, p50))
        if 2 in red:
            say = "%d %s waited %s for %s in the last hour" % (count1, waiter, fmt_s(p50_1), name)
        elif red:
            say = "%s was cut %d times in the last hour at its %s limit" % (
                name, cut1, fmt_s(float(limit or DEFAULT_HOOK_TIMEOUT_S)))
        elif watch:
            say = "%d %s waited %s for %s in 24 h" % (count, waiter, fmt_s(p50), name)
        elif synchronous and recent_ms is not None and recent_ms > LIMITS["hook_note_ms"]:
            say = "%s takes %s ms a run %s, fine under %d ms" % (name, num(recent_ms), recent_span,
                                                                LIMITS["hook_note_ms"])
        elif every_call(members) and recent_ms is not None and recent_ms > LIMITS["every_call_ms"]:
            say = "%s costs %s ms on every tool call, %s calls in 24 h, fine under %d ms" % (
                name, num(recent_ms), fmt_count(tool_calls), LIMITS["every_call_ms"])
        elif grows:
            say = "%s takes %s ms in transcripts over %d MB, %s ms under %d MB" % (
                name, num(big_ms), SIZE_BIG_KB // 1024, num(small_ms), SIZE_SMALL_KB // 1024)
        elif grows_repos:
            say = "%s takes %s ms in chats with %d+ repositories, %s ms with up to %d" % (
                name, num(many_ms), REPOS_MANY, num(few_ms), REPOS_FEW)
        elif full_work:
            say = "%s takes %s ms on a trivial Bash call, as on the rest (%s ms), %s" % (
                name, num(trivial_ms), num(other_ms), "in the last hour" if span else "in 24 h")
        elif cut1:
            say = "%s was cut %d times in the last hour at its %s limit, under %d" % (
                name, cut1, fmt_s(float(limit or DEFAULT_HOOK_TIMEOUT_S)), LIMITS["cut_min"])
        else:
            say = None
        watch = watch or (not red and say is not None)
        hook_values = [s[5] / 1000.0 for s in samples_h if (s[3], s[4]) in pairs]
        judges = [verdict("hook_p50", key, p50_1 if count1 else p50, LIMITS["hook_p50_s"], "s", 1 if count1 else 24,
                          count1 or count, "red" if 2 in red else "watch" if watch and not red and synchronous
                          and p50 is not None and p50 > LIMITS["hook_p50_s"] else None,
                          values=hook_values),
                  verdict("hook_cut", key, cut1, LIMITS["cut_min"], "cuts", 1, calls1 if calls1 is not None else count1,
                          "red" if 4 in red else "watch" if cut1 else None,
                          evidence=[evidence(cut[1], "tool_use %s" % cut[8] if cut[8] else "cut %s %s" % (
                              cut[3], cut[1]), "%s cut after %s ms in %s" % (name, cut[5], cut[2]))
                                    for cut in sorted(mine, key=lambda c: -c[1])[:3]])]
        for rule, applies, hit, value, limit, fact in (
                ("hook_sync", synchronous and recent_ms is not None,
                 recent_ms is not None and recent_ms > LIMITS["hook_note_ms"] and not judges[0]["level"], recent_ms,
                 LIMITS["hook_note_ms"],
                 lambda: "%s takes %s ms a run %s" % (name, num(recent_ms), recent_span)),
                ("hook_every_call", every_call(members) and recent_ms is not None,
                 recent_ms is not None and recent_ms > LIMITS["every_call_ms"],
                 recent_ms, LIMITS["every_call_ms"], lambda: "%s costs %s ms on every tool call, %s calls in 24 h" % (
                     name, num(recent_ms), fmt_count(tool_calls))),
                ("hook_full_work", trivial_ms is not None, full_work, trivial_ms, LIMITS["full_work_min_ms"],
                 lambda: "%s takes %s ms on a trivial Bash call, as on the rest (%s ms)" % (
                     name, num(trivial_ms), num(other_ms))),
                ("hook_grows_size", grows, grows, big_ms, small_ms,
                 lambda: "%s takes %s ms in transcripts over %d MB, %s ms under %d MB" % (
                     name, num(big_ms), SIZE_BIG_KB // 1024, num(small_ms), SIZE_SMALL_KB // 1024)),
                ("hook_grows_repos", grows_repos, grows_repos, many_ms, few_ms,
                 lambda: "%s takes %s ms in chats with %d+ repositories, %s ms with up to %d" % (
                     name, num(many_ms), REPOS_MANY, num(few_ms), REPOS_FEW))):
            if applies:
                judges.append(verdict(rule, key, value, round(limit, 3), "ms", 1 if recent_span == "in the last hour"
                                      or (rule == "hook_full_work" and span) else 24,
                                      count1 if recent_span == "in the last hour" else count,
                                      "watch" if hit and not red else None, fact=fact()))
        if enough("trivial") or enough("other"):
            trivial_rows.append(row([clip(name, 28)] + [num(median(mine_split.get(p))) for p in (
                "trivial1", "other1", "trivial", "other")], dim=not full_work))
        if enough("few") or enough("many"):
            repo_rows.append(row([clip(name, 28)] + [num(median(mine_split.get(p))) for p in ("few", "some", "many")],
                                 dim=not grows_repos))
        if enough("small") or enough("big"):
            size_rows.append(row([clip(name, 28)] + [num(median(mine_split.get(p))) for p in ("small", "mid", "big")],
                                 dim=not grows))
        when = hook_when(first) if len(members) == 1 else clip(hook_when(first), 17) + " +%d" % (len(members) - 1)
        entry = row([clip(name, 28), when, num(None if p50 is None else p50 * 1000), num(total, 60.0),
                     fmt_count(len(mine)) + (" +%d?" % ambiguous if ambiguous else "")], red, dim=not red and not watch,
                    key="hook:" + key, say=say, judge=judges, head=say and say.replace(name, "a hook", 1))
        entry["weight"] = (total if total is not None else sum(times)) + len(mine) * float(
            limit or DEFAULT_HOOK_TIMEOUT_S)
        full.append(entry)
    statusline24, statusline1 = timed24.get(STATUSLINE_KEY), timed1.get(STATUSLINE_KEY)
    if statusline24:
        p50 = hist_percentile(statusline24, 0.5)
        watch = p50 > LIMITS["hook_p50_s"]
        entry = row(["statusline (not a hook)", "each render", num(p50 * 1000), num(statusline24[1] / 60000.0), "–"],
                    dim=not watch, key="hook:statusline",
                    say="the statusline takes %s a render" % fmt_s(p50) if watch else None,
                    judge=[verdict("statusline", "render", p50, LIMITS["hook_p50_s"], "s", 24, statusline24[0],
                                   "watch" if watch else None)])
        entry["weight"] = statusline24[1] / 1000.0
        full.append(entry)
    for key in sorted(k for k in timed24 if k.startswith(MENU_KEY)):
        builds24, builds1 = timed24[key], timed1.get(key)
        p50 = hist_percentile(builds24, 0.5) * 1000
        p50_1 = hist_percentile(builds1, 0.5) * 1000 if builds1 and builds1[0] else None
        red = [2] if (p50_1 is not None and builds1[0] >= LIMITS["menu_min_builds"]
                      and p50_1 > LIMITS["menu_ms"]) else []
        watch = not red and p50 > LIMITS["menu_note_ms"]
        name = menu_label(key)
        say = ("%d menu opens waited %s ms for the %s in the last hour" % (builds1[0], num(p50_1), name) if red
               else "the %s takes %s ms, fine under %d ms" % (name, num(p50), LIMITS["menu_note_ms"]) if watch
               else None)
        entry = row([clip(name, 28), "each open", num(red and p50_1 or p50),
                     num(builds24[1] / 60000.0), "–"], red, dim=not red and not watch, key="hook:menu:" + key[len(MENU_KEY):],
                    say=say, judge=[verdict("menu_build", key[len(MENU_KEY):], p50_1 if red else p50, LIMITS["menu_ms"],
                                            "ms", 1 if red else 24, builds1[0] if red else builds24[0],
                                            "red" if red else "watch" if watch else None)])
        entry["weight"] = builds24[1] / 1000.0
        full.append(entry)
    ranked = sorted(full, key=lambda r: (-len(r["red"]), r["dim"], -r["weight"]))
    rows = [r for r in ranked if not r["dim"]][:6]
    for r in ranked:
        if len(rows) >= 4:
            break
        if r not in rows and r["weight"] > 0:
            rows.append(r)
    unknown = {}
    for cut, name in attributed:
        if not name:
            counts = unknown.setdefault(cut[3], [0, 0])
            counts[1] += 1
            if cut[1] >= hour:
                counts[0] += 1
    for event, (cut1, cut24) in sorted(unknown.items()):
        red = [4] if cut1 >= LIMITS["cut_min"] else []
        rows.append(row(["(which hook is unknown)", hook_when({"event": event, "matcher": ""}), "–", "–",
                         fmt_count(cut24)], red, dim=not red, key="hook:unknown:" + event,
                        say="%d hooks were cut in the last hour, which ones is unknown" % cut1,
                        judge=[verdict("hook_cut", "unknown:" + event, cut1, LIMITS["cut_min"], "cuts", 1, cut24,
                                       "red" if red else "watch" if cut1 else None)]))
    rest = ranked[INVENTORY_ROWS:]
    for r in full:
        r.pop("weight", None)
    nav = [line("top %d of %d hooks" % (INVENTORY_ROWS, len(groups)) if rest else "all %d hooks" % len(groups),
                menu=section("", ranked[:INVENTORY_ROWS], HOOK_COLUMNS, HOOK_RIGHT))]
    if risky:
        nav.append(line("%d hooks can hold a chat up to %d s" % (len(risky), DEFAULT_HOOK_TIMEOUT_S), menu=section(
            "", [row([clip(hook_label(h["command"]), 28), hook_when(h), str(h["timeout"]) if h["timeout"] else "none",
                      "niced" if niced(h["command"]) else ""]) for h in risky],
            ["hook", "when", "limit s", ""], [False, False, True, False])))
    if costly:
        costly.sort(key=lambda c: -c[0])
        nav.append(line("on every tool call: %d hooks, %s min a day" % (len(costly), num(sum(c[0] for c in costly) / 60.0)),
                        menu=section("", [row([clip(name, 28), fmt_count(n), num(p50 * 1000), num(cost / 60.0)],
                                              dim=p50 * 1000 <= LIMITS["every_call_ms"])
                                          for cost, name, n, p50 in costly],
                                     ["hook", "calls 24 h", "median ms 24 h", "median × calls min"],
                                     [False, True, True, True])))
    if trivial_rows:
        flagged = sum(1 for r in trivial_rows if not r["dim"])
        nav.append(line("full work on trivial Bash: %d of %d hooks" % (flagged, len(trivial_rows)), menu=section(
            "", sorted(trivial_rows, key=lambda r: r["dim"]),
            ["hook", "trivial ms 1 h", "other ms 1 h", "trivial ms 24 h", "other ms 24 h"],
            [False, True, True, True, True])))
    if size_rows:
        nav.append(line("by transcript size: %d of %d hooks grow" % (sum(1 for r in size_rows if not r["dim"]),
                                                                      len(size_rows)), menu=section(
            "", sorted(size_rows, key=lambda r: r["dim"]), ["hook", "under 1 MB ms", "1-10 MB ms", "10 MB+ ms"],
            [False, True, True, True])))
    if repo_rows:
        nav.append(line("by repositories in the chat: %d of %d hooks grow" % (
            sum(1 for r in repo_rows if not r["dim"]), len(repo_rows)), menu=section(
            "", sorted(repo_rows, key=lambda r: r["dim"]),
            ["hook", "up to %d repos ms" % REPOS_FEW, "%d-%d repos ms" % (REPOS_FEW + 1, REPOS_MANY - 1),
             "%d+ repos ms" % REPOS_MANY], [False, True, True, True])))
    out = section("Hooks", rows, HOOK_COLUMNS, HOOK_RIGHT, nav=nav,
                  ok="%d hooks, none slow or cut in the last hour" % len(groups),
                  blind="" if timed24 or samples_h else "no hook-time line in 24 h: the hook journal is empty")
    if fast:
        broken = [f for f in fast if f["state"] not in ("loads", "fast path works")]
        red = [f for f in broken if f["state"] != "not found"]
        subject = broken[0] if broken else None
        text = ("%s %s under %s: %s lose%s the fast path" % (
            os.path.basename(subject["lib"]), subject["state"], subject["shell"], ", ".join(subject["hooks"]),
            "" if len(subject["hooks"]) != 1 else "s") if subject else "fast paths: %d quiet libraries load" % len(fast))
        probe = line(text, dim=not broken, red=bool(red), menu=section(
            "", [row([os.path.basename(f["lib"]), f["shell"], clip(", ".join(f["hooks"]), 40), f["state"]],
                     [3] if f["state"] not in ("loads", "fast path works", "not found") else [],
                     dim=f["state"] in ("loads", "fast path works")) for f in fast],
            ["library", "shell", "sourced by", "state"], [False, False, False, False]))
        probe.update(key="hooks:fastpath", say=text if broken else None, judge=[
            verdict("fastpath", "%s:%s" % (os.path.basename(f["lib"]), os.path.basename(f["shell"])), None, None, "",
                    0, len(f["hooks"]), "red" if f in red else "watch",
                    fact="%s %s under %s: %s" % (os.path.basename(f["lib"]), f["state"], f["shell"],
                                                  ", ".join(f["hooks"])),
                    evidence=[evidence(now, "probe %s under %s" % (os.path.basename(f["lib"]), f["shell"]),
                                       f["state"])])
            for f in broken])
        out["lead"].append(probe)
        if red and out["state"] != "problem":
            out.update(state="problem", fact=text)
        elif broken and out["state"] == "ok":
            out.update(state="watch", fact=text)
        out["extra_red"] = [probe] if red else []
    if loose:
        text = "%d hook%s outside the hook journal, no rule judges their time: %s" % (
            len(loose), "" if len(loose) == 1 else "s", ", ".join(sorted(n for n, _, _, _ in loose)))
        flag = line(clip(text, 120), dim=False, red=True)
        flag.update(key="hooks:unjournaled", say=clip(text, 120), judge=[
            verdict("unjournaled", ident, None, None, "", 0, runs, "red",
                    fact="%s runs on %s with no hook-time line, so no rule judges its time" % (name, event))
            for name, event, ident, runs in sorted(loose)])
        out["lead"].append(flag)
        out["extra_red"] = out.get("extra_red", []) + [flag]
        if out["state"] != "problem":
            out.update(state="problem", fact=flag["say"])
    return out


def every_call(members):
    for event in TOOL_EVENTS:
        matchers = [h["matcher"] for h in members if h["event"] == event and not h["async"]]
        if any(m in ("", "*") for m in matchers):
            return True
        if matchers and all(any(matches(m, tool) for m in matchers) for tool in ("Bash", "Edit", "Write")):
            return True
    return False


def shell_of(text):
    first = text.split("\n", 1)[0]
    if first.startswith("#!") and "env bash" in first:
        return shutil.which("bash", path="/opt/homebrew/bin:/usr/local/bin:" + os.environ.get("PATH", "")) or "/bin/bash"
    return "/bin/bash"


def resolve_lib(token, text, script):
    """The file a quiet `. <token> 2>/dev/null` loads: an explicit path in the token or in its variable's
    assignment, else its basename next to the hook, in its lib/ or in ../share/."""
    sources = [token]
    variable = re.match(r"\$\{?(\w+)", token)
    if variable:
        assigned = re.search(r"(?m)^\s*(?:export\s+|local\s+|readonly\s+)?%s=(\S+)" % variable.group(1), text)
        if assigned:
            sources.append(assigned.group(1))
    for source in sources:
        for path in re.findall(r"(?:\$HOME|\$\{HOME\}|~)?/[^\s\"'}:]*\.sh\b", source):
            path = re.sub(r"^(\$HOME|\$\{HOME\}|~)", base_home(), path)
            if path.startswith("/") and os.path.isfile(path):
                return os.path.realpath(path)
    names = [n for source in sources for n in re.findall(r"[\w.-]+\.sh\b", source)]
    if not names:
        return None
    here = os.path.dirname(os.path.realpath(script))
    for folder in (os.path.join(here, "lib"), os.path.join(here, "..", "share"), here, os.path.join(here, "..", "lib")):
        path = os.path.normpath(os.path.join(folder, names[-1]))
        if os.path.isfile(path):
            return os.path.realpath(path)
    return "?" + names[-1]


def probe_fast_paths(hooks):
    """Class D: a hook that sources a library with its errors silenced takes its full path, or no path,
    when the library breaks. Each one is sourced under the hook's own shell; FAST_PATH_PROBES also run
    the fast path's predicate."""
    found = {}
    for hook in hooks:
        script = hook_script(hook["command"])
        if not script:
            continue
        text = hook_text(hook["command"])
        for token in QUIET_SOURCE.findall(text):
            lib = resolve_lib(token.strip("\"'"), text, script)
            if lib:
                found.setdefault((shell_of(text), lib), set()).add(hook_label(hook["command"]))
    env = {k: v for k, v in os.environ.items() if k != "CLAUDE_PROJECT_DIR"}
    running = {}
    for (shell, lib) in found:
        if lib.startswith("?"):
            continue
        check = FAST_PATH_PROBES.get(os.path.basename(lib), "true")
        try:
            running[(shell, lib)] = subprocess.Popen(
                [shell, "-c", '. "$1" >/dev/null 2>&1 || exit 3\n' + check, "harness-doctor", lib],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env, cwd="/")
        except OSError:
            running[(shell, lib)] = None
    out = []
    for (shell, lib), names in sorted(found.items()):
        process = running.get((shell, lib))
        if lib.startswith("?"):
            state = "not found"
        elif process is None:
            state = "does not load"
        else:
            try:
                code = process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill()
                code = 124
            fast = os.path.basename(lib) in FAST_PATH_PROBES
            state = ("fast path works" if fast else "loads") if code == 0 else (
                "does not load" if code == 3 or not fast else "fast path broken")
        out.append({"shell": short_path(shell), "lib": lib[1:] if lib.startswith("?") else short_path(lib),
                    "hooks": sorted(names), "state": state})
    return sorted(out, key=lambda f: (f["state"] in ("loads", "fast path works"), f["lib"]))


def most(names):
    tally = {}
    for name in names:
        if name:
            tally[name] = tally.get(name, 0) + 1
    if not tally:
        return None, 0.0
    best = max(sorted(tally), key=tally.get)
    return best, tally[best] / float(len(names))


def hook_names(hooks):
    names = {}
    for hook in hooks:
        names.setdefault(hook_key(hook["command"]), hook_label(hook["command"]))
    names[STATUSLINE_KEY] = "statusline (not a hook)"
    return names


def menu_label(key):
    return "menu build: " + key[len(MENU_KEY):]


FLOOR_COLUMNS = ["", "calls 1 h", "wait ms 1 h", "wait ms 24 h", "set by 1 h"]
FLOOR_RIGHT = [False, True, True, True, False]


def floor_drill(items, names, window):
    rows = []
    for side, label in (("pre", "before the tool"), ("post", "after the tool")):
        values = [f[side] for f in items if f.get(side) is not None]
        if not values:
            continue
        by, share = most([f[side + "_by"] for f in items if f.get(side) is not None])
        rows.append(row([label, fmt_count(len(values)), num(median(values)), num(percentile(values, 0.95)),
                         "%s %s" % (clip(names.get(by, by or "–"), 28), fmt_pct(share))]))
    return section("", rows, ["", "calls " + window, "wait ms " + window, "p95 ms " + window, "set by " + window],
                   FLOOR_RIGHT) if rows else None


def floors_section(view, names, now):
    """Class A: what a call waits on hooks, per tool class and per turn event, judged on the last hour."""
    hour = now - 3600
    floors = view["floors"]
    note = LIMITS["floor_note_ms"]
    rows = []
    for cls, label, subject in FLOOR_ROWS:
        mine = [f for f in floors if f["cls"] == cls]
        if not mine:
            continue
        recent = [f for f in mine if f["t"] >= hour]
        m1, m24 = median([f["ms"] for f in recent]), median([f["ms"] for f in mine])
        event = cls.startswith("event:")
        limit = LIMITS["floor_event_ms" if event else "floor_write_ms" if cls in ("bash:other", "edit") else "floor_ms"]
        red = [2] if m1 is not None and len(recent) >= LIMITS["call_min_calls"] and m1 > limit else []
        watch = not red and ((m1 or 0) > note if recent else m24 > note)
        shown = recent or mine
        if event:
            setters = [clip(names.get(most([f["by"] for f in shown])[0], ""), 28)]
            said = "%s sets it" % setters[0]
        else:
            pre = most([f["pre_by"] for f in shown if f.get("pre_by")])[0]
            post = most([f["post_by"] for f in shown if f.get("post_by")])[0]
            setters = [clip(names.get(k, k), 24) for k in (pre, post) if k]
            said = ", ".join("%s %s" % (names.get(k, k), side) for k, side in ((pre, "before"), (post, "after")) if k)
        value = m1 if recent else m24
        say = ("%s waits %s ms on hooks%s, %s %d ms · %s" % (
            subject, num(value), "" if recent else " over 24 h", "limit" if red else "fine under",
            limit if red else note, said)) if red or watch else None
        rows.append(row([label, fmt_count(len(recent)), num(m1), num(m24), " · ".join(setters)], red,
                        dim=not red and not watch, key="floor:" + cls, say=say, head=say and say.rsplit(" · ", 1)[0],
                        judge=verdict("floor", cls, value, limit, "ms", 1 if recent else 24, len(shown),
                                      "red" if red else "watch" if watch else None,
                                      values=[f["ms"] for f in shown],
                                      evidence=[evidence(f["t"], "tool_use %s" % f["id"] if f.get("id") else
                                                         "batch %s" % f["t"], "%s ms" % num(f["ms"]))
                                                for f in sorted(shown, key=lambda f: -f["ms"])[:3]]),
                        menu=None if event else floor_drill(shown, names, "1 h" if recent else "24 h")))
    trivial = [f["ms"] for f in floors if f["cls"] == "bash:trivial" and f["t"] >= hour]
    nav = []
    if view["tool_batches"]:
        nav.append(line("tool batches joined to their call, 24 h: %s" % fmt_pct(
            view["joined"] / float(view["tool_batches"]))))
    return section("Hook waits", rows, FLOOR_COLUMNS, FLOOR_RIGHT, nav=nav,
                   ok=("a trivial Bash call waits %s ms on hooks, fine under %d ms" % (num(median(trivial)), note))
                   if trivial else "no hook wait over %d ms in the last hour" % note,
                   blind="" if view["tool_batches"] and rows else "no hook batch joined to a call yet")


def clip(text, width):
    return text if len(text) <= width else text[:width - 1] + "…"


def mean(values):
    values = [v for v in values if v is not None]
    return sum(values) / len(values) if values else None


def level(value, note_limit, red_limit):
    if value is None:
        return "dim"
    return "red" if value > red_limit else "note" if value > note_limit else "dim"


def load_section(samples, now):
    hour, week = now - 3600, now - 7 * 86400
    latest = samples[-1] if samples else {}
    ncpu = latest.get("ncpu") or os.cpu_count() or 1
    first = min((s.get("t", now) for s in samples), default=now)

    # A sample's busy covers the time since the one before, so a slot held at either end makes it requested work.
    quiet = [s for before, s in zip([{}] + samples, samples) if not s.get("held") and not before.get("held")]

    def series(key, since, fn=None, pool=samples):
        return mean([fn(s) if fn else s.get(key) for s in pool if s.get("t", 0) >= since
                     and (fn or s.get(key) is not None)])

    def measure(label, now_value, week_value, fmt, lv, key, say, limit=None, pool=samples, judged=None):
        red = [1] if lv == "red" else []
        name = key.split(":", 1)[1]
        return row([label, fmt(now_value), fmt(week_value)], red, dim=lv == "dim", key=key,
                   say=say if lv != "dim" else None,
                   judge=verdict("load", name, now_value if pool is samples else judged, limit, "", 1,
                                 sum(1 for s in pool if s.get("t", 0) >= hour),
                                 "red" if red else "watch" if lv == "note" else None,
                                 values=[sample_value(s, name) for s in pool if s.get("t", 0) >= week],
                                 bad=sum(1 for s in pool if s.get("t", 0) >= hour and limit is not None
                                         and (sample_value(s, name) or 0) > limit)))

    pct = fmt_pct
    busy, busy7 = series("busy", hour), series("busy", week)
    calm_busy = series("busy", hour, pool=quiet)
    kernel, kernel7 = series("kernel", hour), series("kernel", week)
    forks, forks7 = series("forks", hour), series("forks", week)
    unseen = lambda s: sample_value(s, "unseen")
    gap, gap7 = series(None, hour, unseen), series(None, week, unseen)
    calm_gap = series(None, hour, unseen, quiet)
    asked = "" if len(quiet) == len(samples) else " outside suite and night-fixer runs"
    rows = [
        measure("CPU busy", busy, busy7, pct, level(calm_busy, LIMITS["busy_note"], LIMITS["busy"]), "load:busy",
                "CPU %s busy%s, usual under %s" % (pct(calm_busy), asked, pct(LIMITS["busy_note"])), LIMITS["busy"],
                quiet, calm_busy),
        measure("  of it the kernel", kernel, kernel7, pct, level(kernel, LIMITS["kernel_note"], LIMITS["kernel"]),
                "load:kernel", "the kernel takes %s of CPU, usual under %s" % (pct(kernel),
                                                                                pct(LIMITS["kernel_note"])),
                LIMITS["kernel"]),
        measure("new processes", forks, forks7, lambda v: "–" if v is None else fmt_count(v) + " /s",
                level(forks, LIMITS["forks_note"], LIMITS["forks"]), "load:forks",
                "%s new processes a second, usual under %s" % (fmt_count(forks or 0), fmt_count(LIMITS["forks_note"])),
                LIMITS["forks"]),
        measure("unaccounted CPU", gap, gap7, lambda v: "–" if v is None else "%.1f cores" % v,
                level(calm_gap, LIMITS["unseen_note"], LIMITS["unseen_cores"]), "load:unseen",
                "%.1f of %d cores go to short-lived processes and the kernel%s" % (calm_gap or 0, ncpu, asked),
                LIMITS["unseen_cores"], quiet, calm_gap),
    ]
    swap, swap_total, guard = latest.get("swap_mb"), latest.get("swap_total_mb"), latest.get("guard")
    swap_share = swap / swap_total if swap is not None and swap_total else None
    rows.append(row(["memory free", "%s %%" % latest["mem_free"] if latest.get("mem_free") is not None else "–", ""],
                    [1] if guard else [], dim=not guard, key="load:memory",
                    say="the memory guard raised an alarm" if guard else None,
                    judge=verdict("load", "memory_guard", 1 if guard else 0, 0, "alarms", 0, 1 if latest else 0,
                                  "red" if guard else None)))
    swap_level = level(swap_share, 0.5, LIMITS["swap_share"])
    rows.append(row(["swap used", "%.1f GB" % (swap / 1024.0) if swap is not None else "–", ""],
                    [1] if swap_level == "red" else [], dim=swap_level == "dim", key="load:swap",
                    say="swap %.1f GB, nearly full" % (swap / 1024.0) if swap is not None and swap_level != "dim"
                    else None, judge=verdict("load", "swap_share", swap_share, LIMITS["swap_share"], "", 0,
                                             1 if latest else 0, "red" if swap_level == "red" else
                                             "watch" if swap_level == "note" else None,
                                             bad=int(swap_share is not None and swap_share > LIMITS["swap_share"]))))
    tests_now = latest.get("tests")
    rows.append(row(["tests running", fmt_count(tests_now) if tests_now is not None else "–", ""], dim=not tests_now))
    columns = ["", "last hour", "7 days" if first <= week + 3600 else
               "since " + time.strftime("%m-%d %H:%M", time.localtime(first))]
    if first > hour - 1800:
        columns = drop_column(rows, columns, 2)
    return section("Load", rows, columns, [False, True, True],
                   ok="CPU %s busy, swap %.1f GB" % (pct(busy), (swap or 0) / 1024.0),
                   blind="" if busy is not None else "no load sample in the last hour")


def repo_name(repo):
    """The statusline marks a worktree with ⧉, which Menlo lacks: its fallback glyph shifts the row."""
    return (repo or "?").replace("⧉ ", "wt ").replace("⧉", "wt ")


def test_scope(t):
    return t.get("scope") or ("partial" if t.get("partial") else "full")


def test_where(t):
    root = t.get("repo_root")
    return os.path.basename(root.rstrip("/")) if root else repo_name(t.get("repo"))


def history_ref(t, label=None):
    return "test-history %s %s %d" % (t.get("repo"), label or t.get("label"), t["end"])


def pole_line(tests, now):
    window = LIMITS["test_cost_window_s"]
    fulls = {}
    for t in tests:
        if (t.get("label") == "suites" and isinstance(t.get("suite_secs"), dict) and t["suite_secs"]
                and test_scope(t) in ("full", "all") and t["end"] >= now - window):
            fulls.setdefault(test_ident(t.get("repo"), "", t.get("repo_root")), []).append(t)
    rows = []
    for runs in fulls.values():
        runs.sort(key=lambda t: t["end"])
        run = runs[-1]
        ranked = sorted(run["suite_secs"].items(), key=lambda kv: (-kv[1], kv[0]))
        (pole, took), (after, next_took) = ranked[0], ranked[1] if len(ranked) > 1 else ("–", 0)
        share = min(1.0, took / float(run["secs"])) if run["secs"] > 0 else 1.0
        over = share > LIMITS["long_pole_share"]
        level = "red" if over and took >= LIMITS["long_pole_min_s"] else "watch" if over else None
        repo = test_where(run)
        fact = "%s took %d s of the %d s full %s run (%s), %d s more than %s" % (
            pole, took, run["secs"], repo, fmt_pct(share), took - next_took, after)
        rows.append((share, row([clip(repo, 20), clip(pole, 30), num(took, 60.0), num(took - next_took, 60.0),
                                 fmt_pct(share)], [4] if level == "red" else [], dim=not level, say=fact,
                                judge=verdict("test_long_pole", test_ident(run.get("repo"), SUITE_EXT.sub("", pole),
                                                                           run.get("repo_root")), share,
                                    LIMITS["long_pole_share"], "", window // 3600, len(runs), level, fact=fact,
                                    values=[max(r["suite_secs"].values()) / float(r["secs"]) for r in runs
                                            if r["secs"] > 0], evidence=[evidence(
                                        run["end"] - run["secs"], history_ref(run), "%s %d s of %d s" % (
                                            pole, took, run["secs"]), run.get("who") or "")]))))
    rows.sort(key=lambda x: -x[0])
    rows = [r for _, r in rows]
    top = rows[0] if rows else None
    out = line("long pole, %d h: %s" % (window // 3600, "%s · %s %s" % (top["cells"][1], top["cells"][0], top["cells"][4])
                                         if top else "no full run with suite times"),
               dim=not (top and top["judge"][0]["level"]), red=any(r["red"] for r in rows),
               menu=section("", rows, ["repo", "long pole", "min", "min over next", "share of run"],
                            [False, False, True, True, True]) if rows else None)
    out.update(key="tests:pole", say=next((r["say"] for r in rows if r["red"]), top and top["say"]))
    return out


def split_suites(root):
    name = os.path.basename((root or "").rstrip("/"))
    members = {}
    for path in glob.glob(os.path.join(repos_dir(), name, "tests", "test_*.sh")) if name else ():
        try:
            with open(path, errors="replace") as handle:
                found = SUITE_HARNESS.search(handle.read(4096))
        except OSError:
            continue
        if found:
            members.setdefault("test_" + found.group(1), []).append(SUITE_EXT.sub("", os.path.basename(path)))
    return {label: family for family, labels in members.items() if len(labels) > 1 for label in labels}


def cost_line(tests, now):
    window = LIMITS["test_cost_window_s"]
    costs, bare, families = {}, [], {}
    for t in tests:
        if t["end"] < now - window:
            continue
        if t.get("label") == "suites":
            if not isinstance(t.get("suite_secs"), dict) or not t["suite_secs"]:
                bare.append(t)
                continue
            parts = [(SUITE_EXT.sub("", name), secs) for name, secs in t["suite_secs"].items()]
        else:
            parts = [(t.get("label") or "?", t["secs"])]
        if t.get("repo_root") not in families:
            families[t.get("repo_root")] = split_suites(t.get("repo_root"))
        for label, secs in parts:
            label = families[t.get("repo_root")].get(label, label)
            costs.setdefault(test_ident(t.get("repo"), label, t.get("repo_root")), (label, test_where(t), []))[2].append(
                (secs, t))
    ranked = []
    for ident, (label, repo, runs) in costs.items():
        total = sum(secs for secs, _ in runs)
        level = "red" if total > LIMITS["test_day_s"] else "watch" if total > LIMITS["test_day_note_s"] else None
        biggest = max(runs, key=lambda x: x[0])
        first = min(t["end"] - t["secs"] for _, t in runs)
        fact = "%s · %s cost %s of wall clock in %d h over %d runs" % (label, repo, fmt_long(total), window // 3600,
                                                                     len(runs))
        ranked.append((total, level, row(
            [clip("%s · %s" % (label, repo), 34), fmt_count(len(runs)), num(total, 60.0),
             num(median([secs for secs, _ in runs]), 60.0)], [2] if level == "red" else [], dim=not level, say=fact,
            judge=verdict("test_daily_cost", ident, total, LIMITS["test_day_s"], "s", window // 3600, len(runs), level,
                          fact=fact, values=[secs for secs, _ in runs], bad=int(bool(level)),
                          evidence=[evidence(first, history_ref(biggest[1], label), "%d runs, %d s in %d h" % (
                              len(runs), total, window // 3600), biggest[1].get("who") or "")]))))
    ranked.sort(key=lambda x: -x[0])
    rows = [r for i, (_, level, r) in enumerate(ranked) if i < INVENTORY_ROWS or level]
    if bare:
        rows.append(row(["suites runs without suite times", fmt_count(len(bare)), num(sum(t["secs"] for t in bare), 60.0),
                         "–"], dim=True))
    top = ranked[0][2] if ranked else None
    out = line("daily cost, %d h: %s" % (window // 3600, "%s %s min" % (top["cells"][0], top["cells"][2])
                                         if top else "no suite times" if bare else "no test ran"),
               dim=not (ranked and ranked[0][1]), red=any(level == "red" for _, level, _ in ranked),
               menu=section("", rows, ["suite · repo", "runs", "min %d h" % (window // 3600), "min a run"],
                            [False, True, True, True]) if rows else None)
    out.update(key="tests:cost", say=next((r["say"] for _, level, r in ranked if level == "red"), top and top["say"]))
    return out


def tests_section(tests, now, kills=(), runs=()):
    today = local_day(now)
    todays = [t for t in tests if local_day(t["end"]) == today]
    intervals = lambda xs: [(t["end"] - t["secs"], t["end"]) for t in xs]
    fresh = LIMITS["test_slow_fresh_s"]
    suites = [t for t in tests if t.get("label") == "suites" and t["end"] >= now - fresh]
    journaled = [(r["started_at"], r["ended_at"]) for r in runs if r.get("kind") == "suites" and r["ended_at"] >= now - fresh]
    peak = max(peak_overlap(intervals(suites)) if suites else 0, peak_overlap(journaled) if journaled else 0)
    rows = []
    groups, idents = {}, {}
    for t in tests:
        where = (t.get("repo"), t.get("repo_root"))
        if where not in idents:
            idents[where] = test_ident(where[0], "", where[1])
        groups.setdefault(idents[where] + (t.get("label") or "?"), []).append(t)
    ranked = []
    for items in groups.values():
        items.sort(key=lambda t: t["end"])
        label, root = items[-1].get("label") or "?", items[-1].get("repo_root")
        repo = os.path.basename(root.rstrip("/")) if root else repo_name(items[-1].get("repo"))
        todays_items = [t for t in items if local_day(t["end"]) == today]
        if not todays_items:
            continue
        scope = test_scope(items[-1])
        peers = [t for t in items if test_scope(t) == scope]
        known = [t["secs"] for t in peers[:-1] if t.get("scoped")]
        usual = median(known) if len(known) >= 2 else percentile([t["secs"] for t in peers[:-1]], 0.75)
        last = items[-1]["secs"]
        red = []
        # A worktree's rows stop when it is removed, so its last slow run would stay red all day.
        slow = (len(peers) >= 3 and last > LIMITS["test_slow_ratio"] * usual
                and now - items[-1]["end"] <= LIMITS["test_slow_fresh_s"])
        usual = usual or 0
        end = items[-1]["end"]
        crowd = sum(1 for r in runs if label == "suites" and r.get("kind") == "suites" and r.get("repo_root") == root
                    and r["started_at"] < end and r["ended_at"] > end - last
                    and not (abs(r["started_at"] - (end - last)) <= RUN_JOIN_S and abs(r["ended_at"] - end) <= RUN_JOIN_S))
        if slow and last > LIMITS["test_slow_min_s"] and not crowd:
            red.append(4)
        name = clip("%s · %s" % (label, repo), 34)
        ident = test_ident(items[-1].get("repo"), label, root)
        ranked.append((sum(t["secs"] for t in todays_items), row(
            [name, fmt_count(len(todays_items)), num(sum(t["secs"] for t in todays_items), 60.0), num(usual, 60.0),
             num(last, 60.0)], red, dim=not red and not slow, key="tests:" + ident,
            say="%s took %s, usual %s%s%s" % (name, fmt_long(last), fmt_long(usual), "" if scope == "full" else " for a %s run" % SCOPE_SAY.get(scope, scope),
                                              ", %d other full runs at once" % crowd if crowd else ""),
            judge=verdict("test_slow", ident, last, LIMITS["test_slow_min_s"], "s", LIMITS["test_slow_fresh_s"] // 3600,
                          sum(1 for t in items if t["end"] - t["secs"] > now - fresh),
                          "red" if red else "watch" if slow else None,
                          values=[t["secs"] for t in items], bad=int(bool(slow)),
                          evidence=[evidence(items[-1]["end"] - last, "test-history %s %s %d" % (
                              items[-1].get("repo"), label, items[-1]["end"]), "took %d s, usual %d s" % (
                              last, usual), items[-1].get("who") or "")]))))
    ranked.sort(key=lambda x: -x[0])
    rows = [r for _, r in ranked[:6]] + [r for _, r in ranked[6:] if r["red"]]
    overlap = line("suites at once, %d h: %d" % (fresh // 3600, peak), dim=peak < LIMITS["suites_note"],
                   red=peak >= LIMITS["suites_at_once"])
    overlap.update(key="tests:overlap", say="%d suite runs at once in the last %d h, fine up to %d" % (
        peak, fresh // 3600, LIMITS["suites_at_once"] - 1), judge=[verdict(
            "suites_at_once", "suites", peak, LIMITS["suites_at_once"], "runs", fresh // 3600, len(suites),
            "red" if peak >= LIMITS["suites_at_once"] else "watch" if peak >= LIMITS["suites_note"] else None)])
    columns, right = ["test · repo", "runs today", "min today", "usual min", "last min"], [False, True, True, True, True]
    nav = []
    if len(ranked) > len(rows):
        rest = ranked[INVENTORY_ROWS:]
        nav.append(line("top %d of %d tests today" % (INVENTORY_ROWS, len(ranked)) if rest
                        else "all %d tests today" % len(ranked),
                        menu=section("", [r for _, r in ranked[:INVENTORY_ROWS]], columns, right)))
    live = running_now(now)
    if live:
        nav.append(line("running now: %d" % len(live), menu=section(
            "", [row([clip("%s · %s" % (r["label"], repo_name(r["repo"])), 34), num(r["secs"], 60.0)]) for r in live],
            ["test · repo", "running min"], [False, True])))
    latest = sorted(tests, key=lambda t: -t["end"])[:LATEST_TESTS]
    if latest:
        nav.append(line("latest %d" % len(latest), menu=section("", [
            row([time.strftime("%H:%M" if local_day(t["end"]) == today else "%m-%d %H:%M", time.localtime(t["end"])),
                 clip("%s · %s" % (t.get("label"), repo_name(t.get("repo"))), 34), num(t["secs"], 60.0),
                 t.get("who") or ""])
            for t in latest], ["at", "test · repo", "took min", "who"], [False, False, True, False])))
    fails = load_failures(tests, now, kills)
    loaded = line("failed under load, %d h: %d" % (fresh // 3600, len(fails)), red=bool(fails), menu=section("", [
        row([time.strftime("%H:%M", time.localtime(t["end"])), clip("%s · %s" % (t.get("label"), repo_name(t.get("repo"))), 34),
             fmt_count(crowd), time.strftime("%H:%M", time.localtime(passed["end"]))], [2])
        for t, crowd, passed in fails], ["failed", "test · repo", "suites at once", "passed alone"],
        [False, False, True, False]) if fails else None)
    if fails:
        t, crowd, passed = fails[0]
        loaded.update(say="%s · %s failed while %d suites ran and passed alone at %s" % (
            t.get("label"), repo_name(t.get("repo")), crowd, time.strftime("%H:%M", time.localtime(passed["end"]))))
    loaded["key"] = "tests:load"
    loaded["judge"] = [verdict("test_load_fail", test_ident(t.get("repo"), t.get("label"), t.get("repo_root")), crowd,
                               LIMITS["load_fail_suites"], "suites", fresh // 3600, 1, "red", bad=1,
                               fact="%s failed while %d suites ran, passed alone" % (t.get("label"), crowd),
                               evidence=[evidence(t["end"] - t["secs"], "test-history %s %s %d" % (
                                   t.get("repo"), t.get("label"), t["end"]))])
                       for t, crowd, passed in fails]
    pole, cost = pole_line(tests, now), cost_line(tests, now)
    out = section("Tests", rows, columns, right, lead=[overlap, loaded, pole, cost], nav=nav,
                  ok=("%d runs today, %s of wall clock, none slower than usual" % (
                      len(todays), fmt_long(union_secs(intervals(todays)))) if todays else "no test finished today")
                  + ("; %d running now" % len(live) if live else ""))
    out["extra_red"] = [x for x in (overlap, loaded, pole, cost) if x["red"]]
    if out["extra_red"] and out["state"] != "problem":
        out.update(state="problem", fact=out["extra_red"][0]["say"])
    return out


GATE_BEFORE_S = 900
GATE_AFTER_S = 60
DETAIL_MAX = 40
NEAR_SHARE = 0.5
LANDING_S = 86400
SYNC_JOIN_S = 900
FIXTURE_PATH_RE = re.compile(r"/\.pytest_cache/|/home/\.(?:claude|codex|gemini|grok)/|^(?:/private)?/(?:tmp|var/folders)/")
HEALTH_LIMITS = {"ask-deferred": ("ask_deferred_s", "s"), "stop-silent": ("silent_s", "s"),
                 "baseline-silent": ("silent_s", "s"), "growth-denied": ("growth_min_b", "B"),
                 "growth-ungated": ("growth_min_b", "B"), "watcher-down": ("watch_tick_s", "s")}
HEALTH_COLUMNS = ["", "times 24 h", "last"]


def jsonl_stamp(text, stamp):
    try:
        item = json.loads(text)
    except ValueError:
        return None
    value = item.get(stamp) if isinstance(item, dict) else None
    return value if isinstance(value, (int, float)) else iso_epoch(value)


def read_jsonl(path, since=None, stamp="ts"):
    rows = []
    try:
        with open(path, "rb") as handle:
            lo, hi = 0, handle.seek(0, os.SEEK_END) if since is not None else 0
            while hi - lo > JSONL_BISECT_B:
                mid = (lo + hi) // 2
                handle.seek(mid)
                handle.readline()
                at = jsonl_stamp(handle.readline(), stamp)
                if at is not None and at < since:
                    lo = mid
                else:
                    hi = mid
            handle.seek(lo)
            if lo:
                handle.readline()
            for text in handle:
                try:
                    item = json.loads(text)
                except ValueError:
                    continue
                if isinstance(item, dict):
                    rows.append(item)
    except OSError:
        return None
    return rows


_newest = {}


def newest_transcript():
    key = (base_home(), projects_dir())
    if key not in _newest:
        _newest[key] = transcript_times()
    return _newest[key]


def transcript_globs(name="*"):
    home = base_home()
    return (os.path.join(projects_dir(), "*", name + ".jsonl"),
            os.path.join(home, ".claude-profiles", "*", "projects", "*", name + ".jsonl"),
            os.path.join(home, ".claude-profiles", ".*", "projects", "*", name + ".jsonl"))


def chat_owns(sid):
    return bool(re.fullmatch(r"[0-9A-Za-z-]+", sid or "")) and any(glob.glob(p) for p in transcript_globs(sid))


def transcript_times():
    newest, born = 0, 0
    for pattern in transcript_globs():
        for path in glob.glob(pattern):
            try:
                info = os.stat(path)
            except OSError:
                continue
            newest = max(newest, info.st_mtime)
            born = max(born, min(getattr(info, "st_birthtime", info.st_mtime), info.st_mtime))
    return newest, born


def health_hit(items, rule, ident, label, at, value=None, ref="", excerpt="", level="red", head=None, n=1,
               noun="time"):
    item = items.setdefault((rule, str(ident)), {"label": label, "count": 0, "first": at, "last": at, "value": None,
                                                 "events": [], "level": level, "head": head, "noun": noun})
    if LEVELS[level] > LEVELS[item["level"]]:
        item.update(level=level, label=label, head=head)
    item["count"] += n
    item["first"], item["last"] = min(item["first"], at), max(item["last"], at)
    if value is not None:
        item["value"] = max(item["value"] or value, value)
    item["events"].append((at, ref, str(excerpt or "")))


def clock(at, now):
    return time.strftime("%H:%M" if local_day(at) == local_day(now) else "%m-%d %H:%M", time.localtime(at))


def health_section(name, prefix, items, exposure, now, ok, blind=""):
    rows = []
    for (rule, ident), item in sorted(items.items(), key=lambda kv: (-LEVELS[kv[1]["level"]], -kv[1]["last"])):
        limit_key, unit = HEALTH_LIMITS.get(rule, (None, "events"))
        red = item["level"] == "red"
        say, head = ("%s, %d %s%s in 24 h" % (label, item["count"], item["noun"], "" if item["count"] == 1 else "s") if red
                     else "%s, under its %s limit" % (label, fmt_long(LIMITS[limit_key]) if unit == "s" else "%d %s" % (
                         LIMITS[limit_key], unit)) for label in (item["label"], item.get("head") or item["label"]))
        rows.append(row([clip(item["label"], 60), fmt_count(item["count"]), clock(item["last"], now)],
            [0] if red else [], key="%s:%s:%s" % (prefix, rule, ident), say=say, head=head,
            judge=verdict(rule, ident, item["value"] if limit_key else item["count"],
                          LIMITS[limit_key] if limit_key else 0, unit, 24, exposure, item["level"], fact=say,
                          bad=item["count"],
                          evidence=[evidence(at, ref, excerpt) for at, ref, excerpt in
                                    sorted(item["events"], key=lambda e: -e[0])[:3]])))
    return section(name, rows, HEALTH_COLUMNS, [False, True, False], ok=ok, blind=blind)


def stop_hooks_section(now):
    """What llm-doctor's Hooks row judged: stop-hook failures, asks left unanswered, word notices with no
    reading line, and a stop dispatcher that went quiet while chats ran."""
    cutoff = now - 86400
    items, asked, streaks, last_stop, seen = {}, {}, {}, None, 0
    journal = read_jsonl(stop_journal(), cutoff)

    def streak_end(session, reason, first, last, ref):
        why = {"busy bg-task": "a background task ran", "busy worker-run": "a worker ran",
               "stop hook active": "the chat was answering a check"}.get(reason, "the chat was busy")
        if last - first >= LIMITS["ask_deferred_s"]:
            health_hit(items, "ask-deferred", slug(reason), "end-of-turn checks held back over 2 h while %s" % why,
                       last, value=last - first, ref=ref, excerpt=reason)
        elif last - first >= NEAR_SHARE * LIMITS["ask_deferred_s"]:
            health_hit(items, "ask-deferred", slug(reason), "end-of-turn checks held back %s while %s" % (
                fmt_long(last - first), why), last, value=last - first, ref=ref, excerpt=reason, level="watch")

    for entry in journal or ():
        at = iso_epoch(entry.get("ts"))
        if at is not None:
            last_stop = max(last_stop or at, at)
        if at is None or not cutoff <= at <= now + 3600:
            continue
        seen += 1
        session = str(entry.get("session") or "")
        ref = "stop:%s/%s" % (entry.get("ts"), session or "-")
        hooks = [h for h in entry.get("hooks") or [] if isinstance(h, dict)]
        asks = [h for h in hooks if str(h.get("name") or "").startswith("ask-")]
        if asks:
            outcomes = {h.get("outcome") for h in asks}
            reason = ("busy " + str(entry.get("busy") or "").split(":", 1)[0] if outcomes == {"skipped-busy"} else
                      "stop hook active" if outcomes == {"skipped-active"} else "")
            for key in [k for k in streaks if k[0] == session and k[1] != reason]:
                streak_end(session, *streaks.pop(key))
            if reason:
                streak = streaks.setdefault((session, reason), [reason, at, at, ref])
                if at >= streak[2]:
                    streak[2], streak[3] = at, ref
        for hook in hooks:
            name, outcome, reason = str(hook.get("name") or "?"), hook.get("outcome"), str(hook.get("reason") or "")
            if outcome == "error":
                health_hit(items, "hook-error", name, "%s: %s" % (name, reason or "error"), at, ref=ref, excerpt=reason,
                           head="an end-of-turn check failed")
            elif outcome == "held":
                health_hit(items, "hook-held", name, "%s: held a run no relay owns" % name, at, ref=ref,
                           excerpt=reason, head="an end-of-turn check held a worker run nobody owns")
            elif outcome == "asked":
                key = (session, name, reason[:120])
                if entry.get("busy"):
                    health_hit(items, "ask-busy", name, "%s: asked while busy" % name, at, ref=ref,
                               excerpt=str(entry.get("busy")), head="an end-of-turn check asked while the chat was busy")
                elif key in asked and at - asked[key] <= LIMITS["stop_repeat_s"]:
                    health_hit(items, "ask-repeat", name, "%s: same ask again within 30 min" % name, at, ref=ref,
                               excerpt=reason, head="an end-of-turn check asked the same again within 30 min")
                asked[key] = at
    for (session, _), streak in streaks.items():
        streak_end(session, *streak)
    words, marks, families = [], {}, word_families()
    for entry in read_jsonl(words_journal(), cutoff) or ():
        if entry.get("mark"):
            marks[entry.get("ref")] = entry["mark"]
        elif isinstance(entry.get("ts"), (int, float)) and cutoff <= entry["ts"] <= now + 3600:
            words.append(entry)
    for entry in words:
        seen += 1
        if entry.get("silent") or not (entry.get("hook") or entry.get("unprompted")):
            continue
        mark = marks.get("%s:%s" % (entry.get("ts"), entry.get("session")))
        if mark == "miss" or (entry.get("match") is False and mark != "ok"):
            said = "; ".join(entry.get("model") or [])
            unprompted = bool(entry.get("unprompted"))
            health_hit(items, "reading-miss" if unprompted else "word-miss",
                       "unprompted" if unprompted else word_ident(entry.get("hook"), families),
                       "⚡ reading with no notice: %s" % said[:DETAIL_MAX] if unprompted else
                       "word notice with no reading: %s" % str(entry.get("hook"))[:DETAIL_MAX], entry["ts"],
                       ref="words:%s/%s" % (entry["ts"], entry.get("session") or "-"),
                       excerpt=said if unprompted else str(entry.get("hook")),
                       head="a chat acted on a word you did not say" if unprompted else
                       "a chat got a word of yours and did not act on it")
    active, _ = newest_transcript()
    gap = active - (last_stop or 0)
    if journal is not None and active and active >= cutoff and gap > NEAR_SHARE * LIMITS["silent_s"] and (
            last_stop or gap > LIMITS["silent_s"]):
        health_hit(items, "stop-silent", "stop-dispatch", "stop-dispatch.sh: no journal line while chats ran"
                   if gap > LIMITS["silent_s"] else "stop-dispatch.sh: no journal line for %s" % fmt_long(gap),
                   last_stop or cutoff, value=gap, ref="transcripts:%d" % active,
                   level="red" if gap > LIMITS["silent_s"] else "watch",
                   head="end-of-turn checks recorded nothing while chats ran" if gap > LIMITS["silent_s"]
                   else "end-of-turn checks recorded nothing for %s" % fmt_long(gap))
    return health_section("Stop hooks", "stophooks", items, seen, now,
                          ok="%d stop and word journal lines in 24 h, none failed or unanswered" % seen,
                          blind="" if journal is not None else "no stop journal at %s" % stop_journal())


def file_key(path):
    path = re.sub(r"/\.claude/worktrees/[^/]+", "", str(path))
    home = base_home().rstrip("/")
    return "~" + path[len(home):] if path.startswith(home + "/") else path


def vendor_synced(path, at, manifests):
    """Claude Code's org sync lists what it lands in the bucket's manifest.json and bumps its lastUpdated
    only when it lands content; the file's mtime moves every round, so it proves nothing."""
    found = re.match(r"(%s/\.claude/(?:skills|plugins)/synced/[^/]+)/([^/]+)/" % re.escape(base_home().rstrip("/")),
                     str(path))
    if not found:
        return False
    bucket, name = found.groups()
    if bucket not in manifests:
        manifests[bucket] = read_json(os.path.join(bucket, "manifest.json"), {})
    manifest = manifests[bucket] if isinstance(manifests[bucket], dict) else {}
    listed = [i for i in (manifest.get("skills") or []) + (manifest.get("plugins") or [])
              if isinstance(i, dict) and i.get("name") == name]
    stamp = manifest.get("lastUpdated")
    return bool(listed) and isinstance(stamp, (int, float)) and stamp / 1000.0 >= at - SYNC_JOIN_S


UPSTREAM_MOVE_RE = re.compile(r"(?:checkout|merge|pull|rebase)\b")


def git_out(top, *args, stdin=None):
    try:
        out = subprocess.run(["git", "-C", top] + list(args), input=stdin, capture_output=True, text=True,
                             timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout if out.returncode == 0 else None


def fetched_shas(top):
    """{sha: first epoch} a remote-tracking ref reached by anything but this clone's own push, read off the
    reflog files: `git log -g` over them took 1.7 s in a repository of 3 000 remote reflog lines."""
    common = (git_out(top, "rev-parse", "--path-format=absolute", "--git-common-dir") or "").strip()
    found = {}
    for folder, _, names in os.walk(os.path.join(common, "logs", "refs", "remotes")) if common else ():
        for name in names:
            try:
                with open(os.path.join(folder, name), errors="replace") as handle:
                    for text in handle:
                        head, _, subject = text.partition("\t")
                        parts = head.split()
                        if len(parts) >= 5 and parts[-2].isdigit() and not subject.startswith("update by push"):
                            found[parts[1]] = min(found.get(parts[1], int(parts[-2])), int(parts[-2]))
            except OSError:
                pass
    return found


def upstream_delivered(paths, at, repos):
    """{path: its repository, as the path spells it} of the files git delivered from upstream: a checkout, merge,
    pull or rebase of their repository in the day before the measurement moved HEAD to a commit a remote-tracking
    ref had fetched, never pushed (a land merge of local work is local growth), whose blob the file still holds.
    A checkout writes the files before its reflog line, hence the slack after the measurement."""
    by_top = {}
    for path in paths:
        real = os.path.realpath(path)
        parent = os.path.dirname(real)
        if parent not in repos:
            top = git_out(parent, "rev-parse", "--show-toplevel") if os.path.isdir(parent) else None
            repos[parent] = top.strip() if top else None
        if repos[parent] and os.path.isfile(real) and "\n" not in real:
            by_top.setdefault(repos[parent], []).append((path, os.path.relpath(real, repos[parent])))
    found = {}
    for top, files in by_top.items():
        if ("reflog", top) not in repos:
            moves = []
            for text in (git_out(top, "reflog", "show", "--date=unix", "--format=%gd%x09%H%x09%gs", "-n", "500",
                                 "HEAD") or "").splitlines():
                stamp, sha, subject = (text.split("\t", 2) + ["", ""])[:3]
                when = re.search(r"@\{(\d+)\}$", stamp)
                if when and UPSTREAM_MOVE_RE.match(subject):
                    moves.append((int(when.group(1)), sha))
            repos[("reflog", top)] = moves
            repos[("fetched", top)] = fetched_shas(top)
        fetched = repos[("fetched", top)]
        shas = [sha for when, sha in repos[("reflog", top)] if at - LANDING_S <= when <= at + GATE_AFTER_S
                and fetched.get(sha, when + 1) <= when]
        if not shas:
            continue
        held = (git_out(top, "hash-object", "--stdin-paths", stdin="".join(rel + "\n" for _, rel in files))
                or "").split()
        blobs = (git_out(top, "cat-file", "--batch-check=%(objectname)",
                         stdin="".join("%s:%s\n" % (sha, rel) for _, rel in files for sha in shas)) or "").split("\n")
        if len(held) != len(files) or len(blobs) < len(files) * len(shas):
            continue
        for i, (path, _) in enumerate(files):
            if held[i] in blobs[i * len(shas):(i + 1) * len(shas)]:
                spelled = os.path.dirname(path)
                while spelled != os.path.dirname(spelled) and os.path.realpath(spelled) != top:
                    spelled = os.path.dirname(spelled)
                found[path] = spelled if os.path.realpath(spelled) == top else top
    return found


def gate_verdict(decisions, path, at, delta):
    """A pass the bloat gate priced covers only the bytes it priced (summed over the window), so a small
    passed Edit cannot clear a larger write of the same file beside it; a pass with no delta covers any."""
    names = {path, os.path.realpath(path)}
    found, priced = None, 0
    for entry in decisions:
        if not at - GATE_BEFORE_S <= entry["at"] <= at + GATE_AFTER_S or not names & {entry.get("file"),
                                                                                         entry.get("real")}:
            continue
        if entry.get("decision") in ("passed", "span-pass", "granted"):
            size = entry.get("delta")
            if not isinstance(size, (int, float)) or isinstance(size, bool):
                return "passed"
            priced += max(size, 0)
            continue
        found = "denied"
    return "passed" if priced >= delta else found


def write_classes(paths):
    """instruction_write_class of share/instruction-files.sh per path, empty where no gate speaks for it;
    {} when the library does not answer, which leaves every growth judged."""
    paths = sorted(set(paths))
    if not paths:
        return {}
    script = '. "$1" || exit 1; shift; for p; do printf "%s\\0" "$(instruction_write_class "$p")"; done'
    try:
        out = subprocess.run(["bash", "-c", script, "bash", os.path.join(ROOT_DIR, "share", "instruction-files.sh")]
                             + paths, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return {}
    found = out.stdout.split("\0")
    return dict(zip(paths, found)) if out.returncode == 0 and len(found) == len(paths) + 1 else {}


def growth_root(path, skills):
    """(root, on_demand): the skill directory, else the docs tree, else the file. A skill's files other than
    its SKILL.md load only when it runs, not the every-chat context growth_min_b prices (design §11)."""
    parent = os.path.dirname(path)
    while parent != os.path.dirname(parent):
        if parent not in skills:
            skills[parent] = os.path.isfile(os.path.join(parent, "SKILL.md"))
        if skills[parent]:
            return parent, not (os.path.dirname(path) == parent and os.path.basename(path).upper() == "SKILL.MD")
        parent = os.path.dirname(parent)
    parts = path.split("/")
    if "docs" in parts[:-1]:
        return "/".join(parts[:parts.index("docs") + 1]), False
    return path, False


def guards_section(now):
    """What llm-doctor's Guards row judged: instruction-file growth no gate priced or passed, forged retry
    stamps, the gates' own faults, and a watcher or tripwire that went quiet."""
    cutoff = now - 86400
    items, decisions, seen = {}, [], 0
    state = watch_state()
    if not os.path.isdir(state):
        return health_section("Guards", "guards", items, 0, now, ok="",
                              blind="no instruction-watch state at %s" % state)
    for entry in read_jsonl(os.path.join(state, "gates.jsonl"), cutoff - GATE_BEFORE_S, "at") or ():
        at = entry.get("at")
        if not isinstance(at, (int, float)):
            continue
        if entry.get("decision") != "fault":
            decisions.append(entry)
        elif cutoff <= at <= now + 3600:
            seen += 1
            gate = str(entry.get("gate") or "?")
            health_hit(items, "gate-fault", gate, "%s gate: %s" % (gate, str(entry.get("detail") or "fault")[:DETAIL_MAX]),
                       at, ref="gates:%s/%s" % (at, gate), excerpt=entry.get("detail"),
                       head="a guard on instruction files failed")
    events = read_jsonl(os.path.join(state, "events.jsonl"), cutoff - LANDING_S, "at") or ()
    # A merge, patch or copy between a worktree and its main checkout re-lands bytes already judged; each
    # sibling growth excuses one landing of its bytes, used up oldest first.
    credits, landings, manifests, repos, upstream = {}, set(), {}, {}, {}
    for entry in events:
        at = iso_epoch(entry.get("at"))
        if at is None or entry.get("reverted") or entry.get("kind", "change") not in ("change", "changed-between-sessions"):
            continue
        for path, delta in zip(entry.get("files") or [], entry.get("bytes") or []):
            if not isinstance(delta, (int, float)) or delta <= 0:
                continue
            path, mine = str(path), credits.setdefault(file_key(path), [])
            pool = [c for c in mine if c[2] > 0 and c[0] >= at - LANDING_S and c[1] != path]
            if sum(c[2] for c in pool) >= delta:
                landings.add((id(entry), path))
                need = delta
                for c in pool:
                    take = min(c[2], need)
                    c[2], need = c[2] - take, need - take
            mine.append([at, path, delta])

    classes = write_classes(str(p) for entry in events for p in entry.get("files") or [])
    skills = {os.path.dirname(str(p)): True for entry in events for p in entry.get("files") or []
              if os.path.basename(str(p)).upper() == "SKILL.MD"}
    for entry in events:
        at = iso_epoch(entry.get("at"))
        if at is None or not cutoff <= at <= now + 3600:
            continue
        seen += 1
        kind = entry.get("kind") or "change"
        files = [str(p) for p in entry.get("files") or []]
        ref = "events:%s/%s" % (entry.get("at"), file_key(files[0]) if files else "-")
        if kind in ("change", "changed-between-sessions") and not entry.get("reverted"):
            between = kind == "changed-between-sessions"
            groups, aside, grew = {}, {}, []
            for path, delta in zip(files, entry.get("bytes") or []):
                if (not isinstance(delta, (int, float)) or delta <= 0 or not classes.get(path, "?")
                        or FIXTURE_PATH_RE.search(file_key(path)) or (id(entry), str(path)) in landings):
                    continue
                gate = gate_verdict(decisions, path, at, delta)
                if gate == "passed" or not gate and vendor_synced(path, at, manifests):
                    continue
                grew.append((path, delta, gate))
            delivered = upstream_delivered([p for p, _, gate in grew if not gate], at, repos)
            for path, delta, gate in grew:
                if path in delivered:
                    got = upstream.setdefault(delivered[path], [0, 0, at])
                    got[0], got[1], got[2] = got[0] + 1, got[1] + delta, max(got[2], at)
                    continue
                root, on_demand = growth_root(path, skills)
                if on_demand:
                    aside[root] = aside.get(root, 0) + 1
                    continue
                groups.setdefault(("growth-denied" if gate else "growth-ungated", root), []).append((path, delta))
            for (rule, root), grown in sorted(groups.items()):
                total = sum(delta for _, delta in grown)
                if total < NEAR_SHARE * LIMITS["growth_min_b"]:
                    continue
                denied = rule == "growth-denied"
                label = "instruction files grew between sessions" if between else "%s%s grew %s" % (
                    "/".join(file_key(root).rstrip("/").split("/")[-2:]), " (%d files)" % len(grown) if len(grown) > 1 else "",
                    "after a denial" if denied else "with no gate seeing it")
                listed = ", ".join("%s +%d B" % (os.path.basename(p) if p == root else os.path.relpath(p, root), delta)
                                   for p, delta in grown)
                if aside.get(root):
                    listed += "; %d on-demand file%s not counted" % (aside[root], "" if aside[root] == 1 else "s")
                health_hit(items, rule, "between-sessions" if between else file_key(root), label, at, value=total,
                           ref="events:%s/%s" % (entry.get("at"), file_key(root)),
                           excerpt="%s +%d B: %s" % (file_key(root), total, listed),
                           level="red" if total > LIMITS["growth_min_b"] else "watch",
                           head=None if between else "%s grew %s" % (
                               "an instruction file" if len(grown) == 1 else "instruction files",
                               "after a guard refused it" if denied else "with no guard seeing it"),
                           n=len(grown), noun="file")
        elif kind == "stamp-forged":
            health_hit(items, "stamp-forged", file_key(files[0]) if files else "?", "forged retry stamp: %s" % (
                "/".join((files[0] if files else "?").split("/")[-2:])), at, ref=ref,
                head="a guard's retry permission was forged")
        elif kind in ("changed-while-watcher-off", "baseline-missing", "dropped"):
            if kind == "baseline-missing" and not chat_owns(entry.get("sid")):
                continue
            health_hit(items, kind, "tripwire", {"changed-while-watcher-off": "changed while the watcher was off",
                                                  "baseline-missing": "tripwire baseline missing",
                                                  "dropped": "change journal dropped records"}[kind], at, ref=ref,
                       excerpt=", ".join(file_key(p) for p in files),
                       head={"changed-while-watcher-off": "instruction files changed while their watcher was off",
                             "baseline-missing": "the instruction watcher lost its starting snapshot",
                             "dropped": "the instruction watcher lost change records"}[kind])
    beat = os.path.join(state, "watcher", "heartbeat")
    try:
        born = os.stat(beat).st_mtime
        with open(beat, errors="replace") as handle:
            body = handle.read()
    except OSError:
        born, body = None, ""
    failure = re.search(r"error=([^\n]+)", body)
    if born is None:
        health_hit(items, "watcher-down", "never-started", "watcher never started", now, ref="heartbeat:none")
    elif now - born > 2 * LIMITS["watch_tick_s"]:
        health_hit(items, "watcher-down", "stale", "watcher down", born, value=now - born, ref="heartbeat:%d" % born)
    elif failure or re.search(r"\broots=0\b", body):
        health_hit(items, "watcher-down", "error" if failure else "no-root", "watcher down: %s" % (
            failure.group(1) if failure else "no root watched")[:DETAIL_MAX], born, ref="heartbeat:%d" % born,
            excerpt=body.strip())
    baselines = []
    for path in glob.glob(os.path.join(state, "session-*.tsv")):
        try:
            baselines.append(os.stat(path).st_mtime)
        except OSError:
            pass
    _, started = newest_transcript()
    gap = started - max(baselines or [0])
    if started and started >= cutoff and gap > NEAR_SHARE * LIMITS["silent_s"] and (baselines or gap > LIMITS["silent_s"]):
        health_hit(items, "baseline-silent", "tripwire", "tripwire wrote no baseline while chats started"
                   if gap > LIMITS["silent_s"] else "tripwire wrote no baseline for %s" % fmt_long(gap),
                   max(baselines or [cutoff]), value=gap, ref="transcripts:%d" % started,
                   level="red" if gap > LIMITS["silent_s"] else "watch",
                   head="the instruction watcher took no snapshot while chats started" if gap > LIMITS["silent_s"]
                   else "the instruction watcher took no snapshot for %s" % fmt_long(gap))
    out = health_section("Guards", "guards", items, seen, now,
                         ok="%d gate and change journal lines in 24 h, every write priced or passed, watcher up" % seen)
    out["rows"] += [row(["upstream instruction growth · %s · +%s B" % (file_key(top), fmt_count(total)), fmt_count(n),
                         clock(last, now)], dim=True) for top, (n, total, last) in sorted(upstream.items())]
    return out


# (fix command, [(dir, name, kind, source)]): every copy this repository's installers deploy. kind `copy` is
# byte-equal to the source file, `exec` a wrapper exec-ing the source script, `program` a generated plist whose
# program is the libexec wrapper named by source. A fix command of None is a hand copy (cp source target).
DEPLOYS = (
    ("bin/memlogd install-agent", (("libexec", "memlogd", "copy", "bin/memlogd"),
                                   ("libexec", "chat-load", "copy", "bin/chat-load"),
                                   ("libexec", "chat_names.py", "copy", "share/chat_names.py"),
                                   ("libexec", "report-bus", "copy", "bin/report-bus"),
                                   ("libexec", "report_frame.py", "copy", "share/report_frame.py"),
                                   ("agents", "com.egor.memlogd.plist", "copy", "launchd/com.egor.memlogd.plist"))),
    ("bin/llm-refresh install-agent", (("libexec", "llm-refresh-heartbeat", "exec", "bin/llm-refresh"),
                                       ("agents", "com.llm-refresh.plist", "copy", "launchd/com.llm-refresh.plist"))),
    ("bin/vendor-cli-update install", (("libexec", "vendor-cli-update", "exec", "bin/vendor-cli-update"),
                                       ("agents", "com.llm-legs.vendor-cli-update.plist", "program",
                                        "vendor-cli-update"))),
    ("bin/llm-selfcheck install", (("libexec", "llm-selfcheckd", "exec", "bin/llm-selfcheck"),
                                   ("agents", "com.llm-legs.selfcheck.plist", "program", "llm-selfcheckd"))),
    (None, (("libexec", "harness-doctor", "copy", "launchd/harness-doctor"),
            ("agents", "com.egor.harness-doctor.plist", "copy", "launchd/com.egor.harness-doctor.plist"))),
    (None, (("libexec", "tokenmap-scand", "copy", "launchd/tokenmap-scand"),
            ("agents", "com.tokenmap-scand.plist", "copy", "launchd/com.tokenmap-scand.plist"))),
)


def deploy_drift(target, kind, source):
    if not os.path.lexists(target):
        return "missing"
    if kind == "copy":
        try:
            with open(target, "rb") as deployed, open(source, "rb") as wanted:
                return None if deployed.read() == wanted.read() else "differs from its source"
        except OSError:
            return "unreadable"
    if kind == "exec":
        return None if source in wrapper_targets(target) else "runs %s" % (
            ", ".join(sorted(file_key(p) for p in wrapper_targets(target))) or "nothing")
    try:
        with open(target, "rb") as handle:
            program = (plistlib.load(handle).get("ProgramArguments") or [""])[0]
    except Exception:
        return "unreadable"
    return None if program == source else "runs %s" % file_key(program)


def deploys_section(now):
    """Each copy an installer of this repository deployed, against its source in the main checkout: launchd runs
    the deployed copy, so an edit to the source does nothing until the installer runs again. A group none of whose
    copies exists is not installed and is not judged."""
    source = os.environ.get("HARNESS_DEPLOY_SOURCE") or main_checkout(ROOT_DIR)
    dirs = {"libexec": libexec_dir(), "agents": os.path.join(base_home(), "Library", "LaunchAgents")}
    rows, checked = [], 0
    for fix, copies in DEPLOYS:
        targets = [(os.path.join(dirs[where], name), kind, src) for where, name, kind, src in copies]
        if not any(os.path.lexists(t) for t, _, _ in targets):
            continue
        for target, kind, src in targets:
            checked += 1
            wanted = os.path.join(dirs["libexec"], src) if kind == "program" else os.path.join(source, src)
            why = deploy_drift(target, kind, wanted)
            if not why:
                continue
            ident, command = file_key(target), fix or "cp %s %s" % (src, file_key(target))
            say = "%s %s · fix: %s" % (ident, why, command)
            try:
                at = os.lstat(target).st_mtime
            except OSError:
                at = now
            rows.append(row([clip("%s %s" % (ident, why), 80), command], [0], key="deploys:" + ident, say=say,
                            head="a deployed copy differs from its repo source",
                            judge=verdict("deploy-drift", ident, 1, 0, "copies", 0, checked, "red", fact=say,
                                          evidence=[evidence(at, "deploy:" + ident, "%s: %s" % (src, why))], bad=1)))
    return section("Deploys", rows, ["", "fix"], [False, False],
                   ok="%d deployed cop%s match%s the repo source" % (checked, "y" if checked == 1 else "ies",
                                                                    "es" if checked == 1 else ""))


def guard_kills(since):
    kills = []
    for path in glob.glob(os.path.join(memlogd_dir(), "????-??-??.log")):
        if os.path.basename(path)[:10] < local_day(since):
            continue
        try:
            with open(path, errors="replace") as handle:
                for text in handle:
                    if text.startswith("KILLED "):
                        try:
                            kills.append(int(text.split()[1]))
                        except (IndexError, ValueError):
                            pass
        except OSError:
            pass
    return sorted(kills)


def load_failures(tests, now, kills=()):
    """Class H: a run that failed while LIMITS load_fail_suites suite runs overlapped it, then passed
    with at most its own suite running within the hour; rows without `ok` are unknown and skipped."""
    suites = [(t["end"] - t["secs"], t["end"]) for t in tests if t.get("label") == "suites"]

    def crowd(t):
        start = t["end"] - t["secs"]
        return peak_overlap([(max(s, start), min(e, t["end"])) for s, e in suites if s < t["end"] and e > start])

    groups = {}
    for t in tests:
        groups.setdefault((t.get("repo"), t.get("label"), t.get("scope")), []).append(t)
    out = []
    for t in sorted(tests, key=lambda t: -t["end"]):
        if t.get("ok") is not False or now - t["end"] > LIMITS["test_slow_fresh_s"]:
            continue
        if any(t["end"] - t["secs"] - 5 <= k <= t["end"] + 5 for k in kills):
            continue
        busy = crowd(t)
        if busy < LIMITS["load_fail_suites"]:
            continue
        for later in sorted(groups[(t.get("repo"), t.get("label"), t.get("scope"))], key=lambda x: x["end"]):
            if (later.get("ok") is True and 0 < later["end"] - t["end"] <= LIMITS["load_pass_within_s"]
                    and crowd(later) <= 1):
                out.append((t, busy, later))
                break
    return out


def growth_section(growth, now, spool=None):
    if not growth:
        return None
    latest = growth[-1]
    week = [g for g in growth[:-1] if g.get("t", 0) <= now - 6.5 * 86400]
    before = week[-1]["stores"] if week else {}
    day = [g for g in growth[:-1] if g.get("t", 0) <= now - 20 * 3600]
    yesterday = day[-1]["stores"] if day else {}
    every = []
    for name, (count, size) in sorted(latest["stores"].items(), key=lambda kv: -(kv[1][1] or 0)):
        old = before.get(name, [None, None])[0]
        red, note = [], False
        loose = name.startswith("loose git objects")
        if loose:
            if count is not None and count > LIMITS["loose_red"]:
                red.append(1)
            elif count is not None and count > LIMITS["loose_note"]:
                note = True
            say = "%s: %s loose git objects slow its git, limit %s" % (
                name.split(" · ", 1)[-1], fmt_count(count or 0), fmt_count(LIMITS["loose_red"]))
        else:
            big = (count or 0) > LIMITS["store_entries"] or (size or 0) > LIMITS["store_bytes"]
            grew = old and count and count > LIMITS["store_growth"] * old
            day_old = (yesterday.get(name) or [None])[0]
            runaway = (name in PER_CALL_STORES and count and count > LIMITS["per_call_entries"] and day_old
                       and count > LIMITS["store_growth"] * day_old)
            if big and grew:
                red.append(1)
            elif big or runaway:
                note = True
            say = ("%s doubled in a week to %s entries" % (name, fmt_count(count or 0)) if red
                   else "%s doubled in a day to %s entries, its cleanup may have stopped" % (
                       name, fmt_count(count or 0)) if runaway and not big
                   else "%s holds %s entries, %s" % (name, fmt_count(count or 0), fmt_bytes(size)))
        ident = slug(name)
        rule, value, limit, unit = ("loose_objects", count, LIMITS["loose_red"], "entries") if loose else \
            ("store_runaway", count, LIMITS["per_call_entries"], "entries") if runaway and not big else \
            ("store_size", size, LIMITS["store_bytes"], "bytes") if (count or 0) <= LIMITS["store_entries"] and big else \
            ("store_size", count, LIMITS["store_entries"], "entries")
        every.append(row([clip(name, 40), fmt_count(count) if count is not None else "–",
                          fmt_count(old) if old is not None else "–",
                          fmt_count((size or 0) / float(1 << 20)) if size is not None else "–"], red,
                         dim=not red and not note, key="growth:" + ident, say=say if red or note else None,
                         judge=verdict(rule, ident, value, limit, unit, 24 * 7, 1,
                                       "red" if red else "watch" if note else None, fact=say, bad=int(bool(red or note)))))
    if spool is not None:
        count, oldest = spool
        stuck = oldest > 2 * SPOOL_STALE_S
        every.insert(0, row(["hook spool, not folded yet", fmt_count(count), "", ""], [1] if stuck else [],
                            dim=not stuck, key="growth:spool",
                            say="%d hook spool files wait to be folded, the oldest for %s" % (count, fmt_long(oldest))
                            if stuck else None,
                            judge=verdict("spool_stuck", "hook-spool", oldest, 2 * SPOOL_STALE_S, "s", 0, count,
                                          "red" if stuck else None, bad=count if stuck else 0)))
    columns, right = ["store", "entries", "a week ago", "size MB"], [False, True, True, True]
    if not before:
        columns, right = drop_column(every, columns, 2), [False, True, True]
    rows = [r for r in every if not r["dim"]]
    rows += [r for r in every if r not in rows][:max(0, 5 - len(rows))]
    nav = [line("all %d stores" % len(every), menu=section("", every, columns, right))] if len(every) > len(rows) else []
    return section("Growth", rows, columns, right, nav=nav,
                   ok="no store big enough to slow things down")


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", str(text).lower()).strip("-")


def test_ident(repo, label, root=None):
    if root:
        return "%s:%s" % (slug(os.path.basename(root.rstrip("/"))), label)
    repo = repo or ""
    home = siblings_dir(ROOT_DIR)
    main = repo and not repo.startswith("⧉") and os.path.isdir(os.path.join(home, repo, ".git"))
    return "%s:%s" % (slug(repo) if main else "worktree:" + (slug(repo.replace("⧉", "")) or "?"), label)


def drop_column(rows, columns, index):
    for r in rows:
        del r["cells"][index:index + 1]
    return columns[:index] + columns[index + 1:]


def day_share(day, now):
    start = day_start(day)
    return min(1.0, max(0.0, (now - start) / (day_end(day) - start)))


def new_period(need):
    return {"waits": {}, "hooks": {}, "floors": {}, "load": {k: [] for k in LOAD_KEYS},
            "load_days": dict.fromkeys(LOAD_KEYS, 0.0),
            "slow": 0.0, "days": 0.0, "hook_days": 0.0, "wall": 0.0, "test_days": 0.0, "by_test": {}, "need": need}


def add_test(p, t):
    p["by_test"].setdefault("%s · %s" % (t.get("label") or "?", repo_name(t.get("repo"))), []).append(t["secs"])


def period(summaries, days, now, tests, need=WEEK_MIN_DAYS):
    out = new_period(need)
    for day in days:
        summary = summaries.get(day)
        if not summary:
            continue
        share = day_share(day, now)
        out["days"] += share
        out["slow"] += summary.get("slow_s", 0)
        for key, entry in (summary.get("waits") or {}).items():
            hist_join(out["waits"].setdefault(key, hist_new()), entry)
        for key, entry in (summary.get("floors") or {}).items():
            hist_join(out["floors"].setdefault(key, hist_new()), entry)
        if summary.get("hooks"):
            out["hook_days"] += share
            for key, entry in summary["hooks"].items():
                hist_join(out["hooks"].setdefault(key, hist_new()), entry)
        for key, value in (summary.get("load") or {}).items():
            if key in out["load"]:
                out["load"][key].append(value)
                out["load_days"][key] += 1
    first = local_day(min(t["end"] for t in tests)) if tests else None
    for day in days:
        mine = [t for t in tests if local_day(t["end"]) == day]
        if first and day >= first:
            out["test_days"] += day_share(day, now)
        out["wall"] += union_secs([(t["end"] - t["secs"], t["end"]) for t in mine])
        for t in mine:
            add_test(out, t)
    return out


def raw_period(raw, tests, start, end, need):
    """(start, end] off the raw rows, for the windows shorter than a day summary; coverage is in days
    so a rate keeps its per-day unit."""
    out = new_period(need)

    def cover(since):
        return max(0.0, end - max(start, since)) / 86400.0 if since is not None else 0.0

    out["waits"] = wait_hists([e for e in raw.get("events", ()) if start < e[1] <= end])
    out["slow"] = overlap_secs(raw.get("windows", ()), start, end)
    out["days"] = cover(raw.get("events_since"))
    for slot, entries in raw.get("hook_slots", {}).items():
        if start < int(slot) + SLOT_S / 2 <= end:
            for key, entry in entries.items():
                hist_join(out["hooks"].setdefault(key, hist_new()), entry)
    out["hook_days"] = cover(raw.get("hooks_since"))
    for t, cls, ms in raw.get("floors", ()):
        if start < t <= end:
            hist_put(out["floors"].setdefault(cls, hist_new()), ms)
    for key in LOAD_KEYS:
        mine = [(s["t"], sample_value(s, key)) for s in raw.get("samples", ()) if start < s.get("t", 0) <= end]
        out["load"][key] = [v for _, v in mine if v is not None]
        out["load_days"][key] = len({int(t // SAMPLE_STEP_S) for t, v in mine if v is not None}) * SAMPLE_STEP_S / 86400.0
    out["test_days"] = cover(min((t["end"] - t["secs"] for t in tests), default=None))
    mine = [t for t in tests if start < t["end"] <= end]
    out["wall"] = union_secs([(max(start, t["end"] - t["secs"]), t["end"]) for t in mine])
    for t in mine:
        add_test(out, t)
    return out


def by_hist(entry):
    return (hist_percentile(entry, 0.5), bool(entry) and entry[0] >= WEEK_MIN_RUNS)


def by_rate(p, total, days_key, unit):
    days = p[days_key]
    return (total / days / unit if days else None, days >= p["need"])


def by_mean(p, key, scale=1.0):
    values = p["load"][key]
    return (mean(values) * scale if values else None, p["load_days"][key] >= p["need"])


def bash_waits(p):
    merged = hist_new()
    for key, entry in p["waits"].items():
        if key.startswith("bash:"):
            hist_join(merged, entry)
    return merged


def blank(fmt):
    return lambda v: "–" if v is None else fmt(v)


def tool_floors(p):
    merged = hist_new()
    for key, entry in p["floors"].items():
        if not key.startswith("event:"):
            hist_join(merged, entry)
    return merged


WEEK_METRICS = (
    ("Bash wait s", lambda p: by_hist(bash_waits(p)), blank(num)),
    ("Edit wait s", lambda p: by_hist(p["waits"].get("edit")), blank(num)),
    ("Read wait s", lambda p: by_hist(p["waits"].get("read")), blank(num)),
    ("chat start s", lambda p: by_hist(p["waits"].get("event:SessionStart")), blank(num)),
    ("turn end s", lambda p: by_hist(p["waits"].get("event:Stop")), blank(num)),
    ("hook wait ms", lambda p: by_hist(tool_floors(p)), blank(lambda v: num(v * 1000))),
    ("slow h/day", lambda p: by_rate(p, p["slow"], "days", 3600.0), blank(num)),
    ("hooks h/day", lambda p: by_rate(p, sum(e[1] for k, e in p["hooks"].items() if k != STATUSLINE_KEY),
                                      "hook_days", 3600000.0), blank(num)),
    ("CPU busy %", lambda p: by_mean(p, "busy", 100.0), blank(lambda v: "%d" % round(v))),
    ("kernel %", lambda p: by_mean(p, "kernel", 100.0), blank(lambda v: "%d" % round(v))),
    ("new proc/s", lambda p: by_mean(p, "forks"), blank(lambda v: fmt_count(round(v)))),
    ("unaccounted cores", lambda p: by_mean(p, "unseen"), blank(lambda v: "%.1f" % v)),
    ("tests h/day", lambda p: by_rate(p, p["wall"], "test_days", 3600.0), blank(num)),
)


def window_label(hours):
    return "%d d" % (hours // 24) if hours >= 72 else "%d h" % hours


def delta(cur, prev, enough=True):
    """Row db of docs/shared-invariants.md: tokenmap tracking.py's Δ, cell text and tone alike."""
    if cur is None or prev is None or not (cur or prev):
        return "", ""
    if not prev:
        return "new", ""
    ratio = cur / prev
    pct = round((ratio - 1) * 100)
    text = "×%.0f" % ratio if ratio >= DELTA_TIMES_FROM else "%+d%%" % pct if pct else "0%"
    if abs(ratio - 1) < DELTA_MATERIAL or not enough:
        return text, ""
    return text, "worse" if cur > prev else "better"


def compare_row(label, cur, prev, fmt, menu=None):
    text, tone = delta(cur[0], prev[0], cur[1] and prev[1])
    out = row([label, fmt(cur[0]), fmt(prev[0]), text], red=[3] if tone == "worse" else [],
              green=[3] if tone == "better" else [], dim=cur[0] is None and prev[0] is None, menu=menu)
    out["tone"] = tone
    return out


def compare_columns(header, hours):
    return [header, window_label(hours), "prev " + window_label(hours), "Δ"]


def compare_table(header, hours, cur, prev, labels, value, fmt):
    rows = [compare_row(label, value(cur, key), value(prev, key), fmt) for key, label in labels]
    return section("", rows, compare_columns(header, hours), [False, True, True, True])


def week_days(now):
    today = local_day(now)
    noon = day_start(today) + 12 * 3600
    monday = local_day(noon - time.localtime(noon).tm_wday * 86400)
    weeks = []
    for back in range(BY_WEEKS - 1, -1, -1):
        first = day_start(monday) + 12 * 3600 - back * 7 * 86400
        weeks.append([d for d in (local_day(first + k * 86400) for k in range(7)) if d <= today])
    return weeks


def periods_section(summaries, raw, tests, now, hooks):
    """One comparison per picker window, keyed by its hours: a day window reads the day summaries,
    an hour window the raw rows. Returns them and the current 7 days, which Waits reads."""
    names = hook_names(hooks)
    out, week = {}, None
    for hours in DOCTOR_WINDOWS_H:
        if hours in WINDOW_MIN_DAYS:
            count, need = hours // 24, WINDOW_MIN_DAYS[hours]
            days = day_list(now, 2 * count)
            cur, prev = period(summaries, days[:count], now, tests, need), period(summaries, days[count:], now, tests,
                                                                                   need)
        else:
            span, need = hours * 3600, RAW_MIN_COVER * hours / 24.0
            cur, prev = raw_period(raw, tests, now - span, now, need), raw_period(raw, tests, now - 2 * span, now - span,
                                                                                 need)
        nav = []
        if hours == 168:
            week = cur
            weeks = week_days(now)
            per_week = [period(summaries, w, now, tests) for w in weeks]
            nav.append(line("by week", dim=False, menu=section(
                "", [row([label] + [fmt(value(p)[0]) for p in per_week]) for label, value, fmt in WEEK_METRICS],
                ["week (Mon–Sun)"] + [w[0][5:] for w in weeks], [False] + [True] * len(weeks))))
        out[str(hours)] = compare_entry(cur, prev, hours, names, nav)
    return out, week


def compare_entry(cur, prev, hours, names, nav):
    def ranked(pairs, weight, limit):
        return sorted(pairs, key=lambda kv: -weight(kv[0]))[:limit]

    projects = ranked([(k, "Bash · " + clip(k[5:], 22)) for k in set(cur["waits"]) | set(prev["waits"])
                       if k.startswith("bash:")], lambda k: (cur["waits"].get(k) or [0])[0], 10)
    hook_keys = ranked([(k, clip(names.get(k) or (menu_label(k) if k.startswith(MENU_KEY)
                                                   else re.sub(r"\.sh\b", "", k, count=1)), 28))
                        for k in set(cur["hooks"]) | set(prev["hooks"])],
                       lambda k: (cur["hooks"].get(k) or [0, 0])[1], INVENTORY_ROWS)
    test_keys = ranked([(k, clip(k, 34)) for k in set(cur["by_test"]) | set(prev["by_test"])],
                       lambda k: sum(cur["by_test"].get(k) or []), 10)
    drills = {
        "Bash wait s": compare_table("Bash wait s", hours, cur, prev, projects,
                                     lambda p, k: by_hist(p["waits"].get(k)), blank(num)),
        "hooks h/day": compare_table("hook median ms", hours, cur, prev, hook_keys,
                                     lambda p, k: by_hist(p["hooks"].get(k)), blank(lambda v: num(v * 1000))),
        "hook wait ms": compare_table("hook wait ms", hours, cur, prev, [(k, label) for k, label, _ in FLOOR_ROWS
                                                                        if k in cur["floors"] or k in prev["floors"]],
                                      lambda p, k: by_hist(p["floors"].get(k)), blank(lambda v: num(v * 1000))),
        "tests h/day": compare_table("test median min", hours, cur, prev, test_keys,
                                     lambda p, k: (median(p["by_test"].get(k) or []) / 60.0
                                                   if p["by_test"].get(k) else None,
                                                   len(p["by_test"].get(k) or []) >= WEEK_MIN_DAYS), blank(num)),
    }
    rows = [compare_row(label, value(cur), value(prev), fmt, menu=drills.get(label) if drills.get(label, {}).get(
        "rows") else None) for label, value, fmt in WEEK_METRICS]
    out = section("", rows, compare_columns("", hours), [False, True, True, True], nav=nav)
    worse = sum(1 for r in rows if r["tone"] == "worse")
    better = sum(1 for r in rows if r["tone"] == "better")
    parts = [("%s vs prev %s" % (window_label(hours), window_label(hours)), "")]
    if worse:
        parts.append((" · worse", "r"))
    if better:
        parts.append(((", " if worse else " · ") + "better", "g"))
    entry = line("".join(p[0] for p in parts), dim=False, menu=out)
    entry.update(parts=parts, hours=hours)
    return entry


IMPACT_COLUMNS = {"floor": ("floor", "bash"), "hook": ("floor", "bash"), "load": ("busy", "forks"),
                  "tests": ("suite", "forks"), "wait": ("bash", "forks")}
IMPACT_NAMES = {"bash": "short Bash s", "forks": "new proc/s", "busy": "CPU busy", "floor": "hook wait ms",
                "suite": "suite min"}


def impact_measures(key):
    return IMPACT_COLUMNS.get((key or "").split(":")[0], ("bash", "forks"))


def change_impact(calls, samples, now, floors=(), tests=()):
    short = [(c[1], c[5]) for c in calls if c[3] == "Bash" and c[4] and c[6] != "h"]
    enough = lambda xs: xs if len(xs) >= LIMITS["impact_min_calls"] else []

    def measure(name, key, start, end):
        if name == "bash":
            return median(enough([w for t, w in short if start <= t < end]))
        if name == "floor":
            cls = key[len("floor:"):] if key and key.startswith("floor:") else None
            return median(enough([f["ms"] for f in floors if start <= f["t"] < end and (not cls or f["cls"] == cls)]))
        if name == "suite":
            return median(enough([t["secs"] for t in tests if t.get("label") == "suites" and start <= t["end"] < end]))
        return mean([s[name] for s in samples if start <= s.get("t", 0) < end and s.get(name) is not None])

    fmts = {"bash": num, "forks": lambda v: fmt_count(round(v)), "busy": fmt_pct, "floor": num,
            "suite": lambda v: num(v, 60.0)}

    def pair(before, after, fmt):
        if before is None and after is None:
            return "–"
        return "%s→%s" % (fmt(before) if before is not None else "–", fmt(after) if after is not None else "–")

    def around(at, name, key):
        end = min(at + 3600, now)
        return measure(name, key, at - 3600, at), measure(name, key, at, end)

    def impact(at, key=None):
        return [pair(*around(at, name, key), fmts[name]) for name in impact_measures(key)]

    def step(at, key=None):
        before, after = around(at, impact_measures(key)[0], key)
        return (after - before) / before if before and after is not None else 0.0

    impact.step = step
    return impact


def change_table(changes, impact, key=None):
    rows = [row([time.strftime("%m-%d %H:%M", time.localtime(c["at"])), c["kind"], clip(c["what"], 44)]
                + impact(c["at"], key)) for c in changes]
    return section("", rows, ["at", "change", "what"] + [IMPACT_NAMES[n] for n in impact_measures(key)],
                   [False, False, False, True, True])


def rank_changes(changes, subject, since, impact):
    text = " ".join([subject.get("key") or "", subject.get("say") or ""] + subject.get("cells", [])).lower()
    step = getattr(impact, "step", lambda at, key=None: 0.0)

    def named(change):
        stem = re.sub(r"\.(sh|py|lua|json)$", "", os.path.basename(change["what"].split(" ")[0])).lower()
        return len(stem) >= 4 and stem in text

    return sorted(changes, key=lambda c: (not named(c), -step(c["at"], subject.get("key")), abs(since - c["at"])))


def attach_causes(state, sections, changes_log, impact, now):
    """A problem area names the changes before its first red; a watch area those before its first watch,
    so a step under a hard limit is attributed too."""
    born = state.setdefault("born", now)
    firstred = state.setdefault("firstred", {})
    firstwatch = state.setdefault("firstwatch", {})
    families = state.setdefault("families", {})

    def watched(r):
        return not r.get("red") and not r.get("dim") and r.get("say")

    for part in sections:
        for r in part["rows"] + part.get("extra_red", []) + part.get("lead", []):
            for store, hit in ((firstred, r.get("red")), (firstwatch, watched(r))):
                if r.get("key"):
                    families.setdefault(r["key"].split(":")[0], now)
                if hit and r.get("key"):
                    entry = store.setdefault(r["key"], {"since": now, "label": r["cells"][0]})
                    entry["last"] = now
    for store in (firstred, firstwatch):
        for key in [k for k, v in store.items() if now - v.get("last", 0) > 3600]:
            del store[key]
    for part in sections:
        store = firstred if part["state"] == "problem" else firstwatch
        reds = [r for r in part["rows"] + part.get("extra_red", []) + part.get("lead", [])
                if (r.get("red") if store is firstred else watched(r)) and r.get("key") in store]
        if part["state"] not in ("problem", "watch") or not reds:
            continue
        first = min(reds, key=lambda r: store[r["key"]]["since"])
        since = store[first["key"]]["since"]
        if since <= families.get(first["key"].split(":")[0], born):
            since = min(since, born)
        stamp = time.strftime("%H:%M" if local_day(since) == local_day(now) else "%m-%d %H:%M", time.localtime(since))
        if since <= born:
            part["lead"].insert(0, line("started before %s · cause unknown" % stamp, dim=False))
            continue
        part["fact"] += " · since " + stamp
        near = rank_changes([c for c in changes_log if since - 6 * 3600 <= c["at"] <= since + 900], first, since,
                            impact)
        if near:
            part["lead"].insert(0, line("started %s · %d change%s before it" % (
                stamp, len(near), "" if len(near) == 1 else "s"), dim=False,
                menu=change_table(near[:12], impact, first.get("key"))))
        else:
            part["lead"].insert(0, line("started %s · no change in the 6 h before" % stamp, dim=False))


def load_changes(now):
    rows = []
    try:
        with open(os.path.join(state_dir(), "changes.jsonl")) as handle:
            for line_text in handle:
                try:
                    change = json.loads(line_text)
                except ValueError:
                    continue
                if isinstance(change, dict) and now - change.get("at", 0) <= DAY_SUMMARY_DAYS * 86400:
                    rows.append(change)
    except OSError:
        pass
    return rows


HOLDS_GROUP = "Limiter holds"
SPEED_GROUP = "Speed"
WAITS_GROUP = "Wait classes"
SPEED_SECTIONS = ("Waits", WAITS_GROUP, "Slow periods", "Hook waits", "Hooks", "Load", "Tests", "Collector")
SPLITS = (("Hooks", "Hook health", ("hooks:fastpath", "hooks:unjournaled"), "every hook keeps its fast path and journal"),
          ("Tests", "Test flakes", ("tests:load",), "no suite failed under load"),
          ("Load", "Memory guard", ("load:memory",), "no memory guard alarm"))
LOUD_STATES = ("new", "open", "regressed")


def regroup(sections):
    """The Speed sections keep the rules that judge time; the lines that judge health move to sections of their own."""
    by_name = {part["name"]: part for part in sections}
    out = list(sections)
    for source, name, keys, ok in SPLITS:
        part = by_name.get(source) or section(source, [], [""], [False])
        rows = [r for r in part["rows"] if r.get("key") in keys]
        lead = [i for i in part["lead"] if i.get("key") in keys]
        if rows or lead:
            part["rows"] = [r for r in part["rows"] if r not in rows]
            part["lead"] = [i for i in part["lead"] if i not in lead]
            part["extra_red"] = [i for i in part.get("extra_red", []) if i not in lead]
            settled = section(source, part["rows"], part["columns"], part["right"], ok=part.get("ok", ""),
                              blind=part.get("blind", ""))
            if part["extra_red"] and settled["state"] != "problem":
                settled.update(state="problem", fact=part["extra_red"][0].get("say") or part["extra_red"][0]["cells"][0])
            part.update(state=settled["state"], fact=settled["fact"])
        moved = section(name, rows, part["columns"], part["right"], lead=lead, ok=ok, blind=part.get("blind", ""))
        red = [i for i in lead if i.get("red")]
        if red:
            moved["extra_red"] = red
            if moved["state"] != "problem":
                moved.update(state="problem", fact=red[0].get("say") or red[0]["cells"][0])
        elif moved["state"] == "ok" and [i for i in lead if not i.get("dim") and i.get("say")]:
            moved.update(state="watch", fact=next(i["say"] for i in lead if not i.get("dim") and i.get("say")))
        out.append(moved)
    return out


def in_speed(problem):
    return problem.get("group") in SPEED_SECTIONS or problem.get("group") == SPEED_GROUP


def settle_title(document):
    count = sum(1 for p in document["problems"] if p["state"] in LOUD_STATES)
    blind_areas = [s["name"] for s in document["sections"] if s["state"] == "blind"]
    document.update(problem_count=count, status="problems" if count else "blind" if blind_areas else "ok",
                    title="Harness doctor: " + ("%d problem%s" % (count, "" if count == 1 else "s") if count
                                                else "blind · " + ", ".join(blind_areas) if blind_areas else "ok"))


def apply_speed(document, speed):
    """Lays bin/speed-doctor's section into a Harness document. Whatever an earlier section added or demoted is
    undone first, so a carried-over or repeated section never stacks; a rule whose component Speed judges against
    a baseline keeps its verdict only as `was_state`, so each rule is counted once."""
    problems = []
    for p in document["problems"]:
        if p.get("speed"):
            continue
        if "judged_by" in p:
            p = {k: v for k, v in dict(p, state=p["was_state"]).items() if k not in ("judged_by", "was_state")}
        problems.append(p)
    blind = [b for b in document.get("blind_spots") or () if not str(b.get("id", "")).startswith("speed:")]
    document.pop("speed", None)
    if speed:
        covers = {(rule, ident): component for rule, ident, component in speed.get("covers") or ()}
        for i, p in enumerate(problems):
            component = covers.get((p.get("rule"), p.get("ident"))) or covers.get((p.get("rule"), "*"))
            if component and p["state"] != "fixed-pending":
                problems[i] = dict(p, state="watch", was_state=p["state"], judged_by="speed:" + component)
        problems += [dict(p, speed=True, group=SPEED_GROUP) for p in speed.get("problems") or ()]
        blind += [dict(b, id="speed:%s" % b.get("id")) for b in speed.get("blind_spots") or ()]
        document["speed"] = speed
    document["problems"], document["blind_spots"] = problems, blind
    settle_title(document)
    return document


class MenuLines:
    """The menu as laid-out lines: `depth<TAB>flags<TAB>spans<TAB>text`, spans as `style:byte:bytes`.
    hs.json.decode of the document costs ~40 ms per menu open; these lines cost a match each."""

    def __init__(self, count, as_of_s, title):
        self.lines = ["T\t%d\t%d\t%s" % (count, as_of_s, title)]
        self.tag = ""

    def text(self):
        return "\n".join(self.lines) + "\n"

    def emit(self, depth, flags, spans, text):
        self.lines.append("%d\t%s\t%s\t%s" % (depth, flags + self.tag, ",".join("%s:%d:%d" % s for s in spans),
                                              text.replace("\t", " ").replace("\n", " ") or " "))

    def free(self, item, depth):
        text = item["cells"][0]
        spans = [("r", 0, len(text.encode()))] if item.get("red") else []
        if item.get("parts"):
            at = 0
            for piece, style in item["parts"]:
                size = len(piece.encode())
                if style:
                    lead = len(piece[:len(piece) - len(piece.lstrip(" ·,"))].encode())
                    spans.append((style, at + lead, size - lead))
                at += size
        self.emit(depth, "d" if item.get("dim") else "", spans, text)
        if item.get("menu"):
            self.layout(item["menu"], depth + 1)

    def grid_rows(self, columns, right, rows, depth, header=True):
        grid = ([[str(c) for c in columns]] if header else []) + [r["cells"] for r in rows]
        if not grid:
            return
        count = max(len(r) for r in grid)
        widths = [max(len(r[c]) if c < len(r) else 0 for r in grid) for c in range(count)]
        right = list(right) + [False] * count
        for index, cells in enumerate(grid):
            source = rows[index - 1 if header else index] if index or not header else None
            last = max([c for c, text in enumerate(cells) if text != ""] or [-1])
            text, spans = "", []
            for c in range(last + 1):
                piece = cells[c] if c == last and not right[c] else (
                    cells[c].rjust(widths[c]) if right[c] else cells[c].ljust(widths[c]))
                if c:
                    text += "  "
                style = source and ("r" if c in source.get("red", ()) else "g" if c in source.get("green", ())
                                    else "n" if c in source.get("bright", ()) else "")
                if style:
                    lead = len(piece) - len(piece.lstrip(" "))
                    spans.append((style, len((text + piece[:lead]).encode()), len(piece.strip(" ").encode())))
                text += piece
            if source is None:
                self.emit(depth, "d", [], text)
            else:
                self.emit(depth, "d" if source.get("dim") else "", spans, text)
                if source.get("menu"):
                    self.layout(source["menu"], depth + 1)

    def layout(self, part, depth):
        for item in part.get("lead", ()):
            self.free(item, depth)
        if part["rows"]:
            self.grid_rows(part["columns"], part["right"], part["rows"], depth)
        if part.get("nav"):
            self.emit(depth, "s", [], "-")
        for item in part.get("nav", ()):
            self.free(item, depth)

    def areas(self, sections, problems, depth=0, group_of=lambda p: p.get("group")):
        """One `Area: state · fact` line per section, opening it; problems no section names get lines of their own."""
        counted = {}
        for problem in problems:
            if problem["state"] in LOUD_STATES:
                counted.setdefault(group_of(problem), []).append(problem)
        for part in sections:
            count = len(counted.pop(part["name"], ()))
            state = "%d problem%s" % (count, "" if count == 1 else "s") if count else (
                "watch" if part["state"] == "problem" else part["state"])
            parts = [(part["name"], "n" if state == "ok" else ""), (": ", ""), (state, "r" if count else "")]
            parts += [(" · " + part["fact"], "")] if part["fact"] else []
            self.free({"cells": ["".join(p for p, _ in parts)], "parts": parts, "dim": state == "ok", "menu": part},
                      depth)
        return counted

    def groups(self, counted, depth):
        """Problems whose group no section names, one line per group."""
        for group, problems in sorted(counted.items(), key=lambda item: str(item[0])):
            state = "%d problem%s" % (len(problems), "" if len(problems) == 1 else "s")
            parts = [(str(group or "Other"), ""), (": ", ""), (state, "r")]
            self.free({"cells": ["".join(p for p, _ in parts)], "parts": parts,
                       "menu": {"lead": [line(p["fact"] or p["id"], dim=False) for p in problems], "rows": []}}, depth)

    def periods(self, periods, depth=0):
        for hours in sorted(periods or {}, key=int):
            self.tag = "w" + hours
            self.free(periods[hours], depth)
        self.tag = ""


def speed_block(menu, document, parts):
    """The top line: Speed's headline, then its own lines as bin/speed-doctor laid them out, then the sections
    whose rules judge time."""
    speed = document.get("speed") or {}
    loud = [p for p in document["problems"] if p["state"] in LOUD_STATES and in_speed(p)]
    state = "%d problem%s" % (len(loud), "" if len(loud) == 1 else "s") if loud else "ok"
    head = [(SPEED_GROUP, ""), (": ", ""), (state, "r" if loud else ""),
            (" · " + (speed.get("head") or "not measured yet"), "")]
    menu.free({"cells": ["".join(p for p, _ in head)], "parts": head}, 0)
    for depth, flags, red, text in speed.get("menu") or ():
        menu.emit(1 + depth, flags, [("r", 0, len(text.encode()))] if red else [], text)
    if speed.get("menu") and parts:
        menu.emit(1, "s", [], "-")
    counted = menu.areas(parts, [p for p in document["problems"] if in_speed(p) and p.get("group") != SPEED_GROUP], 1)
    menu.groups(counted, 1)


def menu_text(document):
    count = document["problem_count"] or (1 if document["status"] == "error" else 0)
    menu = MenuLines(count, document["as_of_s"], document["title"])
    groups = collections.Counter(p.get("group") or "Other" for p in document["problems"]
                                 if p.get("state") in LOUD_STATES)
    speed = document.get("speed") or {}
    header = {"status": document["status"], "problems": [
        {k: p[k] for k in ("id", "ledger") if k in p} for p in document["problems"]],
        "issues": [[count, group] for group, count in groups.most_common(3)],
        "speed": {k: speed[k] for k in ("as_of_s", "status", "lost_min_day", "lost_min_day_by_day") if k in speed}}
    header["speed"]["issues"] = [[f["recoverable_min_day"], f["label"]]
                                 for f in sorted((speed.get("budget") or {}).get("floors") or (),
                                                 key=lambda f: -f["recoverable_min_day"])
                                 if f["recoverable_min_day"] > 0][:3]
    menu.lines.append("H\t" + json.dumps(header, separators=(",", ":")))
    sections = document.get("sections") or ()
    if document["status"] != "error":
        speed_block(menu, document, [s for s in sections if s["name"] in SPEED_SECTIONS])
    counted = menu.areas([s for s in sections if s["name"] not in SPEED_SECTIONS],
                         [p for p in document["problems"] if not in_speed(p)])
    menu.groups(counted, 0)
    menu.emit(0, "s", [], "-")
    menu.periods(document.get("periods"))
    for item in document.get("extras", ()):
        menu.free(item, 0)
    menu.emit(0, "s", [], "-")
    menu.emit(0, "d", [], document["footer"])
    return menu.text()


# ---------------------------------------------------------------- contract (docs/doctors-contract.md)


CONTRACT = 1
PROOF_MIN_EXPOSURE = 20
PROOF_SHOW_S = 7 * 86400
SEEN_GAP_S = 86400
SEEN_KEEP_S = 30 * 86400
LEVELS = {"red": 2, "watch": 1}
DISMISSED = ("not-a-bug", "weather")
LEDGER_STATUSES = ("open", "fixed-pending", "fixed") + DISMISSED
IDENT_TOKEN_RE = re.compile(r"\\[dDwWsSbBAZ]|\\(.)|\[(?:\\.|[^\]])*\]|\{\d*,?\d*\}|[.^$*+?()|]|(.)", re.S)


def ledger_path():
    return os.environ.get("HARNESS_LEDGER") or os.path.join(ROOT_DIR, "share", "harness-ledger.json")


def repos_dir():
    return os.environ.get("HARNESS_REPOS_DIR") or siblings_dir(ROOT_DIR)


def load_ledger():
    try:
        with open(ledger_path(), "rb") as handle:
            raw = handle.read()
    except OSError:
        return {"owner": "Harness Doctor", "rows": [], "blind_spots": []}, b""
    try:
        return json.loads(raw), raw
    except ValueError:
        return None, raw


def judge_digest(ledger_raw):
    digest = hashlib.sha256()
    with open(os.path.realpath(__file__), "rb") as handle:
        digest.update(handle.read())
    digest.update(ledger_raw)
    digest.update(json.dumps(LIMITS, sort_keys=True).encode())
    return digest.hexdigest()


def at_epoch(text):
    try:
        return datetime.datetime.fromisoformat(text).timestamp()
    except (TypeError, ValueError):
        return None


def ident_tokens(pattern):
    return [bool(m.group(1) or m.group(2)) for m in IDENT_TOKEN_RE.finditer(pattern)]


def ident_probes():
    rand = random.Random(0)
    word = lambda: "".join(rand.choice("abcdefghijklmnopqrstuvwxyz0123456789_") for _ in range(rand.randint(4, 12)))
    shapes = ("bash:%s", "event:%s", "%s.sh", "%s:%s", "~/%s/%s.md", "/Volumes/%s/%s", "inline-%s", "%s-%s",
              "worktree:%s:test_%s", "%s:test_%s", "busy-%s", "%s")
    return [shape % tuple(word() for _ in range(shape.count("%s"))) for shape in shapes for _ in range(20)]


def row_faults(entry, ids, probes):
    if not isinstance(entry, dict) or not isinstance(entry.get("id"), str) or not entry["id"]:
        return ["no id"]
    faults = ["id used twice"] if ids.count(entry["id"]) > 1 else []
    if entry.get("status") not in LEDGER_STATUSES:
        faults.append("status %r" % entry.get("status"))
    match = entry.get("match") if isinstance(entry.get("match"), dict) else {}
    ident = match.get("ident")
    if not isinstance(match.get("rule"), str) or not isinstance(ident, str) or not ident:
        return faults + ["match is {rule, ident}"]
    try:
        compiled = re.compile(ident)
    except re.error as exc:
        return faults + ["ident %r is no regex: %s" % (ident, exc)]
    literal = ident_tokens(ident)
    if sum(literal) < 3:
        faults.append("ident %r names fewer than 3 literal characters" % ident)
    if compiled.fullmatch(""):
        faults.append("ident %r matches the empty ident" % ident)
    hits = [p for p in probes if compiled.fullmatch(p)]
    if hits:
        faults.append("ident %r matches random idents such as %r" % (ident, hits[0]))
    if entry.get("status") in DISMISSED and not all(literal):
        faults.append("a dismissal matches one ident exactly, %r is a pattern" % ident)
    return faults


def ledger_faults(ledger):
    if ledger is None:
        return [("ledger", "is not JSON")]
    rows = ledger.get("rows") if isinstance(ledger, dict) else None
    if not isinstance(rows, list):
        return [("ledger", "rows is not a list")]
    ids = [r.get("id") for r in rows if isinstance(r, dict)]
    probes = ident_probes()
    return [(r["id"] if isinstance(r, dict) and isinstance(r.get("id"), str) and r["id"] else "#%d" % i, fault)
            for i, r in enumerate(rows) for fault in row_faults(r, ids, probes)]


def ledger_row(ledger, rule, ident):
    for entry in ledger.get("rows") or ():
        match = entry.get("match") or {}
        try:
            if match.get("rule") == rule and match.get("ident") and re.fullmatch(match["ident"], ident):
                return entry
        except re.error:
            continue
    return None


def ledger_row_by_id(ledger, ident):
    return next((r for r in ledger.get("rows") or () if r.get("id") == ident), None)


def last_fix_at(entry):
    fixes = (entry or {}).get("fixes") or []
    if not fixes:
        return None
    at, landed = at_epoch(fixes[-1].get("at")), fix_landed(fixes[-1].get("in"), repos_dir())
    return at if at is None or landed is None else max(at, landed)


def all_verdicts(sections):
    merged, stack = {}, [(part.get("name"), part) for part in sections]
    while stack:
        group, part = stack.pop(0)
        for item in part.get("lead", []) + part.get("rows", []) + part.get("extra_red", []) + part.get("nav", []):
            for v in item.get("judge") or ():
                v = dict(v, fact=v.get("fact") or item.get("say") or item["cells"][0], group=group)
                key = (v["rule"], v["ident"])
                if key not in merged or LEVELS.get(v["level"], 0) > LEVELS.get(merged[key]["level"], 0):
                    merged[key] = v
            if isinstance(item.get("menu"), dict):
                stack.append((group, item["menu"]))
    return [merged[k] for k in sorted(merged)]


def hook_ident(command):
    return hook_key(command) if hook_script(command) else "inline-" + hashlib.sha1(command.encode()).hexdigest()[:10]


def unjournaled_dismissals(hooks, ledger):
    dismissed, blind, done = set(), [], set()
    for hook in hooks:
        ident = hook_ident(hook["command"])
        if hook_journaled(hook["command"]) or ident in done:
            continue
        done.add(ident)
        entry = ledger_row(ledger, "unjournaled", ident)
        if entry and entry.get("status") in DISMISSED:
            dismissed.add(ident)
        blind.append({"id": "unjournaled:" + ident, "what": "hook time of %s on %s outside the hook journal, known "
                      "only when it printed" % (hook_label(hook["command"]), hook["event"]),
                      "reason": entry and (entry.get("note") or entry.get("title")) or "no hook-time line",
                      "since": None, "would_catch_if": "the hook sources %s" % HOOK_TIME_LIB})
    return dismissed, blind


def settle_fixes(ledger):
    changed = False
    for entry in ledger.get("rows") or ():
        fixes = entry.get("fixes") or []
        if entry.get("status") != "fixed-pending" or not fixes or fixes[-1].get("in"):
            continue
        found = fix_commit(fixes[-1], repos_dir())
        if found:
            fixes[-1]["in"] = found
            entry["status"] = "fixed"
            changed = True
    return changed


def write_fix_fields(judging):
    fresh, raw = load_ledger()
    if not raw or not isinstance(fresh, dict):
        return
    rows = {r.get("id"): r for r in fresh.get("rows") or () if isinstance(r, dict)}
    for entry in judging.get("rows") or ():
        target = rows.get(entry["id"])
        mine = (entry.get("fixes") or [None])[-1]
        theirs = ((target or {}).get("fixes") or [None])[-1]
        if not isinstance(mine, dict) or not isinstance(theirs, dict) or mine.get("at") != theirs.get("at"):
            continue
        for key in ("in", "regressed_at"):
            if mine.get(key) and not theirs.get(key):
                theirs[key] = mine[key]
        if entry.get("status") == "fixed" and target.get("status") == "fixed-pending" and theirs.get("in"):
            target["status"] = "fixed"
    with open(ledger_path() + ".tmp", "w") as handle:
        handle.write(json.dumps(fresh, indent=2, ensure_ascii=False) + "\n")
    os.replace(ledger_path() + ".tmp", ledger_path())


def problems_from(sections, ledger, state, now, extra=()):
    seen = state.setdefault("seen", {})
    proof_state = state.setdefault("proof", {})
    verdicts = all_verdicts(sections) + list(extra)
    by_id, touched = {}, {}
    for v in verdicts:
        entry = ledger_row(ledger, v["rule"], v["ident"])
        if entry:
            touched.setdefault(entry["id"], []).append(v)
        if not v["level"] or (entry and entry.get("status") in DISMISSED):
            continue
        if v["level"] == "watch" and entry and entry.get("status") in ("fixed", "fixed-pending"):
            continue
        pid = entry["id"] if entry else v.get("pid") or "%s:%s" % (v["rule"], v["ident"])
        fix_at = last_fix_at(entry)
        times = [t for t in (at_epoch(e["at"]) for e in v["evidence"]) if t]
        if v["level"] == "watch":
            state_name = "watch"
        elif not entry:
            state_name = "new"
        elif entry.get("status") == "open" or not fix_at:
            state_name = "open"
        elif any(t > fix_at for t in times) or (not times and now - v["window_h"] * 3600 >= fix_at):
            state_name = "regressed"
        else:
            state_name = "fixed-pending"
        old = by_id.get(pid)
        bad = [b for b in ([old["_bad"]] if old else []) + [v.get("bad")] if b is not None]
        if old and LEVELS.get(old["_level"], 0) >= LEVELS.get(v["level"], 0):
            old["evidence"] = (old["evidence"] + v["evidence"])[:3]
            old["_bad"] = sum(bad) if bad else None
            continue
        by_id[pid] = {"id": pid, "rule": v["rule"], "ident": v["ident"], "state": state_name, "fact": v["fact"], "value": v["value"],
                      "limit": v["limit"], "unit": v["unit"], "window_h": v["window_h"], "exposure": v["exposure"],
                      "count": None, "runs_red": 0, "first_seen": None, "last_seen": None,
                      "evidence": v["evidence"][:3], "ledger": entry["id"] if entry else None, "near": v["near"],
                      "group": v.get("group"), "_level": v["level"], "_times": times, "_entry": entry, "_bad": sum(bad) if bad else None}
    problems = []
    for pid, problem in sorted(by_id.items()):
        times = problem.pop("_times")
        problem.pop("_level")
        record = seen.get(pid)
        if not record or now - record.get("last", 0) > SEEN_GAP_S:
            record = {"first": now, "hits": []}
        record["first"] = min([record["first"]] + [t for t in times if t > now - SEEN_GAP_S])
        record["last"] = now
        record["hits"] = [t for t in record.get("hits", []) if now - t <= 86400] + [now]
        seen[pid] = record
        problem.update(count=problem.pop("_bad"), runs_red=len(record["hits"]), first_seen=iso_time(record["first"]),
                       last_seen=iso_time(max(times) if times else now))
        if problem["state"] == "regressed":
            fix_at = last_fix_at(problem["_entry"])
            proof = proof_state.get(problem["ledger"])
            if not proof or proof.get("at") != fix_at:
                proof = proof_state[problem["ledger"]] = {"at": fix_at, "events": 0, "matched": 0}
            proof["matched"] += 1
        problem.pop("_entry")
        problems.append(problem)
    for pid in [k for k, v in seen.items() if now - v.get("last", 0) > SEEN_KEEP_S]:
        del seen[pid]
    shown = {p["ledger"] for p in problems if p["ledger"]}
    for entry in ledger.get("rows") or ():
        fix_at = last_fix_at(entry)
        if entry.get("status") not in ("fixed-pending", "fixed") or not fix_at or entry["id"] in shown:
            continue
        proof = proof_state.get(entry["id"])
        if not proof or proof.get("at") != fix_at:
            proof = proof_state[entry["id"]] = {"at": fix_at, "events": 0, "matched": 0}
        after = [v for v in touched.get(entry["id"], []) if now - v["window_h"] * 3600 >= fix_at]
        proof["events"] = max(proof["events"], sum(v["exposure"] for v in after))
        proven = proof["events"] >= PROOF_MIN_EXPOSURE and not proof["matched"]
        if proven and now - fix_at > PROOF_SHOW_S:
            continue
        last = max(after, key=lambda v: v["exposure"]) if after else (touched.get(entry["id"]) or [None])[0]
        problems.append({
            "id": entry["id"], "rule": (entry.get("match") or {}).get("rule"),
            "ident": (entry.get("match") or {}).get("ident"), "state": "fixed-pending",
            "fact": "%s · %d events since · %d matched%s · %s" % (
                "fixed" if proven else "unproven", proof["events"], proof["matched"],
                "" if proven else ", needs %d events and none matched" % PROOF_MIN_EXPOSURE, entry.get("title")),
            "value": last and last["value"], "limit": last and last["limit"], "unit": last and last["unit"],
            "window_h": last and last["window_h"], "exposure": proof["events"],
            "count": sum(v.get("bad") or 0 for v in after if v["level"]), "runs_red": proof["matched"],
            "first_seen": iso_time(fix_at), "last_seen": iso_time(now), "evidence": [],
            "ledger": entry["id"], "near": last and last["near"], "group": last and last.get("group")})
    return problems


HOLD_START_SLACK_S = 2


def pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except (PermissionError, OverflowError):
        return True
    return True


def held_of(hold):
    return hold.get("held") if isinstance(hold.get("held"), dict) else {}


def etime_s(text):
    """ps's [dd-]hh:mm:ss clock, for both etime and the fractional, maybe comma-decimal, cpu time."""
    days, _, clock = text.rpartition("-")
    total = 0.0
    for part in clock.split(":"):
        total = total * 60 + float(part.replace(",", "."))
    return int(days or 0) * 86400 + total


def process_starts(pids):
    asked = time.time()
    try:
        out = subprocess.run(["/bin/ps", "-o", "pid=,etime=", "-p", ",".join(map(str, sorted(pids)))],
                             capture_output=True, text=True, timeout=10).stdout
        return {int(pid): asked - etime_s(etime) for pid, etime in (row.split() for row in out.splitlines() if row.strip())}
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def hold_alive(hold, starts):
    if starts is None:
        return pid_alive(hold["pid"])
    return hold["pid"] in starts and starts[hold["pid"]] <= hold["since"] + HOLD_START_SLACK_S


def read_holds():
    live, leaked = {}, {}
    try:
        names = sorted(n for n in os.listdir(hold_dir()) if n.endswith(".json"))
    except OSError:
        return live, leaked
    holds = []
    for name in names:
        path = os.path.join(hold_dir(), name)
        hold = read_json(path, None)
        if hold is None and not os.path.exists(path):
            continue
        valid = (isinstance(hold, dict) and isinstance(hold.get("limiter"), str) and hold["limiter"]
                 and isinstance(hold.get("pid"), int) and not isinstance(hold.get("pid"), bool)
                 and isinstance(hold.get("since"), (int, float)) and not isinstance(hold.get("since"), bool))
        holds.append((name, hold if valid else None))
    starts = process_starts({h["pid"] for _, h in holds if h}) if any(h for _, h in holds) else {}
    for name, hold in holds:
        limiter = hold["limiter"] if hold else name.rsplit("-", 1)[0]
        target = live if hold and hold_alive(hold, starts) else leaked
        target.setdefault(limiter, []).append(dict(hold or {}, file=name))
    return live, leaked


def hold_verdicts(now):
    live, leaked = read_holds()
    out = []
    for limiter, holds in sorted(live.items()):
        holds.sort(key=lambda h: h["since"])
        longest = now - holds[0]["since"]
        out.append(verdict(
            "limiter_hold", limiter, longest, LIMITS["hold_red_s"], "s", 0, len(holds),
            "red" if longest > LIMITS["hold_red_s"] else "watch" if longest >= LIMITS["hold_note_s"] else None,
            fact="%s holds %d job%s, longest %s: %s" % (limiter, len(holds), "" if len(holds) == 1 else "s",
                                                       fmt_long(longest), holds[0].get("why") or "no reason given"),
            evidence=[evidence(h["since"], "holds/" + h["file"], "%s · %s" % (held_of(h).get("what"), h.get("why")),
                               str(held_of(h).get("session") or held_of(h).get("cwd") or "")) for h in holds],
            bad=len(holds)))
    for limiter, holds in sorted(leaked.items()):
        out.append(verdict(
            "limiter_hold_leak", limiter, len(holds), 0, "files", 0, len(holds), "watch",
            fact="%s left %d hold file%s whose process is gone or unreadable: %s" % (
                limiter, len(holds), "" if len(holds) == 1 else "s", ", ".join(h["file"] for h in holds[:3])),
            evidence=[evidence(h.get("since") or now, "holds/" + h["file"], "no live pid %s" % h.get("pid"))
                      for h in holds], bad=len(holds)))
    return out, [os.path.join(hold_dir(), h["file"]) for holds in leaked.values() for h in holds]


SLOT_WAIT_CLASSES = ("night-workers", "run-suites")


def wait_classes(now):
    days = [local_day(now - back * 86400) for back in range(8)]
    out = {}
    for day in sorted(set(days)):
        for item in read_jsonl(os.path.join(wait_dir(), day + ".jsonl")) or ():
            cls, secs, at = item.get("class"), item.get("seconds"), item.get("started")
            if (isinstance(cls, str) and cls and isinstance(secs, (int, float)) and isinstance(at, (int, float))
                    and secs >= 0):
                out.setdefault(cls, {}).setdefault(day, []).append((at, float(secs), str(item.get("source") or "")))
    return out, days[0]


def waits_classes_section(now):
    classes, today = wait_classes(now)
    reasons = {}
    for item in read_jsonl(os.path.join(wait_dir(), today + ".jsonl")) or ():
        secs = item.get("seconds")
        if item.get("class") in SLOT_WAIT_CLASSES and isinstance(secs, (int, float)) and secs >= 0:
            reasons.setdefault((item["class"], item.get("reason")), []).append(float(secs))
    rows = []
    for cls, by_day in sorted(classes.items(), key=lambda kv: (-sum(s for _, s, _ in kv[1].get(today, ())), kv[0])):
        waits = by_day.get(today, [])
        secs = [s for _, s, _ in waits]
        total = sum(secs)
        prior = [sum(s for _, s, _ in v) for day, v in by_day.items() if day != today]
        usual = median(prior) if len(prior) >= LIMITS["wait_growth_days"] else None
        limit = WAIT_RED_S.get(cls, LIMITS["wait_red_s"])
        longest = sorted(waits, key=lambda w: -w[1])[:3]
        proof = [evidence(at, "waits/%s.jsonl %.3f" % (today, at), "%s waited %s" % (source, fmt_long(sec)))
                 for at, sec, source in longest]
        top = max(secs) if secs else 0
        judge = [verdict("wait_class", cls, top, limit, "s", 24, len(secs), "red" if top > limit else None,
                         fact="%s: a wait of %s today, limit %s: %s" % (
                             cls, fmt_long(top), fmt_long(limit), longest[0][2] if longest else ""),
                         values=secs, evidence=proof)]
        grown = usual is not None and total >= limit and total > LIMITS["wait_growth"] * usual
        judge.append(verdict("wait_growth", cls, total, None if usual is None else round(LIMITS["wait_growth"] * usual, 3),
                             "s", 24, len(secs), "red" if grown else None,
                             fact="%s: %s waited today, %s on a usual day of the week" % (
                                 cls, fmt_long(total), fmt_long(usual or 0)), evidence=proof, bad=int(grown)))
        red = [i for i, bad in ((5, top > limit), (2, grown)) if bad]
        week = section("", [row([day, len(v), fmt_s(sum(s for _, s, _ in v)), fmt_s(max(s for _, s, _ in v))], dim=True)
                            for day, v in sorted(by_day.items(), reverse=True)],
                       ["day", "waits", "total", "max"], [False, True, True, True])
        if cls in SLOT_WAIT_CLASSES:
            week["rows"][:0] = [row(["today: " + why, len(v), fmt_s(sum(v) if v else None), fmt_s(max(v) if v else None)], dim=True)
                                for why, v in ((why, reasons.get((cls, why), [])) for why in ("limit", "room"))]
        rows.append(row([cls, len(secs), fmt_s(total), fmt_s(percentile(secs, 0.5)), fmt_s(percentile(secs, 0.95)),
                         fmt_s(top if secs else None), fmt_s(usual)], red=red, dim=not red, menu=week, key="waits:" + cls,
                        say=next((j["fact"] for j in judge if j["level"]), None), judge=judge))
    return section(WAITS_GROUP, rows, ["class", "waits today", "total today", "p50", "p95", "max", "usual day, 7 d"],
                   [False, True, True, True, True, True, True], ok="every wait class within its limit",
                   blind="" if rows else "no wait journaled in 8 days")


def blind_rows(ledger, dynamic):
    return dynamic + [dict(b) for b in ledger.get("blind_spots") or () if isinstance(b, dict)]


def error_document(now, started, error, ledger_raw=b""):
    try:
        judge = judge_digest(ledger_raw)
    except OSError:
        judge = None
    return {"contract": CONTRACT, "doctor": "harness", "as_of": iso_time(now), "as_of_s": int(now), "judge": judge,
            "status": "error", "problem_count": None, "problems": [], "blind_spots": [],
            "self": {"collector_s": round(time.monotonic() - started, 2), "error": error},
            "red": 1, "local_slow": [], "title": "Harness doctor: error · " + clip(error, 80), "sections": [],
            "periods": {}, "extras": [line(error, dim=False, red=True)], "footer": "as of %s" % time.strftime("%H:%M", time.localtime(now))}


def error_line(exc):
    frames = [f for f in traceback.extract_tb(exc.__traceback__) if os.path.realpath(f.filename) ==
              os.path.realpath(__file__)]
    where = " at line %d (%s)" % (frames[-1].lineno, frames[-1].name) if frames else ""
    return ("%s: %s%s" % (type(exc).__name__, exc, where)).replace("\n", " ")[:300]


# ---------------------------------------------------------------- main


def publish(folder, document):
    write_json(os.path.join(folder, "latest.json"), document)
    collector_runs.problem_day("harness", document, "HARNESS_DOCTOR_DIR")
    tmp = os.path.join(folder, "menu.txt.tmp")
    with open(tmp, "w") as handle:
        handle.write(menu_text(document))
    os.replace(tmp, os.path.join(folder, "menu.txt"))


def cpu_s():
    times = os.times()
    return times.user + times.system + times.children_user + times.children_system


class Phases:
    def __init__(self):
        self.mark, self.secs = time.monotonic(), {}

    def __call__(self, name):
        now = time.monotonic()
        self.secs[name] = round(self.secs.get(name, 0.0) + now - self.mark, 3)
        self.mark = now


def collect(write, now):
    started, cpu_start, phase = time.monotonic(), cpu_s(), Phases()
    folder = state_dir()
    if write:
        os.makedirs(folder, exist_ok=True)
    state = read_json(os.path.join(folder, "state.json"), {})
    ledger, ledger_raw = load_ledger()
    faults = ledger_faults(ledger)
    faulty = {w for w, _ in faults}
    judging = dict(ledger, rows=[r for r in ledger["rows"] if isinstance(r, dict) and isinstance(r.get("id"), str)
                                     and r["id"] and r["id"] not in faulty]) \
        if isinstance(ledger, dict) and isinstance(ledger.get("rows"), list) else {"rows": []}
    new_events, versions = [], {}
    backfill = not state.get("files")
    if not state.get("files"):
        state["rebuilt"] = SUMMARY_V
    phase("setup")
    scan_transcripts(state, now, new_events, versions)
    phase("transcripts")
    hooks = settings_hooks()
    changes = watch_changes(state, now, versions, hooks)
    phase("changes")
    burst = []
    sample = take_sample(state, now, phase, burst)
    samples = load_samples(now) + ([sample] if sample else [])
    phase("sample")
    timed24, timed1, fresh_spool = read_journals(state, now, write)
    phase("journals")
    journal = state.setdefault("journal", {})
    ticks = fold_machine(state, journal, now)
    speed_census(state, burst, now, launchd_labels() if burst else [])
    queues = fold_suites(state, journal, now)
    new_events += fold_mcp(state, now)
    phase("speed")

    if write:
        if changes:
            with open(os.path.join(folder, "changes.jsonl"), "a") as handle:
                handle.write("".join(json.dumps(c, separators=(",", ":")) + "\n" for c in changes))
    growth = load_growth()
    if not growth or growth[-1].get("day") != local_day(now):
        tops = {rec.get("top") for rec in state.get("files", {}).values()
                if rec.get("top") and now - rec.get("mtime", 0) / 1e9 <= 7 * 86400}
        growth.append(growth_sample(now, {t for t in tops if t and t != "/"}))
        if write:
            with open(os.path.join(folder, "growth.jsonl"), "a") as handle:
                handle.write(json.dumps(growth[-1], separators=(",", ":")) + "\n")
    phase("growth")
    reach = RAW_REACH_S
    settled, upto = now - FLOOR_SETTLE_S, journal.get("floor_upto", now - reach)
    since = max(min(upto, now - reach), now - JOURNAL_FILE_DAYS * 86400)
    days = days_between(since, now)
    events = load_events(days) + new_events
    today = local_day(now)
    today_rows = [e for e in events if local_day(e[1]) == today]
    logged = sorted(glob.glob(os.path.join(folder, "events", "*.jsonl")))
    raw = {"events": [e for e in events if now - e[1] <= reach], "samples": samples,
           "events_since": day_start(os.path.basename(logged[0])[:-6]) if logged
           else min((e[1] for e in new_events), default=None)}
    phase("events")
    raw["hooks"], raw["hooks_since"] = journal_runs(since, () if write else fresh_spool, write)
    phase("hook_runs")
    raw["hook_slots"] = state["journal"]["slots"]
    calls_since = [e for e in events if e[0] == "c" and e[1] > since]
    view = hook_view(hooks, raw["hooks"], calls_since, now, session_repos(journal, calls_since, now), now - 86400)
    starts = fold_starts(state, journal, view["floors"], now)
    new_events += starts
    events += starts
    turn_layers(new_events, view["by_call"], queues)
    if write:
        append_events(new_events)
    phase("hook_view")
    for floor in view["floors"]:
        if upto < floor["t"] <= settled:
            day = journal.setdefault("floor_days", {}).setdefault(local_day(floor["t"]), {})
            hist_put(day.setdefault(floor["cls"], hist_new()), floor["ms"])
            speed_floor(state, floor, ticks)
    journal["floor_upto"] = max(upto, settled)
    floors_reach = [f for f in view["floors"] if now - f["t"] <= reach]
    raw["floors"] = [(f["t"], f["cls"], f["ms"]) for f in floors_reach]
    view["floors"] = [f for f in floors_reach if now - f["t"] <= 86400]
    events = [e for e in events if now - e[1] <= 86400]
    calls = [e for e in events if e[0] == "c"]
    cuts = [e for e in events if e[0] == "x"]
    samples_h = [e for e in events if e[0] == "h"]
    changes_log = load_changes(now) + ([] if write else changes)

    slow_periods = local_slow(state, now, new_events, write)
    summaries = day_summaries(state, now, write, samples, slow_periods, today_rows)
    if write:
        prune(now)
    tests = load_tests(now)
    phase("summaries")
    dismissed, blind = unjournaled_dismissals(hooks, judging)
    raw["windows"] = slow_periods
    periods, week = periods_section(summaries, raw, tests, now, hooks)
    sections = [waits_section(calls, cuts, samples_h, week, now),
                slow_section(slow_periods, now),
                floors_section(view, hook_names(hooks), now),
                hooks_section(hooks, calls, cuts, samples_h, settings_mtime(), timed24, timed1, now, view["split"],
                              probe_fast_paths(hooks), unjournaled=dismissed),
                load_section(samples, now),
                tests_section(tests, now, guard_kills(now - LIMITS["test_slow_fresh_s"] - 86400), load_suite_runs(now)),
                stop_hooks_section(now),
                guards_section(now),
                deploys_section(now),
                waits_classes_section(now)]
    growth_part = growth_section(growth, now, spool_backlog(now))
    if growth_part:
        sections.append(growth_part)
    sections = regroup(sections)
    impact = change_impact(calls, samples, now, floors_reach, tests)
    attach_causes(state, sections, changes_log, impact, now)
    phase("sections")
    red = sum(1 for s in sections if s["state"] == "problem")
    recent = sorted([c for c in changes_log if c["at"] >= now - 7 * 86400], key=lambda c: -c["at"])
    if STATUSLINE_KEY not in timed24:
        blind.append({"id": "statusline-journal", "what": "statusline cost per render",
                      "reason": "no render journal line in 24 h", "since": None,
                      "would_catch_if": "bin/statusline.sh writes its render time to the statusline journal"})
    if not os.path.exists(words_journal()):
        blind.append({"id": "words-journal", "what": "word notices with no reading line (word-miss, reading-miss)",
                      "reason": "no words journal at %s" % words_journal(), "since": None,
                      "would_catch_if": "the words hook journals each notice and reading to the words journal"})
    if not any(k.startswith(MENU_KEY) for k in timed24):
        blind.append({"id": "menu-journal", "what": "menu build time", "reason": "no menu journal line in 24 h",
                      "since": None, "would_catch_if": "the Hammerspoon menu builds write their journal lines"})
    blind = blind_rows(judging, blind)
    elapsed = time.monotonic() - started
    self_verdict = collector_verdict(elapsed, backfill, (sample or {}).get("held") or held_slots())
    by_row = {}
    for where, fault in faults:
        by_row.setdefault(where, []).append(fault)
    fault_verdicts = [dict(verdict("ledger_fault", where, len(why), 0, "faults", 0, 1, "red",
                                   fact="ledger %s dropped: %s" % (where, "; ".join(why)),
                                   evidence=[evidence(now, "ledger:" + where, "; ".join(why))], bad=1),
                           pid="ledger:" + where, group="Ledger") for where, why in sorted(by_row.items())]
    holds, leaked_holds = hold_verdicts(now)
    for v in holds:
        v["group"] = HOLDS_GROUP
    problems = problems_from(sections, judging, state, now, [self_verdict] + fault_verdicts + holds)
    changed = write and settle_fixes(judging)
    for problem in problems:
        entry = problem["state"] == "regressed" and ledger_row_by_id(judging, problem["ledger"])
        if write and entry and entry.get("fixes") and not entry["fixes"][-1].get("regressed_at"):
            entry["fixes"][-1]["regressed_at"] = iso_time(now)
            changed = True
    if changed:
        write_fix_fields(judging)
    extras = [line("changes, 7 d", menu=change_table(recent[:CHANGE_ROWS], impact) if recent else None),
              line("not measured" if blind else "not measured: nothing",
                   menu=section("", [row([b["what"]], dim=True) for b in blind], ["blind spot"], [False])),
              line("collector: %.1f s a run, limit %d s" % (elapsed, LIMITS["collector_s"]),
                   dim=self_verdict["level"] is None, red=self_verdict["level"] == "red")]
    shown_holds = [v for v in holds if v["level"]]
    if shown_holds:
        sections.append(section(HOLDS_GROUP, [row([v["fact"]], red=[0] if v["level"] == "red" else (),
                                                  say=v["fact"]) for v in shown_holds], [""], [False]))
    phase("judge")
    document = {
        "contract": CONTRACT, "doctor": "harness", "as_of": iso_time(now), "as_of_s": int(now),
        "judge": judge_digest(ledger_raw),
        "problems": problems, "blind_spots": blind, "self": {"collector_s": round(elapsed, 2), "error": None},
        "timing": {"cpu_s": round(cpu_s() - cpu_start, 2), "sleep_s": phase.secs.get("sleep", 0),
                   "phases": phase.secs},
        "collector_s": round(elapsed, 2), "red": red, "local_slow": slow_periods,
        "sections": sections, "periods": periods, "extras": extras,
        "footer": "as of %s" % time.strftime("%H:%M", time.localtime(now)),
    }
    apply_speed(document, read_json(os.path.join(folder, "latest.json"), {}).get("speed"))
    speed_flush(state, now, write)
    if write:
        write_json(os.path.join(folder, "state.json"), state)
        if sample:
            kept = [s for s in samples if now - s.get("t", 0) <= EVENT_DAYS * 86400]
            with open(os.path.join(folder, "samples.jsonl.tmp"), "w") as handle:
                handle.write("".join(json.dumps(s, separators=(",", ":")) + "\n" for s in kept))
            os.replace(os.path.join(folder, "samples.jsonl.tmp"), os.path.join(folder, "samples.jsonl"))
        publish(folder, document)
        for path in leaked_holds:
            try:
                os.unlink(path)
            except OSError:
                pass
    return document


def main():
    parser = argparse.ArgumentParser(description="Harness doctor collector")
    parser.add_argument("--json", action="store_true", help="print the document and persist nothing")
    parser.add_argument("--menu", action="store_true", help="print the menu lines and persist nothing")
    parser.add_argument("--quiet", action="store_true")
    args = parser.parse_args()
    now, started = now_s(), time.time()
    if args.json or args.menu:
        document = guarded_collect(False, now)
        print(menu_text(document) if args.menu else json.dumps(document, indent=1, ensure_ascii=False), end="")
        return 1 if document["status"] == "error" else 0
    os.makedirs(os.path.join(state_dir(), "hooks", "spool"), exist_ok=True)
    os.makedirs(os.path.join(state_dir(), "menu"), exist_ok=True)
    with open(os.path.join(state_dir(), "lock"), "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            if not args.quiet:
                print("harness-doctor: another run holds the lock", file=sys.stderr)
            return 0
        document = guarded_collect(True, now)
    collector_runs.record("harness", started)
    if not args.quiet or document["status"] == "error":
        print(document["title"] + " · " + document["footer"], file=sys.stderr if document["status"] == "error"
              else sys.stdout)
    if document["status"] != "error":
        exec_speed()
    return 1 if document["status"] == "error" else 0


def exec_speed():
    """Speed reads what this run derived, so it follows each successful run at this run's own priority: never
    taskpolicy -b, whose throttled I/O held an attended run's Speed 50 min at load 129 (2026-10-04).
    A fixture Harness directory with no SPEED_DOCTOR_DIR of its own never reaches the live Speed store."""
    if os.environ.get("HARNESS_DOCTOR_DIR") and not os.environ.get("SPEED_DOCTOR_DIR"):
        return
    script = os.environ.get("SPEED_DOCTOR_CMD") or os.path.join(ROOT_DIR, "bin", "speed-doctor")
    sys.stdout.flush()
    sys.stderr.flush()
    os.environ["DOCTOR_TRIGGER"] = "harness"
    os.environ[collector_runs.CPU_BASE_ENV] = repr(collector_runs.cpu_total())
    try:
        os.execv(script, [script, "--quiet"])
    except OSError:
        pass


def guarded_collect(write, now):
    started = time.monotonic()
    try:
        return collect(write, now)
    except Exception as exc:
        document = error_document(now, started, error_line(exc), load_ledger()[1])
        document["local_slow"] = read_json(os.path.join(state_dir(), "latest.json"), {}).get("local_slow") or []
        if write:
            publish(state_dir(), document)
        return document


if __name__ == "__main__":
    sys.exit(main())

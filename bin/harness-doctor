def words_journal():
    return os.path.join(env_dir("WORDS_DIR", ".cache", "claude", "words"), "journal.jsonl")


def word_token(text):
    return "".join(re.findall(r"[\w+-]+", str(text).lower()))


def word_families():
    """claude-setup's words_journal, the one reader that maps a notice segment to its family; None when
    it does not load. Loaded afresh, since its families are read at import from WORDS_FAMILIES."""
    lib = os.path.dirname(os.environ.get("WORDS_LIB") or os.path.join(base_home(), ".claude", "hooks", "lib",
                                                                       "words.sh"))
    saved = sys.path[:]
    try:
        sys.path.insert(0, lib)
        for name in ("words", "words_journal"):
            sys.modules.pop(name, None)
        import words_journal
        return words_journal
    except Exception:
        return None
    finally:
        sys.path[:] = saved


def word_ident(notice, journal):
    found = set()
    for part in str(notice or "").split("⚡"):
        head = re.sub(r"^\s*[^\s:·]+:(?=\s|$)", "", part).split("·")[0]
        words = [word_token(w) for w in head.split() if word_token(w)]
        if words:
            found.add((journal and journal.family_of(head)) or words[0])
    return "+".join(sorted(found)) or "?"



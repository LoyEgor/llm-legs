SYNC_EVENTS = ("PreToolUse", "PostToolUse", "UserPromptSubmit", "Stop", "SubagentStop", "SessionStart",
               "PreCompact", "SessionEnd")
DEFAULT_HOOK_TIMEOUT_S = 600
TRIVIAL_WORDS = {"ls", "cat", "pwd", "true", "echo", "head", "tail", "wc", "date", "stat", "file", "test",
                 "which", "basename", "dirname", "printf", "grep", "sed", "awk", "jq", "cut", "sort", "uniq",
                 "tr", "readlink", "realpath"}
TRIVIAL_BREAK = re.compile(r"[;&<>`\n]|\$\(|\|\|")
TRIVIAL_RECURSIVE = re.compile(r"(^|\s)-(-recursive|[a-zA-Z]*[rR][a-zA-Z]*)(\s|$)")
QUIET_REDIRECT = re.compile(r"\s[12]?>\s?/dev/null|\s2>&1")
EDIT_TOOLS = {"Edit", "Write", "MultiEdit", "NotebookEdit"}
EVENT_ROWS = (("SessionStart", "session start", "every chat start"),
              ("UserPromptSubmit", "prompt submit", "every message"),
              ("Stop", "turn end", "every turn"),
              ("SubagentStop", "subagent end", "every subagent"))
BACKFILL_DAYS = 28

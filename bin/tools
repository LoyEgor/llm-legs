#!/usr/bin/env python3
"""tools: the harness's tool for a job, before writing a helper or script; extend one that falls short.

  tools <words...>   the 1-5 best matches, `name — job — how to call`
  tools              a line per family

The index (share/tool_index.py) is derived from the README entries, the ~/.local/bin links, share/ modules' first doc
lines and the skills' descriptions; nothing is listed by hand.
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "share"))
import tool_index  # noqa: E402


def main(argv):
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    entries = tool_index.index()
    if not argv:
        print("\n".join(tool_index.overview(entries)))
        return 0
    found = tool_index.search(entries, " ".join(argv))
    if not found:
        print("no tool matches; `tools` lists the families")
        return 1
    print("\n".join(tool_index.line(entries[k]) for k in found))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

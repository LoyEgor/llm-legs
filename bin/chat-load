#!/usr/bin/env python3
# memlogd runs `sample` every tick: it attributes every process to the chat that launched it, keeps
# the machine's load per chat for the llm-limits menu (chats.json) and, when RAM runs out, kills the
# fattest chat job (`docs/memory-guard.md`). `show` prints the last snapshot; `stop` ends what one of
# its closed-chat, leftover, simulator or orphan rows counts, or asks an app a chat opened to quit, on Egor's
# click in the menu; `ledger` is the launch ledger statusline-workdir-hook.sh feeds around a Bash call that
# starts what no process tree holds.
import calendar
import ctypes
import glob
import importlib
import json
import os
import re
import signal
import struct
import subprocess
import sys
import time

GUARD_AVAIL_MB = 2048
GUARD_JOB_MB = 1536
GUARD_SHOWN_S = 900
BUSY_CORES = 0.3
SATURATED = 0.9
HISTORY_MINUTES = 15
TITLE_WIDTH = 22
PID_SLACK_S = 30
HOLD_START_SLACK_S = 2
QUEUE_STUCK_S = 1800
KILLED_GRACE_S = 30
SHOWN_KB = 51200
ORPHAN_AGE_S = 3600
STOP_GRACE_S = 5
# A daemon a stopped command starts on its way out is adopted by launchd a moment after the command dies.
STOP_SETTLE_S = 1
ENV_TRIES = 3
CHAT_KEEP_S = 2 * 86400
CALL_OPEN_S = 1800
BACKGROUND_OPEN_S = 900
LEDGER_KEEP_S = 14 * 86400
LABEL_TTL_S = 60
# Apple's own processes and the extensions and XPC services macOS starts are never a leftover; an app is
# a launchd job. Homebrew's python runs from a Python.app, so ".app/" itself would hide every python.
SYSTEM_PARTS = (".xpc/", ".appex/")
SPARK = "▁▂▃▄▅▆▇█"
ENV_KEYS = (b"CLAUDE_LAUNCHER_SESSION=", b"CLAUDE_CODE_SESSION_ID=")
# A booted simulator is one launchd_sim launchd spawns for CoreSimulatorService (ppid 1, no chat's environment);
# its own environment names the device.
SIM_COMM = "launchd_sim"
SIM_KEYS = (b"SIMULATOR_UDID=", b"SIMULATOR_DEVICE_NAME=")
SIMCTL = ["xcrun", "simctl"]
# What the ledger hook snapshots, by the words of the command: the hook's own gate matches the same words.
# `open` counts only as a command word (first, or after ; & | ( or a newline, behind env/nohup/command) of the
# command with its quoted strings blanked: never opencode, openssl, xdg-open or an `open` inside a string.
LEDGER_WORDS = (("sim", re.compile(r"simctl|xcodebuild")), ("launchd", re.compile(r"launchctl|brew\s+services")))
OPEN_WORD = re.compile(r"(?:^|[;&|(\n])\s*(?:(?:env(?:\s+[A-Za-z_][A-Za-z0-9_]*=\S*)*|nohup|command)\s+)*open(?=\s|$)")
QUOTED = re.compile(r"'[^']*'|\"(?:[^\"\\]|\\.)*\"")
# Jobs macOS and LaunchServices start by themselves are no `launchd` record; an app LaunchServices starts on
# a chat's `open` is an `app` record (application.<bundle id>.<n>.<n>), its own kind.
FOREIGN_LABELS = ("com.apple.", "application.")
APP_PREFIX = "application."
APP_LABEL = re.compile(r"application\.([A-Za-z0-9._-]+?)\.\d+\.\d+")
APP_QUIT_S = 10
WORKTREES = "/.claude/worktrees/"
TOKEN = re.compile(r"[A-Za-z0-9._-]+")
OTHER_KINDS = (("screen", {"WindowServer"}), ("kernel", {"kernel_task"}), ("signing", {"syspolicyd", "trustd"}))

HOME = os.path.expanduser("~")
LOG_DIR = os.environ.get("MEMLOGD_DIR") or os.path.join(HOME, "Library/Logs/memlogd")
STATE_PATH = os.path.join(LOG_DIR, "chat-load.state.json")
OUT_PATH = os.path.join(LOG_DIR, "chats.json")
BENCHES_PATH = os.path.join(LOG_DIR, "chat-load.benches.json")
LAUNCHERS_PATH = os.path.join(LOG_DIR, "chat-load.launchers.json")
LAUNCHERS_TTL_S = 300
LEDGER_DIR = os.path.join(LOG_DIR, "ledger")
CALLS_DIR = os.path.join(LEDGER_DIR, "calls")
HOLDS_DIR = os.environ.get("HARNESS_HOLDS_DIR") or os.path.join(
    os.environ.get("HARNESS_DOCTOR_DIR") or os.path.join(HOME, ".cache/harness-doctor"), "holds")
SESSION_DIRS = (os.environ.get("CHAT_LOAD_SESSIONS")
                or f"{HOME}/.claude-profiles/*/sessions:{HOME}/.claude/sessions").split(":")
RUNS_DIR = os.environ.get("WORKER_RUN_DIR") or os.path.join(HOME, ".cache/claude-worker-runs")
STATS_DIR = os.environ.get("WORKER_STATS_DIR") or os.path.join(
    os.environ.get("CLAUDEB_DIR") or os.path.join(HOME, ".claude-profiles/.claudeb"), "worker-stats")
HERE = os.path.dirname(os.path.realpath(__file__))
# The copies install-agent deploys beside this file come first: macOS denies the daemon's Python, and
# every process it starts, /Volumes/Work even with memlogd itself granted Full Disk Access.
SHARED = [HERE, os.path.join(os.path.dirname(HERE), "share")]
REPORT_BUS = os.environ.get("CHAT_LOAD_REPORT_BUS") or os.path.join(HERE, "report-bus")
REPORT_FRAME = next((path for path in (os.path.join(d, "report_frame.py") for d in SHARED) if os.path.exists(path)), "")
# Only the memlogd LaunchAgent signals: launchd sets XPC_SERVICE_NAME to the job's label, which no shell,
# chat or test carries unless it names it on purpose. Any other run prints WOULD KILL and signals nothing
# (2026-10-14: a hand-run sample with the real low avail SIGKILLed another chat's two Blender renders).
DAEMON_LABEL = "com.egor.memlogd"
# Tests weigh pids from a JSON {pid: KB} in place of proc_pid_rusage; a pid it does not name keeps its RSS.
FOOTPRINT_PATH = os.environ.get("CHAT_LOAD_FOOTPRINT")

libc = ctypes.CDLL(None, use_errno=True)
libc.proc_pid_rusage.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_void_p]


class RusageV2(ctypes.Structure):
    _fields_ = [("uuid", ctypes.c_uint8 * 16), ("values", ctypes.c_uint64 * 18)]


def sysctl_int(name):
    value, size = ctypes.c_uint64(0), ctypes.c_size_t(8)
    if libc.sysctlbyname(name.encode(), ctypes.byref(value), ctypes.byref(size), None, 0) != 0:
        return None
    return value.value


def procargs(pid, keys=ENV_KEYS):
    mib = (ctypes.c_int * 3)(1, 49, pid)
    size = ctypes.c_size_t(0)
    if libc.sysctl(mib, 3, None, ctypes.byref(size), None, 0) != 0 or size.value < 8:
        return None
    buf = ctypes.create_string_buffer(size.value)
    if libc.sysctl(mib, 3, buf, ctypes.byref(size), None, 0) != 0:
        return None
    raw = buf.raw[:size.value]
    argc = struct.unpack("i", raw[:4])[0]
    pos = raw.find(b"\0", 4)
    if pos < 0:
        return None
    while pos < len(raw) and raw[pos] == 0:
        pos += 1
    strings = raw[pos:].split(b"\0")
    argv, env = strings[:argc], []
    for entry in strings[argc:]:
        if not entry:
            break
        env.append(entry)
    found = [""] * len(keys)
    for entry in env:
        for index, key in enumerate(keys):
            if entry.startswith(key):
                found[index] = entry[len(key):].decode("utf-8", "replace")
    return [a.decode("utf-8", "replace") for a in argv], found


def clock(text):
    try:
        days = 0
        if "-" in text:
            head, text = text.split("-", 1)
            days = int(head)
        total = 0.0
        for part in text.split(":"):
            total = total * 60 + float(part)
        return days * 86400 + total
    except ValueError:
        return -1.0


def process_table():
    # A start is the kernel's own (`lstart`, C locale, UTC), never `now - etime`: ps takes seconds under swap,
    # and a start reckoned from when it returned moved past every 2 s match keyed on it (held ownership, the
    # caches, a Stop key) exactly when the guard mattered.
    out = subprocess.run(["ps", "-axo", "pid=,ppid=,pgid=,uid=,rss=,time=,etime=,state=,lstart=,comm="],
                         capture_output=True, text=True, timeout=20,
                         env={**os.environ, "TZ": "UTC", "LC_ALL": "C"}).stdout
    taken = time.time()
    table = {}
    for line in out.splitlines():
        fields = line.split(None, 13)
        if len(fields) < 14:
            continue
        try:
            pid, ppid, pgid, uid, rss = (int(x) for x in fields[:5])
        except ValueError:
            continue
        age = clock(fields[6])
        start = proc_started(" ".join(fields[8:13]))
        table[pid] = {"ppid": ppid, "pgid": pgid, "uid": uid, "kb": rss, "cpu": clock(fields[5]),
                      "age": age, "start": taken - age if start is None else start, "zombie": fields[7].startswith("Z"),
                      "comm": os.path.basename(fields[13].strip()), "path": fields[13].strip()}
    return table


def footprints(table, pids):
    """Weighs each pid by its phys footprint (rusage_info_v2), what `top` and Activity Monitor show as its
    memory: RSS misses wired GPU memory, and a Cycles render on Metal holds ~9 GB at 0.2 GB RSS. One
    syscall per pid; one that cannot be read (another user's, gone) keeps its RSS."""
    fixture = read_json(FOOTPRINT_PATH, {}) if FOOTPRINT_PATH else None
    usage = RusageV2()
    for pid in pids:
        if fixture is not None:
            kb = fixture.get(str(pid))
        else:
            kb = usage.values[7] // 1024 if libc.proc_pid_rusage(pid, 2, ctypes.byref(usage)) == 0 else None
        if type(kb) is int:
            table[pid]["kb"] = kb


def read_json(path, default):
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return default


def write_json(path, value):
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as handle:
        json.dump(value, handle, ensure_ascii=False)
    os.replace(tmp, path)


MONTHS = {name: number for number, name in enumerate(("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep",
                                                        "Oct", "Nov", "Dec"), 1)}
STARTED = {}


def proc_started(text):
    """A C-locale UTC `ps -o lstart=` (process_table's, and Claude Code's `procStart`, bin/claude-chat-switch
    live_registry) as an epoch; None when there is none or it does not read. Parsed once per distinct string."""
    if not isinstance(text, str):
        return None
    if text in STARTED:
        return STARTED[text]
    try:
        _, month, day, clock_text, year = text.split()
        hour, minute, second = clock_text.split(":")
        value = calendar.timegm((int(year), MONTHS[month], int(day), int(hour), int(minute), int(second), 0, 0, 0))
    except (ValueError, KeyError, OverflowError):
        value = None
    STARTED[text] = value
    return value


def live_sessions(table):
    sessions = {}
    for pattern in SESSION_DIRS:
        for path in glob.glob(os.path.join(os.path.expanduser(pattern), "*.json")):
            record = read_json(path, {})
            pid, sid = record.get("pid"), record.get("sessionId")
            if isinstance(pid, int) and isinstance(sid, str) and pid in table:
                # A CLI killed without deregistering leaves its record behind, and macOS hands its pid on: a
                # record of another process than the one under that pid is a stranger's, and claims nothing for
                # the dead chat nor spares that process. The record's own procStart says which process wrote it;
                # a record without one is judged by its mtime, which a copy or a touch moves.
                row = table[pid]
                began = proc_started(record.get("procStart"))
                if began is not None:
                    own = row["age"] >= 0 and abs(began - row["start"]) <= 2
                else:
                    try:
                        written = os.path.getmtime(path)
                    except OSError:
                        continue
                    own = row["age"] >= 0 and written >= time.time() - row["age"] - PID_SLACK_S
                sessions[sid] = {"pid": pid, "status": str(record.get("status") or ""), "own": own,
                                 "cwd": str(record.get("cwd") or "")}
    return sessions


def listed(directory):
    try:
        return [name for name in os.listdir(directory) if not name.startswith(".")]
    except OSError:
        return []


def bench_pid_files():
    """benches/*/pid-* in glob's order. A bench folder is listed again only once its mtime moved: listing all
    ~540 of them (~35k files) every tick was half of memlogd's CPU (2026-10-20)."""
    root, cache, fresh, paths = os.path.join(STATS_DIR, "benches"), read_json(BENCHES_PATH, {}), {}, []
    cache = cache if isinstance(cache, dict) else {}
    for name in listed(root):
        directory = os.path.join(root, name)
        try:
            mtime = os.stat(directory).st_mtime_ns
            hit = cache.get(name)
            pids = hit[1] if isinstance(hit, list) and hit[0] == mtime else \
                [entry for entry in os.listdir(directory) if entry.startswith("pid-")]
        except OSError:
            continue
        fresh[name] = [mtime, pids]
        paths += [os.path.join(directory, entry) for entry in pids]
    if fresh != cache:
        write_json(BENCHES_PATH, fresh)
    return sorted(paths)


def registered_roots(table):
    roots = {}
    # an ended run (exit_code on disk) is skipped before its meta.json is looked at: ~2,400 run folders a tick
    for name in sorted(listed(RUNS_DIR), key=lambda name: name + "/meta.json"):
        directory = os.path.join(RUNS_DIR, name)
        if os.path.exists(os.path.join(directory, "exit_code")):
            continue
        record = read_json(os.path.join(directory, "meta.json"), {})
        for key in ("cli_pid", "pid"):
            pid = record.get(key)
            if isinstance(pid, int) and pid > 1 and pid in table:
                roots.setdefault(pid, (name, directory))
    for path in bench_pid_files():
        try:
            with open(path) as handle:
                pid = int(handle.readline().strip())
        except (OSError, ValueError):
            continue
        if pid > 1 and pid in table:
            directory = os.path.dirname(path)
            roots.setdefault(pid, (f"{os.path.basename(directory)}/{os.path.basename(path)[4:]}", directory))
    return roots


def lineage(pid, table):
    chain = []
    for _ in range(64):
        row = table.get(pid)
        if not row or row["ppid"] <= 1 or row["ppid"] == pid:
            break
        pid = row["ppid"]
        chain.append(pid)
    return chain


# macOS hides a platform binary's environment (/bin/*, /usr/bin/*) from KERN_PROCARGS2: a shell or
# `sleep` claims no chat of its own and is attributed through its ancestry in attribute().
def environments(table, cache):
    uid, fresh = os.getuid(), {}
    for pid, row in table.items():
        if row["uid"] != uid or row["age"] < 0:
            continue
        start = row["start"]
        hit = cache.get(str(pid))
        # exec keeps the pid and the start but not the command: a shell sampled before it exec'd its
        # python showed no environment, and that empty read must not outlive the exec. An empty read is
        # final only after ENV_TRIES ticks ([start, "", "", comm, tries]) and a failed one is not kept: a
        # process caught mid-start would otherwise be no chat's for its whole life.
        same = bool(hit) and abs(hit[0] - start) <= 2 and hit[3:4] == [row["comm"]]
        if same and (hit[1] or hit[2] or hit[4:] == [ENV_TRIES]):
            fresh[str(pid)] = hit
            continue
        parsed = procargs(pid)
        if not parsed:
            continue
        found = parsed[1]
        fresh[str(pid)] = [start, found[0], found[1], row["comm"]]
        if not (found[0] or found[1]):
            fresh[str(pid)].append(min(ENV_TRIES, (hit[4] if same and hit[4:] else 0) + 1))
    return fresh


def attribute(table, envs, sessions):
    cli = {entry["pid"]: sid for sid, entry in sessions.items()}

    def claimed(pid):
        env = envs.get(str(pid))
        return (env and (env[1] or env[2])) or ""

    def launcher(pid):
        for ancestor in lineage(pid, table):
            sid = claimed(ancestor) or cli.get(ancestor, "")
            if sid:
                return sid
        return ""

    def outermost(sid):
        seen = set()
        while sid in sessions and sid not in seen:
            seen.add(sid)
            pid = sessions[sid]["pid"]
            parent = claimed(pid) or launcher(pid)
            if not parent or parent == sid:
                break
            sid = parent
        return sid

    tops = {}
    for pid in table:
        sid = claimed(pid) or launcher(pid) or cli.get(pid, "")
        if sid:
            tops[pid] = outermost(sid)
    return tops, outermost


def hold_owned(table, tops, held, protected):
    """Once attributed, a process keeps its chat while it lives: reparented to launchd, or with the session
    variables scrubbed off its environment (the nx daemon drops CLAUDE_CODE_*), it fell to "other". What it forks
    later inherits through lineage. A chat's CLI and what runs it are never held: a CLI outliving its record would
    be a closed chat's, and its Stop would end a live tab. `held` is the last tick's {pid: [start, session]};
    returns this tick's."""
    for pid, row in table.items():
        hit = held.get(str(pid))
        if pid not in tops and pid not in protected and hit and not row["zombie"] and abs(hit[0] - row["start"]) <= 2:
            tops[pid] = hit[1]
    for pid in table:
        if pid not in tops:
            sid = next((tops[ancestor] for ancestor in lineage(pid, table) if ancestor in tops), "")
            if sid:
                tops[pid] = sid
    return {str(pid): [table[pid]["start"], sid] for pid, sid in tops.items()
            if not table[pid]["zombie"] and table[pid]["age"] >= 0 and pid not in protected}


def chat_tree(cwd):
    """The directory a chat works in: its cwd, or the worktree that cwd sits in (Egor's worktrees live at
    `<repo>/.claude/worktrees/<branch>`). None at or above HOME, under which every process of Egor's runs."""
    path = os.path.realpath(cwd).rstrip(os.sep) if cwd else ""
    cut = path.find(WORKTREES)
    if cut > 0:
        path = path[:cut + len(WORKTREES)] + path[cut + len(WORKTREES):].split(os.sep)[0]
    return "" if not path or (HOME + os.sep).startswith(path + os.sep) else path


def chat_trees(now, sessions, tops, outermost, known):
    """{session: {cwd, tree, top, seen}} of every chat seen live or at work in the last CHAT_KEEP_S, from its
    session record while it is live: what cwd_claims takes a process launchd adopted back by. `top` is the chat
    it is billed to (a worker's launching chat)."""
    fresh = {sid: entry for sid, entry in known.items()
             if isinstance(entry, dict) and 0 <= now - entry.get("seen", 0) < CHAT_KEEP_S}
    for sid, live in sessions.items():
        held = fresh.get(sid) or {}
        if held.get("cwd") != live["cwd"]:
            held = {"cwd": live["cwd"], "tree": chat_tree(live["cwd"])}
        fresh[sid] = dict(held, top=outermost(sid), seen=now)
    for sid in set(tops.values()):
        if sid in fresh:
            fresh[sid]["seen"] = now
    return fresh


def shared_module(name):
    """A module install-agent deploys beside this file (else the checkout's share/), imported on first use."""
    sys.dont_write_bytecode = True
    for directory in reversed(SHARED):
        if directory not in sys.path:
            sys.path.insert(0, directory)
    return importlib.import_module(name)


def deepest_owners(cwd, chats):
    """The chats whose tree holds `cwd`, the deepest tree only (a worktree's chat over its repository's, as the
    statusline's ports probe takes a server back), folded to the chat each is billed to."""
    inside = [(len(entry["tree"]), entry.get("top") or sid) for sid, entry in chats.items()
              if entry.get("tree") and (cwd == entry["tree"] or cwd.startswith(entry["tree"] + os.sep))]
    deepest = max((depth for depth, _ in inside), default=0)
    return sorted({top for depth, top in inside if depth == deepest})


def cwd_claims(table, tops, skip, chats, cache, now):
    """An own process launchd adopted (ppid 1) that nothing above claims is taken back by its working directory:
    inside exactly one chat's tree, that chat's, its tree with it; inside several, ambiguous (shown, never a
    guard's). A launchd job is never claimed: an agent of Egor's may run from a repository. One
    PROC_PIDVNODEPATHINFO per candidate, kept per pid and start ([start, cwd, managed]). Returns
    (claims {pid: session}, ambiguous {root: [sessions]}, cache)."""
    uid, fresh, claims, ambiguous = os.getuid(), {}, {}, {}
    for pid, row in table.items():
        if (row["ppid"] != 1 or row["uid"] != uid or row["zombie"] or row["age"] < 0 or pid in tops or pid in skip
                or row["path"].startswith("/System/") or any(part in row["path"] for part in SYSTEM_PARTS)):
            continue
        hit = cache.get(str(pid))
        if hit and abs(hit[0] - row["start"]) <= 2:
            fresh[str(pid)] = hit
            continue
        fresh[str(pid)] = [row["start"], shared_module("machine_probe").proc_cwd(pid) or "", None]
    if any(hit[1] not in ("", "/") for hit in fresh.values()):
        # A closed chat memlogd never saw live is placed by its transcript, once.
        for sid in set(tops.values()) - set(chats):
            try:
                names = shared_module("chat_names")
                path = names.transcript_path(sid)
                cwd = names._transcript_cwd(path) if path else ""
            except Exception:
                cwd = ""
            chats[sid] = {"cwd": cwd, "tree": chat_tree(cwd), "top": sid, "seen": now}
    found = {int(key): deepest_owners(hit[1], chats) for key, hit in fresh.items()}
    found = {pid: owners for pid, owners in found.items() if owners}
    if any(fresh[str(pid)][2] is None for pid in found):
        jobs = launchd_jobs()
        for pid in found if jobs is not None else []:
            fresh[str(pid)][2] = pid in jobs
    for pid, owners in found.items():
        if fresh[str(pid)][2] is not False:
            continue
        if len(owners) > 1:
            ambiguous[pid] = owners
            continue
        for member in tree_of(pid, table):
            if member not in tops and member not in skip:
                claims[member] = owners[0]
    return claims, ambiguous, fresh


def tree_of(pid, table):
    children = {}
    for child, row in table.items():
        children.setdefault(row["ppid"], []).append(child)
    tree, todo = [], [pid]
    while todo:
        top = todo.pop()
        tree.append(top)
        todo += children.get(top, [])
    return tree


def launchd_list():
    """{label: pid or None} of this user's launchd jobs (`launchctl list`); None when the listing failed, which
    is no evidence about any job: its empty answer once read as "launchd manages nothing" and listed every
    candidate as an orphan."""
    try:
        done = subprocess.run(["launchctl", "list"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if done.returncode != 0:
        return None
    jobs = {}
    for line in done.stdout.splitlines()[1:]:
        fields = line.split("\t") if "\t" in line else line.split(None, 2)
        if len(fields) >= 3 and fields[2].strip():
            jobs[fields[2].strip()] = int(fields[0]) if fields[0].strip().isdigit() else None
    return jobs


def launchd_jobs():
    jobs = launchd_list()
    return None if jobs is None else {pid for pid in jobs.values() if pid}


def booted_simulators():
    """{udid: name} of every booted simulator (`simctl list -j devices booted`), None when it cannot be read."""
    try:
        done = subprocess.run(SIMCTL + ["list", "-j", "devices", "booted"], capture_output=True, text=True, timeout=30)
        groups = json.loads(done.stdout)["devices"].values() if done.returncode == 0 else None
        return None if groups is None else {
            device["udid"]: str(device.get("name") or "") for group in groups for device in group
            if isinstance(device, dict) and device.get("state") == "Booted" and isinstance(device.get("udid"), str)}
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError, AttributeError):
        return None


def simctl_shutdown(udid):
    try:
        return subprocess.run(SIMCTL + ["shutdown", udid], capture_output=True, text=True, timeout=30).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def launchctl_bootout(label):
    try:
        return subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{label}"], capture_output=True,
                              text=True, timeout=30).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


# --- the launch ledger: what a chat starts outside its process tree --------------------------------------
# A simulator a chat boots runs under launchd (CoreSimulatorService spawns its launchd_sim), and a job it
# submits under launchd too: neither carries the chat's environment nor has it for an ancestor (a chat's
# simulator held 7.4 GB in 287 processes for 14 h after the chat closed, on no row at all), and so does an app
# LaunchServices starts on its `open` (two Blenders a chat opened sat in "other"). The hook snapshots these
# kinds around a Bash call that names them and appends what appeared to ledger/<session>.jsonl as
# {session, kind, id, at, ambiguous}; `at` is when the ledger found it, after the resource started.

def ledger_kinds(command):
    kinds = [kind for kind, words in LEDGER_WORDS if words.search(command)]
    return kinds + ["app"] if OPEN_WORD.search(QUOTED.sub("''", command)) else kinds


def ledger_snapshot(kinds):
    shot = {}
    if "sim" in kinds:
        sims = booted_simulators()
        shot["sim"] = None if sims is None else sorted(sims)
    jobs = launchd_list() if "launchd" in kinds or "app" in kinds else None
    if "launchd" in kinds:
        shot["launchd"] = None if jobs is None else sorted(label for label in jobs if not label.startswith(FOREIGN_LABELS))
    if "app" in kinds:
        shot["app"] = None if jobs is None else sorted(label for label in jobs if APP_LABEL.fullmatch(label))
    return shot


def window_end(window, now):
    """When a call window closes: at its Post, BACKGROUND_OPEN_S later for a call run in the background (what it
    starts may come up after the Post), CALL_OPEN_S after its Pre for a call never posted."""
    end = window.get("end")
    if not isinstance(end, (int, float)):
        return min(now, window["at"] + CALL_OPEN_S)
    return end + BACKGROUND_OPEN_S if window.get("background") else end


def call_windows():
    windows = []
    for name in listed(CALLS_DIR):
        window = read_json(os.path.join(CALLS_DIR, name), None) if name.endswith(".json") else None
        if isinstance(window, dict) and isinstance(window.get("at"), (int, float)) and isinstance(window.get("session"), str):
            windows.append(dict(window, file=name))
    return windows


def ledger_append(records):
    for sid in sorted({record["session"] for record in records}):
        os.makedirs(LEDGER_DIR, exist_ok=True)
        with open(os.path.join(LEDGER_DIR, f"{sid}.jsonl"), "a") as handle:
            handle.write("".join(json.dumps({key: record[key] for key in ("session", "kind", "id", "at", "ambiguous")}) + "\n"
                                 for record in records if record["session"] == sid))
    if records:
        # An append moves no directory mtime, and the tick stats nothing but the directory.
        os.utime(LEDGER_DIR)


def ledger_hook(payload):
    """`chat-load ledger`: statusline-workdir-hook.sh hands it the Pre and Post payload of a Bash call naming
    simctl, xcodebuild, launchctl, `brew services` or running `open`. Pre writes the call window with a snapshot of the kinds the
    command names; Post diffs, and what appeared while another chat's call of the same kind was open is
    ambiguous. A worker's resources are its launching chat's (CLAUDE_LAUNCHER_SESSION, as attribute() bills)."""
    tool = payload.get("tool_input") if isinstance(payload.get("tool_input"), dict) else {}
    command = str(tool.get("command") or "")
    sid = os.environ.get("CLAUDE_LAUNCHER_SESSION") or str(payload.get("session_id") or "")
    call = str(payload.get("tool_use_id") or "")
    kinds = ledger_kinds(command)
    if not (kinds and TOKEN.fullmatch(sid) and TOKEN.fullmatch(call)):
        return 0
    path, now = os.path.join(CALLS_DIR, f"{sid}.{call}.json"), time.time()
    if payload.get("hook_event_name") == "PreToolUse":
        os.makedirs(CALLS_DIR, exist_ok=True)
        for window in call_windows():
            if window_end(window, now) < now - 3600:
                try:
                    os.remove(os.path.join(CALLS_DIR, window["file"]))
                except OSError:
                    pass
        for name in listed(LEDGER_DIR):
            try:
                if name.endswith(".jsonl") and os.path.getmtime(os.path.join(LEDGER_DIR, name)) < now - LEDGER_KEEP_S:
                    os.remove(os.path.join(LEDGER_DIR, name))
            except OSError:
                pass
        background = tool.get("run_in_background") is True or bool(re.search(r"(^|[^&>|])&($|[^&>])", command))
        write_json(path, {"session": sid, "call": call, "at": now, "end": None, "kinds": kinds,
                          "background": background, "before": ledger_snapshot(kinds)})
        return 0
    window = read_json(path, None)
    if not isinstance(window, dict) or not isinstance(window.get("at"), (int, float)):
        return 0
    after, before = ledger_snapshot(window.get("kinds") or []), window.get("before") or {}
    rivals = [other for other in call_windows() if other["session"] != sid
              and other["at"] <= now and window_end(other, now) >= window["at"]]
    records = []
    for kind in window.get("kinds") or []:
        if before.get(kind) is None or after.get(kind) is None:
            continue
        ambiguous = any(kind in (other.get("kinds") or []) for other in rivals)
        records += [{"session": sid, "kind": kind, "id": ident, "at": now, "ambiguous": ambiguous}
                    for ident in sorted(set(after[kind]) - set(before[kind]))]
    ledger_append(records)
    write_json(path, dict(window, end=now))
    return 0


def ledger_records(cache):
    """Every ledger line, re-read only once the ledger directory's mtime moved. Returns (records, cache)."""
    try:
        mtime = os.stat(LEDGER_DIR).st_mtime_ns
    except OSError:
        return [], {}
    if cache.get("mtime") == mtime and isinstance(cache.get("records"), list):
        return cache["records"], cache
    records = []
    for name in sorted(listed(LEDGER_DIR)):
        try:
            with open(os.path.join(LEDGER_DIR, name)) as handle:
                lines = handle.read().splitlines() if name.endswith(".jsonl") else []
        except OSError:
            continue
        for line in lines:
            try:
                record = json.loads(line)
            except ValueError:
                continue
            if (isinstance(record, dict) and record.get("kind") in ("sim", "launchd", "app") and isinstance(record.get("id"), str)
                    and isinstance(record.get("session"), str) and isinstance(record.get("at"), (int, float))):
                records.append({"session": record["session"], "kind": record["kind"], "id": record["id"],
                                "at": record["at"], "ambiguous": bool(record.get("ambiguous"))})
    return records, {"mtime": mtime, "records": records}


def owner_of(records):
    """The one chat a resource's ledger lines name, "" for none; ambiguous when they disagree or say so."""
    sessions = {record["session"] for record in records}
    if len(sessions) == 1 and not any(record["ambiguous"] for record in records):
        return next(iter(sessions)), False
    return "", bool(records)


def simulators(table, records, cache, now):
    """Each booted simulator in the table -> {pid: {udid, name, start, tree, owner, ambiguous}}. Its UDID and name
    are read off its launchd_sim's environment once per pid and start; its owner is the ledger's lines for that
    UDID written since it booted. One no line names is matched once to the call windows open when it booted (a
    command run in the background boots it after its Post): exactly one chat's window makes it that chat's, several
    make it ambiguous. Nothing here runs unless a launchd_sim is in the table."""
    uid, fresh, found, added = os.getuid(), {}, {}, []
    for pid, row in table.items():
        if row["comm"] != SIM_COMM or row["uid"] != uid or row["zombie"] or row["age"] < 0:
            continue
        hit = cache.get(str(pid))
        if not (hit and abs(hit[0] - row["start"]) <= 2):
            parsed = procargs(pid, SIM_KEYS)
            if not parsed or not parsed[1][0]:
                continue
            hit = [row["start"], parsed[1][0], parsed[1][1], False]
        mine = [record for record in records + added
                if record["kind"] == "sim" and record["id"] == hit[1] and record["at"] >= hit[0] - 2]
        if not mine and not hit[3]:
            hit[3] = True
            booted = hit[0]
            owners = sorted({window["session"] for window in call_windows() if "sim" in (window.get("kinds") or [])
                             and window["at"] <= booted + 2 and window_end(window, now) >= booted - 2})
            mine = [{"session": sid, "kind": "sim", "id": hit[1], "at": now, "ambiguous": len(owners) > 1}
                    for sid in owners]
            added += mine
        fresh[str(pid)] = hit
        owner, ambiguous = owner_of(mine)
        found[pid] = {"udid": hit[1], "name": hit[2] or hit[1], "start": hit[0], "tree": tree_of(pid, table),
                      "owner": owner, "ambiguous": ambiguous}
    ledger_append(added)
    return found, fresh


def labelled(table, records, cache, now, kind="launchd", listing=launchd_list):
    """Each launchd job a chat submitted (kind `launchd`: `launchctl load|bootstrap|submit`, `brew services start`),
    or app LaunchServices started on its `open` (kind `app`) -> {label: {pid, owner, ambiguous}}. `listing()` (one
    `launchctl list` a tick for both kinds) runs only while a ledger line names a label, at most every LABEL_TTL_S
    or once a job's pid is gone; a label a listing no longer has was unloaded (an app quit), its lines with it."""
    gone = {label: at for label, at in (cache.get("gone") or {}).items() if now - at < LEDGER_KEEP_S}
    mine = {}
    for record in records:
        if record["kind"] == kind and record["at"] > gone.get(record["id"], 0):
            mine.setdefault(record["id"], []).append(record)
    pids = {label: pid for label, pid in (cache.get("pids") or {}).items() if label in mine}
    held = {"at": cache.get("at", 0), "pids": pids, "gone": gone}
    if not mine:
        return {}, held
    if (now - held["at"] >= LABEL_TTL_S or set(mine) - set(pids)
            or any(isinstance(pid, int) and pid not in table for pid in pids.values())):
        jobs = listing()
        if jobs is not None:
            for label in [label for label in mine if label not in jobs]:
                gone[label] = now
                del mine[label]
            held = {"at": now, "pids": {label: jobs[label] for label in mine}, "gone": gone}
    found = {}
    for label, lines in mine.items():
        owner, ambiguous = owner_of(lines)
        pid = held["pids"].get(label)
        found[label] = {"pid": pid if isinstance(pid, int) and pid in table else None, "owner": owner,
                        "ambiguous": ambiguous}
    return found, held


def app_name(label, path):
    """What an app is called: its bundle's name off the executable's path (Blender.app), else its bundle id's
    last part."""
    bundle = re.search(r"([^/]+)\.app/", path or "")
    return bundle.group(1) if bundle else APP_LABEL.fullmatch(label).group(1).rsplit(".", 1)[-1]


def orphans(table, tops, protected, weigh):
    """What nothing runs any more and no chat claims: a process of Egor's whose parent died, which launchd adopted
    but does not manage, an hour old or more, not Apple's, with no chat's work in its tree. A hung CLI
    a dead pipeline left behind lands here (2026-10-28: three `agy --print` of a morning job, 5 days, 0.4 GB);
    an app, launchd's own jobs and a detached bench waiting for its slot never do. `weigh(tree)` -> (cores, kb)."""
    uid, found = os.getuid(), []
    for pid, row in table.items():
        if (row["ppid"] != 1 or row["uid"] != uid or row["zombie"] or row["age"] < ORPHAN_AGE_S or pid in tops
                or pid in protected or row["path"].startswith("/System/")
                or any(part in row["path"] for part in SYSTEM_PARTS)):
            continue
        tree = tree_of(pid, table)
        if any(member in tops or member in protected for member in tree):
            continue
        cores, kb = weigh(tree)
        if (cores or 0.0) >= 0.05 or kb >= SHOWN_KB:
            found.append((pid, tree, cores, kb))
    managed = launchd_jobs() if found else set()
    return [] if managed is None else [entry for entry in found if entry[0] not in managed]


def post_notices(sids, identity, body):
    started = []
    for sid in sids:
        try:
            proc = subprocess.Popen([REPORT_BUS, "post", "--kind", "notice", "--id", identity, "--session", sid],
                                    stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, text=True,
                                    env={**os.environ, "REPORT_FRAME": REPORT_FRAME})
        except OSError:
            continue
        try:
            proc.stdin.write(body)
            proc.stdin.close()
        except OSError:
            pass
        started.append((sid, proc))
    deadline = time.monotonic() + 3
    posted = []
    for sid, proc in started:
        try:
            if proc.wait(timeout=max(0, deadline - time.monotonic())) == 0:
                posted.append(sid)
        except subprocess.TimeoutExpired:
            # A post past the deadline is waiting on the queue lock; killed, its notice was gone
            # without a trace. Left alone it lands or keeps it in lost.log; the alarm says not told.
            pass
    return posted


def post_inboxes(inboxes, text):
    """A worker session never flushes the report bus (`skip_flush`), so its notice goes into its run's
    inbox, which worker-inbox-hook.sh hands it at its next tool call. Appended in one write, so a held
    `.claim.lock` is waited on for a second at most."""
    line = json.dumps({"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "by": "memory-guard",
                       "from": "the machine's memory guard", "text": text}, ensure_ascii=False) + "\n"
    told = []
    for sid, directory in sorted(inboxes.items()):
        lock, held = os.path.join(directory, ".claim.lock"), False
        for _ in range(10):
            try:
                os.mkdir(lock)
                held = True
                break
            except OSError:
                time.sleep(0.1)
        try:
            with open(os.path.join(directory, "inbox"), "a") as handle:
                handle.write(line)
            open(os.path.join(directory, "inbox.new"), "w").close()
            told.append(sid)
        except OSError:
            pass
        finally:
            if held:
                try:
                    os.rmdir(lock)
                except OSError:
                    pass
    return told


def guard(now, avail, room, measure, table, envs, tops, sessions, protected, roots, titles, last, resources=None,
          sims=None):
    """`measure` is how memlogd counted `avail`: "swap" when the swap volume had no room left and
    inactive anonymous pages counted as used (`docs/memory-guard.md`). `resources` maps a member of a
    ledgered resource to (kind, id, pid): a simulator is one job, shut down; a launchd job or an app never is."""
    if avail < 0 or avail >= GUARD_AVAIL_MB:
        return None
    uid, resources, sims = os.getuid(), resources or {}, sims or {}
    # A SIGKILLed process can take longer than a tick to go away under swapping: it is not a new job.
    spent = set(last.get("killed", [])) if last and now - last.get("at", 0) < KILLED_GRACE_S else set()
    chats = {}
    for pid, top in tops.items():
        row, resource = table[pid], resources.get(pid)
        if pid in protected or row["zombie"] or row["uid"] != uid or pid in spent or (resource and resource[0] != "sim"):
            continue
        chats.setdefault(top, {}).setdefault(resource or row["pgid"], []).append(pid)
    if not chats:
        return None
    weight = lambda pids: sum(table[p]["kb"] for p in pids)
    # A chat's jobs are weighed together: a setsid fan-out runs each worker in a group of its own, and four
    # 1 GB groups never tripped a ceiling weighed per group. Its largest job goes first.
    top, groups = max(chats.items(), key=lambda item: (sum(weight(pids) for pids in item[1].values()), item[0]))
    if sum(weight(pids) for pids in groups.values()) // 1024 <= GUARD_JOB_MB:
        return None
    group, members = max(groups.items(), key=lambda item: (weight(item[1]), -min(item[1])))
    sim = sims.get(group[2]) if isinstance(group, tuple) else None
    pgid = table[group[2]]["pgid"] if isinstance(group, tuple) else group
    job_mb = weight(members) // 1024
    if os.environ.get("XPC_SERVICE_NAME") != DAEMON_LABEL:
        print(f"WOULD KILL {now} chat={top} job_pgid={pgid} footprint_mb={job_mb} avail_mb={avail} "
              f"swap_room_mb={room} trigger={measure} pids={','.join(map(str, sorted(members)))}", flush=True)
        return None
    heaviest = max(members, key=lambda p: table[p]["kb"])
    parsed = procargs(heaviest)
    command = " ".join(parsed[0]) if parsed and parsed[0] else table[heaviest]["comm"]
    if len(command) > 160:
        command = command[:159] + "…"
    why = {
        "ram": f"the Mac was down to {avail} MB of available RAM and this was the largest job of the chat whose "
               "jobs weighed the most; left alone it would have frozen the machine into a forced reboot",
        "swap": f"the Mac was down to {avail} MB of RAM it could still free (swap had {room} MB of room left on "
                "the disk, so memory waiting to be swapped out counted as used) and this was the largest job of the "
                "chat whose jobs weighed the most; past that point macOS kills its own services and the machine hangs",
    }[measure]
    what = (f"the simulator {sim['name']} ({sim['udid']}), shut down" if sim else
            f"{command} (pid {heaviest}) and the rest of its process group {pgid}")
    rows = [
        ["stopped", f"{what}: {len(members)} processes, {job_mb / 1024:.1f} GB of memory"],
        ["why", why],
        ["this is", "not a crash and not a broken system: the machine is healthy and the task is still solvable"],
        ["next", "do not start it again at that size or in any variant near it: this Mac cannot hold it beside "
                 "the rest. A rerun must need far less memory (one job at a time, smaller tiles or batches, a "
                 "lighter model); otherwise finish without it and report that it needs a bigger machine"],
    ]
    body = json.dumps({"word": "memory guard", "rows": rows})
    inboxes = {}
    for pid in members:
        root = next((ancestor for ancestor in lineage(pid, table) if ancestor in roots), None)
        if root is None:
            continue
        try:
            with open(os.path.join(roots[root][1], "worker-session")) as handle:
                sid = handle.readline().strip()
        except OSError:
            continue
        if sid and sid != top:
            inboxes[sid] = roots[root][1]
    notify = [sid for sid in [top] + sorted({envs.get(str(p), [0, "", ""])[2] for p in members} - {top})
              if sid in sessions and sid not in inboxes]
    posted = post_notices(notify, f"memguard-{now}-{pgid}", body)
    posted += post_inboxes(inboxes, "memory guard — " + "; ".join(f"{label}: {value}" for label, value in rows))
    notify += sorted(inboxes)
    killed = []
    if sim:
        # A simulator ends by its own shutdown (launchd would read a killed launchd_sim as a crash); what of its
        # tree outlives that is SIGKILLed, and a member already gone went with the shutdown.
        simctl_shutdown(sim["udid"])
        for pid in sorted(members):
            try:
                os.kill(pid, signal.SIGKILL)
                killed.append(pid)
            except ProcessLookupError:
                killed.append(pid)
            except OSError:
                pass
    # The whole group at once when nothing else is in it, so what it forked during the notice goes too.
    elif all(p in members or row["zombie"] for p, row in table.items() if row["pgid"] == pgid):
        try:
            os.killpg(pgid, signal.SIGKILL)
            killed = sorted(members)
        except OSError:
            pass
    for pid in [] if killed else sorted(members):
        try:
            os.kill(pid, signal.SIGKILL)
            killed.append(pid)
        except OSError:
            pass
    if not killed:
        return None
    by_root = {}
    for pid in killed:
        for ancestor in lineage(pid, table):
            if ancestor in roots:
                by_root.setdefault(ancestor, []).append(pid)
                break
    for root, pids in by_root.items():
        agent, directory = roots[root]
        try:
            with open(os.path.join(directory, "memguard"), "a") as handle:
                handle.write(f"MEMGUARD {now} avail_mb={avail} tree_rss_mb={job_mb} agent={agent} "
                             f"root_pid={root} killed={','.join(map(str, pids))}\n")
        except OSError:
            pass
    print(f"KILLED {now} chat={top} job_pgid={pgid} avail_mb={avail} swap_room_mb={room} trigger={measure} "
          f"job_rss_mb={job_mb} killed={','.join(map(str, killed))} notified={','.join(posted) or 'none'}", flush=True)
    return {"at": now, "session": top, "mb": job_mb, "title": titles.get(top, {}).get("t", ""),
            "told": bool(posted) or not notify, "killed": killed}


def launchers_of(chat_names, now):
    """chat_names.worker_run_launchers() reads two files in each of the thousands of run dirs (~0.25 CPU-s) and a
    title refresh is due on most ticks, so the map is kept for LAUNCHERS_TTL_S, under the 600 s a title already lives."""
    held = read_json(LAUNCHERS_PATH, {})
    if isinstance(held.get("map"), dict) and 0 <= now - held.get("at", 0) < LAUNCHERS_TTL_S:
        return held["map"]
    found = {worker: sorted(owners) for worker, owners in chat_names.worker_run_launchers().items()}
    write_json(LAUNCHERS_PATH, {"at": now, "map": found})
    return found


def name_chats(sids, now, cache):
    stale = [sid for sid in sids if now - cache.get(sid, {}).get("at", 0) > 600]
    if not stale:
        return cache
    found = {}
    try:
        sys.dont_write_bytecode = True
        sys.path[:0] = SHARED
        import chat_names
        launchers, store = launchers_of(chat_names, now), chat_names.store_names()
        for sid in stale:
            name = chat_names.chat_name(sid, launchers=launchers, store=store)
            found[sid] = (name, name or chat_names.chat_title(sid, launchers, store))
    except Exception:
        pass
    for sid in stale:
        name, title = found.get(sid, (None, None))
        cache[sid] = {"t": title or cache.get(sid, {}).get("t", ""), "at": now if name else now - 540}
    return cache


def short(title):
    if len(title) <= TITLE_WIDTH:
        return title
    tail = re.search(r" (PR|phase|ph) ?#?\d+$", title)
    suffix = tail.group(0) if tail else ""
    return title[:TITLE_WIDTH - len(suffix) - 1].rstrip() + "…" + suffix


def live_holds(now, table):
    try:
        names = sorted(name for name in os.listdir(HOLDS_DIR) if name.endswith(".json"))
    except OSError:
        return []
    holds = []
    for name in names:
        hold = read_json(os.path.join(HOLDS_DIR, name), None)
        if not (isinstance(hold, dict) and isinstance(hold.get("limiter"), str) and type(hold.get("pid")) is int
                and type(hold.get("since")) in (int, float)):
            continue
        row = table.get(hold["pid"])
        if row and row["age"] >= 0 and now - row["age"] <= hold["since"] + HOLD_START_SLACK_S:
            holds.append(dict(hold, file=name))
    return holds


def waited(seconds):
    seconds = max(0, int(seconds))
    return f"{seconds // 60}m" if seconds < 3600 else f"{seconds // 3600}h{seconds % 3600 // 60:02d}"


def queues(now, holds, tops, state, prev):
    """Per limiter: its held jobs, and when one last left the queue; a queue no job left for
    QUEUE_STUCK_S is stuck, however long a job waits in one that moves."""
    seen, groups, out = prev.get("queues", {}), {}, []
    for hold in holds:
        groups.setdefault(hold["limiter"], []).append(hold)
    state["queues"] = {}
    for limiter, group in sorted(groups.items()):
        files = sorted(hold["file"] for hold in group)
        before = seen.get(limiter) or {}
        moved = before.get("moved") if set(before.get("files", [])) <= set(files) and before.get("moved") else now
        state["queues"][limiter] = {"files": files, "moved": moved}
        by_chat = {}
        for hold in group:
            by_chat.setdefault(tops.get(hold["pid"]) or "", []).append(hold)
        for sid, held in sorted(by_chat.items()):
            out.append({"limiter": limiter, "session": sid or None, "count": len(held),
                        "longest": now - min(hold["since"] for hold in held), "moved_at": moved,
                        "stuck": now - moved >= QUEUE_STUCK_S})
    return out


def spark(buckets, minute, top_cores):
    cells = []
    for m in range(minute - HISTORY_MINUTES, minute):
        seconds = buckets.get(str(m))
        if seconds is None:
            cells.append(" ")
            continue
        cells.append(SPARK[min(len(SPARK) - 1, int(seconds / 60 / top_cores * len(SPARK)))])
    return "".join(cells)


def command_name(pid, table):
    parsed = procargs(pid)
    name = " ".join([os.path.basename(parsed[0][0])] + parsed[0][1:]) if parsed and parsed[0] else table[pid]["comm"]
    return " ".join(name.split())


def render(now, avail, swap, table, tops, sessions, state, prev, holds, protected=frozenset(), view=None):
    ncpu = os.cpu_count() or 1
    top_cores = sysctl_int("hw.perflevel0.physicalcpu") or ncpu
    total_mb = (sysctl_int("hw.memsize") or 0) // 1048576
    dt = now - prev.get("at", 0)
    rated = 0 < dt <= 120
    before = prev.get("procs", {})
    procs, spent, chat_cpu, chat_kb, chat_count, machine = {}, {}, {}, {}, {}, 0.0
    other = dict.fromkeys([k for k, _ in OTHER_KINDS], 0.0)
    other_kb = 0
    for pid, row in table.items():
        if row["cpu"] < 0 or row["age"] < 0:
            continue
        start = row["start"]
        procs[str(pid)] = [start, row["cpu"]]
        seen = before.get(str(pid))
        if seen and abs(seen[0] - start) <= 2:
            used = max(0.0, row["cpu"] - seen[1])
        elif rated and start >= now - dt - 1:
            used = row["cpu"]
        else:
            used = 0.0
        spent[pid] = used
        machine += used
        top = tops.get(pid)
        if top:
            chat_cpu[top] = chat_cpu.get(top, 0.0) + used
            if not row["zombie"]:
                chat_kb[top] = chat_kb.get(top, 0) + row["kb"]
                chat_count[top] = chat_count.get(top, 0) + 1
        else:
            if not row["zombie"]:
                other_kb += row["kb"]
            for kind, names in OTHER_KINDS:
                if row["comm"] in names:
                    other[kind] += used
    state["procs"], state["at"] = procs, now
    minute = now // 60
    history = state.setdefault("hist", {})
    if rated:
        for sid, used in chat_cpu.items():
            buckets = history.setdefault(sid, {})
            buckets[str(minute)] = buckets.get(str(minute), 0.0) + used
    for sid in list(history):
        history[sid] = {m: v for m, v in history[sid].items() if int(m) >= minute - HISTORY_MINUTES}
        if not history[sid] and sid not in chat_kb:
            del history[sid]
    queued = queues(now, holds, tops, state, prev)
    held = {}
    for queue in queued:
        mine = held.setdefault(queue["session"] or "", {"count": 0, "longest": 0, "stuck": False})
        mine["count"] += queue["count"]
        mine["longest"] = max(mine["longest"], queue["longest"])
        mine["stuck"] = mine["stuck"] or queue["stuck"]
    chats = sorted(set(chat_kb) | set(chat_cpu) | (set(held) - {""}))
    titles = name_chats(chats, now, state.setdefault("titles", {}))
    state["titles"] = {sid: titles[sid] for sid in titles if sid in chats or now - titles[sid]["at"] < GUARD_SHOWN_S}
    rate = (lambda seconds: seconds / dt) if rated else (lambda seconds: None)
    chats_cores, machine_cores = rate(sum(chat_cpu.values())), rate(machine)
    used_mb = total_mb - avail if avail >= 0 and total_mb else None
    # Footprints count compressed and swapped pages at their uncompressed size, so they sum past RAM used
    # (live 2026-10-14: 34.7 GB of footprints on 21.7 GB used + 6.1 GB swap). Chats and other are both
    # footprint sums, and the total is their shown parts added, so the row always adds up.
    chats_mb, other_mb = sum(chat_kb.values()) / 1024, other_kb / 1024
    mem_gb = round(chats_mb / 1024, 1) + round(other_mb / 1024, 1)

    def cores(value, width):
        return f"{value:{width}.1f}" if value is not None else "–".rjust(width)

    def gb(mb, width, digits=1):
        return f"{mb / 1024:{width}.{digits}f}" if mb is not None else "–".rjust(width)

    other_cores = machine_cores - chats_cores if rated else None
    title = f"Chats/other  {cores(chats_cores, 0)}/{cores(other_cores, 0)} cores · {gb(chats_mb, 0, 0)}/{gb(other_mb, 0, 0)} GB"
    rows = [
        {"text": f"CPU  {cores(chats_cores, 4)} chats + {cores(other_cores, 4)} other = "
                 f"{cores(machine_cores, 4)} of {ncpu} cores", "dim": True},
        {"text": f"Mem  {gb(chats_mb, 4)} chats + {gb(other_mb, 4)} other = {mem_gb:4.1f} GB · RAM {gb(used_mb, 0)} of "
                 f"{total_mb / 1024:.0f} · swap {max(swap, 0) / 1024:.1f}", "dim": True},
    ]
    event = state.get("guard")
    alarm = bool(event) and now - event["at"] < GUARD_SHOWN_S
    if alarm:
        who = short(event.get("title") or titles.get(event["session"], {}).get("t") or "a chat")
        rows.append({"text": f"⚠ {time.strftime('%H:%M', time.localtime(event['at']))} guard killed a job of "
                             f"{who} · freed {event['mb'] / 1024:.1f} GB"
                             + ("" if event.get("told", True) else " · chat not told"), "alarm": True})
    rows.append("-")
    weigh = lambda tree: (rate(sum(spent.get(pid, 0.0) for pid in tree)), sum(table[pid]["kb"] for pid in tree))
    view = view or {}
    # An app a chat opened is named on its row and counted in it; each gets its own Quit item, never the row's Stop.
    chat_apps = {}
    for label, app in sorted(view.get("apps", {}).items(), key=lambda item: (item[1]["name"], item[0])):
        if app["owner"] and app["tree"] and tops.get(app["pid"]):
            live_tree = [member for member in app["tree"] if not table[member]["zombie"]]
            chat_apps.setdefault(tops[app["pid"]], []).append((label, app, weigh(live_tree)[1]))
    listed, leftovers = [], []
    for sid in chats:
        now_cores = rate(chat_cpu.get(sid, 0.0))
        live = sessions.get(sid)
        wait = held.get(sid)
        apps = chat_apps.get(sid, [])
        app_kb = sum(kb for _, _, kb in apps)
        names = {}
        for _, app, _ in apps:
            names[app["name"]] = names.get(app["name"], 0) + 1
        if not live:
            # A closed chat's own leftovers show at once; under the floor they share one `leftovers` row.
            if (now_cores or 0.0) < 0.05 and chat_kb.get(sid, 0) < SHOWN_KB and not wait and not apps:
                if chat_count.get(sid):
                    leftovers.append(sid)
                continue
            word = "closed"
        elif now_cores is not None and now_cores >= BUSY_CORES:
            word = "needs CPU" if machine_cores >= SATURATED * ncpu else "full speed"
        elif live["status"] == "busy":
            word = "wait model"
        else:
            word = "idle"
        listed.append(((now_cores or 0.0), chat_kb.get(sid, 0), {
            "text": f"{word:<10}  {short(titles[sid]['t'] or 'unnamed chat'):<{TITLE_WIDTH}}  {cores(now_cores, 4)} cores  "
                    f"{gb(chat_kb.get(sid, 0) / 1024, 4)} GB  {spark(history.get(sid, {}), minute, top_cores)}"
                    + (f"  ⏳{wait['count']} {waited(wait['longest'])}" if wait else "")
                    + ("  " + ", ".join(name + (f" ×{count}" if count > 1 else "") for name, count in names.items())
                       if apps else ""),
            "session": sid, "dim": word in ("idle", "wait model") and not (wait and wait["stuck"]),
            **({"alarm": True} if wait and wait["stuck"] else {}), **({"pid": live["pid"]} if live else {}),
            # A closed chat's row ends what it counts: `chat-load stop chat:<session>` from its submenu.
            **({} if live else {"stop": f"chat:{sid}", "gb": round((chat_kb.get(sid, 0) - app_kb) / 1048576, 1)}),
            **({"apps": [{"name": app["name"], "gb": round(kb / 1048576, 1), "quit": f"app:{label}:{int(app['start'])}"}
                         for label, app, kb in apps]} if apps else {})}))
    rows += [row for _, _, row in sorted(listed, key=lambda item: (-item[0], -item[1]))]
    if leftovers:
        members = [pid for pid, top in tops.items() if top in leftovers and not table[pid]["zombie"]]
        now_cores, kb = weigh(members)
        rows.append({"text": f"{'leftovers':<10}  {short(f'{len(members)} processes · {len(leftovers)} chats'):<{TITLE_WIDTH}}  "
                             f"{cores(now_cores, 4)} cores  {gb(kb / 1024, 4)} GB",
                     "stop": "leftovers:" + ",".join(leftovers), "gb": round(kb / 1048576, 1)})
    sims, ambiguous = view.get("sims", {}), view.get("ambiguous", {})
    # A booted simulator no chat's ledger names, or two chats' do, is a row of its own; its Stop shuts it down.
    for pid, sim in sorted(sims.items(), key=lambda item: item[1]["udid"]):
        if sim["owner"]:
            continue
        now_cores, kb = weigh(sim["tree"])
        rows.append({"text": f"{'simulator':<10}  {short(sim['name']):<{TITLE_WIDTH}}  {cores(now_cores, 4)} cores  "
                             f"{gb(kb / 1024, 4)} GB  {waited(table[pid]['age'])}",
                     "stop": f"sim:{sim['udid']}:{int(sim['start'])}", "gb": round(kb / 1048576, 1)})
    # A root launchd adopted inside several chats' trees is shown, never stopped from here nor a guard's.
    shown = set()
    for pid, owners in sorted(ambiguous.items()):
        tree = [member for member in tree_of(pid, table) if member not in tops]
        shown.update(tree)
        now_cores, kb = weigh(tree)
        if (now_cores or 0.0) >= 0.05 or kb >= SHOWN_KB:
            rows.append({"text": f"{'ambiguous':<10}  {short(command_name(pid, table)):<{TITLE_WIDTH}}  "
                                 f"{cores(now_cores, 4)} cores  {gb(kb / 1024, 4)} GB  {waited(table[pid]['age'])}",
                         "dim": True})
    # So is an app two chats' `open` calls overlapped on: display-only, no Quit.
    for label, app in sorted(view.get("apps", {}).items()):
        if app["owner"] or not app["ambiguous"] or not app["tree"]:
            continue
        tree = [member for member in app["tree"] if member not in tops]
        shown.update(tree)
        now_cores, kb = weigh(tree)
        if (now_cores or 0.0) >= 0.05 or kb >= SHOWN_KB:
            rows.append({"text": f"{'ambiguous':<10}  {short(app['name']):<{TITLE_WIDTH}}  {cores(now_cores, 4)} cores  "
                                 f"{gb(kb / 1024, 4)} GB  {waited(table[app['pid']]['age'])}", "dim": True})
    for sim in sims.values():
        shown.update(sim["tree"])
    for pid, tree, now_cores, kb in sorted(orphans(table, tops, set(protected) | shown, weigh), key=lambda item: -item[3]):
        rows.append({"text": f"{'orphan':<10}  {short(command_name(pid, table)):<{TITLE_WIDTH}}  {cores(now_cores, 4)} cores  "
                             f"{gb(kb / 1024, 4)} GB  {waited(table[pid]['age'])}",
                     "stop": f"orphan:{pid}:{int(table[pid]['start'])}", "gb": round(kb / 1048576, 1)})
    for queue in queued:
        if not queue["session"]:
            rows.append({"text": f"{'queued':<10}  {short(queue['limiter']):<{TITLE_WIDTH}}  "
                                 f"⏳{queue['count']} {waited(queue['longest'])}",
                         "dim": not queue["stuck"], **({"alarm": True} if queue["stuck"] else {})})
    for queue in queued:
        who = short(titles.get(queue["session"], {}).get("t") or "") if queue["session"] else ""
        queue["text"] = (f"{who or queue['limiter']}: {queue['count']} job{'s' if queue['count'] != 1 else ''} "
                         f"queued, none started for {waited(now - queue['moved_at'])}")
    rows.append("-")
    rows.append({"text": "Other incl.: " + " · ".join(
        f"{kind} {cores(rate(other[kind]), 0)}" for kind, _ in OTHER_KINDS) + " cores", "dim": True})
    return {"as_of": now, "title": title, "alarm": alarm or any(queue["stuck"] for queue in queued),
            "rows": rows, "queues": queued,
            "queue_stuck_s": QUEUE_STUCK_S, "error": ""}


def attribution(table, prev, now):
    """Who each process belongs to, the one answer sample and stop share: the environment, ancestry and registry
    (attribute), what those settled on while the process lived (hold_owned), the resources the launch ledger
    names (simulators, launchd jobs, apps) and the working directory of a root launchd adopted (cwd_claims), in that
    order. Returns the view and what it keeps for the next tick."""
    envs = environments(table, prev.get("env", {}))
    sessions = {sid: entry for sid, entry in live_sessions(table).items() if entry["own"]}
    roots = registered_roots(table)
    protected = set()
    # Only a record of the process now under its pid spares it: a stale one on a reused pid hid a leftover's tree.
    for pid in list(roots) + [entry["pid"] for entry in sessions.values()]:
        protected.add(pid)
        protected.update(lineage(pid, table))
    tops, outermost = attribute(table, envs, sessions)
    owned = hold_owned(table, tops, prev.get("owned", {}), protected)
    chats = chat_trees(now, sessions, tops, outermost, prev.get("chats", {}))
    records, ledger = ledger_records(prev.get("ledger", {}))
    sims, sim_cache = simulators(table, records, prev.get("sims", {}), now)
    listed_jobs = []

    def listing():
        if not listed_jobs:
            listed_jobs.append(launchd_list())
        return listed_jobs[0]

    labels, label_cache = labelled(table, records, prev.get("labels", {}), now, "launchd", listing)
    apps, app_cache = labelled(table, records, prev.get("apps", {}), now, "app", listing)
    resources = {}
    for pid, sim in sims.items():
        for member in sim["tree"] if sim["owner"] else []:
            if member not in tops:
                tops[member], resources[member] = outermost(sim["owner"]), ("sim", sim["udid"], pid)
    for label, job in labels.items():
        for member in tree_of(job["pid"], table) if job["owner"] and job["pid"] else []:
            if member not in tops:
                tops[member], resources[member] = outermost(job["owner"]), ("launchd", label, job["pid"])
    # An app a chat opened is billed to it (its row, CPU and GB), never a guard's candidate nor its Stop's: Egor may
    # be working in it. Its own Quit item asks it to quit (`stop app:<label>:<start>`).
    for label, app in apps.items():
        pid = app["pid"]
        app.update(bundle=APP_LABEL.fullmatch(label).group(1), name=app_name(label, table[pid]["path"] if pid else ""),
                   start=table[pid]["start"] if pid else None, tree=tree_of(pid, table) if pid else [])
        for member in app["tree"] if app["owner"] else []:
            if member not in tops:
                tops[member], resources[member] = outermost(app["owner"]), ("app", label, pid)
    skip = set(protected).union(*(sim["tree"] for sim in sims.values()))
    claims, ambiguous, cwds = cwd_claims(table, tops, skip, chats, prev.get("cwd", {}), now)
    tops.update(claims)
    view = {"envs": envs, "sessions": sessions, "roots": roots, "protected": protected, "tops": tops,
            "outermost": outermost, "chats": chats, "sims": sims, "labels": labels, "apps": apps,
            "resources": resources, "ambiguous": ambiguous}
    return view, {"env": envs, "owned": owned, "chats": chats, "ledger": ledger, "sims": sim_cache,
                  "labels": label_cache, "apps": app_cache, "cwd": cwds}


def sample(now, avail, swap, room, measure):
    os.makedirs(LOG_DIR, exist_ok=True)
    prev = read_json(STATE_PATH, {})
    state = {"guard": prev.get("guard"), "titles": prev.get("titles", {}), "hist": prev.get("hist", {}),
             "queues": prev.get("queues", {})}
    table = process_table()
    view, kept = attribution(table, prev, now)
    state.update(kept)
    tops, sessions, protected = view["tops"], view["sessions"], view["protected"]
    footprints(table, [pid for pid, row in table.items() if not row["zombie"]])
    failure = ""
    try:
        event = guard(now, avail, room, measure, table, view["envs"], tops, sessions, protected, view["roots"],
                      state["titles"], prev.get("guard"), view["resources"], view["sims"])
        if event:
            state["guard"] = event
    except Exception as error:
        failure = f"guard: {error!r}"
    try:
        snapshot = render(now, avail, swap, table, tops, sessions, state, prev, live_holds(now, table), protected, view)
    except Exception as error:
        snapshot = {"as_of": now, "title": "Chats: error", "alarm": False, "rows": []}
        failure = failure or f"render: {error!r}"
    snapshot["error"] = failure or snapshot.get("error", "")
    write_json(STATE_PATH, state)
    write_json(OUT_PATH, snapshot)
    if failure:
        print(f"CHAT-LOAD-ERROR {now} {failure}", flush=True)
        return 1
    return 0


def born_owner(pid, view):
    """The chat a process born during a Stop belongs to by its own environment or its working directory, "" for
    none: it has no ancestry left to read once launchd adopted it."""
    parsed = procargs(pid)
    sid = (parsed[1][0] or parsed[1][1]) if parsed else ""
    if sid:
        return view["outermost"](sid)
    owners = deepest_owners(shared_module("machine_probe").proc_cwd(pid) or "", view["chats"])
    return owners[0] if len(owners) == 1 else ""


def quit_app(view, table, label, start):
    """`stop app:<label>:<start>`: asks an app one chat opened to quit, the way its own Quit menu does (unsaved work
    gets its dialog), and waits APP_QUIT_S for it to go. Never a signal: an app may hold work no signal saves."""
    app = view["apps"].get(label)
    if not app or not app["pid"] or abs(app["start"] - start) > 2:
        print("already gone")
        return 0
    if not app["owner"]:
        print(f"{app['name']}: no one chat opened it, left alone")
        return 1
    tree = [pid for pid in app["tree"] if not table[pid]["zombie"]]
    footprints(table, tree)
    mb = sum(table[pid]["kb"] for pid in tree) / 1024
    try:
        # The quit goes to this pid, never to the bundle: `tell application id` picks any instance, so with the
        # owner's own Blender open beside the chat's it could ask his to quit. `terminate` (a JXA property read
        # calls it) sends the app's normal Quit and returns; the app is waited for, not osascript.
        asker = subprocess.Popen(["osascript", "-l", "JavaScript", "-e",
                                  "ObjC.import('AppKit'); const a = $.NSRunningApplication"
                                  f".runningApplicationWithProcessIdentifier({int(app['pid'])}); a.isNil() || a.terminate"],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        print(f"{app['name']}: could not ask it to quit")
        return 1
    deadline = time.monotonic() + APP_QUIT_S
    while True:
        try:
            os.kill(app["pid"], 0)
        except ProcessLookupError:
            break
        except OSError:
            pass
        if time.monotonic() >= deadline:
            if asker.poll() is None:
                asker.kill()
            print(f"{app['name']} still running after {APP_QUIT_S} s: it may be asking to save, left open")
            return 1
        time.sleep(0.2)
    if asker.poll() is None:
        asker.kill()
    print(f"quit {app['name']} · {mb / 1024:.1f} GB")
    return 0


def stop(key):
    """Ends what one menu row counts, worked out again from the live table, so a pid reused since the row was
    drawn is never touched: `chat:<session>` every process of a closed chat but the apps it opened,
    `leftovers:<session>,...` those of several, `sim:<udid>:<start>` a simulator no chat owns,
    `orphan:<pid>:<start>` an orphan's tree; `app:<label>:<start>` asks one app to quit (quit_app). A resource the
    ledger bills to the chat ends by its own teardown first (`simctl shutdown`, `launchctl bootout` of a label that
    chat submitted). Then SIGTERM with SIGCONT, so a stopped process hears it; a child they spawn while shutting
    down goes too, and so does a process launchd adopted meanwhile that is the same chat's by its environment or
    working directory (2026-10-28: a stopped `nx serve` started a fresh nx daemon on its way out); one that is not
    is named and left. What still runs after STOP_GRACE_S is SIGKILLed."""
    table, began = process_table(), time.time()
    uid, me = os.getuid(), {os.getpid(), *lineage(os.getpid(), table)}
    view = attribution(table, read_json(STATE_PATH, {}), int(began))[0]
    sessions, tops, outermost = view["sessions"], view["tops"], view["outermost"]
    kind, _, rest = key.partition(":")
    chats, teardown = set(), []
    if kind in ("chat", "leftovers") and rest:
        chats = set(rest.split(","))
        if chats & set(sessions):
            print("that chat is open: close it in its tab")
            return 1
        members = {pid for pid, top in tops.items() if top in chats and view["resources"].get(pid, ("",))[0] != "app"}
        teardown = [("simulator", sim["name"], sim["udid"]) for sim in view["sims"].values()
                    if sim["owner"] and outermost(sim["owner"]) in chats]
        teardown += [("launchd job", label, label) for label, job in sorted(view["labels"].items())
                     if job["owner"] and outermost(job["owner"]) in chats]
    elif kind == "orphan" and re.fullmatch(r"\d+:\d+", rest):
        pid, start = (int(part) for part in rest.split(":"))
        row = table.get(pid)
        if not row or row["ppid"] != 1 or abs(row["start"] - start) > 2:
            print("already gone")
            return 0
        members = set(tree_of(pid, table))
        if members & set(tops):
            print("a chat's work runs under it now: left alone")
            return 1
    elif kind == "sim" and re.fullmatch(r"[0-9A-Fa-f-]+:\d+", rest):
        udid, _, start = rest.rpartition(":")
        sim = next((sim for sim in view["sims"].values() if sim["udid"] == udid and abs(sim["start"] - int(start)) <= 2), None)
        if not sim:
            print("already gone")
            return 0
        if sim["owner"] and outermost(sim["owner"]) in sessions:
            print("an open chat's simulator: left alone")
            return 1
        members, teardown = set(sim["tree"]), [("simulator", sim["name"], udid)]
    elif kind == "app" and re.fullmatch(r"application\.[A-Za-z0-9._-]+:\d+", rest):
        label, _, start = rest.rpartition(":")
        return quit_app(view, table, label, int(start))
    else:
        print("usage: chat-load stop chat:<session> | leftovers:<session>,... | sim:<udid>:<start> | orphan:<pid>:<start>"
              " | app:<label>:<start>", file=sys.stderr)
        return 2
    members = {pid for pid in members if table[pid]["uid"] == uid and not table[pid]["zombie"] and pid not in me}
    if not members and not teardown:
        print("nothing left to stop")
        return 0
    footprints(table, members)
    mb = sum(table[pid]["kb"] for pid in members) / 1024
    notes, failed = [], False
    for what, name, ident in teardown:
        done = simctl_shutdown(ident) if what == "simulator" else launchctl_bootout(ident)
        failed = failed or not done
        notes.append(f"{what} {name} " + ("would not stop" if not done else "shut down" if what == "simulator" else "booted out"))

    def send(pids, *sigs):
        for pid in pids:
            for sig in sigs:
                try:
                    os.kill(pid, sig)
                except OSError:
                    pass

    def running():
        live = process_table()
        return live, {pid for pid in members if pid in live and not live[pid]["zombie"]
                      and abs(live[pid]["start"] - table[pid]["start"]) <= 2}

    def adopted(pid, row):
        known = table.get(pid)
        return (row["ppid"] == 1 and row["uid"] == uid and not row["zombie"] and row["start"] >= began - 2
                and not (known and abs(known["start"] - row["start"]) <= 2) and pid not in me
                and not row["path"].startswith("/System/") and not any(part in row["path"] for part in SYSTEM_PARTS))

    send(members, signal.SIGTERM, signal.SIGCONT)
    judged, left = set(), []
    deadline, settled = time.monotonic() + STOP_GRACE_S, time.monotonic() + STOP_SETTLE_S
    while True:
        live, alive = running()
        born = {pid for pid, row in live.items() if row["ppid"] in alive and pid not in members
                and row["uid"] == uid and not row["zombie"] and pid not in me}
        for pid, row in live.items():
            if pid in members or pid in judged or not adopted(pid, row):
                continue
            judged.add(pid)
            if chats and born_owner(pid, view) in chats:
                born.update(member for member in tree_of(pid, live) if member not in members and member not in me)
            else:
                left.append(pid)
        for pid in born:
            table[pid] = live[pid]
        members |= born
        send(born, signal.SIGTERM, signal.SIGCONT)
        if (not (alive or born) and time.monotonic() >= settled) or time.monotonic() >= deadline:
            break
        time.sleep(0.2)
    if alive or born:
        send(alive | born, signal.SIGKILL)
        for _ in range(20):
            alive = running()[1]
            if not alive:
                break
            time.sleep(0.1)
    count = len(members) - len(alive)
    print(f"stopped {count} process{'es' if count != 1 else ''} · {mb / 1024:.1f} GB" + "".join(f" · {note}" for note in notes)
          + (f" · {len(alive)} would not stop: pid {', '.join(map(str, sorted(alive)))}" if alive else "")
          + (f" · {len(left)} started meanwhile, not this chat's, left: pid {', '.join(map(str, sorted(left)[:3]))}"
             if left else ""))
    return 1 if alive or failed else 0


def show():
    snapshot = read_json(OUT_PATH, None)
    if not snapshot:
        print(f"chat-load: no snapshot at {OUT_PATH}", file=sys.stderr)
        return 1
    print(snapshot.get("title", ""))
    for row in snapshot.get("rows", []):
        print(row if row == "-" else row.get("text", ""))
    return 0


def main(argv):
    if argv[:1] == ["show"] and len(argv) == 1:
        return show()
    if argv[:1] == ["stop"] and len(argv) == 2:
        return stop(argv[1])
    if argv == ["ledger"]:
        try:
            payload = json.load(sys.stdin)
        except ValueError:
            return 0
        return ledger_hook(payload) if isinstance(payload, dict) else 0
    if (argv[:1] == ["sample"] and len(argv) == 11
            and argv[1::2] == ["--now", "--avail", "--swap", "--room", "--measure"] and argv[10] in ("ram", "swap")):
        try:
            now, avail, swap, room = int(argv[2]), int(argv[4]), int(argv[6]), int(argv[8])
        except ValueError:
            now = None
        if now is not None:
            try:
                return sample(now, avail, swap, room, argv[10])
            except Exception as error:
                print(f"CHAT-LOAD-ERROR {now} sample: {error!r}", flush=True)
                return 1
    print("usage: chat-load sample --now EPOCH --avail MB --swap MB --room MB --measure ram|swap | chat-load show"
          " | chat-load stop chat:<session>|leftovers:<session>,...|sim:<udid>:<start>|orphan:<pid>:<start>|app:<label>:<start>"
          " | chat-load ledger <hook payload", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

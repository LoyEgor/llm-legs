#!/usr/bin/env bash
# Source of truth; `memlogd install-agent` deploys a copy to ~/.local/libexec/memlogd, which is
# what launchd runs. The copy is not a convenience: a LaunchAgent that execs off /Volumes/Work
# gets EPERM from TCC unless that exact program path was granted, and a memory logger must also
# keep running while that volume is unmounted. harness-doctor reruns install-agent once an edit of
# this file or any file it deploys beside the copy (chat-load, chat_names.py, machine_probe.py,
# limit_hit.py, report-bus, report_frame.py, store-lock.sh, limiter-hold.sh, limit-hit.sh) lands in main.
# Besides logging, this daemon ACTS: every full tick runs chat-load, deployed beside this copy, which
# keeps the per-chat load snapshot for the menubar and, when the machine is nearly out of RAM,
# SIGKILLs the fattest job a chat launched (`docs/memory-guard.md` is the decision record).
# launchd's PATH finds macOS bash 3.2, which has no sleep builtin: every tick would fork a `sleep`.
if [ "${BASH_VERSINFO[0]}" -lt 5 ] && [ "${BASH_SOURCE[0]}" = "$0" ]; then
  for modern_bash in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [ -x "$modern_bash" ] && "$modern_bash" -c '[ "${BASH_VERSINFO[0]}" -ge 5 ]' && exec "$modern_bash" "$0" "$@"
  done
fi
{
set -u

resolve_script() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")" && printf '%s/%s\n' "$PWD" "$(basename "$source")"
}

script_path=$(resolve_script)
repo_root=$(cd "$(dirname "$script_path")/.." && pwd)

log_dir="${MEMLOGD_DIR:-$HOME/Library/Logs/memlogd}"
frames="$log_dir/frames"
# Every tick probes (vm_stat, swap: no python, no ps), every quiet_interval s while calm and every
# armed_interval s while armed. The full tick (ps, chat-load and its guard) runs on every incident tick,
# on any probe that sees pressure, once per wall-clock armed_full_interval slot while armed and once per
# wall-clock full_interval slot while calm: the menu calls chats.json stale at 120 s and its sparks
# bucket CPU per minute. 2026-11-11: 15 s full ticks cost 21-40 CPU-min a day, almost all of it calm.
# A probe is 5 forks (vm_stat, df, sysctl, available_mb's awk), ~18 ms CPU (a full tick ~200 ms), so
# calm probes every 10 s, not 5.
quiet_interval="${MEMLOGD_QUIET_INTERVAL:-10}"
armed_interval="${MEMLOGD_ARMED_INTERVAL:-2}"
full_interval="${MEMLOGD_FULL_INTERVAL:-60}"
armed_full_interval="${MEMLOGD_ARMED_FULL_INTERVAL:-15}"
incident_interval="${MEMLOGD_INCIDENT_INTERVAL:-1}"
# Armed is danger short of an incident (arm_reason): available under arm_avail_mb, swap used up
# arm_swap_mb or available down arm_drop_mb within arm_window s; it holds arm_hold s past the last
# sign. Replayed over the 2026-11-09..11 day logs: armed 61 s before the 02:32 burst's first incident
# tick, 47 s before 02:44's, 97 s before 17:42's (tests/fixtures/memlogd-bursts-2026-11-11.txt), and
# 29 % of the non-incident time on those busy days; a 30 s window missed 02:32 (a 2.2 GB drop over 31 s).
arm_avail_mb=6144
arm_swap_mb=512
arm_drop_mb=2048
arm_window=60
arm_hold=120
enter_avail_mb="${MEMLOGD_ENTER_AVAIL_MB:-4096}"
exit_avail_mb="${MEMLOGD_EXIT_AVAIL_MB:-5120}"
# Under this much room for swap to grow into, available RAM is counted the swap way (available_mb).
swap_reserve_mb=4096
recover_seconds="${MEMLOGD_RECOVER_SECONDS:-60}"
retention_days="${MEMLOGD_RETENTION_DAYS:-3}"
max_frames_mb="${MEMLOGD_MAX_FRAMES_MB:-1024}"
max_episode_mb="${MEMLOGD_MAX_EPISODE_MB:-256}"
fast_seconds="${MEMLOGD_FAST_SECONDS:-180}"
slow_interval="${MEMLOGD_SLOW_INTERVAL:-30}"
jump_nodes="${MEMLOGD_JUMP_NODES:-8}"
jump_rss_mb="${MEMLOGD_JUMP_RSS_MB:-1024}"
max_ticks="${MEMLOGD_MAX_TICKS:-0}"
sync_writes="${MEMLOGD_SYNC:-1}"
machine_interval="${MEMLOGD_MACHINE_INTERVAL:-15}"
probe_interval="${MEMLOGD_PROBE_INTERVAL:-60}"
probe_forks="${MEMLOGD_PROBE_FORKS:-10}"

label=com.egor.memlogd
agent_plist="$HOME/Library/LaunchAgents/$label.plist"
wrapper="$HOME/.local/libexec/memlogd"
chat_load="$(dirname "$script_path")/chat-load"
. "$(dirname "$script_path")/limit-hit.sh" 2>/dev/null || . "$repo_root/share/limit-hit.sh" 2>/dev/null || limit_hit() { :; }
lock_dir="$log_dir/memlogd.lock"
current_file=""
episode_frames=""
episode_start=0
last_frame_at=""
prev_node_count=""
prev_node_rss=""
episode_capped=0
machine_at=""
probe_at=""
prev_swapins=""
prev_swapins_at=""
full_at=""
armed_until=0
danger=""
arm_t=()
arm_a=()
arm_s=()
ncpu=-1
boot_id=-1

# "<MB> <measure>". The ram measure counts free, inactive and speculative pages, all RAM can hand out
# while swap can grow. Under swap_reserve_mb of room an inactive anonymous page has nowhere to go and
# is used memory: the swap measure counts free, speculative and purgeable pages plus the file-backed
# share of the inactive ones (vm_stat has no per-queue split, so the inactive queue is taken at the
# file-backed share of all active and inactive pages). 2026-10-20 02:32: 3748 MB by the ram measure,
# 1373 MB by the swap one, while the kernel's low-swap jetsam was killing services.
# -1 is "the probe failed", and every threshold test rejects it: a vm_stat that returns nothing
# must not read as zero bytes available and fake an incident. Without a room or a file-backed count
# the ram measure stays. Called without a room (share/slots.sh, bin/image-fanout) it prints the bare MB.
available_mb() { # vm_text [room]
  awk -v room="${2--1}" -v said="${2+1}" -v reserve="${swap_reserve_mb-0}" '
    BEGIN { file = -1 }
    NR == 1 { for (i = 1; i <= NF; i++) if ($i == "of") page = $(i + 1) + 0 }
    /^Pages free:/ { free = $3 + 0; seen = 1 }
    /^Pages active:/ { active = $3 + 0 }
    /^Pages inactive:/ { inactive = $3 + 0 }
    /^Pages speculative:/ { speculative = $3 + 0 }
    /^Pages purgeable:/ { purgeable = $3 + 0 }
    /^File-backed pages:/ { file = $3 + 0 }
    END {
      if (!seen) { print said ? "-1 ram" : "-1"; exit }
      if (page <= 0) page = 4096
      pages = free + inactive + speculative
      measure = "ram"
      if (room >= 0 && room < reserve && file >= 0 && active + inactive > 0) {
        backed = file > speculative ? file - speculative : 0
        pages = free + speculative + purgeable + inactive * backed / (active + inactive)
        measure = "swap"
      }
      if (said) printf "%d %s\n", pages * page / 1048576, measure
      else printf "%d\n", pages * page / 1048576
    }' <<<"$1"
}

# Sets `swap` (used MB) and `room` (MB): room is the free swap plus the free disk of the swap volume, all
# swap can still grow into. Once it is gone the kernel's low-swap jetsam kills system services while
# vm_stat still shows gigabytes available (2026-10-20, 14 GB free on the disk). -1 is a failed probe.
# Parsed in bash into globals: it runs every probe, and awk plus a $(...) were 3 of its 5 forks.
swap_probe() {
  local text disk="" used free mb
  text=$(df -m /System/Volumes/VM 2>/dev/null) || :
  { read -r _ && read -r _ _ _ disk _; } <<<"$text" || :
  [[ "$disk" =~ ^[0-9]+$ ]] || disk=-1
  text=$(sysctl -n vm.swapusage 2>/dev/null) || text=""
  swap=-1 room=-1
  [[ "$text" =~ used\ =\ ([^ ]+) ]] || return 0
  used=${BASH_REMATCH[1]}
  swap_mb "$used"
  swap=$mb
  [[ "$text" =~ free\ =\ ([^ ]+) ]] && [ "$disk" -ge 0 ] || return 0
  free=${BASH_REMATCH[1]}
  swap_mb "$free"
  [ "$mb" -lt 0 ] || room=$((mb + disk))
}

# "2977.31M" -> mb=2977 (G x1024, K /1024, truncated), -1 when it is no size.
swap_mb() {
  [[ "$1" =~ ^([0-9]+)(\.([0-9]*))?([KMG]?)$ ]] || { mb=-1; return 0; }
  local frac="${BASH_REMATCH[3]}000" milli
  milli=$((10#${BASH_REMATCH[1]} * 1000 + 10#${frac:0:3}))
  case ${BASH_REMATCH[4]} in
    G) mb=$((milli * 1024 / 1000)) ;;
    K) mb=$((milli / 1024000)) ;;
    *) mb=$((milli / 1000)) ;;
  esac
}

# A ps that failed or said nothing is unknown, not zero node processes: the jump test compares this
# tick against the previous one, so a zero here fakes a multi-GB rise on the next healthy tick.
node_stats() {
  local snapshot
  snapshot=$(ps -axo rss=,comm= 2>/dev/null) || snapshot=""
  if [ -z "$snapshot" ]; then
    printf '%s\n' '-1 -1'
    return 0
  fi
  awk '
    {
      rss = $1
      $1 = ""
      sub(/^ +/, "", $0)
      name = $0
      sub(/.*\//, "", name)
      if (name == "node") { count++; total += rss }
    }
    END { printf "%d %d\n", count + 0, (total + 0) / 1024 }' <<<"$snapshot"
}

chat_load_tick() { # now avail swap room measure
  local line
  while IFS= read -r line; do
    append "$line"
    flush
  done < <("$chat_load" sample --now "$1" --avail "$2" --swap "$3" --room "$4" --measure "$5" 2>/dev/null)
}

boot_facts() {
  local text
  text=$(sysctl -n hw.ncpu kern.boottime 2>/dev/null) || text=""
  [[ "$text" =~ ^([0-9]+) ]] && ncpu=${BASH_REMATCH[1]}
  [[ "$text" =~ sec\ =\ ([0-9]+) ]] && boot_id=${BASH_REMATCH[1]}
}

contention_probe_ms() {
  local start end i=0
  start=$(date +%s%N 2>/dev/null)
  while [ "$i" -lt "$probe_forks" ]; do
    /usr/bin/true
    i=$((i + 1))
  done
  printf '{"a":[1,2,3]}' | jq -e '.a | add == 6' >/dev/null 2>&1 || { printf '%s\n' -1; return 0; }
  end=$(date +%s%N 2>/dev/null)
  if [[ "$start" =~ ^[0-9]+$ ]] && [[ "$end" =~ ^[0-9]+$ ]] && [ "$end" -ge "$start" ]; then
    printf '%s\n' $(((end - start) / 1000000))
  else
    printf '%s\n' -1
  fi
}

machine_tick() { # now swap vm_text room
  local now="$1" swap="$2" room="$4" load1=-1 swapins=-1 rate=-1 thermal=-1 text probe=""
  [ -z "$machine_at" ] || [ "$now" -lt "$machine_at" ] || [ $((now - machine_at)) -ge "$machine_interval" ] || \
    return 0
  machine_at=$now
  text=$(sysctl -n vm.loadavg 2>/dev/null) || text=""
  [[ "$text" =~ ^\{\ *([0-9.]+) ]] && load1=${BASH_REMATCH[1]}
  [[ "$3" =~ Swapins:\ *([0-9]+) ]] && swapins=${BASH_REMATCH[1]}
  if [ "$swapins" -ge 0 ] && [ -n "$prev_swapins" ] && [ "$prev_swapins" -ge 0 ] && \
     [ "$now" -gt "$prev_swapins_at" ] && [ "$swapins" -ge "$prev_swapins" ]; then
    rate=$(((swapins - prev_swapins) / (now - prev_swapins_at)))
  fi
  prev_swapins=$swapins
  prev_swapins_at=$now
  text=$(notifyutil -g com.apple.system.thermalpressurelevel 2>/dev/null) || text=""
  [[ "$text" =~ \ ([0-9]+)$ ]] && thermal=${BASH_REMATCH[1]}
  if [ -z "$probe_at" ] || [ "$now" -lt "$probe_at" ] || [ $((now - probe_at)) -ge "$probe_interval" ]; then
    probe_at=$now
    probe=" probe_ms=$(contention_probe_ms)"
  fi
  [ -d "$log_dir/machine" ] || mkdir -p "$log_dir/machine"
  printf '%s load1=%s ncpu=%s swap_mb=%s swap_room_mb=%s swapin_pages_s=%s thermal=%s boot=%s%s\n' \
    "$now" "$load1" "$ncpu" "$swap" "$room" "$rate" "$thermal" "$boot_id" "$probe" >>"$log_dir/machine/$today.log"
}

log_path() { printf '%s/%s.log\n' "$log_dir" "$1"; }


frames_stamp() { date -r "$1" +%Y-%m-%dT%H%M%S; }

# fsync of this one file, never sync(2): a machine-wide flush at 1 Hz under memory pressure hurts
# every process. Without notrunc dd truncates the log.
flush() { [ "$sync_writes" = 1 ] || return 0; dd of="${1:-$current_file}" conv=notrunc,fsync if=/dev/null 2>/dev/null; }

append() { printf '%s\n' "$*" >>"$current_file"; }

file_bytes() { stat -f %z "$1" 2>/dev/null || printf '0\n'; }

# One stat pass per call, oldest first: at 1 Hz under thrash a fork per file plus a rescan per
# victim costs more than the frames the cap exists to keep. A file that vanished between the glob
# and the stat drops out of the listing instead of breaking the arithmetic. The live episode (or
# jump file being written) is never a victim: a freeze in progress is exactly the evidence kept.
evict_frames() {
  local keep="${1##*/}" cap=$((max_frames_mb * 1048576)) listing total=0 mtime size name
  [ -d "$frames" ] || mkdir -p "$frames"
  listing=$(stat -f '%m %z %N' "$frames"/*.log "$frames"/*.log.gz 2>/dev/null | sort -n)
  while read -r mtime size name; do
    [ -n "$name" ] || continue
    total=$((total + size))
  done <<<"$listing"
  [ "$total" -gt "$cap" ] || return 0
  while read -r mtime size name; do
    [ -n "$name" ] || continue
    [ "$total" -gt "$cap" ] || break
    [ "${name##*/}" = "$keep" ] && continue
    rm -f "$name" && total=$((total - size)) &&
      limit_hit memlogd.frames-cap "$cap" bytes drop "incident frames ${name##*/} ($size bytes) evicted for a newer episode" \
        'bin/memlogd:max_frames_mb="${' "$((total + size))"
  done <<<"$listing"
}

write_frame() {
  local dest="$1" kind="$2" now="$3" avail="$4" swap="$5" node_count="$6" node_rss="$7"
  [ -d "${dest%/*}" ] || mkdir -p "${dest%/*}"
  evict_frames "$dest"
  {
    printf '%s %s avail_mb=%s swap_used_mb=%s node_count=%s node_rss_mb=%s\n' \
      "$now" "$kind" "$avail" "$swap" "$node_count" "$node_rss"
    printf 'PS-BEGIN %s\n' "$now"
    ps -axo pid,ppid,pgid,rss,etime,command 2>/dev/null
    printf 'PS-END %s\n' "$now"
  } >>"$dest"
  flush "$dest"
}

want_frame() {
  [ -z "$last_frame_at" ] && return 0
  [ $((now - episode_start)) -lt "$fast_seconds" ] && return 0
  [ $((now - last_frame_at)) -ge "$slow_interval" ]
}

# Swap is reported but decides no incident: macOS holds swap allocated for hours after the pressure
# that caused it is gone, and a swap term here once latched the 1 Hz dumps for 14 hours and 8 GB.
# Its room only changes how available RAM is counted (available_mb).
pressure() { [ "$1" -ge 0 ] && [ "$1" -lt "$enter_avail_mb" ]; }

# A failed probe is unknown, not pressure — the same rule pressure() applies, so a vm_stat that
# breaks mid-incident cannot latch the dumps forever.
recovered() { [ "$1" -lt 0 ] || [ "$1" -ge "$exit_avail_mb" ]; }

# The sign of danger this probe shows, into `danger` (a global: a $(...) would fork every probe), empty
# when calm: low, swap (used swap above the lowest of the last arm_window s by arm_swap_mb) or drop
# (available under the highest of them by arm_drop_mb). A failed probe (-1) shows no sign.
arm_reason() { # now avail swap
  local now="$1" avail="$2" swap="$3" i top=-1 floor=-1 keep_t=() keep_a=() keep_s=()
  for i in "${!arm_t[@]}"; do
    [ "${arm_t[i]}" -le "$now" ] && [ $((now - arm_t[i])) -le "$arm_window" ] || continue
    keep_t+=("${arm_t[i]}") keep_a+=("${arm_a[i]}") keep_s+=("${arm_s[i]}")
    [ "${arm_a[i]}" -le "$top" ] || top=${arm_a[i]}
    [ "${arm_s[i]}" -lt 0 ] || { [ "$floor" -ge 0 ] && [ "${arm_s[i]}" -ge "$floor" ]; } || floor=${arm_s[i]}
  done
  arm_t=("${keep_t[@]}" "$now") arm_a=("${keep_a[@]}" "$avail") arm_s=("${keep_s[@]}" "$swap")
  danger=""
  if [ "$avail" -ge 0 ] && [ "$avail" -lt "$arm_avail_mb" ]; then
    danger=low
  elif [ "$swap" -ge 0 ] && [ "$floor" -ge 0 ] && [ $((swap - floor)) -ge "$arm_swap_mb" ]; then
    danger=swap
  elif [ "$avail" -ge 0 ] && [ "$top" -ge 0 ] && [ $((top - avail)) -ge "$arm_drop_mb" ]; then
    danger=drop
  fi
}

# Arms on a sign (an ARMED line), stays armed arm_hold s past the last one, then a CALM line. A
# backwards clock jump that leaves the hold further away than arm_hold ends it.
arm_tick() { # now avail swap
  arm_reason "$@"
  if [ -n "$danger" ]; then
    [ "$armed_until" -gt 0 ] || append "ARMED $1 reason=$danger avail_mb=$2 swap_used_mb=$3"
    armed_until=$(($1 + arm_hold))
  elif [ "$armed_until" -gt 0 ] && { [ "$1" -ge "$armed_until" ] || [ $((armed_until - $1)) -gt "$arm_hold" ]; }; then
    armed_until=0
    append "CALM $1 avail_mb=$2 swap_used_mb=$3"
  fi
}

# Away from the Mac (presence.lua's presence/away, rewritten within 180 s; read here, since nothing memlogd runs lives
# on /Volumes/Work): a calm full tick only feeds what he would look at (the Chats app's load bars and rows, the menu),
# so none runs; pressure and armed ticks run as ever (Egor 2026-11-12: «если это не защита… можно пересмотреть»).
away_now() { # now
  local since='' written=''
  { IFS=$'\t' read -r since written < "${MEMLOGD_PRESENCE_DIR:-$HOME/.cache/speed-doctor/presence}/away"; } 2>/dev/null || return 1
  [[ $written =~ ^[0-9]+$ ]] && [ $(($1 - written)) -le 180 ]
}

# Due once per wall-clock slot of `every` s (0: every tick); a backwards clock jump is due at once.
full_due() { # now every
  [ "$2" -le 0 ] || [ -z "$full_at" ] || [ "$1" -lt "$full_at" ] || [ $(($1 / $2)) -ne $((full_at / $2)) ]
}

rotate() {
  local cutoff file base live="" gone=0 kills=0 incidents=0 n
  rotate_files "$@"
  [ "$gone" -eq 0 ] || limit_hit memlogd.retention "$retention_days" count expire \
    "$gone memlogd day logs/frames older than $cutoff deleted, holding $kills KILLED and $incidents INCIDENT lines" \
    'bin/memlogd:retention_days="${'
}

rotate_files() {
  [ -z "$episode_frames" ] || live=${episode_frames##*/}
  cutoff=$(date -v-"${retention_days}"d +%F 2>/dev/null) || return 0
  [ -n "$cutoff" ] || return 0
  for file in "$log_dir"/????-??-??.log; do
    [ -f "$file" ] || continue
    base=${file##*/}
    base=${base%.log}
    [[ "$base" < "$cutoff" ]] || continue
    n=$(grep -c 'KILLED' "$file" 2>/dev/null) && kills=$((kills + n))
    n=$(grep -c '^INCIDENT' "$file" 2>/dev/null) && incidents=$((incidents + n))
    rm -f "$file" && gone=$((gone + 1))
  done
  for file in "$log_dir"/machine/????-??-??.log; do
    [ -f "$file" ] || continue
    base=${file##*/}
    [[ "${base%.log}" < "$cutoff" ]] || continue
    rm -f "$file" && gone=$((gone + 1))
  done
  for file in "$frames"/*.log "$frames"/*.log.gz; do
    [ -f "$file" ] || continue
    base=${file##*/}
    # Retention reads the day out of the name, and an incident older than the window is still
    # writing into its file: deleting it drops the frames of the freeze in progress.
    [ "$base" != "$live" ] || continue
    base=${base#jump-}
    base=${base%%T*}
    [[ "$base" < "$cutoff" ]] || continue
    rm -f "$file" && gone=$((gone + 1))
  done
}

acquire_lock() {
  local holder holder_boot attempt stale=0
  if ! mkdir "$lock_dir" 2>/dev/null; then
    # A lock whose pid is not written yet belongs to a daemon still starting, never to a crash:
    # taking it over on an empty holder is how two daemons end up sampling the same file.
    for attempt in 1 2; do
      holder="" holder_boot=""
      read -r holder holder_boot 2>/dev/null <"$lock_dir/pid" || true
      [ -z "$holder" ] || break
      [ "$attempt" = 2 ] || sleep 0.5
    done
    if [ -z "$holder" ]; then
      printf 'memlogd: lock at %s is held with no pid written; not taking it over\n' "$lock_dir" >&2
      exit 3
    fi
    # A pid left by an earlier boot (a forced reboot skips the EXIT trap) names whatever process
    # holds that number now, often this very daemon.
    [ "$holder" != "$$" ] || stale=1
    [ "$boot_id" = -1 ] || [ -z "$holder_boot" ] || [ "$holder_boot" = -1 ] || \
      [ "$holder_boot" = "$boot_id" ] || stale=1
    if [ "$stale" = 0 ] && kill -0 "$holder" 2>/dev/null; then
      printf 'memlogd: already running (pid %s)\n' "$holder" >&2
      exit 3
    fi
    rm -rf "$lock_dir"
    mkdir "$lock_dir" 2>/dev/null || {
      printf 'memlogd: cannot take the lock at %s\n' "$lock_dir" >&2
      exit 3
    }
  fi
  printf '%s %s\n' "$$" "$boot_id" >"$lock_dir/pid"
  trap 'rm -rf "$lock_dir"' EXIT
  trap 'exit 129' HUP INT TERM
}

# Sets now and day off bash's own clock, no fork a probe; MEMLOGD_CLOCK names a date(1) to ask instead
# (the tests' fake days and epochs), and bash 3.2, which has no %()T, asks date.
clock() {
  if [ -z "${MEMLOGD_CLOCK:-}" ] && printf -v now '%(%s)T' -1 2>/dev/null && printf -v day '%(%F)T' "$now" 2>/dev/null; then
    return 0
  fi
  now=$("${MEMLOGD_CLOCK:-date}" +%s)
  day=$("${MEMLOGD_CLOCK:-date}" +%F)
}

run_loop() {
  local today day now avail measure swap room counts node_count node_rss stamp jump_file vm_text
  local state=quiet recover_since=0 ticks=0 interval full
  node_count=-1 node_rss=-1
  enable -f "${BASH%/bin/*}/lib/bash/sleep" sleep 2>/dev/null || :
  mkdir -p "$log_dir" || return 1
  boot_facts
  acquire_lock
  today=$(date +%F)
  rotate
  current_file=$(log_path "$today")
  while :; do
    clock
    if [ "$day" != "$today" ]; then
      today=$day
      mkdir -p "$log_dir"
      rotate
      current_file=$(log_path "$today")
      if [ "$state" = incident ]; then
        append "INCIDENT $now continued=1"
        flush
      fi
    fi
    vm_text=$(vm_stat 2>/dev/null) || vm_text=""
    swap_probe
    read -r avail measure <<<"$(available_mb "$vm_text" "$room")"
    arm_tick "$now" "$avail" "$swap"
    # Before the state machine, and independent of it: the guard answers to its own two thresholds,
    # not to whether this tick opened an incident, so a change to the incident window cannot quietly
    # move when the machine defends itself. Its 2048 MB lies under pressure(), so every tick it could
    # fire on is a full one.
    full=0
    if [ "$state" = incident ] || pressure "$avail"; then
      full=1
    elif [ "$armed_until" -gt 0 ]; then
      ! full_due "$now" "$armed_full_interval" || full=1
    elif ! away_now "$now"; then
      ! full_due "$now" "$full_interval" || full=1
    fi
    if [ "$full" = 1 ]; then
      full_at=$now
      counts=$(node_stats)
      node_count=${counts% *}
      node_rss=${counts#* }
      chat_load_tick "$now" "$avail" "$swap" "$room" "$measure"
    fi

    if [ "$state" = quiet ] && pressure "$avail"; then
      state=incident
      recover_since=0
      episode_start=$now
      last_frame_at=""
      stamp=$(frames_stamp "$now")
      [ -d "$frames" ] || mkdir -p "$frames"
      episode_frames="$frames/$stamp.log"
      episode_capped=0
      append "INCIDENT $now avail_mb=$avail swap_used_mb=$swap frames=$stamp.log"
      flush
    fi

    if [ "$state" = incident ]; then
      append "$now incident avail_mb=$avail swap_used_mb=$swap node_count=$node_count node_rss_mb=$node_rss"
      flush
      # A slow-phase episode would otherwise grow without bound, and its own eviction would burn
      # every older episode to make room. Capped, it keeps the summary lines and stops writing.
      if [ "$episode_capped" = 0 ] && \
         [ "$(file_bytes "$episode_frames")" -ge $((max_episode_mb * 1048576)) ]; then
        episode_capped=1
        limit_hit memlogd.episode-cap "$((max_episode_mb * 1048576))" bytes trim "every later frame of incident ${episode_frames##*/}: summary lines only" \
          'bin/memlogd:max_episode_mb="${' "$(file_bytes "$episode_frames")"
        append "EPISODE-CAP $now frames=${episode_frames##*/}"
        flush
      fi
      if [ "$episode_capped" = 0 ] && want_frame; then
        write_frame "$episode_frames" incident "$now" "$avail" "$swap" "$node_count" "$node_rss"
        last_frame_at=$now
      fi
      if recovered "$avail"; then
        [ "$recover_since" -ne 0 ] || recover_since=$now
        # A backwards clock jump would otherwise hold the incident open forever.
        [ "$now" -ge "$recover_since" ] || recover_since=$now
        if [ $((now - recover_since)) -ge "$recover_seconds" ]; then
          state=quiet
          recover_since=0
          # ps dumps shrink ~6x: uncompressed, 10 episodes a day filled the frames cap in 2 of the 3 retention days.
          [ ! -f "$episode_frames" ] || gzip -q -- "$episode_frames" 2>/dev/null || :
          episode_frames=""
          episode_start=0
          episode_capped=0
          last_frame_at=""
          append "RECOVERED $now avail_mb=$avail swap_used_mb=$swap"
          flush
        fi
      else
        recover_since=0
      fi
      interval=$incident_interval
    elif [ "$full" = 0 ]; then
      append "$now probe avail_mb=$avail swap_used_mb=$swap"
      interval=$quiet_interval
      [ "$armed_until" -eq 0 ] || interval=$armed_interval
    else
      append "$now quiet avail_mb=$avail swap_used_mb=$swap node_count=$node_count node_rss_mb=$node_rss"
      # A failed probe on either side is unknown, the same rule pressure() applies: a -1 tick must
      # not read as an 8-node, gigabyte-wide rise once the next healthy tick lands. The previous
      # full tick is the baseline, a minute back while calm.
      if [ -n "$prev_node_count" ] && [ "$node_count" -ge 0 ] && [ "$node_rss" -ge 0 ] && \
         [ "$prev_node_count" -ge 0 ] && [ "$prev_node_rss" -ge 0 ]; then
        if [ $((node_count - prev_node_count)) -ge "$jump_nodes" ] || \
           [ $((node_rss - prev_node_rss)) -ge "$jump_rss_mb" ]; then
          stamp=$(frames_stamp "$now")
          jump_file="$frames/jump-$stamp.log"
          [ -d "$frames" ] || mkdir -p "$frames"
          append "JUMP $now node_count=$node_count node_rss_mb=$node_rss frames=jump-$stamp.log"
          flush
          write_frame "$jump_file" jump "$now" "$avail" "$swap" "$node_count" "$node_rss"
        fi
      fi
      interval=$quiet_interval
      [ "$armed_until" -eq 0 ] || interval=$armed_interval
    fi
    if [ "$full" = 1 ]; then
      prev_node_count=$node_count
      prev_node_rss=$node_rss
    fi
    machine_tick "$now" "$swap" "$vm_text" "$room"

    ticks=$((ticks + 1))
    if [ "$max_ticks" -gt 0 ] && [ "$ticks" -ge "$max_ticks" ]; then break; fi
    sleep "$interval"
  done
}

install_agent() {
  local plist_source="$repo_root/launchd/$label.plist" deployed_tmp source
  if [ ! -f "$plist_source" ]; then
    printf 'memlogd: no plist at %s — run install-agent from the repo checkout\n' "$plist_source" >&2
    return 1
  fi
  mkdir -p "$(dirname "$wrapper")" "$(dirname "$agent_plist")"
  deployed_tmp=$(mktemp "${wrapper}.tmp.XXXXXX") || return 1
  cat "$script_path" >"$deployed_tmp"
  chmod 755 "$deployed_tmp"
  mv -f "$deployed_tmp" "$wrapper"
  for source in bin/chat-load share/chat_names.py share/machine_probe.py share/limit_hit.py bin/report-bus share/report_frame.py share/store-lock.sh share/limiter-hold.sh share/limit-hit.sh; do
    deployed_tmp=$(mktemp "${wrapper}.tmp.XXXXXX") || return 1
    cat "$repo_root/$source" >"$deployed_tmp" || return 1
    chmod 755 "$deployed_tmp"
    mv -f "$deployed_tmp" "$(dirname "$wrapper")/${source##*/}"
  done
  cp "$plist_source" "$agent_plist"
  launchctl bootout "gui/$UID" "$agent_plist" >/dev/null 2>&1 || true
  if ! launchctl bootstrap "gui/$UID" "$agent_plist"; then
    launchctl load -w "$agent_plist" || {
      printf 'memlogd: launchctl could not load %s\n' "$agent_plist" >&2
      return 1
    }
  fi
  printf 'Installed %s from %s; logs under %s.\n' "$label" "$wrapper" "$log_dir"
}

uninstall_agent() {
  launchctl bootout "gui/$UID" "$agent_plist" >/dev/null 2>&1 || \
    launchctl unload -w "$agent_plist" >/dev/null 2>&1 || true
  rm -f "$agent_plist"
  if [ -f "$wrapper" ] && grep -qF "label=$label" "$wrapper"; then
    (cd "$(dirname "$wrapper")" && rm -f "$wrapper" chat-load chat_names.py machine_probe.py limit_hit.py report-bus report_frame.py \
      store-lock.sh limiter-hold.sh limit-hit.sh)
  fi
  printf 'Uninstalled %s.\n' "$label"
}

usage() {
  printf 'usage: memlogd [run|install-agent|uninstall-agent]\n' >&2
  exit 2
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  case "${1:-run}" in
    run) [ "$#" -le 1 ] || usage; run_loop ;;
    install-agent) [ "$#" -eq 1 ] || usage; install_agent ;;
    uninstall-agent) [ "$#" -eq 1 ] || usage; uninstall_agent ;;
    *) usage ;;
  esac
fi
case $0 in "${BASH_SOURCE[0]}") exit; esac; }

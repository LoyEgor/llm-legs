#!/usr/bin/env bash
# Source of truth; `memlogd install-agent` deploys a copy to ~/.local/libexec/memlogd, which is
# what launchd runs. The copy is not a convenience: a LaunchAgent that execs off /Volumes/Work
# gets EPERM from TCC unless that exact program path was granted, and a memory logger must also
# keep running while that volume is unmounted. Re-run install-agent after editing this file.
# Besides logging, this daemon ACTS: the memory guard below SIGKILLs the descendants of the fattest
# registered agent process tree when the machine is nearly out of RAM, sparing that tree's root
# (`docs/memory-guard.md` is the decision record).
set -u

resolve_script() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")" && printf '%s/%s\n' "$PWD" "$(basename "$source")"
}

script_path=$(resolve_script)
repo_root=$(cd "$(dirname "$script_path")/.." && pwd)

log_dir="${MEMLOGD_DIR:-$HOME/Library/Logs/memlogd}"
quiet_interval="${MEMLOGD_QUIET_INTERVAL:-15}"
incident_interval="${MEMLOGD_INCIDENT_INTERVAL:-1}"
enter_avail_mb="${MEMLOGD_ENTER_AVAIL_MB:-4096}"
exit_avail_mb="${MEMLOGD_EXIT_AVAIL_MB:-5120}"
recover_seconds="${MEMLOGD_RECOVER_SECONDS:-60}"
retention_days="${MEMLOGD_RETENTION_DAYS:-3}"
max_frames_mb="${MEMLOGD_MAX_FRAMES_MB:-1024}"
max_episode_mb="${MEMLOGD_MAX_EPISODE_MB:-256}"
fast_seconds="${MEMLOGD_FAST_SECONDS:-180}"
slow_interval="${MEMLOGD_SLOW_INTERVAL:-30}"
jump_nodes="${MEMLOGD_JUMP_NODES:-8}"
jump_rss_mb="${MEMLOGD_JUMP_RSS_MB:-1024}"
max_ticks="${MEMLOGD_MAX_TICKS:-0}"
sync_writes="${MEMLOGD_SYNC:-1}"

# The memory guard's whole rule, and deliberately not a knob: a threshold an operator can turn down
# under pressure is a guard that stops firing exactly when it is needed. Both halves must hold —
# 3072 MB is below where the machine still swaps its way out, 1536 MB is above every healthy agent
# tree measured here, so neither number alone can convict.
memguard_avail_mb=3072
memguard_tree_mb=1536
# The two registries, read through the seams their own writers already use rather than seams of the
# guard's own: worker-run's run dirs and review-bench's bench/pool run dirs.
worker_runs_dir="${WORKER_RUN_DIR:-$HOME/.cache/claude-worker-runs}"
bench_runs_root="${WORKER_STATS_DIR:-${CLAUDEB_DIR:-$HOME/.claude-profiles/.claudeb}/worker-stats}"

label=com.egor.memlogd
agent_plist="$HOME/Library/LaunchAgents/$label.plist"
wrapper="$HOME/.local/libexec/memlogd"
lock_dir="$log_dir/memlogd.lock"
current_file=""
episode_frames=""
episode_start=0
last_frame_at=""
prev_node_count=""
prev_node_rss=""
episode_capped=0

# -1 is "the probe failed", and every threshold test rejects it: a vm_stat that returns nothing
# must not read as zero bytes available and fake an incident.
available_mb() {
  vm_stat 2>/dev/null | awk '
    NR == 1 { for (i = 1; i <= NF; i++) if ($i == "of") page = $(i + 1) + 0 }
    /^Pages free:/ { free = $3 + 0; seen = 1 }
    /^Pages inactive:/ { inactive = $3 + 0 }
    /^Pages speculative:/ { speculative = $3 + 0 }
    END {
      if (!seen) { print "-1"; exit }
      if (page <= 0) page = 4096
      printf "%d\n", (free + inactive + speculative) * page / 1048576
    }'
}

swap_used_mb() {
  sysctl -n vm.swapusage 2>/dev/null | awk '
    { for (i = 1; i <= NF; i++) if ($i == "used") { value = $(i + 2); seen = 1; break } }
    END {
      if (!seen) { print "-1"; exit }
      unit = substr(value, length(value), 1)
      number = value + 0
      if (unit == "G") number *= 1024
      else if (unit == "K") number /= 1024
      printf "%d\n", number
    }'
}

# A ps that failed or said nothing is unknown, not zero node processes: the jump test compares this
# tick against the previous one, so a zero here fakes a multi-GB rise on the next healthy tick.
node_stats() {
  local snapshot
  snapshot=$(ps -axo rss=,comm= 2>/dev/null) || snapshot=""
  if [ -z "$snapshot" ]; then
    printf '%s\n' '-1 -1'
    return 0
  fi
  printf '%s\n' "$snapshot" | awk '
    {
      rss = $1
      $1 = ""
      sub(/^ +/, "", $0)
      name = $0
      sub(/.*\//, "", name)
      if (name == "node") { count++; total += rss }
    }
    END { printf "%d %d\n", count + 0, (total + 0) / 1024 }'
}

# Every registration currently on disk, one `pid agent_id run_dir` row each, from both writers:
# worker-run's meta.json, review-bench's pid- file per launched cell. A run carrying an exit_code is
# over whatever its metadata still says, and a pid nobody is running any more drops out later,
# against the process table.
#
# cli_pid is the VENDOR CLI, and it is what a worker run registers when it has one: the kill takes
# the root's descendants, so rooted at the supervisor instead the agent dies with the hog and comes
# back as a bare exit 137. Rooted at the CLI, the agent survives its command's death and can say so.
# .pid — the supervisor — answers for runs launched before cli_pid existed.
#
# Every registration is a CLAIM about a number, and nothing on disk retires it: a supervisor killed
# before it wrote exit_code leaves its pids registered until the 7-day prune, and macOS hands the
# same numbers out again within the day. So each root must PROVE it is the process that registered —
# see memguard_verified. Unproven is SKIPPED, because a kill aimed at an unverified identity is a
# kill aimed at a stranger's children.
memguard_registry() { # now
  local now="$1" meta directory pid stamp file table
  table=$(ps -axo pid=,etime= 2>/dev/null) || table=''
  [ -n "$table" ] || return 0
  for meta in "$worker_runs_dir"/*/meta.json; do
    [ -f "$meta" ] || continue
    directory=${meta%/meta.json}
    [ ! -e "$directory/exit_code" ] || continue
    # `"pid":` and not `pid`: the same object carries pid_started_at, and a looser match reads the
    # launch instant as a process id and aims the guard at whatever now holds that number. The
    # space after the colon is jq's own output shape, which is how these files are written.
    pid=$(grep -o '"cli_pid": *[0-9][0-9]*' "$meta" 2>/dev/null | head -n1 | tr -dc '0-9')
    if [ -n "$pid" ]; then
      stamp=$(grep -o '"cli_pid_started_at": *[0-9][0-9]*' "$meta" 2>/dev/null | head -n1 | tr -dc '0-9')
    else
      pid=$(grep -o '"pid": *[0-9][0-9]*' "$meta" 2>/dev/null | head -n1 | tr -dc '0-9')
      stamp=$(grep -o '"pid_started_at": *[0-9][0-9]*' "$meta" 2>/dev/null | head -n1 | tr -dc '0-9')
    fi
    [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null || continue
    memguard_verified "$table" "$now" "$pid" "$stamp" || continue
    printf '%s %s %s\n' "$pid" "${directory##*/}" "$directory"
  done
  for file in "$bench_runs_root"/benches/*/pid-* "$bench_runs_root"/pool-runs/*/pid-*; do
    [ -f "$file" ] || continue
    directory=${file%/*}
    pid=$(head -n1 "$file" 2>/dev/null | tr -dc '0-9')
    [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null || continue
    # A cell file carries no stamp of its own; it is written right after Popen, so its mtime IS the
    # launch instant, and it is removed when the cell ends.
    stamp=$(stat -f %m "$file" 2>/dev/null | tr -dc '0-9')
    memguard_verified "$table" "$now" "$pid" "$stamp" || continue
    printf '%s %s %s\n' "$pid" "${directory##*/}/${file##*/pid-}" "$directory"
  done
}

# Whether the process wearing a registered number is the one that was registered: its start —
# now minus the elapsed time ps reports — within memguard_pid_slack of the instant its writer
# stamped. Answered against one table for the whole registry, since a ps per candidate at incident
# cadence costs more than the guard saves. A number the table does not hold, an etime in a shape
# this cannot read, a missing stamp: all false. worker-run judges its own runs' pids by the same
# comparison (`supervisor_running`, PID_START_SLACK).
memguard_pid_slack=60
memguard_verified() { # table now pid stamp
  case "$4" in '' | *[!0-9]*) return 1 ;; esac
  printf '%s\n' "$1" | awk -v want="$3" -v now="$2" -v stamp="$4" -v slack="$memguard_pid_slack" '
    ($1 + 0) == want {
      count = split($2, part, /[-:]/)
      seconds = -1
      if (count == 2) seconds = part[1] * 60 + part[2]
      else if (count == 3) seconds = part[1] * 3600 + part[2] * 60 + part[3]
      else if (count == 4) seconds = part[1] * 86400 + part[2] * 3600 + part[3] * 60 + part[4]
      if (seconds >= 0) {
        drift = (now - seconds) - stamp
        if (drift < 0) drift = -drift
        if (drift <= slack) ok = 1
      }
      exit
    }
    END { exit ok ? 0 : 1 }'
}

# `root total_rss_mb descendant_pid...` per registered root, out of ONE process table: a ps per
# candidate at incident cadence costs more than the guard saves. Ancestry is walked upward under a
# hop cap, so a table that somehow cycles cannot spin here, and a root the table no longer holds is
# a stale registration and yields no row at all.
memguard_trees() { # root...
  local roots="$*"
  ps -axo pid=,ppid=,rss=,state= 2>/dev/null | awk -v roots="$roots" '
    # A zombie is already dead and weighs nothing, but `kill` still SUCCEEDS on it: counted as a
    # descendant it would be "killed" again on every tick, and a root that has stopped reaping would
    # produce a KILLED line a second, forever. It stays in the ancestry (its own children reparent
    # through it) and out of both the weight and the kill list.
    { pid = $1 + 0; parent[pid] = $2 + 0; kb[pid] = $3 + 0; live[pid] = 1; dead[pid] = ($4 ~ /^Z/) }
    END {
      count = split(roots, list, " ")
      for (i = 1; i <= count; i++) root[list[i] + 0] = 1
      for (p in live) {
        node = p
        for (hop = 0; hop <= 64; hop++) {
          if (node in root) {
            # The root itself is deliberately not weighed: only DESCENDANTS are ever killed, so a
            # tree fat at the root alone would be convicted for memory the kill cannot free and its
            # small children would be SIGKILLed every tick for nothing.
            if (!dead[p] && node != p) {
              total[node] += kb[p]
              kids[node] = kids[node] " " p
            }
            break
          }
          if (node <= 1 || !(node in parent) || parent[node] == node) break
          node = parent[node]
        }
      }
      for (i = 1; i <= count; i++) {
        r = list[i] + 0
        if (!(r in live) || done[r]++) continue
        printf "%d %d%s\n", r, int(total[r] / 1024), kids[r]
      }
    }'
}

# The one rule: system available RAM under the floor AND the fattest registered agent tree over the
# ceiling, and that tree's DESCENDANTS are SIGKILLed. The ROOT is spared on purpose — it is the
# launcher that owns the run directory, writes the exit code and reports the kill, so killing it
# would end the run with no record of why its work stopped, which is the case this guard exists to
# make legible. A failed availability probe is unknown rather than zero, the same rule pressure()
# applies. Nothing is said when nothing died: a fat root with no descendants leaves the guard no
# move, and a KILLED line for it would be a kill that never happened.
memguard_tick() { # now avail
  local now="$1" avail="$2" registry roots trees best root rss kids line agent directory pid killed=''
  [ "$avail" -ge 0 ] && [ "$avail" -lt "$memguard_avail_mb" ] || return 0
  registry=$(memguard_registry "$now")
  [ -n "$registry" ] || return 0
  roots=$(printf '%s\n' "$registry" | awk '{ print $1 }' | sort -un)
  trees=$(memguard_trees $roots)
  [ -n "$trees" ] || return 0
  # Only a tree with a live descendant is a candidate, because only descendants are killed: pick the
  # fattest tree first and a childless root wins every tick while nothing is ever cut. NF > 2 is
  # "this row listed at least one descendant".
  best=$(printf '%s\n' "$trees" | awk 'NF > 2' | sort -k2,2nr -k1,1n | head -n1)
  [ -n "$best" ] || return 0
  root=${best%% *}
  rss=$(printf '%s\n' "$best" | awk '{ print $2 }')
  kids=$(printf '%s\n' "$best" | awk '{ $1 = ""; $2 = ""; sub(/^ +/, ""); print }')
  [ "$rss" -gt "$memguard_tree_mb" ] || return 0
  for pid in $kids; do
    kill -KILL "$pid" 2>/dev/null || continue
    killed="${killed:+$killed,}$pid"
  done
  [ -n "$killed" ] || return 0
  line=$(printf '%s\n' "$registry" | awk -v r="$root" '$1 == r { print; exit }')
  agent=$(printf '%s\n' "$line" | awk '{ print $2 }')
  directory=$(printf '%s\n' "$line" | cut -d' ' -f3-)
  append "KILLED $now agent=$agent avail_mb=$avail tree_rss_mb=$rss root_pid=$root killed=$killed"
  flush
  # And beside the run itself, because the day log is not what anyone reads when a worker comes
  # back wrong: `worker-run report`/`wait` surface this file, so the run states its own cause.
  [ ! -d "$directory" ] ||
    printf 'MEMGUARD %s avail_mb=%s tree_rss_mb=%s agent=%s root_pid=%s killed=%s\n' \
      "$now" "$avail" "$rss" "$agent" "$root" "$killed" >>"$directory/memguard" 2>/dev/null || :
}

log_path() { printf '%s/%s.log\n' "$log_dir" "$1"; }

frames_dir() { printf '%s/frames\n' "$log_dir"; }

frames_stamp() { date -r "$1" +%Y-%m-%dT%H%M%S; }

flush() { [ "$sync_writes" = 1 ] || return 0; sync; }

append() { printf '%s\n' "$*" >>"$current_file"; }

file_bytes() { stat -f %z "$1" 2>/dev/null || printf '0\n'; }

# One stat pass per call, oldest first: at 1 Hz under thrash a fork per file plus a rescan per
# victim costs more than the frames the cap exists to keep. A file that vanished between the glob
# and the stat drops out of the listing instead of breaking the arithmetic. The live episode (or
# jump file being written) is never a victim: a freeze in progress is exactly the evidence kept.
evict_frames() {
  local keep="${1##*/}" cap=$((max_frames_mb * 1048576)) listing total=0 mtime size name
  mkdir -p "$(frames_dir)"
  listing=$(stat -f '%m %z %N' "$(frames_dir)"/*.log 2>/dev/null | sort -n)
  while read -r mtime size name; do
    [ -n "$name" ] || continue
    total=$((total + size))
  done <<<"$listing"
  [ "$total" -gt "$cap" ] || return 0
  while read -r mtime size name; do
    [ -n "$name" ] || continue
    [ "$total" -gt "$cap" ] || break
    [ "${name##*/}" = "$keep" ] && continue
    rm -f "$name" && total=$((total - size))
  done <<<"$listing"
}

write_frame() {
  local dest="$1" kind="$2" now="$3" avail="$4" swap="$5" node_count="$6" node_rss="$7"
  mkdir -p "$(dirname "$dest")"
  evict_frames "$dest"
  {
    printf '%s %s avail_mb=%s swap_used_mb=%s node_count=%s node_rss_mb=%s\n' \
      "$now" "$kind" "$avail" "$swap" "$node_count" "$node_rss"
    printf 'PS-BEGIN %s\n' "$now"
    ps -axo pid,ppid,pgid,rss,etime,command 2>/dev/null
    printf 'PS-END %s\n' "$now"
  } >>"$dest"
  flush
}

want_frame() {
  [ -z "$last_frame_at" ] && return 0
  [ $((now - episode_start)) -lt "$fast_seconds" ] && return 0
  [ $((now - last_frame_at)) -ge "$slow_interval" ]
}

# Swap is reported but decides nothing: macOS holds swap allocated for hours after the pressure
# that caused it is gone, and a swap term here once latched the 1 Hz dumps for 14 hours and 8 GB.
pressure() { [ "$1" -ge 0 ] && [ "$1" -lt "$enter_avail_mb" ]; }

# A failed probe is unknown, not pressure — the same rule pressure() applies, so a vm_stat that
# breaks mid-incident cannot latch the dumps forever.
recovered() { [ "$1" -lt 0 ] || [ "$1" -ge "$exit_avail_mb" ]; }

rotate() {
  local cutoff file base live=""
  [ -z "$episode_frames" ] || live=${episode_frames##*/}
  cutoff=$(date -v-"${retention_days}"d +%F 2>/dev/null) || return 0
  [ -n "$cutoff" ] || return 0
  for file in "$log_dir"/????-??-??.log; do
    [ -f "$file" ] || continue
    base=${file##*/}
    base=${base%.log}
    [[ "$base" < "$cutoff" ]] || continue
    rm -f "$file"
  done
  for file in "$(frames_dir)"/*.log; do
    [ -f "$file" ] || continue
    base=${file##*/}
    # Retention reads the day out of the name, and an incident older than the window is still
    # writing into its file: deleting it drops the frames of the freeze in progress.
    [ "$base" != "$live" ] || continue
    base=${base#jump-}
    base=${base%%T*}
    [[ "$base" < "$cutoff" ]] || continue
    rm -f "$file"
  done
}

acquire_lock() {
  local holder attempt
  if ! mkdir "$lock_dir" 2>/dev/null; then
    # A lock whose pid is not written yet belongs to a daemon still starting, never to a crash:
    # taking it over on an empty holder is how two daemons end up sampling the same file.
    for attempt in 1 2; do
      holder=$(cat "$lock_dir/pid" 2>/dev/null || true)
      [ -z "$holder" ] || break
      [ "$attempt" = 2 ] || sleep 0.5
    done
    if [ -z "$holder" ]; then
      printf 'memlogd: lock at %s is held with no pid written; not taking it over\n' "$lock_dir" >&2
      exit 3
    fi
    if kill -0 "$holder" 2>/dev/null; then
      printf 'memlogd: already running (pid %s)\n' "$holder" >&2
      exit 3
    fi
    rm -rf "$lock_dir"
    mkdir "$lock_dir" 2>/dev/null || {
      printf 'memlogd: cannot take the lock at %s\n' "$lock_dir" >&2
      exit 3
    }
  fi
  printf '%s\n' "$$" >"$lock_dir/pid"
  trap 'rm -rf "$lock_dir"' EXIT
  trap 'exit 129' HUP INT TERM
}

run_loop() {
  local today day now avail swap counts node_count node_rss stamp jump_file
  local state=quiet recover_since=0 ticks=0 interval
  mkdir -p "$log_dir" || return 1
  acquire_lock
  today=$(date +%F)
  rotate
  current_file=$(log_path "$today")
  while :; do
    now=$(date +%s)
    day=$(date +%F)
    if [ "$day" != "$today" ]; then
      today=$day
      mkdir -p "$log_dir"
      rotate
      current_file=$(log_path "$today")
      if [ "$state" = incident ]; then
        append "INCIDENT $now continued=1"
        flush
      fi
    fi
    avail=$(available_mb)
    swap=$(swap_used_mb)
    counts=$(node_stats)
    node_count=${counts% *}
    node_rss=${counts#* }
    # Before the state machine, and independent of it: the guard answers to its own two thresholds,
    # not to whether this tick opened an incident, so a change to the incident window cannot quietly
    # move when the machine defends itself.
    memguard_tick "$now" "$avail"

    if [ "$state" = quiet ] && pressure "$avail"; then
      state=incident
      recover_since=0
      episode_start=$now
      last_frame_at=""
      stamp=$(frames_stamp "$now")
      mkdir -p "$(frames_dir)"
      episode_frames="$(frames_dir)/$stamp.log"
      episode_capped=0
      append "INCIDENT $now avail_mb=$avail swap_used_mb=$swap frames=$stamp.log"
      flush
    fi

    if [ "$state" = incident ]; then
      append "$now incident avail_mb=$avail swap_used_mb=$swap node_count=$node_count node_rss_mb=$node_rss"
      flush
      # A slow-phase episode would otherwise grow without bound, and its own eviction would burn
      # every older episode to make room. Capped, it keeps the summary lines and stops writing.
      if [ "$episode_capped" = 0 ] && \
         [ "$(file_bytes "$episode_frames")" -ge $((max_episode_mb * 1048576)) ]; then
        episode_capped=1
        append "EPISODE-CAP $now frames=${episode_frames##*/}"
        flush
      fi
      if [ "$episode_capped" = 0 ] && want_frame; then
        write_frame "$episode_frames" incident "$now" "$avail" "$swap" "$node_count" "$node_rss"
        last_frame_at=$now
      fi
      if recovered "$avail"; then
        [ "$recover_since" -ne 0 ] || recover_since=$now
        # A backwards clock jump would otherwise hold the incident open forever.
        [ "$now" -ge "$recover_since" ] || recover_since=$now
        if [ $((now - recover_since)) -ge "$recover_seconds" ]; then
          state=quiet
          recover_since=0
          episode_frames=""
          episode_start=0
          episode_capped=0
          last_frame_at=""
          append "RECOVERED $now avail_mb=$avail swap_used_mb=$swap"
          flush
        fi
      else
        recover_since=0
      fi
      interval=$incident_interval
    else
      append "$now quiet avail_mb=$avail swap_used_mb=$swap node_count=$node_count node_rss_mb=$node_rss"
      # A failed probe on either side is unknown, the same rule pressure() applies: a -1 tick must
      # not read as an 8-node, gigabyte-wide rise once the next healthy tick lands.
      if [ -n "$prev_node_count" ] && [ "$node_count" -ge 0 ] && [ "$node_rss" -ge 0 ] && \
         [ "$prev_node_count" -ge 0 ] && [ "$prev_node_rss" -ge 0 ]; then
        if [ $((node_count - prev_node_count)) -ge "$jump_nodes" ] || \
           [ $((node_rss - prev_node_rss)) -ge "$jump_rss_mb" ]; then
          stamp=$(frames_stamp "$now")
          jump_file="$(frames_dir)/jump-$stamp.log"
          mkdir -p "$(frames_dir)"
          append "JUMP $now node_count=$node_count node_rss_mb=$node_rss frames=jump-$stamp.log"
          flush
          write_frame "$jump_file" jump "$now" "$avail" "$swap" "$node_count" "$node_rss"
        fi
      fi
      interval=$quiet_interval
    fi
    prev_node_count=$node_count
    prev_node_rss=$node_rss

    ticks=$((ticks + 1))
    if [ "$max_ticks" -gt 0 ] && [ "$ticks" -ge "$max_ticks" ]; then break; fi
    sleep "$interval"
  done
}

install_agent() {
  local plist_source="$repo_root/launchd/$label.plist" deployed_tmp
  if [ ! -f "$plist_source" ]; then
    printf 'memlogd: no plist at %s — run install-agent from the repo checkout\n' "$plist_source" >&2
    return 1
  fi
  mkdir -p "$(dirname "$wrapper")" "$(dirname "$agent_plist")"
  deployed_tmp=$(mktemp "${wrapper}.tmp.XXXXXX") || return 1
  cat "$script_path" >"$deployed_tmp"
  chmod 755 "$deployed_tmp"
  mv -f "$deployed_tmp" "$wrapper"
  cp "$plist_source" "$agent_plist"
  launchctl bootout "gui/$UID" "$agent_plist" >/dev/null 2>&1 || true
  if ! launchctl bootstrap "gui/$UID" "$agent_plist"; then
    launchctl load -w "$agent_plist"
  fi
  printf 'Installed %s from %s; logs under %s.\n' "$label" "$wrapper" "$log_dir"
}

uninstall_agent() {
  launchctl bootout "gui/$UID" "$agent_plist" >/dev/null 2>&1 || \
    launchctl unload -w "$agent_plist" >/dev/null 2>&1 || true
  rm -f "$agent_plist"
  if [ -f "$wrapper" ] && grep -qF "label=$label" "$wrapper"; then
    rm -f "$wrapper"
  fi
  printf 'Uninstalled %s.\n' "$label"
}

usage() {
  printf 'usage: memlogd [run|install-agent|uninstall-agent]\n' >&2
  exit 2
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  case "${1:-run}" in
    run) [ "$#" -le 1 ] || usage; run_loop ;;
    install-agent) [ "$#" -eq 1 ] || usage; install_agent ;;
    uninstall-agent) [ "$#" -eq 1 ] || usage; uninstall_agent ;;
    *) usage ;;
  esac
fi

#!/usr/bin/env bash
# The per-chat place journal the statusline's middle block renders: the shown tree is the tree of
# the LAST line (docs/statusline-contract.md "Shown tree"). Lines are declared by the actor that
# knows where it works; nothing here guesses.
#   statusline-place add --session <sid> --kind <kind> --path <dir-or-file>
#   statusline-place why --session <sid>
# `add` exits 0 when it wrote a line and 3 when it wrote none (an excluded or non-repository path).
set -u

cache_dir="${STATUSLINE_CACHE_DIR:-$HOME/.cache/claude-statusline}"

usage() {
  sed -n '5,6s/^#   //p' "$0" >&2
  exit 2
}

cmd=${1:-}
[ $# -gt 0 ] && shift
session="" kind="" path=""
while [ $# -gt 0 ]; do
  case "$1" in
    --session) session=${2:-}; shift 2 ;;
    --kind) kind=${2:-}; shift 2 ;;
    --path) path=${2:-}; shift 2 ;;
    *) usage ;;
  esac
done
session=${session//[^A-Za-z0-9_-]/}
[ -n "$session" ] || usage
journal="$cache_dir/place-$session"

excluded() {
  local tmp_root=${TMPDIR:-}
  tmp_root=${tmp_root%/}
  case "$1/" in
    /tmp/*|/private/tmp/*|"$HOME"/.cache/*|*/node_modules/*) return 0 ;;
  esac
  [ -n "$tmp_root" ] && case "$1/" in "$tmp_root"/*|/private"$tmp_root"/*) return 0 ;; esac
  return 1
}

add() {
  local dir out top main lines lock="$journal.lock" locked="" i
  case "$kind" in
    seed|edit|git|cd|dispatch|enter-worktree|exit-worktree|worker-start|worker-end|review-start|review-end) ;;
    *) usage ;;
  esac
  [ -n "$path" ] || usage
  dir=$path
  if [ ! -d "$path" ]; then
    # The file's own symlink first: ~/.claude/hooks/x.sh is journaled as the repository holding it.
    [ -L "$path" ] && dir=$(realpath "$path" 2>/dev/null)
    dir=$(dirname -- "${dir:-$path}")
  fi
  excluded "$dir" && return 3
  out=$(git -C "$dir" rev-parse --show-toplevel --path-format=absolute --git-common-dir 2>/dev/null) ||
    return 3
  out=$(cd "${out%%$'\n'*}" && pwd -P && cd "${out#*$'\n'}/.." && pwd -P) 2>/dev/null || return 3
  { IFS= read -r top; IFS= read -r main; } <<< "$out"
  [ -n "$top" ] && ! excluded "$top" || return 3
  [ -n "$main" ] && [ -d "$main/.git" ] || main=$top
  umask 077
  mkdir -p "$cache_dir" 2>/dev/null || return 3
  lines=$(wc -l < "$journal" 2>/dev/null) || lines=0
  # Past 350 lines every append takes the lock the trim holds, so the trim's rewrite cannot drop a
  # line appended between its read and its rename.
  if [ "$lines" -gt 350 ]; then
    for i in {1..200}; do
      mkdir "$lock" 2>/dev/null && { locked=1; break; }
      [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ] && rmdir "$lock" 2>/dev/null
      sleep 0.01
    done
  fi
  printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "$kind" "$top" "$main" >> "$journal" 2>/dev/null || {
    [ -z "$locked" ] || rmdir "$lock" 2>/dev/null
    return 3
  }
  [ -n "$locked" ] || return 0
  if [ "$(wc -l < "$journal" 2>/dev/null)" -gt 400 ]; then
    tail -n 200 "$journal" > "$journal.tmp.$$" && mv -f "$journal.tmp.$$" "$journal" ||
      rm -f "$journal.tmp.$$"
  fi 2>/dev/null
  rmdir "$lock" 2>/dev/null
  return 0
}

why() {
  local lines=() last i tree main
  [ -r "$journal" ] && while IFS= read -r i; do lines+=("$i"); done < "$journal"
  last=$((${#lines[@]} - 1))
  for ((i = last; i >= 0; i--)); do
    IFS=$'\t' read -r _ _ tree _ <<< "${lines[$i]}"
    if [ -n "$tree" ] && [ -d "$tree" ]; then
      printf 'shown: %s\nfrom line %d: %s\n' "$tree" $((i + 1)) "${lines[$i]}"
      [ "$i" = "$last" ] || printf 'fallback: the %d newer line(s) name vanished trees\n' $((last - i))
      break
    fi
  done
  if [ "$i" -lt 0 ] && [ "$last" -ge 0 ]; then
    IFS=$'\t' read -r _ _ _ main <<< "${lines[$last]}"
    if [ -n "$main" ] && [ -d "$main" ]; then
      printf 'shown: %s\nfrom line %d: %s\n' "$main" $((last + 1)) "${lines[$last]}"
      printf 'fallback: no line names a live tree; the last line'"'"'s main checkout is shown\n'
      i=$last
    fi
  fi
  [ "$i" -ge 0 ] || printf 'shown: the project dir (%s)\n' \
    "$([ "$last" -ge 0 ] && printf 'no journal line resolves' || printf 'no journal at %s' "$journal")"
  i=$((last > 9 ? last - 9 : 0))
  [ "$last" -ge 0 ] && printf -- '--- last lines of %s\n' "$journal" && printf '%s\n' "${lines[@]:$i}"
  return 0
}

case "$cmd" in
  add) add ;;
  why) why ;;
  *) usage ;;
esac

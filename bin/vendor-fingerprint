#!/usr/bin/env bash
{
set -u

resolve_script() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")" && printf '%s/%s\n' "$PWD" "$(basename "$source")"
}

script_path=$(resolve_script)
repo_root=$(cd "$(dirname "$script_path")/.." && pwd)
state_dir="${VENDOR_CLI_UPDATE_STATE_DIR:-$HOME/.cache/vendor-cli-update}"
fp_dir="$state_dir/fingerprints"
events_dir="$state_dir/events"
log_file="$state_dir/update.log"
codex_profiles_dir="${CODEXB_PROFILES_DIR:-$HOME/.codex-profiles}"
grok_home="${GROK_HOME:-$HOME/.grok}"
grokb_cache="${GROKB_CACHE_DIR:-$HOME/.cache/grokb}/models.json"
vendors="codex grok gemini claude"
sibling_repos="review-bench claude-setup"
# Facets that are recorded in an event but never open an integration chat on their own.
info_facets="version catalog_text catalog_order foreign_clients"
id_prefixes='gpt|grok|gemini|imagen|veo|sora|claude'
id_re="($id_prefixes)(-[a-z]+)*-[0-9]+[a-z]?(\\.[0-9]+)*(-[a-z0-9]+){0,3}"
doctor_fix="${VENDOR_FINGERPRINT_DOCTOR_FIX:-$repo_root/bin/doctor-fix}"
. "$repo_root/share/worktree.sh"
# npm puts codex and grok under nvm, which neither a LaunchAgent's PATH nor a plain shell's carries.
# Appended, so a native install earlier on PATH (~/.local/bin/claude) stays the one that runs.
while IFS= read -r nvm_bin; do PATH="$PATH:$nvm_bin"; done < <(ls -d "$HOME"/.nvm/versions/node/*/bin 2>/dev/null | sort -rV)

timeout_command() {
  if command -v gtimeout >/dev/null 2>&1; then
    command gtimeout "$@"
  elif command -v timeout >/dev/null 2>&1; then
    command timeout "$@"
  else
    perl -e 'alarm shift; exec @ARGV' "$@"
  fi
}

stamp() { date -u +%Y-%m-%dT%H:%M:%SZ; }
log() { printf '%s fingerprint %s\n' "$(stamp)" "$*" >>"$log_file"; }
version_of() { "$@" 2>/dev/null | head -n 1 | LC_ALL=C grep -oE '[0-9]+(\.[0-9]+)+' | head -n 1; }

cli_of() {
  case $1 in
    gemini) printf 'agy\n' ;;
    *) printf '%s\n' "$1" ;;
  esac
}

native_of() { # vendor -> the executable the CLI really runs, not its launcher
  local override="VENDOR_FINGERPRINT_NATIVE_$1" cli real
  if [ -n "${!override:-}" ]; then
    printf '%s\n' "${!override}"
    return 0
  fi
  cli=$(command -v "$(cli_of "$1")") || return 1
  case $1 in
    codex)
      real=$(realpath "$cli" 2>/dev/null) || return 1
      find "${real%/bin/*}" -type f -path '*/vendor/*/bin/codex' 2>/dev/null | head -n 1
      ;;
    grok) realpath "$grok_home/bin/grok" 2>/dev/null ;;
    *) realpath "$cli" 2>/dev/null ;;
  esac
}

codex_homes() { # installed-version -> homes whose model list this client fetched
  local home
  for home in "$HOME/.codex" "$codex_profiles_dir"/*; do
    [ -f "$home/models_cache.json" ] || continue
    [ "$(jq -r '.client_version // ""' "$home/models_cache.json" 2>/dev/null)" = "$1" ] && printf '%s\n' "$home"
  done
}

# Other installs of the same CLI at another version: whichever comes first on some other PATH runs
# its own, older model aliases and catalog.
put_installs() { # vendor
  local primary_version=$version
  local cli primary path real version
  cli=$(cli_of "$1")
  primary=$(realpath "$(command -v "$cli")" 2>/dev/null)
  { type -ap "$cli"; ls -d "$HOME"/.nvm/versions/node/*/bin/"$cli" 2>/dev/null; } | while IFS= read -r path; do
    real=$(realpath "$path" 2>/dev/null) || continue
    [ "$real" = "$primary" ] || [ ! -x "$path" ] && continue
    version=$(version_of timeout_command 30 "$path" --version)
    [ "$version" = "$primary_version" ] && continue
    printf '%s\t%s\n' "$path" "${version:-unknown}"
  done | LC_ALL=C sort -u | jq -R 'split("\t") | {(.[0]): .[1]}' | jq -s 'add // {}' | put installs
}

put() { jq -c --arg k "$1" '{k: $k, v: .}' >>"$work/facets.jsonl"; }
fail() { printf '%s\t%s\n' "$1" "$2" >>"$work/failed.tsv"; }

put_text() { # facet command...
  local facet=$1 out
  shift
  if ! out=$(NO_COLOR=1 TERM=dumb timeout_command 60 "$@" 2>&1 </dev/null) || [ -z "$out" ]; then
    fail "$facet" local
    return 0
  fi
  printf '%s\n' "$out" | V="$version" perl -pe 's/\e\[[0-9;]*[A-Za-z]//g; s/\Q$ENV{V}\E/<version>/g if length $ENV{V}' |
    jq -Rs . | put "$facet"
}

# Packed string tables glue an id onto the next string (gemini-3.1-pro-highparse mime type): a lowercase
# run is cut off after a digit run, or an effort word or word other ids hold as a whole component,
# unless the component it grows is one other ids hold; after another id it is cut always, since one
# neighbour glues onto many ids alike (gpt-6-lunaopenai, gpt-5.6-lunaopenai in codex 0.161); a tail of
# `openai` is cut always, the head of a model path glued on (gemini-3.7-flash-tieredopenai/gpt-oss-20b-maas
# in agy 1.3.2).
unglue() { # sorted ids -> the same ids cut off their glued neighbours
  LC_ALL=C awk '
    {
      t[NR] = $0; s[$0] = 1; delete own
      for (j = split($0, c, "-"); j > 0; j--) if (!(c[j] in own)) { own[c[j]] = 1; w[c[j]]++ }
    }
    END {
      w["low"]++; w["medium"]++; w["high"]++; w["thinking"]++
      for (n = 1; n <= NR; n++) {
        id = t[n]; cut = length(id); start = 1
        for (i = 1; i < length(id) && cut == length(id); i++) {
          if (substr(id, i, 1) == "-") { start = i + 1; continue }
          if (substr(id, i + 1, 1) !~ /[a-z]/) continue
          word = substr(id, start, i - start + 1)
          whole = substr(id, start); sub(/-.*/, "", whole)
          if ((substr(id, 1, i) in s) || substr(whole, i - start + 2) == "openai" ||
            (word ~ /^[a-z][a-z][a-z]+$/ && w[word] && w[whole] < 2) ||
            (word ~ /^[0-9]+$/ && substr(whole, length(word) + 1) ~ /^[a-z][a-z][a-z]/)) cut = i
        }
        print substr(id, 1, cut)
      }
    }' | LC_ALL=C sort -u
}

# A rule change must never read as a release, so the stored side is compared through the same rule.
reunglue() { # fingerprint file
  local ids tmp
  jq -e '.facets.ids | type == "array"' "$1" >/dev/null 2>&1 || return 0
  ids=$(jq -r '.facets.ids[]' "$1" | unglue | jq -R . | jq -s -c .) || return 0
  tmp=$(mktemp "$1.XXXXXX") || return 0
  jq --argjson ids "$ids" '.facets.ids = $ids' "$1" >"$tmp" && mv -f "$tmp" "$1" || rm -f "$tmp"
}

put_ids() { # vendor
  local native
  native=$(native_of "$1") && [ -f "$native" ] || { fail ids local; return 0; }
  # A cargo build dir is `<crate>-<16 hex>`, rehashed every build: xai-grok-memory-api-38bd164a103e0d8a
  # read as the id grok-memory-api-38b in grok 1.0.50, so the hash goes before ids are matched.
  LC_ALL=C strings -a -n 6 "$native" 2>/dev/null |
    perl -pe "s/-[0-9a-f]{16}(?=\\/)//g; s/(?<=[a-z0-9])(?=(?:$id_prefixes)-)/\\n/g" | LC_ALL=C grep -oE "$id_re" |
    LC_ALL=C sort -u |
    unglue >"$work/ids"
  # An empty dump means the binary moved or changed format, not that the vendor dropped its models.
  [ -s "$work/ids" ] || { fail ids local; return 0; }
  jq -R . "$work/ids" | jq -s . | put ids
}

put_docs() { # facet directory
  local file
  [ -d "$2" ] || { fail "$1" local; return 0; }
  find "$2" -type f ! -name '.*' 2>/dev/null | LC_ALL=C sort | while IFS= read -r file; do
    printf '%s\t%s\n' "${file#"$2"/}" "$(shasum -a 256 <"$file" | cut -c1-16)"
  done | jq -R 'split("\t") | {(.[0]): .[1]}' | jq -s 'add // {}' | put "$1"
}

codex_facets() {
  local homes=() home key text
  put_text 'help: codex --help' codex --help
  put_text 'help: codex exec --help' codex exec --help
  NO_COLOR=1 timeout_command 60 codex features list 2>/dev/null </dev/null |
    awk 'NF > 1 { $NF = ""; sub(/ +$/, ""); print }' | jq -R . | jq -s . >"$work/features"
  if [ "$(jq length "$work/features" 2>/dev/null || printf 0)" -gt 0 ]; then put features <"$work/features"; else fail features local; fi
  while IFS= read -r home; do homes+=("$home"); done < <(codex_homes "$version")
  if [ "${#homes[@]}" -gt 0 ]; then
    # Accounts are served different catalogs (A/B defaults, priorities) and ~/.codex drops in and out
    # of the homes as the ChatGPT app rewrites it: a field the homes disagree on is their sorted value
    # set, so the facet never depends on which home happened to be read first.
    # A leaf in one home can be a container in another (`[]` beside `["pro"]`): the merge keeps the
    # shortest such path, or setpath indexes its per_account object with a number and jq dies.
    if jq -s 'map(.models[]?) | group_by(.slug) | map(. as $vs | {key: .[0].slug, value: (
        [$vs[] | paths((type != "object" and type != "array") or . == {} or . == [])] | unique
        | . as $all | map(. as $p | select(any($all[]; length < ($p | length) and . == $p[0:length]) | not))
        | reduce .[] as $p (null; setpath($p; [$vs[] | try getpath($p) catch null] | unique
            | if length == 1 then .[0] else {per_account: .} end)))}) | from_entries' \
      "${homes[@]/%//models_cache.json}" >"$work/catalog" 2>/dev/null && [ -s "$work/catalog" ]; then
      # Prompts ride in the catalog as long strings; they change without any capability changing.
      # priority only orders the list: every launch passes a resolved -m, so it serves nothing.
      # A per-account prompt goes whole: its emptied {per_account: []} shell vanishing when the
      # accounts converge on one text was a substantive catalog event with no diff line (0.161.0).
      jq 'delpaths([paths(type == "string" and length > 300) | if .[-2] == "per_account" then .[:-2] else . end])
        | map_values(del(.priority))' "$work/catalog" | put catalog
      jq 'map_values(.priority) | with_entries(select(.value != null))' "$work/catalog" | put catalog_order
      jq -r 'keys[]' "$work/catalog" >"$work/served"
      jq -r 'paths(type == "string" and length > 300) as $p | [($p | map(tostring) | join(".")), (getpath($p) | @base64)] | @tsv' \
        "$work/catalog" | while IFS=$'\t' read -r key text; do
        printf '%s\t%s\n' "$key" "$(printf '%s' "$text" | base64 -D 2>/dev/null | shasum -a 256 | cut -c1-16)"
      done | jq -R 'split("\t") | {(.[0]): .[1]}' | jq -s 'add // {}' | put catalog_text
    else
      fail catalog local
      fail catalog_text local
      fail catalog_order local
    fi
    put_docs docs "${homes[0]}/skills/.system"
  else
    fail catalog remote
    fail catalog_text remote
    fail catalog_order remote
    fail docs remote
  fi
  jq -r '.codex.divergence // [] | .[]' "$state_dir/state.json" 2>/dev/null >"$work/divergence"
  LC_ALL=C grep $'^catalog\t' "$work/divergence" | jq -R . | jq -s . | put divergence
  LC_ALL=C grep $'^client\t' "$work/divergence" | jq -R 'split("\t") | {(.[1]): .[2]}' | jq -s 'add // {}' | put foreign_clients
}

grok_facets() {
  put_text 'help: grok --help' grok --help
  if jq -e '.models | type == "array" and length > 0' "$grokb_cache" >/dev/null 2>&1; then
    jq '.models | map({key: .slug, value: del(.slug)}) | from_entries' "$grokb_cache" | put catalog
    jq -r '.models[].slug // empty' "$grokb_cache" >"$work/served"
  else
    fail catalog remote
  fi
  put_docs docs "$grok_home/docs"
}

gemini_facets() {
  put_text 'help: agy --help' agy --help
  if timeout_command 30 agy models </dev/null 2>/dev/null | LC_ALL=C grep -E $'^[a-z0-9][a-z0-9._-]*\t' >"$work/models"; then
    jq -R . "$work/models" | jq -s . | put catalog
    cut -f1 "$work/models" >"$work/served"
  else
    fail catalog remote
  fi
}

claude_facets() {
  local native
  put_text 'help: claude --help' claude --help
  # The binary bakes the model catalog its aliases resolve through: every served model is an entry.
  native=$(native_of claude) && [ -f "$native" ] &&
    LC_ALL=C strings -a -n 6 "$native" 2>/dev/null | LC_ALL=C grep -oE 'first_party:"[a-z0-9.-]+"' |
    sed -E 's/^first_party:"(.*)"$/\1/' >"$work/served"
  return 0
}

snapshot() { # vendor -> {vendor, version, facets, failed}
  local vendor=$1 version work
  command -v "$(cli_of "$vendor")" >/dev/null 2>&1 || return 1
  version=$(version_of timeout_command 30 "$(cli_of "$vendor")" --version)
  [ -n "$version" ] || return 1
  work=$(mktemp -d "${TMPDIR:-/tmp}/vendor-fingerprint.XXXXXX") || return 1
  : >"$work/facets.jsonl"
  : >"$work/failed.tsv"
  : >"$work/served"
  jq -n --arg v "$version" '$v' | put version
  put_installs "$vendor"
  "${vendor}_facets"
  put_ids "$vendor"
  jq -n --arg vendor "$vendor" --arg version "$version" \
    --slurpfile facets "$work/facets.jsonl" --rawfile failed "$work/failed.tsv" --rawfile served "$work/served" \
    '{vendor: $vendor, version: $version,
      served: ($served | split("\n") | map(select(length > 0)) | if length == 0 then null
               else . + map(sub("-(minimal|low|medium|high|xhigh)$"; "")) | unique end),
      facets: ($facets | map({(.k): .v}) | add // {}),
      failed: ($failed | split("\n") | map(select(length > 0) | split("\t") | {facet: .[0], where: .[1]}))}'
  rm -rf "$work"
}

render() { # facet value on stdin -> diffable lines
  jq -r 'if type == "string" then .
    elif type == "array" then .[] | (if type == "string" then . else tojson end)
    elif type == "object" then (paths((type != "object" and type != "array") or . == {} or . == []) as $p | "\($p | map(tostring) | join(".")) = \(getpath($p) | tojson)")
    else tojson end'
}

write_diff() { # previous current changed-json -> unified diff per facet
  local previous=$1 current=$2 facet
  jq -r '.[]' <<<"$3" | while IFS= read -r facet; do
    printf '### %s\n' "$facet"
    diff -u -L before -L after \
      <(jq --arg k "$facet" '.facets[$k] // empty' "$previous" | render) \
      <(jq --arg k "$facet" '.facets[$k] // empty' "$current" | render)
  done
}

event_set() { # id jq-filter args...
  local file="$events_dir/$1.json" filter=$2 tmp
  shift 2
  tmp=$(mktemp "$events_dir/event.XXXXXX") || return 1
  jq "$@" "$filter" "$file" >"$tmp" && mv -f "$tmp" "$file" || { rm -f "$tmp"; return 1; }
}

new_event() { # vendor from to status reason changed-json substantive-json -> id
  local id
  id="$1-$(date -u +%Y%m%dT%H%M%SZ)"
  while [ -e "$events_dir/$id.json" ]; do id="$id-x"; done
  jq -n --arg id "$id" --arg vendor "$1" --arg from "$2" --arg to "$3" --arg status "$4" --arg reason "$5" \
    --argjson changed "$6" --argjson substantive "$7" --arg at "$(stamp)" \
    --arg diff "$events_dir/$id.diff" --arg fingerprint "$fp_dir/$1.json" \
    '{id: $id, vendor: $vendor, created_at: $at, from: $from, to: $to, status: $status, reason: $reason,
      changed: $changed, substantive: $substantive, diff: $diff, fingerprint: $fingerprint}' >"$events_dir/$id.json"
  printf '%s\n' "$id"
}

# Codex serves accounts A/B catalog variants that roll out and back with no release. A catalog change
# in which every field only takes values some account already had (a field no account has reads as
# null) is accounts regrouping: logged, never a chat. A new model, field or value still opens one.
catalog_regrouped() { # previous current
  jq -e -s '
    def leaves: [paths((type != "object" and type != "array") or . == {} or . == []
                       or (type == "object" and has("per_account")))
                 | select(any(.[]; . == "per_account") | not)];
    def vals($k): (try getpath($k) catch null) | if type == "object" and has("per_account") then .per_account else [.] end;
    def unordered: map_values(if type == "object" then del(.priority) else . end);
    (.[0].facets.catalog // {} | unordered) as $p | (.[1].facets.catalog // {}) as $c
    | (($p | leaves) + ($c | leaves) | unique)
    | all(.[]; . as $k | (($c | vals($k)) - ($p | vals($k))) == [])' "$1" "$2" >/dev/null
}

# Strings in a binary hold ids nothing serves (claude-haiku-3-55, gemini-3.7-flash-tiered): an id
# counts only when the served catalog lists it, or when no served model shares its family, so a family no
# catalog covers (gpt-image, grok-imagine) is still news.
ids_unserved() { # previous current -> true when every added or removed id is one the catalog should list and does not
  jq -e -s 'def stem: split("-") | (map(test("^[0-9]")) | index(true)) as $i | if $i == null then . else .[:$i] end | join("-");
    (.[1].served | type == "array") and (
      ((.[0].served // []) + .[1].served) as $s | ($s | map(stem)) as $st
      | (.[0].facets.ids // []) as $p | (.[1].facets.ids // []) as $c
      | all(($c - $p)[], ($p - $c)[]; . as $id | (any($s[]; . == $id) | not) and any($st[]; . == ($id | stem))))' "$1" "$2" >/dev/null
}

changes() { # vendor previous current -> changed-json<TAB>substantive-json
  local changed substantive
  changed=$(jq -s -c '.[0].facets as $p | .[1].facets as $c
    | [(($p | keys) + ($c | keys) | unique)[] | select(($p[.] // null) != ($c[.] // null))]' "$2" "$3")
  substantive=$(jq -c --arg info "$info_facets" '($info | split(" ")) as $i | map(select(. as $f | $i | index($f) | not))' <<<"$changed")
  if jq -e 'index("ids")' <<<"$substantive" >/dev/null && ids_unserved "$2" "$3"; then
    substantive=$(jq -c 'map(select(. != "ids"))' <<<"$substantive")
  fi
  if [ "$1" = codex ] && jq -e 'index("catalog")' <<<"$substantive" >/dev/null && catalog_regrouped "$2" "$3"; then
    substantive=$(jq -c 'map(select(. != "catalog"))' <<<"$substantive")
  fi
  # Only a newly lagging install is news; one catching up to the primary, still lagging, or ahead of it
  # is not — the npm claude moves to npm's latest before the native one does, and the primary's own
  # version event follows when it gets there.
  if jq -e 'index("installs")' <<<"$substantive" >/dev/null &&
    jq -e -s 'def ver: if test("^[0-9]+(\\.[0-9]+)*$") then split(".") | map(tonumber) else null end;
      (.[0].facets.installs // {} | keys) as $p | (.[1].facets.version // "" | ver) as $primary
      | [.[1].facets.installs // {} | to_entries[] | select(.key as $k | $p | any(. == $k) | not)
         | select((.value | ver) as $v | $v == null or $primary == null or $v < $primary)] == []' "$2" "$3" >/dev/null; then
    substantive=$(jq -c 'map(select(. != "installs"))' <<<"$substantive")
  fi
  printf '%s\t%s\n' "$changed" "$substantive"
}

pending_event() { # vendor -> its open event still waiting for a chat, which keeps the fingerprint it started from
  local base
  for base in "$events_dir/$1"-*.base; do
    [ -f "$base" ] && jq -e '.status == "open" and .launched_at == null' "${base%.base}.json" >/dev/null 2>&1 &&
      { basename "${base%.base}"; return 0; }
  done
  return 0
}

check_vendor() { # vendor
  local vendor=$1 previous="$fp_dir/$1.json" current changed substantive status id
  current=$(mktemp "$fp_dir/current.XXXXXX") || return 0
  if ! snapshot "$vendor" >"$current.raw"; then
    rm -f "$current" "$current.raw"
    return 0
  fi
  id=$(pending_event "$vendor")
  reunglue "$previous"
  [ -z "$id" ] || reunglue "$events_dir/$id.base"
  # A facet the probe could not read keeps its last value: a network blip is not a release. A local
  # probe that broke is itself news, so it is also named in probe_failures.
  jq -s --arg t "$(stamp)" '(.[0] // {facets: {}}) as $p | .[1] as $s
    | ($s.facets
       + ($s.failed | map(.facet as $f | select($p.facets | has($f)) | {($f): $p.facets[$f]}) | add // {})
       + {foreign_clients: (($p.facets.foreign_clients // {}) + ($s.facets.foreign_clients // {}))}
       + {probe_failures: ($s.failed | map(select(.where == "local") | .facet) | unique)}) as $facets
    | {vendor: $s.vendor, version: $s.version, checked_at: $t, facets: $facets,
       served: (if $s.served != null then $s.served elif any($s.failed[]; .facet == "catalog") then $p.served else null end),
       remote_failures: ($s.failed | map(select(.where == "remote") | .facet) | unique)}' \
    <({ [ -s "$previous" ] && cat "$previous" || printf 'null\n'; }) "$current.raw" >"$current"
  rm -f "$current.raw"
  if [ ! -s "$previous" ]; then
    mv -f "$current" "$previous"
    log "$vendor baseline $(jq -r .version "$previous")"
    return 0
  fi
  IFS=$'\t' read -r changed substantive < <(changes "$vendor" "$previous" "$current")
  if [ "$changed" = '[]' ]; then
    mv -f "$current" "$previous"
    return 0
  fi
  # An event waits for Egor's request; a change meanwhile joins it and is re-judged against the
  # fingerprint from before the event, so a flap that has reverted by then closes it unseen.
  if [ -n "$id" ]; then
    IFS=$'\t' read -r changed substantive < <(changes "$vendor" "$events_dir/$id.base" "$current")
    write_diff "$events_dir/$id.base" "$current" "$changed" >"$events_dir/$id.diff"
    if [ "$substantive" = '[]' ]; then
      status=auto-closed
      rm -f "$events_dir/$id.base"
    else
      status=open
    fi
    event_set "$id" '.status = $s | .to = $to | .changed = $c | .substantive = $sub
      | if $s == "open" then . else .note = "only informational changes were left before its chat" end' \
      --arg s "$status" --arg to "$(jq -r .version "$current")" --argjson c "$changed" --argjson sub "$substantive"
    mv -f "$current" "$previous"
    log "$vendor event $id $status, joined: $(jq -r 'join(", ")' <<<"$changed")"
    return 0
  fi
  if [ "$substantive" = '[]' ]; then status=auto-closed; else status=open; fi
  id=$(new_event "$vendor" "$(jq -r .version "$previous")" "$(jq -r .version "$current")" "$status" \
    "$([ "$status" = open ] && printf 'fingerprint changed' || printf 'only informational facets changed')" \
    "$changed" "$substantive")
  write_diff "$previous" "$current" "$changed" >"$events_dir/$id.diff"
  [ "$status" != open ] || cp "$previous" "$events_dir/$id.base"
  mv -f "$current" "$previous"
  log "$vendor event $id $status: $(jq -r 'join(", ")' <<<"$changed")"
}

requested() { # vendor -> its open events Egor asked for that no run has taken yet
  local file
  for file in "$events_dir/$1"-*.json; do
    [ -f "$file" ] && jq -e '.status == "open" and .launched_at == null
      and (.requested_at != null or (.reason // "" | startswith("manual request")))' "$file" >/dev/null 2>&1 && basename "$file" .json
  done
  return 0
}

# Chats open only on Egor's request. A request whose chat failed to open is his own ask, so the next
# check retries it.
launch_pending() {
  # A manual update opens its own chat for every vendor right after this check.
  [ -z "${VENDOR_FINGERPRINT_HOLD:-}" ] || return 0
  day_launch >/dev/null
  return 0
}

day_launch() { # -> the requested events' runs, then one orchestrator chat dispatching them
  local lines file run opened event
  lines=$(mktemp "$events_dir/.lines.XXXXXX") || return 1
  vendor_runs '' >"$lines"
  [ -s "$lines" ] || { rm -f "$lines"; return 0; }
  file="$events_dir/$(head -n 1 "$lines" | cut -f1)"
  mv -f "$lines" "$file.lines" || { rm -f "$lines"; return 1; }
  if ! opened=$(DOCTOR_FIX_OPENER="${VENDOR_FINGERPRINT_OPENER:-open -a Terminal}" \
    DOCTOR_FIX_WORKER_PICK="${VENDOR_FINGERPRINT_WORKER_PICK:-$repo_root/bin/worker-pick}" \
    "$doctor_fix" orchestrate "$file.lines" 2>&1 >/dev/null); then
    while IFS=$'\t' read -r run _; do
      for event in "$events_dir"/*.json; do
        jq -e --arg r "$run" '.run == $r' "$event" >/dev/null 2>&1 &&
          event_set "$(basename "$event" .json)" '.launched_at = null | .launched = null | .run = null'
      done
    done <"$file.lines"
    log "could not open the orchestrator chat for $(cut -f1 "$file.lines" | paste -sd ' ' -): $opened; retried next run if requested"
    return 1
  fi
  log "opened the orchestrator chat for $(cut -f1 "$file.lines" | paste -sd ' ' -)"
  cat "$file.lines"
}

check() { # [--here] [vendor...]
  local vendor file here=false wait=0
  mkdir -p "$fp_dir" "$events_dir"
  if [ -z "${VENDOR_FINGERPRINT_LOCKED:-}" ]; then
    [ "${1:-}" != --here ] || wait=${VENDOR_FINGERPRINT_LOCK_WAIT:-600}
    exec env VENDOR_FINGERPRINT_LOCKED=1 lockf -k -t "$wait" "$fp_dir/check.lock" "$script_path" check "$@"
  fi
  [ "${1:-}" = --here ] && { here=true; shift; }
  for vendor in ${*:-$vendors}; do check_vendor "$vendor"; done
  $here || { launch_pending; return 0; }
  for file in "$events_dir"/*.json; do
    [ -f "$file" ] || continue
    jq -e --arg v " ${*:-$vendors} " '.status == "open" and .launched_at == null and (.vendor as $x | $v | contains(" \($x) "))' \
      "$file" >/dev/null 2>&1 || continue
    event_set "$(jq -r .id "$file")" '.launched_at = $t | .launched = "here"' --arg t "$(stamp)"
    rm -f "${file%.json}.base"
  done
  return 0
}

manual_event() { # vendor note... -> id
  local vendor=$1 version id fingerprint="$fp_dir/$1.json"
  shift
  version=$(version_of timeout_command 30 "$(cli_of "$vendor")" --version)
  id=$(new_event "$vendor" "${version:-unknown}" "${version:-unknown}" open "manual request${*:+: $*}" '[]' '[]')
  if [ ! -s "$fingerprint" ]; then
    fingerprint="$events_dir/$id.fingerprint"
    snapshot "$vendor" >"$fingerprint"
    event_set "$id" '.fingerprint = $f' --arg f "$fingerprint"
  fi
  # The whole current fingerprint is its diff, so close gates the full checklist line by line.
  {
    printf 'manual request: integrate every capability of %s %s against the manifests and surfaces\n' "$vendor" "${version:-unknown}"
    write_diff /dev/null "$fingerprint" "$(jq -c --arg info "$info_facets probe_failures" \
      '($info | split(" ")) as $i | .facets // {} | keys | map(select(. as $f | $i | index($f) | not))' "$fingerprint" 2>/dev/null ||
      printf '[]')"
  } >"$events_dir/$id.diff"
  log "$vendor event $id open: manual request"
  printf '%s\n' "$id"
}

waiting() { # [vendor] -> the open events no chat has taken yet
  local file
  for file in "$events_dir/${1:+$1-}"*.json; do
    [ -f "$file" ] && jq -e '.status == "open" and .launched_at == null' "$file" >/dev/null 2>&1 && basename "$file" .json
  done
  return 0
}

cheap_events() { # id... -> true when every event changed only help text or bundled docs, Sonnet's to integrate
  local id
  for id in "$@"; do
    jq -e '(.reason // "" | startswith("manual request") | not) and (.changed | length > 0)
      and all(.substantive[]; startswith("help: ") or . == "docs")' "$events_dir/$id.json" >/dev/null 2>&1 || return 1
  done
}

vendor_brief() { # top night-or-empty branch worktree id... -> the brief a headless worker runs, after its ROUND: and ADD-DIR: lines
  local top=$1 night=$2 branch=$3 worktree=$4 id vendor
  shift 4
  vendor=$(jq -r .vendor "$events_dir/$1.json")
  printf '%sVendor release events of %s:\n' "${night:+Night run $night: }" "$vendor"
  for id in "$@"; do
    printf -- '- %s (%s): `bin/vendor-fingerprint show %s`, its diff %s\n' "$id" \
      "$(jq -r '"\(.from) -> \(.to), changed: \(if .substantive == [] then .reason else (.substantive | join(", ")) end)"' "$events_dir/$id.json")" \
      "$id" "$events_dir/$id.diff"
  done
  cat <<EOF

Working directory: $worktree, the llm-legs worktree on branch $branch.
Never write a main checkout.

Read $top/docs/vendor-release.md in full and follow it${night:+ with its §6 Night rules}, per event in turn:
- The other repositories you may change have their worktrees on the same branch: the \`ADD-DIR:\`
  lines above. A repository with none is not yours: its change is a handoff.
- Commit on that branch in every worktree you changed. Never push, merge or rebase.
- \`bin/vendor-fingerprint check --here $vendor\` runs in this worktree, then
  \`bin/vendor-fingerprint close <id> --decisions <file> <note>\`.
- A generation, or any step that needs Egor's word, is decided \`blocked\` with evidence starting
  \`blocked-on-egor:\` and naming what his word unlocks. Never wait for him.
- Research (step 3) is yours, from primary sources; the blind cross-check (step 4) is the
  orchestrator's, never a missing or blocked item of yours.
- Look at the older blocks around what you touch, not only at what you add: is a workaround there
  obsolete now, because the vendor does it natively or its reason is gone? Then remove it.

Report in English, under 300 words, outcome first: each event closed or not; the branch and commit
hash per repository; every blocked-on-egor line; the suites run with PASS counts.
EOF
  ! cheap_events "$@" || printf '\nYou run on Sonnet: on a new served model, a tool schema or flag change, a conflict in logic or a
failure whose cause is unclear, stop editing, write what you found and end with `ESCALATE: <reason>`.\n'
}

# A night takes per vendor its one real waiting release (never a manual request), branched from
# refs/night/<night>/base; a day takes every event Egor requested, branched from main.
vendor_runs() { # night-or-empty -> per vendor its fixer run, brief and worktree: <run>\t<brief>\t<worktree>
  local night=$1 top common vendor id ids branch worktree brief run repo repos record_args siblings failed=0
  [ -z "$night" ] || [[ $night =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || usage
  common=$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=''
  if [ "$(basename "$common")" = .git ]; then top=$(dirname "$common"); else top=$repo_root; fi
  for vendor in $vendors; do
    ids=()
    if [ -n "$night" ]; then
      id=$(pending_event "$vendor")
      [ -z "$id" ] || ids=("$id")
    else
      while IFS= read -r id; do ids+=("$id"); done < <(requested "$vendor")
    fi
    [ ${#ids[@]} -gt 0 ] || continue
    if [ -n "$night" ]; then branch="night/$night/$vendor"; else branch="vendor/${ids[0]}"; fi
    brief="$events_dir/${ids[0]}.brief.md"
    siblings=() record_args=()
    if worktree=$(worktree_new "$top" "$branch"); then
      repos=()
      for repo in $sibling_repos; do [ ! -d "${top%/*}/$repo" ] || repos+=("${top%/*}/$repo"); done
      while IFS= read -r repo; do siblings+=("$repo") record_args+=(--worktree "$repo"); done < <(
        worktree_siblings "$branch" ${repos[@]+"${repos[@]}"})
    fi
    if [ -z "$worktree" ] || ! { printf 'ROUND: none\n'
      ! cheap_events "${ids[@]}" || printf 'MODEL: sonnet\n'
      for repo in ${siblings[@]+"${siblings[@]}"}; do printf 'ADD-DIR: %s\n' "$repo"; done
      vendor_brief "$top" "$night" "$branch" "$worktree" "${ids[@]}"; } >"$brief"; then
      log "${night:+night $night: }no worktree or brief for ${ids[*]}, it keeps waiting"
      printf 'vendor-fingerprint: %sno worktree or brief for %s\n' "${night:+night $night: }" "${ids[*]}" >&2
      failed=1
      continue
    fi
    if ! run=$("$doctor_fix" record updater ${night:+--night "$night"} --branch "$branch" --worktree "$worktree" \
      ${record_args[@]+"${record_args[@]}"} --problems "${ids[@]}" 2>/dev/null) || [ -z "$run" ]; then
      log "${night:+night $night: }no fixer run recorded for ${ids[*]}, it keeps waiting"
      printf 'vendor-fingerprint: %sno fixer run recorded for %s\n' "${night:+night $night: }" "${ids[*]}" >&2
      failed=1
      continue
    fi
    for id in "${ids[@]}"; do
      event_set "$id" '.launched_at = $t | .launched = (if $n == "" then "day" else "night" end) | .night = (if $n == "" then null else $n end)
        | .worktree = $w | .brief = $b | .run = $r' \
        --arg t "$(stamp)" --arg n "$night" --arg w "$worktree" --arg b "$brief" --arg r "$run" || break
      rm -f "${events_dir:?}/$id.base"
    done
    if [ "$(jq -r .run "$events_dir/$id.json" 2>/dev/null)" != "$run" ]; then
      "$doctor_fix" abandon "$run" --reason "event $id not written" >/dev/null 2>&1
      log "${night:+night $night: }event $id not written, run $run abandoned, it keeps waiting"
      printf 'vendor-fingerprint: %sevent %s not written\n' "${night:+night $night: }" "$id" >&2
      failed=1
      continue
    fi
    log "${night:+night $night: }${ids[*]} to $worktree (run $run)"
    printf '%s\t%s\t%s\n' "$run" "$brief" "$worktree"
  done
  return "$failed"
}

request() { # [--here] vendor|--all [note...] | --night <night-id>
  local here=false vendor id ids=()
  [ "${1:-}" != --night ] || [ -n "${2:-}" ] || usage
  mkdir -p "$fp_dir" "$events_dir"
  # Unlocked, a check's launch_pending sees requested_at before launched_at and opens a second chat.
  [ -n "${VENDOR_FINGERPRINT_LOCKED:-}" ] || exec env VENDOR_FINGERPRINT_LOCKED=1 \
    lockf -k -t "${VENDOR_FINGERPRINT_LOCK_WAIT:-600}" "$fp_dir/check.lock" "$script_path" request "$@"
  if [ "${1:-}" = --night ]; then
    vendor_runs "$2"
    return
  fi
  [ "${1:-}" = --here ] && { here=true; shift; }
  vendor=${1:-}
  [ -n "$vendor" ] || usage
  shift
  if [ "$vendor" = --all ]; then
    # A waiting event already carries its vendor's pass.
    for vendor in $vendors; do [ -n "$(waiting "$vendor")" ] || manual_event "$vendor" "$@" >/dev/null; done
    while IFS= read -r id; do ids+=("$id"); done < <(waiting)
  else
    case " $vendors " in *" $vendor "*) ;; *) printf 'vendor-fingerprint: unknown vendor %s\n' "$vendor" >&2; exit 2 ;; esac
    while IFS= read -r id; do ids+=("$id"); done < <(waiting "$vendor")
    [ ${#ids[@]} -gt 0 ] || ids=("$(manual_event "$vendor" "$@")")
  fi
  printf '%s\n' "${ids[@]}"
  if $here; then
    for id in "${ids[@]}"; do event_set "$id" '.launched_at = $t | .launched = "here"' --arg t "$(stamp)"; rm -f "$events_dir/$id.base"; done
  else
    for id in "${ids[@]}"; do event_set "$id" '.requested_at //= $t' --arg t "$(stamp)"; done
    day_launch >/dev/null
  fi
  return 0
}

# The completeness gate: every changed line of an event's diff carries a decision row
# `facet<TAB>line<TAB>integrated|not-applicable|blocked<TAB>purpose<TAB>evidence`; a line ending in *
# covers every line it prefixes.
DECISION_ROWS='facet<TAB>line<TAB>integrated|not-applicable|blocked<TAB>purpose<TAB>evidence, purpose a repo@hash or a file stating why the surface exists, a line ending in * covers its prefix'
undecided() { # id decisions-file -> the diff lines no row covers
  awk -F'\t' '
    FILENAME == ARGV[1] {
      if (NF >= 5 && $3 ~ /^(integrated|not-applicable|blocked)$/ && $5 != "") { facets[++n] = $1; lines[n] = $2 }
      next
    }
    /^### / { facet = substr($0, 5); next }
    $0 == "--- before" || $0 == "+++ after" { next }
    /^[+-]/ {
      covered = 0
      for (i = 1; i <= n && !covered; i++) {
        if (facets[i] != facet) continue
        if (lines[i] == $0) covered = 1
        else if (substr(lines[i], length(lines[i])) == "*" && index($0, substr(lines[i], 1, length(lines[i]) - 1)) == 1) covered = 1
      }
      if (!covered) print facet "\t" $0
    }' "$2" "$events_dir/$1.diff"
}

# doctor-fix owns the purpose rule and is asked, never copied, so both close gates agree. A diff line
# names no component, so the rule reduces to resolving, the worktree this runs in included.
unresolved_purposes() { # decisions-file -> one line per decision row whose purpose resolves nowhere
  local record row purpose
  "$doctor_fix" help 2>/dev/null | grep -q 'doctor-fix touches ' ||
    { printf '%s has no touches verb to judge purposes with\n' "$doctor_fix"; return 0; }
  record=$(mktemp "${TMPDIR:-/tmp}/vendor-fingerprint-purpose.XXXXXX") ||
    { printf 'no record to judge purposes with under %s\n' "${TMPDIR:-/tmp}"; return 0; }
  jq -n --arg w "$repo_root" '{doctor: "updater", problems: [], worktrees: [$w]}' >"$record" ||
    { rm -f "${record:?}"; printf 'no record to judge purposes with at %s\n' "$record"; return 0; }
  while IFS=$'\t' read -r row purpose; do
    "$doctor_fix" touches "$record" "row $row" "$purpose" </dev/null >/dev/null 2>&1 ||
      printf "row %s: purpose '%s' resolves to no commit (repo@hash) and no file\n" "$row" "$purpose"
  done < <(awk -F'\t' 'NF >= 5 && $3 ~ /^(integrated|not-applicable|blocked)$/ { print NR "\t" $4 }' "$1")
  rm -f "${record:?}"
}

close_event() { # id [--decisions file] note...
  local id=$1 decisions=/dev/null missing
  shift
  if [ "${1:-}" = --decisions ]; then
    decisions=${2:-}
    shift 2 || usage
  fi
  [ -f "$events_dir/$id.json" ] || { printf 'vendor-fingerprint: no event %s\n' "$id" >&2; exit 1; }
  [ -r "$decisions" ] || { printf 'vendor-fingerprint: cannot read %s\n' "$decisions" >&2; exit 1; }
  missing=$(undecided "$id" "$decisions")
  if [ -n "$missing" ]; then
    printf 'vendor-fingerprint: %s changed line(s) of %s have no decision; rows are %s:\n' \
      "$(printf '%s\n' "$missing" | wc -l | tr -d ' ')" "$id" "$DECISION_ROWS" >&2
    printf '%s\n' "$missing" | head -n 20 >&2
    exit 1
  fi
  missing=$(unresolved_purposes "$decisions")
  if [ -n "$missing" ]; then
    printf 'vendor-fingerprint: %s stays open; rows are %s:\n%s\n' "$id" "$DECISION_ROWS" "$missing" >&2
    exit 1
  fi
  event_set "$id" '.status = "closed" | .closed_at = $t | .note = $n | .decisions = $d' --arg t "$(stamp)" --arg n "$*" \
    --argjson d "$(jq -R 'split("\t") | select(length >= 5)
      | {facet: .[0], line: .[1], decision: .[2], purpose: .[3], evidence: .[4]}' "$decisions" | jq -s .)"
  rm -f "$events_dir/$id.base"
  log "event $id closed: $*"
  close_run "$(jq -r '.run // ""' "$events_dir/$id.json")"
}

close_run() { # run -> closed once none of its events is still open
  local run=$1 events decisions
  [ -n "$run" ] || return 0
  events=$(jq -s -c --arg r "$run" 'map(select(type == "object" and .run == $r))' "$events_dir"/*.json 2>/dev/null) ||
    return 0
  jq -e 'length == 0 or any(.[]; .status == "open")' <<<"$events" >/dev/null && return 0
  decisions=$(mktemp "${TMPDIR:-/tmp}/vendor-fingerprint-decisions.XXXXXX") ||
    { log "could not close fixer run $run: no temporary file"; return 0; }
  jq 'map((.decisions // []) as $d | ($d | map(.decision)) as $v | {id,
      purpose: ($d | map(.purpose // empty) | unique | if length > 0 then join(" ") else null end),
      verdict: (if $d == [] then .status elif any($v[]; . == "blocked") then "blocked"
                elif any($v[]; . == "integrated") then "integrated" else "not-applicable" end),
      evidence: "\($d | length) decision rows: \(["integrated", "not-applicable", "blocked"] | map(. as $k | "\($v | map(select(. == $k)) | length) \($k)") | join(", ")) · \(.note // "")"})' \
    <<<"$events" >"$decisions"
  "$doctor_fix" record-close "$run" --decisions "$decisions" \
    "$(jq -r 'map("\(.id): \(.note // .status)") | join("; ")' <<<"$events")" >/dev/null 2>&1 ||
    log "could not close fixer run $run"
  rm -f "${decisions:?}"
}

list_events() { # [--all]
  local file
  for file in "$events_dir"/*.json; do
    [ -f "$file" ] || continue
    if [ "${1:-}" = --all ]; then jq -e . "$file" >/dev/null 2>&1; else jq -e '.status == "open"' "$file" >/dev/null 2>&1; fi || continue
    jq -r '[.id, .status, "\(.from) -> \(.to)", (.substantive | join(",")), (if .launched_at then "chat opened" else "no chat" end)] | @tsv' "$file"
  done
  return 0
}

show_event() { # id
  [ -f "$events_dir/$1.json" ] || { printf 'vendor-fingerprint: no event %s\n' "$1" >&2; exit 1; }
  jq . "$events_dir/$1.json"
}

usage() {
  printf 'usage: vendor-fingerprint check [--here] [vendor...] | snapshot <vendor> | events [--all] | show <id> | close <id> [--decisions <file>] <note> | request [--here] <vendor>|--all [note] | request --night <night-id>\n' >&2
  exit 2
}

case "${1:-}" in
  check) shift; check "$@" ;;
  snapshot) [ -n "${2:-}" ] || usage; snapshot "$2" ;;
  events) list_events "${2:-}" ;;
  show) [ -n "${2:-}" ] || usage; show_event "$2" ;;
  close) [ -n "${2:-}" ] || usage; close_event "${@:2}" ;;
  request) [ -n "${2:-}" ] || usage; request "${@:2}" ;;
  *) usage ;;
esac
exit; }

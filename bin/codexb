#!/usr/bin/env bash
set -euo pipefail

profiles_dir="$HOME/.codex-profiles"
shared_items=(config.toml AGENTS.md skills plugins rules)

resolve_root() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}

quota_helper="${CODEXB_QUOTA_CMD:-$(resolve_root)/codex-quota.py}"

account_names() {
  local path
  printf 'main\n'
  if [ -d "$profiles_dir" ]; then
    for path in "$profiles_dir"/*; do
      [ -d "$path" ] && basename "$path"
    done | LC_ALL=C sort
  fi
}

account_home() {
  if [ "$1" = main ]; then
    printf '%s\n' ''
  else
    printf '%s\n' "$profiles_dir/$1"
  fi
}

reserved_name() {
  case "$1" in
    .*|*/*|help|add|remove|list|status|pick|profile|p|run|login) return 0 ;;
    *) return 1 ;;
  esac
}

ensure_profile() {
  local directory="$1" item
  for item in "${shared_items[@]}"; do
    if [ -e "$HOME/.codex/$item" ] && [ ! -e "$directory/$item" ] && [ ! -L "$directory/$item" ]; then
      ln -s "$HOME/.codex/$item" "$directory/$item"
    fi
  done
}

ensure_profiles() {
  local name
  while IFS= read -r name; do
    [ "$name" = main ] || ensure_profile "$profiles_dir/$name"
  done < <(account_names)
}

login_status() {
  local name="$1" home output rc
  home=$(account_home "$name")
  rc=0
  if [ "$name" = main ]; then
    output=$(env -u CODEX_HOME codex login status 2>&1) || rc=$?
  else
    output=$(env CODEX_HOME="$home" codex login status 2>&1) || rc=$?
  fi
  output=$(printf '%s' "$output" | tr '\n\r\t' '   ' | awk '{$1=$1; print}')
  [ -n "$output" ] || output="login status unavailable"
  printf '%s\t%s\n' "$rc" "$output"
}

authenticated() {
  local status
  status=$(login_status "$1")
  [ "${status%%$'\t'*}" -eq 0 ]
}

format_reset_time() {
  local epoch="$1" now delta weekday
  local -a weekdays=(Sun Mon Tue Wed Thu Fri Sat)
  if ! [ "$epoch" -gt 0 ] 2>/dev/null; then printf 'unknown'; return; fi
  now=$(date +%s)
  delta=$((epoch - now))
  if [ "$delta" -lt 86400 ]; then
    date -r "$epoch" '+%H:%M' 2>/dev/null || date -d "@$epoch" '+%H:%M' 2>/dev/null || printf 'unknown'
  elif [ "$delta" -lt 604800 ]; then
    weekday=$(date -r "$epoch" '+%w' 2>/dev/null || date -d "@$epoch" '+%w' 2>/dev/null) || { printf 'unknown'; return; }
    printf '%s ' "${weekdays[$weekday]}"
    date -r "$epoch" '+%H:%M' 2>/dev/null || date -d "@$epoch" '+%H:%M' 2>/dev/null || printf 'unknown'
  else
    date -r "$epoch" '+%m-%d %H:%M' 2>/dev/null || date -d "@$epoch" '+%m-%d %H:%M' 2>/dev/null || printf 'unknown'
  fi
}

quota_snapshot() {
  local output
  if [ ! -x "$quota_helper" ]; then
    printf '{"accounts":[]}\n'
    return
  fi
  output=$(CODEX_QUOTA_TIMEOUT="${CODEXB_QUOTA_TIMEOUT:-5}" "$quota_helper" --all-accounts 2>/dev/null) || true
  if jq -e '.accounts | type == "array"' >/dev/null 2>&1 <<<"$output"; then
    printf '%s\n' "$output"
  else
    printf '{"accounts":[]}\n'
  fi
}

add_account() {
  local name="${1:-}" directory status
  if [ -z "$name" ] || ! [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || [ "$name" = main ] || reserved_name "$name"; then
    printf 'usage: codexb add <name> (must start with a lowercase letter or number; use only lowercase letters, numbers, and hyphens; not reserved words or "main")\n' >&2
    exit 2
  fi
  directory="$profiles_dir/$name"
  if [ -e "$directory" ] || [ -L "$directory" ]; then
    printf 'codexb: account already exists: %s\n' "$name" >&2
    exit 2
  fi
  mkdir -p "$directory"
  ensure_profile "$directory"
  printf 'CODEX_HOME=~/.codex-profiles/%s codex login\n' "$name"
  printf 'CODEX_HOME=~/.codex-profiles/%s codex login --device-auth\n' "$name"
  status=$(login_status "$name")
  printf '%s: %s\n' "$name" "${status#*$'\t'}"
}

remove_account() {
  local name="${1:-}" directory codex_cache tmp
  if [ -z "$name" ] || [ "$name" = main ]; then
    printf 'usage: codexb remove <name> (not "main")\n' >&2
    exit 2
  fi
  directory="$profiles_dir/$name"
  if [ ! -e "$directory" ] && [ ! -L "$directory" ]; then
    printf 'codexb: unknown account: %s\n' "$name" >&2
    exit 2
  fi
  rm -rf "$directory"
  codex_cache="${LLM_LIMITS_CODEX_CACHE:-$HOME/.llm-limits-codex.json}"
  if [ -r "$codex_cache" ]; then
    tmp="$codex_cache.tmp.$$"
    if jq -c --arg name "$name" '
        if type == "object" then
          (if (.accounts | type) == "array"
           then .accounts |= map(select(.account != $name)) else . end)
          | (if .current == $name then .current = "main" else . end)
        else . end' "$codex_cache" > "$tmp" 2>/dev/null; then
      mv "$tmp" "$codex_cache"
    else
      rm -f "$tmp"
    fi
  fi
  printf 'codexb: removed %s\n' "$name"
}

list_accounts() {
  local name status
  while IFS= read -r name; do
    status=$(login_status "$name")
    printf '%s: %s\n' "$name" "${status#*$'\t'}"
  done < <(account_names)
}

show_status() {
  local quotas name status entry hused wused hreset wreset
  quotas=$(quota_snapshot)
  while IFS= read -r name; do
    status=$(login_status "$name")
    entry=$(jq -c --arg account "$name" '[.accounts[] | select(.account == $account)][0] // {}' <<<"$quotas")
    hused=$(jq -r 'if (.five_hour.used_pct | type) == "number" then (.five_hour.used_pct | round | tostring) + "%" else "-" end' <<<"$entry")
    wused=$(jq -r 'if (.weekly.used_pct | type) == "number" then (.weekly.used_pct | round | tostring) + "%" else "-" end' <<<"$entry")
    hreset=$(format_reset_time "$(jq -r '.five_hour.resets_at // 0' <<<"$entry")")
    wreset=$(format_reset_time "$(jq -r '.weekly.resets_at // 0' <<<"$entry")")
    printf '%s: %s | 5H %s reset %s | WEEKLY %s reset %s\n' "$name" "${status#*$'\t'}" "$hused" "$hreset" "$wused" "$wreset"
  done < <(account_names)
}

pick_account() {
  local quotas now name selected
  quotas=$(quota_snapshot)
  now=$(date +%s)
  selected=''
  while IFS= read -r name; do
    authenticated "$name" || continue
    selected=$(jq -r --arg account "$name" --argjson now "$now" '
      def effective($bucket):
        if ($bucket.used_pct | type) != "number" then null
        elif ($bucket.resets_at | type) == "number" and $bucket.resets_at <= $now then 0
        else $bucket.used_pct
        end;
      [.accounts[] | select(.account == $account) |
       . as $entry |
       [effective(.five_hour), effective(.weekly)] | map(select(. != null)) as $known |
       select(($known | length) == 0 or ($known | max) < 100) |
       {account:$entry.account,main_last:(if $entry.account == "main" then 1 else 0 end),
        unknown:(if ($known | length) == 0 then 1 else 0 end),
        pressure:(if ($known | length) == 0 then 0 else ($known | max) end)}] | .[0] // empty |
      [.account, .main_last, .unknown, .pressure] | @tsv
    ' <<<"$quotas")
    [ -z "$selected" ] || printf '%s\n' "$selected"
  done < <(account_names) |
    LC_ALL=C sort -t $'\t' -k2,2n -k3,3n -k4,4n -k1,1 |
    awk -F '\t' 'NR == 1 {print $1}'
}

run_account() {
  local allow_create="$1" name="${2:-}" directory
  if [ "$allow_create" = true ] && { [ "$name" = -h ] || [ "$name" = --help ]; }; then
    show_help
    return
  fi
  if [ -z "$name" ]; then
    printf 'usage: codexb profile <name> [codex args...]\n' >&2
    exit 2
  fi
  if ! [[ "$name" =~ ^[a-z0-9-]+$ ]]; then
    printf "codexb: invalid profile name '%s' (must start with a lowercase letter or number; use only lowercase letters, numbers, and hyphens)\n" "$name" >&2
    exit 2
  fi
  shift 2
  if [ "$name" = main ]; then
    exec env -u CODEX_HOME codex "$@"
  fi
  directory="$profiles_dir/$name"
  if [ ! -d "$directory" ]; then
    # Only explicit entry verbs create; the bare `<name> exec` path must still
    # reject an unknown account rather than mkdir a typo into existence.
    if [ "$allow_create" != true ]; then
      printf 'codexb: unknown account: %s\n' "$name" >&2
      exit 2
    fi
    if reserved_name "$name"; then
      printf "codexb: invalid profile name '%s'\n" "$name" >&2
      exit 2
    fi
    if ! [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
      printf "codexb: invalid profile name '%s' (must start with a lowercase letter or number; use only lowercase letters, numbers, and hyphens)\n" "$name" >&2
      exit 2
    fi
    mkdir -p "$directory"
    printf "codexb: new profile '%s' created at %s — Codex will ask you to log in once.\n" "$name" "$directory" >&2
  fi
  ensure_profile "$directory"
  exec env CODEX_HOME="$directory" codex "$@"
}

show_help() {
  printf '%s\n' \
    'codexb profile <name> [codex args...]  Open an isolated profile; creates it if missing (Codex asks you to log in once). Aliases: p, run.' \
    'codexb profile <name> login --device-auth   Log in with a device code (menu Codex login uses this).' \
    'codexb <name> exec [args...]' \
    'codexb add <name>                      Create a profile without launching; prints the login command.' \
    'codexb remove <name>                   Forget a profile and prune its cached quota.' \
    'codexb list                            List profiles with login state.' \
    'codexb status                          Per-account login state and quota.' \
    'codexb pick                            Print the highest-priority usable account.'
}

ensure_profiles
if [ "${2:-}" = exec ] && [ "${1:-}" != main ] \
   && [[ "${1:-}" =~ ^[a-z0-9-]+$ ]] \
   && [ -d "$profiles_dir/${1:-}" ]; then
  name="$1"
  shift 2
  run_account false "$name" exec "$@"
fi
case "${1:-}" in
  add)
    shift
    [ "$#" -eq 1 ] || { printf 'usage: codexb add <name>\n' >&2; exit 2; }
    add_account "$1"
    ;;
  remove)
    shift
    [ "$#" -eq 1 ] || { printf 'usage: codexb remove <name>\n' >&2; exit 2; }
    remove_account "$1"
    ;;
  list)
    [ "$#" -eq 1 ] || { printf 'usage: codexb list\n' >&2; exit 2; }
    list_accounts
    ;;
  status)
    [ "$#" -eq 1 ] || { printf 'usage: codexb status\n' >&2; exit 2; }
    show_status
    ;;
  pick)
    [ "$#" -eq 1 ] || { printf 'usage: codexb pick\n' >&2; exit 2; }
    selection=$(pick_account)
    printf '%s\n' "${selection:-main}"
    ;;
  profile|p|run)
    shift
    run_account true "$@"
    ;;
  help|-h|--help|'')
    show_help
    ;;
  *)
    name="$1"
    if [ "${2:-}" != exec ]; then
      printf 'usage: codexb <name> exec [args...]\n' >&2
      exit 2
    fi
    shift 2
    run_account false "$name" exec "$@"
    ;;
esac

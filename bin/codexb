#!/usr/bin/env bash
set -euo pipefail

profiles_dir="${CODEXB_PROFILES_DIR:-$HOME/.codex-profiles}"
shared_items=(config.toml AGENTS.md skills plugins rules)

resolve_root() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}

codexb_root=$(resolve_root)
. "$codexb_root/share/codex-accounts.sh"
. "$codexb_root/share/worker-pool.sh"
. "$codexb_root/share/worker-model.sh"
. "$codexb_root/share/account-announce.sh"
. "$codexb_root/share/limits-view.sh"
. "$codexb_root/share/account-status-tui.sh"
pool_dir=$(worker_pool_dir codex)

is_disabled() { worker_pool_is_disabled "$pool_dir" "$1"; }
set_disabled() { worker_pool_set_disabled "$pool_dir" "$1" "$2"; }
pool_suffix() { if is_disabled "$1"; then printf ' (out of pool)'; fi; }

quota_helper="${CODEXB_QUOTA_CMD:-$codexb_root/codex-quota.py}"
codex_cache="${LLM_LIMITS_CODEX_CACHE:-$HOME/.llm-limits-codex.json}"
# The alias every hand-driven jump onto an OpenAI account opens on; share/chat_resume.py
# spells the same one as GATEWAY_SWITCH_ALIAS (docs/shared-invariants.md row `cj`).
codexb_status_model=astra

# A live token can be locally present yet invalidated; llm-limits.sh records that as an
# auth-needed marker in the codex cache. Trust the marker over `codex login status`.
auth_marker() {
  [ -r "$codex_cache" ] || return 1
  jq -e --arg n "$1" 'any(.accounts[]?; .account == $n and .auth_needed == true)' \
    "$codex_cache" >/dev/null 2>&1
}

account_names() {
  local path
  codex_main_removed || printf 'main\n'
  if [ -d "$profiles_dir" ]; then
    for path in "$profiles_dir"/*; do
      [ -d "$path" ] && basename "$path"
    done | LC_ALL=C sort
  fi
}

account_home() {
  if [ "$1" = main ]; then
    printf '%s\n' ''
  else
    printf '%s\n' "$profiles_dir/$1"
  fi
}

reserved_name() {
  case "$1" in
    .*|*/*|help|add|remove|list|status|pick|profile|p|run|login|enable|disable|use|fast-mode|export-auth|models) return 0 ;;
    *) return 1 ;;
  esac
}

ensure_profile() {
  local directory="$1" item
  for item in "${shared_items[@]}"; do
    if [ -e "$HOME/.codex/$item" ] && [ ! -e "$directory/$item" ] && [ ! -L "$directory/$item" ]; then
      ln -s "$HOME/.codex/$item" "$directory/$item"
    fi
  done
}

ensure_profiles() {
  local name
  while IFS= read -r name; do
    [ "$name" = main ] || ensure_profile "$profiles_dir/$name"
  done < <(account_names)
}

login_status() {
  local name="$1" home output rc
  home=$(account_home "$name")
  rc=0
  if [ "$name" = main ]; then
    output=$(env -u CODEX_HOME codex login status 2>&1) || rc=$?
  else
    output=$(env CODEX_HOME="$home" codex login status 2>&1) || rc=$?
  fi
  output=$(printf '%s' "$output" | tr '\n\r\t' '   ' | awk '{$1=$1; print}')
  [ -n "$output" ] || output="login status unavailable"
  printf '%s\t%s\n' "$rc" "$output"
}

authenticated() {
  local status
  status=$(login_status "$1")
  [ "${status%%$'\t'*}" -eq 0 ]
}

format_reset_time() {
  local epoch="$1" now delta weekday
  local -a weekdays=(Sun Mon Tue Wed Thu Fri Sat)
  if ! [ "$epoch" -gt 0 ] 2>/dev/null; then printf 'unknown'; return; fi
  now=$(date +%s)
  delta=$((epoch - now))
  if [ "$delta" -lt 86400 ]; then
    date -r "$epoch" '+%H:%M' 2>/dev/null || date -d "@$epoch" '+%H:%M' 2>/dev/null || printf 'unknown'
  elif [ "$delta" -lt 604800 ]; then
    weekday=$(date -r "$epoch" '+%w' 2>/dev/null || date -d "@$epoch" '+%w' 2>/dev/null) || { printf 'unknown'; return; }
    printf '%s ' "${weekdays[$weekday]}"
    date -r "$epoch" '+%H:%M' 2>/dev/null || date -d "@$epoch" '+%H:%M' 2>/dev/null || printf 'unknown'
  else
    date -r "$epoch" '+%m-%d %H:%M' 2>/dev/null || date -d "@$epoch" '+%m-%d %H:%M' 2>/dev/null || printf 'unknown'
  fi
}

quota_snapshot() {
  local output
  if [ ! -x "$quota_helper" ]; then
    printf '{"accounts":[]}\n'
    return
  fi
  output=$(CODEX_QUOTA_TIMEOUT="${CODEXB_QUOTA_TIMEOUT:-5}" "$quota_helper" --all-accounts 2>/dev/null) || true
  if jq -e '.accounts | type == "array"' >/dev/null 2>&1 <<<"$output"; then
    printf '%s\n' "$output"
  else
    printf '{"accounts":[]}\n'
  fi
}

add_account() {
  local name="${1:-}" directory status
  if [ -z "$name" ] || ! [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || [ "$name" = main ] || reserved_name "$name"; then
    printf 'usage: codexb add <name> (must start with a lowercase letter or number; use only lowercase letters, numbers, and hyphens; not reserved words or "main")\n' >&2
    exit 2
  fi
  directory="$profiles_dir/$name"
  if [ -e "$directory" ] || [ -L "$directory" ]; then
    printf 'codexb: account already exists: %s\n' "$name" >&2
    exit 2
  fi
  mkdir -p "$directory"
  ensure_profile "$directory"
  announce_account_added "$codexb_root" codex "$name"
  printf 'CODEX_HOME=~/.codex-profiles/%s codex login\n' "$name"
  status=$(login_status "$name")
  printf '%s: %s\n' "$name" "${status#*$'\t'}"
}

# Alive = a login token is present locally (codex stores it in auth.json). A
# read/parse failure is treated as alive (fail closed) so a flaky read never
# turns removal into an unguarded delete.
codex_credentials_alive() {
  local auth="$1/auth.json"
  [ -f "$auth" ] || return 1
  jq -e '((.tokens.access_token // "") != "") or ((.tokens.refresh_token // "") != "")
         or ((.OPENAI_API_KEY // "") != "")' "$auth" >/dev/null 2>&1 && return 0
  # auth.json exists but jq could not confirm empty tokens: fail closed.
  jq -e 'true' "$auth" >/dev/null 2>&1 || return 0
  return 1
}

remove_account() {
  local name='' force=false arg directory codex_cache tmp marker fallback
  for arg in "$@"; do
    case "$arg" in
      --force) force=true ;;
      -*) printf 'usage: codexb remove <name> [--force]\n' >&2; exit 2 ;;
      *)
        if [ -n "$name" ]; then printf 'usage: codexb remove <name> [--force]\n' >&2; exit 2; fi
        name="$arg" ;;
    esac
  done
  # Charset (not reserved_name): rejects path traversal (`../x`, leading dot,
  # slashes) while still allowing removal of an account whose name became a
  # reserved word only after it was created (creation is gated separately).
  if [ -z "$name" ] || ! [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    printf 'usage: codexb remove <name> [--force] (lowercase letters, numbers, hyphens)\n' >&2
    exit 2
  fi
  marker=''
  if [ "$name" = main ]; then
    # main's home is the real ~/.codex, which this tool never deletes: the marker alone is what
    # takes it out of every enumerator, so removing it twice is removing an account that is gone.
    if codex_main_removed; then
      printf 'codexb: unknown account: %s\n' "$name" >&2
      exit 2
    fi
    marker=$(codex_removal_marker main)
  else
    directory="$profiles_dir/$name"
    if [ ! -e "$directory" ] && [ ! -L "$directory" ]; then
      printf 'codexb: unknown account: %s\n' "$name" >&2
      exit 2
    fi
    if [ "$force" != true ] && codex_credentials_alive "$directory"; then
      printf 'codexb: refusing to remove %s: it is still logged in; run codex logout first or pass --force\n' "$name" >&2
      exit 1
    fi
    rm -rf "$directory"
  fi
  # A pool entry outliving its account keeps the last-member guard counting a ghost, and the
  # name silently re-excludes a future account created under it.
  if is_disabled "$name"; then set_disabled "$name" off; fi
  if [ -n "$marker" ]; then
    mkdir -p "$(dirname "$marker")"
    : >"$marker"
  fi
  fallback=main
  if codex_main_removed; then fallback=''; fi
  codex_cache="${LLM_LIMITS_CODEX_CACHE:-$HOME/.llm-limits-codex.json}"
  if [ -r "$codex_cache" ]; then
    tmp="$codex_cache.tmp.$$"
    if jq -c --arg name "$name" --arg fallback "$fallback" '
        if type == "object" then
          (if (.accounts | type) == "array"
           then .accounts |= map(select(.account != $name)) else . end)
          | (if .current == $name then
               ((first(.accounts[]?.account) // $fallback) as $next |
                if $next == "" then del(.current) else .current = $next end)
             else . end)
        else . end' "$codex_cache" > "$tmp" 2>/dev/null; then
      mv "$tmp" "$codex_cache"
    else
      rm -f "$tmp"
    fi
  fi
  announce_account_removed "$codexb_root"
  printf 'codexb: removed %s\n' "$name"
  if [ -n "$marker" ]; then
    printf 'codexb: main stays hidden while %s exists; delete that file to bring it back.\n' "$marker"
  fi
}

list_accounts() {
  local name status
  while IFS= read -r name; do
    status=$(login_status "$name")
    if [ "${status%%$'\t'*}" -eq 0 ] && auth_marker "$name"; then
      printf '%s: login needed%s\n' "$name" "$(pool_suffix "$name")"
    else
      printf '%s: %s%s\n' "$name" "${status#*$'\t'}" "$(pool_suffix "$name")"
    fi
  done < <(account_names)
}

render_plain_status() {
  local quotas name status entry hused wused hreset wreset
  quotas=$(quota_snapshot)
  while IFS= read -r name; do
    entry=$(jq -c --arg account "$name" '[.accounts[] | select(.account == $account)][0] // {}' <<<"$quotas")
    status=$(login_status "$name")
    if [ "${status%%$'\t'*}" -eq 0 ] && jq -e '.auth_needed == true' <<<"$entry" >/dev/null 2>&1; then
      printf '%s: login needed%s | 5H - reset unknown | WEEKLY - reset unknown\n' \
        "$name" "$(pool_suffix "$name")"
      continue
    fi
    hused=$(jq -r 'if (.five_hour.used_pct | type) == "number" then (.five_hour.used_pct | round | tostring) + "%" else "-" end' <<<"$entry")
    wused=$(jq -r 'if (.weekly.used_pct | type) == "number" then (.weekly.used_pct | round | tostring) + "%" else "-" end' <<<"$entry")
    hreset=$(format_reset_time "$(jq -r '.five_hour.resets_at // 0' <<<"$entry")")
    wreset=$(format_reset_time "$(jq -r '.weekly.resets_at // 0' <<<"$entry")")
    printf '%s: %s%s | 5H %s reset %s | WEEKLY %s reset %s\n' \
      "$name" "${status#*$'\t'}" "$(pool_suffix "$name")" "$hused" "$hreset" "$wused" "$wreset"
  done < <(account_names)
}

codexb_status_pick_cmd() {
  if [ -n "${CODEXB_WORKER_PICK:-}" ]; then printf '%s' "$CODEXB_WORKER_PICK"; return; fi
  if [ -x "$codexb_root/bin/worker-pick" ]; then printf '%s' "$codexb_root/bin/worker-pick"; return; fi
  command -v worker-pick 2>/dev/null || return 1
}

codexb_status_now() { date +%s; }

codexb_status_claudegpt_cmd() {
  local candidate
  if [ -n "${CODEXB_CLAUDEGPT_CMD:-}" ]; then candidate="$CODEXB_CLAUDEGPT_CMD"
  elif [ -x "$codexb_root/bin/claudegpt" ]; then candidate="$codexb_root/bin/claudegpt"
  else candidate=$(command -v claudegpt 2>/dev/null) || return 1
  fi
  [ -x "$candidate" ] || return 1
  printf '%s' "$candidate"
}

# The picker's Enter opens Claude Code on this OpenAI account, not the Codex CLI, and names the
# alias rather than taking the launcher's default. Falling back to `codex` when the launcher is
# missing would open the wrong tool, so an absent launcher is a refusal.
codexb_status_launch() {
  local launcher
  [ -n "${accounts_launch:-}" ] || return 0
  launcher=$(codexb_status_claudegpt_cmd) || launcher=''
  if [ -z "$launcher" ]; then
    printf 'codexb: claudegpt is not installed; status opens Claude Code on a Codex account and will not start Codex instead\n' >&2
    exit 2
  fi
  exec "$launcher" p "$accounts_launch" --model "$codexb_status_model"
}

codexb_status_refresh() {
  local target=codex
  [ -z "${2:-}" ] || target="$target/$2"
  "${LLM_LIMITS_CMD:-$codexb_root/llm-limits.sh}" --refresh-account "$target"
}

codexb_status_outcome() {
  if [ "$(cat "$1/.result")" = 0 ]; then printf '✓ refreshed %s' "$(date '+%H:%M')"
  else printf '⚠ not refreshed'; fi
}

show_status() {
  if [ ! -t 1 ]; then render_plain_status; return; fi
  local accounts_vendor=codex accounts_store_vendor=codex accounts_rows=account_status_rows
  local accounts_pick_resolver=codexb_status_pick_cmd accounts_now=codexb_status_now
  local accounts_live_probe='' accounts_live_age=''
  local accounts_refresh_action=codexb_status_refresh accounts_refresh_summary=codexb_status_outcome
  local accounts_plain=render_plain_status accounts_launch_hook=codexb_status_launch
  account_status_show cached
}

account_exists() {
  if [ "$1" = main ]; then ! codex_main_removed; else [ -d "$profiles_dir/$1" ]; fi
}

pin_account() {
  case "${1:-}" in
    --unpin) worker_model_pin_account codex_profile codexb account_names is_disabled --unpin "${2:-}" ;;
    *) worker_model_pin_account codex_profile codexb account_names is_disabled "${1:-}" ;;
  esac
}

set_all_pool() { worker_pool_set_all "$pool_dir" codexb account_names "$1"; }

enable_account() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    printf 'usage: codexb enable <name>|--all\n' >&2
    exit 2
  fi
  if [ "$name" = --all ]; then
    set_all_pool off
    return
  fi
  if ! account_exists "$name"; then
    printf 'codexb: unknown account: %s\n' "$name" >&2
    exit 2
  fi
  if [ -e "$pool_dir/shielded/$name" ]; then
    worker_pool_shield_override codex "$name"
  fi
  if ! is_disabled "$name"; then
    printf 'codexb: %s is already enabled\n' "$name"
    return
  fi
  set_disabled "$name" off
  printf 'codexb: enabled %s\n' "$name"
}

disable_account() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    printf 'usage: codexb disable <name>|--all\n' >&2
    exit 2
  fi
  if [ "$name" = --all ]; then
    set_all_pool on
    return
  fi
  if ! account_exists "$name"; then
    printf 'codexb: unknown account: %s\n' "$name" >&2
    exit 2
  fi
  if is_disabled "$name"; then
    printf 'codexb: %s is already disabled\n' "$name"
    return
  fi
  set_disabled "$name" on
  printf 'codexb: disabled %s\n' "$name"
}

pick_account() {
  local quotas now name selected
  quotas=$(quota_snapshot)
  now=$(date +%s)
  selected=''
  while IFS= read -r name; do
    authenticated "$name" || continue
    if is_disabled "$name"; then continue; fi
    selected=$(jq -r --arg account "$name" --argjson now "$now" "$LIMITS_VIEW_JQ"'
      def effective($bucket):
        if ($bucket.used_pct | type) != "number" then null
        elif ($bucket.resets_at | type) == "number" and $bucket.resets_at <= $now then 0
        else $bucket.used_pct
        end;
      [.accounts[] | select(.account == $account and (.auth_needed // false) != true) |
       . as $entry |
       effective(.five_hour) as $five_hour |
       effective(.weekly) as $weekly |
       [$five_hour, $weekly] | map(select(. != null)) as $known |
       select(($known | length) == 0 or ($known | max) < 100) |
       {account:$entry.account,
        budget:(if $weekly == null
                then limits_daily_budget($five_hour; null)
                else limits_daily_budget($weekly; limits_days_remaining($entry.weekly.resets_at; $now))
                end)}] | .[0] // empty |
      [.account, .budget] | @tsv
    ' <<<"$quotas")
    [ -z "$selected" ] || printf '%s\n' "$selected"
  done < <(account_names) |
    LC_ALL=C sort -t $'\t' -k2,2nr -k1,1 |
    awk -F '\t' 'NR == 1 {print $1}'
}

fast_mode() {
  local name="${1:-}" mode="${2:-status}"
  account_exists "$name" || { printf 'codexb: unknown account: %s\n' "$name" >&2; return 2; }
  python3 "$codexb_root/share/codex_fast_mode.py" "$profiles_dir" "$name" "$mode"
}

codex_launch_needs_default_model() {
  local command_seen=false launch=true
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -m|--model|--model=*) return 1 ;;
      -h|--help|-V|--version) return 1 ;;
      --) break ;;
      -c|--config|-p|--profile|-C|--cd|-s|--sandbox|-a|--ask-for-approval|-i|--image|--enable|--disable|--add-dir|--local-provider)
        [ "$#" -lt 2 ] || shift ;;
      -*) ;;
      *)
        if [ "$command_seen" = false ]; then
          command_seen=true
          case "$1" in
            login|logout|mcp|mcp-server|app|app-server|resume|fork|review|debug|completion|cloud|apply|features|help) launch=false ;;
          esac
        fi ;;
    esac
    shift
  done
  [ "$launch" = true ]
}

codex_launch_needs_fast_mode_off() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h|--help|-V|--version) return 1 ;;
      --) return 0 ;;
      -c|--config|-m|--model|-p|--profile|-C|--cd|-s|--sandbox|-a|--ask-for-approval|-i|--image|--enable|--disable|--add-dir|--local-provider)
        [ "$#" -lt 2 ] || shift ;;
      -*) ;;
      login|logout|mcp|mcp-server|app|app-server|debug|completion|cloud|apply|features|help) return 1 ;;
      *) return 0 ;;
    esac
    shift
  done
  return 0
}

run_account() {
  local allow_create="$1" name="${2:-}" directory created=false
  if [ "$allow_create" = true ] && { [ "$name" = -h ] || [ "$name" = --help ]; }; then
    show_help
    return
  fi
  if [ -z "$name" ]; then
    printf 'usage: codexb profile <name> [codex args...]\n' >&2
    exit 2
  fi
  if ! [[ "$name" =~ ^[a-z0-9-]+$ ]]; then
    printf "codexb: invalid profile name '%s' (must start with a lowercase letter or number; use only lowercase letters, numbers, and hyphens)\n" "$name" >&2
    exit 2
  fi
  shift 2
  # `codex exec` is a program calling codexb; an interactive session is Egor, and only the
  # program half answers to the pool.
  if [ "${1:-}" = exec ]; then
    worker_pool_refuse_headless codex "$name" "$(worker_model_pinned_account codex_profile)" || exit 2
  fi
  if [ "$name" = main ]; then
    if codex_main_removed; then
      printf 'codexb: unknown account: %s\n' "$name" >&2
      exit 2
    fi
    exec env -u CODEX_HOME codex "$@"
  fi
  directory="$profiles_dir/$name"
  if [ ! -d "$directory" ]; then
    # Only explicit entry verbs create; the bare `<name> exec` path must still
    # reject an unknown account rather than mkdir a typo into existence.
    if [ "$allow_create" != true ]; then
      printf 'codexb: unknown account: %s\n' "$name" >&2
      exit 2
    fi
    if reserved_name "$name"; then
      printf "codexb: invalid profile name '%s'\n" "$name" >&2
      exit 2
    fi
    if ! [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
      printf "codexb: invalid profile name '%s' (must start with a lowercase letter or number; use only lowercase letters, numbers, and hyphens)\n" "$name" >&2
      exit 2
    fi
    mkdir -p "$directory"
    created=true
    printf "codexb: new profile '%s' created at %s — Codex will ask you to log in once.\n" "$name" "$directory" >&2
  fi
  ensure_profile "$directory"
  if codex_launch_needs_default_model "$@"; then
    local default_slug
    default_slug=$(worker_model_codex_slug "$(worker_model_default_model codex)") || default_slug=''
    if [ -z "$default_slug" ]; then
      printf "codexb: no listed codex model of the default family '%s' (see 'codexb models'); pass -m <slug>\n" \
        "$(worker_model_default_model codex)" >&2
      exit 2
    fi
    set -- -m "$default_slug" "$@"
  fi
  if codex_launch_needs_fast_mode_off "$@"; then
    # Past a `--` codex reads everything as prompt text, so the flags go in ahead of it.
    local before=() after=() terminated=false argument
    for argument in "$@"; do
      if [ "$terminated" = false ] && [ "$argument" = -- ]; then terminated=true; fi
      if [ "$terminated" = true ]; then after+=("$argument"); else before+=("$argument"); fi
    done
    set -- ${before[@]+"${before[@]}"} --disable fast_mode --config 'service_tier="default"' \
      ${after[@]+"${after[@]}"}
  fi
  [ "$created" != true ] || announce_account_added "$codexb_root" codex "$name"
  exec env CODEX_HOME="$directory" codex "$@"
}

show_help() {
  printf '%s\n' \
    'codexb profile <name> [codex args...]  Open an isolated profile; chats default to the worker allow-list model; creates it if missing (Codex asks you to log in once). Aliases: p, run.' \
    'codexb profile <name> login            Browser OAuth login for that account (menu Codex login uses this).' \
    'codexb <name> exec [args...]' \
    'codexb add <name>                      Create a profile without launching; prints the login command.' \
    'codexb remove <name> [--force]         Forget a profile and prune its cached quota; --force overrides the logged-in guard. main leaves only a marker.' \
    'codexb enable <name>|--all             Return an account (or every account) to worker selection.' \
    'codexb disable <name>|--all            Exclude an account (or every account) from the worker pool; headless runs are then refused, your own sessions are not.' \
    'codexb use <name>|--unpin [<name>]|--clear  Add/remove a workers pin; no name prints the list.' \
    'codexb fast-mode <name> [on|off|status]  Set Fast Mode for worker-run launches on that account; existing sessions are unchanged.' \
    'codexb list                            List profiles with login state.' \
    'codexb status                          Per-account login state and quota; on a TTY, Enter opens Claude Code on the selected account (claudegpt p <name> --model astra).' \
    'codexb pick                            Print the highest-priority usable account.' \
    'codexb models [--json] [--all] [--family <word>]  The codex model list from the newest models_cache.json (builtin fallback); --family prints the newest slug of a family word.' \
    'codexb export-auth <name> --to <path> [--min-seconds N]  Write an access-only auth.json for a confined run.'
}

models_builtin() { # slug<TAB>label<TAB>priority<TAB>visibility<TAB>efforts
  printf '%s\t%s\t%s\t%s\t%s\n' \
    gpt-6-astra GPT-6-Astra 1 list low,medium,high,xhigh,max,ultra \
    gpt-reserve GPT-Reserve 3 hide low,medium,high,xhigh,max \
    gpt-5.6-sol GPT-5.6-Sol 4 list low,medium,high,xhigh,max,ultra \
    gpt-5.6-terra GPT-5.6-Terra 7 list low,medium,high,xhigh,max,ultra \
    gpt-5.6-luna GPT-5.6-Luna 8 list low,medium,high,xhigh,max \
    gpt-5.5 GPT-5.5 12 list low,medium,high,xhigh \
    codex-auto-review 'Codex Auto Review' 43 hide low,medium,high,xhigh,max
}

models_cache_rows() { # cache -> the builtin's columns, nothing when unusable
  jq -r '.models | select(type == "array" and length > 0) | .[]
    | [.slug, (.display_name // .slug), (.priority // 999 | tostring), (.visibility // "list"),
       ([.supported_reasoning_levels[]? | .effort? // . | strings] | join(","))]
    | select(.[0] | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$")) | @tsv' "$1" 2>/dev/null
}

# The CLI refreshes models_cache.json in whichever home it last ran from, so the newest by the
# stamp the CLI wrote is the vendor's current list; no network here.
models_source() { # -> path of the newest usable cache, or nothing
  local path stamp best='' best_stamp=''
  if [ -n "${CODEXB_MODELS_CACHE:-}" ]; then
    [ -z "$(models_cache_rows "$CODEXB_MODELS_CACHE")" ] || printf '%s\n' "$CODEXB_MODELS_CACHE"
    return 0
  fi
  for path in "$HOME/.codex/models_cache.json" "$profiles_dir"/*/models_cache.json; do
    [ -r "$path" ] || continue
    [ -n "$(models_cache_rows "$path")" ] || continue
    stamp=$(jq -r '.fetched_at // "" | tostring' "$path" 2>/dev/null) || continue
    if [ -z "$best" ] || [[ "$stamp" > "$best_stamp" ]]; then best=$path; best_stamp=$stamp; fi
  done
  [ -z "$best" ] || printf '%s\n' "$best"
}

models_ranked() { # all(true|false) source-path
  local slug label priority visibility efforts split
  { if [ -n "$2" ]; then models_cache_rows "$2"; else models_builtin; fi; } |
    while IFS=$'\t' read -r slug label priority visibility efforts; do
      split=$(worker_model_codex_split "$slug")
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$slug" "$split" "$label" "$efforts" "$priority" "$visibility"
    done |
    awk -F'\t' -v all="$1" '
      function newer(a, b,   x, y, n, m, i) {
        if (b == "") return 1
        n = split(a, x, "."); m = split(b, y, ".")
        for (i = 1; i <= (n > m ? n : m); i++) if ((x[i] + 0) != (y[i] + 0)) return (x[i] + 0) > (y[i] + 0)
        return 0
      }
      all != "true" && $7 != "list" { next }
      { row[++n] = $0; fam[n] = $2; ver[n] = ($3 == "-" ? "" : $3); pri[n] = $6 + 0
        if (!($2 in top) || newer(ver[n], topver[$2])) { top[$2] = n; topver[$2] = ver[n] }
        if ($7 == "list" && (dflt == "" || pri[n] < pri[dflt])) dflt = n }
      END {
        for (i = 1; i <= n; i++) {
          rank = sprintf("%09d", pri[top[fam[i]]])
          split(ver[i], v, "."); key = ""
          for (j = 1; j <= 4; j++) key = key sprintf("%06d", 999999 - (v[j] + 0))
          split(row[i], c, "\t")
          printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", rank, fam[i], key, c[1], c[2], c[3], c[4],
            (i == dflt ? "y" : "n"), c[5], c[6] "\t" c[7]
        }
      }' | LC_ALL=C sort -t $'\t' -k1,1 -k2,2 -k3,3 | cut -f4-
}

show_models() {
  local json=false all=false family='' source rows known
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) json=true ;;
      --all) all=true ;;
      --family) [ "$#" -ge 2 ] || { printf 'usage: codexb models [--json] [--all] [--family <word>]\n' >&2; exit 2; }
                family=$2; shift ;;
      *) printf 'usage: codexb models [--json] [--all] [--family <word>]\n' >&2; exit 2 ;;
    esac
    shift
  done
  source=$(models_source)
  [ -n "$source" ] || printf 'codexb: no readable models_cache.json; using the built-in list\n' >&2
  if [ -n "$family" ]; then
    rows=$(models_ranked true "$source")
    awk -F'\t' -v want="$family" '$1 == want { print $1; found = 1; exit } END { exit !found }' \
      <<<"$rows" && return 0
    awk -F'\t' -v want="$family" '$2 == want && $8 == "list" { print $1; found = 1; exit } END { exit !found }' \
      <<<"$rows" && return 0
    known=$(awk -F'\t' '$8 == "list" && !seen[$2]++ { printf "%s%s", sep, $2; sep = ", " }' <<<"$rows")
    printf 'codexb: no listed codex model of family %s; families: %s\n' "$family" "$known" >&2
    exit 1
  fi
  rows=$(models_ranked "$all" "$source")
  if [ "$json" = true ]; then
    printf '%s\n' "$rows" | jq -Rn --arg source "$([ -n "$source" ] && printf cache || printf builtin)" \
      --arg path "$source" '
      [inputs | select(length > 0) | split("\t")
       | {slug: .[0], family: .[1], version: (if .[2] == "-" then null else .[2] end), label: .[3],
          default: (.[4] == "y"), efforts: (.[5] | split(",") | map(select(length > 0))),
          priority: (.[6] | tonumber), visibility: .[7], source: $source}
         + (if $path != "" then {cache: $path} else {} end)]'
  else
    printf '%s\n' "$rows" | cut -f1-6
  fi
}

# The saved login carries a refresh_token, and a confined runtime holding one can rotate the
# credential this machine is signed in with — a rotation nobody reads logs the account out. The
# native client will not load an auth.json that omits the field, so it leaves as an empty string:
# the run authenticates with the access token it was handed and can mint no other.
export_auth() {
  local name="${1:-}" target='' min_seconds=0
  if [ "$#" -gt 0 ]; then shift; fi
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --to) target="${2:-}"; shift 2 || return 2 ;;
      --min-seconds) min_seconds="${2:-}"; shift 2 || return 2 ;;
      *) break ;;
    esac
  done
  if [ "$#" -gt 0 ] || [ -z "$name" ] || [ -z "$target" ] || ! [[ "$min_seconds" =~ ^[0-9]+$ ]] \
     || ! [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    printf 'usage: codexb export-auth <name> --to <path> [--min-seconds N]\n' >&2
    return 2
  fi
  CODEXB_SHARE="$codexb_root/share" python3 - "$name" "$target" "$min_seconds" <<'PYTHON'
import calendar, json, os, sys, time
from pathlib import Path

sys.path.insert(0, os.environ["CODEXB_SHARE"])
import gateway_auth

name, target, min_seconds = sys.argv[1], Path(sys.argv[2]), int(sys.argv[3])


def refuse(code, message):
    print(f"codexb: {message}", file=sys.stderr)
    raise SystemExit(code)


if target.exists():
    refuse(2, f"{target} already exists")
# The shared resolver owns what counts as a usable login, including the JWT expiry this wrapper
# would otherwise re-derive. Its REFRESH verdict is a renewal this export must never perform.
payload, status, detail = gateway_auth.read_codex_auth(name)
if not payload or status != gateway_auth.READY:
    refuse(3, f"{name}: {status}" + (f" ({detail})" if detail else ""))
source = Path(gateway_auth.codex_auth_path(name))
try:
    saved = json.loads(source.read_text())["tokens"]
except (OSError, ValueError, KeyError, TypeError):
    refuse(3, f"unreadable codex auth: {source}")
identity = saved.get("id_token")
if not isinstance(identity, str) or identity.count(".") != 2:
    refuse(3, f"{name}: saved login carries no id_token to project")
expiry = calendar.timegm(time.strptime(payload["expired"], "%Y-%m-%dT%H:%M:%SZ"))
remaining = int(expiry - time.time())
if remaining < min_seconds:
    refuse(4, f"{name}'s access token does not outlast the run "
              f"({remaining} seconds left, {min_seconds} needed)")
document = {"OPENAI_API_KEY": None,
            "tokens": {"id_token": identity, "access_token": payload["access_token"],
                       "refresh_token": "", "account_id": payload["account_id"]},
            "last_refresh": time.strftime("%Y-%m-%dT%H:%M:%S.000000000Z", time.gmtime())}
descriptor = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(descriptor, "w") as stream:
    json.dump(document, stream)
print(f"source=auth.json expires_at={payload['expired']}")
PYTHON
}

if [ "${1:-}" = models ]; then
  shift
  show_models "$@"
  exit
fi
if [ "${1:-}" = fast-mode ]; then
  shift
  [ "$#" -ge 1 ] && [ "$#" -le 2 ] || { printf 'usage: codexb fast-mode <name> [on|off|status]\n' >&2; exit 2; }
  fast_mode "$@"
  exit
fi
ensure_profiles
if [ "${2:-}" = exec ] && [ "${1:-}" != main ] \
   && [[ "${1:-}" =~ ^[a-z0-9-]+$ ]] \
   && [ -d "$profiles_dir/${1:-}" ]; then
  name="$1"
  shift 2
  run_account false "$name" exec "$@"
fi
case "${1:-}" in
  add)
    shift
    [ "$#" -eq 1 ] || { printf 'usage: codexb add <name>\n' >&2; exit 2; }
    add_account "$1"
    ;;
  remove)
    shift
    [ "$#" -ge 1 ] || { printf 'usage: codexb remove <name> [--force]\n' >&2; exit 2; }
    remove_account "$@"
    ;;
  enable)
    shift
    enable_account "${1:-}"
    ;;
  disable)
    shift
    disable_account "${1:-}"
    ;;
  use)
    shift
    pin_account "$@"
    ;;
  list)
    [ "$#" -eq 1 ] || { printf 'usage: codexb list\n' >&2; exit 2; }
    list_accounts
    ;;
  status)
    [ "$#" -eq 1 ] || { printf 'usage: codexb status\n' >&2; exit 2; }
    show_status
    ;;
  pick)
    [ "$#" -eq 1 ] || { printf 'usage: codexb pick\n' >&2; exit 2; }
    selection=$(pick_account)
    # `main` is the last-resort answer when nothing else qualifies — but not when the user
    # excluded it, which would make `pick` hand back the one account it was told to spare, and not
    # when it has been removed, which would name an account no enumerator lists.
    if [ -z "$selection" ]; then
      if codex_main_removed || is_disabled main; then
        printf 'codexb: no account in the worker pool is usable\n' >&2
        exit 3
      fi
      selection=main
    fi
    printf '%s\n' "$selection"
    ;;
  export-auth)
    shift
    export_auth_rc=0
    export_auth "$@" || export_auth_rc=$?
    exit "$export_auth_rc"
    ;;
  profile|p|run)
    shift
    run_account true "$@"
    ;;
  help|-h|--help|'')
    show_help
    ;;
  *)
    name="$1"
    if [ "${2:-}" != exec ]; then
      printf 'usage: codexb <name> exec [args...]\n' >&2
      exit 2
    fi
    shift 2
    run_account false "$name" exec "$@"
    ;;
esac

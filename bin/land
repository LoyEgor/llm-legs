#!/usr/bin/env bash
set -u

usage() {
  cat >&2 <<'EOF'
usage: land [--test | --no-test] [<worktree-or-branch> | main]

Lands a finished branch (default: the current worktree's), or with `main` (or run in the main checkout)
that checkout's unpushed commits, on origin/main (local main with no origin): rebase, covering suites
only when upstream touched the branch's files since they last ran (--test: whenever the base moved),
push (at most 3 tries), the main checkout fast-forwarded where git's own guard lets it, the worktree and
branch removed. Exit 0 once the work is published, anything left undone in one `land: warning` line;
exit 1 when nothing was: a dirty worktree, a rebase conflict, a red suite (the branch put back), a refused push.
EOF
  exit 2
}

die() { printf 'land: %s\n' "$*" >&2; exit 1; }
warn() { printf 'land: warning: %s\n' "$*" >&2; }
. "$(cd -P "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)/share/processes.sh" || die "no share/processes.sh beside land"
export GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -oBatchMode=yes' GIT_EDITOR=true

tests=auto target_arg=''
while [ $# -gt 0 ]; do
  case $1 in
    --test) tests=on ;;
    --no-test) tests=off ;;
    -*) usage ;;
    *) [ -z "$target_arg" ] || usage; target_arg=$1 ;;
  esac
  shift
done

wt='' branch=''
if [ -z "$target_arg" ] || { [ -d "$target_arg" ] && ! git rev-parse -q --verify "refs/heads/$target_arg" >/dev/null 2>&1; }; then
  wt=$(git -C "${target_arg:-.}" rev-parse --show-toplevel 2>/dev/null) || die "${target_arg:-$PWD} is not inside a git worktree"
  branch=$(git -C "$wt" symbolic-ref -q --short HEAD) || die "$wt is on a detached HEAD, not a branch"
  here=$wt
else
  branch=$target_arg
  here=$(git rev-parse --show-toplevel 2>/dev/null) || die "run inside the repository of $branch"
fi
git -C "$here" rev-parse -q --verify "refs/heads/$branch" >/dev/null || die "no branch $branch"

repo='' main_wt='' path=''
while IFS= read -r line; do
  case $line in
    "worktree "*) path=${line#worktree }; [ -n "$repo" ] || repo=$path ;;
    "branch refs/heads/main") main_wt=$path ;;
    "branch refs/heads/$branch") [ -n "$wt" ] || wt=$path ;;
  esac
done < <(git -C "$here" worktree list --porcelain)
common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)

if [ "$branch" = main ]; then wt=''
elif [ "$wt" = "$repo" ]; then die "the main checkout itself is on $branch; land takes a branch in its own worktree"
elif [ -n "$wt" ]; then
  dirty=$(git -C "$wt" status --porcelain --untracked-files=all | wc -l | tr -d ' ')
  [ "$dirty" = 0 ] || die "$wt has $dirty uncommitted files: commit them, then land again"
fi

remote='' into=refs/heads/main
git -C "$repo" remote | grep -qx origin && remote=origin into=refs/remotes/origin/main
[ -n "$remote" ] || [ "$branch" != main ] || { echo "main has no origin to land on: nothing to land"; exit 0; }

tmp_wt='' dir=''
drop_tmp() { [ -z "$tmp_wt" ] || git -C "$repo" worktree remove --force "$tmp_wt" 2>/dev/null; tmp_wt=''; }
trap drop_tmp EXIT

work_tree() { # sets dir: the branch's worktree, else one made for the run, detached at cur
  if [ -z "$wt" ] && [ -z "$tmp_wt" ]; then
    tmp_wt=$(mktemp -d "${TMPDIR:-/tmp}/land.XXXXXX") && rmdir "$tmp_wt" &&
      git -C "$repo" worktree add -q --detach "$tmp_wt" "$cur" || die "cannot check $branch out to rebase it"
  fi
  dir=${wt:-$tmp_wt}
}

short() { git -C "$repo" rev-parse --short "$1"; }

target_of() { # -> origin/main, or local main when it only adds commits to it or there is no origin
  local lm om
  lm=$(git -C "$repo" rev-parse refs/heads/main)
  om=$(git -C "$repo" rev-parse -q --verify refs/remotes/origin/main) || { echo "$lm"; return; }
  if [ "$branch" != main ] && git -C "$repo" merge-base --is-ancestor "$om" "$lm"; then echo "$lm"; else echo "$om"; fi
}

chat_of() { # commit -> the author chat its message names, «name» or "(<name> chat"
  local body name=''
  body=$(git -C "$repo" log -1 --format=%B "$1")
  case $body in
    *«*»*) name=${body#*«} name=${name%%»*} ;;
    *) name=$(printf '%s\n' "$body" | head -1 | sed -nE 's/^[^(]*\(([^,()]+ chat)[,)].*/\1/p') ;;
  esac
  [ -z "$name" ] || printf ' (chat %s)' "$name"
}

wip_holder() { # main-checkout path -> the chat that last wrote the path there, per <git-common-dir>/claude-writes
  local key common sid name
  key=$(cd "$(git -C "$1" rev-parse --absolute-git-dir)" && pwd -P) || return 0
  common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir) || return 0
  sid=$(awk -F'\t' -v k="$key" -v p="$2" '$3 == k && $4 == p { o = $2 } END { print o }' "$common/claude-writes" 2>/dev/null)
  [ -n "$sid" ] || { printf 'unknown'; return 0; }
  name=$(chat-name "$sid" 2>/dev/null | head -1)
  printf '%s' "${name:-$sid}"
}

put_back() { [ -z "$wt" ] || git -C "$wt" reset -q --keep "$orig"; }

rebase_onto() { # target -> rebases cur, or exits naming the conflicting files and main's commits on them
  local files f c out
  [ "$(git -C "$repo" merge-base "$cur" "$1")" != "$1" ] || return 0
  work_tree
  out=$(git -C "$dir" -c gc.auto=0 rebase -q "$1" 2>&1) && { cur=$(git -C "$dir" rev-parse HEAD); return 0; }
  files=$(git -C "$dir" diff --no-renames --name-only --diff-filter=U)
  git -C "$dir" rebase --abort 2>/dev/null
  put_back
  {
    printf 'land: rebasing %s onto main %s conflicts; the branch is left as it was\n' "$branch" "$(short "$1")"
    [ -n "$files" ] || printf '%s\n' "$out"
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      printf '  %s\n' "$f"
      git -C "$repo" log --format='%H' "$cur..$1" -- "$f" | while IFS= read -r c; do
        printf '    %s %s%s\n' "$(short "$c")" "$(git -C "$repo" log -1 --format=%s "$c")" "$(chat_of "$c")"
      done
    done <<<"$files"
    printf 'land: resolve it in %s with git rebase %s, then land again\n' "${wt:-a worktree on $branch}" "$1"
  } >&2
  exit 1
}

suites_fail() { put_back; die "$1 on $branch rebased onto $(short "$target"); $branch is back at its pre-land tip $(short "$orig"), nothing published"; }

run_suites() {
  local s list suites=()
  work_tree
  [ -x "$dir/tests/affected" ] || return 0
  if ! list=$(cd "$dir" && env -u WORKER_RUN_ID tests/affected $own_files); then
    [ "$tests" != on ] || suites_fail "tests/affected failed, coverage unknown,"
    warn "tests/affected failed on $branch, coverage unknown: landing without suites"
    return 0
  fi
  while IFS= read -r s; do [ -n "$s" ] && suites+=("$s"); done <<<"$list"
  [ ${#suites[@]} -gt 0 ] || return 0
  if [ -x "$dir/tests/run-all" ]; then
    (cd "$dir" && env -u WORKER_RUN_ID tests/run-all "${suites[@]}") >&2 || suites_fail "suites failed"
  else
    for s in "${suites[@]}"; do (cd "$dir" && env -u WORKER_RUN_ID "./$s") >&2 || suites_fail "$s failed"; done
  fi
  suites_ran=$((suites_ran + ${#suites[@]}))
}

main_rebasing() { cat "$common"/{,worktrees/*/}rebase-{merge,apply}/head-name 2>/dev/null | grep -qx refs/heads/main; }

stuck() { why="the main checkout ${main_wt:-$repo} stays at $(git -C "${main_wt:-$repo}" rev-parse --short HEAD): $1; the next land catches it up"; return 1; }

catch_up() { # tip -> main and its checkout at tip, git's own guard keeping the WIP; else why set, status 1
  local tip=$1 head out f how=(merge --ff-only -q)
  head=$(git -C "$repo" rev-parse refs/heads/main)
  [ "$head" != "$tip" ] || return 0
  if ! git -C "$repo" merge-base --is-ancestor "$head" "$tip"; then
    git -C "$repo" cherry "$tip" "$head" | grep -q '^+' && { why="local main has commits not on origin/main, left to their owner: $(git -C "$repo" log --format='%h %s' --cherry-pick --right-only "$tip...$head" | paste -sd ';' - | sed 's/;/; /g'); land in the main checkout publishes them"; return 1; }
    how=(reset -q --keep)
  fi
  if [ -z "$main_wt" ]; then
    ! main_rebasing || { stuck 'main is being rebased in a worktree'; return; }
    git -C "$repo" update-ref refs/heads/main "$tip" "$head" || { stuck 'main moved meanwhile'; return; }
    [ "$(git -C "$repo" rev-parse HEAD)" = "$tip" ] || stuck "main moved to $(short "$tip"), the checkout is not on it"
    return
  fi
  while IFS= read -r f; do
    [ ! -e "$f" ] || { stuck "mid-operation (${f##*/})"; return; }
  done < <(git -C "$main_wt" rev-parse --path-format=absolute --git-path MERGE_HEAD --git-path CHERRY_PICK_HEAD \
    --git-path REVERT_HEAD --git-path BISECT_LOG --git-path rebase-apply --git-path rebase-merge)
  out=$(git -C "$main_wt" "${how[@]}" "$tip" 2>&1) && return 0
  f=$(comm -12 <(git -C "$main_wt" diff --no-renames --name-only HEAD "$tip" | sort) \
    <(git -C "$main_wt" status --porcelain --untracked-files=all --no-renames | cut -c4- | sort) |
    while IFS= read -r f; do printf '%s (holder: %s), ' "$f" "$(wip_holder "$main_wt" "$f")"; done)
  if [ -n "$f" ]; then stuck "${f%, } in the way"; else stuck "$(head -1 <<<"$out")"; fi
}

orig=$(git -C "$repo" rev-parse "refs/heads/$branch") cur=$orig
own_files='' tested='' suites_ran=0
[ -z "$remote" ] || git -C "$repo" -c gc.auto=0 fetch -q origin || die "fetch from origin failed; nothing published"
if [ "$branch" = main ] && [ -z "$(git -C "$repo" rev-list "$(target_of)..$cur")" ]; then
  catch_up "$(target_of)" || warn "$why, night-run leftovers lists it until then"
  echo "main has no unpushed commits: nothing to land" && exit 0
fi
for try in 1 2 3; do
  target=$(target_of)
  if [ "$try" = 1 ]; then
    base=$(git -C "$repo" merge-base "$cur" "$target")
    own_files=$(git -C "$repo" diff --no-renames --name-only "$base" "$cur")
    [ "$tests" != auto ] || tested=$base
  fi
  need=false
  if [ "$tests" = on ]; then [ "$target" = "$tested" ] || need=true
  elif [ "$tests" = auto ] && [ -n "$own_files" ] &&
    git -C "$repo" diff --no-renames --name-only "$tested" "$target" | grep -qxF -f <(printf '%s\n' "$own_files"); then need=true; fi
  rebase_onto "$target"
  if $need; then run_suites; tested=$target; fi
  if [ -z "$remote" ]; then
    catch_up "$cur" && break
    git -C "$repo" merge-base --is-ancestor "$cur" refs/heads/main && { warn "$why"; break; }
    [ "$(git -C "$repo" rev-parse refs/heads/main)" != "$target" ] || die "$why; nothing landed"
    continue
  fi
  git -C "$repo" -c gc.auto=0 push -q origin "$cur:refs/heads/main" 2>/dev/null && break
  git -C "$repo" -c gc.auto=0 fetch -q origin || die "push of main failed and origin cannot be fetched; nothing published"
  ! git -C "$repo" merge-base --is-ancestor refs/remotes/origin/main "$cur" || die "push of main to origin was refused; nothing published"
done
git -C "$repo" merge-base --is-ancestor "$cur" "$into" ||
  die "main moved under every one of 3 tries; $branch is rebased but not landed"
[ -z "$remote" ] || catch_up "$(git -C "$repo" rev-parse "$into")" ||
  warn "$why, night-run leftovers lists it until then"

drop_tmp
if [ "$branch" = main ]; then :
elif [ -n "$wt" ] && held=$(cwd_held "$wt"); then
  warn "landed, but $wt and branch $branch stay, $held; nothing killed, night-run finish prunes them once they end"
elif [ -n "$wt" ] && ! git -C "$repo" worktree remove "$wt" 2>/dev/null; then
  warn "landed, but $wt could not be removed and stays with branch $branch; night-run leftovers lists them"
elif ! git -C "$repo" update-ref -d "refs/heads/$branch" "$([ -n "$wt" ] && echo "$cur" || echo "$orig")" 2>/dev/null; then
  warn "landed, but branch $branch got commits after the rebase and stays; land it again"
fi
if [ "$suites_ran" -gt 0 ]; then suites="ran $suites_ran"; else suites=skipped; fi
printf 'landed %s → main %s (%s), suites: %s\n' "$branch" "$(short "$cur")" "$([ -n "$remote" ] && echo pushed || echo local)" "$suites"

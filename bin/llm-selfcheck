#!/usr/bin/env bash
set -u

resolve_script() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")" && printf '%s/%s\n' "$PWD" "$(basename "$source")"
}

script_path=$(resolve_script)
repo_root=$(cd "$(dirname "$script_path")/.." && pwd)
log_dir="$HOME/.claude-profiles/.claudeb"
log_file="$log_dir/selfcheck.log"
state_file="$log_dir/selfcheck.state"
agent_dir="$HOME/Library/LaunchAgents"
plist="$agent_dir/com.llm-legs.selfcheck.plist"
link="$HOME/.local/bin/llm-selfcheck"
label="com.llm-legs.selfcheck"

timeout_command() {
  if command -v gtimeout >/dev/null 2>&1; then
    command gtimeout "$@"
  elif command -v timeout >/dev/null 2>&1; then
    command timeout "$@"
  else
    perl -e 'alarm shift; exec @ARGV' "$@"
  fi
}

write_log() {
  local status="$1" step="$2" temporary
  mkdir -p "$log_dir"
  printf 'timestamp=%s status=%s failed_step=%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$status" "$step" >>"$log_file"
  temporary="$log_file.$$"
  tail -n 60 "$log_file" >"$temporary" && mv "$temporary" "$log_file"
}

write_step_log() {
  local status="$1" step="$2" detail="$3" temporary
  detail=${detail//$'\n'/; }
  mkdir -p "$log_dir"
  printf 'timestamp=%s status=%s step=%s detail=%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$status" "$step" "$detail" >>"$log_file"
  temporary="$log_file.$$"
  tail -n 60 "$log_file" >"$temporary" && mv "$temporary" "$log_file"
}

send_alert() {
  local message="$1"
  hs -c "hs.alert.show(\"$message\")" >/dev/null 2>&1 || true
  osascript -e "display notification \"$message\" with title \"LLM self-check\"" >/dev/null 2>&1 || true
}

alert_failure() {
  send_alert "LLM self-check failed: $1"
}

last_run_epoch() {
  local ts
  [ -f "$log_file" ] || return 0
  ts=$(grep -o 'timestamp=[^ ]*' "$log_file" | tail -n 1 | cut -d= -f2-)
  [ -n "$ts" ] || return 0
  date -j -f '%Y-%m-%dT%H:%M:%S%z' "$ts" '+%s' 2>/dev/null || date -d "$ts" '+%s' 2>/dev/null
}

alert_stale() {
  local last="$1" prev stale_date
  mkdir -p "$log_dir"
  prev=""
  [ -f "$state_file" ] && prev=$(cat "$state_file")
  [ "$prev" = "$last" ] && return 0
  stale_date=$(date -r "$last" '+%Y-%m-%d %H:%M' 2>/dev/null || date -d "@$last" '+%Y-%m-%d %H:%M' 2>/dev/null || printf 'unknown')
  send_alert "LLM self-check stale since $stale_date"
  printf '%s\n' "$last" >"$state_file"
}

maybe_run() {
  local now last age debounce_s stale_s
  now=$(date '+%s')
  last=$(last_run_epoch)
  if [ -n "$last" ]; then
    debounce_s=$(( ${LLM_SELFCHECK_DEBOUNCE_HOURS:-20} * 3600 ))
    age=$(( now - last ))
    if [ "$age" -lt "$debounce_s" ]; then
      return 0
    fi
    stale_s=$(( ${LLM_SELFCHECK_STALE_ALERT_HOURS:-26} * 3600 ))
    if [ "$age" -ge "$stale_s" ]; then
      alert_stale "$last"
    fi
  fi
  run_checks
}

run_checks() {
  local name path seconds output rc detail step_status exit_plan exit_date
  # Scaffolding self-reminder (docs/EXIT-PLAN.md): after the decision date, nag daily
  # until the exit plan is executed — this block is removed together with it.
  exit_plan="$repo_root/docs/EXIT-PLAN.md"
  exit_date=$(sed -n 's/^decision-date: *//p' "$exit_plan" 2>/dev/null | head -1)
  if [ -n "$exit_date" ] && ! [ "$(date +%Y-%m-%d)" \< "$exit_date" ]; then
    write_step_log WARN exit-plan-review "due since $exit_date — see docs/EXIT-PLAN.md"
    send_alert "LLM limits: exit-plan review due — docs/EXIT-PLAN.md"
  fi
  local -a steps=(
    "shadow-divergence:${LLM_SELFCHECK_SHADOW_TIMEOUT:-30}"
    "e2e_surfaces.sh:${LLM_SELFCHECK_E2E_TIMEOUT:-900}"
    "test_llm_limits.sh:${LLM_SELFCHECK_SUITE_TIMEOUT:-300}"
    "test_claudeb.sh:${LLM_SELFCHECK_SUITE_TIMEOUT:-300}"
    "test_claudebd.sh:${LLM_SELFCHECK_SUITE_TIMEOUT:-300}"
    "test_codexb.sh:${LLM_SELFCHECK_SUITE_TIMEOUT:-300}"
    "test_geminib.sh:${LLM_SELFCHECK_SUITE_TIMEOUT:-300}"
  )
  output=$(mktemp "${TMPDIR:-/tmp}/llm-selfcheck.XXXXXX") || exit 1
  cd "$repo_root" || exit 1
  for path in "${steps[@]}"; do
    name=${path%%:*}
    seconds=${path#*:}
    rc=0
    if [ "$name" = shadow-divergence ]; then
      timeout_command "$seconds" "$repo_root/bin/llm-shadow-divergence" >"$output" 2>&1 || rc=$?
      detail=$(tr '\n' ' ' <"$output" | sed 's/[[:space:]]*$//')
      step_status=PASS
      [[ "$detail" == *": skipped "* ]] && step_status=SKIP
      [ "$rc" -ne 0 ] && step_status=FAIL
      write_step_log "$step_status" "$name" "$detail"
    else
      timeout_command "$seconds" bash "tests/$name" >"$output" 2>&1 || rc=$?
    fi
    if [ "$rc" -ne 0 ]; then
      write_log FAIL "$name"
      printf 'llm-selfcheck: %s failed (exit %s)\n' "$name" "$rc" >&2
      cat "$output" >&2
      if [ "$name" = shadow-divergence ] && [ -n "$detail" ]; then
        alert_failure "$name: $detail"
      else
        alert_failure "$name"
      fi
      rm -f "$output"
      return "$rc"
    fi
  done
  rm -f "$output"
  write_log PASS -
}

install_agent() {
  mkdir -p "$agent_dir" "$log_dir" "$(dirname "$link")"
  ln -sfn "$script_path" "$link"
  cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$link</string>
  </array>
  <key>WorkingDirectory</key>
  <string>$repo_root</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>$log_dir/selfcheck.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>$log_dir/selfcheck.stderr.log</string>
</dict>
</plist>
EOF
  launchctl bootout "gui/$UID" "$plist" >/dev/null 2>&1 || true
  if ! launchctl bootstrap "gui/$UID" "$plist"; then
    launchctl load -w "$plist"
  fi
  printf 'Installed %s for 10:30 daily, plus RunAtLoad and hourly catch-up checks (debounced).\n' "$label"
}

uninstall_agent() {
  launchctl bootout "gui/$UID" "$plist" >/dev/null 2>&1 || launchctl unload -w "$plist" >/dev/null 2>&1 || true
  rm -f "$plist"
  if [ -L "$link" ] && [ "$(readlink "$link")" = "$script_path" ]; then
    rm -f "$link"
  fi
  printf 'Uninstalled %s.\n' "$label"
}

show_status() {
  if launchctl print "gui/$UID/$label" 2>/dev/null; then
    printf 'Status: loaded\n'
  else
    printf 'Status: not loaded\n'
  fi
  if [ -f "$log_file" ]; then
    printf 'Recent runs:\n'
    tail -n 10 "$log_file"
  else
    printf 'Recent runs: none\n'
  fi
}

usage() { printf 'usage: llm-selfcheck [run [--force]|install|uninstall|status]\n' >&2; exit 2; }

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
case "${1:-run}" in
  run)
    case "${2:-}" in
      '') maybe_run ;;
      --force) [ "$#" -eq 2 ] || usage; run_checks ;;
      *) usage ;;
    esac
    ;;
  install) [ "$#" -eq 1 ] || exit 2; install_agent ;;
  uninstall) [ "$#" -eq 1 ] || exit 2; uninstall_agent ;;
  status) [ "$#" -eq 1 ] || exit 2; show_status ;;
  *) usage ;;
esac
fi

#!/usr/bin/env bash
# claude-relogin — logs a logged-out Claude account back in with no password: `claude auth login` under its profile,
# its Chrome profile's surviving Google session, and a codex Computer Use run that clicks Authorize; then revive.
# usage: claude-relogin <account> [--dry-run]
#
# The flow Egor proved by hand (2026-11-13): (1) `claude auth login --claudeai` with a BROWSER stub that writes the
# authorize URL (localhost:<port>/callback redirect) to a file while the process waits for the callback; (2)
# `worker-run browse --window <account>` brings the account's Chrome profile up (the only way Chrome starts); (3) a
# codex Computer Use run of share/briefs/claude-cli-login.md opens the URL there and clicks through Google to
# Authorize, stopping on any password, code, captcha, passkey or other email; (4) `claude auth status` shows the
# registry email and `claudeb revive` clears auth_needed. bin/llm-refresh starts it detached for a logged-out account.
#
# Exit codes, each with one `REASON:` line (0 prints `RELOGIN:`):
#   0 logged in and revived            2 usage, unknown account or no brief template
#   3 already logged in (refused)      4 no enrolled Chrome profile (refused)
#   5 another relogin is live (lock)   6 cool-down: a real attempt within CLAUDE_RELOGIN_COOLDOWN_S (refused)
#   7 weather: no codex account can serve Computer Use, or a read failed; no attempt stamp, retried next time
#   8 the attempt failed; the waiting login is killed and "login needed" stays
#   9 logged in, but `claudeb revive` failed
# Every verdict but usage reaches token-attempts.jsonl as kind `relogin`; --dry-run journals, stamps and starts nothing.
{
set -u

resolve_root() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}
root=$(resolve_root)
. "$root/share/store-lock.sh"
. "$root/share/limit-hit.sh"
. "$root/share/run-bounded.sh"
. "$root/share/processes.sh"
. "$root/share/token-journal.sh"
. "$root/share/claude-relogin.sh"

base_dir=$claude_relogin_dir
profiles_root=${CLAUDE_RELOGIN_PROFILES_ROOT:-$HOME/.claude-profiles}
claude_bin=${CLAUDE_RELOGIN_CLAUDE:-claude}
worker_run=${CLAUDE_RELOGIN_WORKER_RUN:-$root/bin/worker-run}
claudeb_bin=${CLAUDE_RELOGIN_CLAUDEB:-$root/bin/claudeb}
brief_template=${CLAUDE_RELOGIN_BRIEF:-$root/share/briefs/claude-cli-login.md}
seconds() { [[ "${!1:-}" =~ ^[1-9][0-9]*$ ]] && printf '%s' "${!1}" || printf '%s' "$2"; }
url_wait=$(seconds CLAUDE_RELOGIN_URL_WAIT_S 30)
run_timeout=$(seconds CLAUDE_RELOGIN_RUN_TIMEOUT_S 1200)
login_wait=$(seconds CLAUDE_RELOGIN_LOGIN_WAIT_S 60)
status_timeout=$(seconds CLAUDE_RELOGIN_STATUS_TIMEOUT_S 30)
revive_timeout=$(seconds CLAUDE_RELOGIN_REVIVE_TIMEOUT_S 240)

account='' dry_run=false work='' login_pid='' locked=false prev_stamp=null

usage() { printf 'usage: claude-relogin <account> [--dry-run]\n' >&2; exit 2; }
note() { printf 'claude-relogin: %s: %s\n' "$account" "$*" >&2; }

# One verdict: journal (kind relogin), one REASON line, the exit code.
verdict() { # code outcome text
  $dry_run || token_journal "$account" relogin "$2"
  printf 'REASON: %s — %s\n' "$2" "$3"
  exit "$1"
}

cleanup() {
  if [ -n "$login_pid" ] && kill -0 "$login_pid" 2>/dev/null; then process_tree_end "$login_pid" 2; fi
  ! $locked || store_lock_release "$claude_relogin_lock"
  [ -z "$work" ] || rm -rf "$work"
}

# Cool-down stamps: {account: {at, verdict}} under the state file's own lock.
state_write() { # jq filter over $old, $a, $now, $v, $prev
  local lock="$claude_relogin_state.lock" old tmp
  mkdir -p "${claude_relogin_state%/*}" 2>/dev/null || return 0
  store_lock_acquire "$lock" || return 0
  old=$(jq -c 'if type == "object" then . else {} end' "$claude_relogin_state" 2>/dev/null) || old=''
  [ -n "$old" ] || old='{}'
  tmp="$claude_relogin_state.tmp.$$"
  if jq -n --argjson old "$old" --arg a "$account" --argjson now "${EPOCHSECONDS:-$(date +%s)}" \
      --arg v "${2:-}" --argjson prev "$prev_stamp" "$1" >"$tmp" 2>/dev/null; then
    mv -f "$tmp" "$claude_relogin_state" || rm -f "$tmp"
  else
    rm -f "$tmp"
  fi
  store_lock_release "$lock"
}
stamp() { state_write '$old + {($a): {at: $now, verdict: $v}}' "$1"; }
# Weather is no attempt: the stamp the attempt wrote goes back to what it was.
unstamp() { state_write 'if $prev == null then $old | del(.[$a]) else $old + {($a): $prev} end'; }

auth_status() { # -> the `claude auth status` JSON of the account's profile
  run_bounded "$status_timeout" env CLAUDE_CONFIG_DIR="$profile_dir" "$claude_bin" auth status --json 2>/dev/null
}

kill_login() {
  [ -n "$login_pid" ] || return 0
  ! kill -0 "$login_pid" 2>/dev/null || process_tree_end "$login_pid" 2
  wait "$login_pid" 2>/dev/null
  login_pid=''
}

# A failed attempt: the waiting login dies, the stamp stays, the flag is left as it was.
attempt_failed() { # cause text
  kill_login
  verdict 8 "failed:$1" "$2; \`claudeb profile $account\` + /login is the hand fallback"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) dry_run=true ;;
    -h|--help) usage ;;
    -*) usage ;;
    *) [ -z "$account" ] || usage; account=$1 ;;
  esac
  shift
done
[ -n "$account" ] || usage
case "$account" in main|-|*[!A-Za-z0-9._-]*) printf 'claude-relogin: not an account name: %s\n' "$account" >&2; exit 2 ;; esac
profile_dir=$profiles_root/$account
[ -d "$profile_dir" ] || { printf 'claude-relogin: unknown account %s (no %s)\n' "$account" "$profile_dir" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || { printf 'claude-relogin: jq is required\n' >&2; exit 2; }

trap cleanup EXIT
trap 'exit 129' HUP INT TERM

# One relogin at a time, whatever its account: it owns a Chrome window and a Computer Use run.
if $dry_run; then
  ! claude_relogin_live || verdict 5 busy "another claude-relogin holds $claude_relogin_lock"
else
  mkdir -p "${claude_relogin_lock%/*}" 2>/dev/null
  LLM_STORE_LOCK_RETRIES=1 store_lock_acquire "$claude_relogin_lock" ||
    verdict 5 busy "another claude-relogin holds $claude_relogin_lock"
  locked=true
fi

status=$(auth_status) && jq -e 'type == "object" and has("loggedIn")' >/dev/null 2>&1 < <(printf '%s\n' "$status") ||
  verdict 7 weather "claude auth status gave no answer for $profile_dir; retried next time"
if jq -e '.loggedIn == true' >/dev/null 2>&1 < <(printf '%s\n' "$status"); then
  email=$(jq -r '.email // "?"' < <(printf '%s\n' "$status"))
  # A login made by hand leaves the flag until a revive merges a usage read: clear it here, or the heartbeat asks
  # for this account every tick.
  if ! $dry_run && jq -e '.auth_needed == true' "$claude_relogin_dir/limits/$account.json" >/dev/null 2>&1; then
    revive_rc=0
    run_bounded "$revive_timeout" "$claudeb_bin" revive "$account" >/dev/null 2>&1 || revive_rc=$?
    verdict 3 already-logged-in "$account is logged in as $email; login needed cleared by claudeb revive (exit $revive_rc)"
  fi
  verdict 3 already-logged-in "$account is logged in as $email"
fi

! claude_relogin_cooling "$account" "${EPOCHSECONDS:-$(date +%s)}" attempt ||
  verdict 6 cooldown "a real attempt on $account ran within ${claude_relogin_cooldown}s ($claude_relogin_state); the hand fallback is \`claudeb profile $account\` + /login"

registry=$(run_bounded 60 "$worker_run" browse --json 2>/dev/null) &&
  jq -e 'type == "object"' >/dev/null 2>&1 < <(printf '%s\n' "$registry") ||
  verdict 7 weather "worker-run browse --json gave no registry; retried next time"
IFS=$'\t' read -r email chrome_profile < <(jq -r --arg a "$account" '
  .[$a] // {} | select((.email // "") != "" and (.chrome_profile // "") != "") | [.email, .chrome_profile] | @tsv' \
  < <(printf '%s\n' "$registry"))
if [ -z "${email:-}" ] || [ -z "${chrome_profile:-}" ]; then
  $dry_run || stamp no-profile
  verdict 4 no-profile "$account has no enrolled Chrome profile with an email (worker-run browse --enroll $account); log in by hand: \`claudeb profile $account\` + /login"
fi
[ -r "$brief_template" ] || verdict 2 no-brief "the brief template $brief_template is missing"

if $dry_run; then
  printf 'DRY-RUN: would log %s in as %s through Chrome profile %s\n' "$account" "$email" "$chrome_profile"
  exit 0
fi

# The attempt is stamped before anything runs: a relogin killed half way still counts, so a wall never loops.
prev_stamp=$(jq -c --arg a "$account" '.[$a] // null' "$claude_relogin_state" 2>/dev/null) || prev_stamp=null
[ -n "$prev_stamp" ] || prev_stamp=null
stamp attempt

work=$(mktemp -d "${TMPDIR:-/tmp}/claude-relogin.XXXXXX") || attempt_failed workdir 'no scratch directory'
url_file=$work/authorize-url
printf '#!/bin/sh\nprintf '"'"'%%s\\n'"'"' "$1" >>'"'"'%s'"'"'\n' "$url_file" >"$work/browser"
chmod +x "$work/browser"

# Step 1: the waiting login; the stub stands in for the browser and only writes the URL down.
note "step 1: claude auth login --claudeai"
CLAUDE_CONFIG_DIR="$profile_dir" BROWSER="$work/browser" "$claude_bin" auth login --claudeai \
  </dev/null >"$work/login.log" 2>&1 &
login_pid=$!
url='' waited=0
while [ "$waited" -lt $((url_wait * 5)) ]; do
  if [ -s "$url_file" ]; then IFS= read -r url <"$url_file"; break; fi
  kill -0 "$login_pid" 2>/dev/null || break
  sleep 0.2
  waited=$((waited + 1))
done
# A CLI that prints the URL instead of opening it still names it in its own output.
[ -n "$url" ] || url=$(grep -Eo 'https://[^[:space:]]*authorize[^[:space:]]*' "$work/login.log" 2>/dev/null | head -n1)
kill -0 "$login_pid" 2>/dev/null ||
  attempt_failed login-exited "claude auth login exited before the callback: $(tail -n 3 "$work/login.log" 2>/dev/null | tr '\n' ' ')"
[[ $url =~ localhost(%3A|:)([0-9]+)(%2F|/)callback ]] ||
  attempt_failed no-authorize-url "no authorize URL with a localhost callback within ${url_wait}s"
port=${BASH_REMATCH[2]}
[ -s "$url_file" ] || printf '%s\n' "$url" >"$url_file"

# Step 2: the account's Chrome profile, brought up the one way Chrome may start.
note "step 2: worker-run browse --window"
run_bounded 120 "$worker_run" browse --window "$account" >"$work/window.out" 2>&1 ||
  attempt_failed window "worker-run browse --window $account failed: $(tail -n 1 "$work/window.out" 2>/dev/null)"

# Step 3: the clicks, a codex Computer Use run of the stock brief.
note "step 3: Computer Use run (callback port $port)"
brief=$(awk '/^```/ { n++; next } n == 1' "$brief_template")
[ -n "$brief" ] || attempt_failed no-brief "the brief template $brief_template holds no fenced brief"
brief=${brief//"<account>"/"$account"}
brief=${brief//"<email>"/"$email"}
brief=${brief//"<profile dir>"/"$chrome_profile"}
brief=${brief//"<url file>"/"$url_file"}
brief=${brief//"<port>"/"$port"}
printf '%s\n' "$brief" >"$work/brief"
run_rc=0
run_bounded "$run_timeout" "$worker_run" run auto --brief "$work/brief" --workdir "$work" >"$work/run.out" 2>&1 || run_rc=$?
if [ "$run_rc" -eq 124 ]; then
  run_id=$(sed -n 's/^RUN: //p' "$work/run.out" | head -n1)
  [ -z "$run_id" ] || run_bounded 60 "$worker_run" stop "$run_id" >/dev/null 2>&1
  attempt_failed run-timeout "the Computer Use run passed ${run_timeout}s${run_id:+ (run $run_id stopped)}"
fi
# No codex account (or no Computer Use service) to serve the run is weather: nothing was clicked.
if grep -Eq '^OUTCOME: (CODEX_UNAVAILABLE|CODEX_USAGE_LIMIT)|^REASON: codex computer use unavailable' "$work/run.out"; then
  kill_login
  unstamp
  verdict 7 weather "no codex account can serve Computer Use now: $(grep -Em1 '^(OUTCOME|REASON): ' "$work/run.out")"
fi
outcome=$(sed -nE 's/^`?(OUTCOME: [A-Z_]+.*)$/\1/p' "$work/run.out" | tail -n1)
outcome=${outcome%\`}
case "$outcome" in
  'OUTCOME: COMPUTER_OK'*) ;;
  'OUTCOME: COMPUTER_UNAVAILABLE'*) attempt_failed wall "the Computer Use run stopped: ${outcome#OUTCOME: }" ;;
  *) attempt_failed run "worker-run exited $run_rc with ${outcome:-no OUTCOME line}" ;;
esac

# Step 4: the callback lands, then the CLI's own word and the registry email must agree.
note "step 4: verify"
waited=0
while kill -0 "$login_pid" 2>/dev/null && [ "$waited" -lt $((login_wait * 5)) ]; do sleep 0.2; waited=$((waited + 1)); done
kill_login
status=$(auth_status) || status='{}'
got=$(jq -r 'if .loggedIn == true then (.email // "?") else "" end' 2>/dev/null < <(printf '%s\n' "$status"))
if [ -z "$got" ]; then
  attempt_failed not-logged-in "the run reported Authorize, yet claude auth status shows $account logged out"
fi
if [ "$(tr '[:upper:]' '[:lower:]' < <(printf '%s' "$got"))" != "$(tr '[:upper:]' '[:lower:]' < <(printf '%s' "$email"))" ]; then
  # Another account in this profile would spend the wrong quota under this name: back to logged out.
  run_bounded "$status_timeout" env CLAUDE_CONFIG_DIR="$profile_dir" "$claude_bin" auth logout >/dev/null 2>&1
  attempt_failed wrong-email "the profile logged in as $got, not $email; logged out again"
fi
# A success leaves no cool-down: the next logout is served at once.
state_write '$old | del(.[$a])'
revive_rc=0
run_bounded "$revive_timeout" "$claudeb_bin" revive "$account" >"$work/revive.out" 2>&1 || revive_rc=$?
if [ "$revive_rc" -ne 0 ]; then
  verdict 9 revive-failed "$account is logged in as $email, but claudeb revive exited $revive_rc: $(tail -n 1 "$work/revive.out")"
fi
token_journal "$account" relogin success
printf 'RELOGIN: %s logged in as %s; revived\n' "$account" "$email"
exit; }

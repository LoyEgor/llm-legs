#!/usr/bin/env bash
# claude-relogin — `relogin claude`: logs a logged-out Claude account back in with no password (bin/relogin).
# usage: claude-relogin <account> [--on <node>] [--dry-run]
{
source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  directory=$(cd -P "$(dirname "$source")" && pwd)
  source=$(readlink "$source")
  [[ "$source" = /* ]] || source="$directory/$source"
done
exec "$(cd -P "$(dirname "$source")" && pwd)/relogin" claude "$@"
exit; }

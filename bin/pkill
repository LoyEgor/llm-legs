#!/bin/bash
{
set -u

tool=${0##*/}
case "$tool" in
  pkill|pgrep) ;;
  *) printf '%s: invoke as pkill or pgrep\n' "$tool" >&2; exit 2 ;;
esac
real="${PKILL_GUARD_REAL_DIR:-/usr/bin}/$tool"

refuse() {
  printf '%s: refused: option %s comes after the first pattern. macOS %s stops reading options at the first pattern, so %s would become another pattern that can match unrelated processes (every Claude Bash tool shell contains `pwd -P`). Put every option before the pattern, e.g. `%s -f -P 123 pattern`; a pattern that starts with - goes after `--`.\n' \
    "$tool" "'$1'" "$tool" "'$1'" "$tool" >&2
  exit 2
}

# BSD getopt does not permute: the first non-option ends option parsing, so a later -P is a pattern.
args=("$@")
i=0
n=${#args[@]}
if [ "$tool" = pkill ] && [ "$n" -gt 0 ]; then
  sig=${args[0]}
  case "$sig" in
    -[0-9]*) i=1 ;;
    -?*)
      sig=${sig#-}
      shopt -s nocasematch
      # The builtin also knows trap's pseudo-signals, which /bin/kill -l does not list.
      case "$sig" in
        exit|err|debug|return|sig|*[!a-z0-9]*) ;;
        *) kill -l "$sig" >/dev/null 2>&1 && i=1 ;;
      esac
      shopt -u nocasematch ;;
  esac
fi
first=$i
while [ "$i" -lt "$n" ]; do
  arg=${args[$i]}
  i=$((i + 1))
  case "$arg" in
    --) i=$n; break ;;
    -?*) ;;
    *) break ;;
  esac
  rest=${arg#-}
  while [ -n "$rest" ]; do
    c=${rest:0:1}
    rest=${rest:1}
    case "$c" in
      [FGPUcdgtu])
        [ -z "$rest" ] && i=$((i + 1))
        break ;;
    esac
  done
done
while [ "$i" -lt "$n" ]; do
  case "${args[$i]}" in -*) refuse "${args[$i]}" ;; esac
  i=$((i + 1))
done

# A worker run in a worktree leaves alone the matches working in another worktree or in the main
# checkout: a pattern like `pkill -f run-all` also ended seven other runs' suites (night 3131, 14:07).
top=''
[ "$tool" != pkill ] || [ -z "${WORKER_RUN_ID:-}" ] || [ "$n" -le "$first" ] || top=$(git rev-parse --show-toplevel 2>/dev/null)
case $top in
  */.claude/worktrees/?*)
    pids=$("${real%/*}/pgrep" "${args[@]:first}" 2>/dev/null) || exec "$real" "$@"
    case $pids in *[!0-9$'\n']*) exec "$real" "$@" ;; esac
    name=${top##*/} main=${top%/.claude/worktrees/*} own=() foreign=() far=' ' pid=''
    while read -r field; do
      case $field in
        p*) pid=${field#p} ;;
        n*)
          case ${field#n}/ in
            */.claude/worktrees/"$name"/*) ;;
            */.claude/worktrees/*|"$main"/*) foreign+=("$pid in ${field#n}") far+="$pid " ;;
          esac ;;
      esac
    done < <(/usr/sbin/lsof -a -d cwd -p "$(paste -sd, - <<<"$pids")" -Fn 2>/dev/null)
    for pid in $pids; do
      case $far in *" $pid "*) ;; *) [ "$pid" = $$ ] || own+=("$pid") ;; esac
    done
    [ ${#foreign[@]} -eq 0 ] ||
      printf '%s: left alone %s matching process(es) working in another checkout: %s\n' \
        "$tool" "${#foreign[@]}" "$(IFS=,; printf '%s' "${foreign[*]}" | sed 's/,/, /g')" >&2
    [ ${#own[@]} -gt 0 ] || exit 1
    sig=TERM
    [ "$first" -eq 0 ] || sig=$(printf '%s' "${args[0]#-}" | tr '[:lower:]' '[:upper:]')
    exec /bin/kill -"${sig#SIG}" "${own[@]}" ;;
esac

exec "$real" "$@"
exit; }

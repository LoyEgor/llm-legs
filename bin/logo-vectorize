#!/usr/bin/env bash
{
set -euo pipefail

BENCH=${LOGO_BENCH:-/Volumes/Work/Projects/logo-vectorizer-bench}

usage() {
  printf 'usage: logo-vectorize --in <absolute image> --dest <absolute .svg> [--size 512|native] [--auto no] [--dry-run]\n' >&2
  printf '                      [--gradient yes|no] [--colors N] [--palette #rrggbb,#rrggbb,...]\n' >&2
  printf '  traces a logo or icon bitmap (PNG, JPEG, WebP; flat colours and gradients) into an SVG with the\n' >&2
  printf '  logo bench'\''s stable champion (%s/tracers/stable); local, free, ~2-5 min per image\n' "$BENCH" >&2
  printf '  By default (auto=on) it first decides whether the art is flat and how many colours it has: flat art takes a\n' >&2
  printf '  palette path that keeps colours apart, kept only when it loses nothing the champion keeps; gradients, JPEG,\n' >&2
  printf '  transparency, blur and art under 300 px get the champion unchanged. On unseen logos judges preferred it to\n' >&2
  printf '  the champion alone on 29, the champion on 8, no element lost. Rough print art (linocut, stamp, woodcut: a few\n' >&2
  printf '  inks with grain and ragged edges), JPEG included, is detected and traced flat with its roughness kept, without\n' >&2
  printf '  the champion (judges preferred it on 21 of 21 unseen tiles). Pixel art (8-bit logos on a coarse square grid), JPEG\n' >&2
  printf '  included, is detected and traced as exact square cells in about a second (preferred on 22 of 23 decided unseen\n' >&2
  printf '  tiles). A pale tinted background keeps its input colour instead of turning pure white; white details inside\n' >&2
  printf '  the logo stay white; a faint soft shadow beside dark letters stays white ground instead of a grey band; a grey\n' >&2
  printf '  edge bar no longer shows through as grey slivers along lines inside the logo; flat art printed with a darker\n' >&2
  printf '  rim and mottled fill (worn-print look) keeps its few flat colours instead of patches of extra shades.\n' >&2
  printf '  --auto no runs the champion alone\n' >&2
  printf '  --size native (default) traces up to 1024 px as given (finer edges). Flat opaque PNG of 300 px or more takes the\n' >&2
  printf '  palette path at any size; on the fallback most post-steps match the bench sizes (256/512/1024) exactly, so other\n' >&2
  printf '  sizes (e.g. 257-511 px tiles) get the core trace plus crack/spike repair; above 512 px soft art gets the core steps)\n' >&2
  printf '  --size 512 fits the long side into 512 px (use it for blurred or soft art)\n' >&2
  printf '  --dry-run prints the champion, the source size and the traced size, and writes nothing\n' >&2
  printf '  Hints: rerun with them only after looking at a default output that mixes or loses colours:\n' >&2
  printf '  --gradient no   the art is flat: forces the palette path (every gate off), no gradients, no blend fills;\n' >&2
  printf '                  use it when flat shapes got gradients, banding, mottle or in-between edge tones, or (with\n' >&2
  printf '                  --palette) when the default still smoothed rough print art whose torn edges or grain are the design\n' >&2
  printf '  --gradient yes  the art has real gradients (smooth ramps, metallic shading) that came out flat or banded\n' >&2
  printf '  --colors N      N distinct colours, background included (2-16); with --gradient no exactly N fills: missing ones\n' >&2
  printf '                  are searched among pixels no colour or blend explains, never added as blends; alone it keeps\n' >&2
  printf '                  the palette gates, so an input they reject gets the default output\n' >&2
  printf '  --palette L     seed colours (background included), implies --colors; for a colour so close to another\n' >&2
  printf '                  (#f2f2f2 on white) that the search treats it as noise. Fills are refined, not copied exactly\n' >&2
  printf '  Prefer --palette with every visible colour (thin lines included) over --colors: with a count alone, a thin\n' >&2
  printf '  line can take its neighbour'\''s colour or vanish (eye-worse on 15 of 38 AI logos, better on 4). A wrong count\n' >&2
  printf '  merges or splits fills; leave a hint out when unsure. A JPEG of 128 px or less can get jagged edges under\n' >&2
  printf '  --gradient no. Compare a hinted rerun with the input and keep whichever output is closer\n' >&2
  printf '  A colcheck: line after svg= names input colours the output lost, recoloured or mixed, and the hints to rerun\n' >&2
  printf '  with (on AI logos 15 of 18 such lines were right; it misses about 1 loss in 3, so still look)\n' >&2
  exit 2
}

input='' dest='' size=native dry=0 grad='' colors='' palette='' auto=on
while [ $# -gt 0 ]; do
  case "$1" in
    --auto) [ $# -ge 2 ] && [ "$2" = no ] || usage; auto=no; shift 2 ;;
    --in) [ $# -ge 2 ] || usage; input=$2; shift 2 ;;
    --dest) [ $# -ge 2 ] || usage; dest=$2; shift 2 ;;
    --size) [ $# -ge 2 ] && [[ "$2" =~ ^(512|native)$ ]] || usage; size=$2; shift 2 ;;
    --gradient) [ $# -ge 2 ] && [[ "$2" =~ ^(yes|no)$ ]] || usage; grad=$2; shift 2 ;;
    --colors) [ $# -ge 2 ] && [[ "$2" =~ ^([2-9]|1[0-6])$ ]] || usage; colors=$2; shift 2 ;;
    --palette) [ $# -ge 2 ] && [[ "$2" =~ ^#[0-9a-fA-F]{6}(,#[0-9a-fA-F]{6}){1,15}$ ]] || usage; palette=$2; shift 2 ;;
    --dry-run) dry=1; shift ;;
    -h|--help) usage ;;
    *) printf 'logo-vectorize: unknown argument %s\n' "$1" >&2; usage ;;
  esac
done
[ -n "$input" ] && [ -n "$dest" ] || usage
[[ "$input" = /* && "$dest" = /* ]] || { printf 'logo-vectorize: --in and --dest must be absolute paths\n' >&2; exit 2; }
[[ "$dest" = *.svg ]] || { printf 'logo-vectorize: --dest must end in .svg\n' >&2; exit 2; }
[ -f "$input" ] || { printf 'logo-vectorize: no such image %s\n' "$input" >&2; exit 2; }
[ -d "$(dirname "$dest")" ] || { printf 'logo-vectorize: no such directory %s\n' "$(dirname "$dest")" >&2; exit 2; }
[ -x "$BENCH/tracers/stable/run.sh" ] || { printf 'logo-vectorize: no stable champion at %s/tracers/stable\n' "$BENCH" >&2; exit 1; }
runner="$BENCH/tracers/stable/run.sh" hints='' lvauto=''
if [ -n "$grad$colors$palette" ]; then
  runner="$BENCH/tracers/hints-a7/run.sh"
  [ -x "$runner" ] || { printf 'logo-vectorize: no hints tracer at %s/tracers/hints-a7\n' "$BENCH" >&2; exit 1; }
  hints=" hints=gradient:${grad:-auto},colors:${colors:-auto}${palette:+,palette:$palette}"
elif [ "$auto" = on ] && [ -x "$BENCH/tracers/gutter-a2/run.sh" ]; then
  runner="$BENCH/tracers/gutter-a2/run.sh" hints=' auto=on' lvauto=1
fi

champion=$(basename "$(cd -P "$BENCH/tracers/stable" && pwd)")
PY="$BENCH/.venv/bin/python"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

plan=$("$PY" -I - "$input" "$work" "$size" <<'EOF'
import shutil, sys
from PIL import Image
src, work, size = sys.argv[1:]
im = Image.open(src)
fmt, w, h = im.format, *im.size
cap = 512 if size == '512' else 1024
s = min(1, cap / max(w, h))
if s == 1 and fmt in ('PNG', 'JPEG'):
    out = f'{work}/in.{"jpg" if fmt == "JPEG" else "png"}'
    shutil.copyfile(src, out)
else:
    im = im.convert('RGBA' if im.mode in ('RGBA', 'LA', 'P') or 'transparency' in im.info else 'RGB')
    out = f'{work}/in.png'
    im.resize((max(1, round(w * s)), max(1, round(h * s))), Image.LANCZOS).save(out)
print(w, h, *Image.open(out).size, out)
EOF
) || { printf 'logo-vectorize: cannot read %s as an image\n' "$input" >&2; exit 2; }
read -r w h tw th src <<<"$plan"

if [ "$dry" = 1 ]; then
  printf 'champion=%s source=%sx%s traced=%sx%s size=%s%s\n' "$champion" "$w" "$h" "$tw" "$th" "$size" "$hints"
  exit 0
fi

start=$SECONDS
LV_AUTO=$lvauto LV_GRADIENT=${grad:-auto} LV_COLORS=${colors:-auto} LV_PALETTE=$palette BENCH_IN_SLOT=1 BENCH_SLOT_WAIT=86400 \
  nice -n 5 "$runner" "$src" "$work/out.svg" >"$work/log" 2>&1 || true
[ -s "$work/out.svg" ] || { printf 'logo-vectorize: the tracer produced no SVG; last log lines:\n' >&2; tail -5 "$work/log" >&2; exit 1; }
"$PY" -I - "$work/out.svg" "$dest" "$w" "$h" <<'EOF'
import re, sys
svg, dest, w, h = open(sys.argv[1]).read(), *sys.argv[2:]
head = re.match(r'<svg\b[^>]*>', svg).group(0)
new = re.sub(r'\s(width|height)="[^"]*"', '', head)[:-1] + f' width="{w}" height="{h}">'
open(dest, 'w').write(svg.replace(head, new, 1))
EOF
printf 'svg=%s champion=%s source=%sx%s traced=%sx%s seconds=%s%s\n' "$dest" "$champion" "$w" "$h" "$tw" "$th" "$((SECONDS - start))" "$hints"
cc="$BENCH/tracers/colcheck-a2b/check.py" ccpy="$BENCH/tracers/champ47-soft/.venv/bin/python"
[ -f "$cc" ] && [ -x "$ccpy" ] && "$ccpy" -I "$cc" "$src" "$work/out.svg" 2>/dev/null | "$PY" -I -c '
import json, sys
r = json.loads(sys.stdin.read().strip().splitlines()[-1])
if not r["ok"]:
    j = lambda l: ",".join(l) or "-"
    fix = "; rerun with " + r["hint"] + " and keep the output closer to the input" if r["hint"] else ""
    print("colcheck: colours lost=" + j(r["lost"]) + " recoloured=" + j(r["recoloured"]) + " mixed=" + ("yes" if r["mixed"] else "no") + fix)
' 2>/dev/null || true
exit; }

#!/usr/bin/env bash
set -u

usage() {
  printf 'usage: light-research --prompt-file <f> [--prompt-file <f>...] --out <answer-file> --repo <abs> [--repo <abs>...] [--account <n>] [--timeout 360m]\n       light-research --attach <run-id> --out <answer-file>\n' >&2
  exit 2
}

resolve_root() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ "$source" = /* ]] || source="$directory/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}

prompt_files=()
out=''
account=''
timeout_value='360m'
attach=''
repos=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --prompt-file) [ "$#" -ge 2 ] || usage; prompt_files+=("$2"); shift 2 ;;
    --out) [ "$#" -ge 2 ] || usage; out=$2; shift 2 ;;
    --repo) [ "$#" -ge 2 ] || usage; repos+=("$2"); shift 2 ;;
    --account) [ "$#" -ge 2 ] || usage; account=$2; shift 2 ;;
    --timeout) [ "$#" -ge 2 ] || usage; timeout_value=$2; shift 2 ;;
    --attach) [ "$#" -ge 2 ] || usage; attach=$2; shift 2 ;;
    *) usage ;;
  esac
done

[ -n "$out" ] && [ -d "$(dirname "$out")" ] || usage
out_dir=$(cd "$(dirname "$out")" && pwd -P) || usage
out="$out_dir/${out##*/}"
root=$(resolve_root)
worker_run="$root/bin/worker-run"
. "$root/share/light-research.sh"
. "$root/share/web-search.sh"
# One round per call: the agent's Bash call must return inside the tool's 10-minute cap, and a run
# still going is handed back as `RUN:`/`STATUS: running` for `--attach` to continue.
wait_max=${LIGHT_RESEARCH_WAIT_MAX:-540}
start_seconds=$SECONDS

unavailable() { # vendor reason
  printf 'OUTCOME: %s_UNAVAILABLE\nlight-research: %s\n' "$(tr '[:lower:]' '[:upper:]' <<<"$1")" "$2"
  exit 4
}

wait_budget() { # the whole call gets one round, however many runs share it
  local left=$((wait_max - (SECONDS - start_seconds)))
  [ "$left" -ge 0 ] || left=0
  printf '%s\n' "$left"
}

# A usage limit outranks every other failure of a batch: it is the one the caller routes on.
code_rank() { case "$1" in 3) printf '3\n' ;; 5) printf '2\n' ;; 4) printf '1\n' ;; *) printf '0\n' ;; esac; }

COLLECT_RUNNING=false
collect_run() { # run-id run-dir part-file
  local state account vendor code log web
  COLLECT_RUNNING=false
  state=$("$worker_run" wait "$1" --max "$(wait_budget)") || { printf '%s\n' "$state"; return 4; }
  case "$state" in
    *'STATUS: running'*) COLLECT_RUNNING=true; printf 'RUN: %s\nSTATUS: running\n' "$1"; return 0 ;;
  esac
  printf '%s\n' "$state"
  account=$(jq -r .account "$2/meta.json")
  vendor=$(jq -r .vendor "$2/meta.json")
  log="$2/log"
  [ -f "$log" ] || log="$2/err"
  web=$(web_search_meta_state "$2/meta.json")
  printf 'ACCOUNT: %s (%s)\nWEB: %s\nLOG: %s\n' "$account" "$vendor" "$web" "$log"
  code=$(cat "$2/exit_code" 2>/dev/null) || return 4
  [[ "$code" =~ ^[0-9]+$ ]] || return 4
  if [ "$code" = 0 ] && grep -qx 'STATUS: done' <<<"$state"; then
    if [ -f "$2/result" ]; then cp "$2/result" "$3"; else cp "$2/out" "$3"; fi || return 4
    return 0
  fi
  case "$(sed -n 's/^OUTCOME: //p' <<<"$state" | tail -n1)" in
    *_USAGE_LIMIT*) return 3 ;;
    READ_ONLY_VIOLATION*) return 5 ;;
  esac
  return 4
}

land_answer() { # combined-file repo-root...
  local combined=$1 counts lines verified total links
  shift
  counts=$(research_citation_check "$combined" "$out" "$@") || return 4
  read -r verified total links <<<"$counts"
  lines=$(wc -l <"$out" | tr -d '[:space:]')
  printf 'CITATIONS: %s/%s\nLINKS: %s\nANSWER: %s\nLINES: %s\n' "$verified" "$total" "$links" "$out" "$lines"
}

# The unit table of a multi-unit call, kept beside the answer file. A batch whose first units are
# done and whose last one is still going has nowhere else to leave them: the work directory dies
# with this process, and `--attach` is a new one. A single-unit call writes none of it.
units_dir="$out.units"
part_dir=''
persist=false
units=0
question_count=0
fanout=false
worst=0
run_ids=()
run_dirs=()
unit_repos=()
unit_questions=()
resolved_repos=()

units_persist() {
  local u
  # A table left by an earlier call to the same --out would hand this batch that call's rc files.
  rm -rf "$units_dir"
  mkdir -p "$units_dir" || return 1
  : >"$units_dir/table" || return 1
  for ((u=0; u<units; u++)); do
    printf '%s\t%s\t%s\t%s\n' "${run_ids[$u]}" "${run_dirs[$u]}" "${unit_questions[$u]}" "${unit_repos[$u]}" \
      >>"$units_dir/table" || return 1
  done
  printf '%s\n' "${resolved_repos[@]}" >"$units_dir/repos" || return 1
  printf '%s\n%s\n%s\n' "$question_count" "$fanout" "$worst" >"$units_dir/shape" || return 1
}

units_load() { # run-id — true when the table holds that run
  local id dir question repo line
  [ -f "$units_dir/table" ] && [ -f "$units_dir/repos" ] && [ -f "$units_dir/shape" ] || return 1
  cut -f1 "$units_dir/table" | grep -qxF -- "$1" || return 1
  run_ids=(); run_dirs=(); unit_questions=(); unit_repos=(); resolved_repos=()
  while IFS=$'\t' read -r id dir question repo; do
    [ -n "$id" ] || continue
    run_ids+=("$id"); run_dirs+=("$dir"); unit_questions+=("$question"); unit_repos+=("$repo")
  done <"$units_dir/table"
  while IFS= read -r line; do [ -n "$line" ] || continue; resolved_repos+=("$line"); done <"$units_dir/repos"
  units=${#run_ids[@]}
  { read -r question_count; read -r fanout; read -r worst; } <"$units_dir/shape"
  [[ "$question_count" =~ ^[0-9]+$ ]] && [[ "$worst" =~ ^[0-9]+$ ]] && [ "$units" -gt 0 ] || return 1
  part_dir=$units_dir
  persist=true
}

# Collect every unit, then assemble — the exit code is the worst rc of the batch whether or not a
# unit is still running, because a usage limit one unit hit is what the caller routes on.
units_finish() {
  local u rc running=false combined repo_heading counts total=0 verified=0 links=0 checked
  local unit_ok unit_total unit_links
  for ((u=0; u<units; u++)); do
    if [ "$persist" = true ] && [ -f "$units_dir/rc.$u" ]; then
      rc=$(tr -d '[:space:]' <"$units_dir/rc.$u")
      [[ "$rc" =~ ^[0-9]+$ ]] || rc=4
    else
      rc=0
      collect_run "${run_ids[$u]}" "${run_dirs[$u]}" "$part_dir/part.$u" || rc=$?
      if [ "$COLLECT_RUNNING" = true ]; then
        running=true
      elif [ "$persist" = true ]; then
        printf '%s\n' "$rc" >"$units_dir/rc.$u"
      fi
    fi
    [ "$(code_rank "$rc")" -le "$(code_rank "$worst")" ] || worst=$rc
  done
  [ "$persist" = false ] || printf '%s\n%s\n%s\n' "$question_count" "$fanout" "$worst" >"$units_dir/shape"
  if [ "$running" = true ]; then
    printf 'OUT: %s\n' "$out"
    return "$worst"
  fi
  [ "$worst" -eq 0 ] || return "$worst"
  for ((u=0; u<units; u++)); do
    checked="$part_dir/checked.$u"
    if [ "$fanout" = true ]; then
      counts=$(research_citation_check "$part_dir/part.$u" "$checked" "${unit_repos[$u]}") || return 4
    else
      counts=$(research_citation_check "$part_dir/part.$u" "$checked" "${resolved_repos[@]}") || return 4
    fi
    read -r unit_ok unit_total unit_links <<<"$counts"
    verified=$((verified + unit_ok))
    total=$((total + unit_total))
    links=$((links + unit_links))
  done
  combined="$part_dir/combined"
  if [ "$units" -eq 1 ]; then
    tail -n +3 "$part_dir/checked.0" >"$combined" || return 4
  else
    repo_heading='##'
    [ "$question_count" -eq 1 ] || repo_heading='###'
    : >"$combined"
    for ((u=0; u<units; u++)); do
      if [ "$question_count" -gt 1 ] && { [ "$u" -eq 0 ] || [ "${unit_questions[$u]}" != "${unit_questions[$((u - 1))]}" ]; }; then
        printf '## Q%s\n\n' "$((${unit_questions[$u]} + 1))" >>"$combined"
      fi
      [ "$fanout" = false ] || printf '%s %s\n\n' "$repo_heading" "${unit_repos[$u]}" >>"$combined"
      tail -n +3 "$part_dir/checked.$u" >>"$combined" || return 4
      printf '\n' >>"$combined"
    done
  fi
  { printf 'CITATIONS: %s/%s\nLINKS: %s\n' "$verified" "$total" "$links"; cat "$combined"; } >"$out" || return 4
  printf 'CITATIONS: %s/%s\nLINKS: %s\nANSWER: %s\nLINES: %s\n' "$verified" "$total" "$links" "$out" "$(wc -l <"$out" | tr -d '[:space:]')"
  return 0
}

if [ -n "$attach" ]; then
  [ "${#prompt_files[@]}" -eq 0 ] && [ "${#repos[@]}" -eq 0 ] && [ -z "$account" ] && [[ "$attach" =~ ^[a-z0-9][a-z0-9-]*$ ]] || usage
  if units_load "$attach"; then
    units_finish
    exit $?
  fi
  run_dir="${WORKER_RUN_DIR:-$HOME/.cache/claude-worker-runs}/$attach"
  [ "$(jq -r '.role // empty' "$run_dir/meta.json" 2>/dev/null)" = research ] ||
    unavailable "${attach%%-*}" "no research run $attach"
  attach_roots=()
  while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    resolved=$(cd "$repo" 2>/dev/null && pwd -P) || resolved=$repo
    case "$out" in "$resolved"|"$resolved"/*) usage ;; esac
    attach_roots+=("$resolved")
  done < <(jq -r '(.workdir // empty), ((.add_dirs // [])[])' "$run_dir/meta.json" 2>/dev/null)
  attach_part=$(mktemp "${TMPDIR:-/tmp}/light-research-part.XXXXXX") || exit 4
  trap 'rm -f "$attach_part"' EXIT
  collect_run "$attach" "$run_dir" "$attach_part" || exit $?
  if [ "$COLLECT_RUNNING" = true ]; then printf 'OUT: %s\n' "$out"; exit 0; fi
  land_answer "$attach_part" "${attach_roots[@]}" || exit 4
  exit 0
fi

[ "${#prompt_files[@]}" -gt 0 ] && [ "${#repos[@]}" -gt 0 ] && [ -n "$timeout_value" ] || usage
for prompt_file in "${prompt_files[@]}"; do [ -r "$prompt_file" ] || usage; done
if [ -n "$account" ] && ! [[ "$account" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then usage; fi

. "$root/share/worker-model.sh"
vendor=$(worker_light_vendor research) && model=$(worker_light_model research) || {
  printf 'OUTCOME: MODEL_REFUSED\n'
  exit 4
}

for repo in "${repos[@]}"; do
  [[ "$repo" = /* ]] && [ -d "$repo" ] || usage
  resolved=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null) || unavailable "$vendor" "not a git repository: $repo"
  resolved=$(cd "$resolved" && pwd -P) || exit 4
  duplicate=false
  for known in "${resolved_repos[@]:-}"; do [ "$known" != "$resolved" ] || duplicate=true; done
  [ "$duplicate" = true ] || resolved_repos+=("$resolved")
done
for repo in "${resolved_repos[@]}"; do
  case "$out" in "$repo"|"$repo"/*) usage ;; esac
done

timeout_seconds=$(research_duration_seconds "$timeout_value") && [ "$timeout_seconds" -gt 0 ] || usage

work=$(mktemp -d "${TMPDIR:-/tmp}/light-research.XXXXXX") || exit 4
trap 'rm -rf "$work"' EXIT

if research_fans_out_per_repo "$vendor" && [ "${#resolved_repos[@]}" -gt 1 ]; then fanout=true; fi
geminib_bin=''
if [ "$vendor" = gemini ]; then
  geminib_bin=$(command -v geminib 2>/dev/null) || unavailable gemini 'geminib is missing'
fi

launch_failed=0
for ((question=0; question<${#prompt_files[@]}; question++)); do
  if [ "$fanout" = true ]; then targets=("${resolved_repos[@]}"); else targets=("${resolved_repos[0]}"); fi
  for target in "${targets[@]}"; do
    brief="$work/brief.$units"
    { [ "$fanout" = false ] || printf 'REPOSITORY: %s\n\n' "$target"
      cat "${prompt_files[$question]}"
      printf '\n%s\n' "$LIGHT_RESEARCH_CONTRACT"; } >"$brief" || exit 4
    args=(start "$vendor" --role research --model "$model" --brief "$brief" --workdir "$target" --research-timeout "$timeout_value")
    [ -z "$account" ] || args+=(--account "$account")
    if [ "$fanout" = false ]; then
      for ((i=1; i<${#resolved_repos[@]}; i++)); do args+=(--add-dir "${resolved_repos[$i]}"); done
    fi
    start_rc=0
    if [ "$vendor" = gemini ]; then
      launch=$(WORKER_RUN_GEMINIB="$geminib_bin" \
        GEMINI_RESEARCH_SANDBOX_EXEC="${GEMINI_RESEARCH_SANDBOX_EXEC:-/usr/bin/sandbox-exec}" \
        "$worker_run" "${args[@]}") || start_rc=$?
    else
      launch=$("$worker_run" "${args[@]}") || start_rc=$?
    fi
    printf '%s\n' "$launch"
    # The units already launched are spending accounts of their own: abandoned here, they run to
    # the end with nothing waiting on them and no answer anybody reads.
    [ "$start_rc" -eq 0 ] || { launch_failed=$start_rc; break 2; }
    run_id=$(sed -n 's/^RUN: //p' <<<"$launch" | head -n1)
    run_dir=$(sed -n 's/^DIR: //p' <<<"$launch" | head -n1)
    [ -n "$run_id" ] && [ -r "$run_dir/meta.json" ] || { launch_failed=4; break 2; }
    run_ids+=("$run_id")
    run_dirs+=("$run_dir")
    unit_repos+=("$target")
    unit_questions+=("$question")
    units=$((units + 1))
  done
done

[ "$units" -gt 0 ] || exit "$launch_failed"
worst=$launch_failed
question_count=${#prompt_files[@]}
if [ "$units" -gt 1 ]; then
  persist=true
  part_dir=$units_dir
  units_persist || exit 4
else
  part_dir=$work
fi
units_finish
exit $?

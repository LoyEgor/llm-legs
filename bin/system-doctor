def write_json(path, value, indent=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    temporary = "%s.%d.tmp" % (path, os.getpid())
    with open(temporary, "w", encoding="utf-8") as handle:
        json.dump(value, handle, ensure_ascii=False, indent=indent, separators=None if indent else (",", ":"))
        handle.write("\n")
    os.replace(temporary, path)


def read_lines(path):
    rows = []
    try:
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                if isinstance(row, dict):
                    rows.append(row)
    except OSError:
        pass
    return rows


def write_lines(path, rows):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    temporary = "%s.%d.tmp" % (path, os.getpid())
    with open(temporary, "w", encoding="utf-8") as handle:
        handle.write("".join(json.dumps(r, separators=(",", ":")) + "\n" for r in rows))
    os.replace(temporary, path)


def local_day(epoch):
    return time.strftime("%Y-%m-%d", time.localtime(epoch))


def iso_time(epoch):
    if epoch is None:
        return None
    return datetime.datetime.fromtimestamp(epoch).astimezone().isoformat(timespec="seconds")


def iso_epoch(text):
    try:
        return datetime.datetime.fromisoformat(str(text).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def clip(text, limit=EXCERPT_MAX):
    text = text or ""
    return text if len(text) <= limit else text[: limit - 1] + "…"


class Steps:
    """Wall and CPU (own plus reaped children) per collector step."""

    def __init__(self):
        self.out = {}

    def __call__(self, name, fn, *args):
        wall, cpu = time.time(), collector_runs.cpu_total()
        try:
            return fn(*args)
        finally:
            self.out[name] = [round(time.time() - wall, 3), round(collector_runs.cpu_total() - cpu, 3)]


# ---------------------------------------------------------------- probes


def cpu_seconds(text):
    days, _, clock = text.rpartition("-")
    total = 0.0
    for part in clock.split(":"):
        try:
            total = total * 60 + float(part.replace(",", "."))
        except ValueError:
            return 0.0
    return (int(days) if days.isdigit() else 0) * DAY_S + total


def exe_and_rest(args):
    match = APP_EXE.match(args)
    if match:
        return match.group(1), args[match.end():].split()
    words = args.split()
    return (words[0] if words else ""), words[1:]


def interpreter(name):
    return name in INTERPRETERS or bool(re.match(r"python3\.\d+$", name or ""))


@functools.lru_cache(maxsize=None)
def repos_top():
    return os.path.realpath(repos_dir()).rstrip("/") + "/"


def path_owner(path, roots):
    if path.startswith(roots) or path.startswith(repos_top()):
        return "own"
    return "apple" if path.startswith(APPLE_PREFIXES) and not path.startswith("/usr/local/") else "third-party"


@functools.lru_cache(maxsize=None)
def script_name(path):
    """`repo/path` of a script inside a repository beside ours (a worktree folds into its repository), else its
    basename with unique numbers cut."""
    real, top = os.path.realpath(path), repos_top()
    if real.startswith(top):
        parts = real[len(top):].split("/")
        if parts[1:3] == [".claude", "worktrees"] and len(parts) > 4:
            parts = parts[:1] + parts[4:]
        return "/".join(parts)[:120]
    return re.sub(r"\d{6,}.*?(?=\.\w+$|$)", "N", os.path.basename(path))[:40] or "?"


@functools.lru_cache(maxsize=None)
def module_file(module, bases):
    for base in bases:
        for tail in (".py", "/__main__.py"):
            path = os.path.join(base, module.replace(".", "/") + tail)
            if os.path.isfile(path):
                return path
    return None


def family(name):
    return "python" if name.startswith("python") or name == "Python" else "shell" if name in SHELLS else name


def script_of(name, exe, rest, cwd):
    """(kind, script) of what an interpreter's argv runs: ('file', path) for the first non-option argument, ('module',
    file or name) for `-m`, ('inline', None) for code inline (`-c`, `-e`); None when nothing names one."""
    words = iter(rest[:ARGV_WORDS])
    for word in words:
        kind = family(name)
        if word == "-":
            return "inline", None
        if word.startswith("-"):
            if kind == "python" and re.match(r"^-[bBdEhiIOPqRsSuvVx]*m", word):
                module = word.split("m", 1)[1] or next(words, "")
                venv = re.match(r"^(.*?)/\.?venv/", exe)
                bases = tuple(b for b in (cwd() if cwd else None, venv.group(1) if venv else None) if b)
                return ("module", module_file(module, bases) or module) if module else None
            if word in INLINE_OPTS.get(kind, ()) or re.match(INLINE_BUNDLED.get(kind, "$^"), word) or \
                    kind == "shell" and re.match(r"^-[A-Za-z]*c[A-Za-z]*$", word) or \
                    kind == "python" and re.match(r"^-[bBdEhiIOPqRsSuvVx]*c$", word):
                return "inline", None
            if word in VALUE_OPTS.get(kind, ()):
                next(words, None)
            continue
        if interpreter(os.path.basename(word)):
            name, exe = os.path.basename(word), word
            continue
        if re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", word) or word == "run" and kind in RUNNERS:
            continue
        path = os.path.expanduser(word)
        if not os.path.isabs(path):
            base = cwd() if cwd else None
            path = os.path.join(base, path) if base else None
        return ("file", path) if path else None
    return None


def describe(exe, rest, roots, cwd=None):
    """(tag, owner, kind) of one process from its argv held in memory only. An interpreter is tagged by the script it
    runs (`repo/path` beside ours, else its basename; a `-m` module by its file, else its name) with kind `script`; one
    running inline code is kind `inline` and takes its parent's script; everything else is its executable's name."""
    name = os.path.basename(exe).lstrip("-")[:40] or "?"
    found = script_of(name, exe, rest, cwd) if interpreter(name) else None
    if found and found[0] == "inline":
        return name, path_owner(exe, roots), "inline"
    if found and (found[0] == "file" or os.path.isabs(found[1])):
        owners = {path_owner(found[1], roots), path_owner(os.path.realpath(found[1]), roots)}
        return script_name(found[1]), "own" if "own" in owners else owners.pop(), "script"
    if found:
        return found[1][:80], path_owner(exe, roots), "script"
    if name in OWN_APPS or exe.startswith(roots):
        return name, "own", None
    if exe.startswith(APPLE_PREFIXES) and not exe.startswith("/usr/local/"):
        return name, "apple", None
    return name, "third-party", None


def classify(args, uid, roots, cwd=None):
    """(tag, owner) of one process from its argv: an interpreter by the script it runs, else its executable."""
    exe, rest = exe_and_rest(args)
    return describe(exe, rest, roots, cwd)[:2]


def inherit(procs, inline, by_pid):
    """Inline code (`bash -c`, `python3 -c`) takes the script of its parent, through inline parents only."""
    for key in inline:
        entry, pid, depth = procs[key], procs[key][0], 0
        while pid in by_pid and depth < 6:
            parent = procs[by_pid[pid]]
            if parent[6] == "script":
                entry[2], entry[3], entry[6] = parent[2], parent[3], "script"
            if parent[6] != "inline":
                break
            pid, depth = parent[0], depth + 1


def ps_snapshot(with_children):
    """{key: [ppid, cpu_s, tag, owner, pid, uid, kind]} keyed `pid@lstart`, plus the probe's own pid; kind is `script`
    for an interpreter tagged by its script."""
    args = ["-A"] + (["-S"] if with_children else []) + ["-o", "pid=,ppid=,uid=,time=,lstart=,args="]
    pid, out = machine_probe.spawn("ps", args)
    roots = own_roots()
    procs, inline = {}, []
    for line in out.splitlines():
        match = ROW.match(line)
        if not match:
            continue
        number, ppid, uid, cpu, start, argv = match.groups()
        exe, rest = exe_and_rest(argv)
        tag, owner, kind = describe(exe, rest, roots, functools.partial(machine_probe.proc_cwd, int(number)))
        key = "%s@%s" % (number, " ".join(start.split()))
        procs[key] = [int(ppid), cpu_seconds(cpu), tag, owner, int(number), int(uid), kind]
        if kind == "inline":
            inline.append(key)
    inherit(procs, inline, {entry[4]: key for key, entry in procs.items()})
    return pid, procs


def causer(key, procs, by_pid):
    """The nearest own script or app above a newborn; else its parent's name."""
    chain, pid = [], procs[key][0]
    while pid > 1 and len(chain) < 12 and pid in by_pid:
        entry = procs[by_pid[pid]]
        chain.append(entry)
        pid = entry[0]
    for entry in chain:
        if entry[3] == "own" or entry[2] in CAUSER_APPS:
            return entry[2], entry[3]
    for entry in chain:
        if entry[2] not in INTERPRETERS:
            return entry[2], entry[3]
    return (chain[0][2], chain[0][3]) if chain else ("launchd", "apple")


def own_usage(procs):
    """{key: (footprint, read B, written B, idle wakeups)} of the own processes proc_pid_rusage can read."""
    out = {}
    for key, entry in procs.items():
        if entry[3] == "own":
            found = machine_probe.proc_rusage(entry[4])
            if found:
                out[key] = found
    return out


def births_rate(first_pid, last_pid, seconds, own_spawns=1):
    if first_pid is None or last_pid is None or seconds <= 0:
        return None
    return max(0, (last_pid - first_pid) % PID_WRAP - own_spawns) / seconds


def vm_counters():
    out = machine_probe.run("vm_stat", [])
    page = re.search(r"page size of (\d+) bytes", out)
    values = {"page": int(page.group(1)) if page else 16384}
    for name, key in (("Pages occupied by compressor", "comp_pages"), ("Pages stored in compressor", "stored_pages"),
                      ("Pageins", "pageins"), ("Swapins", "swapins"), ("Swapouts", "swapouts")):
        found = re.search(r"^%s:\s+(\d+)" % re.escape(name), out, re.M)
        if found:
            values[key] = int(found.group(1))
    return values


def memory_sysctls():
    boot, memsize, swap = machine_probe.sysctl("kern.boottime", "hw.memsize", "vm.swapusage")
    found = re.search(r"sec = (\d+)", boot)
    used, total = re.search(r"used = ([\d.]+)M", swap), re.search(r"total = ([\d.]+)M", swap)
    return {"boot": int(found.group(1)) if found else None,
            "mem": int(memsize) if memsize.strip().isdigit() else None,
            "swap_used_mb": float(used.group(1)) if used else None,
            "swap_total_mb": float(total.group(1)) if total else None}


def disk_counters():
    """{label: [bytes read, bytes written]} per block storage device, label `internal:<bsd>` or `external:<bsd>`."""
    out = machine_probe.run("ioreg", ["-r", "-c", "IOBlockStorageDevice", "-w0", "-d", "3", "-l"])
    disks = {}
    for block in re.split(r"(?m)^\+-o ", out)[1:]:
        location = re.search(r'"Physical Interconnect Location"="(\w+)"', block)
        read, wrote = re.search(r'"Bytes \(Read\)"=(\d+)', block), re.search(r'"Bytes \(Write\)"=(\d+)', block)
        bsd = re.search(r'"BSD Name" = "(disk\d+)"', block)
        if read and wrote:
            label = "%s:%s" % ((location.group(1) if location else "unknown").lower(), bsd.group(1) if bsd else "?")
            disks[label] = [int(read.group(1)), int(wrote.group(1))]
    return disks


def free_space():
    """{volume: [free GiB, size GiB]} for the data volume and every local /Volumes mount."""
    volumes = {}
    for line in machine_probe.run("df", ["-k", "-l"]).splitlines()[1:]:
        words = line.split()
        if len(words) < 9 or not words[1].isdigit() or not words[3].isdigit():
            continue
        mount = " ".join(words[8:])
        if mount == "/System/Volumes/Data":
            name = "Data"
        elif mount.startswith("/Volumes/"):
            name = mount[len("/Volumes/"):]
        else:
            continue
        volumes[name] = [round(int(words[3]) * 1024 / GIB, 1), round(int(words[1]) * 1024 / GIB, 1)]
    return volumes


# ---------------------------------------------------------------- light tick


def top_rows(counter, width=TOP):
    return [list(row) for row in sorted(counter, key=lambda r: (-r[1], r[0]))[:width]]


def tick(now=None):
    """One sample row in ticks/<day>.jsonl; state between ticks in tick-state.json."""
    started_cpu = collector_runs.cpu_total()
    now = time.time() if now is None else now
    steps = Steps()
    path = os.path.join(state_dir(), "tick-state.json")
    previous = read_json(path, {}) or {}
    window = float(os.environ.get("SYSTEM_DOCTOR_WINDOW_S") or 2.0)

    ticks = steps("host", machine_probe.host_ticks)
    repos_top()
    first_at = time.monotonic()
    first_pid, first = steps("ps", ps_snapshot, False)
    time.sleep(max(0.0, first_at + window - time.monotonic()))
    seconds = time.monotonic() - first_at
    last_pid, last = steps("ps_children", ps_snapshot, True)
    vm = steps("vm_stat", vm_counters)
    mem = steps("sysctl", memory_sysctls)
    disks = steps("ioreg", disk_counters)
    volumes = steps("df", free_space)
    usage = steps("rusage", own_usage, last)

    gap = now - previous["t"] if isinstance(previous.get("t"), (int, float)) else None
    joined = gap is not None and 0 < gap <= TICK_GAP_S and previous.get("boot") == mem["boot"]
    row = {"t": round(now, 1), "dt": round(gap, 1) if joined else None, "boot": mem["boot"],
           "births_s": None, "kernel": None, "busy": None, "procs": len(last)}

    rate = births_rate(first_pid, last_pid, seconds)
    row["births_s"] = round(rate) if rate is not None else None
    born = [key for key, entry in last.items() if key not in first and entry[4] != last_pid]
    by_pid = {entry[4]: key for key, entry in last.items()}
    births = {}
    for key in born:
        name = causer(key, last, by_pid)
        births[name] = births.get(name, 0) + 1
    row["births_seen"] = len(born)
    row["births_top"] = top_rows([[tag, n, owner] for (tag, owner), n in births.items()])

    old_ticks = previous.get("ticks")
    if ticks and old_ticks and joined:
        delta = [(b - a) % (1 << 32) for a, b in zip(old_ticks, ticks)]
        total = sum(delta)
        if total > 0:
            row["kernel"] = round(delta[1] / total, 3)
            row["busy"] = round((delta[0] + delta[1] + delta[3]) / total, 3)

    page = vm.get("page", 16384)
    if mem["mem"]:
        row["mem_gib"] = round(mem["mem"] / GIB, 1)
        if "comp_pages" in vm:
            row["comp_share"] = round(vm["comp_pages"] * page / mem["mem"], 3)
            row["comp_gib"] = round(vm["comp_pages"] * page / GIB, 2)
        if "stored_pages" in vm:
            row["stored_gib"] = round(vm["stored_pages"] * page / GIB, 2)
    if mem["swap_used_mb"] is not None:
        row["swap_used_mb"] = mem["swap_used_mb"]
        row["swap_total_mb"] = mem["swap_total_mb"]
        row["swap_share"] = round(mem["swap_used_mb"] / mem["swap_total_mb"], 3) if mem["swap_total_mb"] else 0.0
    old_vm = previous.get("vm") or {}
    if joined:
        for key, out in (("pageins", "pagein_s"), ("swapins", "swapin_s")):
            if key in vm and key in old_vm and vm[key] >= old_vm[key]:
                row[out] = round((vm[key] - old_vm[key]) / gap, 1)
        if "swapouts" in vm and "swapouts" in old_vm and vm["swapouts"] >= old_vm["swapouts"]:
            row["swapout_b"] = (vm["swapouts"] - old_vm["swapouts"]) * page
        old_disks = previous.get("disks") or {}
        row["disk"] = {label: [r - old_disks[label][0], w - old_disks[label][1]] for label, (r, w) in disks.items()
                       if label in old_disks and r >= old_disks[label][0] and w >= old_disks[label][1]}
    row["free_gib"] = {name: free for name, (free, _size) in volumes.items()}

    cpu = {}
    old_procs = previous.get("procs") or {}
    charged = {}
    for key, kept in old_procs.items():
        if key not in last and len(kept) >= 4:
            charged[kept[3]] = charged.get(kept[3], 0.0) + max(0.0, kept[1] - kept[2])
    for key, entry in last.items():
        own_now = first.get(key)
        before = old_procs.get(key)
        if not joined or own_now is None or before is None:
            continue
        spent, own = entry[1] - before[1], own_now[1] - before[0]
        if spent < 0 or own < 0:
            continue
        reaped = max(0.0, spent - own)
        # a reaped child's whole lifetime lands in its parent's -S time, though its ticks already charged part of it
        twice = min(reaped, charged.pop(entry[4], 0.0))
        spent, reaped = spent - twice, reaped - twice
        if spent > 0:
            slot = cpu.setdefault((entry[2], entry[3]), [0.0, 0.0])
            slot[0] += spent
            slot[1] += reaped
    row["cpu_top"] = top_rows([[tag, round(s, 2), round(r, 2), owner] for (tag, owner), (s, r) in cpu.items()])

    row["own_procs"] = sum(1 for entry in last.values() if entry[3] == "own")
    row["usage_read"] = len(usage)
    held, moved = {}, {}
    old_usage = previous.get("usage") or {}
    for key, (footprint, read, written, wakes) in usage.items():
        tag = (last[key][2], last[key][3])
        held[tag] = held.get(tag, 0) + footprint
        before = old_usage.get(key)
        if joined and before and read >= before[0] and written >= before[1] and wakes >= before[2]:
            slot = moved.setdefault(tag, [0, 0, 0])
            slot[0] += written - before[1]
            slot[1] += read - before[0]
            slot[2] += wakes - before[2]
    row["mem_top"] = top_rows([[tag, footprint, owner] for (tag, owner), footprint in held.items()])
    row["io_top"] = top_rows([[tag, w, r, k, owner] for (tag, owner), (w, r, k) in moved.items() if w or r or k])

    state = {"t": now, "boot": mem["boot"], "ticks": ticks, "vm": vm, "disks": disks,
             "procs": {key: [first[key][1], entry[1], old_procs[key][2] if joined and len(old_procs.get(key) or ()) >= 4
                             else entry[1], entry[0]] for key, entry in last.items() if key in first},
             "usage": {key: [read, written, wakes] for key, (_f, read, written, wakes) in usage.items()},
             "recent": (previous.get("recent") or [])[-2:] + [{"t": round(now, 1), "births_s": row["births_s"],
                                                              "kernel": row["kernel"]}],
             "named": {key: entry[2:4] for key, entry in last.items() if entry[6] == "script" and key in first}}
    gone = [[int(key.split("@", 1)[0]), start_epoch(key), previous["t"]] + list(named)
            for key, named in (previous.get("named") or {}).items() if key not in last and isinstance(previous.get("t"), (int, float))]
    if gone:
        append_row("pids", {"t": round(now, 1), "gone": gone}, REPORT_DAYS + 1)
    write_json(path, state)
    row["self"] = {"wall_s": round(time.time() - now, 3), "cpu_s": round(collector_runs.cpu_total() - started_cpu, 3),
                   "steps": steps.out}
    folder = os.path.join(state_dir(), "ticks")
    os.makedirs(folder, exist_ok=True)
    with open(os.path.join(folder, local_day(now) + ".jsonl"), "a", encoding="utf-8") as handle:
        handle.write(json.dumps(row, separators=(",", ":")) + "\n")
    return row


# ---------------------------------------------------------------- rollups


def tick_rows(since, until, sub="ticks"):
    names, at = set(), since
    while at < until + 6 * HOUR_S:
        names.add(local_day(min(at, until)))
        at += 6 * HOUR_S
    rows = [row for name in sorted(names) for row in read_lines(os.path.join(state_dir(), sub, name + ".jsonl"))
            if isinstance(row.get("t"), (int, float)) and since <= row["t"] <= until]
    rows.sort(key=lambda r: r["t"])
    return rows


def merge_top(rows, key, value_at=1, width=TOP):
    merged = {}
    for row in rows:
        for entry in row.get(key) or ():
            slot = merged.setdefault((entry[0], entry[-1]), [0.0] * (len(entry) - 2))
            for index in range(len(slot)):
                slot[index] += entry[value_at + index]
    return [[tag] + [round(v, 2) for v in values] + [owner]
            for (tag, owner), values in sorted(merged.items(), key=lambda kv: (-kv[1][0], kv[0][0]))[:width]]


def mean(values):
    values = [v for v in values if v is not None]
    return sum(values) / len(values) if values else None


def summarize(rows):
    covered = sum(r["dt"] for r in rows if r.get("dt"))
    out = {"ticks": len(rows), "covered_s": round(covered),
           "births_s": round(mean(r.get("births_s") for r in rows) or 0) if rows else None,
           "kernel": round(mean(r.get("kernel") for r in rows), 3) if mean(r.get("kernel") for r in rows) is not None else None,
           "comp_share_max": max((r.get("comp_share") or 0 for r in rows), default=None),
           "swap_share_max": max((r.get("swap_share") or 0 for r in rows), default=None),
           "ssd_w_b": sum(w for r in rows for label, (_r, w) in (r.get("disk") or {}).items() if label.startswith("internal")),
           "ssd_r_b": sum(rd for r in rows for label, (rd, _w) in (r.get("disk") or {}).items() if label.startswith("internal")),
           "ext_r_b": sum(rd for r in rows for label, (rd, _w) in (r.get("disk") or {}).items() if label.startswith("external")),
           "swapout_b": sum(r.get("swapout_b") or 0 for r in rows),
           "tick_cpu_s": round(sum((r.get("self") or {}).get("cpu_s") or 0 for r in rows), 2),
           "births_top": merge_top(rows, "births_top"), "cpu_top": merge_top(rows, "cpu_top")}
    free = {}
    for row in rows:
        for name, gib in (row.get("free_gib") or {}).items():
            free[name] = min(gib, free.get(name, gib))
    out["free_min_gib"] = free
    if covered >= COVER_MIN_S:
        out["ssd_gb_day"] = round(out["ssd_w_b"] / covered * DAY_S / 1e9, 1)
        out["ssd_read_gb_day"] = round(out["ssd_r_b"] / covered * DAY_S / 1e9, 1)
        out["swap_gib_day"] = round(out["swapout_b"] / covered * DAY_S / GIB, 2)
    return out


def rollup(now, rows, persist=True):
    """Hourly rollups of today and yesterday (hours/<day>.jsonl, 90 days) and their daily rows (days.jsonl, kept
    forever) off the minute rows `rows`, which cover both days; minute rows older than 14 days are deleted."""
    base = state_dir()
    days_path = os.path.join(base, "days.jsonl")
    days = {r["day"]: r for r in read_lines(days_path) if isinstance(r.get("day"), str)}
    for offset in (1, 0):
        day = local_day(now - offset * DAY_S)
        part = [row for row in rows if local_day(row["t"]) == day]
        if not part:
            continue
        days[day] = dict(summarize(part), day=day, cohort=cohort_sums(part))
        if persist:
            hours = {}
            for row in part:
                hours.setdefault(time.strftime("%Y-%m-%dT%H", time.localtime(row["t"])), []).append(row)
            write_lines(os.path.join(base, "hours", day + ".jsonl"),
                        [dict(summarize(chunk), hour=hour) for hour, chunk in sorted(hours.items())])
    if not persist:
        return [days[d] for d in sorted(days)]
    write_lines(days_path, [days[d] for d in sorted(days)])
    for sub, keep in (("ticks", KEEP_TICK_DAYS), ("hours", KEEP_HOUR_DAYS)):
        cutoff = local_day(now - keep * DAY_S)
        for path in glob.glob(os.path.join(base, sub, "????-??-??.jsonl")):
            if os.path.basename(path)[:10] < cutoff:
                try:
                    os.remove(path)
                except OSError:
                    pass
    return [days[d] for d in sorted(days)]


# ---------------------------------------------------------------- nightly pass


def report_date(text):
    for fmt in ("%Y-%m-%d %H:%M:%S.%f %z", "%Y-%m-%d %H:%M:%S %z"):
        try:
            return datetime.datetime.strptime(text.strip(), fmt).timestamp()
        except (ValueError, AttributeError):
            continue
    return None


def owner_of(name, bundle, path, jobs):
    if name in OWN_APPS or interpreter(name) or (path or "").startswith(own_roots()):
        return "own"
    if (bundle or "").startswith("com.apple.") or (path or "").startswith(APPLE_PREFIXES) and not (
            path or "").startswith("/usr/local/"):
        return "apple"
    if name in jobs:
        return jobs[name]["owner"]
    return "third-party"


def pid_scripts(now):
    """{pid: [(start, last seen, script, owner)]} of the interpreters the ticks saw running a script, dead ones from
    pids/<day>.jsonl and live ones from tick-state.json, REPORT_DAYS back."""
    found = {}
    for row in tick_rows(now - (REPORT_DAYS + 1) * DAY_S, now, "pids"):
        for pid, start, seen, tag, owner in row.get("gone") or ():
            found.setdefault(pid, []).append((start, seen, tag, owner))
    state = read_json(os.path.join(state_dir(), "tick-state.json"), {}) or {}
    for key, (tag, owner) in (state.get("named") or {}).items():
        found.setdefault(int(key.split("@", 1)[0]), []).append((start_epoch(key), state.get("t"), tag, owner))
    return found


def script_at(runs, began, ended):
    """(script, owner) of the run of a pid that was alive over [began, ended], or None."""
    alive = [run for run in runs or () if run[0] is not None and run[1] is not None and run[0] <= (ended or began) + 60
             and run[1] >= began - 120]
    return max(alive)[2:] if alive else None


def report_header(path, name, jobs, scripts=None):
    """{at, kind, name, owner} of one DiagnosticReports file off its first 4 KB, or None. An interpreter's report names
    the script the ticks saw that pid run at the time."""
    try:
        with open(path, errors="replace") as handle:
            head = handle.read(4096)
    except OSError:
        return None
    kind = proc = bundle = exe = pid = ended = None
    at = None
    first, _, rest = head.partition("\n")
    suffix = os.path.splitext(name)[1]
    if suffix == ".ips":
        try:
            header = json.loads(first)
        except ValueError:
            header = {}
        if not isinstance(header, dict):
            header = {}
        bug = str(header.get("bug_type") or "")
        kind = "jetsam" if name.startswith("JetsamEvent") else CRASH_TYPES.get(bug, "other")
        if kind == "crash" and header.get("is_simulated"):
            kind = "fault"
        proc = header.get("app_name") or header.get("name")
        bundle = header.get("bundleID")
        at = report_date(header.get("timestamp") or "")
        found = re.search(r'"pid"\s*:\s*(\d+)', rest)
        pid = int(found.group(1)) if found else None
    else:
        field = lambda label: (re.search(r"^%s:\s+(.+)$" % label, head, re.M) or [None, None])[1]
        event = (field("Event") or "").strip().lower()
        kind = SUFFIX_KINDS.get(suffix) or DIAG_EVENTS.get(event) or ("other" if suffix == ".diag" else None)
        if kind is None:
            return None
        proc = (field("Command") or "").strip() or None
        bundle = (field("Identifier") or "").strip() or None
        exe = (field("Path") or "").strip() or None
        at = report_date(field("Date/Time") or "")
        ended = report_date(field("End time") or "")
        pid = int(field("PID").strip()) if (field("PID") or "").strip().isdigit() else None
    proc = (proc or re.split(r"[-_]\d{4}-\d\d-\d\d", name)[0].replace("ExcUserFault_", "")).strip()[:40]
    if at is None:
        try:
            at = os.path.getmtime(path)
        except OSError:
            return None
    owner = "apple" if kind == "jetsam" else owner_of(proc, bundle, exe, jobs)
    ran = script_at((scripts or {}).get(pid), at, ended) if kind != "jetsam" and interpreter(proc) and pid else None
    if ran:
        proc, owner = ran
    return {"at": round(at), "kind": kind, "name": proc, "owner": owner, "ref": name,
            "job": proc in jobs}


def job_owner(label, program):
    if label.split("application.", 1)[-1].startswith("com.apple.") or (program or "").startswith(APPLE_PREFIXES) and not (
            program or "").startswith("/usr/local/"):
        return "apple"
    return "own" if (program or "").startswith(own_roots()) else "third-party"


def wrapper_target(program):
    """argv the last `exec` line of a libexec_dir() wrapper runs (its `name=value` lines expanded, "$@" dropped), or None."""
    if os.path.dirname(program) != libexec_dir().rstrip("/"):
        return None
    try:
        with open(program, errors="replace") as handle:
            text = handle.read(4096)
        names = {key: (shlex.split(value) or [""])[0] for key, value in re.findall(r"^(\w+)=(\S+)$", text, re.M)}
        argv = shlex.split([line for line in text.split("\n") if line.strip().startswith("exec ")][-1])[1:]
    except (OSError, IndexError, ValueError):
        return None
    argv = [re.sub(r"\$\{?(\w+)\}?", lambda m: names.get(m.group(1), m.group(0)), word) for word in argv if word != "$@"]
    return argv or None


def program_name(program, args=()):
    """A launchd job's cause name: the script its interpreter runs, else its program's basename. A wrapper is named by
    what it execs, and a script run directly by its `repo/path`, the names the ticks and crash reports give them."""
    rest = list(args[1:] if args and args[0] == program else args)
    target = wrapper_target(program)
    if target:
        program, rest = target[0], target[1:]
    name, _owner, kind = describe(program, rest, own_roots())
    if kind == "script":
        return name
    try:
        with open(program, "rb") as handle:
            script = handle.read(2) == b"#!"
    except OSError:
        script = False
    return script_name(program) if script else os.path.basename(program)[:40]


def job_plists():
    """[(label, program, plist)] of the launchd job plists in agent_dirs()."""
    found = []
    for folder in agent_dirs():
        for path in glob.glob(os.path.join(folder, "*.plist")):
            try:
                with open(path, "rb") as handle:
                    plist = plistlib.load(handle)
            except Exception:
                continue
            if not isinstance(plist, dict):
                continue
            args = plist.get("ProgramArguments")
            program = plist.get("Program") or (args[0] if isinstance(args, list) and args else "")
            if isinstance(program, str) and program:
                found.append((str(plist.get("Label") or os.path.basename(path)[:-6]), program, plist))
    return found


def relaunched_jobs():
    """{program name: {label, owner}} of the launchd jobs launchd starts again on its own (KeepAlive or StartInterval)."""
    return {program_name(program, [a for a in plist.get("ProgramArguments") or () if isinstance(a, str)]):
            {"label": label, "owner": job_owner(label, program)}
            for label, program, plist in job_plists() if plist.get("KeepAlive") or plist.get("StartInterval")}


def diagnostic_reports(now, jobs):
    reports = []
    cutoff = now - REPORT_DAYS * DAY_S
    scripts = pid_scripts(now)
    for folder in diag_dirs():
        try:
            names = os.listdir(folder)
        except OSError:
            continue
        for name in names:
            path = os.path.join(folder, name)
            try:
                if not os.path.isfile(path) or os.path.getmtime(path) < cutoff:
                    continue
            except OSError:
                continue
            row = report_header(path, name, jobs, scripts)
            if row and row["at"] >= cutoff:
                reports.append(row)
    reports.sort(key=lambda r: (r["at"], r["ref"]))
    return reports


MONTHS = {m: i for i, m in enumerate(("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov",
                                      "Dec"), 1)}


def boot_events(now):
    """[(epoch, 'reboot'|'shutdown')] newest first off `last`, whose lines carry no year."""
    events = []
    year = time.localtime(now).tm_year
    newest_month = None
    for line in machine_probe.run("last", ["reboot", "shutdown"]).splitlines():
        words = line.split()
        if not words or words[0] not in ("reboot", "shutdown"):
            continue
        found = re.search(r"\b(\w{3})\s+(\w{3})\s+(\d{1,2})\s+(\d\d):(\d\d)\b", line)
        if not found or found.group(2) not in MONTHS:
            continue
        month = MONTHS[found.group(2)]
        if month > (newest_month or time.localtime(now).tm_mon):
            year -= 1
        newest_month = month
        try:
            at = time.mktime((year, month, int(found.group(3)), int(found.group(4)), int(found.group(5)), 0, 0, 0, -1))
        except (OverflowError, ValueError):
            continue
        events.append((at, words[0]))
    return events


def unclean_reboots(events):
    """Boots whose previous record is another boot, not a shutdown: a freeze, a power loss or a panic."""
    return [at for (at, kind), (_older, older_kind) in zip(events, events[1:])
            if kind == "reboot" and older_kind == "reboot"]


def cache_sizes(deadline):
    sizes = []
    for root in cache_roots():
        left = deadline - time.time()
        if left <= 1 or not os.path.isdir(root):
            continue
        for line in machine_probe.run("du", ["-k", "-d", "1", root], timeout=left).splitlines():
            size, _, path = line.partition("\t")
            if size.isdigit() and os.path.normpath(path) != os.path.normpath(root):
                sizes.append([os.path.relpath(path, HOME) if path.startswith(HOME) else os.path.basename(path),
                              round(int(size) * 1024 / GIB, 1)])
    for folder in cache_dirs():
        left = deadline - time.time()
        if left <= 1 or not os.path.isdir(folder):
            continue
        out = machine_probe.run("du", ["-k", "-d", "0", folder], timeout=left).split("\t", 1)[0]
        if out.isdigit():
            sizes.append([os.path.relpath(folder, HOME) if folder.startswith(HOME) else os.path.basename(folder),
                          round(int(out) * 1024 / GIB, 1)])
    return sorted(sizes, key=lambda r: -r[1])[:8]


def smart_status():
    state = read_json(os.path.join(state_dir(), "tick-state.json"), {}) or {}
    internal = sorted(label.split(":", 1)[1] for label in state.get("disks") or {} if label.startswith("internal:"))
    if not internal:
        return None
    found = re.search(r"SMART Status:\s+(.+)", machine_probe.run("diskutil", ["info", internal[0]], timeout=10))
    return found.group(1).strip() if found else None


def nightly(now=None):
    now = time.time() if now is None else now
    steps = Steps()
    jobs = steps("jobs", relaunched_jobs)
    reports = steps("reports", diagnostic_reports, now, jobs)
    events = steps("last", boot_events, now)
    caches = steps("caches", cache_sizes, time.time() + CACHE_BUDGET_S)
    smart = steps("smart", smart_status)
    unclean = unclean_reboots(events)
    result = {"as_of_s": round(now), "reports": reports, "unclean": [round(at) for at in unclean if at >= now - 31 * DAY_S],
              "boots": sum(1 for _at, kind in events if kind == "reboot" and _at >= now - REBOOT_DAYS * DAY_S),
              "relaunched": len(jobs), "caches": caches, "smart": smart, "steps": steps.out}
    write_json(os.path.join(state_dir(), "nightly.json"), result)
    return result


# ---------------------------------------------------------------- collectors: storm census, launchd, unified log


@contextlib.contextmanager
def single(name):
    """True while this process holds the collector's lock, False when another run of it holds it."""
    os.makedirs(state_dir(), exist_ok=True)
    with open(os.path.join(state_dir(), name + ".lock"), "w") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            yield False
            return
        yield True


def detach(command):
    try:
        subprocess.Popen([sys.executable, os.path.realpath(__file__), command, "--quiet"], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, close_fds=True)
    except OSError as error:
        print("system-doctor %s: %s: %s" % (command, type(error).__name__, error), file=sys.stderr)


def census_due(recent, now, last=None):
    """The storm that calls for a newborn census, or None: births >= storm_s on every tick of the last storm_min
    minutes (at least storm_min ticks), or the latest tick's kernel share >= storm_kernel; one census per
    census_every_s at most."""
    if last is not None and now - last < COLLECT["census_every_s"]:
        return None
    window = [r for r in recent if r.get("t", 0) >= now - COLLECT["storm_min"] * 60 + 10]
    births = [r.get("births_s") for r in window]
    if len(window) >= COLLECT["storm_min"] and all(b is not None and b >= COLLECT["storm_s"] for b in births):
        return {"births_s": min(births), "kernel": window[-1].get("kernel")}
    latest = window[-1] if window else {}
    if latest.get("kernel") is not None and latest["kernel"] >= COLLECT["storm_kernel"]:
        return {"births_s": latest.get("births_s"), "kernel": latest["kernel"]}
    return None


def launch_due(now, start=detach):
    """Starts each collector that is due as its own background process; launched.json holds when each last began."""
    path = os.path.join(state_dir(), "launched.json")
    launched = read_json(path, {}) or {}
    recent = (read_json(os.path.join(state_dir(), "tick-state.json"), {}) or {}).get("recent") or []
    due = ["census"] if census_due(recent, now, launched.get("census")) else []
    for name, every in (("dumpstate", COLLECT["dumpstate_every_s"]), ("harvest", COLLECT["harvest_every_s"])):
        if now - (launched.get(name) or 0) >= every - 30:
            due.append(name)
    if logstores_due(launched.get("logstores"), now):
        due.append("logstores")
    if due:
        write_json(path, dict(launched, **{name: now for name in due}))
        for name in due:
            start(name)
    return due


def append_row(sub, row, keep_days=KEEP_HOUR_DAYS):
    folder = os.path.join(state_dir(), sub)
    os.makedirs(folder, exist_ok=True)
    with open(os.path.join(folder, local_day(row["t"]) + ".jsonl"), "a", encoding="utf-8") as handle:
        handle.write(json.dumps(row, separators=(",", ":")) + "\n")
    cutoff = local_day(row["t"] - keep_days * DAY_S)
    for path in glob.glob(os.path.join(folder, "????-??-??.jsonl")):
        if os.path.basename(path)[:10] < cutoff:
            try:
                os.remove(path)
            except OSError:
                pass


def census(now=None, seconds=None, poll=None):
    """One newborn census: polls the process table for `seconds` and charges every newborn it catches to the nearest
    own script or app above it, as the tick does; one row in census/<day>.jsonl."""
    began = time.time()
    now = began if now is None else now
    started_cpu = collector_runs.cpu_total()
    machine_probe.low_priority()
    seconds = COLLECT["census_s"] if seconds is None else seconds
    poll = COLLECT["census_poll_s"] if poll is None else poll
    roots = own_roots()
    repos_top()
    procs, by_pid = {}, {}

    def look(pid, depth=0):
        found = machine_probe.proc_info(pid)
        if not found:
            return None
        ppid, uid, start, args = found
        key = "%d@%d" % (pid, start)
        if key not in procs:
            exe, rest = exe_and_rest(args)
            tag, owner, kind = describe(exe, rest, roots, functools.partial(machine_probe.proc_cwd, pid))
            procs[key] = [int(ppid), 0.0, tag, owner, pid, uid, kind]
            if kind == "inline" and ppid > 1 and depth < 6 and (ppid in by_pid or look(ppid, depth + 1)):
                inherit(procs, [key], by_pid)
        by_pid[pid] = key
        return key

    seen = machine_probe.all_pids()
    births, caught, unreadable, polls = {}, 0, 0, 0
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        time.sleep(poll)
        current = machine_probe.all_pids()
        polls += 1
        for pid in current - seen:
            key = look(pid)
            if key is None:
                unreadable += 1
                continue
            parent, depth = procs[key][0], 0
            while parent > 1 and depth < 12 and (parent in by_pid or look(parent)):
                parent, depth = procs[by_pid[parent]][0], depth + 1
            name = causer(key, procs, by_pid)
            births[name] = births.get(name, 0) + 1
            caught += 1
        seen = current
        if len(procs) > 200000:
            procs.clear()
            by_pid.clear()
    recent = (read_json(os.path.join(state_dir(), "tick-state.json"), {}) or {}).get("recent") or []
    row = {"t": round(now, 1), "seconds": seconds, "polls": polls, "births_seen": caught, "unreadable": unreadable,
           "births_top": top_rows([[tag, n, owner] for (tag, owner), n in births.items()]),
           "trigger": recent[-1] if recent else None,
           "self": {"wall_s": round(time.time() - began, 3), "cpu_s": round(collector_runs.cpu_total() - started_cpu, 3)}}
    append_row("census", row, KEEP_TICK_DAYS)
    return row


def job_label(text):
    """A launchd service name without its domain, pid or unique parts: `gui/501/com.x.<uuid> [12]` -> `com.x.N`."""
    label = re.sub(r"^(?:(?:gui|user|login|pid|session)/\d+/|system/)", "", text.strip()).split(" [")[0].rstrip(":")
    return re.sub(r"(?:\.(?:N|\d+))+$", "", UNIQUE.sub("N", label))[:80]


def exit_text(code=None, signal_text=None):
    """`exit N`, `signal N` or None (never exited) off dumpstate's last exit code and terminating signal."""
    found = re.search(r":\s*(\d+)\s*$", signal_text or "")
    if found:
        return "signal %s" % found.group(1)
    found = re.match(r"^(-?\d+)(?::.*)?$", (code or "").strip())
    if found:
        return "exit %s" % found.group(1)
    return None


def abnormal(text):
    kind, _, number = (text or "").partition(" ")
    return kind == "exit" and number not in ("0", "") or kind == "signal" and number.isdigit() and int(
        number) in CRASH_SIGNALS


DUMP_KEYS = ("runs", "last exit code", "last terminating signal", "program", "pid", "run interval", "properties")


def parse_dumpstate(text):
    """{service: {label, name, owner, runs, exit, pid, every, relaunched}} of every service with a run counter. The text carries
    argv and environment: nothing but the label, the program's basename and counters leaves this function."""
    services, block, listing = {}, None, None
    for line in text.split("\n"):
        if not line.startswith("\t"):
            if line.endswith(" = {") and not line.startswith(" "):
                block, listing = services.setdefault(line[:-4], {}), None
            continue
        if block is None:
            continue
        if line.startswith("\t\t"):
            if listing is not None and len(listing) < ARGV_WORDS + 1:
                listing.append(line.strip())
            continue
        key, _, value = line[1:].partition(" = ")
        listing = block.setdefault("arguments", []) if key == "arguments" and "arguments" not in block else None
        if key in DUMP_KEYS and key not in block:
            block[key] = value.strip()
    out = {}
    for service, block in services.items():
        if not block.get("runs", "").isdigit():
            continue
        label, program = job_label(service), block.get("program") or ""
        owner = job_owner(label, program)
        every = re.match(r"(\d+) seconds", block.get("run interval") or "")
        out[service] = {"label": label, "name": program_name(program, block.get("arguments") or ()) if owner == "own" and program
                        else label,
                        "owner": owner, "runs": int(block["runs"]),
                        "exit": exit_text(block.get("last exit code"), block.get("last terminating signal")),
                        "pid": int(block["pid"]) if block.get("pid", "").isdigit() else None,
                        "every": int(every.group(1)) if every else None,
                        "relaunched": bool(every) or "keepalive" in (block.get("properties") or "").split(" | ")}
    return out


def worker_pids():
    """Supervisor pids of worker runs still open: a detached supervisor under launchd is on purpose."""
    folder = os.environ.get("WORKER_RUN_DIR") or os.path.join(HOME, ".cache", "claude-worker-runs")
    pids = set()
    try:
        entries = list(os.scandir(folder))
    except OSError:
        return pids
    for entry in entries:
        try:
            if not entry.is_dir() or time.time() - entry.stat().st_mtime > 3 * DAY_S or os.path.exists(
                    os.path.join(entry.path, "exit_code")):
                continue
        except OSError:
            continue
        pid = (read_json(os.path.join(entry.path, "meta.json"), {}) or {}).get("pid")
        if isinstance(pid, int):
            pids.add(pid)
    return pids


def start_epoch(key):
    try:
        return time.mktime(time.strptime(key.split("@", 1)[1], "%a %b %d %H:%M:%S %Y"))
    except (IndexError, ValueError):
        return None


def orphan_census(job_pids, now):
    """Own processes launchd adopted that are no launchd job: [tag, count, oldest age s, open worker supervisors]."""
    _pid, procs = ps_snapshot(False)
    supervisors = worker_pids()
    found = {}
    for key, entry in procs.items():
        if entry[0] != 1 or entry[3] != "own" or entry[2] in OWN_APPS or entry[4] in job_pids or entry[5] != os.getuid():
            continue
        slot = found.setdefault(entry[2], [0, 0, 0])
        born = start_epoch(key)
        slot[0] += 1
        slot[1] = max(slot[1], round(now - born) if born else 0)
        slot[2] += entry[4] in supervisors
    rows = [[tag, n, age, sup, "own"] for tag, (n, age, sup) in found.items()]
    return {"count": sum(r[1] for r in rows), "supervisors": sum(r[3] for r in rows), "top": top_rows(rows)}


def dumpstate(now=None):
    """Hourly: launchd's per-service run counters and last exits (`launchctl dumpstate`, parsed in memory) as deltas
    against the previous snapshot, and the orphan census; one row in launchd/<day>.jsonl."""
    began = time.time()
    now = began if now is None else now
    started_cpu = collector_runs.cpu_total()
    machine_probe.low_priority()
    steps = Steps()
    services = steps("parse", lambda: parse_dumpstate(machine_probe.run("launchctl", ["dumpstate"], timeout=30)))
    path = os.path.join(state_dir(), "dumpstate-state.json")
    previous = read_json(path, {}) or {}
    old = previous.get("services") or {}
    jobs, reloaded = {}, 0
    for service, entry in services.items():
        before = old.get(service)
        if not old:
            runs = 0
        elif before is None:
            runs = entry["runs"]
        elif entry["runs"] < before[0]:
            runs, reloaded = entry["runs"], reloaded + 1
        else:
            runs = entry["runs"] - before[0]
        bad = runs > 0 and abnormal(entry["exit"])
        if not runs and not bad:
            continue
        slot = jobs.setdefault(entry["label"], {"label": entry["label"], "name": entry["name"], "owner": entry["owner"],
                                                "runs": 0, "bad": 0, "exit": None, "every": entry["every"],
                                                "relaunched": entry["relaunched"]})
        slot["runs"] += runs
        slot["bad"] = max(slot["bad"], int(bad))
        slot["exit"] = entry["exit"] if bad or slot["exit"] is None else slot["exit"]
    orphans = steps("orphans", orphan_census, {e["pid"] for e in services.values() if e["pid"]}, now)
    moved = sorted(jobs.values(), key=lambda j: (-j["bad"], -j["runs"], j["label"]))
    row = {"t": round(now, 1), "dt": round(now - previous["t"], 1) if isinstance(previous.get("t"), (int, float)) else None,
           "services": len(services), "reloaded": reloaded, "jobs": moved[:80], "orphans": orphans,
           "self": {"wall_s": round(time.time() - began, 3), "cpu_s": round(collector_runs.cpu_total() - started_cpu, 3),
                    "steps": steps.out}}
    if services:
        write_json(path, {"t": now, "services": {k: [e["runs"], e["exit"]] for k, e in services.items()}})
    append_row("launchd", row)
    return row


STAMP = re.compile(r"^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d\.\d")


def log_time(stamp):
    try:
        return time.mktime(time.strptime(stamp[:19], "%Y-%m-%d %H:%M:%S")) + float("0" + stamp[19:23])
    except ValueError:
        return None


class Exits:
    """launchd's `exited ... ran for Nms` lines: per label runs, wall, longest run, abnormal exits and exit kinds."""
    LINE = re.compile(r"^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d\.\d+) +\S+ +launchd\[1\S*\] \[(\S+?)(?: \[\d+\])?:?\] (.*)ran for (\d+)ms")

    def __init__(self, own_labels):
        self.own, self.items, self.last = own_labels, {}, None

    def feed(self, line):
        found = self.LINE.match(line)
        if not found:
            return
        stamp, service, message, ms = found.groups()
        self.last = stamp
        code = re.search(r"exit\((-?\d+)\)", message)
        name = re.search(r"\b(SIG[A-Z]+)\b", message)
        reason = re.search(r"\b((?:OS|JETSAM)_REASON_[A-Z_]+)", message)
        kind = "exit %s" % code.group(1) if code else "signal %d" % signal.Signals[name.group(1)].value if name and \
            name.group(1) in signal.Signals.__members__ else reason.group(1) if reason else "other"
        label = job_label(service)
        slot = self.items.setdefault(label, [0, 0.0, 0.0, 0, {}])
        slot[0] += 1
        slot[1] += int(ms) / 1000.0
        slot[2] = max(slot[2], int(ms) / 1000.0)
        slot[3] += abnormal(kind)
        slot[4][kind] = slot[4].get(kind, 0) + 1

    def result(self):
        rows = [[label, n, round(wall, 1), round(longest, 1), bad,
                 dict(sorted(kinds.items(), key=lambda kv: -kv[1])[:3]),
                 "apple" if label.startswith("com.apple.") else "own" if label in self.own else "third-party"]
                for label, (n, wall, longest, bad, kinds) in self.items.items()]
        rows.sort(key=lambda r: (-r[4], -r[1], r[0]))
        return rows[:60]


class Verdicts:
    """dasd's scoring verdicts, starts and completions per background activity."""
    HEAD = re.compile(r":scoring\] \d+:([^\s:,']+):[0-9A-Fa-f]+(?::\[|, Decision: (\w+))")
    TAIL = re.compile(r"^\s*\], Decision: (\w+)\}")
    START = re.compile(r"lifecycle\] STARTED <_DASActivity: \"\d+:([^:\"]+)")
    DONE = re.compile(r"BGSTHelper\] Completed \d+:(\S+)")
    STAMP = re.compile(r"^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d\.\d+) ")

    def __init__(self, _own=None):
        self.items, self.current, self.last = {}, None, None

    def slot(self, name):
        return self.items.setdefault(UNIQUE.sub("N", name)[:80], [0, 0, {}])

    def feed(self, line):
        stamp = self.STAMP.match(line)
        if stamp:
            self.last = stamp.group(1)
        head = self.HEAD.search(line)
        if head:
            self.current = None
            if head.group(2):
                decisions = self.slot(head.group(1))[2]
                decisions[head.group(2)] = decisions.get(head.group(2), 0) + 1
            else:
                self.current = head.group(1)
            return
        tail = self.TAIL.match(line)
        if tail and self.current:
            decisions = self.slot(self.current)[2]
            decisions[tail.group(1)] = decisions.get(tail.group(1), 0) + 1
            self.current = None
            return
        for pattern, index in ((self.START, 0), (self.DONE, 1)):
            found = pattern.search(line)
            if found:
                self.slot(found.group(1))[index] += 1

    def result(self):
        rows = [[name, starts, done, decisions, "third-party" if re.match(r"[a-z]+\.", name) and not name.startswith("com.apple.") else "apple"]
                for name, (starts, done, decisions) in self.items.items()]
        rows.sort(key=lambda r: (-sum(r[3].values()), -r[1], r[0]))
        return rows[:40]


class Hangs:
    """spindump's `<App> [pid]: spin` and `slow hid response (Ns)` lines per app."""
    LINE = re.compile(r"^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d\.\d+) .*\] (.+?) \[\d+\]: (spin|slow hid response \(([\d.]+)s\))")

    def __init__(self, _own=None):
        self.items, self.last = {}, None

    def feed(self, line):
        found = self.LINE.match(line)
        if not found:
            return
        self.last = found.group(1)
        slot = self.items.setdefault(found.group(2)[:40], [0, 0, 0.0])
        if found.group(3) == "spin":
            slot[0] += 1
        else:
            slot[1] += 1
            slot[2] += float(found.group(4))

    def result(self):
        rows = [[app, spins, slow, round(slow_s, 1), "own" if app in OWN_APPS else "apple" if any(
            os.path.isdir(os.path.join(folder, app + ".app")) for folder in (
                "/System/Applications", "/System/Applications/Utilities", "/System/Library/CoreServices")) else "third-party"]
                for app, (spins, slow, slow_s) in self.items.items()]
        rows.sort(key=lambda r: (-(r[1] + r[2]), r[0]))
        return rows[:30]


PARSERS = {"launchd": Exits, "das": Verdicts, "hangs": Hangs}


def harvest(now=None, budget_s=None, max_lines=None):
    """Every 6 h: launchd exits, DAS verdicts and hangs off the unified log since each source's cursor (at most
    harvest_back_s back, the log keeps ~11 h), each `log show` cut at its time and line budget; counters only, one
    row in harvest/<day>.jsonl."""
    began = time.time()
    now = began if now is None else now
    started_cpu = collector_runs.cpu_total()
    machine_probe.low_priority()
    path = os.path.join(state_dir(), "harvest-state.json")
    cursors = (read_json(path, {}) or {}).get("cursors") or {}
    own_labels = {label for label, program, _plist in job_plists() if job_owner(label, program) == "own"}
    row = {"t": round(now, 1), "sources": {}}
    for name, predicate, budget, lines in HARVEST:
        cursor = cursors.get(name)
        start = max(cursor or 0, now - COLLECT["harvest_back_s"])
        parser, last = PARSERS[name](own_labels), [None]

        def feed(line):
            if STAMP.match(line):
                last[0] = line[:23]
            parser.feed(line)

        wall, cpu = time.time(), collector_runs.cpu_total()
        count, cut = machine_probe.stream("log", ["show", "--style", "compact", "--start", time.strftime(
            "%Y-%m-%d %H:%M:%S", time.localtime(start)), "--end", time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(now)),
            "--predicate", predicate], budget if budget_s is None else budget_s, lines if max_lines is None else max_lines,
            feed)
        reached = now if cut is None else log_time(last[0]) if last[0] else None
        cursors[name] = max(start, reached or start)
        row["sources"][name] = {"from": round(start), "to": round(cursors[name]), "lines": count, "cut": cut,
                                "lost_s": round(start - cursor) if cursor and start > cursor else 0,
                                "wall_s": round(time.time() - wall, 3), "cpu_s": round(collector_runs.cpu_total() - cpu, 3)}
        row[name] = parser.result()
    write_json(path, {"t": now, "cursors": cursors})
    row["self"] = {"wall_s": round(time.time() - began, 3), "cpu_s": round(collector_runs.cpu_total() - started_cpu, 3)}
    append_row("harvest", row)
    return row


# ---------------------------------------------------------------- log stores


def log_sweep_command():
    return os.environ.get("SYSTEM_DOCTOR_LOG_SWEEP") or os.path.join(ROOT_DIR, "bin", "log-sweep")


def run_log_sweep():
    try:
        out = subprocess.run([log_sweep_command(), "--json"], capture_output=True, text=True,
                             timeout=LOGS["sweep_timeout_s"], stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError) as error:
        return {"error": clip("%s: %s" % (type(error).__name__, error), 200)}
    lines = out.stdout.strip().splitlines()
    try:
        found = json.loads(lines[-1]) if lines else None
    except ValueError:
        found = None
    if not isinstance(found, dict):
        return {"error": clip("exit %d: %s" % (out.returncode, out.stderr.strip() or "no summary"), 200)}
    return {k: found.get(k) for k in ("units", "bytes", "errors", "skipped_open", "wall_s")}


def tilde(path):
    return "~" + path[len(HOME):] if path == HOME or path.startswith(HOME + "/") else path


def previous_scan(now):
    """({path: [kb, residual]}, days back) of the newest directory scan at least 20 h and at most 8 days old."""
    best = None
    for path in glob.glob(os.path.join(state_dir(), "logscan", "????-??-??.json")):
        scan = read_json(path, {}) or {}
        at = scan.get("t")
        if isinstance(at, (int, float)) and now - 8 * DAY_S <= at <= now - LOGS["compare_min_s"] and \
                (best is None or at > best["t"]):
            best = scan
    if not best:
        return None, None
    return {log_stores.expand(p): v for p, v in (best.get("dirs") or {}).items()}, (now - best["t"]) / DAY_S


def logstores(now=None):
    """Daily: bin/log-sweep, then every registered log store's size, files, oldest unit and what lies past its
    criterion plus slack, and the du fallback naming each directory no store or ignore entry covers that holds
    min_mb or grew grow_mb_day; one row in logstores/<day>.jsonl, the directory sizes in logscan/<day>.json."""
    began = time.time()
    now = began if now is None else now
    started_cpu = collector_runs.cpu_total()
    machine_probe.low_priority()
    steps = Steps()
    row = {"t": round(now, 1)}
    try:
        registry = log_stores.load()
    except (OSError, ValueError) as error:
        row["error"] = clip("registry: %s" % error, 200)
        append_row("logstores", row)
        return row
    row["sweep"] = steps("sweep", run_log_sweep)
    stores, claims = [], {}
    for entry in log_stores.logs(registry):
        rows = steps("store:" + entry["name"], log_stores.measure, entry)
        claims.update((r["path"], r["bytes"]) for r in rows)
        stores.append(dict(log_stores.summary(entry, rows, now), writer=entry.get("writer"), owner=entry.get("owner"),
                           readers=entry["readers"]))
    scan = registry.get("scan") or {}
    depth = scan.get("depth", 3)
    roots = [r for r in (log_stores.expand(r) for r in scan.get("roots") or ()) if os.path.isdir(r)]
    sizes, cut = {}, []
    deadline = time.time() + scan.get("budget_s", 600)

    def du_all():
        for top, levels in log_stores.du_plan(roots, depth):
            left = deadline - time.time()
            found = log_stores.parse_du(machine_probe.run("du", ["-k", "-x", "-d", str(levels), top], timeout=left)
                                        if left > 1 else "")
            if top not in found:
                cut.append(tilde(top))
            sizes.update(found)

    steps("du", du_all)
    old, old_days = previous_scan(now)
    claims = steps("apps", log_stores.app_claims, registry, sizes) | claims
    reported, dirs = steps("fallback", log_stores.unregistered, sizes, roots, depth, claims,
                           log_stores.ignore_paths(registry), scan.get("min_mb", 200) * 1024,
                           scan.get("grow_mb_day", 50) * 1024, scan.get("floor_mb", 10) * 1024, old, old_days)
    if not cut:
        write_json(os.path.join(state_dir(), "logscan", local_day(now) + ".json"),
                   {"t": round(now), "dirs": {tilde(p): v for p, v in dirs.items()}})
        cutoff = local_day(now - LOGS["keep_scan_days"] * DAY_S)
        for path in glob.glob(os.path.join(state_dir(), "logscan", "????-??-??.json")):
            if os.path.basename(path)[:10] < cutoff:
                with contextlib.suppress(OSError):
                    os.remove(path)
    row.update({"stores": stores, "total_bytes": sum(s["bytes"] for s in stores),
                "unregistered": [{"path": tilde(r["path"]), "mb": round(r["kb"] / 1024),
                                  "residual_mb": round(r["residual_kb"] / 1024),
                                  "grow_mb_day": round(r["grow_kb_day"] / 1024) if r["grow_kb_day"] is not None else None}
                                 for r in reported[:40]] if not cut else [],
                "scan": {"roots": len(roots), "dirs": len(sizes), "cut": cut,
                         "compared_days": round(old_days, 2) if old_days else None},
                "self": {"wall_s": round(time.time() - began, 3), "cpu_s": round(collector_runs.cpu_total() - started_cpu, 3),
                         "steps": {k: v for k, v in steps.out.items() if not k.startswith("store:")} |
                         {"stores": [round(sum(v[0] for k, v in steps.out.items() if k.startswith("store:")), 3),
                                     round(sum(v[1] for k, v in steps.out.items() if k.startswith("store:")), 3)]}}})
    append_row("logstores", row)
    return row


def logstores_due(last, now):
    if not isinstance(last, (int, float)):
        return True
    return local_day(last) != local_day(now) and time.localtime(now).tm_hour >= NIGHTLY_HOUR or now - last > NIGHTLY_STALE_S


# ---------------------------------------------------------------- cohort score


def pressured(row):
    swapouts = (row.get("swapout_b") or 0) / 16384 / row["dt"] if row.get("dt") else 0
    return (row.get("comp_share") or 0) >= COHORT["pressure_comp"] or swapouts >= COHORT["pressure_swapouts_s"]


def cohort_sums(rows):
    """[[tag, owner, cpu-s, births, written B, read B, idle wakes, footprint B·s under pressure]] over minute rows."""
    items = {}
    for row in rows:
        dt = row.get("dt")
        if not dt:
            continue
        for entry in row.get("cpu_top") or ():
            items.setdefault((entry[0], entry[-1]), [0.0] * 6)[0] += entry[1]
        if row.get("births_s") is not None and row.get("births_seen"):
            for entry in row.get("births_top") or ():
                items.setdefault((entry[0], entry[-1]), [0.0] * 6)[1] += row["births_s"] * entry[1] / row["births_seen"] * dt
        for entry in row.get("io_top") or ():
            slot = items.setdefault((entry[0], entry[-1]), [0.0] * 6)
            slot[2] += entry[1]
            slot[3] += entry[2]
            slot[4] += entry[3]
        if pressured(row):
            for entry in row.get("mem_top") or ():
                items.setdefault((entry[0], entry[-1]), [0.0] * 6)[5] += entry[1] * dt
    out = [[tag, owner] + [round(v, 1) for v in values] for (tag, owner), values in items.items()]
    out.sort(key=lambda r: (-max(r[2] / COHORT["cpu_s"], r[3] / COHORT["births"], r[4] / COHORT["writes_b"],
                                 r[5] / COHORT["reads_b"], r[6] / COHORT["wakes"], r[7] / DAY_S / COHORT["footprint_b"]),
                               r[0]))
    return out[:COHORT["items_day"]]


def cohort_score(days, launches, now):
    """{covered_days, items} of B_i = max(C/864, W/86400, D/1 GiB, R/100 GiB, M/512 MiB x pressure, S/86400, L/1440)
    per item over the newest day rows covering >= 7 days (14 back at most); items None while fewer are covered.
    Only own processes' rusage is readable: W, D, R and M of other items are unknown and never certify a low B."""
    chosen, covered = [], 0
    for day in sorted(days, key=lambda d: d.get("day", ""), reverse=True):
        if day.get("day", "") < local_day(now - COHORT["lookback_days"] * DAY_S) or covered >= COHORT["days"] * DAY_S:
            break
        chosen.append(day)
        covered += day.get("covered_s") or 0
    span = covered / DAY_S
    if covered < COHORT["days"] * DAY_S:
        return {"covered_days": round(span, 2), "items": None}
    since = time.mktime(time.strptime(chosen[-1]["day"], "%Y-%m-%d"))
    sums = {}
    for day in chosen:
        for entry in day.get("cohort") or ():
            slot = sums.setdefault((entry[0], entry[1]), [0.0] * 7)
            for index, value in enumerate(entry[2:8]):
                slot[index] += value
    for row in launches:
        if row.get("t", 0) >= since:
            for job in row.get("jobs") or ():
                sums.setdefault((job["name"], job["owner"]), [0.0] * 7)[6] += job["runs"]
    items = []
    for (name, owner), (cpu, births, written, read, wakes, held, runs) in sums.items():
        per_day = {"C": cpu / span, "S": births / span, "L": runs / span}
        if owner == "own":
            per_day.update(W=wakes / span, D=written / span, R=read / span, M=held / covered)
        terms = {key: per_day[key] / COHORT[unit] for key, unit, _words in TERMS if key in per_day}
        score = max(terms.values())
        items.append({"name": name, "owner": owner, "B": score, "terms": {k: round(v, 3) for k, v in terms.items()},
                      "per_day": {k: round(v, 1) for k, v in per_day.items()},
                      "unknown": [key for key, _unit, _words in TERMS if key not in per_day]})
    items.sort(key=lambda i: (-i["B"], i["name"]))
    return {"covered_days": round(span, 2), "items": items}


# ---------------------------------------------------------------- the judge


def judge_digest():
    digest = hashlib.sha256()
    with open(os.path.realpath(__file__), "rb") as handle:
        digest.update(handle.read())
    try:
        with open(ledger_path(), "rb") as handle:
            digest.update(handle.read())
    except OSError:
        digest.update(b"no ledger")
    digest.update(json.dumps([LIMITS, PROOF, COLLECT, COHORT], sort_keys=True).encode())
    return digest.hexdigest()


def cause(entry, total):
    if not entry:
        return None
    return {"name": entry[0], "share": round(entry[1] / total, 2) if total else None, "owner": entry[-1],
            "fix_target": entry[-1] == "own"}


def cause_words(found):
    if not found:
        return ""
    share = " %d%%" % round(found["share"] * 100) if found.get("share") is not None else ""
    tail = "" if found["fix_target"] else " (%s, report only)" % found["owner"]
    return " · top cause %s%s%s" % (found["name"], share, tail)


def tag_rates(rows, name):
    """Births/s and CPU cores attributed to one cause over minute rows, and the ticks it was seen in."""
    covered = births = cpu = 0.0
    seen = 0
    for row in rows:
        if not row.get("dt"):
            continue
        born = sum(e[1] for e in row.get("births_top") or () if e[0] == name)
        spent = sum(e[1] for e in row.get("cpu_top") or () if e[0] == name)
        covered += row["dt"]
        if row.get("births_s") is not None and row.get("births_seen"):
            births += row["births_s"] * born / row["births_seen"] * row["dt"]
        cpu += spent
        seen += bool(born or spent)
    return {"covered_s": round(covered), "seen": seen, "births_s": round(births / covered, 1) if covered else None,
            "cores": round(cpu / covered, 3) if covered else None}


def fix_since(row):
    """When the row's last fix reached main, or None while it has not landed."""
    fixes = [f for f in (row or {}).get("fixes") or () if isinstance(f, dict)]
    if not fixes:
        return None
    ref = fixes[-1].get("in") or fix_commit(fixes[-1], repos_dir())
    return fix_landed(ref, repos_dir()) if ref else None


def proof(name, rule, since, now, night=None, memo=None):
    """{verdict: proven|refused|pending, why, ...} of a fix of cause `name` that landed at `since`. `memo` keeps the
    evidence that ages out of the stores (the reports after the fix, the baseline before it) across calls."""
    if since is None:
        return {"verdict": "pending", "why": "the fix has not landed in main"}
    key = "%s|%s|%d" % (rule, name, round(since))
    if rule == "log-store":
        rows = [r for r in tick_rows(since, now, "logstores") if r.get("stores") is not None]
        if not rows:
            return {"verdict": "pending", "why": "no log-store scan since the fix", "need_s": DAY_S}
        if name in log_firing(rows[-1], rule):
            return {"verdict": "refused", "why": "the %s scan still fires it" % iso_time(rows[-1]["t"]), "need_s": DAY_S}
        return {"verdict": "proven", "why": "the %s scan no longer fires it" % iso_time(rows[-1]["t"]), "need_s": DAY_S}
    if rule == "job-loop":
        rows = tick_rows(since, now, "launchd")
        after = [r["t"] for r in rows if any(loops(j, r) for j in r.get("jobs") or () if name in (j["name"], j["label"]))]
        covered = max(0, round((rows[-1]["t"] if rows else since) - since))
        out = {"after": {"loops": len(after), "covered_s": covered}, "need_s": PROOF["reports_s"]}
        if after:
            return dict(out, verdict="refused", why="%s looped or died in %d hourly snapshots since the fix" % (name, len(after)))
        if covered < PROOF["reports_s"]:
            return dict(out, verdict="pending", why="%s quiet for %.1f of %d days" % (name, covered / DAY_S,
                                                                                       PROOF["reports_s"] // DAY_S))
        return dict(out, verdict="proven", why="%s quiet for %d days" % (name, PROOF["reports_s"] // DAY_S))
    if rule in REPORT_KINDS:
        night = night if night is not None else read_json(os.path.join(state_dir(), "nightly.json"), {}) or {}
        after = sorted({str(r.get("ref") or r.get("at")) for r in night.get("reports") or () if r.get("at", 0) >= since
                        and r.get("kind") in REPORT_KINDS[rule] and r.get("name") == name})
        if memo is not None:
            after = sorted(set(after) | set(memo.get(key) or ()))
            if after:
                memo[key] = after
        covered = max(0, round((night.get("as_of_s") or 0) - since))
        out = {"after": {"reports": len(after), "covered_s": covered}, "need_s": PROOF["reports_s"]}
        if after:
            return dict(out, verdict="refused", why="%d %s report%s of %s since the fix" % (
                len(after), "/".join(REPORT_KINDS[rule]), "" if len(after) == 1 else "s", name))
        if covered < PROOF["reports_s"]:
            return dict(out, verdict="pending", why="no report of %s in %.1f of %d days" % (
                name, covered / DAY_S, PROOF["reports_s"] // DAY_S))
        return dict(out, verdict="proven", why="no report of %s in %d days" % (name, PROOF["reports_s"] // DAY_S))
    rows = tick_rows(since - PROOF["baseline_s"], now)
    before = tag_rates([r for r in rows if r["t"] < since], name)
    if memo is not None:
        kept = memo.get(key)
        if isinstance(kept, dict) and (kept.get("covered_s") or 0) >= before["covered_s"]:
            before = kept
        elif since <= now:
            memo[key] = before
    after = tag_rates([r for r in rows if r["t"] >= since], name)
    out = {"before": before, "after": after}
    if before["seen"] < PROOF["sightings"] or not (before["births_s"] or before["cores"]):
        return dict(out, verdict="refused", why="no measurable baseline: %s seen in %d ticks of the %d days before, "
                    "needs %d" % (name, before["seen"], PROOF["baseline_s"] // DAY_S, PROOF["sightings"]))
    need = min(PROOF["max_s"], max(PROOF["min_s"], PROOF["sightings"] * before["covered_s"] / before["seen"]))
    out["need_s"] = round(need)
    words = "births %s -> %s /s · CPU %s -> %s cores · %.1f of %.1f h after" % (
        before["births_s"], after["births_s"], before["cores"], after["cores"], after["covered_s"] / 3600.0,
        need / 3600.0)
    if after["covered_s"] < need:
        return dict(out, verdict="pending", why=words)
    pairs = [(before[k], after[k] or 0) for k in ("births_s", "cores") if before[k]]
    fell = any(b2 <= b1 * (1 - PROOF["drop"]) for b1, b2 in pairs)
    rose = any(b2 > b1 * (1 + PROOF["drop"]) for b1, b2 in pairs)
    return dict(out, verdict="proven" if fell and not rose else "refused", why=words)


class Judge:
    def __init__(self, now, night):
        self.now = now
        self.nightly = night
        self.reports = (night or {}).get("reports") or []
        self.problems = []
        self.blind = []
        self.censuses = []
        self.ledger = read_json(ledger_path(), {}) or {}
        self.rows = self.ledger.get("rows") if isinstance(self.ledger.get("rows"), list) else []
        memo = read_json(proofs_path(), {})
        self.memo = memo if isinstance(memo, dict) else {}
        self.memo_read = json.dumps(self.memo, sort_keys=True)

    def add(self, rule, key, fact, value, limit, unit, window_h, exposure, count, first, last, evidence,
            heavy=False, found=None):
        if found and found.get("fix_target"):
            files = own_sources(found["name"])
            found = dict(found, fix_target=bool(files), files=files)
        self.problems.append({
            "id": "%s:%s" % (rule, key), "rule": rule, "state": "new", "label": RULE_LABELS[rule],
            "severity": "heavy" if heavy else "review", "fact": fact + cause_words(found),
            "value": value, "limit": limit, "unit": unit, "window_h": window_h, "exposure": exposure, "count": count,
            "first_seen": iso_time(first), "last_seen": iso_time(last), "evidence": evidence[:EVIDENCE_MAX],
            "ledger": None, "cause": found, "_last": last})

    def apply_ledger(self):
        kept = []
        for row in self.rows:
            match = row.get("match") if isinstance(row, dict) else None
            if not (isinstance(match, dict) and isinstance(match.get("rule"), str) and match["rule"]
                    and isinstance(match.get("key"), str) and match["key"]
                    and (match.get("cause") is None or isinstance(match["cause"], str) and match["cause"])):
                rid = row.get("id") if isinstance(row, dict) else None
                kept.append({"id": "ledger:%s" % rid, "rule": "ledger", "state": "new", "label": "ledger",
                             "fact": "ledger row %s names no exact rule and key, so it judges nothing" % rid,
                             "value": 1, "limit": 0, "unit": "rows", "window_h": None, "exposure": len(self.rows),
                             "count": 1, "first_seen": None, "last_seen": None, "evidence": [], "ledger": rid})
        shown = set()
        for problem in self.problems:
            last = problem.pop("_last")
            name = (problem.get("cause") or {}).get("name")
            row = next((r for r in self.rows if isinstance(r, dict) and isinstance(r.get("match"), dict)
                        and "%s:%s" % (r["match"].get("rule"), r["match"].get("key")) == problem["id"]
                        and r["match"].get("cause") in (None, name)), None)
            if row:
                status = row.get("status")
                if status in DISMISSED:
                    continue
                problem["ledger"] = problem["id"] = row.get("id")
                shown.add(row.get("id"))
                if status == "fixed-pending" and row["match"].get("cause"):
                    self.prove(problem, row)
                elif status == "fixed-pending":
                    problem["state"] = "fixed-pending"
                elif status == "fixed":
                    fixed_at = max([iso_epoch(f.get("at")) or 0
                                    for f in row.get("fixes") or [] if isinstance(f, dict)] or [0])
                    problem["state"] = "regressed" if (last or 0) > fixed_at else "watch"
                else:
                    problem["state"] = "open"
            kept.append(problem)
        for row in [r for r in self.rows if isinstance(r, dict)]:
            match = row.get("match")
            if row.get("id") in shown or row.get("status") != "fixed-pending" or not isinstance(match, dict) \
                    or not isinstance(match.get("cause"), str) or match.get("rule") not in RULE_LABELS:
                continue
            problem = {"id": row.get("id"), "rule": match["rule"], "state": "fixed-pending",
                       "label": RULE_LABELS[match["rule"]], "severity": "review",
                       "fact": "%s fixed for %s" % (RULE_LABELS[match["rule"]], match["cause"]), "value": None,
                       "limit": None, "unit": None, "window_h": None, "exposure": None, "count": None,
                       "first_seen": None, "last_seen": None, "evidence": [], "ledger": row.get("id"),
                       "cause": {"name": match["cause"], "share": None, "owner": "own", "fix_target": True}}
            if self.prove(problem, row) == "proven" and self.now - (problem["proof"].get("since") or 0) - (
                    problem["proof"].get("need_s") or 0) > PROOF_SHOW_S:
                continue
            kept.append(problem)
        self.problems = kept

    def prove(self, problem, row):
        since = fix_since(row)
        found = dict(proof(row["match"]["cause"], row["match"]["rule"], since, self.now, self.nightly or {}, self.memo),
                     since=since)
        problem["proof"] = found
        problem["state"] = {"proven": "watch", "refused": "open"}.get(found["verdict"], "fixed-pending")
        problem["fact"] += " · %s · %s" % ({"proven": "fixed", "refused": "not proven"}.get(
            found["verdict"], "unproven"), found["why"])
        return found["verdict"]


def tick_evidence(row, text):
    return {"at": iso_time(row["t"]), "ref": "tick:%d" % row["t"], "account": None, "excerpt": clip(text)}


def judge_ticks(judge, rows, days):
    now = judge.now
    latest = rows[-1] if rows else None
    if not latest or now - latest["t"] > TICK_STALE_S:
        judge.blind.append("ticks")
    hour = [r for r in rows if r["t"] >= now - HOUR_S]
    births = [r for r in hour if r.get("births_s") is not None]
    attributed = hour + [c for c in judge.censuses if c.get("t", 0) >= now - HOUR_S]
    seen = merge_top(attributed, "births_top")
    seen_total = sum(r.get("births_seen") or 0 for r in attributed)
    if len(births) >= MIN_TICKS:
        value = mean(r["births_s"] for r in births)
        if value >= LIMITS["spawn_s"]:
            over = [r for r in births if r["births_s"] >= LIMITS["spawn_s"]]
            peak = max(births, key=lambda r: r["births_s"])
            judge.add("spawn", "machine", "%s new processes a second over the last hour, limit %s" % (
                format(round(value), ","), format(LIMITS["spawn_s"], ",")), round(value), LIMITS["spawn_s"], "/s", 1,
                len(births), len(over), over[0]["t"], over[-1]["t"],
                [tick_evidence(peak, "births %d/s" % peak["births_s"])], heavy=value >= LIMITS["spawn_heavy_s"],
                found=cause(seen[0] if seen else None, seen_total))
    kernel = [r for r in hour if r.get("kernel") is not None]
    if len(kernel) >= MIN_TICKS:
        value = mean(r["kernel"] for r in kernel)
        half = [r for r in kernel if r["t"] >= now - LIMITS["kernel_heavy_min"] * 60]
        heavy = len(half) >= MIN_TICKS and all(r["kernel"] >= LIMITS["kernel_heavy"] for r in half)
        if value >= LIMITS["kernel"]:
            over = [r for r in kernel if r["kernel"] >= LIMITS["kernel"]]
            peak = max(kernel, key=lambda r: r["kernel"])
            judge.add("kernel", "machine", "the kernel took %d%% of all CPU over the last hour, limit %d%%" % (
                round(value * 100), round(LIMITS["kernel"] * 100)), round(value, 3), LIMITS["kernel"], "share", 1,
                len(kernel), len(over), over[0]["t"], over[-1]["t"],
                [tick_evidence(peak, "kernel %d%% · busy %s" % (round(peak["kernel"] * 100), peak.get("busy")))],
                heavy=heavy, found=cause(seen[0] if seen else None, seen_total))
    recent = [r for r in rows if r["t"] >= now - LIMITS["compressor_min"] * 60 and r.get("comp_share") is not None]
    if len(recent) >= MIN_TICKS and all(r["comp_share"] >= LIMITS["compressor"] for r in recent):
        low = min(recent, key=lambda r: r["comp_share"])
        judge.add("compressor", "machine", "compressed memory held %d%% of RAM or more for %d min, limit %d%%" % (
            round(low["comp_share"] * 100), LIMITS["compressor_min"], round(LIMITS["compressor"] * 100)),
            low["comp_share"], LIMITS["compressor"], "share of RAM", LIMITS["compressor_min"] / 60, len(recent),
            len(recent), recent[0]["t"], recent[-1]["t"],
            [tick_evidence(low, "compressor %.1f GiB of %.0f GiB" % (low.get("comp_gib") or 0, low.get("mem_gib") or 0))])
    if latest and latest.get("swap_share") is not None and now - latest["t"] <= TICK_STALE_S \
            and latest["swap_share"] >= LIMITS["swap"]:
        judge.add("swap", "machine", "swap %.1f of %.1f GB in use (%d%%), limit %d%%" % (
            latest["swap_used_mb"] / 1024, latest["swap_total_mb"] / 1024, round(latest["swap_share"] * 100),
            round(LIMITS["swap"] * 100)), latest["swap_share"], LIMITS["swap"], "share", None, 1, 1,
            latest["t"], latest["t"], [tick_evidence(latest, "vm.swapusage used %.0fM total %.0fM" % (
                latest["swap_used_mb"], latest["swap_total_mb"]))])
    day = [r for r in rows if r["t"] >= now - DAY_S]
    covered = sum(r["dt"] for r in day if r.get("dt") and r.get("swapout_b") is not None)
    if covered >= COVER_MIN_S:
        value = sum(r.get("swapout_b") or 0 for r in day) / covered * DAY_S / GIB
        if value >= LIMITS["swap_writes_gib_day"]:
            peak = max(day, key=lambda r: r.get("swapout_b") or 0)
            judge.add("swap-writes", "machine", "swap wrote %.0f GiB a day over the last 24 h, limit %d" % (
                value, LIMITS["swap_writes_gib_day"]), round(value, 1), LIMITS["swap_writes_gib_day"], "GiB/day", 24,
                len(day), None, day[0]["t"], day[-1]["t"],
                [tick_evidence(peak, "swapouts %.2f GiB in %ds" % ((peak.get("swapout_b") or 0) / GIB, peak.get("dt") or 0))])
    week = [d for d in days if d.get("day", "") > local_day(now - 7 * DAY_S) and (d.get("covered_s") or 0) >= COVER_MIN_S]
    covered = sum(d["covered_s"] for d in week)
    if week:
        value = sum(d.get("ssd_w_b") or 0 for d in week) / covered * DAY_S / 1e9
        if value > LIMITS["ssd_gb_day"]:
            causes = merge_top([{"x": [[r["name"], 1, r["owner"]] for r in judge.reports
                                        if r["kind"] == "diskwrites"]}], "x")
            judge.add("ssd-writes", "internal", "the internal SSD took %.0f GB of writes a day over %d day%s, limit %d" % (
                value, len(week), "" if len(week) == 1 else "s", LIMITS["ssd_gb_day"]), round(value, 1),
                LIMITS["ssd_gb_day"], "GB/day", 24 * 7, len(week), None, None, now,
                [{"at": None, "ref": "day:%s" % d["day"], "account": None,
                  "excerpt": "%s %.0f GB/day over %.1f h" % (d["day"], d.get("ssd_gb_day") or 0, d["covered_s"] / 3600)}
                 for d in week[::-1]], heavy=value > LIMITS["ssd_heavy_gb_day"],
                found=cause(causes[0], sum(c[1] for c in causes)) if causes else None)
    if latest and now - latest["t"] <= TICK_STALE_S:
        for name, gib in sorted((latest.get("free_gib") or {}).items()):
            if gib < LIMITS["free_gib"]:
                caches = (judge.nightly or {}).get("caches") or []
                found = {"name": caches[0][0], "share": None, "owner": "own", "fix_target": False} if caches and \
                    name == "Data" else None
                judge.add("free-space", name, "%s has %.1f GiB free, limit %d" % (name, gib, LIMITS["free_gib"]),
                          gib, LIMITS["free_gib"], "GiB", None, 1, 1, latest["t"], latest["t"],
                          [tick_evidence(latest, "df %s free %.1f GiB" % (name, gib))],
                          heavy=gib < LIMITS["free_heavy_gib"], found=found)


def judge_nightly(judge, night):
    now = judge.now
    failed = (read_json(os.path.join(state_dir(), "launched.json"), {}) or {}).get("nightly_failed")
    if not night or now - (night.get("as_of_s") or 0) > NIGHTLY_STALE_S or isinstance(failed, (int, float)) and \
            failed > night["as_of_s"]:
        judge.blind.append("nightly")
    if not night:
        return
    since = night["as_of_s"] - DAY_S
    day = [r for r in night.get("reports") or () if r["at"] >= since and r["kind"] == "crash"]
    hs = [r for r in day if r["name"] == "Hammerspoon"]
    if len(hs) >= LIMITS["hammerspoon_crashes"]:
        judge.add("hammerspoon-crash", "Hammerspoon", "Hammerspoon crashed %d time%s in the day before the nightly pass" % (
            len(hs), "" if len(hs) == 1 else "s"), len(hs), LIMITS["hammerspoon_crashes"], "crashes", 24, len(day),
            len(hs), hs[0]["at"], hs[-1]["at"], [report_evidence(r) for r in hs[::-1]],
            found={"name": "Hammerspoon", "share": None, "owner": "own", "fix_target": True})
    jobs = {}
    for report in day:
        if report.get("job") and report["name"] != "Hammerspoon":
            jobs.setdefault(report["name"], []).append(report)
    for name, crashes in sorted(jobs.items()):
        if len(crashes) >= LIMITS["job_crashes_day"]:
            owner = crashes[0]["owner"]
            judge.add("job-crash", name, "%s, a job launchd restarts, crashed %d time%s in a day" % (
                name, len(crashes), "" if len(crashes) == 1 else "s"), len(crashes), LIMITS["job_crashes_day"],
                "crashes/day", 24, len(day), len(crashes), crashes[0]["at"], crashes[-1]["at"],
                [report_evidence(r) for r in crashes[::-1]],
                found={"name": name, "share": None, "owner": owner, "fix_target": owner == "own"})
    unclean = [at for at in night.get("unclean") or () if at >= now - REBOOT_DAYS * DAY_S]
    if len(unclean) >= LIMITS["unclean_reboots"]:
        stalls = [r for r in night.get("reports") or () if r["kind"] in ("shutdownStall", "panic")
                  and any(abs(r["at"] - at) <= HOUR_S for at in unclean)]
        judge.add("unclean-reboot", "machine", "%d unclean reboot%s in %d days (a boot with no shutdown before it)" % (
            len(unclean), "" if len(unclean) == 1 else "s", REBOOT_DAYS), len(unclean), LIMITS["unclean_reboots"],
            "reboots", REBOOT_DAYS * 24, night.get("boots") or len(unclean), len(unclean), min(unclean), max(unclean),
            [{"at": iso_time(at), "ref": "boot:%d" % at, "account": None, "excerpt": "last: reboot with no shutdown before"}
             for at in sorted(unclean, reverse=True)],
            found={"name": stalls[-1]["name"], "share": None, "owner": stalls[-1]["owner"],
                   "fix_target": stalls[-1]["owner"] == "own"} if stalls else None)


def loop_rate(job, row):
    """Runs an hour of a job launchd relaunches on its own (KeepAlive or a run interval), 0 for on-demand services."""
    if not job.get("relaunched") or not row.get("dt") or row["dt"] < COLLECT["loop_dt_s"]:
        return 0.0
    rate = job["runs"] * HOUR_S / row["dt"]
    return rate if rate > 2 * HOUR_S / (job.get("every") or HOUR_S * 1e9) else 0.0


def loops(job, row):
    """True when one hourly snapshot shows the job relaunching in a loop or dying abnormally."""
    return job.get("bad", 0) > 0 or loop_rate(job, row) >= COLLECT["loop_runs_h"]


def judge_launchd(judge, rows, harvests):
    """job-loop: a job launchd relaunches (KeepAlive or a run interval) starting >= 60 times an hour and over twice its
    schedule, or any job dying abnormally >= 3 times a day (hourly snapshots whose runs moved after an abnormal exit, or the unified log's exits if more)."""
    now = judge.now
    jobs = {}
    day = [r for r in rows if r["t"] >= now - DAY_S]
    for row in day:
        for job in row.get("jobs") or ():
            slot = jobs.setdefault(job["label"], {"rate": 0.0, "bad": 0, "logged": 0, "rows": []})
            slot["job"] = job
            slot["rate"] = max(slot["rate"], loop_rate(job, row))
            slot["bad"] += job.get("bad", 0)
            if loops(job, row):
                slot["rows"].append((row, job))
    for row in [r for r in harvests if r["t"] >= now - DAY_S]:
        for label, runs, _wall, _longest, bad, kinds, owner in row.get("launchd") or ():
            slot = jobs.setdefault(label, {"rate": 0.0, "bad": 0, "logged": 0, "rows": [],
                                           "job": {"label": label, "name": label, "owner": owner, "every": None,
                                                   "exit": next(iter(kinds), None)}})
            slot["logged"] += bad
            if bad:
                slot["rows"].append((row, {"label": label, "runs": runs, "exit": next(
                    (k for k in kinds if abnormal(k)), None)}))
    for label, slot in sorted(jobs.items()):
        job, bad = slot["job"], max(slot["bad"], slot["logged"])
        every = job.get("every")
        loop = slot["rate"] >= COLLECT["loop_runs_h"]
        if not loop and bad < COLLECT["job_exits_day"]:
            continue
        if loop:
            fact = "%s relaunched %d times an hour%s, limit %d" % (label, round(slot["rate"]), " (scheduled every %d s)" % every
                                                                  if every else "", COLLECT["loop_runs_h"])
            value, limit, unit = round(slot["rate"]), COLLECT["loop_runs_h"], "runs/h"
        else:
            fact = "%s exited abnormally %d times in a day (last %s), limit %d" % (label, bad, job.get("exit"),
                                                                              COLLECT["job_exits_day"])
            value, limit, unit = bad, COLLECT["job_exits_day"], "abnormal exits/day"
        seen = sorted(slot["rows"], key=lambda pair: -pair[0]["t"])
        judge.add("job-loop", label, fact, value, limit, unit, 24, len(day), len(seen),
                  seen[-1][0]["t"] if seen else None, seen[0][0]["t"] if seen else now,
                  [{"at": iso_time(r["t"]), "ref": "%s:%d" % ("launchd" if "jobs" in r else "harvest", r["t"]), "account": None,
                    "excerpt": "%s · %s runs · last exit %s" % (label, j.get("runs"), j.get("exit"))} for r, j in seen],
                  heavy=slot["rate"] >= COLLECT["loop_heavy_runs_h"] or bad >= COLLECT["job_exits_heavy_day"],
                  found={"name": job["name"], "share": None, "owner": job["owner"], "fix_target": job["owner"] == "own",
                         "label": label})


def judge_cohort(judge, score):
    """cohort: an item whose amortized B >= 1 (heavy >= 5). An own item in a sweep repository is tuned by a fixer;
    any other's value is unknown, so it reads watch and is never proposed for removal."""
    if not score or score.get("items") is None:
        return
    watched = 0
    for item in score["items"]:
        if item["B"] < COHORT["review"]:
            break
        if item["owner"] != "own" and watched >= COHORT["watch_rows"]:
            continue
        top = max(item["terms"], key=lambda key: item["terms"][key])
        words = dict((key, text) for key, _unit, text in TERMS)
        shown = {"D": 1e9, "R": 1e9, "M": 1 << 20}
        judge.add("cohort", item["name"], "%s costs B %.1f a day over %.1f days, mostly %s a day" % (
            item["name"], item["B"], score["covered_days"], words[top] % (item["per_day"][top] / shown.get(top, 1))),
            round(item["B"], 2), COHORT["review"], "B", round(score["covered_days"] * 24), len(item["terms"]), None, None,
            judge.now, [{"at": None, "ref": "cohort:%s" % key, "account": None, "excerpt": "%s %s/day · term %.2f" % (
                key, item["per_day"][key], item["terms"][key])} for key in sorted(item["terms"], key=lambda k: -item["terms"][k])],
            heavy=item["B"] >= COHORT["heavy"],
            found={"name": item["name"], "share": None, "owner": item["owner"], "fix_target": item["owner"] == "own"})
        problem = judge.problems[-1]
        problem["cohort"] = {k: item[k] for k in ("terms", "per_day", "unknown")}
        if problem["cause"]["fix_target"]:
            problem["fact"] += " · tune it, output-equivalent"
        else:
            problem["state"] = "watch"
            problem["fact"] += " · value unknown: watch, never remove"
            watched += item["owner"] != "own"


def store_cause(store):
    if store["cleaner"] == "sweep":
        return {"name": "log-sweep", "share": None, "owner": "own", "fix_target": True}
    owner = store.get("owner") or "third-party"
    return {"name": store.get("writer") or store["name"], "share": None, "owner": owner,
            "fix_target": owner == "own" and store["cleaner"] == "self"}


def log_firing(row, rule):
    """The causes a log-store scan row still fires `rule` for."""
    if rule == "log-store":
        found = {store_cause(s)["name"] for s in row.get("stores") or () if s.get("over_units")}
        sweep = row.get("sweep") or {}
        return found | ({"log-sweep"} if sweep.get("error") or sweep.get("errors") else set())
    return set()


def log_growth(rows):
    """(GiB grown since the scan about a day before the newest, mean GiB/day over the newest 7 days or None under
    growth_min_days of series), one scan a local day (its newest)."""
    by_day = {}
    for row in rows:
        if isinstance(row.get("total_bytes"), (int, float)):
            by_day[local_day(row["t"])] = row
    series = [by_day[d] for d in sorted(by_day)]
    if len(series) < 2:
        return None, None
    latest = series[-1]
    day_ago = [r for r in series[:-1] if r["t"] <= latest["t"] - LOGS["compare_min_s"]]
    one = (latest["total_bytes"] - day_ago[-1]["total_bytes"]) / GIB if day_ago else None
    week = [r for r in series if r["t"] >= latest["t"] - 7.5 * DAY_S]
    span = (latest["t"] - week[0]["t"]) / DAY_S
    seven = (latest["total_bytes"] - week[0]["total_bytes"]) / GIB / span if span >= LOGS["growth_min_days"] else None
    return one, seven


def criterion_words(store):
    key, value = store.get("criterion") or (None, None)
    return {"days": "%s days", "max_mb": "%s MB", "keep_newest": "newest %s", "tail_mb": "last %s MB"}.get(
        key, "%s") % value


def judge_logstores(judge, rows):
    """A store holding units past its criterion plus slack (its cleaner is broken), a failed sweep, a log store no
    program reads, the total of all log stores growing log_growth_gib_day a day over 7 days and still growing, and each
    directory the du fallback names."""
    now = judge.now
    rows = [r for r in rows if r.get("stores") is not None]
    if not rows:
        return
    latest = rows[-1]
    sweep = latest.get("sweep") or {}
    if sweep.get("error") or sweep.get("errors"):
        judge.add("log-store", "log-sweep", "log-sweep failed: %s" % (sweep.get("error") or "%d removals failed" % sweep["errors"]),
                  1, 0, "runs", 24, 1, 1, latest["t"], latest["t"], [], found=store_cause({"cleaner": "sweep"}))
    for store in latest["stores"]:
        if not store.get("over_units"):
            continue
        words = "older than" if (store.get("criterion") or [None])[0] == "days" else "past"
        judge.add("log-store", store["name"], "%s holds %d unit%s (%.2f GB) %s its %s plus slack, the oldest %d days: "
                  "its cleaner (%s) does not keep up" % (
                      store["name"], store["over_units"], "" if store["over_units"] == 1 else "s", store["over_bytes"] / 1e9,
                      words, criterion_words(store), (now - (store.get("over_oldest_s") or now)) // DAY_S, store["cleaner"]),
                  store["over_units"], 0, "units", 24, store["units"], store["over_units"], store.get("over_oldest_s"),
                  latest["t"], [{"at": iso_time(latest["t"]), "ref": "logstores:%s" % store["name"], "account": None,
                                 "excerpt": "%d units, %.2f GB in all" % (store["units"], store["bytes"] / 1e9)}],
                  found=store_cause(store))
    for store in latest["stores"]:
        if store.get("readers") != [] or not store.get("bytes"):
            continue
        judge.add("log-unread", store["name"], "%s: %.2f GB in %d files written by %s, read by nobody; kept %s" % (
            store["name"], store["bytes"] / 1e9, store["files"], store.get("writer") or "?",
            criterion_words(store) if store.get("criterion") else "by its %s cleaner" % store["cleaner"]),
            store["bytes"], 0, "bytes", 24, store["units"], store["units"], store.get("oldest_s"), latest["t"],
            [{"at": iso_time(latest["t"]), "ref": "logstores:%s" % store["name"], "account": None,
              "excerpt": "readers [] in share/log-stores.json"}])
    one, seven = log_growth(rows)
    if seven is not None and seven >= LIMITS["log_growth_gib_day"] and one is not None and one > 0:
        judge.add("log-growth", "total", "LLM log stores grew %.1f GiB a day over 7 days (%.1f GiB in the last day), %.0f GB "
                  "in all" % (seven, one, latest["total_bytes"] / 1e9), round(seven, 2), LIMITS["log_growth_gib_day"],
                  "GiB/day", 7 * 24, len(latest["stores"]), None, rows[0]["t"], latest["t"], [],
                  heavy=seven >= LIMITS["log_growth_heavy_gib_day"])
    scan = registry_scan()
    for found in latest.get("unregistered") or ():
        grow = found.get("grow_mb_day")
        judge.add("unregistered-store", found["path"], "%s holds %.2f GB no log store or ignore entry covers%s" % (
            found["path"], found["residual_mb"] / 1000, ", growing %d MB a day" % grow if grow and grow > 0 else ""),
            found["residual_mb"], scan.get("min_mb", 200), "MB", 24, found["mb"], 1, latest["t"], latest["t"],
            [{"at": iso_time(latest["t"]), "ref": "du:%s" % found["path"], "account": None,
              "excerpt": "%d MB in the directory, %d MB of it in no store" % (found["mb"], found["residual_mb"])}])


def registry_scan():
    try:
        return log_stores.load().get("scan") or {}
    except (OSError, ValueError):
        return {}


def logstores_view(rows):
    rows = [r for r in rows if r.get("stores") is not None or r.get("error")]
    if not rows:
        return None
    latest = rows[-1]
    if latest.get("error"):
        return {"as_of": iso_time(latest["t"]), "error": latest["error"]}
    one, seven = log_growth([r for r in rows if r.get("stores") is not None])
    stores = sorted(latest["stores"], key=lambda s: -s["bytes"])
    return {"as_of": iso_time(latest["t"]), "total_gb": round(latest["total_bytes"] / 1e9, 2),
            "growth_gb_1d": round(one * GIB / 1e9, 2) if one is not None else None,
            "growth_gb_day_7d": round(seven * GIB / 1e9, 2) if seven is not None else None,
            "stores": [[s["name"], round(s["bytes"] / 1e9, 2), s["files"],
                        round((latest["t"] - s["oldest_s"]) / DAY_S, 1) if s.get("oldest_s") else None, s["cleaner"],
                        criterion_words(s) if s.get("criterion") else None, s.get("over_units"),
                        s.get("readers")] for s in stores],
            "unregistered": latest.get("unregistered"), "sweep": latest.get("sweep"), "scan": latest.get("scan")}


def judge_collectors(judge, rows, launches, harvests, censuses, logs=()):
    """Names each collector that cannot see: own footprints unreadable, no launchd snapshot for 3 h or no unified-log
    harvest for 12 h while the doctor ran, a harvest source that failed, a census that read nothing."""
    now = judge.now
    since = rows[0]["t"] if rows else now
    latest = rows[-1] if rows else {}
    if latest and now - latest["t"] <= TICK_STALE_S and latest.get("own_procs") and not latest.get("usage_read"):
        judge.blind.append("footprints")
    if since <= now - 3 * HOUR_S and not [r for r in launches if r["t"] >= now - 3 * HOUR_S and r.get("services")]:
        judge.blind.append("dumpstate")
    recent = [r for r in harvests if r["t"] >= now - 12 * HOUR_S]
    if since <= now - 12 * HOUR_S and not recent or recent and any(
            (source or {}).get("cut") == "failed" for source in recent[-1].get("sources", {}).values()):
        judge.blind.append("harvest")
    if censuses and censuses[-1]["t"] >= now - DAY_S and not censuses[-1].get("polls"):
        judge.blind.append("census")
    fresh = [r for r in logs if r["t"] >= now - LOGS["stale_s"]]
    if since <= now - LOGS["stale_s"] and not fresh or fresh and (fresh[-1].get("error") or (fresh[-1].get("scan") or {}).get("cut")):
        judge.blind.append("logstores")


def report_evidence(report):
    return {"at": iso_time(report["at"]), "ref": report["ref"], "account": None,
            "excerpt": "%s %s (%s)" % (report["kind"], report["name"], report["owner"])}


def nightly_summary(night, jobs_named):
    if not night:
        return None
    kinds, processes = {}, {}
    for report in night.get("reports") or ():
        kinds[report["kind"]] = kinds.get(report["kind"], 0) + 1
        key = (report["kind"], report["name"], report["owner"])
        processes[key] = processes.get(key, 0) + 1
    top = sorted(processes.items(), key=lambda kv: (-kv[1], kv[0]))[:TOP]
    return {"as_of": iso_time(night.get("as_of_s")), "as_of_s": night.get("as_of_s"), "reports": kinds,
            "processes": [[kind, name, n, owner] for (kind, name, owner), n in top],
            "unclean_reboots_7d": sum(1 for at in night.get("unclean") or () if at >= night["as_of_s"] - REBOOT_DAYS * DAY_S),
            "boots_7d": night.get("boots"), "relaunched_jobs": night.get("relaunched"), "caches": night.get("caches"),
            "smart": night.get("smart"), "steps": night.get("steps"), "jobs_crashed": jobs_named}


def document(now, started, persist=True):
    rows = tick_rows(now - 2 * DAY_S, now)
    days = rollup(now, rows, persist)
    night = read_json(os.path.join(state_dir(), "nightly.json"))
    night = night if isinstance(night, dict) and isinstance(night.get("as_of_s"), (int, float)) else None
    judge = Judge(now, night)
    launches = tick_rows(now - COHORT["lookback_days"] * DAY_S, now, "launchd")
    harvests = tick_rows(now - 2 * DAY_S, now, "harvest")
    censuses = tick_rows(now - DAY_S, now, "census")
    judge.censuses = censuses
    judge_ticks(judge, rows, days)
    judge_nightly(judge, night)
    judge_launchd(judge, launches, harvests)
    score = cohort_score(days, launches, now)
    judge_cohort(judge, score)
    logs = tick_rows(now - 9 * DAY_S, now, "logstores")
    judge_logstores(judge, logs)
    judge_collectors(judge, rows, launches, harvests, censuses, logs)
    judge.apply_ledger()
    if persist and json.dumps(judge.memo, sort_keys=True) != judge.memo_read:
        write_json(proofs_path(), judge.memo)
    count = sum(1 for p in judge.problems if p["state"] in COUNTED)
    hour = [r for r in rows if r["t"] >= now - HOUR_S]
    latest = rows[-1] if rows else {}
    today = next((d for d in days if d.get("day") == local_day(now)), {})
    week = [d for d in days if d.get("day", "") > local_day(now - 7 * DAY_S) and (d.get("covered_s") or 0) >= COVER_MIN_S]
    covered = sum(d["covered_s"] for d in week)
    hour_covered = sum(r["dt"] for r in hour if r.get("dt")) or None
    measures = {
        "births_s": round(mean(r.get("births_s") for r in hour)) if mean(r.get("births_s") for r in hour) is not None else None,
        "kernel": round(mean(r.get("kernel") for r in hour), 3) if mean(r.get("kernel") for r in hour) is not None else None,
        "busy": round(mean(r.get("busy") for r in hour), 3) if mean(r.get("busy") for r in hour) is not None else None,
        "comp_share": latest.get("comp_share"), "comp_gib": latest.get("comp_gib"), "stored_gib": latest.get("stored_gib"),
        "mem_gib": latest.get("mem_gib"), "swap_share": latest.get("swap_share"), "swap_used_mb": latest.get("swap_used_mb"),
        "pagein_s": round(mean(r.get("pagein_s") for r in hour) or 0, 1) if hour else None,
        "ssd_gb_day_7d": round(sum(d.get("ssd_w_b") or 0 for d in week) / covered * DAY_S / 1e9, 1) if covered else None,
        "ssd_read_gb_day_7d": round(sum(d.get("ssd_r_b") or 0 for d in week) / covered * DAY_S / 1e9, 1) if covered else None,
        "swap_gib_day": today.get("swap_gib_day"), "free_gib": latest.get("free_gib") or {},
        "days_measured": len(week)}
    seen_total = sum(r.get("births_seen") or 0 for r in hour)
    causes = {"births": [[tag, round(n / seen_total, 3) if seen_total else None, owner]
                         for tag, n, owner in merge_top(hour, "births_top", width=8)],
              "cpu": [[tag, round(s / hour_covered, 2), round(rp / hour_covered, 2), owner]
                      for tag, s, rp, owner in merge_top(hour, "cpu_top", width=8)] if hour_covered else []}
    tick_cost = {"ticks_1h": len(hour), "wall_s": round(mean((r.get("self") or {}).get("wall_s") for r in hour) or 0, 3),
                 "cpu_s": round(mean((r.get("self") or {}).get("cpu_s") for r in hour) or 0, 3),
                 "cpu_s_today": today.get("tick_cpu_s"), "steps": (latest.get("self") or {}).get("steps") or {}}
    crashed = sorted({r["name"] for r in judge.reports if r.get("job") and r["kind"] == "crash"})
    costs = {"tick": tick_cost}
    for name, found in (("census", censuses), ("dumpstate", launches), ("harvest", harvests), ("logstores", logs)):
        day = [r for r in found if r["t"] >= now - DAY_S]
        costs[name] = {"runs_24h": len(day), "wall_s": round(sum((r.get("self") or {}).get("wall_s") or 0 for r in day), 2),
                       "cpu_s": round(sum((r.get("self") or {}).get("cpu_s") or 0 for r in day), 2)}
    last_launch = launches[-1] if launches else None
    last_harvest = harvests[-1] if harvests else None
    collectors = {
        "census": dict({k: v for k, v in censuses[-1].items() if k != "self"}, as_of=iso_time(censuses[-1]["t"]))
        if censuses else None,
        "dumpstate": {"as_of": iso_time(last_launch["t"]), "services": last_launch.get("services"),
                      "reloaded": last_launch.get("reloaded"), "jobs": (last_launch.get("jobs") or [])[:TOP],
                      "orphans": last_launch.get("orphans")} if last_launch else None,
        "harvest": {"as_of": iso_time(last_harvest["t"]), "sources": last_harvest.get("sources"),
                    "launchd": (last_harvest.get("launchd") or [])[:TOP], "das": (last_harvest.get("das") or [])[:TOP],
                    "hangs": (last_harvest.get("hangs") or [])[:TOP]} if last_harvest else None,
        "footprints": {"own_procs": latest.get("own_procs"), "read": latest.get("usage_read"),
                       "mem_top": latest.get("mem_top") or [], "io_top": merge_top(hour, "io_top")}}
    cohort = {"covered_days": score["covered_days"], "items": [dict(i, B=round(i["B"], 3)) for i in (score["items"] or [])[:TOP]]
              if score["items"] is not None else None}
    status = "blind" if judge.blind else ("problems" if count else "ok")
    return {
        "contract": 1, "doctor": "system", "as_of": iso_time(now), "as_of_s": int(now), "judge": judge_digest(),
        "status": status, "problem_count": count, "problems": judge.problems,
        "blind_spots": judge.ledger.get("blind_spots") or [], "blind": judge.blind, "measures": measures,
        "causes": causes, "nightly": nightly_summary(night, crashed), "costs": costs, "collectors": collectors,
        "cohort": cohort, "log_stores": logstores_view(logs),
        "limits": LIMITS, "self": {"collector_s": round(time.time() - started, 3), "error": None},
    }


def write(doc):
    write_json(os.path.join(state_dir(), "latest.json"), doc, indent=1)
    collector_runs.problem_day("system", doc, "SYSTEM_DOCTOR_DIR")


def error_document(started, error):
    now = time.time()
    return {"contract": 1, "doctor": "system", "as_of": iso_time(now), "as_of_s": int(now), "judge": None,
            "status": "error", "problem_count": 0, "problems": [], "blind_spots": [], "blind": [],
            "self": {"collector_s": round(time.time() - started, 3), "error": clip("%s: %s" % (type(error).__name__, error), 200)}}


def view(doc):
    if doc["status"] == "error":
        return "System doctor: error · %s" % doc["self"]["error"]
    lines = ["System doctor: %s · %d problems%s" % (doc["status"], doc["problem_count"],
                                                     " · blind: " + ", ".join(doc["blind"]) if doc["blind"] else "")]
    for problem in doc["problems"]:
        lines.append("  %-10s %-7s %s" % (problem["state"], problem.get("severity", ""), problem["fact"]))
    return "\n".join(lines)


# ---------------------------------------------------------------- proofs


def cause_row(rows, name, rule=None):
    found = [r for r in rows if isinstance(r, dict) and isinstance(r.get("match"), dict)
             and r["match"].get("cause") == name and (rule is None or r["match"].get("rule") == rule)]
    return found[-1] if found else None


def check(name, rule=None, since=None, now=None):
    """The proof of a fix of one cause: (exit code 0 proven | 1 refused | 3 pending, line)."""
    now = time.time() if now is None else now
    row = cause_row((read_json(ledger_path(), {}) or {}).get("rows") or [], name, rule)
    rule = rule or ((row or {}).get("match") or {}).get("rule")
    if rule not in RULE_LABELS:
        return 1, "%s: no ledger row names this cause, and no --rule was given" % name
    since = since if since is not None else fix_since(row)
    memo = read_json(proofs_path(), {})
    found = proof(name, rule, since, now, memo=memo if isinstance(memo, dict) else {})
    return {"proven": 0, "refused": 1}.get(found["verdict"], 3), "%s %s: %s · %s" % (
        name, rule, found["verdict"], found["why"])


def check_record(record_file, decisions_file, now=None):
    """Close gate of a System fixer run: each `fixed` problem has a fixed-pending ledger row naming its cause with a
    fix record, and a births/CPU cause has a baseline a later proof can measure. Returns the faults."""
    now = time.time() if now is None else now
    record = read_json(record_file, {}) or {}
    worktree = ([w for w in record.get("worktrees") or () if isinstance(w, str)] or [None])[0]
    ledger = os.path.join(worktree, "share", "system-ledger.json") if worktree else ""
    rows = (read_json(ledger if os.path.isfile(ledger) else ledger_path(), {}) or {}).get("rows") or []
    problems = {p.get("id"): p for p in record.get("problems") or () if isinstance(p, dict)}
    faults = []
    try:
        with open(decisions_file, encoding="utf-8") as handle:
            lines = [line.rstrip("\n").split("\t") for line in handle]
    except OSError as error:
        return ["cannot read %s: %s" % (decisions_file, error)]
    for parts in lines:
        problem = problems.get(parts[0]) if len(parts) >= 2 and parts[1] == "fixed" else None
        if not problem or problem.get("rule") in ("ledger", "collector") or not problem.get("cause"):
            continue
        name, rule = problem["cause"], problem.get("rule")
        row = cause_row(rows, name, rule)
        if not row or row.get("status") != "fixed-pending" or not [f for f in row.get("fixes") or () if isinstance(f, dict)]:
            faults.append("%s: fixed, but no fixed-pending ledger row matches {rule: %s, cause: %s} with a fixes[] entry: "
                          "the doctor proves a fix of that cause only through such a row" % (parts[0], rule, name))
            continue
        if rule in RATE_RULES:
            found = proof(name, rule, now, now)
            if found["verdict"] == "refused":
                faults.append("%s: %s, so no births/s or CPU drop can prove this fix" % (parts[0], found["why"]))
    return faults


# ---------------------------------------------------------------- agent and install


def nightly_due(now):
    night = read_json(os.path.join(state_dir(), "nightly.json"), {}) or {}
    last = night.get("as_of_s")
    failed = (read_json(os.path.join(state_dir(), "launched.json"), {}) or {}).get("nightly_failed")
    if isinstance(failed, (int, float)) and now - failed < HOUR_S:
        return False
    if not isinstance(last, (int, float)):
        return True
    return local_day(last) != local_day(now) and time.localtime(now).tm_hour >= NIGHTLY_HOUR or now - last > NIGHTLY_STALE_S


def judge_due(now):
    doc = read_json(os.path.join(state_dir(), "latest.json"), {}) or {}
    return not isinstance(doc.get("as_of_s"), (int, float)) or now - doc["as_of_s"] >= JUDGE_EVERY_S - 30


def agent():
    started = time.time()
    try:
        tick(started)
    except Exception as error:  # a failed tick leaves a gap the document reads as blind, never a stale document
        print("system-doctor tick: %s: %s" % (type(error).__name__, error), file=sys.stderr)
    try:
        launch_due(time.time())
    except Exception as error:
        print("system-doctor collectors: %s: %s" % (type(error).__name__, error), file=sys.stderr)
    did = []
    if nightly_due(time.time()):
        did.append("nightly")
        try:
            nightly()
        except Exception as error:
            path = os.path.join(state_dir(), "launched.json")
            write_json(path, dict(read_json(path, {}) or {}, nightly_failed=time.time()))
            write(error_document(started, error))
            return did
    if did or judge_due(time.time()):
        try:
            write(document(time.time(), time.time()))
        except Exception as error:
            write(error_document(started, error))
        did.append("judge")
    return did


def libexec_dir():
    return os.environ.get("SYSTEM_DOCTOR_LIBEXEC_DIR") or os.path.join(HOME, ".local", "libexec")


def plist_path():
    return os.path.join(os.environ.get("SYSTEM_DOCTOR_AGENT_DIR") or os.path.join(HOME, "Library", "LaunchAgents"),
                        LABEL + ".plist")


def install_agent():
    wrapper = os.path.join(libexec_dir(), WRAPPER)
    script = os.path.realpath(__file__)
    os.makedirs(libexec_dir(), exist_ok=True)
    temporary = wrapper + ".tmp"
    with open(temporary, "w") as handle:
        handle.write("#!/usr/bin/env bash\nscript=%s\n[ -r \"$script\" ] || exit 0\nexec \"$script\" \"$@\"\n"
                     % shlex.quote(script))
    os.chmod(temporary, 0o755)
    os.replace(temporary, wrapper)
    logs = os.path.join(HOME, "Library", "Logs")
    plist = {"Label": LABEL, "ProgramArguments": [wrapper, "agent"], "StartInterval": 60, "RunAtLoad": True,
             "ProcessType": "Standard", "Nice": 10, "LowPriorityIO": True,
             "EnvironmentVariables": {"PATH": "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"},
             "StandardOutPath": os.path.join(logs, "system-doctor.log"),
             "StandardErrorPath": os.path.join(logs, "system-doctor.log")}
    os.makedirs(os.path.dirname(plist_path()), exist_ok=True)
    with open(plist_path(), "wb") as handle:
        plistlib.dump(plist, handle)
    domain = "gui/%d" % os.getuid()
    machine_probe.run("launchctl", ["bootout", domain, plist_path()])
    for wait in (0, 0.5, 1, 2):
        time.sleep(wait)
        loaded = subprocess.run([machine_probe.command("launchctl"), "bootstrap", domain, plist_path()],
                                stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        if loaded.returncode == 0:
            break
    else:
        print("system-doctor: launchctl bootstrap %s failed: %s" % (plist_path(), loaded.stderr.strip()), file=sys.stderr)
        return 1
    print("Installed %s: a light tick every minute, the nightly pass after %02d:00, the document every %d min." % (
        LABEL, NIGHTLY_HOUR, JUDGE_EVERY_S // 60))
    return 0


def uninstall_agent():
    machine_probe.run("launchctl", ["bootout", "gui/%d" % os.getuid(), plist_path()])
    for path in (plist_path(), os.path.join(libexec_dir(), WRAPPER)):
        try:
            os.remove(path)
        except OSError:
            pass
    print("Uninstalled %s." % LABEL)


def main(argv=None):
    global RECORD
    parser = argparse.ArgumentParser(prog="system-doctor", description=__doc__.split("\n")[0])
    parser.add_argument("command", nargs="?", default="judge",
                        choices=("judge", "tick", "nightly", "agent", "install-agent", "uninstall-agent", "check",
                                 "census", "dumpstate", "harvest", "logstores"))
    parser.add_argument("cause", nargs="?", help="check: the cause (a script's basename) whose fix to prove")
    parser.add_argument("--json", action="store_true", help="judge: print the document and write nothing")
    parser.add_argument("--quiet", action="store_true", help="print nothing")
    parser.add_argument("--rule", help="check: the rule the fix answers (default: the cause's ledger row)")
    parser.add_argument("--since", help="check: when the fix landed, epoch or ISO (default: its ledger fix's commit)")
    parser.add_argument("--record", help="check: a doctor-fix run record to gate at close, with --decisions")
    parser.add_argument("--decisions", help="check --record: the close's decisions file")
    args = parser.parse_args(argv)
    started = time.time()
    if args.command == "check":
        RECORD = False
        if args.record:
            if not args.decisions:
                parser.error("check --record needs --decisions")
            faults = check_record(args.record, args.decisions)
            for fault in faults:
                print(fault)
            return 1 if faults else 0
        if not args.cause:
            parser.error("check needs a cause or --record")
        since = None
        if args.since:
            since = float(args.since) if re.match(r"^\d+(\.\d+)?$", args.since) else iso_epoch(args.since)
            if since is None:
                parser.error("--since is neither an epoch nor an ISO time: %s" % args.since)
        code, text = check(args.cause, args.rule, since)
        print(text)
        return code
    if args.command == "tick":
        row = tick()
        if not args.quiet:
            print(json.dumps(row, ensure_ascii=False))
        return 0
    if args.command == "nightly":
        result = nightly()
        if not args.quiet:
            print(json.dumps({k: v for k, v in result.items() if k != "reports"} | {"reports": len(result["reports"])}))
        return 0
    if args.command in COLLECTORS:
        with single(args.command) as mine:
            if not mine:
                RECORD = False
                return 0
            row = COLLECTORS[args.command]()
        if not args.quiet:
            print(json.dumps({k: v for k, v in row.items() if not isinstance(v, list) or len(v) <= TOP}, ensure_ascii=False))
        return 0
    if args.command == "agent":
        RECORD = bool(agent())
        return 0
    if args.command == "install-agent":
        return install_agent()
    if args.command == "uninstall-agent":
        uninstall_agent()
        return 0
    try:
        doc = document(time.time(), started, persist=not args.json)
    except Exception as error:
        doc = error_document(started, error)
    if args.json:
        print(json.dumps(doc, ensure_ascii=False, indent=1))
        return 0 if doc["status"] != "error" else 1
    write(doc)
    if not args.quiet:
        print(view(doc))
    return 0 if doc["status"] != "error" else 1


RECORD = True
COLLECTORS = {"census": census, "dumpstate": dumpstate, "harvest": harvest, "logstores": logstores}

if __name__ == "__main__":
    started = time.time()
    code = main()
    if RECORD and sys.argv[1:2] != ["tick"]:
        collector_runs.record("system", started, next((a for a in sys.argv[1:] if not a.startswith("-")), "judge"))
    sys.exit(code)

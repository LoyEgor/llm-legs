@functools.lru_cache(maxsize=None)
def repo_files(top):
    try:
        out = subprocess.run(["git", "-C", top, "ls-files", "--cached", "--others", "--exclude-standard"],
                             capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return ()
    return tuple(out.stdout.splitlines()) if out.returncode == 0 else ()


def own_sources(name):
    """`repo/path` of the night-fixable files a cause names: itself when it is one such `repo/path` of a sweep or helper
    repository, else every sweep-repository file of its basename; an own app maps to its config entry."""
    found = []
    for top in sweep_dirs() + (helper_dirs() if "/" in name else []):
        repo = os.path.basename(top.rstrip("/"))
        named = APP_SOURCES.get(name) or (name if "/" in name else None)
        if named:
            if named.split("/", 1)[0] == repo and named.split("/", 1)[1] in repo_files(top):
                found.append(named)
            continue
        found += ["%s/%s" % (repo, path) for path in repo_files(top) if os.path.basename(path) == name]
    return sorted(set(found))[:8]


def source_path(rel):
    repo, _, path = rel.partition("/")
    return next((os.path.join(top, path) for top in sweep_dirs() + helper_dirs() if os.path.basename(top.rstrip("/")) == repo),
                None)



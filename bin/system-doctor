def env_list(name, default):
    value = os.environ.get(name)
    return [part for part in value.split(":") if part] if value is not None else list(default)


def diag_dirs():
    return env_list("SYSTEM_DOCTOR_DIAG_DIRS", (os.path.join(HOME, "Library", "Logs", "DiagnosticReports"),
                                                "/Library/Logs/DiagnosticReports"))


def agent_dirs():
    return env_list("SYSTEM_DOCTOR_AGENTS_DIRS", (os.path.join(HOME, "Library", "LaunchAgents"),
                                                  "/Library/LaunchAgents", "/Library/LaunchDaemons"))


def own_roots():
    return tuple(env_list("SYSTEM_DOCTOR_OWN_ROOTS", ("/Volumes/Work/Projects/", os.path.join(HOME, ".claude"),
                                                      os.path.join(HOME, ".local") + "/",
                                                      os.path.join(HOME, ".hammerspoon"))))


def cache_roots():

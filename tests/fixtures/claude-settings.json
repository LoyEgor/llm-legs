{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worker-spawn-hook.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/statusline-workdir-hook.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worker-pin-gate.sh write",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/instruction-write-gate.sh",
            "timeout": 10,
            "statusMessage": "Instruction write gate..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/worker-pin-gate.sh bash",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/worker-launch-gate.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Monitor|mcp__codex__codex|mcp__codex__codex-reply",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worker-launch-gate.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/instruction-watch.sh check",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit|EnterWorktree|ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/statusline-workdir-hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/statusline-workdir-hook.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/instruction-watch.sh baseline",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/word-intake.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

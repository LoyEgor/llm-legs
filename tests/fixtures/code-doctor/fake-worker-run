#!/usr/bin/env bash
# worker-run for tests/test_code_doctor.sh: answers each judge brief from CODE_DOCTOR_FAKE_VERDICTS by its cause id.
set -u
case ${1:-} in
  start)
    shift 2
    brief=''
    while [ $# -gt 0 ]; do
      case $1 in --brief) brief=$2 ;; esac
      shift 2
    done
    id="fake-$(date +%s)-$RANDOM$RANDOM"
    printf '%s\t%s\n' "$id" "$(head -1 "$brief" | sed 's/^# Code doctor judge: //')" >>"$CODE_DOCTOR_FAKE_LOG"
    printf 'RUN: %s\nDIR: /tmp\n' "$id" ;;
  wait) exit 0 ;;
  report)
    cause=$(awk -F'\t' -v id="$2" '$1 == id { print $2 }' "$CODE_DOCTOR_FAKE_LOG")
    printf 'ACCOUNT: fake\nSTATUS: done\nCOST: %s tok-eq\nRESULT:\nJudged from the fixture.\n%s\n' "${CODE_DOCTOR_FAKE_COST:-1000}" \
      "$(jq -c --arg c "$cause" '.[$c] // {verdict: "not-now", fact: "fixture", reason: "no fixture verdict", triggers: ["a fixture verdict"]}' \
        "$CODE_DOCTOR_FAKE_VERDICTS")" ;;
  *) exit 2 ;;
esac
